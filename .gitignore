# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Coherent -- an allowlist.  Everything under Coherent/ stays out unless it
# is re-included here.  Out: the source archives (gtz/) and the partition
# images (romana/), reference material far too large for history.  In:
# everything needed to put COHERENT on an SBC-386EX or to rebuild it --
# the original 4.2.10 install kit (distrib/), the kernel source with our
# changes, the board files, the tools, and the finished images (images/).
Coherent/*
!Coherent/readme.txt
!Coherent/*.md
!Coherent/.gitattributes

# The original COHERENT 4.2.10 install kit, four 1.44 MB floppies: what
# emu/mkdisks.sh and the development-disk install start from.
!Coherent/distrib/

# Ready-to-use images: the CF card image (gzipped), the board and QEMU
# install diskettes, and their checksums.  Rebuilt by emu/mkrelease.sh
# and emu/mkdisks.sh.
!Coherent/images/

# Host-side tools: cohfs.py, qmp.py, sercon.py
!Coherent/tools/

# Emulator scripts only.  The working disk images (the development disk,
# test builds) are rebuilt by the procedures in Coherent/README.md and the
# screenshots are scratch; finished images go in Coherent/images.
!Coherent/emu/
Coherent/emu/*.img
Coherent/emu/*.png

# Kernel source (sys.r12 from gtz/src.gtz) and our changes to it
!Coherent/sys.r12/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
Coherent/emu/xfer/
Coherent/emu/*.log
!Coherent/board/
