# The -K list for the kernel link: symbols kept in the kernel image's
# symbol table, which is what /conf/patch can find and change.  Stock
# 4.2.10 list (/etc/conf/install_conf/keeplist), plus the SBC-386EX
# additions on the last line.
echo '-R *'
echo '-I stext:sdata:*[!_]dev:drvl:*con:boot_gift:asy*:atparm:ASY*:t_*'
echo '-I ndpType:ndpDump'
echo '-I SHMMNI:SEMMNI:NMSQID'
echo '-I pit_count:early_con:AT*'
