									:
				;       (AX) IS SET, BIT SIGNIFICANT, TO INDICA
				TE ATTACHED I/O			:
				;       BIT 15,14 = NUMBER OF PRINTERS ATTACHED
									
					:
				;       BIT 13 = INTERNAL MODEM INSTALLED
									
						:
				;       BIT 12 NOT USED			
								:
				;       BIT 11,10,9 = NUMBER OF RS232 CARDS ATT
				ACHED					:
				;       BIT 8 = NOT USED		
									:
				;       BIT 7,6 = NUMBER OF DISKETTE DRIVES
									
					:
				;               00=1, 01=2 ONLY IF BIT 0 = 1
									
					:
				;       BIT 5,4 = INITIAL VIDEO MODE	
									
					:
				;                       00 - UNUSED	
									
					:
				;                       01 - 40X25 BW USING COL
				OR CARD				:
				;                       10 - 80X25 BW USING COL
				OR CARD				:
				;                       11 - 80X25 BW USING BW 
				CARD					:
				;       BIT 3 = NOT USED		
									:
