			     C	;-------------------------------------------------------------------------------
			     C	; BIOS I/O INTERFACE							       ;
			     C	;									       ;
			     C	;	   THESE LISTINGS PROVIDE INTERFACE INFORMATION FOR ACCESSING          ;
			     C	;	   THE BIOS ROUTINES. THE POWER ON SELF TEST IS INCLUDED.	       ;
			     C	;									       ;
			     C	;	   THE BIOS ROUTINES ARE MEANT TO BE ACCESSED THROUGH		       ;
			     C	;	   SOFTWARE INTERRUPTS ONLY. ANY ADDRESSES PRESENT IN		       ;
			     C	;	   THESE LISTINGS ARE INCLUDED ONLY FOR	COMPLETENESS,		       ;
			     C	;	   NOT FOR REFERENCE. APPLICATIONS WHICH REFERENCE ANY		       ;
			     C	;	   ABSOLUTE ADDRESSES WITHIN THE CODE SEGMENTS OF BIOS		       ;
			     C	;	   VIOLATE THE STRUCTURE AND DESIGN OF BIOS.			       ;
			     C	;									       ;
			     C	;-------------------------------------------------------------------------------
			     C	
			     C	
			     C	;-------------------------------------------------------------------------------
			     C	;   MODULE REFERENCE                                                           ;
			     C	;                                                                              ;
			     C	;    TEST1.ASM      -->  POST AND MANUFACTURING TEST ROUTINES                  ;
			     C	;      DSEG.INC	    -->   DATA SEGMENTS LOCATIONS                              ;
			     C	;      POSTEQU.INC  -->   COMMON EQUATES FOR POST AND BIOS                     ;
			     C	;      SYSDATA.INC  -->   POWER ON SELF TEST EQUATES FOR PROTECTED MODE        ;
			     C	;                          POST TEST.01 THROUGH TEST.16                        ;
			     C	;    TEST2.ASM	    -->  POST TEST AND INITIALIZATION ROUTINES                 ;
			     C	;			  POST TEST.17 THROUGH TEST.22                         ;
			     C	;    TEST3.ASM	    -->  POST EXCEPTION INTERRUPT TESTS                        ;
			     C	;    TEST4.ASM	    -->	 POST AND BIOS UTILITY ROUTINES                        ;
			     C	;			   CMOS_READ	 - READ CMOS LOCATION ROUTINE          ;
			     C	;                          CMOS WRITE	 - WRITE CMOS LOCATION ROUTINE         ;
			     C	;                          DDS	         - LOAD (DS:) WITH DATA SEGMENT        ;
			     C	;                          E_MSG	 - POST ERROR MESSAGE HANDLER          ;
			     C	;                          MFG_HALT	 - MANUFACTURING ERROR TRAP            ;
			     C	;                          P_MSG	 - POST STRING DISPLAY ROUTINE         ;
			     C	;                          ERR_BEEP	 - POST ERROR BEEP PROCEDURE           ;
			     C	;                          BEEP	         - SPEAKER BEEP CONTROL ROUTINE        ;
			     C	;                          WAITF	 - FIXED TIME WAIT ROUTINE             ;
			     C	;                          CONFIG_BAD	 - SET BAD CONFIG IN CMOS_DIAG         ;
			     C	;                          XPC_BYTE	 - DISPLAY-HEX BYTE AS 00 - FF         ; 
			     C	;                          PRT_HEX	 - DISPLAY CHARACTER                   ;
			     C	;                          PRT_SEG	 - DISPLAY SEGMENT FORMAT ADDRESS      ;
			     C	;                          PROT_PRT_HEX  - POST PROTECTED MODE DISPLAY         ;
			     C	;                          ROM_CHEECKSUM - CHECK ROM MODULES FOR CHECKSUM      ;
			     C	;                          ROM_CHECK	 - ROM SCAN AND INITIALIZE             ;
			     C	;                          KBD_RESET	 - POST KEYBOARD RESET ROUTINE         ;
			     C	;                          BLINK_INT	 - MANUFACTURING TOGGLE BIT ROUTINE    ;
			     C	;                          SET_TOD 	 - SET TIMER FROM CMOS RTC             ;
			     C	;                          D11	         - DUMMY INTERRUPT HANDLER   ->INT ??H ;
			     C	;                          RE_DIRECT 	 - HARDWARE INT  9 REDIRECT (L 2)      ;
			     C	;                          INT_287	 - HARDWARE INT 13 REDIRECT (287)      ;
			     C	;			   PROC_SHUTDOWN - 80286 RESET ROUTINE                 ;
			     C	;    TEST5.ASM	    -->  EXCEPTTON INTERRUPT TEST HANDLERS FOR POST TESTS      ;
			     C	;		           SYSINIT1	 - BUILD PROTECTED MODE POINTERS       ;
			     C	;		           GDT_BLD	 - BUILD THE GDT FOR POST              ;
			     C	;		           SIDT_BLD	 - BUILD THE IDT FOR POST              ;
			     C	;    TEST6.ASM	    -->  POST TESTS AND SYSTEM BOOT STRAP                      ;
			     C	;		           STGTST_CNT	 - SEGMENT STORAGE TEST                ;
			     C	;		           ROM_ERR	 - ROM ERROR DISPLAY ROUTINE           ;
			     C	;		           XMIT_8042	 - KEYBOARD DIAGNOSTIC OUTPUT          ;
			     C	;		           BOOT_STRAP	 - BOOT STRAP LOADER	      -INT 19H ;
			     C	;    DSKETTE.ASM    -->	 DISKETTE BIOS                                         ;
			     C	;                          DISKETTE_IO_1 - INT 13H BIOS ENTRY (40H)   -INT 13H ;
			     C	;                          DISK_INT_1	 - HARDWARE INTERRUPT HANDLER -INT 0EH ;
			     C	;                          DSKETTE_SETUP - POST SETUP DRIVE TYPES              ;
			     C	;    DISK.ASM       -->  FIXED DISK BIOS                                       ;
			     C	;                          DISK_SETUP	 - SETUP DISK VECTORS AND TEST         ;
			     C	;                          DISK_IO	 - INT 13H BIOS ENTRY         -INT 13H ;
			     C	;                          HD_IRT	 - HARDWARE INTERRUPT HANDLER -INT 16H ;
			     C	;    KYBD.ASM       -->  KEYBOARD BIOS                                         ;
			     C	;	                   KEYBOARD_IO_1 - INT 16H BIOS ENTRY	      -INT 16H ;
			     C	;	                   KB_INT_1	 - HARDWARE INTERRUPT	      -INT 09H ;
			     C	;	                   SND_DATA	 - KEYBOARD TRANSMISSION               ;
			     C	;    PRT.ASM	    -->  PRINTER ADAPTER BIOS               	      -INT 17H ;
			     C	;    RS232.ASM	    -->  COMMUNICATIONS BIOS FOR RS232	              -INT 14H ;
			     C	;    VIDEO.ASM	    -->  VIDEO BIOS		                      -INT 10H ;
			     C	;    BIOS.ASM	    -->  BIOS ROUTINES                                         ;
			     C	;		           MEMORY_SIZE_DET_1 - REAL MODE SIZE         -INT 12H ;
			     C	;		           EQUIPMENT_1   - EQUIPMENT DETERMINATION    -INT 11H ;
			     C	;		           NMI_INT_1	 - NMI HANDLER	              -INT 02H ;
			     C	;    BIOS1.ASM      -->  INTERRUPT 15H BIOS ROUTINES	              -INT 15H ;
			     C	;                          DEV_OPEN	 - NULL DEVICE OPEN HANDLER            ;
			     C	;                          DEV_CLOSE	 - NULL DEVICE CLOSE HANDLER           ;
			     C	;                          PROG_TERM	 - NULL PROGRAM TERMINATION            ;
			     C	;                          EVENT_WAIT	 - RTC EVENT WAIT/TIMEOUT ROUTINE      ;
			     C	;                          JOY_STICK	 - JOYSTICK PORT HANDLER               ;
			     C	;                          SYS_REQ	 - NULL SYSTEM REQUEST KEY             ;
			     C	;                          WAIT		 - RTC TIMED WAIT ROUTINE              ;
			     C	;                          BLOCKMOVE	 - EXTENDED MEMORY MOVE INTERFACE      ;
			     C	;                          GATE_A20	 - ADDRESS BIT 20 CONTROL              ;
			     C	;                          EXT_MEMORY	 - EXTENDED MEMORY SIZE DETERMINE      ;
			     C	;                          SET_VMODE	 - SWITCH PROCESSOR TO VIRTUAL MODE    ;
			     C	;		           DEVICE_BUSY	 - NULL DEVICE BUSY HANDLER            ;
			     C	;		           INT_COMPLETE  - NULL INTERRUPT COMPLETE HANDLER     ;
			     C	;    BIOS2.ASM	    -->  BIOS INTERRUPT ROUTINES                               ;
			     C	;		           TIME_OF_DAY_1 - TIME OF DAY ROUTINES	      -INT 1AH ;
			     C	;		           RTC_INT	 - IRQ LEVEL 8 ALARM HANDLER  -INT 70H ;
			     C	;		           PRINT_SCREEN1 - PRINT SCREEN ROUTINE	      -INT 05H ;
			     C	;		           TIMER_INT_1	 - TIMER1 INTERRUPT HANDLER  ->INT 1CH ;
			     C	;    ORGS.ASM	    -->	 COMPATIBILITY MODULE                                  ;
			     C	;		           POST ERROR MESSAGES                                 ;
			     C	;		           DISKETTE - DISK - VIDEO DATA TABLES                 ;
			     C	;-------------------------------------------------------------------------------
			     C	.LIST
				INCLUDE	POSTEQU.INC
			     C	;TITLE POSTEQU.INC
			     C	
