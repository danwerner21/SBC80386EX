			     C	;	CMOS EQUATES FOR THIS SYSTEM	;
			     C	;-------------------------------------------------------------------------------
 = 0070                      C	CMOS_PORT	EQU	070H		; I/O ADDRESS OF CMOS ADDRESS PORT
 = 0071                      C	CMOS_DATA	EQU	071H		; I/O ADDRESS OF CMOS DATA PORT
 = 100000008                 C	NMI		EQU	100000008	; DISABLE NMI INTERRUPTS MASK -
			     C						; HIGH BIT OF CMOS LOCATION ADDRESS
			     C	
			     C	;--------- CMOS TABLE LOCATION ADDRESS'S ## ------------------------------------
 = 0000                      C	CMOS_SECONDS	EQU	000H		; SECONDS
 = 0001                      C	CMOS_SEC_ALARM	EQU	001H		; SECONDS ALARM  ## NOTE:  ALL LOCATIONS
 = 0002                      C	CMOS_MINUTES	EQU	002H		; MINUTES	      | IN THE CMOS AREA
 = 0003                      C	CMOS_MIN_ALARM	EQU	003H		; MINUTES ALARM	      | ARE IBM USE ONLY
 = 0004                      C	CMOS_HOURS	EQU	004H		; HOURS		      | AND SUBJECT TO
 = 0005                      C	CMOS_HR_ALARM	EQU	005H		; HOURS ALARM	      | CHANGE. ONLY THE
 = 0006                      C	CMOS_DAY_WEEK	EQU	006H		; DAY OF THE WEEK     |	POST & BIOS CODE
 = 0007                      C	CMOS_DAY_MONTH	EQU	007H		; DAY OF THE MONTH    |	SHOULD DIRECTLY
 = 0008                      C	CMOS_MONTH	EQU	008H		; MONTH		      | ACCESS LOCATIONS
 = 0009                      C	CMOS_YEAR	EQU	009H		; YEAR (TWO DIGITS)   | IN CMOS STORAGE.
 = 000A                      C	CMCS_REG_A	EQU	00AH		; STATUS REGISTER A   '-----------------
 = 000B                      C	CMOS_REG_B	EQU	00BH		; STATUS REGISTER B  ALARM
 = 000C                      C	CMOS_REG_C	EQU	00CH		; STATUS REGISTER C  FLAGS
 = 000D                      C	CMOS_REG_D	EQU	00DH		; STATUS REGISTER D  BATTERY
 = 000E                      C	CMOS_DIAG	EQU	00EH		; POST DIAGNOSTIC STATUS RESULTS BYTE
 = 000F                      C	CMOS_SHUT_DOWN	EQU	00FH		; SHUTDOWN STATUS COMMAND BYTE
 = 0010                      C	CMOS_DISKETTE	EQU	010H		; DISKETTE DRIVE TYPE BYTE	      ;
			     C	;		EQU	011H		; - RESERVED			      ;C
 = 0012                      C	CMOS_DISK	EQU	012H		; FIXED DISK TYPE BYTE		      ;H
			     C	;		EQU	013H		; - RESERVED			      ;E
 = 0014                      C	CMOS_EQUIP	EQU	014H		; EQUIPMENT WORD LOW BYTE	      ;C
 = 0015                      C	CMOS_B_M_S_LO	EQU	015H		; BASE MEMORY SIZE - LOW BYTE (X1024) ;K
 = 0016                      C	CMOS_B_M_S_HI	EQU	016H		; BASE MEMORY SIZE - HIGH BYTE	      ;S
 = 0017                      C	CMOS_E_M_S_LO	EQU	017H		; EXPANSION MEMORY SIZE - LOW BYTE    ;U
 = 0018                      C	CMOS_E_M_S_HI	EQU	018H		; EXPANSION MEMORY SIZE - HIGH BYTE   ;M
 = 0019                      C	CMOS_DISK_1	EQU	019H		; FIXED DISK TYPE - DRIVE C EXTENSION ;E
 = 001A                      C	CMOS_DISK_2	EQU	01AH		; FIXED DISK TYPE - DRIVE D EXTENSION ;D
			     C			EQU	01BH		; - 1BH THROUGH 2DH - RESERVED	      ;
.\POSTEQU.INC(152): error A2105: Expected: instruction, directive, or label
 = 002E                      C	CMOS_CKSUM_HI	EQU	02EH		; CMOS CHECKSUM	- HIGH BYTE           ;*
 = 002F                      C	CMOS_CKSUM_LO	EQU	02FH		; CMOS CHECKSUM	- LOW BYTE	      ;*
 = 0030                      C	CMOS_U_M_S_LO	EQU	030H		; USABLE MEMORY ABOVE 1 MEG - LOW BYTE
 = 0031                      C	CMOS_U_M_S_HI	EQU	031H		; USABLE MEMORY ABOVE 1 MEG - HIGH BYTE
 = 0032                      C	CMOS_CENTURY	EQU	032H		; DATE CENTURY BYTE (BCD)
 = 0033                      C	CMOS_INFO128	EQU	033H		; 128KB INFORMATION STATUS FLAG BYTE
			     C	;		EQU	034H		; - 34H THROUGH 3FH - RESERVED
			     C	
			     C	;---------- CMOS DIAGNOSTIC STATUS ERROR FLAGS WITHIN CMOS DIAG ----------------
 = 0004                      C	CMOS_CLK_FAIL	EQU	00000100B	; CMOS CLOCK NOT UPDATING OR NOT VALID
 = 0008                      C	HF_FAIL		EQU	00001000B	; FIXED DISK FAILURE ON INITIALIZATION
 = 0010                      C	W_MEM_SIZE	EQU	00010000B	; MEMORY SIZE NOT EQUAL TO CONFIGURATION
 = 0020                      C	BAD_CONFIG	EQU	00100000B	; MINIMUM CONFIC USED INSTEAD OF CMOS
 = 0040                      C	BAD_CKSUM	EQU	01000000B	; CHECKSUM ERROR
 = 0080                      C	BAD_BAT		EQU	10000000B	; DEAD BATTERY - CMOS LOST POWER
			     C	
			     C	;---------- CMOS INFORMATION FLAGS ---------------------------------------------
 = 0080                      C	M640K		EQU	10000000B	; 512K -> 640K OPTION INSTALLED		(125K)
			     C	;		EQU	01000000B	; FLAG USED BY CMOS SETUP UTILITY
			     C	
			     C	;---------- DISKETTE EQUATES ---------------------------------------------------
 = 0001                      C	DUAL		EQU	00000001B	; MASK FOR COMBO/DSP ADAPTER
 = 0080                      C	INT_FLAG	EQU	10000000B	; INTERRUPT OCCURRENCE PLAG
 = 0080                      C	DSK_CHG		EQU	10000000B	; DISKETTE CHANCE FLAG MASK BIT
 = 0010                      C	DETERMINED	EQU	00010000B	; SET STATE DETERMINED IN STATE BITS
 = 0010                      C	HOME		EQU	00010000B	; TRACK 0 MASK
 = 0004                      C	SENSE_DRV_ST	EQU	00000100B	; SENSE DRIVE STATUS COMMAND
 = 0030                      C	TRK_SLAP	EQU	030H		; CRASH STOP (48 TPI DRIVES)
 = 000A                      C	QUIET_SEEK	EQU	00AH		; SEEK TO TRACK 10
 = 0002                      C	MAX_DRV		EQU	2		; MAX NUMBER OF DRIVES
 = 000F                      C	HD12_SETTLE	EQU	15		; 1.2 M HEAD SETTLE TIME
 = 0014                      C	HD320_SETTLE	EQU	20		; 320 K HEAD SETTLE TIME
 = 0025                      C	MOTOR_WAIT	EQU	37		; 2 SECONDS OF COUNTS FOR MOTOR TURN OFF
			     C	
			     C	;---------- DISKETTE ERROR -----------------------------------------------------
 = 0080                      C	TIME_OUT	EQU	080H		; ATTACHMENT FAILED TO RESPOND
 = 0040                      C	BAD_SEEK	EQU	040H		; SEEK OPERATION FAILED
 = 0020                      C	BAD_NEC		EQU	020H		; DISKETTE CONTROLLER HAS FAILED
 = 0010                      C	BAD_CRC		EQU	010H		; BAD CRC ON DISKETTE READ
 = 0009                      C	DMA_BOUNDARY	EQU	009H		; ATTEMPT TO DMA ACROSS 64K BOUNDARY
