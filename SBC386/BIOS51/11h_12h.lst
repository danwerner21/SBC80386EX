    30                                  %include "seg_def.inc"
    31                              <1> ; SEG_DEF.inc
    32                              <1> ;
    33                              <1> %ifndef SEG_DEF
    34                              <1> %define SEG_DEF 1
    35                              <1> 
    36                              <1> segment CODE	use16	align=16	class=CODE	public
    37                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    38                              <1> 
    39                              <1> segment CONST		align=16	class=DATA	public
    40                              <1> segment CONST2		align=2		class=DATA	public
    41                              <1> segment _DATA		align=16	class=DATA	public
    42                              <1> segment _BSS		align=16	class=DATA	public
    43                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    44                              <1> 
    45                              <1> group DGROUP CODE _TEXT CONST2 CONST _DATA _BSS
    46                              <1> 
    47                              <1> 
    48                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    49                              <1> 
    50                              <1> %define XXX
    51                              <1> %endif
    52                              <1> ;
    53                              <1> ; end SEG_DEF.inc
