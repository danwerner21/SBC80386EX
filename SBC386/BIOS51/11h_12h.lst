   431                              <1> defb    ASCII_CR        equ     0x0D
   432                              <1> defb	ASCII_ESC	equ	0x1B
   433                              <1> defb    ASCII_SP        equ     0x20
   434                              <1> defb    ASCII_DEL       equ     0x7F
   435                              <1> defb	ASCII_RUB	equ	0xFF
   436                              <1> 
   437                              <1> 
   438                              <1> ;/* End of i386EX.inc */
   439                                  %include "bda.inc"
   440                              <1> XXX
   441                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
   442                              <1> %define BDA_segment 0x40
   443                              <1> struc _BDA
   444                              <1> ; first items at 0x40:0	*/
   445 00000000 <res 00000008>      <1> serial_dev	resw	4	; serial port device codes */
   446 00000008 <res 00000008>      <1> parallel_dev	resw	4	; printer port device codes */
   447 00000010 <res 00000002>      <1> equip_flag	resw	1		; int 12h equipment flags */
   448 00000012 <res 00000001>      <1> mfg_test	resb	1		; initialization flags */
   449 00000013 <res 00000002>      <1> memory_size	resw	1	; base memory size in Kilowords (1024) */
   450 00000015 <res 00000001>      <1> mfg_err_flag	resb	1
   451 00000016 <res 00000001>      <1> mfg_err_flag2	resb	1
   452                              <1> ; */
   453                              <1> ; first Keyboard data area */
   454 00000017 <res 00000001>      <1> kbd_flag	resb	1	; shift status &c. */
   455 00000018 <res 00000001>      <1> kbd_flag1	resb	1	;  more  */
   456 00000019 <res 00000001>      <1> alt_input	resb	1	; save alternate kbd entry code */
   457 0000001A <res 00000002>      <1> buffer_head	resw	1
   458 0000001C <res 00000002>      <1> buffer_tail	resw	1
   459                              <1> ; */
   460 0000001E <res 00000020>      <1> kbd_buffer	resw	16	; buffer empty when  head==tail */
   461                              <1> ; */
   462                              <1> ; Diskette data area */
   463 0000003E <res 00000001>      <1> seek_status	resb	1	; drive recalibration status */
   464                              <1> ; bits 3..0 drive must recalibrate before next seek */
   465 0000003F <res 00000001>      <1> motor_status	resb	1	; bits 3..0 motor running */
   466                              <1> ; bit 7 current op is write */
   467 00000040 <res 00000001>      <1> motor_count	resb	1	; timeout counter for motor turn-off */
   468 00000041 <res 00000001>      <1> fd_status	resb	1	; return code status byte */
   469 00000042 <res 00000007>      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   470                              <1> ; */
   471                              <1> ; Video Display data area -- also used for video emulation */
   472 00000049 <res 00000001>      <1> vid_mode	resb	1	; current display mode */
   473 0000004A <res 00000002>      <1> vid_columns	resw	1	; no. of columns on the screen */
   474 0000004C <res 00000002>      <1> vid_buf_len	resw	1	; length of video buffer in bytes */
   475 0000004E <res 00000002>      <1> vid_start	resw	1	; start address of screen regeneration (in vid buf) */
   476 00000050 <res 00000010>      <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   477 00000060 <res 00000002>      <1> vid_cursor_mode	resw	1
   478 00000062 <res 00000001>      <1> vid_active_page	resb	1
   479 00000063 <res 00000002>      <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA) */
   480 00000065 <res 00000001>      <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   481 00000066 <res 00000001>      <1> vid_palette	resb	1	; current color setting / palette  */
   482                              <1> ; */
   483                              <1> ; POST and ROM data */
   484 00000067 <res 00000004>      <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   485                              <1> %define io_rom_addr_low io_rom_addr
   486                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   487 0000006B <res 00000001>      <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   488                              <1> ; */
   489                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   490 0000006C <res 00000002>      <1> timer_count_low	resw	1	; low word of timer count */
   491 0000006E <res 00000002>      <1> timer_count_high	resw	1
   492                              <1> %define timer_count timer_count_low
   493                              <1> ; use timer_count as the double word timer counter */
   494 00000070 <res 00000001>      <1> timer_overflow	resb	1	; timer has rolled over since last read */
   495                              <1> ; */
   496                              <1> ; System & Keboard data area */
   497 00000071 <res 00000001>      <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   498 00000072 <res 00000002>      <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   499                              <1> ; */
   500                              <1> ; Fixed (Hard) disk data area */
   501 00000074 <res 00000001>      <1> hd_status	resb	1	; status info for hard disk */
   502                              <1> %define disk_status1 hd_status
   503 00000075 <res 00000001>      <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
   504 00000076 <res 00000001>      <1> control_byte	resb	1	; head control ???? */
   505 00000077 <res 00000001>      <1> port_offset	resb	1	; obsolete, maybe ???? */
   506                              <1> ; */
   507                              <1> ; Timeout counters *;
   508 00000078 <res 00000004>      <1> printer_timeout	resb	4
   509 0000007C <res 00000004>      <1> serial_timeout	resb	4	; one byte for each interface */
   510                              <1> ; */
   511                              <1> ; Keyboard additional data area -- buffer location within segment 40h */
   512 00000080 <res 00000002>      <1> buffer_start	resw	1	; offset of keyboard buffer start */
   513 00000082 <res 00000002>      <1> buffer_end	resw	1		; offset of end of kbd buffer */
   514                              <1> ; */
   515                              <1> ; EGA/PGA? data work area (graphic mode?  probably available) */
   516 00000084 <res 00000001>      <1> ega_rows	resb	1		; rows on the active screen (less 1) */
   517 00000085 <res 00000002>      <1> ega_points	resw	1		; bytes per character	*/
   518 00000087 <res 00000001>      <1> ega_info	resb	1		; mode options ???? */
   519 00000088 <res 00000001>      <1> ega_info_3	resb	1		; switch settings */
   520 00000089 <res 00000002>      <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   521                              <1> ; */
   522                              <1> ; Disk / Diskette media data */
   523 0000008B <res 00000001>      <1> fd_last_data_rate	resb	1	; last data rate selected */
   524 0000008C <res 00000001>      <1> hd_status_reg	resb	1		; hard disk status register */
   525 0000008D <res 00000001>      <1> hd_error_reg	resb	1		; hard disk error register */
   526 0000008E <res 00000001>      <1> hd_int_flag	resb	1	; HD interrupt flag */
   527 0000008F <res 00000001>      <1> hd_cntrl	resb	1		; HD/FD combo controller bit flag */
   528 00000090 <res 00000002>      <1> hd_media	resb	2	; media state */
   529 00000092 <res 00000002>      <1> hd_op_start	resb	2	; operation start state */
   530 00000094 <res 00000002>      <1> hd_track	resb	2	; HD present cylinder number */
   531                              <1> ; */
   532                              <1> ; Additional Keyboard flags */
   533 00000096 <res 00000001>      <1> kbd_flag3	resb	1	; mode state & type flags */
   534 00000097 <res 00000001>      <1> kbd_flag2	resb	1	; kbd LED flags */
   535                              <1> ; */
   536                              <1> ; Real Time Clock data area */
   537 00000098 <res 00000004>      <1> rtc_user_flag_addr	resd	1	; far address of user's wait flag */
   538 0000009C <res 00000004>      <1> rtc_user_wait_flag	resd	1	; user wait flag */
   539 000000A0 <res 00000001>      <1> rtc_wait_active	resb	1	; 01=busy, 80=posted, 00=post acknowledge */
   540                              <1> ; */
   541                              <1> ; Miscellaneous */
   542 000000A1 <res 00000007>      <1> rsvd_network	resb	7	; reserved for network adapters */
   543 000000A8 <res 00000004>      <1> ptr_ega_save	resd	1		; far pointer to EGA parameter control block */
   544                              <1> ; */
   545                              <1> ;	byte	rsvd_unused[84];	; reserved for 386EX usage */
   546 000000AC <res 00000002>      <1> extended_memory	resw	1	; size of Extended Memory in Kilobytes */
   547                              <1> ; this size is stored in CMOS on the PC/AT */
   548 000000AE <res 00000048>      <1> rsvd_unused	resb	72	; reserved for 386EX usage */
   549 000000F6 <res 00000008>      <1> disk_tab	resb	8  		; hard disk driver table */
   550 000000FE <res 00000002>      <1> floppy_tab	resb	2		; floppy disk driver table */
   551                              <1> ; */
   552 00000100 <res 00000001>      <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte */
   553                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   554                              <1> ; */
   555                              <1> ; Extentsion to BDA during BIOS startup */
   556 00000101 <res 00000001>      <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   557 00000102 <res 0000001F>      <1> nvram_info	resb	31	; 31 bytes of NVRAM information (this may move) */
   558 00000121 <res 00000002>      <1> CPU_freq	resw	1	; CPU frequency in kilohertz */
   559                              <1> ; */
   560                              <1> endstruc
   561                                  %include "macro.inc"
   562                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   563                              <1> ;
   564                              <1> ; some useful macros:
   565                              <1> ;
   566                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   567                              <1> ;
   568                              <1> ;
   569                              <1> ; format of the BYTE initialization table:  address, byte
   570                              <1> ;
   571                              <1> %imacro  binit 2
   572                              <1>         dw      %1
   573                              <1>         db      %2
   574                              <1> %endmacro
   575                              <1> ; end with DW -1
   576                              <1> 
   577                              <1> ;
   578                              <1> ; format of the WORD initialization table:  address, word
   579                              <1> ;
   580                              <1> %imacro  winit 2
   581                              <1>         dw      %1
   582                              <1>         dw      %2
   583                              <1> %endmacro
   584                              <1> ; end with DW -1
   585                              <1> 
   586                              <1> 
   587                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   588                              <1> %imacro get_bda	1.nolist
   589                              <1> 	push	0x0040
   590                              <1> 	pop	%1
   591                              <1> %endm
   592                              <1> 
   593                              <1> 
   594                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   595                              <1> %imacro	get_loc0 1.nolist
   596                              <1> 	push	0x0000
   597                              <1> 	pop	%1
   598                              <1> %endm
   599                              <1> 
   600                              <1> 
   601                              <1> 
   602                              <1> %imacro setloc  1.nolist
   603                              <1>  times   (%1-($-$$)) db 0FFh
   604                              <1> %endm
   605                              <1> 
   606                              <1> %imacro db_lo   1
   607                              <1>  db (%1)&255
   608                              <1> %endm
   609                              <1> 
   610                              <1> %imacro cnop    0.nolist
   611                              <1> %ifdef SOFT_DEBUG
   612                              <1> %if SOFT_DEBUG
   613                              <1>         nop
   614                              <1> %endif
   615                              <1> %endif
   616                              <1> %endm
   617                              <1> 
   618                              <1> %imacro popm 1-*.nolist
   619                              <1> %rep %0
   620                              <1> %ifidni %1,ALL
   621                              <1>  popa
   622                              <1> %elifidni %1,F
   623                              <1>  popf
   624                              <1> %else
   625                              <1>  pop %1
   626                              <1> %ifidni %1,DS
   627                              <1>  cnop
   628                              <1> %elifidni %1,ES
   629                              <1>  cnop
   630                              <1> %endif
   631                              <1> %endif
   632                              <1> %rotate 1
   633                              <1> %endrep
   634                              <1> %endm
   635                              <1> 
   636                              <1> %imacro pushm 1-*.nolist
   637                              <1> %rep %0
   638                              <1> %rotate -1
   639                              <1> %ifidni %1,ALL
   640                              <1>  pusha
   641                              <1> %elifidni %1,F
   642                              <1>  pushf
   643                              <1> %else
   644                              <1>  push %1
   645                              <1> %endif
   646                              <1> %endrep
   647                              <1> %endm
   648                              <1> 
   649                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   650                              <1> %assign __size__ (%2-1)	| 0xFF
   651                              <1> %if (__size__ <= 0xFFFF)
   652                              <1> %assign __gran__ 0
   653                              <1> %else
   654                              <1> %assign __gran__ 0xC0			; G B 0 0
   655                              <1> %endif
   656                              <1> %assign __expand__ 0
   657                              <1> %if %0==3
   658                              <1> %if %3
   659                              <1> %assign __expand__ 4
   660                              <1> %endif
   661                              <1> %endif
   662                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   663                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   664                              <1> %endm
   665                              <1> 
   666                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   667                              <1> %assign __size__ (%2-1)	| 0xFF
   668                              <1> %if (__size__ <= 0xFFFF)
   669                              <1> %assign __gran__ 0
   670                              <1> %else
   671                              <1> %assign __gran__ 0xC0			; G D 0 0
   672                              <1> %endif
   673                              <1> %assign __conform__ 0
   674                              <1> %if %0==3
   675                              <1> %if %3
   676                              <1> %assign __conform__ 4
   677                              <1> %endif
   678                              <1> %endif
   679                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   680                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   681                              <1> %endm
   682                              <1> 
   683                              <1> ;/* End of macro.inc */
   684                                  
   685                                  	global	int_11h
   686                                  	global	int_12h
   687                                  segment CODE
   688                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   689                                  ; int_11h	Get Equipment Configuration word
   690                                  ;
   691                                  ;    Enter with:
   692                                  ;	nothing
   693                                  ;
   694                                  ;    Exit with:
   695                                  ;	AX	equipment configuration word; viz.,
   696                                  ;
   697                                  ;			bits 15 14	number of printers
   698                                  ;			bit  13		used on PC,XT,PCjr only
   699                                  ;			bit  12		1=game adapter present
   700                                  ;			bits 11 10 9	number of RS-232 ports
   701                                  ;			bit  8		reserved
   702                                  ;			bits 7 6	no. of floppy drives - 1, if bit0 set
   703                                  ;			bits 5 4	initial video mode
   704                                  ;						00 - reserved
   705                                  ;						01 - 40x25 color text
   706                                  ;						10 - 80x25 color text
   707                                  ;						11 - 80x25 monochrome
   708                                  ;			bit  3		no longer used (was on PC)
   709                                  ;			bit  2		has pointing device (PS/2)
   710                                  ;			bit  1		math coprocessor (FPU) installed
   711                                  ;			bit  0		has floppy disk(s) (see bits 7 6)
   712                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   713                                  
   714                                  int_11h:
   715 00000000 FB                      	sti
   716 00000001 1E                      	push	DS	;save seg. reg.
   717 00000002 6A401F                  	get_bda	DS
   718 00000005 A11000                  	mov	ax,[equip_flag]
   719 00000008 1F                      	pop	DS
   720                                  	cnop
   721 00000009 CF                      	iret
   722                                  
   723                                  
   724                                  
   725                                  
   726                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   727                                  ; int_12h	Get Conventional Memory size in K-words
   728                                  ;
   729                                  ;    Enter with:
   730                                  ;	nothing
   731                                  ;
   732                                  ;    Exit with:
   733                                  ;	AX	number of 1K blocks below 1Mb (up to 640)
   734                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   735                                  
   736                                  int_12h:
   737 0000000A FB                      	sti
   738 0000000B 1E                      	push	DS	;save seg. reg.
   739 0000000C 6A401F                  	get_bda	DS
   740 0000000F A11300                  	mov	ax,[memory_size]
   741 00000012 1F                      	pop	DS
   742                                  	cnop
   743 00000013 CF                      	iret
   744                                  
   745                                  
