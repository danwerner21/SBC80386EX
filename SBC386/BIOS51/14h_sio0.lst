   431                              <1> defb    ASCII_LF        equ     0x0A
   432                              <1> defb    ASCII_NL        equ     0x0A
   433                              <1> defb    ASCII_FF        equ     0x0C
   434                              <1> defb    ASCII_CR        equ     0x0D
   435                              <1> defb	ASCII_ESC	equ	0x1B
   436                              <1> defb    ASCII_SP        equ     0x20
   437                              <1> defb    ASCII_DEL       equ     0x7F
   438                              <1> defb	ASCII_RUB	equ	0xFF
   439                              <1> 
   440                              <1> 
   441                              <1> ;/* End of i386EX.inc */
   442                                  %include "bda.inc"
   443                              <1> XXX
   444                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
   445                              <1> %define BDA_segment 0x40
   446                              <1> struc _BDA
   447                              <1> ; first items at 0x40:0	*/
   448 00000000 <res 00000008>      <1> serial_dev	resw	4	; serial port device codes */
   449 00000008 <res 00000008>      <1> parallel_dev	resw	4	; printer port device codes */
   450 00000010 <res 00000002>      <1> equip_flag	resw	1		; int 12h equipment flags */
   451 00000012 <res 00000001>      <1> mfg_test	resb	1		; initialization flags */
   452 00000013 <res 00000002>      <1> memory_size	resw	1	; base memory size in Kilowords (1024) */
   453 00000015 <res 00000001>      <1> mfg_err_flag	resb	1
   454 00000016 <res 00000001>      <1> mfg_err_flag2	resb	1
   455                              <1> ; */
   456                              <1> ; first Keyboard data area */
   457 00000017 <res 00000001>      <1> kbd_flag	resb	1	; shift status &c. */
   458 00000018 <res 00000001>      <1> kbd_flag1	resb	1	;  more  */
   459 00000019 <res 00000001>      <1> alt_input	resb	1	; save alternate kbd entry code */
   460 0000001A <res 00000002>      <1> buffer_head	resw	1
   461 0000001C <res 00000002>      <1> buffer_tail	resw	1
   462                              <1> ; */
   463 0000001E <res 00000020>      <1> kbd_buffer	resw	16	; buffer empty when  head==tail */
   464                              <1> ; */
   465                              <1> ; Diskette data area */
   466 0000003E <res 00000001>      <1> seek_status	resb	1	; drive recalibration status */
   467                              <1> ; bits 3..0 drive must recalibrate before next seek */
   468 0000003F <res 00000001>      <1> motor_status	resb	1	; bits 3..0 motor running */
   469                              <1> ; bit 7 current op is write */
   470 00000040 <res 00000001>      <1> motor_count	resb	1	; timeout counter for motor turn-off */
   471 00000041 <res 00000001>      <1> fd_status	resb	1	; return code status byte */
   472 00000042 <res 00000007>      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   473                              <1> ; */
   474                              <1> ; Video Display data area -- also used for video emulation */
   475 00000049 <res 00000001>      <1> vid_mode	resb	1	; current display mode */
   476 0000004A <res 00000002>      <1> vid_columns	resw	1	; no. of columns on the screen */
   477 0000004C <res 00000002>      <1> vid_buf_len	resw	1	; length of video buffer in bytes */
   478 0000004E <res 00000002>      <1> vid_start	resw	1	; start address of screen regeneration (in vid buf) */
   479 00000050 <res 00000010>      <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   480 00000060 <res 00000002>      <1> vid_cursor_mode	resw	1
   481 00000062 <res 00000001>      <1> vid_active_page	resb	1
   482 00000063 <res 00000002>      <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA) */
   483 00000065 <res 00000001>      <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   484 00000066 <res 00000001>      <1> vid_palette	resb	1	; current color setting / palette  */
   485                              <1> ; */
   486                              <1> ; POST and ROM data */
   487 00000067 <res 00000004>      <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   488                              <1> %define io_rom_addr_low io_rom_addr
   489                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   490 0000006B <res 00000001>      <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   491                              <1> ; */
   492                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   493 0000006C <res 00000002>      <1> timer_count_low	resw	1	; low word of timer count */
   494 0000006E <res 00000002>      <1> timer_count_high	resw	1
   495                              <1> %define timer_count timer_count_low
   496                              <1> ; use timer_count as the double word timer counter */
   497 00000070 <res 00000001>      <1> timer_overflow	resb	1	; timer has rolled over since last read */
   498                              <1> ; */
   499                              <1> ; System & Keboard data area */
   500 00000071 <res 00000001>      <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   501 00000072 <res 00000002>      <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   502                              <1> ; */
   503                              <1> ; Fixed (Hard) disk data area */
   504 00000074 <res 00000001>      <1> hd_status	resb	1	; status info for hard disk */
   505                              <1> %define disk_status1 hd_status
   506 00000075 <res 00000001>      <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
   507 00000076 <res 00000001>      <1> control_byte	resb	1	; head control ???? */
   508 00000077 <res 00000001>      <1> port_offset	resb	1	; obsolete, maybe ???? */
   509                              <1> ; */
   510                              <1> ; Timeout counters *;
   511 00000078 <res 00000004>      <1> printer_timeout	resb	4
   512 0000007C <res 00000004>      <1> serial_timeout	resb	4	; one byte for each interface */
   513                              <1> ; */
   514                              <1> ; Keyboard additional data area -- buffer location within segment 40h */
   515 00000080 <res 00000002>      <1> buffer_start	resw	1	; offset of keyboard buffer start */
   516 00000082 <res 00000002>      <1> buffer_end	resw	1		; offset of end of kbd buffer */
   517                              <1> ; */
   518                              <1> ; EGA/PGA? data work area (graphic mode?  probably available) */
   519 00000084 <res 00000001>      <1> ega_rows	resb	1		; rows on the active screen (less 1) */
   520 00000085 <res 00000002>      <1> ega_points	resw	1		; bytes per character	*/
   521 00000087 <res 00000001>      <1> ega_info	resb	1		; mode options ???? */
   522 00000088 <res 00000001>      <1> ega_info_3	resb	1		; switch settings */
   523 00000089 <res 00000002>      <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   524                              <1> ; */
   525                              <1> ; Disk / Diskette media data */
   526 0000008B <res 00000001>      <1> fd_last_data_rate	resb	1	; last data rate selected */
   527 0000008C <res 00000001>      <1> hd_status_reg	resb	1		; hard disk status register */
   528 0000008D <res 00000001>      <1> hd_error_reg	resb	1		; hard disk error register */
   529 0000008E <res 00000001>      <1> hd_int_flag	resb	1	; HD interrupt flag */
   530 0000008F <res 00000001>      <1> hd_cntrl	resb	1		; HD/FD combo controller bit flag */
   531 00000090 <res 00000002>      <1> hd_media	resb	2	; media state */
   532 00000092 <res 00000002>      <1> hd_op_start	resb	2	; operation start state */
   533 00000094 <res 00000002>      <1> hd_track	resb	2	; HD present cylinder number */
   534                              <1> ; */
   535                              <1> ; Additional Keyboard flags */
   536 00000096 <res 00000001>      <1> kbd_flag3	resb	1	; mode state & type flags */
   537 00000097 <res 00000001>      <1> kbd_flag2	resb	1	; kbd LED flags */
   538                              <1> ; */
   539                              <1> ; Real Time Clock data area */
   540 00000098 <res 00000004>      <1> rtc_user_flag_addr	resd	1	; far address of user's wait flag */
   541 0000009C <res 00000004>      <1> rtc_user_wait_flag	resd	1	; user wait flag */
   542 000000A0 <res 00000001>      <1> rtc_wait_active	resb	1	; 01=busy, 80=posted, 00=post acknowledge */
   543                              <1> ; */
   544                              <1> ; Miscellaneous */
   545 000000A1 <res 00000007>      <1> rsvd_network	resb	7	; reserved for network adapters */
   546 000000A8 <res 00000004>      <1> ptr_ega_save	resd	1		; far pointer to EGA parameter control block */
   547                              <1> ; */
   548                              <1> ;	byte	rsvd_unused[84];	; reserved for 386EX usage */
   549 000000AC <res 00000002>      <1> extended_memory	resw	1	; size of Extended Memory in Kilobytes */
   550                              <1> ; this size is stored in CMOS on the PC/AT */
   551 000000AE <res 00000048>      <1> rsvd_unused	resb	72	; reserved for 386EX usage */
   552 000000F6 <res 00000008>      <1> disk_tab	resb	8  		; hard disk driver table */
   553 000000FE <res 00000002>      <1> floppy_tab	resb	2		; floppy disk driver table */
   554                              <1> ; */
   555 00000100 <res 00000001>      <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte */
   556                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   557                              <1> ; */
   558                              <1> ; Extentsion to BDA during BIOS startup */
   559 00000101 <res 00000001>      <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   560 00000102 <res 0000001F>      <1> nvram_info	resb	31	; 31 bytes of NVRAM information (this may move) */
   561 00000121 <res 00000002>      <1> CPU_freq	resw	1	; CPU frequency in kilohertz */
   562                              <1> ; */
   563                              <1> endstruc
   564                                  %include "macro.inc"
   565                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   566                              <1> ;
   567                              <1> ; some useful macros:
   568                              <1> ;
   569                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   570                              <1> ;
   571                              <1> ;
   572                              <1> ; format of the BYTE initialization table:  address, byte
   573                              <1> ;
   574                              <1> %imacro  binit 2
   575                              <1>         dw      %1
   576                              <1>         db      %2
   577                              <1> %endmacro
   578                              <1> ; end with DW -1
   579                              <1> 
   580                              <1> ;
   581                              <1> ; format of the WORD initialization table:  address, word
   582                              <1> ;
   583                              <1> %imacro  winit 2
   584                              <1>         dw      %1
   585                              <1>         dw      %2
   586                              <1> %endmacro
   587                              <1> ; end with DW -1
   588                              <1> 
   589                              <1> 
   590                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   591                              <1> %imacro get_bda	1.nolist
   592                              <1> 	push	0x0040
   593                              <1> 	pop	%1
   594                              <1> %endm
   595                              <1> 
   596                              <1> 
   597                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   598                              <1> %imacro	get_loc0 1.nolist
   599                              <1> 	push	0x0000
   600                              <1> 	pop	%1
   601                              <1> %endm
   602                              <1> 
   603                              <1> 
   604                              <1> 
   605                              <1> %imacro setloc  1.nolist
   606                              <1>  times   (%1-($-$$)) db 0FFh
   607                              <1> %endm
   608                              <1> 
   609                              <1> %imacro db_lo   1
   610                              <1>  db (%1)&255
   611                              <1> %endm
   612                              <1> 
   613                              <1> %imacro cnop    0.nolist
   614                              <1> %ifdef SOFT_DEBUG
   615                              <1> %if SOFT_DEBUG
   616                              <1>         nop
   617                              <1> %endif
   618                              <1> %endif
   619                              <1> %endm
   620                              <1> 
   621                              <1> %imacro popm 1-*.nolist
   622                              <1> %rep %0
   623                              <1> %ifidni %1,ALL
   624                              <1>  popa
   625                              <1> %elifidni %1,F
   626                              <1>  popf
   627                              <1> %else
   628                              <1>  pop %1
   629                              <1> %ifidni %1,DS
   630                              <1>  cnop
   631                              <1> %elifidni %1,ES
   632                              <1>  cnop
   633                              <1> %endif
   634                              <1> %endif
   635                              <1> %rotate 1
   636                              <1> %endrep
   637                              <1> %endm
   638                              <1> 
   639                              <1> %imacro pushm 1-*.nolist
   640                              <1> %rep %0
   641                              <1> %rotate -1
   642                              <1> %ifidni %1,ALL
   643                              <1>  pusha
   644                              <1> %elifidni %1,F
   645                              <1>  pushf
   646                              <1> %else
   647                              <1>  push %1
   648                              <1> %endif
   649                              <1> %endrep
   650                              <1> %endm
   651                              <1> 
   652                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   653                              <1> %assign __size__ (%2-1)	| 0xFF
   654                              <1> %if (__size__ <= 0xFFFF)
   655                              <1> %assign __gran__ 0
   656                              <1> %else
   657                              <1> %assign __gran__ 0xC0			; G B 0 0
   658                              <1> %endif
   659                              <1> %assign __expand__ 0
   660                              <1> %if %0==3
   661                              <1> %if %3
   662                              <1> %assign __expand__ 4
   663                              <1> %endif
   664                              <1> %endif
   665                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   666                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   667                              <1> %endm
   668                              <1> 
   669                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   670                              <1> %assign __size__ (%2-1)	| 0xFF
   671                              <1> %if (__size__ <= 0xFFFF)
   672                              <1> %assign __gran__ 0
   673                              <1> %else
   674                              <1> %assign __gran__ 0xC0			; G D 0 0
   675                              <1> %endif
   676                              <1> %assign __conform__ 0
   677                              <1> %if %0==3
   678                              <1> %if %3
   679                              <1> %assign __conform__ 4
   680                              <1> %endif
   681                              <1> %endif
   682                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   683                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   684                              <1> %endm
   685                              <1> 
   686                              <1> ;/* End of macro.inc */
   687                                  
   688                                  	global	int_14h
   689                                  segment CODE
   690                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   691                                  ; int_14h	-- called with INT 0x14 with function code in AH
   692                                  ;
   693                                  ;    Enter with:
   694                                  ;	AH	function code 0, 1, 2, 3
   695                                  ;	DX	port number 0=COM1, .. 3=COM4
   696                                  ;
   697                                  ;  
   698                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   699                                  
   700                                  int_14h:
   701 00000000 FB                      	sti			; re-enable interrupts
   702 00000001 1E525153                	pushm	BX,CX,DX,DS	; AX is usually a return value
   703 00000005 6A401F                  	get_bda	DS		;get DS = segment pointer to BDA
   704 00000008 8B0E1000                	mov	cx,[equip_flag]	; equipment flag in BDA
   705 0000000C C1E909                  	shr	cx,9		;number of RS-232 ports
   706 0000000F 83E107                  	and	cx,7		; **
   707 00000012 89D3                    	mov	bx,dx		; COM1==0, COM2==1, ...
   708 00000014 39CB                    	cmp	bx,cx		; 4 COM ports at most
   709 00000016 731F                    	jae	bad_error
   710                                  
   711                                  ; the index in BX is below the number in CX
   712 00000018 01DB                    	add	bx,bx
   713 0000001A 8B17                    	mov	dx,[serial_dev + BX]
   714 0000001C 09D2                    	or	dx,dx
   715 0000001E 7417                    	jz	bad_error
   716 00000020 89D1                    	mov	cx,dx		; CX = base
   717 00000022 83C205                  	add	dx,LSR0-TBR0	; DX = Line Status Register
   718                                  ;
   719                                  ; we have the I/O base device code in DX
   720                                  ;
   721 00000025 08E4                    	or	ah,ah		; test for 0
   722 00000027 7465                    	jz	init_sio
   723 00000029 FECC                    	dec	ah
   724 0000002B 7449                    	jz	write		; function 1
   725 0000002D FECC                    	dec	ah
   726 0000002F 742F                    	jz	read		; function 2
   727 00000031 FECC                    	dec	ah
   728 00000033 0F848500                	jz	status		; function 3
   729                                  ;
   730                                  ; the PS/2 functions are not implemented
   731                                  ;
   732                                  bad_error:
   733 00000037 B80F8E                  	mov	ax,0x8E0F	; AH.7 = timeout
   734                                  return_AX:
   735 0000003A 5B595A1F                	popm	BX,CX,DX,DS	; restore the registers
   736 0000003E CF                      	iret
   737                                  
   738                                  
   739                                  
   740                                  SHIFT	equ	0		; set to 2 for 7.3728 mhz on 4UART
   741                                  OSC	equ	1843200<<SHIFT
   742                                  CLK	equ	OSC/16
   743                                  
   744                                  	global	sio_divisors
   745                                  sio_divisors:
   746 0000003F 1704                    	dw	CLK/110		;0
   747 00000041 0003                    	dw	CLK/150
   748 00000043 8001                    	dw	CLK/300
   749 00000045 C000                    	dw	CLK/600
   750 00000047 6000                    	dw	CLK/1200	;5
   751 00000049 3000                    	dw	CLK/2400
   752 0000004B 1800                    	dw	CLK/4800
   753 0000004D 0C00                    	dw	CLK/9600	;7
   754                                  ; for the extended initialization call (PS/2)
   755 0000004F 0600                    	dw	CLK/19200	;8
   756 00000051 0300                    	dw	CLK/38400
   757 00000053 0200                    	dw	CLK/56000	; actually 57600
   758 00000055 0100                    	dw	CLK/115200	;11
   759                                  %if SHIFT
   760                                  	dw	CLK/230400	;12
   761                                  	dw	CLK/460800	;13
   762                                  %endif
   763                                  
   764                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   765                                  ; get_status
   766                                  ;
   767                                  ;    Enter with:
   768                                  ;	CX	port base I/O address
   769                                  ;	DX	LSR I/O address
   770                                  ;
   771                                  ;    Exit with:
   772                                  ;	AH	line status
   773                                  ;	AL	modem status
   774                                  ;
   775                                  ;	CX	port I/O base address
   776                                  ;
   777                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   778                                  get_status:
   779 00000057 EC                      	in	al,dx		; get line status
   780 00000058 247F                    	and	al,7Fh		; clear undefined bit
   781 0000005A 88C4                    	mov	ah,al		; will return in AH
   782 0000005C 42                      	inc	dx		; MSR0 in DX
   783 0000005D EC                      	in	al,dx		; line status to AL
   784 0000005E 4A                      	dec	dx
   785 0000005F C3                      	ret
   786                                  
   787                                  
   788                                  
   789                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   790                                  ; read
   791                                  ;
   792                                  ;    Enter with:
   793                                  ;	CX	base port address
   794                                  ;	DX	LSR port address
   795                                  ;
   796                                  ;    Exit with:
   797                                  ;	AH	port (line) status
   798                                  ;	AL	character read
   799                                  ;	CX,DX	unchanged
   800                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   801                                  
   802                                  read:
   803 00000060 E8F4FF                  	call	get_status
   804 00000063 F6C401                  	test	ah,LSR_RBF	;anything in the buffer
   805 00000066 74F8                    	jz	read
   806                                  
   807 00000068 87CA                    	xchg	cx,dx		;RBR to DX
   808 0000006A EC                      	in	al,dx		;get the character
   809 0000006B 87CA                    	xchg	cx,dx		;LSR to DX
   810 0000006D 88C3                    	mov	bl,al		; save char read in
   811 0000006F E8E5FF                  	call	get_status
   812 00000072 88D8                    	mov	al,bl		;return char in AL, LSR in AH
   813 00000074 EBC4                    	jmp	return_AX
   814                                  
   815                                  
   816                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   817                                  ; write
   818                                  ;
   819                                  ;    Enter with:
   820                                  ;	AL	character to write
   821                                  ;	CX	base port address
   822                                  ;	DX	LSR port address
   823                                  ;
   824                                  ;    Exit with:
   825                                  ;	AH	port (line) status
   826                                  ;	AL	unchanged char
   827                                  ;	CX,DX	unchanged
   828                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   829                                  
   830                                  write:
   831 00000076 88C3                    	mov	bl,al		;save output character
   832                                  .1:
   833 00000078 E8DCFF                  	call	get_status	;line status to AH
   834 0000007B F6C420                  	test	ah,LSR_TBE	;buffer empty?
   835 0000007E 74F8                    	jz	.1
   836                                  
   837 00000080 87CA                    	xchg	cx,dx		;DX = base (TBR)
   838 00000082 88D8                    	mov	al,bl		; AL = character
   839 00000084 EE                      	out	dx,al		; put it out
   840 00000085 87CA                    	xchg	cx,dx		;DX = LSR again
   841 00000087 E8CDFF                  	call	get_status
   842 0000008A 88D8                    	mov	al,bl		;restore char in AL
   843 0000008C EBAC                    	jmp	return_AX
   844                                  
   845                                  
   846                                  
   847                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   848                                  ; init_sio
   849                                  ;
   850                                  ;    Enter with:
   851                                  ;	AL	initialization parameters
   852                                  ;			bits 7 6 5	data rate
   853                                  ;			bits 4 3	parity x0=none, 01=odd, 11=even
   854                                  ;			bit  2		stop bits 0->1, 1->2 stop bits
   855                                  ;			bits 1 0	word length 10->7 11->8 bits
   856                                  ;	CX	base port address
   857                                  ;	DX	LSR port address
   858                                  ;
   859                                  ;    Exit with:
   860                                  ;	AH	port (line) status
   861                                  ;	AL	modem status
   862                                  ;	CX,DX	unchanged
   863                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   864                                  
   865                                  init_sio:
   866 0000008E 88C4                    	mov	ah,al		;save init bits in AH
   867 00000090 4A                      	dec	dx
   868 00000091 4A                      	dec	dx		; LSR-2 is LCR
   869 00000092 B080                    	mov	al,80h		; set Latch enable
   870 00000094 EE                      	out	dx,al		;enable divisor latch
   871 00000095 88E3                    	mov	bl,ah		;data rate bits to BX.765
   872 00000097 C1EB04                  	shr	bx,4		;  to bits 321
   873 0000009A 83E30E                  	and	bx,0x0E		;mask bits
   874 0000009D 2E8B9F[3F00]               cs	mov	bx,[sio_divisors + bx]
   875 000000A2 88D8                       	mov	al,bl		; low divisor
   876 000000A4 87CA                    	xchg	cx,dx		; DLL to DX
   877 000000A6 EE                      	out	dx,al
   878 000000A7 42                      	inc	dx		; DLH to DX (also IER)
   879 000000A8 88F8                    	mov	al,bh		;high divisor
   880 000000AA EE                      	out	dx,al
   881 000000AB 87CA                    	xchg	cx,dx		;LCR to DX, IER to CX
   882 000000AD B01F                    	mov	al,00011111b	;mask for status bits
   883 000000AF 20E0                    	and	al,ah		;mask bits, clear DLAB
   884 000000B1 EE                      	out	dx,al
   885 000000B2 42                      	inc	dx
   886 000000B3 42                      	inc	dx	 	;LCR+2 = LSR
   887 000000B4 87CA                    	xchg	cx,dx		; IER to DX
   888 000000B6 31C0                    	xor	ax,ax
   889 000000B8 EE                      	out	dx,al		;turn off all interrupts
   890 000000B9 4A                      	dec	dx		;base to DX
   891 000000BA 87CA                    	xchg	cx,dx		;base to CX, LSR to DX
   892                                  ;  return status in AH,AL
   893                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   894                                  ; status
   895                                  ;
   896                                  ;    Enter with:
   897                                  ;	CX	base port address
   898                                  ;	DX	LSR port address
   899                                  ;
   900                                  ;    Exit with:
   901                                  ;	AH	port (line) status
   902                                  ;	AL	modem status
   903                                  ;	CX,DX	unchanged
   904                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   905                                  
   906                                  status:
   907 000000BC E898FF                  	call	get_status
   908 000000BF E978FF                  	jmp	return_AX
   909                                  
   910                                  
   911                                  
   912                                  
   913                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   914                                  ; install_SIO0_		install the system board SIO0 (internal) 386EX port
   915                                  ;
   916                                  ;    Enter with:
   917                                  ;	AX	device code to install
   918                                  ;	direction flag clear
   919                                  ;
   920                                  ;    Exit with:
   921                                  ;	AX	0 if successful
   922                                  ;		non-Zero if error
   923                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   924                                  
   925                                  	global	install_SIO0_
   926                                  segment _TEXT			; this routine is C-callable
   927                                  
   928                                  install_SIO0_:
   929 00000000 1E565152                	pushm	DX,CX,SI,DS
   930 00000004 89C2                    	mov	dx,ax		; use device code in DX
   931 00000006 6A401F                  	get_bda	DS		; get BIOS Data Area segment pointer
   932 00000009 8D360000                	lea	SI,[serial_dev]
   933 0000000D B90400                  	mov	cx,4
   934                                  .1:
   935 00000010 AD                      	lodsw			; get a device code
   936 00000011 39D0                       	cmp	ax,dx		; is it already there
   937 00000013 7412                    	je	.8
   938 00000015 09C0                    	or	ax,ax		; is the slot empty
   939 00000017 7404                    	jz	.3		; empty if 0, install here
   940 00000019 E2F5                    	loop	.1
   941 0000001B EB0A                    	jmp	.8		; no empty slot
   942                                  
   943                                  ; empty slot found SI is already incremented
   944 0000001D 8954FE                  .3:	mov	[si-2],dx	;set device code
   945 00000020 8006110002              	add	byte [equip_flag+1], 1<<(9-8)	; increment at bit 9
   946 00000025 EB03                    	jmp	.9		; AX is already zero
   947                                  
   948 00000027 B88E00                  .8:	mov	ax,0x8E		;
   949 0000002A 5A595E1F                .9:	popm	DX,CX,SI,DS
   950 0000002E C3                      	ret
