    34                              <1> ; SEG_DEF.inc
    35                              <1> ;
    36                              <1> %ifndef SEG_DEF
    37                              <1> %define SEG_DEF 1
    38                              <1> 
    39                              <1> segment CODE	use16	align=16	class=CODE	public
    40                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    41                              <1> 
    42                              <1> segment CONST		align=16	class=DATA	public
    43                              <1> segment CONST2		align=2		class=DATA	public
    44                              <1> segment _DATA		align=16	class=DATA	public
    45                              <1> segment _BSS		align=16	class=DATA	public
    46                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    47                              <1> 
    48                              <1> group DGROUP CODE _TEXT CONST2 CONST _DATA _BSS
    49                              <1> 
    50                              <1> 
    51                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    52                              <1> 
    53                              <1> %define XXX
    54                              <1> %endif
    55                              <1> ;
    56                              <1> ; end SEG_DEF.inc
