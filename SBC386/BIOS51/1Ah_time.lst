   926                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   927                                  ;
   928                                  ; INT 1A
   929                                  ; function 20   Get NVRAM byte
   930                                  ;
   931                                  ; Enter with:
   932                                  ;       AH      0x20
   933                                  ;       AL      byte number ( 0 <= AL <= 30) 
   934                                  ;   (single byte read)
   935                                  ;
   936                                  ;       AH      0x20
   937                                  ;       AL      31
   938                                  ;       ES:BX   pointer to 31 byte buffer
   939                                  ;   (burst read)
   940                                  ;
   941                                  ; Exit with:
   942                                  ;       AL      byte read (single byte read)
   943                                  ;       Carry clear
   944                                  ;
   945                                  ;       AL      byte NVRAM[30] (burst read)
   946                                  ;       ES:BX buffer filled with bytes 0..30
   947                                  ;
   948                                  ;       Carry clear
   949                                  ;
   950                                  ; Error:
   951                                  ;       Carry set
   952                                  ;
   953                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   954                                  	global	ds_read
   955                                  ds_read:
   956 000000CE 5250                            pushm   ax,dx
   957                                  
   958 000000D0 3C1F                    	cmp	al,31
   959 000000D2 7311                    	jae	ds_burstr	; burst or error
   960                                  	
   961 000000D4 B4C1                    	mov	ah,1100_0001B	; NVRAM read
   962 000000D6 E82E00                   	call	byte_read
   963                                  
   964                                  ds_read_exit:
   965 000000D9 88E0                    	mov	al,ah		;return in AL
   966 000000DB 5A                      	pop	dx		;get old ax
   967 000000DC 88F4                    	mov	ah,dh		;restore AH
   968                                  ds_good_exit:
   969 000000DE F8                      	clc 			;signal good return
   970                                  ds_exit:
   971 000000DF 5A                      	popm	dx
   972 000000E0 C3                      	ret	
   973                                  ;	IRET or  "retf 2"
   974                                  
   975                                  
   976                                  ds_error:
   977 000000E1 58                      	popm	ax
   978 000000E2 F9                      	stc
   979 000000E3 EBFA                    	jmp    ds_exit
   980                                  
   981                                  
   982                                  
   983                                  
   984                                  ;
   985                                  ; handle burst read
   986                                  ds_burstr:
   987 000000E5 75FA                            jne	ds_error	;must be 31 exactly, else error
   988                                  
   989 000000E7 5153                    	pushm	bx,cx		;extra save
   990                                  
   991 000000E9 E87C00                  	call	ds_reset_on	;reset before command byte
   992 000000EC E88A00                  	call	ds_reset_off	;set for read
   993                                  
   994                                  
   995 000000EF B4FF                    	mov	ah,1111_1111B	;burst read command
   996 000000F1 E89200                  	call	ds_outb		;output the command
   997                                  
   998 000000F4 B91F00                  	mov	cx,31		;
   999                                  ds_read2:
  1000 000000F7 E8A200                  	call	ds_inb		;retrieve a byte in AH
  1001 000000FA 268827                    es	mov	byte [bx],ah	;save in the array
  1002 000000FD 43                        	inc	bx
  1003 000000FE E2F7                    	loop	ds_read2	;and loop back
  1004                                  
  1005 00000100 E86500                  	call	ds_reset_on	;terminate read
  1006                                  
  1007 00000103 5B59                    	popm	bx,cx		;and restore
  1008 00000105 EBD2                            jmp	ds_read_exit	;return AH
  1009                                   
  1010                                  
  1011                                  ; byte read into AH
  1012                                  ;	AH = command bits
  1013                                  ;	AL = register number
  1014                                  ;
  1015                                  ;  Uses AX, DX
  1016                                  ;
  1017                                  byte_read:
  1018                                  ; single byte read
  1019 00000107 D0E0                    	shl	al,1		; shift by one
  1020 00000109 08E0                            or      al,ah		; Clock or NVRAM read
  1021 0000010B 88C4                    	mov	ah,al		; command byte to AH
  1022                                  
  1023 0000010D E85800                  	call	ds_reset_on	;start of command, set AL & DX
  1024 00000110 E86600                  	call	ds_reset_off	;remove the Reset
  1025                                  
  1026                                  ; output the command
  1027 00000113 E87000                          call    ds_outb
  1028                                  
  1029 00000116 E88300                  	call	ds_inb		;input byte to AH
  1030                                  
  1031 00000119 E84C00                  	call	ds_reset_on	;terminate command
  1032                                  
  1033 0000011C C3                      	ret
  1034                                  
  1035                                  
  1036                                  
  1037                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1038                                  ;
  1039                                  ; INT 1A
  1040                                  ; function 21   Set NVRAM byte
  1041                                  ;
  1042                                  ; Enter with:
  1043                                  ;       AH      0x21
  1044                                  ;       AL      byte number ( 0 <= AL <= 30) 
  1045                                  ;   (single byte write)
  1046                                  ;       CL      byte value to write
  1047                                  ;
  1048                                  ;       AH      0x21
  1049                                  ;       AL      31
  1050                                  ;       ES:BX   pointer to 31 byte buffer
  1051                                  ;   (burst write)
  1052                                  ;
  1053                                  ; Exit with:
  1054                                  ;       Carry clear
  1055                                  ;
  1056                                  ; Error:
  1057                                  ;       Carry set
  1058                                  ;
  1059                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1060                                  ds_write:
  1061 0000011D 5250                            pushm   ax,dx
  1062                                  
  1063 0000011F 3C1F                    	cmp	al,31
  1064 00000121 731A                    	jae	ds_burstw	; burst or error
  1065                                  
  1066                                  ; single byte write
  1067 00000123 D0E0                    	shl	al,1		; prepare command
  1068 00000125 0CC0                            or      al,1100_0000B   ; RAM/WRITE
  1069 00000127 88C4                    	mov	ah,al		; command byte to AH
  1070                                  
  1071 00000129 E83C00                  	call	ds_reset_on	;start of command, set AL & DX
  1072 0000012C E84A00                  	call	ds_reset_off	;prepare for read
  1073                                  
  1074                                  ; output the command, will turn Reset off
  1075 0000012F E85400                          call    ds_outb
  1076                                  
  1077 00000132 88CC                            mov     ah,cl		;single byte to write
  1078 00000134 E84F00                          call    ds_outb
  1079                                  
  1080 00000137 E82E00                  	call	ds_reset_on	;terminate the write
  1081                                  
  1082                                  ds_full_exit:
  1083 0000013A 58                      	popm	ax
  1084 0000013B EBA1                    	jmp	ds_good_exit
  1085                                  
  1086                                  	
  1087                                  	
  1088                                  ; burst write
  1089                                  ds_burstw:
  1090 0000013D 75A2                            jne	ds_error	;must be 31 exactly, else error
  1091                                  
  1092 0000013F 5153                    	pushm	bx,cx		;extra save
  1093                                  
  1094 00000141 E82400                  	call	ds_reset_on	;reset before command byte
  1095 00000144 E83200                  	call	ds_reset_off	;prepare for burst write
  1096                                  
  1097 00000147 B4FE                    	mov	ah,1111_1110B	;burst write command
  1098 00000149 E83A00                  	call	ds_outb		;output the command
  1099                                  
  1100 0000014C B91F00                  	mov	cx,31		;
  1101                                  ds_write2:
  1102 0000014F 268A27                     es	mov	ah,byte [bx]	;get byte to write
  1103 00000152 E83100                     	call	ds_outb
  1104 00000155 43                      	inc	bx		;increment
  1105 00000156 E2F7                    	loop	ds_write2
  1106                                  
  1107 00000158 E80D00                  	call	ds_reset_on	;terminate the write
  1108                                  
  1109 0000015B 5B59                    	popm	bx,cx
  1110 0000015D EBDB                    	jmp	ds_full_exit	;restore & return
  1111                                  
  1112                                  
  1113                                  
  1114                                  ;**********
  1115                                  ; N.B. These will move to P1 from P3 on the final board
  1116                                  ; Jan 2018 -- updated to P1 for rev 2.0 board
  1117                                  ;**********
  1118                                  DSLTC   equ     P1LTC           ; DS1302 latch
  1119                                  DSPIN   equ     P1PIN           ;   pin value
  1120                                  
  1121                                  DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
  1122                                  DSCLK   equ     BIT2            ; Clock idles high
  1123                                  DSRST   equ     BIT3            ; Reset idles low (asserted)
  1124                                  
  1125                                  DSMSK   equ     DSRST+DSCLK+DSDAT
  1126                                  
  1127                                  
  1128                                  %macro  us_delay 0
  1129                                          jmp     $+2
  1130                                          jmp     $+2
  1131                                          jmp     $+2
  1132                                  %endmacro
  1133                                  
  1134                                  
  1135 0000015F 90                      	align	2
  1136                                  ds_out_latch:
  1137 00000160 EE                      	out	dx,al
  1138                                  	us_delay
  1139 00000161 EB00                <1>  jmp $+2
  1140 00000163 EB00                <1>  jmp $+2
  1141 00000165 EB00                <1>  jmp $+2
  1142 00000167 C3                      	ret
  1143                                  
  1144                                  ;
  1145                                  ; initializes the DSLTC in DX
  1146                                  ; sets the Clock low, then asserts Reset
  1147                                  ;
  1148                                  ds_reset_on:
  1149 00000168 BA62F8                  	mov	dx,DSLTC	;set I/O latch address in DX
  1150 0000016B EC                      	in	al,dx		;get the latch value
  1151 0000016C 24FB                    	and	al,~DSCLK	;set the clock low (should be idle state)
  1152 0000016E 0C01                    	or	al,DSDAT	;set data for input
  1153 00000170 E8EDFF                  	call	ds_out_latch
  1154 00000173 24F7                    	and	al,~DSRST	;assert RESET#
  1155 00000175 E8E8FF                  	call	ds_out_latch
  1156 00000178 C3                      	ret
  1157                                  
  1158                                  ;
  1159                                  ; sets the Clock low, then removes the Reset
  1160                                  ;
  1161                                  ds_reset_off:		; assume DX is set
  1162 00000179 24FB                    	and	al,~DSCLK	;set the clock low (idle)
  1163 0000017B 0C01                    	or	al,DSDAT	;set data for input
  1164 0000017D E8E0FF                  	call	ds_out_latch
  1165 00000180 0C08                    	or	al,DSRST	;deassert RESET#
  1166 00000182 E8DBFF                  	call	ds_out_latch
  1167 00000185 C3                      	ret			;clock idles low
  1168                                  
  1169                                  ;
  1170                                  ; moves output bit into position, and then drops the clock low
  1171                                  ; pauses, then sets the clock high to clock in the data bit
  1172                                  ; loops back for all 8 bits
  1173                                  ; exits with the clock HIGH
  1174                                  ;
  1175                                  ds_outb:	;output the byte in AH
  1176 00000186 51                      	pushm	cx
  1177 00000187 B90800                  	mov	cx,8		;8 bits go out
  1178                                  
  1179 0000018A 24FB                    .1:	and	al,~DSCLK	;drop the clock
  1180 0000018C D1E8                    	shr	ax,1		;LSB to AL
  1181 0000018E D0C0                    	rol	al,1		;data bit to position
  1182 00000190 E8CDFF                  	call	ds_out_latch
  1183 00000193 0C04                    	or	al,DSCLK	
  1184 00000195 E8C8FF                  	call	ds_out_latch
  1185 00000198 E2F0                    	loop	.1
  1186                                  
  1187 0000019A 59                      	popm	cx
  1188 0000019B C3                         	ret			;clock is high on exit
  1189                                  
  1190                                  ;
  1191                                  ; sets clock High and data bit for input
  1192                                  ; pauses, drops the clock, pauses, reads the data bit
  1193                                  ; shifts 8 bits into AH from the left, hence LSB ends up in AX bit 8
  1194                                  ; exits with the clock low
  1195                                  ;
  1196                                  ds_inb:		;input a byte to AH
  1197 0000019C 51                      	pushm	cx
  1198 0000019D B90800                  	mov	cx,8
  1199                                  
  1200 000001A0 0C05                    .2:	or	al,DSCLK+DSDAT	;raise the clock, O.C. data set for input
  1201 000001A2 E8BBFF                  	call	ds_out_latch
  1202 000001A5 24FB                    	and	al,~DSCLK	;drop the clock
  1203 000001A7 E8B6FF                  	call	ds_out_latch
  1204 000001AA 52                      	push	dx
  1205 000001AB BA60F8                     	mov	dx,DSPIN	;set to read data bit
  1206 000001AE EC                      	in	al,dx		;data bit to LSB
  1207 000001AF 5A                      	pop	dx
  1208 000001B0 D1C8                    	ror	ax,1		;data to AH MSB
  1209 000001B2 D0E0                    	shl	al,1		;restore latch value just read in
  1210 000001B4 E2EA                    	loop	.2
  1211                                  
  1212 000001B6 59                      	popm	cx
  1213 000001B7 C3                      	ret		; exit with clock Low
  1214                                  
