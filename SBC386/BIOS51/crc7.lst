    31                                  %include "seg_def.inc"
    32                              <1> ; SEG_DEF.inc
    33                              <1> ;
    34                              <1> %ifndef SEG_DEF
    35                              <1> %define SEG_DEF 1
    36                              <1> 
    37                              <1> segment CODE	use16	align=16	class=CODE	public
    38                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    39                              <1> 
    40                              <1> segment CONST		align=16	class=DATA	public
    41                              <1> segment CONST2		align=2		class=DATA	public
    42                              <1> segment _DATA		align=16	class=DATA	public
    43                              <1> segment _BSS		align=16	class=DATA	public
    44                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    45                              <1> 
    46                              <1> group DGROUP CODE _TEXT CONST2 CONST _DATA _BSS
    47                              <1> 
    48                              <1> 
    49                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    50                              <1> 
    51                              <1> %define XXX
    52                              <1> %endif
    53                              <1> ;
    54                              <1> ; end SEG_DEF.inc
    55                                  %include "macro.inc"
    56                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    57                              <1> ;
    58                              <1> ; some useful macros:
    59                              <1> ;
    60                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    61                              <1> ;
    62                              <1> ;
    63                              <1> ; format of the BYTE initialization table:  address, byte
    64                              <1> ;
    65                              <1> %imacro  binit 2
    66                              <1>         dw      %1
    67                              <1>         db      %2
    68                              <1> %endmacro
    69                              <1> ; end with DW -1
    70                              <1> 
    71                              <1> ;
    72                              <1> ; format of the WORD initialization table:  address, word
    73                              <1> ;
    74                              <1> %imacro  winit 2
    75                              <1>         dw      %1
    76                              <1>         dw      %2
    77                              <1> %endmacro
    78                              <1> ; end with DW -1
    79                              <1> 
    80                              <1> 
    81                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
    82                              <1> %imacro get_bda	1.nolist
    83                              <1> 	push	0x0040
    84                              <1> 	pop	%1
    85                              <1> %endm
    86                              <1> 
    87                              <1> 
    88                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
    89                              <1> %imacro	get_loc0 1.nolist
    90                              <1> 	push	0x0000
    91                              <1> 	pop	%1
    92                              <1> %endm
    93                              <1> 
    94                              <1> 
    95                              <1> 
    96                              <1> %imacro setloc  1.nolist
    97                              <1>  times   (%1-($-$$)) db 0FFh
    98                              <1> %endm
    99                              <1> 
   100                              <1> %imacro db_lo   1
   101                              <1>  db (%1)&255
   102                              <1> %endm
   103                              <1> 
   104                              <1> %imacro cnop    0.nolist
   105                              <1> %ifdef SOFT_DEBUG
   106                              <1> %if SOFT_DEBUG
   107                              <1>         nop
   108                              <1> %endif
   109                              <1> %endif
   110                              <1> %endm
   111                              <1> 
   112                              <1> %imacro popm 1-*.nolist
   113                              <1> %rep %0
   114                              <1> %ifidni %1,ALL
   115                              <1>  popa
   116                              <1> %elifidni %1,F
   117                              <1>  popf
   118                              <1> %else
   119                              <1>  pop %1
   120                              <1> %ifidni %1,DS
   121                              <1>  cnop
   122                              <1> %elifidni %1,ES
   123                              <1>  cnop
   124                              <1> %endif
   125                              <1> %endif
   126                              <1> %rotate 1
   127                              <1> %endrep
   128                              <1> %endm
   129                              <1> 
   130                              <1> %imacro pushm 1-*.nolist
   131                              <1> %rep %0
   132                              <1> %rotate -1
   133                              <1> %ifidni %1,ALL
   134                              <1>  pusha
   135                              <1> %elifidni %1,F
   136                              <1>  pushf
   137                              <1> %else
   138                              <1>  push %1
   139                              <1> %endif
   140                              <1> %endrep
   141                              <1> %endm
   142                              <1> 
   143                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   144                              <1> %assign __size__ (%2-1)	| 0xFF
   145                              <1> %if (__size__ <= 0xFFFF)
   146                              <1> %assign __gran__ 0
   147                              <1> %else
   148                              <1> %assign __gran__ 0xC0			; G B 0 0
   149                              <1> %endif
   150                              <1> %assign __expand__ 0
   151                              <1> %if %0==3
   152                              <1> %if %3
   153                              <1> %assign __expand__ 4
   154                              <1> %endif
   155                              <1> %endif
   156                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   157                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   158                              <1> %endm
   159                              <1> 
   160                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   161                              <1> %assign __size__ (%2-1)	| 0xFF
   162                              <1> %if (__size__ <= 0xFFFF)
   163                              <1> %assign __gran__ 0
   164                              <1> %else
   165                              <1> %assign __gran__ 0xC0			; G D 0 0
   166                              <1> %endif
   167                              <1> %assign __conform__ 0
   168                              <1> %if %0==3
   169                              <1> %if %3
   170                              <1> %assign __conform__ 4
   171                              <1> %endif
   172                              <1> %endif
   173                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   174                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   175                              <1> %endm
   176                              <1> 
   177                              <1> ;/* End of macro.inc */
   178                                  
   179                                  segment	CODE
   180                                  
   181                                  %ifndef CRC16
   182                                  %define CRC16 0		; don't include CRC16 calculations
   183                                  %endif
   184                                  %ifndef CRC7
   185                                  %define CRC7 0
   186                                  %endif
   187                                  
   188                                  
   189                                  %if CRC7
   190                                  %if CRC7==1
   191                                  CRC7poly	equ	00100001b	; 8-bit polynomial
   192                                  %else
   193                                  CRC7poly	equ	00010010b
   194                                  %endif
   195                                  
   196                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   197                                  ; crc7	calculate a CRC7 polynomial
   198                                  ;    /* THIS CODE DIFFERS FROM THE crc7 USED WITH THE SDCARDs */
   199                                  ; calcCRC7  calculate CRC7 for the SDcard (no OR of last bit)
   200                                  ;
   201                                  ;  Enter with:
   202                                  ;	ES:BX	points at a string of bytes
   203                                  ;	CX	count of bytes in the string
   204                                  ;	direction flag clear
   205                                  ;
   206                                  ;  Return with:
   207                                  ;	ES:BX	point at next byte beyond end of string
   208                                  ;	CX = 0
   209                                  ;	AL = CRC7 polynomial byte
   210                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   211                                  %if CRC7==2
   212                                  	global	calcCRC7
   213                                  calcCRC7:
   214                                  %else
   215                                  	global	crc7
   216                                  crc7:
   217                                  %endif
   218 00000000 52                      	push	dx
   219 00000001 30D2                    	xor	dl,dl		; start CRC7 at zero
   220                                  .1:
   221 00000003 268A07                     es	mov	al,[bx]		; get next byte
   222 00000006 43                         	inc	bx
   223 00000007 B608                    	mov	dh,8 			; 8 bits in AL
   224                                  .11:	
   225 00000009 88D4                    	mov	ah,dl			; copy CRC to AH
   226 0000000B 30C4                    	xor	ah,al			; Sign bit is 0 or 1
   227 0000000D D1E0                    	shl	ax,1
   228 0000000F 18E4                    	sbb	ah,ah			; AH is 0 or -1
   229 00000011 D0E2                    	shl	dl,1			; shift polynomial
   230                                  
   231 00000013 80E421                  	and	ah,CRC7poly		; get bits to add into the CRC
   232                                  ; USE CRC7=1 FOR 8-BIT, CRC7=2 FOR 7-BIT (SDcards)
   233                                  
   234 00000016 30E2                    	xor	dl,ah			; update the polynomial
   235 00000018 FECE                    	dec	dh
   236 0000001A 75ED                    	jnz	.11
   237                                  
   238 0000001C E2E5                    	loop	.1
   239                                  
   240 0000001E 88D0                    	mov	al,dl		; final CRC7 to AL
   241 00000020 5A                      	pop	dx
   242 00000021 C3                      	ret
   243                                  
   244                                  %endif
   245                                  
   246                                  
   247                                  
   248                                  %if CRC16
   249                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   250                                  ; crc16		add data to the input CRC16 calculation
   251                                  ;
   252                                  ;  Enter with:
   253                                  ;	ES:BX	data pointer
   254                                  ;	CX	count of bytes
   255                                  ;	AX	partial CRC16 sum
   256                                  ;
   257                                  ;  Return with:
   258                                  ;	ES:BX	updated data pointer
   259                                  ;	CX = 0
   260                                  ;	AX	updated CRC16 sum
   261                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   262                                  	global	crc16
   263                                  crc16:
   264                                  	pushm	si		; save SI
   265                                  
   266                                  	mov	si,bx		; use ES:SI to address data
   267                                  .2:
   268                                  	mov	bl,ah		; form index into table
   269                                  	xor	bh,bh		; zap BH
   270                                    es	xor	bl,[si]		; form table index
   271                                    	inc	si
   272                                    	mov	ah,al		; update CRC16
   273                                  	xor	al,al
   274                                  	shl	bx,1
   275                                    cs	xor	ax,[crc16tab + bx]
   276                                    	loop	.2
   277                                  
   278                                  	mov	bx,si		; updated BX value
   279                                  	popm	si
   280                                  	ret
   281                                  
   282                                  
   283                                  	align	2
   284                                  %include "crc16tab.inc"
   285                                  
   286                                  %endif
   287                                  
   288                                  ; end crc.asm
   289                                  
