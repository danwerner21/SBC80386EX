   490                                  %include "macro.inc"
   491                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   492                              <1> ;
   493                              <1> ; some useful macros:
   494                              <1> ;
   495                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   496                              <1> ;
   497                              <1> ;
   498                              <1> ; format of the BYTE initialization table:  address, byte
   499                              <1> ;
   500                              <1> %imacro  binit 2
   501                              <1>         dw      %1
   502                              <1>         db      %2
   503                              <1> %endmacro
   504                              <1> ; end with DW -1
   505                              <1> 
   506                              <1> ;
   507                              <1> ; format of the WORD initialization table:  address, word
   508                              <1> ;
   509                              <1> %imacro  winit 2
   510                              <1>         dw      %1
   511                              <1>         dw      %2
   512                              <1> %endmacro
   513                              <1> ; end with DW -1
   514                              <1> 
   515                              <1> 
   516                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   517                              <1> %imacro get_bda	1.nolist
   518                              <1> 	push	0x0040
   519                              <1> 	pop	%1
   520                              <1> %endm
   521                              <1> 
   522                              <1> 
   523                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   524                              <1> %imacro	get_loc0 1.nolist
   525                              <1> 	push	0x0000
   526                              <1> 	pop	%1
   527                              <1> %endm
   528                              <1> 
   529                              <1> 
   530                              <1> 
   531                              <1> %imacro setloc  1.nolist
   532                              <1>  times   (%1-($-$$)) db 0FFh
   533                              <1> %endm
   534                              <1> 
   535                              <1> %imacro db_lo   1
   536                              <1>  db (%1)&255
   537                              <1> %endm
   538                              <1> 
   539                              <1> %imacro cnop    0.nolist
   540                              <1> %ifdef SOFT_DEBUG
   541                              <1> %if SOFT_DEBUG
   542                              <1>         nop
   543                              <1> %endif
   544                              <1> %endif
   545                              <1> %endm
   546                              <1> 
   547                              <1> %imacro popm 1-*.nolist
   548                              <1> %rep %0
   549                              <1> %ifidni %1,ALL
   550                              <1>  popa
   551                              <1> %elifidni %1,F
   552                              <1>  popf
   553                              <1> %else
   554                              <1>  pop %1
   555                              <1> %ifidni %1,DS
   556                              <1>  cnop
   557                              <1> %elifidni %1,ES
   558                              <1>  cnop
   559                              <1> %endif
   560                              <1> %endif
   561                              <1> %rotate 1
   562                              <1> %endrep
   563                              <1> %endm
   564                              <1> 
   565                              <1> %imacro pushm 1-*.nolist
   566                              <1> %rep %0
   567                              <1> %rotate -1
   568                              <1> %ifidni %1,ALL
   569                              <1>  pusha
   570                              <1> %elifidni %1,F
   571                              <1>  pushf
   572                              <1> %else
   573                              <1>  push %1
   574                              <1> %endif
   575                              <1> %endrep
   576                              <1> %endm
   577                              <1> 
   578                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   579                              <1> %assign __size__ (%2-1)	| 0xFF
   580                              <1> %if (__size__ <= 0xFFFF)
   581                              <1> %assign __gran__ 0
   582                              <1> %else
   583                              <1> %assign __gran__ 0xC0			; G B 0 0
   584                              <1> %endif
   585                              <1> %assign __expand__ 0
   586                              <1> %if %0==3
   587                              <1> %if %3
   588                              <1> %assign __expand__ 4
   589                              <1> %endif
   590                              <1> %endif
   591                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   592                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   593                              <1> %endm
   594                              <1> 
   595                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   596                              <1> %assign __size__ (%2-1)	| 0xFF
   597                              <1> %if (__size__ <= 0xFFFF)
   598                              <1> %assign __gran__ 0
   599                              <1> %else
   600                              <1> %assign __gran__ 0xC0			; G D 0 0
   601                              <1> %endif
   602                              <1> %assign __conform__ 0
   603                              <1> %if %0==3
   604                              <1> %if %3
   605                              <1> %assign __conform__ 4
   606                              <1> %endif
   607                              <1> %endif
   608                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   609                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   610                              <1> %endm
   611                              <1> 
   612                              <1> ;/* End of macro.inc */
   613                                  %define XXX
   614                                  %include "bda.inc"
   615                              <1> XXX
   616                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
   617                              <1> %define BDA_segment 0x40
   618                              <1> struc _BDA
   619                              <1> ; first items at 0x40:0	*/
   620 00000000 <res 00000008>      <1> serial_dev	resw	4	; serial port device codes */
   621 00000008 <res 00000008>      <1> parallel_dev	resw	4	; printer port device codes */
   622 00000010 <res 00000002>      <1> equip_flag	resw	1		; int 12h equipment flags */
   623 00000012 <res 00000001>      <1> mfg_test	resb	1		; initialization flags */
   624 00000013 <res 00000002>      <1> memory_size	resw	1	; base memory size in Kilowords (1024) */
   625 00000015 <res 00000001>      <1> mfg_err_flag	resb	1
   626 00000016 <res 00000001>      <1> mfg_err_flag2	resb	1
   627                              <1> ; */
   628                              <1> ; first Keyboard data area */
   629 00000017 <res 00000001>      <1> kbd_flag	resb	1	; shift status &c. */
   630 00000018 <res 00000001>      <1> kbd_flag1	resb	1	;  more  */
   631 00000019 <res 00000001>      <1> alt_input	resb	1	; save alternate kbd entry code */
   632 0000001A <res 00000002>      <1> buffer_head	resw	1
   633 0000001C <res 00000002>      <1> buffer_tail	resw	1
   634                              <1> ; */
   635 0000001E <res 00000020>      <1> kbd_buffer	resw	16	; buffer empty when  head==tail */
   636                              <1> ; */
   637                              <1> ; Diskette data area */
   638 0000003E <res 00000001>      <1> seek_status	resb	1	; drive recalibration status */
   639                              <1> ; bits 3..0 drive must recalibrate before next seek */
   640 0000003F <res 00000001>      <1> motor_status	resb	1	; bits 3..0 motor running */
   641                              <1> ; bit 7 current op is write */
   642 00000040 <res 00000001>      <1> motor_count	resb	1	; timeout counter for motor turn-off */
   643 00000041 <res 00000001>      <1> fd_status	resb	1	; return code status byte */
   644 00000042 <res 00000007>      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   645                              <1> ; */
   646                              <1> ; Video Display data area -- also used for video emulation */
   647 00000049 <res 00000001>      <1> vid_mode	resb	1	; current display mode */
   648 0000004A <res 00000002>      <1> vid_columns	resw	1	; no. of columns on the screen */
   649 0000004C <res 00000002>      <1> vid_buf_len	resw	1	; length of video buffer in bytes */
   650 0000004E <res 00000002>      <1> vid_start	resw	1	; start address of screen regeneration (in vid buf) */
   651 00000050 <res 00000010>      <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   652 00000060 <res 00000002>      <1> vid_cursor_mode	resw	1
   653 00000062 <res 00000001>      <1> vid_active_page	resb	1
   654 00000063 <res 00000002>      <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA) */
   655 00000065 <res 00000001>      <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   656 00000066 <res 00000001>      <1> vid_palette	resb	1	; current color setting / palette  */
   657                              <1> ; */
   658                              <1> ; POST and ROM data */
   659 00000067 <res 00000004>      <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   660                              <1> %define io_rom_addr_low io_rom_addr
   661                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   662 0000006B <res 00000001>      <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   663                              <1> ; */
   664                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   665 0000006C <res 00000002>      <1> timer_count_low	resw	1	; low word of timer count */
   666 0000006E <res 00000002>      <1> timer_count_high	resw	1
   667                              <1> %define timer_count timer_count_low
   668                              <1> ; use timer_count as the double word timer counter */
   669 00000070 <res 00000001>      <1> timer_overflow	resb	1	; timer has rolled over since last read */
   670                              <1> ; */
   671                              <1> ; System & Keboard data area */
   672 00000071 <res 00000001>      <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   673 00000072 <res 00000002>      <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   674                              <1> ; */
   675                              <1> ; Fixed (Hard) disk data area */
   676 00000074 <res 00000001>      <1> hd_status	resb	1	; status info for hard disk */
   677                              <1> %define disk_status1 hd_status
   678 00000075 <res 00000001>      <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
   679 00000076 <res 00000001>      <1> control_byte	resb	1	; head control ???? */
   680 00000077 <res 00000001>      <1> port_offset	resb	1	; obsolete, maybe ???? */
   681                              <1> ; */
   682                              <1> ; Timeout counters *;
   683 00000078 <res 00000004>      <1> printer_timeout	resb	4
   684 0000007C <res 00000004>      <1> serial_timeout	resb	4	; one byte for each interface */
   685                              <1> ; */
   686                              <1> ; Keyboard additional data area -- buffer location within segment 40h */
   687 00000080 <res 00000002>      <1> buffer_start	resw	1	; offset of keyboard buffer start */
   688 00000082 <res 00000002>      <1> buffer_end	resw	1		; offset of end of kbd buffer */
   689                              <1> ; */
   690                              <1> ; EGA/PGA? data work area (graphic mode?  probably available) */
   691 00000084 <res 00000001>      <1> ega_rows	resb	1		; rows on the active screen (less 1) */
   692 00000085 <res 00000002>      <1> ega_points	resw	1		; bytes per character	*/
   693 00000087 <res 00000001>      <1> ega_info	resb	1		; mode options ???? */
   694 00000088 <res 00000001>      <1> ega_info_3	resb	1		; switch settings */
   695 00000089 <res 00000002>      <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   696                              <1> ; */
   697                              <1> ; Disk / Diskette media data */
   698 0000008B <res 00000001>      <1> fd_last_data_rate	resb	1	; last data rate selected */
   699 0000008C <res 00000001>      <1> hd_status_reg	resb	1		; hard disk status register */
   700 0000008D <res 00000001>      <1> hd_error_reg	resb	1		; hard disk error register */
   701 0000008E <res 00000001>      <1> hd_int_flag	resb	1	; HD interrupt flag */
   702 0000008F <res 00000001>      <1> hd_cntrl	resb	1		; HD/FD combo controller bit flag */
   703 00000090 <res 00000002>      <1> hd_media	resb	2	; media state */
   704 00000092 <res 00000002>      <1> hd_op_start	resb	2	; operation start state */
   705 00000094 <res 00000002>      <1> hd_track	resb	2	; HD present cylinder number */
   706                              <1> ; */
   707                              <1> ; Additional Keyboard flags */
   708 00000096 <res 00000001>      <1> kbd_flag3	resb	1	; mode state & type flags */
   709 00000097 <res 00000001>      <1> kbd_flag2	resb	1	; kbd LED flags */
   710                              <1> ; */
   711                              <1> ; Real Time Clock data area */
   712 00000098 <res 00000004>      <1> rtc_user_flag_addr	resd	1	; far address of user's wait flag */
   713 0000009C <res 00000004>      <1> rtc_user_wait_flag	resd	1	; user wait flag */
   714 000000A0 <res 00000001>      <1> rtc_wait_active	resb	1	; 01=busy, 80=posted, 00=post acknowledge */
   715                              <1> ; */
   716                              <1> ; Miscellaneous */
   717 000000A1 <res 00000007>      <1> rsvd_network	resb	7	; reserved for network adapters */
   718 000000A8 <res 00000004>      <1> ptr_ega_save	resd	1		; far pointer to EGA parameter control block */
   719                              <1> ; */
   720                              <1> ;	byte	rsvd_unused[84];	; reserved for 386EX usage */
   721 000000AC <res 00000002>      <1> extended_memory	resw	1	; size of Extended Memory in Kilobytes */
   722                              <1> ; this size is stored in CMOS on the PC/AT */
   723 000000AE <res 00000048>      <1> rsvd_unused	resb	72	; reserved for 386EX usage */
   724 000000F6 <res 00000008>      <1> disk_tab	resb	8  		; hard disk driver table */
   725 000000FE <res 00000002>      <1> floppy_tab	resb	2		; floppy disk driver table */
   726                              <1> ; */
   727 00000100 <res 00000001>      <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte */
   728                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   729                              <1> ; */
   730                              <1> ; Extentsion to BDA during BIOS startup */
   731 00000101 <res 00000001>      <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   732 00000102 <res 0000001F>      <1> nvram_info	resb	31	; 31 bytes of NVRAM information (this may move) */
   733 00000121 <res 00000002>      <1> CPU_freq	resw	1	; CPU frequency in kilohertz */
   734                              <1> ; */
   735                              <1> endstruc
   736                                  %undef XXX
   737                                  
   738                                  %define ARG(n) [bp+2+(n)*2]
   739                                  
   740                                  	SEGMENT	_TEXT
   741                                  
   742                                  ; -----------------------------------------------------------------------------	
   743                                  ;  IDE_READ_SECTOR
   744                                  ; -----------------------------------------------------------------------------	
   745                                  ; read a sector, specified by the 4 bytes in "lba",
   746                                  ; Return, acc is zero on success, non-zero for an error
   747                                  ;
   748                                  ;  int IDE_READ_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
   749                                  ;
   750                                  ;
   751                                  ;-----------------------------------------------------------------------------
   752                                          global  IDE_READ_SECTOR
   753                                          global  IDE_READ_SECTOR_
   754                                  IDE_READ_SECTOR:
   755                                  IDE_READ_SECTOR_:
   756 00000000 52                      		push 	DX
   757 00000001 53                      		push    BX
   758 00000002 51                      		push 	CX
   759 00000003 55                              push    bp
   760 00000004 89E5                            mov     bp,sp
   761 00000006 06                              push 	ES
   762 00000007 57                              push	DI
   763                                  
   764 00000008 E8FA00                  		call	ide_wait_not_busy		; make sure drive is ready
   765 0000000B 7519                    		jnz	.2
   766                                  
   767 0000000D 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS 
   768 00000010 88C7                            mov     bh,al	 				; Master/slave INTO BH       
   769 00000012 8B560C                          mov     dx,ARG(5)
   770 00000015 8B460A                          mov     ax,ARG(4)
   771 00000018 E84D01                  		call	wr_lba					; tell it which sector we want
   772                                  
   773 0000001B B020                            mov     al,IDE_CMD_PIO_READ
   774 0000001D BAF701                  		mov		dx,IDESTTS
   775 00000020 EE                      		out		dx,al
   776                                  
   777 00000021 E8F500                  		call	ide_wait_drq			; wait until it's got the data
   778 00000024 7405                    		jz	.3							; NO ERROR, CONTINUE
   779                                  .2
   780 00000026 B8FFFF                     		mov		ax,-1					; MARK ERROR, ABORT
   781 00000029 EB10                    		jmp	.9
   782                                  .3:
   783                                  
   784 0000002B 8B4E0E                          mov     CX,ARG(6) 				; COUNT OF SECTORS 
   785 0000002E 8E4602                          mov     es,ARG(0) 				; high address INTO es	
   786 00000031 8B5E04                          mov     bx,ARG(1)				; low address into bx
   787                                  .4
   788 00000034 E80F01                  		call	read_data				; grab the data
   789 00000037 E2FB                    		loop	.4
   790                                  
   791 00000039 31C0                            xor     ax,ax
   792                                  
   793                                  .9:
   794 0000003B 5F                         		POP 	DI 
   795 0000003C 07                         		POP 	ES 
   796 0000003D C9                              leave
   797 0000003E 59                              pop 	CX
   798 0000003F 5B                              pop 	BX
   799 00000040 5A                              pop 	DX
   800 00000041 C3                              ret
   801                                  
   802                                  
   803                                  ; -----------------------------------------------------------------------------	
   804                                  ;  IDE_WRITE_SECTOR
   805                                  ; -----------------------------------------------------------------------------	
   806                                  ; write a sector, specified by the 4 bytes in "lba",
   807                                  ; Return, acc is zero on success, non-zero for an error
   808                                  ;
   809                                  ;  int IDE_WRITE_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
   810                                  ;
   811                                  ;
   812                                  ;-----------------------------------------------------------------------------
   813                                          global  IDE_WRITE_SECTOR
   814                                          global  IDE_WRITE_SECTOR_
   815                                  IDE_WRITE_SECTOR:
   816                                  IDE_WRITE_SECTOR_:
   817 00000042 52                      		push 	DX
   818 00000043 53                      		push    BX
   819 00000044 51                      		push 	CX
   820 00000045 55                              push    bp
   821 00000046 89E5                            mov     bp,sp
   822 00000048 1E                              push 	DS
   823 00000049 56                              push	SI
   824                                  
   825 0000004A E8B800                  		call	ide_wait_not_busy		; make sure drive is ready
   826 0000004D 7519                    		jnz	.2
   827                                  
   828 0000004F 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS 
   829 00000052 88C7                            mov     bh,al	 				; Master/slave INTO BH       
   830 00000054 8B560C                          mov     dx,ARG(5)
   831 00000057 8B460A                          mov     ax,ARG(4)
   832 0000005A E80B01                  		call	wr_lba					; tell it which sector we want
   833                                  
   834 0000005D B030                            mov     al,IDE_CMD_PIO_WRITE
   835 0000005F BAF701                  		mov		dx,IDESTTS
   836 00000062 EE                      		out		dx,al
   837                                  
   838 00000063 E8B300                  		call	ide_wait_drq			; wait until it wants the data
   839 00000066 7405                    		jz	.3							; NO ERROR, CONTINUE
   840                                  .2
   841 00000068 B8FFFF                     		mov		ax,-1					; MARK ERROR, ABORT
