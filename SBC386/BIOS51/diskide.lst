    23                                  ;
    24                                  ; SBC-386 board revisions:
    25                                  ;       SBC386-0   prototype / concept testing
    26                                  ;	SBC-386EX 2.0	production / January 2018
    27                                  ;
    28                                  ; Assembly by NASM 2.08 is preferred
    29                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;*/
    30                                  ; IDE HARDWARE SPECIFIC VALUES	DEFAULT 01F0h - 01FFh	
    31                                  ;				
    32                                  ;  -  CONTROLLER I/O PORT		
    33                                  ;     > WHEN READ FROM
    34                                  ;	HF_PORT+0 - READ DATA (FROM CONTROLLER TO CPU)	
    35                                  ;	HF_PORT+1 - --
    36                                  ;	HF_PORT+2 - GET SECTOR COUNT		
    37                                  ;	HF_PORT+3 - GET LBA LOW (7:0)
    38                                  ;	HF_PORT+4 - GET LBA MID {15:8)
    39                                  ;	HF_PORT+5 - GET LBA HIGH (23:16)  
    40                                  ;	HF_PORT+6 - GET (1: LBA(1/0) : 1 : MST(0)/SLV(1) : LBA (27 :24)  )
    41                                  ;	HF_PORT+7 - GET STATUS REGISTER		
    42                                  ;				
    43                                  ;     > WHEN WRITTEN TO:		
    44                                  ;	HF_PORT+0 - WRITE DATA (FROM CPU TO CONTROLLER)	
    45                                  ;	HF_PORT+1 - SET FEATURES	
    46                                  ;	HF_PORT+2 - SET SECTOR COUNT		
    47                                  ;	HF_PORT+3 - SET LBA LOW (7:0)
    48                                  ;	HF_PORT+4 - SET LBA MID {15:8)
    49                                  ;	HF_PORT+5 - SET LBA HIGH (23:16)
    50                                  ;	HF_PORT+6 - SET (1: LBA(1/0) : 1 : MST(0)/SLV(1) : LBA (27 :24)  )
    51                                  ;	HF_PORT+7 - SET COMMAND REGISTER		
    52                                  ;				
    53                                  HF_PORT		EQU		01F0h		; DISK PORT
    54                                  IDEDTA		EQU     HF_PORT+0	; DATA PORT (16 BIT)
    55                                  IDEERR		EQU     HF_PORT+1	; READ: ERROR REGISTER; WRITE: PRECOMP
    56                                  IDESECC		EQU     HF_PORT+2	; SECTOR COUNT
    57                                  IDELBAL		EQU     HF_PORT+3	; SECTOR NUMBER
    58                                  IDELBAM		EQU     HF_PORT+4	; CYLINDER LOW
    59                                  IDELBAH		EQU     HF_PORT+5	; CYLINDER HIGH
    60                                  IDEDRV 		EQU     HF_PORT+6	; DRIVE/HEAD
    61                                  IDESTTS		EQU     HF_PORT+7	; READ: STATUS; WRITE: COMMAND
    62                                  IDEALTS		EQU     HF_PORT+14	; ALTERNATE STATUS(Not IBM Compat)
    63                                  IDEADDR		EQU     HF_PORT+15	; DRIVE ADDRESS   (Not IBM Compat)
    64                                  ;
    65                                  ;
    66                                  ; IDE/ATA COMMANDS
    67                                  ;
    68                                  ;
    69                                  IDE_CMD_RECAL		EQU     010h
    70                                  IDE_CMD_PIO_READ    EQU 	020h
    71                                  IDE_CMD_PIO_WRITE   EQU 	030h
    72                                  IDE_CMD_INIT_PARAM  EQU 	091h
    73                                  IDE_CMD_DMA_READ    EQU 	0C8h
    74                                  IDE_CMD_DMA_WRITE   EQU 	0CAh
    75                                  IDE_CMD_SPINDOWN    EQU 	0E0h
    76                                  IDE_CMD_SPINUP      EQU 	0E1h
    77                                  IDE_CMD_IDENT       EQU 	0ECh
    78                                  IDE_CMD_SET_FEATURE EQU 	0EFh
    79                                  
    80                                  
    81                                  %include "seg_def.inc"
    82                              <1> ; SEG_DEF.inc
    83                              <1> ;
    84                              <1> %ifndef SEG_DEF
    85                              <1> %define SEG_DEF 1
    86                              <1> 
    87                              <1> segment CODE	use16	align=16	class=CODE	public
    88                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    89                              <1> 
    90                              <1> segment CONST		align=16	class=DATA	public
    91                              <1> segment CONST2		align=2		class=DATA	public
    92                              <1> segment _DATA		align=16	class=DATA	public
    93                              <1> segment _BSS		align=16	class=DATA	public
    94                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    95                              <1> 
    96                              <1> group DGROUP CODE _TEXT CONST2 CONST _DATA _BSS
    97                              <1> 
    98                              <1> 
    99                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
   100                              <1> 
   101                              <1> %define XXX
   102                              <1> %endif
   103                              <1> ;
   104                              <1> ; end SEG_DEF.inc
