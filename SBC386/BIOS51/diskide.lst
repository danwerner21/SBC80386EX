   979                                  ;------------------------------------------------------------------------------
   980                                  ; IDE INTERNAL SUBROUTINES 
   981                                  ;------------------------------------------------------------------------------
   982                                  ;-----------------------------------------------------------------------------
   983                                  ;  Wait for RDY to be set
   984                                  ;
   985                                  ;  Exit with:
   986                                  ;       AL contains status
   987                                  ;       All other registers preserved
   988                                  ;
   989                                  ;------------------------------------------------------------------------------
   990                                  ide_wait_not_busy:
   991 00000105 515253                          pushm   bx,dx,cx
   992 00000108 B9FFFF                  		mov	cx,0FFFFh
   993                                  .1:
   994 0000010B BAF701                  		mov	dx,IDESTTS
   995 0000010E EC                      		in	al,dx
   996                                  
   997 0000010F 2480                            and     al,10000000b
   998 00000111 E0F8                    		loopnz	.1
   999                                  
  1000 00000113 08C0                    		or	al,al
  1001 00000115 5B5A59                          popm    bx,dx,cx
  1002 00000118 C3                      		ret
  1003                                  ;------------------------------------------------------------------------------
  1004                                  ; Wait for the drive to be ready to transfer data (DRQ = data request)
  1005                                  ; Returns the drive's status in Acc
  1006                                  ;
  1007                                  ;  Exit with:
  1008                                  ;       AL contains status
  1009                                  ;       All other registers preserved
  1010                                  ;------------------------------------------------------------------------------
  1011                                  ide_wait_drq:
  1012 00000119 515253                          pushm   bx,dx,cx
  1013 0000011C B9FFFF                  		mov	cx,0FFFFh
  1014                                  .1:
  1015 0000011F BAF701                     		mov	dx,IDESTTS
  1016 00000122 EC                      		in	al,dx
  1017                                  
  1018 00000123 2488                            and     al,10001000b		; Mask off Busy(7) and DRQ(3)
  1019 00000125 3408                            xor     al,00001000b		; We want Busy(7) to be 0 and DRQ (3) to be 1
  1020                                  
  1021 00000127 E0F6                    		loopnz	.1
  1022                                  
  1023 00000129 08C0                    		or	al,al
  1024 0000012B 5B5A59                          popm    bx,dx,cx
  1025 0000012E C3                      	ret
  1026                                  ;------------------------------------------------------------------------------
  1027                                  ; Read a sector of 512 bytes into memory at ES:[BX]
  1028                                  ;
  1029                                  ;  Call with:
  1030                                  ;       ES:BX -- pointer to the data block
  1031                                  ;
  1032                                  ;  Exit with:
  1033                                  ;       AX and DX are destroyed; other registers preserved
  1034                                  ;
  1035                                  ; "BE" version is for ide id information
  1036                                  ;-----------------------------------------------------------------------------
  1037                                  read_dataBE:
  1038 0000012F 5153                        pushm   bx,cx
  1039 00000131 BAF001                  	mov		dx,IDEDTA
  1040                                  
  1041 00000134 87FB                        xchg    di,bx
  1042                                  
  1043 00000136 B90001                  	mov     cx,256          ; sector size in words
  1044                                  rdblk2BE:
  1045 00000139 EC                      	in	al,dx
  1046 0000013A 88C4                    	mov ah,al
  1047 0000013C EC                      	in	al,dx
  1048 0000013D AA                      	stosb
  1049 0000013E 88E0                    	mov al,ah
  1050 00000140 AA                      	stosb
  1051 00000141 E2F6                        loop    rdblk2BE
  1052 00000143 5B59                        popm    bx,cx
  1053 00000145 C3                      	ret
  1054                                  
  1055                                  read_data:
  1056 00000146 51                          pushm   cx
  1057 00000147 BAF001                  	mov		dx,IDEDTA
  1058 0000014A 87FB                        xchg    di,bx
  1059 0000014C B90002                  	mov     cx,512          ; sector size in words
  1060                                  rdblk2:
  1061 0000014F EC                      	in	al,dx
  1062 00000150 AA                      	stosb
  1063 00000151 E2FC                        loop    rdblk2
  1064 00000153 87FB                        xchg    di,bx
  1065 00000155 59                          popm    cx
  1066 00000156 C3                      	ret
  1067                                  
  1068                                  ;------------------------------------------------------------------------------
  1069                                  ; Write a sector of 512 bytes from memory at ES:[BX]
  1070                                  ;
  1071                                  ;  Call with:
  1072                                  ;       ES:BX -- pointer to the data block
  1073                                  ;
  1074                                  ;  Exit with:
  1075                                  ;       AX and DX are destroyed; other registers preserved
  1076                                  ;
  1077                                  ;-----------------------------------------------------------------------------
  1078                                  write_data:
  1079 00000157 51                          pushm   cx
  1080 00000158 BAF001                  	mov		dx,IDEDTA
  1081 0000015B 87F3                        xchg    si,bx
  1082 0000015D B90002                  	mov     cx,512          ; sector size in words
  1083                                  wtblk2:
  1084 00000160 AC                      	lodsb	     		
  1085 00000161 EE                      	out	dx,al
  1086 00000162 E2FC                        loop    wtblk2
  1087 00000164 87F3                        xchg    si,bx
  1088 00000166 59                          popm    cx
  1089 00000167 C3                      	ret
  1090                                  
  1091                                  
  1092                                  
  1093                                  ;-----------------------------------------------------------------------------
  1094                                  ; write the logical block address to the drive's registers
  1095                                  ;
  1096                                  ;  Call with:
  1097                                  ;       DX:AX = logical block address
  1098                                  ;		BH = Master/Slave selection in bit 4
  1099                                  ;       BL = Sector read count
  1100                                  ;
  1101                                  ;  Exit with:
  1102                                  ;       AX, BX, DX are destroyed
  1103                                  ;
  1104                                  ;-----------------------------------------------------------------------------
  1105                                  wr_lba:
  1106 00000168 51                      		push 	cx
  1107 00000169 50                              push    ax
  1108 0000016A 52                              push    dx
  1109 0000016B 89D9                            mov 	CX,BX
  1110                                  
  1111 0000016D B010                            mov     al,10h          ; Master/Slave mask
  1112 0000016F 20E8                            and     al,ch           ; mask bit
  1113 00000171 88F3                            mov     bl,dh           ; high order
  1114 00000173 80E30F                          and     bl,00Fh
  1115 00000176 80CBE0                          or      bl,0E0h         ; mark as LBA
  1116                                  
  1117 00000179 08D8                    		or		al,bl
  1118 0000017B BAF601                  		mov		dx,IDEDRV
  1119 0000017E EE                      		out		dx,al			; DRV
  1120                                  	
  1121 0000017F 5B                              pop     bx              ; get DL to BL
  1122                                  
  1123 00000180 88D8                    		mov		al,bl
  1124 00000182 4A                      		dec		dx
  1125 00000183 EE                      		out		dx,al			; LBA - H
  1126                                  
  1127 00000184 5B                              pop     bx
  1128                                  
  1129 00000185 88F8                    		mov		al,bh
  1130 00000187 4A                      		dec		dx
  1131 00000188 EE                      		out		dx,al			; LBA - M
  1132                                  	
  1133 00000189 88D8                    		mov		al,bl
  1134 0000018B 4A                      		dec		dx
  1135 0000018C EE                      		out		dx,al			; LBA - L
  1136                                  	
  1137 0000018D 88C8                    		mov		al,cl
  1138 0000018F 4A                      		dec		dx
  1139 00000190 EE                      		out		dx,al 			; SET SECTOR COUNT
  1140                                  	
  1141 00000191 59                      		POP 	CX
  1142 00000192 C3                      		ret
