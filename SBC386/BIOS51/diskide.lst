   427                              <1> 
   428                              <1> ;
   429                              <1> ;/* Asynchronout Serial I/O channel 1  (COM2)
   430                              <1> ;*/
   431                              <1> defb    RBR1_F8 equ     0xF8F8
   432                              <1> defb    TBR1_F8 equ     0xF8F8
   433                              <1> defb    DLL1_F8 equ     0xF8F8
   434                              <1> defb    DLH1_F8 equ     0xF8F9
   435                              <1> defb    IER1_F8 equ     0xF8F9
   436                              <1> defb    IIR1_F8 equ     0xF8FA
   437                              <1> defb    LCR1_F8 equ     0xF8FB
   438                              <1> defb    MCR1_F8 equ     0xF8FC
   439                              <1> defb    LSR1_F8 equ     0xF8FD
   440                              <1> defb    MSR1_F8 equ     0xF8FE
   441                              <1> defb    SCR1_F8 equ     0xF8FF
   442                              <1> 
   443                              <1> defb    RBR1    equ     0x02F8
   444                              <1> defb    TBR1    equ     0x02F8
   445                              <1> defb    DLL1    equ     0x02F8
   446                              <1> defb    DLH1    equ     0x02F9
   447                              <1> defb    IER1    equ     0x02F9
   448                              <1> defb    IIR1    equ     0x02FA
   449                              <1> defb    LCR1    equ     0x02FB
   450                              <1> defb    MCR1    equ     0x02FC
   451                              <1> defb    LSR1    equ     0x02FD
   452                              <1> defb    MSR1    equ     0x02FE
   453                              <1> defb    SCR1    equ     0x02FF
   454                              <1> 
   455                              <1> ;/* LSRx bits
   456                              <1> ;*/
   457                              <1> defb    LSR_TE  equ     BIT6
   458                              <1> defb    LSR_TBE equ     BIT5
   459                              <1> defb    LSR_BI  equ     BIT4
   460                              <1> defb    LSR_FE  equ     BIT3
   461                              <1> defb    LSR_PE  equ     BIT2
   462                              <1> defb    LSR_OE  equ     BIT1
   463                              <1> defb    LSR_RBF equ     BIT0
   464                              <1> 
   465                              <1> ;/* Bits in CR0
   466                              <1> ;*/
   467                              <1> defb    CR0_PE  equ     BIT0
   468                              <1> defb    CR0_MP  equ     BIT1
   469                              <1> defb    CR0_EM  equ     BIT2
   470                              <1> defb    CR0_TS  equ     BIT3
   471                              <1> defd    CR0_WP  equ     BIT16
   472                              <1> defd    CR0_PG  equ     BIT31
   473                              <1> 
   474                              <1> ;/* Some ASCII character codes
   475                              <1> ;*/
   476                              <1> defb    ASCII_NUL       equ     0x00
   477                              <1> defb    ASCII_BS        equ     0x08
   478                              <1> defb    ASCII_HT        equ     0x09
   479                              <1> defb    ASCII_LF        equ     0x0A
   480                              <1> defb    ASCII_NL        equ     0x0A
   481                              <1> defb    ASCII_FF        equ     0x0C
   482                              <1> defb    ASCII_CR        equ     0x0D
   483                              <1> defb	ASCII_ESC	equ	0x1B
   484                              <1> defb    ASCII_SP        equ     0x20
   485                              <1> defb    ASCII_DEL       equ     0x7F
   486                              <1> defb	ASCII_RUB	equ	0xFF
   487                              <1> 
   488                              <1> 
