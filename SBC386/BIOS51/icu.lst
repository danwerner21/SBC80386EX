   430                              <1> defb    ASCII_CR        equ     0x0D
   431                              <1> defb	ASCII_ESC	equ	0x1B
   432                              <1> defb    ASCII_SP        equ     0x20
   433                              <1> defb    ASCII_DEL       equ     0x7F
   434                              <1> defb	ASCII_RUB	equ	0xFF
   435                              <1> 
   436                              <1> 
   437                              <1> ;/* End of i386EX.inc */
   438                                  %include "bda.inc"
   439                              <1> XXX
   440                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
   441                              <1> %define BDA_segment 0x40
   442                              <1> struc _BDA
   443                              <1> ; first items at 0x40:0	*/
   444 00000000 <res 00000008>      <1> serial_dev	resw	4	; serial port device codes */
   445 00000008 <res 00000008>      <1> parallel_dev	resw	4	; printer port device codes */
   446 00000010 <res 00000002>      <1> equip_flag	resw	1		; int 12h equipment flags */
   447 00000012 <res 00000001>      <1> mfg_test	resb	1		; initialization flags */
   448 00000013 <res 00000002>      <1> memory_size	resw	1	; base memory size in Kilowords (1024) */
   449 00000015 <res 00000001>      <1> mfg_err_flag	resb	1
   450 00000016 <res 00000001>      <1> mfg_err_flag2	resb	1
   451                              <1> ; */
   452                              <1> ; first Keyboard data area */
   453 00000017 <res 00000001>      <1> kbd_flag	resb	1	; shift status &c. */
   454 00000018 <res 00000001>      <1> kbd_flag1	resb	1	;  more  */
   455 00000019 <res 00000001>      <1> alt_input	resb	1	; save alternate kbd entry code */
   456 0000001A <res 00000002>      <1> buffer_head	resw	1
   457 0000001C <res 00000002>      <1> buffer_tail	resw	1
   458                              <1> ; */
   459 0000001E <res 00000020>      <1> kbd_buffer	resw	16	; buffer empty when  head==tail */
   460                              <1> ; */
   461                              <1> ; Diskette data area */
   462 0000003E <res 00000001>      <1> seek_status	resb	1	; drive recalibration status */
   463                              <1> ; bits 3..0 drive must recalibrate before next seek */
   464 0000003F <res 00000001>      <1> motor_status	resb	1	; bits 3..0 motor running */
   465                              <1> ; bit 7 current op is write */
   466 00000040 <res 00000001>      <1> motor_count	resb	1	; timeout counter for motor turn-off */
   467 00000041 <res 00000001>      <1> fd_status	resb	1	; return code status byte */
   468 00000042 <res 00000007>      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   469                              <1> ; */
   470                              <1> ; Video Display data area -- also used for video emulation */
   471 00000049 <res 00000001>      <1> vid_mode	resb	1	; current display mode */
   472 0000004A <res 00000002>      <1> vid_columns	resw	1	; no. of columns on the screen */
   473 0000004C <res 00000002>      <1> vid_buf_len	resw	1	; length of video buffer in bytes */
   474 0000004E <res 00000002>      <1> vid_start	resw	1	; start address of screen regeneration (in vid buf) */
   475 00000050 <res 00000010>      <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   476 00000060 <res 00000002>      <1> vid_cursor_mode	resw	1
   477 00000062 <res 00000001>      <1> vid_active_page	resb	1
   478 00000063 <res 00000002>      <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA) */
   479 00000065 <res 00000001>      <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   480 00000066 <res 00000001>      <1> vid_palette	resb	1	; current color setting / palette  */
   481                              <1> ; */
   482                              <1> ; POST and ROM data */
   483 00000067 <res 00000004>      <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   484                              <1> %define io_rom_addr_low io_rom_addr
   485                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   486 0000006B <res 00000001>      <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   487                              <1> ; */
   488                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   489 0000006C <res 00000002>      <1> timer_count_low	resw	1	; low word of timer count */
   490 0000006E <res 00000002>      <1> timer_count_high	resw	1
   491                              <1> %define timer_count timer_count_low
   492                              <1> ; use timer_count as the double word timer counter */
   493 00000070 <res 00000001>      <1> timer_overflow	resb	1	; timer has rolled over since last read */
   494                              <1> ; */
   495                              <1> ; System & Keboard data area */
   496 00000071 <res 00000001>      <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   497 00000072 <res 00000002>      <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   498                              <1> ; */
   499                              <1> ; Fixed (Hard) disk data area */
   500 00000074 <res 00000001>      <1> hd_status	resb	1	; status info for hard disk */
   501                              <1> %define disk_status1 hd_status
   502 00000075 <res 00000001>      <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
   503 00000076 <res 00000001>      <1> control_byte	resb	1	; head control ???? */
   504 00000077 <res 00000001>      <1> port_offset	resb	1	; obsolete, maybe ???? */
   505                              <1> ; */
   506                              <1> ; Timeout counters *;
   507 00000078 <res 00000004>      <1> printer_timeout	resb	4
   508 0000007C <res 00000004>      <1> serial_timeout	resb	4	; one byte for each interface */
   509                              <1> ; */
   510                              <1> ; Keyboard additional data area -- buffer location within segment 40h */
   511 00000080 <res 00000002>      <1> buffer_start	resw	1	; offset of keyboard buffer start */
   512 00000082 <res 00000002>      <1> buffer_end	resw	1		; offset of end of kbd buffer */
   513                              <1> ; */
   514                              <1> ; EGA/PGA? data work area (graphic mode?  probably available) */
   515 00000084 <res 00000001>      <1> ega_rows	resb	1		; rows on the active screen (less 1) */
   516 00000085 <res 00000002>      <1> ega_points	resw	1		; bytes per character	*/
   517 00000087 <res 00000001>      <1> ega_info	resb	1		; mode options ???? */
   518 00000088 <res 00000001>      <1> ega_info_3	resb	1		; switch settings */
   519 00000089 <res 00000002>      <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   520                              <1> ; */
   521                              <1> ; Disk / Diskette media data */
   522 0000008B <res 00000001>      <1> fd_last_data_rate	resb	1	; last data rate selected */
   523 0000008C <res 00000001>      <1> hd_status_reg	resb	1		; hard disk status register */
   524 0000008D <res 00000001>      <1> hd_error_reg	resb	1		; hard disk error register */
   525 0000008E <res 00000001>      <1> hd_int_flag	resb	1	; HD interrupt flag */
   526 0000008F <res 00000001>      <1> hd_cntrl	resb	1		; HD/FD combo controller bit flag */
   527 00000090 <res 00000002>      <1> hd_media	resb	2	; media state */
   528 00000092 <res 00000002>      <1> hd_op_start	resb	2	; operation start state */
   529 00000094 <res 00000002>      <1> hd_track	resb	2	; HD present cylinder number */
   530                              <1> ; */
   531                              <1> ; Additional Keyboard flags */
   532 00000096 <res 00000001>      <1> kbd_flag3	resb	1	; mode state & type flags */
   533 00000097 <res 00000001>      <1> kbd_flag2	resb	1	; kbd LED flags */
   534                              <1> ; */
   535                              <1> ; Real Time Clock data area */
   536 00000098 <res 00000004>      <1> rtc_user_flag_addr	resd	1	; far address of user's wait flag */
   537 0000009C <res 00000004>      <1> rtc_user_wait_flag	resd	1	; user wait flag */
   538 000000A0 <res 00000001>      <1> rtc_wait_active	resb	1	; 01=busy, 80=posted, 00=post acknowledge */
   539                              <1> ; */
   540                              <1> ; Miscellaneous */
   541 000000A1 <res 00000007>      <1> rsvd_network	resb	7	; reserved for network adapters */
   542 000000A8 <res 00000004>      <1> ptr_ega_save	resd	1		; far pointer to EGA parameter control block */
   543                              <1> ; */
   544                              <1> ;	byte	rsvd_unused[84];	; reserved for 386EX usage */
   545 000000AC <res 00000002>      <1> extended_memory	resw	1	; size of Extended Memory in Kilobytes */
   546                              <1> ; this size is stored in CMOS on the PC/AT */
   547 000000AE <res 00000048>      <1> rsvd_unused	resb	72	; reserved for 386EX usage */
   548 000000F6 <res 00000008>      <1> disk_tab	resb	8  		; hard disk driver table */
   549 000000FE <res 00000002>      <1> floppy_tab	resb	2		; floppy disk driver table */
   550                              <1> ; */
   551 00000100 <res 00000001>      <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte */
   552                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   553                              <1> ; */
   554                              <1> ; Extentsion to BDA during BIOS startup */
   555 00000101 <res 00000001>      <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   556 00000102 <res 0000001F>      <1> nvram_info	resb	31	; 31 bytes of NVRAM information (this may move) */
   557 00000121 <res 00000002>      <1> CPU_freq	resw	1	; CPU frequency in kilohertz */
   558                              <1> ; */
   559                              <1> endstruc
   560                                  %include "macro.inc"
   561                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   562                              <1> ;
   563                              <1> ; some useful macros:
   564                              <1> ;
   565                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   566                              <1> ;
   567                              <1> ;
   568                              <1> ; format of the BYTE initialization table:  address, byte
   569                              <1> ;
   570                              <1> %imacro  binit 2
   571                              <1>         dw      %1
   572                              <1>         db      %2
   573                              <1> %endmacro
   574                              <1> ; end with DW -1
   575                              <1> 
   576                              <1> ;
   577                              <1> ; format of the WORD initialization table:  address, word
   578                              <1> ;
   579                              <1> %imacro  winit 2
   580                              <1>         dw      %1
   581                              <1>         dw      %2
   582                              <1> %endmacro
   583                              <1> ; end with DW -1
   584                              <1> 
   585                              <1> 
   586                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   587                              <1> %imacro get_bda	1.nolist
   588                              <1> 	push	0x0040
   589                              <1> 	pop	%1
   590                              <1> %endm
   591                              <1> 
   592                              <1> 
   593                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   594                              <1> %imacro	get_loc0 1.nolist
   595                              <1> 	push	0x0000
   596                              <1> 	pop	%1
   597                              <1> %endm
   598                              <1> 
   599                              <1> 
   600                              <1> 
   601                              <1> %imacro setloc  1.nolist
   602                              <1>  times   (%1-($-$$)) db 0FFh
   603                              <1> %endm
   604                              <1> 
   605                              <1> %imacro db_lo   1
   606                              <1>  db (%1)&255
   607                              <1> %endm
   608                              <1> 
   609                              <1> %imacro cnop    0.nolist
   610                              <1> %ifdef SOFT_DEBUG
   611                              <1> %if SOFT_DEBUG
   612                              <1>         nop
   613                              <1> %endif
   614                              <1> %endif
   615                              <1> %endm
   616                              <1> 
   617                              <1> %imacro popm 1-*.nolist
   618                              <1> %rep %0
   619                              <1> %ifidni %1,ALL
   620                              <1>  popa
   621                              <1> %elifidni %1,F
   622                              <1>  popf
   623                              <1> %else
   624                              <1>  pop %1
   625                              <1> %ifidni %1,DS
   626                              <1>  cnop
   627                              <1> %elifidni %1,ES
   628                              <1>  cnop
   629                              <1> %endif
   630                              <1> %endif
   631                              <1> %rotate 1
   632                              <1> %endrep
   633                              <1> %endm
   634                              <1> 
   635                              <1> %imacro pushm 1-*.nolist
   636                              <1> %rep %0
   637                              <1> %rotate -1
   638                              <1> %ifidni %1,ALL
   639                              <1>  pusha
   640                              <1> %elifidni %1,F
   641                              <1>  pushf
   642                              <1> %else
   643                              <1>  push %1
   644                              <1> %endif
   645                              <1> %endrep
   646                              <1> %endm
   647                              <1> 
   648                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   649                              <1> %assign __size__ (%2-1)	| 0xFF
   650                              <1> %if (__size__ <= 0xFFFF)
   651                              <1> %assign __gran__ 0
   652                              <1> %else
   653                              <1> %assign __gran__ 0xC0			; G B 0 0
   654                              <1> %endif
   655                              <1> %assign __expand__ 0
   656                              <1> %if %0==3
   657                              <1> %if %3
   658                              <1> %assign __expand__ 4
   659                              <1> %endif
   660                              <1> %endif
   661                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   662                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   663                              <1> %endm
   664                              <1> 
   665                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   666                              <1> %assign __size__ (%2-1)	| 0xFF
   667                              <1> %if (__size__ <= 0xFFFF)
   668                              <1> %assign __gran__ 0
   669                              <1> %else
   670                              <1> %assign __gran__ 0xC0			; G D 0 0
   671                              <1> %endif
   672                              <1> %assign __conform__ 0
   673                              <1> %if %0==3
   674                              <1> %if %3
   675                              <1> %assign __conform__ 4
   676                              <1> %endif
   677                              <1> %endif
   678                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   679                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   680                              <1> %endm
   681                              <1> 
   682                              <1> ;/* End of macro.inc */
   683                                  
   684                                  
   685                                  	global	mask_interrrupt, mask_interrupt_
   686                                  	global	unmask_interrupt, unmask_interrupt_
   687                                  
   688                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   689                                  ; mask_interrupt
   690                                  ;
   691                                  ;    Enter with:
   692                                  ;	AX	interrupt to mask off (0..15)
   693                                  ;
   694                                  ;    Exit with;
   695                                  ;		specified interrupt is masked off
   696                                  ;
   697                                  ; N.B. routine may be called from C-code
   698                                  ;
   699                                  ;	void mask_interrupt(int);
   700                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   701                                  mask_interrupt_:
   702                                  mask_interrupt:
   703 00000000 5251                    	pushm	cx,dx
   704                                  
   705 00000002 91                      	xchg	ax,cx		; CX is interrupt number
   706 00000003 B80100                  	mov	ax,1
   707 00000006 83E10F                  	and	cx,15		; insurance
   708 00000009 D3E0                    	shl	ax,cl
   709 0000000B BAA100                  	mov	dx,OCW1S_AT	; set for slave
   710 0000000E 08C0                    	or	al,al
   711 00000010 7405                    	jz	.2		; non-zero means master
   712 00000012 BA2100                  	mov	dx,OCW1M_AT
   713 00000015 88C4                    	mov	ah,al
   714                                  .2:			; enable bit is in AH
   715 00000017 EC                      	in	al,dx		; read current mask
   716 00000018 08E0                    	or	al,ah		; set bit
   717 0000001A EE                      	out	dx,al		; set mask
   718                                  
   719 0000001B 595A                    	popm	cx,dx
   720 0000001D C3                      	ret
   721                                  
   722                                  	
   723                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   724                                  ; unmask_interrupt
   725                                  ;
   726                                  ;    Enter with:
   727                                  ;	AX	interrupt to unmask (0..15)
   728                                  ;
   729                                  ;    Exit with;
   730                                  ;		specified interrupt is turned on
   731                                  ;
   732                                  ; N.B. routine may be called from C-code
   733                                  ;
   734                                  ;	void unmask_interrupt(int);
   735                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   736                                  unmask_interrupt_:
   737                                  unmask_interrupt:
   738 0000001E 5251                    	pushm	cx,dx
   739                                  
   740 00000020 91                      	xchg	ax,cx		; CX is interrupt number
   741 00000021 B80100                  	mov	ax,1
   742 00000024 83E10F                  	and	cx,15		; insurance
   743 00000027 D3E0                    	shl	ax,cl
   744 00000029 BAA100                  	mov	dx,OCW1S_AT	; set for slave
   745 0000002C 08C0                    	or	al,al
   746 0000002E 7405                    	jz	.2		; non-zero means master
   747 00000030 BA2100                  	mov	dx,OCW1M_AT
   748 00000033 88C4                    	mov	ah,al
   749                                  .2:			; enable bit is in AH
   750 00000035 F6D4                    	not	ah		; disable mask in AH
   751 00000037 EC                      	in	al,dx		; read current mask
   752 00000038 20E0                    	and	al,ah		; clear bit
   753 0000003A EE                      	out	dx,al		; set new mask
   754                                  
   755 0000003B 595A                    	popm	cx,dx
   756 0000003D C3                      	ret
   757                                  
   758                                  	
   759                                  
   760                                  
