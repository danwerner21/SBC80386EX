   428                              <1> defb    ASCII_NL        equ     0x0A
   429                              <1> defb    ASCII_FF        equ     0x0C
   430                              <1> defb    ASCII_CR        equ     0x0D
   431                              <1> defb	ASCII_ESC	equ	0x1B
   432                              <1> defb    ASCII_SP        equ     0x20
   433                              <1> defb    ASCII_DEL       equ     0x7F
   434                              <1> defb	ASCII_RUB	equ	0xFF
   435                              <1> 
   436                              <1> 
   437                              <1> ;/* End of i386EX.inc */
   438                                  ;%include "bda.inc"
   439                                  %include "macro.inc"
   440                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   441                              <1> ;
   442                              <1> ; some useful macros:
   443                              <1> ;
   444                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   445                              <1> ;
   446                              <1> ;
   447                              <1> ; format of the BYTE initialization table:  address, byte
   448                              <1> ;
   449                              <1> %imacro  binit 2
   450                              <1>         dw      %1
   451                              <1>         db      %2
   452                              <1> %endmacro
   453                              <1> ; end with DW -1
   454                              <1> 
   455                              <1> ;
   456                              <1> ; format of the WORD initialization table:  address, word
   457                              <1> ;
   458                              <1> %imacro  winit 2
   459                              <1>         dw      %1
   460                              <1>         dw      %2
   461                              <1> %endmacro
   462                              <1> ; end with DW -1
   463                              <1> 
   464                              <1> 
   465                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   466                              <1> %imacro get_bda	1.nolist
   467                              <1> 	push	0x0040
   468                              <1> 	pop	%1
   469                              <1> %endm
   470                              <1> 
   471                              <1> 
   472                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   473                              <1> %imacro	get_loc0 1.nolist
   474                              <1> 	push	0x0000
   475                              <1> 	pop	%1
   476                              <1> %endm
   477                              <1> 
   478                              <1> 
   479                              <1> 
   480                              <1> %imacro setloc  1.nolist
   481                              <1>  times   (%1-($-$$)) db 0FFh
   482                              <1> %endm
   483                              <1> 
   484                              <1> %imacro db_lo   1
   485                              <1>  db (%1)&255
   486                              <1> %endm
   487                              <1> 
   488                              <1> %imacro cnop    0.nolist
   489                              <1> %ifdef SOFT_DEBUG
   490                              <1> %if SOFT_DEBUG
   491                              <1>         nop
   492                              <1> %endif
   493                              <1> %endif
   494                              <1> %endm
   495                              <1> 
   496                              <1> %imacro popm 1-*.nolist
   497                              <1> %rep %0
   498                              <1> %ifidni %1,ALL
   499                              <1>  popa
   500                              <1> %elifidni %1,F
   501                              <1>  popf
   502                              <1> %else
   503                              <1>  pop %1
   504                              <1> %ifidni %1,DS
   505                              <1>  cnop
   506                              <1> %elifidni %1,ES
   507                              <1>  cnop
   508                              <1> %endif
   509                              <1> %endif
   510                              <1> %rotate 1
   511                              <1> %endrep
   512                              <1> %endm
   513                              <1> 
   514                              <1> %imacro pushm 1-*.nolist
   515                              <1> %rep %0
   516                              <1> %rotate -1
   517                              <1> %ifidni %1,ALL
   518                              <1>  pusha
   519                              <1> %elifidni %1,F
   520                              <1>  pushf
   521                              <1> %else
   522                              <1>  push %1
   523                              <1> %endif
   524                              <1> %endrep
   525                              <1> %endm
   526                              <1> 
   527                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   528                              <1> %assign __size__ (%2-1)	| 0xFF
   529                              <1> %if (__size__ <= 0xFFFF)
   530                              <1> %assign __gran__ 0
   531                              <1> %else
   532                              <1> %assign __gran__ 0xC0			; G B 0 0
   533                              <1> %endif
   534                              <1> %assign __expand__ 0
   535                              <1> %if %0==3
   536                              <1> %if %3
   537                              <1> %assign __expand__ 4
   538                              <1> %endif
   539                              <1> %endif
   540                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   541                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   542                              <1> %endm
   543                              <1> 
   544                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   545                              <1> %assign __size__ (%2-1)	| 0xFF
   546                              <1> %if (__size__ <= 0xFFFF)
   547                              <1> %assign __gran__ 0
   548                              <1> %else
   549                              <1> %assign __gran__ 0xC0			; G D 0 0
   550                              <1> %endif
   551                              <1> %assign __conform__ 0
   552                              <1> %if %0==3
   553                              <1> %if %3
   554                              <1> %assign __conform__ 4
   555                              <1> %endif
   556                              <1> %endif
   557                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   558                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   559                              <1> %endm
   560                              <1> 
   561                              <1> ;/* End of macro.inc */
   562                                  
   563                                  
   564                                  segment CONST
   565                                  
   566                                  PM_GDT	equ	0x000F_0000 + gdt0
   567                                  	global	gdt0
   568                                  ;
   569                                  ; now the Global Descriptor Table prototype
   570                                  ;
   571                                  	align	16
   572 00000000 0000000000000000        gdt0:	dq	0		; null descriptor
   573                                  rom_gdt:
   574                                  descr08	equ	$-gdt0
   575 00000008 6F00                    	dw	len_gdt-1
   576 0000000A [00000F00]              	dd	PM_GDT
   577 0000000E 0000                    	dw	0		; filler
   578                                  descrP	equ	descr08
   579                                  
   580                                  
   581                                  descr10	equ	$-gdt0
   582 00000010 0000000000000000        	dq	0		; LDT filler
   583                                  
   584                                  
   585                                  descr18	equ	$-gdt0
   586 00000018 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
   587                                  descr_DS	equ	descr18
   588                                  
   589                                  
   590                                  descr20	equ	$-gdt0
   591 00000020 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
   592                                  descr_ES	equ	descr20
   593                                  
   594                                  
   595                                  descr28	equ	$-gdt0
   596 00000028 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
   597                                  descr_SS	equ	descr28
   598                                  
   599                                  
   600                                  descr30	equ	$-gdt0
   601 00000030 FFFF0000009BCF00        	descr_linear_code	0, 0x03FF_FFFF	; 64meg DRAM
   602                                  descr_CS	equ	descr30
   603                                  
   604                                  
   605                                  descr38	equ	$-gdt0
   606 00000038 FFFF00000F9B0000        	descr_linear_code	0xF0000, 0xFFFF ; 64K code (286)
   607                                  descr_BIOS	equ	descr38
   608                                  
   609                                  
   610                                  descr40	equ	$-gdt0
   611 00000040 FF02000400930000        	descr_linear_data	0x400, 0x300	; BIOS data area
   612                                  descr_BDA equ	descr40
   613                                  
   614                                  
   615                                  descr48	equ	$-gdt0
   616 00000048 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
   617                                  descr_FS	equ	descr48
   618                                  
   619                                  
   620                                  descr50	equ	$-gdt0
   621 00000050 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
   622                                  descr_GS	equ	descr50
   623                                  
   624                                  
   625                                  descr58	equ	$-gdt0
   626 00000058 FFFF000000930000        	descr_linear_data	0, 0xFFFF	; 64K return Data segment
   627                                  descr_RMdata	equ	descr58
   628                                  
   629                                  
   630                                  descr60	equ	$-gdt0
   631 00000060 FFFF00000F9B0000        	descr_linear_code	0x000F0000, 0xFFFF	; 64K return Code segment
   632                                  descr_RMcode	equ	descr60
   633                                  
   634                                  
   635                                  descr68	equ	$-gdt0
   636 00000068 FFFF00000F9BC100        	descr_linear_code	0xF0000, 0x1FFFF ; 128K code
   637                                  descr_BIOS32	equ	descr68
   638                                  
   639                                  
   640                                  len_gdt		equ	$-gdt0
   641                                  
   642                                  
   643                                  
   644                                  segment	CODE
   645                                  
   646                                  	bits	16
   647                                  
   648                                  	global	ext_mem_size
   649                                  ;
   650                                  ; enter protected mode to size Extended memory
   651                                  ;
   652                                  ext_mem_size:
   653 00000000 0F0116[0800]            	lgdt	[rom_gdt]	; use ROM version of GDT
   654                                  ;
   655                                  ; set the PE bit to switch into Protected Mode
   656                                  ;
   657 00000005 0F20C3                  	mov	ebx,cr0			; get CR0 to set Prot Mode
   658 00000008 80CB01                  	or	bl,1			; set PE bit
   659 0000000B 66F7E0                  	mul	eax	;time waster for prefetch queue
   660 0000000E 0F22C3                  	mov	cr0,ebx			; enter protected mode
   661                                  ; now in protected mode, but no segment registers are set
   662 00000011 EA[1600]6800            	jmp	descr_BIOS32:pm_continue
   663                                  
   664                                  	bits	32
   665                                  pm_continue:
   666 00000016 66BAFF04                	mov	dx,0x4FF
   667 0000001A B0F0                    	mov	al,0xF0
   668 0000001C EE                      	out	dx,al
   669                                  ;;;	hlt
   670                                  
   671 0000001D 66B81800                	mov	ax,descr_DS		; set DS descriptor
   672 00000021 8ED8                    	mov	ds,ax			; **
   673                                  
   674                                  ;	xor	ebx,ebx
   675                                  ;	xor	ebp,ebp
   676                                  ; stack value saves
   677                                  ;	mov	bx,ss
   678                                  ;	mov	esi,ebx			; save SS
   679                                  ;	mov	bp,sp			; save SP
   680                                  ;
   681                                  ;	shl	ebx,4			; account for
   682                                  ;	add	ebx,ebp			; new linear stack pointer
   683                                  ;
   684                                  ;	mov	ss,ax			; linear Stack
   685                                  ;	mov	esp,ebx			; set stack
   686                                  
   687                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   688                                  ;  __pm_sizeMem -- size Memory in Megabytes
   689                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   690                                  
   691 00000023 31C0                    	xor	eax,eax		; DO  I=0 TO 63
   692 00000025 8B10                    	mov	edx,[eax]	;save location [00000]
   693                                  __pm_size1:
   694 00000027 89C7                    	mov	edi,eax
   695 00000029 C1E714                  	shl	edi,20		; address Megabytes (2**20)
   696 0000002C 8907                    	mov	[edi],eax	; store the number 0..63
   697 0000002E FEC0                    	inc	al
   698 00000030 3C40                    	cmp	al,64		; 64mb limit
   699 00000032 72F3                    	jb	__pm_size1
   700                                  
   701 00000034 2B0500000000            	sub	eax,[0]		; get memory size in megabytes
   702 0000003A 891500000000            	mov	[0],edx		;restore location [00000]
   703 00000040 89C2                    	mov	edx,eax		; answer in EDX
   704                                  
   705                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   706                                  ; now return to Real Mode
   707                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   708                                  return_to_real:
   709 00000042 66B85800                	mov	ax,descr_RMdata		; 64K segment at 0x00000000
   710 00000046 8ED8                    	mov	ds,ax
   711                                  ;;;	jmp	$+2	; clear prefetch queue
   712 00000048 EA[4F000000]6000        	jmp	descr_RMcode:real_return
   713                                  real_return:
   714                                  	bits	16
   715                                  
   716 0000004F 0F20C0                  	mov	eax,cr0		;
   717 00000052 24FE                    	and	al,0xFE		; turn off PE bit
   718 00000054 0F22C0                  	mov	cr0,eax
   719 00000057 EA[5C00]00F0            	jmp	0xF000:really_return
   720                                  ;	jmp	far really_return
   721                                  really_return:
   722 0000005C B8[0000]                	mov	ax,DGROUP
   723 0000005F 8ED8                    	mov	ds,ax
   724                                  ; the segment registers below were never touched in Protected Mode
   725                                  ;	mov	es,ax
   726                                  ;	mov	fs,ax
   727                                  ;	mov	gs,ax
   728                                  
   729                                  ; EDX is size in MB
   730 00000061 89D0                    	mov	ax,dx
   731 00000063 C3                      	ret
   732                                  
   733                                  
   734                                  
   735                                  
