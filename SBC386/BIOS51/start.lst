   453                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   454                              <1> ;
   455                              <1> ; some useful macros:
   456                              <1> ;
   457                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   458                              <1> ;
   459                              <1> ;
   460                              <1> ; format of the BYTE initialization table:  address, byte
   461                              <1> ;
   462                              <1> %imacro  binit 2
   463                              <1>         dw      %1
   464                              <1>         db      %2
   465                              <1> %endmacro
   466                              <1> ; end with DW -1
   467                              <1> 
   468                              <1> ;
   469                              <1> ; format of the WORD initialization table:  address, word
   470                              <1> ;
   471                              <1> %imacro  winit 2
   472                              <1>         dw      %1
   473                              <1>         dw      %2
   474                              <1> %endmacro
   475                              <1> ; end with DW -1
   476                              <1> 
   477                              <1> 
   478                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   479                              <1> %imacro get_bda	1.nolist
   480                              <1> 	push	0x0040
   481                              <1> 	pop	%1
   482                              <1> %endm
   483                              <1> 
   484                              <1> 
   485                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   486                              <1> %imacro	get_loc0 1.nolist
   487                              <1> 	push	0x0000
   488                              <1> 	pop	%1
   489                              <1> %endm
   490                              <1> 
   491                              <1> 
   492                              <1> 
   493                              <1> %imacro setloc  1.nolist
   494                              <1>  times   (%1-($-$$)) db 0FFh
   495                              <1> %endm
   496                              <1> 
   497                              <1> %imacro db_lo   1
   498                              <1>  db (%1)&255
   499                              <1> %endm
   500                              <1> 
   501                              <1> %imacro cnop    0.nolist
   502                              <1> %ifdef SOFT_DEBUG
   503                              <1> %if SOFT_DEBUG
   504                              <1>         nop
   505                              <1> %endif
   506                              <1> %endif
   507                              <1> %endm
   508                              <1> 
   509                              <1> %imacro popm 1-*.nolist
   510                              <1> %rep %0
   511                              <1> %ifidni %1,ALL
   512                              <1>  popa
   513                              <1> %elifidni %1,F
   514                              <1>  popf
   515                              <1> %else
   516                              <1>  pop %1
   517                              <1> %ifidni %1,DS
   518                              <1>  cnop
   519                              <1> %elifidni %1,ES
   520                              <1>  cnop
   521                              <1> %endif
   522                              <1> %endif
   523                              <1> %rotate 1
   524                              <1> %endrep
   525                              <1> %endm
   526                              <1> 
   527                              <1> %imacro pushm 1-*.nolist
   528                              <1> %rep %0
   529                              <1> %rotate -1
   530                              <1> %ifidni %1,ALL
   531                              <1>  pusha
   532                              <1> %elifidni %1,F
   533                              <1>  pushf
   534                              <1> %else
   535                              <1>  push %1
   536                              <1> %endif
   537                              <1> %endrep
   538                              <1> %endm
   539                              <1> 
   540                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   541                              <1> %assign __size__ (%2-1)	| 0xFF
   542                              <1> %if (__size__ <= 0xFFFF)
   543                              <1> %assign __gran__ 0
   544                              <1> %else
   545                              <1> %assign __gran__ 0xC0			; G B 0 0
   546                              <1> %endif
   547                              <1> %assign __expand__ 0
   548                              <1> %if %0==3
   549                              <1> %if %3
   550                              <1> %assign __expand__ 4
   551                              <1> %endif
   552                              <1> %endif
   553                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   554                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   555                              <1> %endm
   556                              <1> 
   557                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   558                              <1> %assign __size__ (%2-1)	| 0xFF
   559                              <1> %if (__size__ <= 0xFFFF)
   560                              <1> %assign __gran__ 0
   561                              <1> %else
   562                              <1> %assign __gran__ 0xC0			; G D 0 0
   563                              <1> %endif
   564                              <1> %assign __conform__ 0
   565                              <1> %if %0==3
   566                              <1> %if %3
   567                              <1> %assign __conform__ 4
   568                              <1> %endif
   569                              <1> %endif
   570                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   571                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   572                              <1> %endm
   573                              <1> 
   574                              <1> ;/* End of macro.inc */
   575                                  %define XXX
   576                                  %include "bda.inc"
   577                              <1> XXX
   578                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
   579                              <1> %define BDA_segment 0x40
   580                              <1> struc _BDA
   581                              <1> ; first items at 0x40:0	*/
   582 00000000 <res 00000008>      <1> serial_dev	resw	4	; serial port device codes */
   583 00000008 <res 00000008>      <1> parallel_dev	resw	4	; printer port device codes */
   584 00000010 <res 00000002>      <1> equip_flag	resw	1		; int 12h equipment flags */
   585 00000012 <res 00000001>      <1> mfg_test	resb	1		; initialization flags */
   586 00000013 <res 00000002>      <1> memory_size	resw	1	; base memory size in Kilowords (1024) */
   587 00000015 <res 00000001>      <1> mfg_err_flag	resb	1
   588 00000016 <res 00000001>      <1> mfg_err_flag2	resb	1
   589                              <1> ; */
   590                              <1> ; first Keyboard data area */
   591 00000017 <res 00000001>      <1> kbd_flag	resb	1	; shift status &c. */
   592 00000018 <res 00000001>      <1> kbd_flag1	resb	1	;  more  */
   593 00000019 <res 00000001>      <1> alt_input	resb	1	; save alternate kbd entry code */
   594 0000001A <res 00000002>      <1> buffer_head	resw	1
   595 0000001C <res 00000002>      <1> buffer_tail	resw	1
   596                              <1> ; */
   597 0000001E <res 00000020>      <1> kbd_buffer	resw	16	; buffer empty when  head==tail */
   598                              <1> ; */
   599                              <1> ; Diskette data area */
   600 0000003E <res 00000001>      <1> seek_status	resb	1	; drive recalibration status */
   601                              <1> ; bits 3..0 drive must recalibrate before next seek */
   602 0000003F <res 00000001>      <1> motor_status	resb	1	; bits 3..0 motor running */
   603                              <1> ; bit 7 current op is write */
   604 00000040 <res 00000001>      <1> motor_count	resb	1	; timeout counter for motor turn-off */
   605 00000041 <res 00000001>      <1> fd_status	resb	1	; return code status byte */
   606 00000042 <res 00000007>      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   607                              <1> ; */
   608                              <1> ; Video Display data area -- also used for video emulation */
   609 00000049 <res 00000001>      <1> vid_mode	resb	1	; current display mode */
   610 0000004A <res 00000002>      <1> vid_columns	resw	1	; no. of columns on the screen */
   611 0000004C <res 00000002>      <1> vid_buf_len	resw	1	; length of video buffer in bytes */
   612 0000004E <res 00000002>      <1> vid_start	resw	1	; start address of screen regeneration (in vid buf) */
   613 00000050 <res 00000010>      <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   614 00000060 <res 00000002>      <1> vid_cursor_mode	resw	1
   615 00000062 <res 00000001>      <1> vid_active_page	resb	1
   616 00000063 <res 00000002>      <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA) */
   617 00000065 <res 00000001>      <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   618 00000066 <res 00000001>      <1> vid_palette	resb	1	; current color setting / palette  */
   619                              <1> ; */
   620                              <1> ; POST and ROM data */
   621 00000067 <res 00000004>      <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   622                              <1> %define io_rom_addr_low io_rom_addr
   623                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   624 0000006B <res 00000001>      <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   625                              <1> ; */
   626                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   627 0000006C <res 00000002>      <1> timer_count_low	resw	1	; low word of timer count */
   628 0000006E <res 00000002>      <1> timer_count_high	resw	1
   629                              <1> %define timer_count timer_count_low
   630                              <1> ; use timer_count as the double word timer counter */
   631 00000070 <res 00000001>      <1> timer_overflow	resb	1	; timer has rolled over since last read */
   632                              <1> ; */
   633                              <1> ; System & Keboard data area */
   634 00000071 <res 00000001>      <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   635 00000072 <res 00000002>      <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   636                              <1> ; */
   637                              <1> ; Fixed (Hard) disk data area */
   638 00000074 <res 00000001>      <1> hd_status	resb	1	; status info for hard disk */
   639                              <1> %define disk_status1 hd_status
   640 00000075 <res 00000001>      <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
   641 00000076 <res 00000001>      <1> control_byte	resb	1	; head control ???? */
   642 00000077 <res 00000001>      <1> port_offset	resb	1	; obsolete, maybe ???? */
   643                              <1> ; */
   644                              <1> ; Timeout counters *;
   645 00000078 <res 00000004>      <1> printer_timeout	resb	4
   646 0000007C <res 00000004>      <1> serial_timeout	resb	4	; one byte for each interface */
   647                              <1> ; */
   648                              <1> ; Keyboard additional data area -- buffer location within segment 40h */
   649 00000080 <res 00000002>      <1> buffer_start	resw	1	; offset of keyboard buffer start */
   650 00000082 <res 00000002>      <1> buffer_end	resw	1		; offset of end of kbd buffer */
   651                              <1> ; */
   652                              <1> ; EGA/PGA? data work area (graphic mode?  probably available) */
   653 00000084 <res 00000001>      <1> ega_rows	resb	1		; rows on the active screen (less 1) */
   654 00000085 <res 00000002>      <1> ega_points	resw	1		; bytes per character	*/
   655 00000087 <res 00000001>      <1> ega_info	resb	1		; mode options ???? */
   656 00000088 <res 00000001>      <1> ega_info_3	resb	1		; switch settings */
   657 00000089 <res 00000002>      <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   658                              <1> ; */
   659                              <1> ; Disk / Diskette media data */
   660 0000008B <res 00000001>      <1> fd_last_data_rate	resb	1	; last data rate selected */
   661 0000008C <res 00000001>      <1> hd_status_reg	resb	1		; hard disk status register */
   662 0000008D <res 00000001>      <1> hd_error_reg	resb	1		; hard disk error register */
   663 0000008E <res 00000001>      <1> hd_int_flag	resb	1	; HD interrupt flag */
   664 0000008F <res 00000001>      <1> hd_cntrl	resb	1		; HD/FD combo controller bit flag */
   665 00000090 <res 00000002>      <1> hd_media	resb	2	; media state */
   666 00000092 <res 00000002>      <1> hd_op_start	resb	2	; operation start state */
   667 00000094 <res 00000002>      <1> hd_track	resb	2	; HD present cylinder number */
   668                              <1> ; */
   669                              <1> ; Additional Keyboard flags */
   670 00000096 <res 00000001>      <1> kbd_flag3	resb	1	; mode state & type flags */
   671 00000097 <res 00000001>      <1> kbd_flag2	resb	1	; kbd LED flags */
   672                              <1> ; */
   673                              <1> ; Real Time Clock data area */
   674 00000098 <res 00000004>      <1> rtc_user_flag_addr	resd	1	; far address of user's wait flag */
   675 0000009C <res 00000004>      <1> rtc_user_wait_flag	resd	1	; user wait flag */
   676 000000A0 <res 00000001>      <1> rtc_wait_active	resb	1	; 01=busy, 80=posted, 00=post acknowledge */
   677                              <1> ; */
   678                              <1> ; Miscellaneous */
   679 000000A1 <res 00000007>      <1> rsvd_network	resb	7	; reserved for network adapters */
   680 000000A8 <res 00000004>      <1> ptr_ega_save	resd	1		; far pointer to EGA parameter control block */
   681                              <1> ; */
   682                              <1> ;	byte	rsvd_unused[84];	; reserved for 386EX usage */
   683 000000AC <res 00000002>      <1> extended_memory	resw	1	; size of Extended Memory in Kilobytes */
   684                              <1> ; this size is stored in CMOS on the PC/AT */
   685 000000AE <res 00000048>      <1> rsvd_unused	resb	72	; reserved for 386EX usage */
   686 000000F6 <res 00000008>      <1> disk_tab	resb	8  		; hard disk driver table */
   687 000000FE <res 00000002>      <1> floppy_tab	resb	2		; floppy disk driver table */
   688                              <1> ; */
   689 00000100 <res 00000001>      <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte */
   690                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   691                              <1> ; */
   692                              <1> ; Extentsion to BDA during BIOS startup */
   693 00000101 <res 00000001>      <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   694 00000102 <res 0000001F>      <1> nvram_info	resb	31	; 31 bytes of NVRAM information (this may move) */
   695 00000121 <res 00000002>      <1> CPU_freq	resw	1	; CPU frequency in kilohertz */
   696                              <1> ; */
   697                              <1> endstruc
