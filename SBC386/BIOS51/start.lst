    44                              <1> ; SEG_DEF.inc
    45                              <1> ;
    46                              <1> %ifndef SEG_DEF
    47                              <1> %define SEG_DEF 1
    48                              <1> 
    49                              <1> segment CODE	use16	align=16	class=CODE	public
    50                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    51                              <1> 
    52                              <1> segment CONST		align=16	class=DATA	public
    53                              <1> segment CONST2		align=2		class=DATA	public
    54                              <1> segment _DATA		align=16	class=DATA	public
    55                              <1> segment _BSS		align=16	class=DATA	public
    56                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    57                              <1> 
    58                              <1> group DGROUP CODE _TEXT CONST2 CONST _DATA _BSS
    59                              <1> 
    60                              <1> 
    61                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    62                              <1> 
    63                              <1> %define XXX
    64                              <1> %endif
    65                              <1> ;
    66                              <1> ; end SEG_DEF.inc
