  1674                                  ; lites -- show a 4-bit value in the lites
  1675                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1676                                  ;
  1677                                  ;    Enter with:
  1678                                  ;	AL	set to value to display (0h..0Fh)
  1679                                  ;
  1680                                  ;    Exit with:
  1681                                  ;	All registers preserved
  1682                                  ;
  1683                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1684                                  	global	lites_
