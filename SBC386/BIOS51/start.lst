   435                              <1> 
   436                              <1> ;/* Some ASCII character codes
   437                              <1> ;*/
   438                              <1> defb    ASCII_NUL       equ     0x00
   439                              <1> defb    ASCII_BS        equ     0x08
   440                              <1> defb    ASCII_HT        equ     0x09
   441                              <1> defb    ASCII_LF        equ     0x0A
   442                              <1> defb    ASCII_NL        equ     0x0A
   443                              <1> defb    ASCII_FF        equ     0x0C
   444                              <1> defb    ASCII_CR        equ     0x0D
   445                              <1> defb	ASCII_ESC	equ	0x1B
   446                              <1> defb    ASCII_SP        equ     0x20
   447                              <1> defb    ASCII_DEL       equ     0x7F
   448                              <1> defb	ASCII_RUB	equ	0xFF
