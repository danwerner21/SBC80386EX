  1652                                  .4:
  1653 000001F9 31FF                    	xor	di,di		;
  1654 000001FB 89D1                    	mov	cx,dx		; set DWORD count
  1655 000001FD F366AB                  	rep stosd		; store all of memory
  1656                                  
  1657 00000200 89D1                    	mov	cx,dx		; reset the count
  1658 00000202 31FF                    	xor	di,di		; reset start address
  1659 00000204 F366AF                  	repe	scasd		;
  1660 00000207 7401                    	je	.5		; continue on no error
  1661 00000209 F4                      	hlt			; with the LITES as set
  1662                                  
  1663 0000020A 66D1E0                  .5:	shl	eax,1
  1664 0000020D 73EA                    	jnc	.4
  1665                                  ; now zero the SRAM
  1666 0000020F 31FF                    	xor	di,di		; reset the start address
  1667 00000211 89D1                    	mov	cx,dx		; reset the count
  1668 00000213 F366AB                  	rep	stosd		; zero the SRAM
  1669                                  
  1670 00000216 FFE3                    	jmp	bx	; return
  1671                                  
