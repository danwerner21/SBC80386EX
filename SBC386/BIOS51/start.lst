  1723                                  ;****** debugging stuff ******
  1724                                  %if 0
  1725                                  
  1726                                  
  1727                                  ; Hexadecimal output:
  1728                                  ; extdword(EAX)
  1729                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1730                                  ;
  1731                                  eout:   ror     eax,16          ; put out high word first
  1732                                          call    wout
  1733                                          shr     eax,16          ; put out the low word
  1734                                          jmp     wout
  1735                                  dout:   xchg    ax,dx           ; put out DX first
  1736                                          call    wout
  1737                                          mov     ax,dx
  1738                                  wout:   xchg    ah,al           ; put out AH first
  1739                                          call    bout
  1740                                          mov     al,ah           ; put out former AL
  1741                                  bout:   push    ax              ; save AL
  1742                                          shr     al,4            ; position High nibble
  1743                                          call    nout            ; write high nibble
  1744                                          pop     ax
  1745                                  nout:   and     al,0x0F         ; mask low nibble
  1746                                          daa                     ; divide by 10, AH=quotient, AL=remainder
  1747                                          add     al,0xF0         ; propagate quotient into the Carry flag
  1748                                          adc     al,0x40         ; form HEX digit
  1749                                          jmp     putc            ; 'putc' does the return
  1750                                  
  1751                                  
  1752                                  
  1753                                  ;
  1754                                  ; output an ASCII_SP to the console
  1755                                  ;
  1756                                  space:
  1757                                  	mov	al,ASCII_SP
  1758                                  	jmp	putc
  1759                                  ;
  1760                                  ; output a CR/LF to the console
  1761                                  ;
  1762                                  ;;crlf:
  1763                                  ;
  1764                                  ; outc -- write an ASCII 'cooked' character
  1765                                  ;       Convert NL to CR,NL
  1766                                  ;
  1767                                  outc:
  1768                                          cmp     al,ASCII_NL     ; test for NL
  1769                                          jne     putc            ; if not, just put out the character
  1770                                  crlf:
  1771                                          mov     al,ASCII_CR     ; get a CR
  1772                                          call    putc            ; write it out
  1773                                          mov     al,ASCII_NL     ; restore NL
  1774                                  ;
  1775                                  ; putc -- put out a character in AL to the SIO0 port
  1776                                  ;
  1777                                  putc:
  1778                                  	push	dx		; register save
  1779                                  	push	ax		; PUSH EAX
  1780                                  putc1:
  1781                                          mov     dx,LSR0         ; Line Status Register
  1782                                  
  1783                                          in      al,dx
  1784                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1785                                          jz      putc1
  1786                                  
  1787                                          pop     ax
  1788                                          mov     dx,TBR0         ; Transmit buffer register
  1789                                          out     dx,al           ; send the character
  1790                                  
  1791                                          pop     dx              ; register restore
  1792                                          ret
  1793                                  %endif
  1794                                  
  1795                                  
  1796                                  
  1797                                  ;        setloc (0x100000-(ROM<<10)-16)
  1798 0000023F 90                      	align	16
  1799                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1800                                  ; The Real Mode statup jump
  1801                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1802                                  	bits	16
  1803 00000240 EA[0000][0000]          	jmp	far origin
  1804 00000245 FF<rept>                	times 9 db 0FFh
  1805 0000024E FC00                    	db	0FCh, 00h		; PC/AT
  1806                                  
  1807                                  segment BOOT
  1808                                  %include "boot.asm"
  1809                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1810                              <1> ;boot.asm
  1811                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1812                              <1> ; The Real Mode statup jump
  1813                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1814                              <1> 	bits	16
  1815                              <1> 
  1816                              <1> SEGBASE equ 0x10000-(ROM<<6)
  1817                              <1> 
  1818                              <1>         align   16
  1819                              <1> bootstrap:
  1820 00000000 EA000000F0          <1>         jmp     SEGBASE:0000	; 5 byte real-mode far call
  1821                              <1> %include "date.inc"
  1822                              <2> ; date.inc
  1823                              <2> ;
  1824                              <2> ; must be exactly 8 characters
  1825                              <2> ;
  1826 00000005 30332F32342F3138    <2> 	db	"03/24/18"
  1827 0000000D FFFC00              <1> 	db	0xFF, 0xFC, 0x00	; PC/AT
  1828                              <1> 
  1829                              <1> 
  1830                              <1> 
  1831                              <1> 
  1832                                  
