  1211                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1212                                  ; initb_cx	primitive entry
  1213                                  ; initb		callable entry (but uses CX)
  1214                                  ;
  1215                                  ;    Enter with:
  1216                                  ;
  1217                                  ;	DS:SI	pointing at the table of BYTES to init.
  1218                                  ;	CX	used to hold the return address
  1219                                  ;
  1220                                  ;    Exit with:
  1221                                  ;	AX,DX	trashed
  1222                                  ;	CX	used to hold the return
  1223                                  ;	SI	updated
  1224                                  ;	
  1225                                  ;	All other registers preserved
  1226                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1227                                  initb:
  1228 00000040 59                              pop     cx
  1229                                  initb_cx:
  1230 00000041 AD                      	lodsw                   ; get destination port
  1231 00000042 89C2                            mov     dx,ax		; put where useful
  1232 00000044 40                              inc     ax              ; test for EOF
  1233 00000045 7404                    	jz	.9		; EOF? if so, return
  1234                                  
  1235 00000047 AC                      	lodsb                   ; get port value
  1236 00000048 EE                              out     dx,al           ; output port value
  1237 00000049 EBF6                            jmp     initb_cx
  1238                                  .9:
  1239 0000004B FFE1                            jmp     cx              ; EOF, return
  1240                                  
  1241                                  
  1242                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
