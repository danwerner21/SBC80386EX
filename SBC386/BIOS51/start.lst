  1622                                  segment	CODE
  1623                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1624                                  ; seg_test -- test a segment of memory (variable size)
  1625                                  ; seg_test_bx	ditto, but returns through BX
  1626                                  ;
  1627                                  ;    Enter with:
  1628                                  ;	ES:SI	points at area to test
  1629                                  ;	DX	count of size of area in DWORDS (16K==full segment)
  1630                                  ;
  1631                                  ;    Exit with:
  1632                                  ;	ES:SI	unchanged
  1633                                  ;	DX	unchanged
  1634                                  ;	memory area is cleared to Zeroes if successful
  1635                                  ;
  1636                                  ;    Error Condition:
  1637                                  ;	*** WILL HALT ***	so have the LITES set up
  1638                                  ;
  1639                                  ;    Trashes:
  1640                                  ;	EAX
  1641                                  ;	BX	is used for the return
  1642                                  ;	CX
  1643                                  ;	DI
  1644                                  ;
  1645                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1646                                  
  1647                                  seg_test:
  1648 000001F2 5B                      	pop	bx
  1649                                  seg_test_bx:
  1650                                  
