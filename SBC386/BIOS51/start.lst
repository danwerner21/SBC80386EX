  1695 00000226 EC                      	in	al,dx		; read the latch
  1696 00000227 240F                    	and	al,0Fh		; preserve bits
  1697 00000229 08E0                    	or	al,ah		; set the new bits
  1698 0000022B EE                      	out	dx,al		; put out the new LITES value
  1699                                  
  1700 0000022C 585A                    	popm	ax,dx
  1701 0000022E C3                      	ret
