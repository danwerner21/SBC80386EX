  1244                                  ; initw		callable entry (but uses CX)
  1245                                  ;
  1246                                  ;    Enter with:
  1247                                  ;
  1248                                  ;	DS:SI	pointing at the table of WORDS to init.
  1249                                  ;	CX	used to hold the return address
  1250                                  ;
  1251                                  ;    Exit with:
  1252                                  ;	AX,DX	trashed
  1253                                  ;	CX	used to hold the return
  1254                                  ;	SI	updated
  1255                                  ;	
  1256                                  ;	All other registers preserved
  1257                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1258                                  initw:
