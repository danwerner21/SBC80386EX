   182                                  ; vgoto -- move the terminal cursor to the BDA cursor position
   183                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   184                                  vgoto:
   185 00000095 515350                  	pushm	ax,bx,cx
