   106                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   107                                  ; vputc -- write AL to the serial console
   108                                  ;
   109                                  ; Everything preserved.  INT 14h is used rather than VIDEO_putchar
   110                                  ; because VIDEO_putchar is about to be pointed here, and that would be
   111                                  ; a loop.
   112                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   113                                  vputc:
   114 0000003E 575652515350            	pushm	ax,bx,cx,dx,si,di
