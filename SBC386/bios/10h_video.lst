    55 00000000 ????                <1> offset_di	resw	1		; PUSHA (all) save*//
    56 00000002 ????                <1> offset_si	resw	1
    57 00000004 ????                <1> offset_bp	resw	1
    58 00000006 ????                <1> offset_sp	resw	1
    59 00000008 ????                <1> offset_bx	resw	1
    60 0000000A ????                <1> offset_dx	resw	1
    61 0000000C ????                <1> offset_cx	resw	1
    62 0000000E ????                <1> offset_ax	resw	1
