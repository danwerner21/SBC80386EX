    65 00000012 ????                <1> offset_es	resw	1
    66                              <1> ; */
    67 00000014 ????                <1> offset_ip	resw	1
    68 00000016 ????                <1> offset_cs	resw	1		; set for IRET */
    69 00000018 ????                <1> offset_flags	resw	1	; flag.0 is the Crrry */
    70                              <1> endstruc
