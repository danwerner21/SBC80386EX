   156                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   157                                  ; vcursor -- BX = the current page's cursor word, AH = row, AL = column
   158                                  ; vsetcur -- store AH/AL back as the current page's cursor
   159                                  ;
