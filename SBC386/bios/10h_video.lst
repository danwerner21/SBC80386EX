   409                              <1> defb    LSR_OE  equ     BIT1
   410                              <1> defb    LSR_RBF equ     BIT0
   411                              <1> 
   412                              <1> ;/* MSRx bits
   413                              <1> ;*/
   414                              <1> defb	MSR_DCD	equ	BIT7
   415                              <1> defb	MSR_RI 	equ	BIT6
   416                              <1> defb	MSR_DSR	equ	BIT5
   417                              <1> defb	MSR_CTS	equ	BIT4
   418                              <1> defb	MSR_deltaDCD	equ	BIT3
   419                              <1> defb	MSR_deltaRI	equ	BIT2
   420                              <1> defb	MSR_deltaDSR	equ	BIT1
   421                              <1> defb	MSR_deltaCTS	equ	BIT0
   422                              <1> 
   423                              <1> ;/* Bits in CR0
   424                              <1> ;*/
   425                              <1> defb    CR0_PE  equ     BIT0
   426                              <1> defb    CR0_MP  equ     BIT1
   427                              <1> defb    CR0_EM  equ     BIT2
   428                              <1> defb    CR0_TS  equ     BIT3
   429                              <1> defd    CR0_WP  equ     BIT16
   430                              <1> defd    CR0_PG  equ     BIT31
   431                              <1> 
   432                              <1> ;/* Some ASCII character codes
   433                              <1> ;*/
   434                              <1> defb    ASCII_NUL       equ     0x00
   435                              <1> defb    ASCII_BS        equ     0x08
   436                              <1> defb    ASCII_HT        equ     0x09
   437                              <1> defb    ASCII_LF        equ     0x0A
   438                              <1> defb    ASCII_NL        equ     0x0A
   439                              <1> defb    ASCII_FF        equ     0x0C
   440                              <1> defb    ASCII_CR        equ     0x0D
   441                              <1> defb	ASCII_ESC	equ	0x1B
   442                              <1> defb    ASCII_SP        equ     0x20
   443                              <1> defb    ASCII_DEL       equ     0x7F
   444                              <1> defb	ASCII_RUB	equ	0xFF
   445                              <1> 
