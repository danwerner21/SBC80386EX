   185 000000E1 ????                <1> nvram_info	resb	2	; 31 bytes of NVRAM information (this may move)*//
   186                              <1> ; starts with 2 bytes of SIO0 params */
   187 000000E3 ????                <1> floppy_tab	resb	2		; floppy disk driver table */
   188 000000E5 ????????????????    <1> disk_tab	resb	8  		; hard disk driver table */
   189 000000ED ??                  <1> boot_order	resb	1		; which device INT 19h tries, and in what order */
   190 000000EE ??                  <1> console_sel	resb	1		; which console SETUP was told to use */
   191 000000EF <res Fh>            <1> nvram_unused	resb	15
   192 000000FE ????                <1> nvram_checksum	resw	1	; 31st byte of the NVRAM info */
   193                              <1> ; end of 31 bytes of NVRAM information */
   194                              <1> ; */
   195 00000100 ??                  <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte*//
   196                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   197 00000101 ??                  <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   198                              <1> ; */
   199                              <1> ; Extentsion to BDA during BIOS startup */
   200                              <1> ; */
   201                              <1> endstruc
   201          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    48                                  %undef XXX
    49                                  
    50                                  	global	int_10h
    51                                  
    52                                  	extern	vga3_putc, vga3_cells, vga3_getcell, vga3_cursor
    53                                  	extern	vga3_shape, vga3_scroll_up, vga3_scroll_dn, vga3_clear
    54                                  
    55                                  segment	_TEXT
    56                                  
    57                                  VID_COLS	equ	80		; the terminal we assume
    58                                  VID_ROWS	equ	25
    59                                  VID_MODE	equ	3		; 80x25 colour text
    60                                  VID_ATTR	equ	0x07		; normal white on black
    61                                  ASCII_BEL	equ	0x07
    62                                  
    63                                  
    64                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    65                                  ; INT 10h entry
    66                                  ;
    67                                  ; DS is pointed at the BIOS data area throughout, so the video fields
    68                                  ; are addressed directly.  Anything in the ROM needs a CS override --
    69                                  ; which is why the escape sequences below are built a character at a
    70                                  ; time instead of coming from strings.
    71                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    72                                  int_10h:
    73 00000000 FB                      	sti
    74 00000001 061E60                  	pushm	all,ds,es
    75 00000004 89E5                    	mov	bp,sp
    76 00000006 FC                      	cld
    77                                  
    78 00000007 6A401F                  	get_bda	DS			; the BDA is all the state there is
    79                                  
    80 0000000A 80FC1B                  	cmp	ah,len_v_tab
    81 0000000D 730B                    	jnb	v_done			; unsupported: return quietly, as a
    82                                  					;  real BIOS does -- never an error
    83                                  
    84 0000000F 88E3                    	mov	bl,ah
    85 00000011 30FF                    	xor	bh,bh
    86 00000013 01DB                    	add	bx,bx
    87 00000015 2EFFA7[1E00]               cs	jmp	word [bx+v_tab]
    88                                  
    89                                  v_done:
    90 0000001A 611F07                  	popm	all,ds,es
    91 0000001D CF                      	iret
    92                                  
    93                                  
    94                                  	align	2
    95                                  v_tab:
    96 0000001E [5501]                  	dw	v_fn00		; 00 set mode
    97 00000020 [D301]                  	dw	v_fn01		; 01 set cursor shape
    98 00000022 [EA01]                  	dw	v_fn02		; 02 set cursor position
    99 00000024 [0D02]                  	dw	v_fn03		; 03 get cursor position
   100 00000026 [1A00]                  	dw	v_done		; 04 read light pen -- no
   101 00000028 [2602]                  	dw	v_fn05		; 05 set active page
   102 0000002A [0403]                  	dw	v_fn06		; 06 scroll up
   103 0000002C [0803]                  	dw	v_fn07		; 07 scroll down
   104 0000002E [F102]                  	dw	v_fn08		; 08 read character/attribute
   105 00000030 [C202]                  	dw	v_fn09		; 09 write character and attribute
   106 00000032 [C202]                  	dw	v_fn0A		; 0A write character
   107 00000034 [1A00]                  	dw	v_done		; 0B set palette -- nothing to set
   108 00000036 [1A00]                  	dw	v_done		; 0C write pixel -- text only
   109 00000038 [1A00]                  	dw	v_done		; 0D read pixel  -- text only
   110 0000003A [7702]                  	dw	v_fn0E		; 0E teletype
   111 0000003C [3402]                  	dw	v_fn0F		; 0F get mode
   112 0000003E [1A00]                  	dw	v_done		; 10 palette -- nothing to set
   113 00000040 [1A00]                  	dw	v_done		; 11 character generator -- one font, in ROM
   114 00000042 [4B02]                  	dw	v_fn12		; 12 alternate select: the EGA information call
   115 00000044 [1A00]                  	dw	v_done		; 13 write string -- not yet
   116 00000046 [1A00]                  	dw	v_done		; 14..19
   117 00000048 [1A00]                  	dw	v_done
   118 0000004A [1A00]                  	dw	v_done
   119 0000004C [1A00]                  	dw	v_done
   120 0000004E [1A00]                  	dw	v_done
   121 00000050 [1A00]                  	dw	v_done
   122 00000052 [6202]                  	dw	v_fn1A		; 1A display combination code
   123                                  len_v_tab	equ	($-v_tab)/2
   124                                  
   125                                  
   126                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   127                                  ; vputc -- write AL to the serial console
   128                                  ;
   129                                  ; Everything preserved.  INT 14h is used rather than VIDEO_putchar
   130                                  ; because VIDEO_putchar is about to be pointed here, and that would be
   131                                  ; a loop.
   132                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   133                                  vputc:
   134 00000054 F606890001              	test	byte [console],CON_SERIAL
   135 00000059 7412                    	jz	.9			; the serial console is off
   136 0000005B 575652515350            	pushm	ax,bx,cx,dx,si,di
   137 00000061 B401                    	mov	ah,1			; write character
   138 00000063 31D2                    	xor	dx,dx			; COM1
   139 00000065 CD14                    	int	0x14
   140 00000067 585B595A5E5F            	popm	ax,bx,cx,dx,si,di
   141 0000006D C3                      .9:	ret
   142                                  
   143                                  
   144                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   145                                  ; vputdec2 -- write AL as exactly two decimal digits
   146                                  ;
   147                                  ; ANSI accepts leading zeros, so two digits always is both correct and
   148                                  ; much shorter than suppressing them.  Rows reach 25 and columns 80, so
   149                                  ; two is enough.
   150                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   151                                  vputdec2:
   152 0000006E 5350                    	pushm	ax,bx
   153 00000070 30E4                    	xor	ah,ah
   154 00000072 B30A                    	mov	bl,10
   155 00000074 F6F3                    	div	bl			; AL = tens, AH = units
   156 00000076 0430                    	add	al,'0'
   157 00000078 E8D9FF                  	call	vputc
   158 0000007B 88E0                    	mov	al,ah
   159 0000007D 0430                    	add	al,'0'
   160 0000007F E8D2FF                  	call	vputc
   161 00000082 585B                    	popm	ax,bx
   162 00000084 C3                      	ret
   163                                  
   164                                  
   165                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   166                                  ; vcsi -- emit ESC [
   167                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   168                                  vcsi:
   169 00000085 50                      	pushm	ax
   170 00000086 B01B                    	mov	al,ASCII_ESC
   171 00000088 E8C9FF                  	call	vputc
   172 0000008B B05B                    	mov	al,'['
   173 0000008D E8C4FF                  	call	vputc
   174 00000090 58                      	popm	ax
   175 00000091 C3                      	ret
   176                                  
   177                                  
   178                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   179                                  ; vcursor -- BX = the current page's cursor word, AH = row, AL = column
   180                                  ; vsetcur -- store AH/AL back as the current page's cursor
   181                                  ;
   182                                  ;  DS is the BDA.
   183                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   184                                  vcursor:
   185 00000092 8A1E6200                	mov	bl,[vid_active_page]
   186 00000096 80E307                  	and	bl,7
   187 00000099 30FF                    	xor	bh,bh
   188 0000009B 01DB                    	add	bx,bx
   189 0000009D 8B4750                  	mov	ax,[bx+vid_cursor]
   190 000000A0 C3                      	ret
   191                                  
   192                                  vsetcur:
   193 000000A1 53                      	pushm	bx
   194 000000A2 8A1E6200                	mov	bl,[vid_active_page]
   195 000000A6 80E307                  	and	bl,7
   196 000000A9 30FF                    	xor	bh,bh
   197 000000AB 01DB                    	add	bx,bx
   198 000000AD 894750                  	mov	[bx+vid_cursor],ax
   199 000000B0 F606890002              	test	byte [console],CON_VIDEO
   200 000000B5 7403                    	jz	.9
   201 000000B7 E8(0000)                	call	vga3_cursor		; AH row, AL column
   202 000000BA 5B                      .9:	popm	bx
   203 000000BB C3                      	ret
   204                                  
   205                                  
   206                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   207                                  ; vgoto -- move the terminal cursor to the BDA cursor position
   208                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   209                                  vgoto:
   210 000000BC 515350                  	pushm	ax,bx,cx
   211 000000BF E8D0FF                  	call	vcursor			; AH = row, AL = column
   212 000000C2 89C1                    	mov	cx,ax
   213 000000C4 E8BEFF                  	call	vcsi
   214 000000C7 88E8                    	mov	al,ch			; row
   215 000000C9 FEC0                    	inc	al			; ANSI counts from one
   216 000000CB E8A0FF                  	call	vputdec2
   217 000000CE B03B                    	mov	al,';'
   218 000000D0 E881FF                  	call	vputc
   219 000000D3 88C8                    	mov	al,cl			; column
   220 000000D5 FEC0                    	inc	al
   221 000000D7 E894FF                  	call	vputdec2
   222 000000DA B048                    	mov	al,'H'
   223 000000DC E875FF                  	call	vputc
   224 000000DF 585B59                  	popm	ax,bx,cx
   225 000000E2 C3                      	ret
   226                                  
   227                                  
   228                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   229                                  ; g_scroll1 -- the whole board up one line, for the cursor falling off
   230                                  ; the bottom.  The terminal did the same by itself.
   231                                  g_scroll1:
   232 000000E3 F606890002              	test	byte [console],CON_VIDEO
   233 000000E8 7414                    	jz	.9
   234 000000EA 52515350                	pushm	ax,bx,cx,dx
   235 000000EE 31C9                    	xor	cx,cx			; from 0,0
   236 000000F0 BA4F18                  	mov	dx,((VID_ROWS-1)<<8)|(VID_COLS-1)
   237 000000F3 B001                    	mov	al,1
   238 000000F5 B707                    	mov	bh,VID_ATTR
   239 000000F7 E8(0000)                	call	vga3_scroll_up
   240 000000FA 585B595A                	popm	ax,bx,cx,dx
   241 000000FE C3                      .9:	ret
   242                                  
   243                                  
   244                                  ; Cursor movement, tracked in the BDA.  The terminal does the real work
   245                                  ; -- it wraps and scrolls by itself -- so these only keep our idea of
   246                                  ; where the cursor is in step with what the terminal has done.
   247                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   248                                  v_advance:				; one column right, wrapping
   249 000000FF 515350                  	pushm	ax,bx,cx
   250 00000102 E88DFF                  	call	vcursor			; AH = row, AL = column
   251 00000105 FEC0                    	inc	al
   252 00000107 3C50                    	cmp	al,VID_COLS
   253 00000109 720E                    	jb	.9
   254 0000010B 30C0                    	xor	al,al			; wrapped: column 0 of the next row
   255 0000010D FEC4                    	inc	ah
   256 0000010F 80FC19                  	cmp	ah,VID_ROWS
   257 00000112 7205                    	jb	.9
   258 00000114 B418                    	mov	ah,VID_ROWS-1		; the terminal scrolled; stay on the
   259 00000116 E8CAFF                  	call	g_scroll1		;  bottom row, and scroll the board too
   260                                  .9:
   261 00000119 E885FF                  	call	vsetcur
   262 0000011C 585B59                  	popm	ax,bx,cx
   263 0000011F C3                      	ret
   264                                  
   265                                  v_col0:					; carriage return
   266 00000120 5350                    	pushm	ax,bx
   267 00000122 E86DFF                  	call	vcursor
   268 00000125 30C0                    	xor	al,al
   269 00000127 E877FF                  	call	vsetcur
   270 0000012A 585B                    	popm	ax,bx
   271 0000012C C3                      	ret
   272                                  
   273                                  v_nextrow:				; line feed
   274 0000012D 5350                    	pushm	ax,bx
   275 0000012F E860FF                  	call	vcursor
   276 00000132 FEC4                    	inc	ah
   277 00000134 80FC19                  	cmp	ah,VID_ROWS
   278 00000137 7205                    	jb	.9
   279 00000139 B418                    	mov	ah,VID_ROWS-1
   280 0000013B E8A5FF                  	call	g_scroll1
   281                                  .9:
   282 0000013E E860FF                  	call	vsetcur
   283 00000141 585B                    	popm	ax,bx
   284 00000143 C3                      	ret
   285                                  
   286                                  v_backsp:				; backspace
   287 00000144 5350                    	pushm	ax,bx
   288 00000146 E849FF                  	call	vcursor
   289 00000149 08C0                    	or	al,al
   290 0000014B 7402                    	jz	.9			; already at the left margin
   291 0000014D FEC8                    	dec	al
   292                                  .9:
   293 0000014F E84FFF                  	call	vsetcur
   294 00000152 585B                    	popm	ax,bx
   295 00000154 C3                      	ret
   296                                  
   297                                  
   298                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   299                                  ; fn 00 -- set video mode
   300                                  ;
   301                                  ;  AL = mode; bit 7 set means do not clear the screen
   302                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   303                                  v_fn00:
   304 00000155 8A460E                  	mov	al,[bp+offset_ax]
   305 00000158 88C4                    	mov	ah,al
   306 0000015A 247F                    	and	al,0x7F
   307 0000015C A24900                  	mov	[vid_mode],al
   308                                  
   309 0000015F C7064A005000            	mov	word [vid_columns],VID_COLS
   310 00000165 C606840018              	mov	byte [ega_rows],VID_ROWS-1
   311 0000016A C70685001000            	mov	word [ega_points],16		; 16 lines a character
   312 00000170 C606870060              	mov	byte [ega_info],0x60		; EGA active, colour, 256K -- see fn 12
   313 00000175 C606880009              	mov	byte [ega_info_3],0x09		; switches: colour 80x25
   314 0000017A C7064C00A00F            	mov	word [vid_buf_len],VID_COLS*VID_ROWS*2
   315 00000180 C7064E000000            	mov	word [vid_start],0
   316 00000186 C606620000              	mov	byte [vid_active_page],0
   317 0000018B C7066300D403            	mov	word [vid_addr_chip],0x03D4
   318 00000191 C606660000              	mov	byte [vid_palette],0
   319                                  
   320                                  ; The cursor shape has to be stated, not left as whatever the BDA held at
   321                                  ; power-up.  Function 03 reports this word, and a program that saves the
   322                                  ; shape on entry and restores it on exit -- which every full-screen DOS
   323                                  ; program does -- will faithfully put back what it was told.  Told zero,
   324                                  ; it sets scan line 0 to 0: a cursor one line thick at the top of the
   325                                  ; cell, which on a sixteen-line cell reads as the row above.  Turbo C did
   326                                  ; exactly that, and it survived CLS because a shape is a CRTC register
   327                                  ; and not something on the screen.
   328                                  ;
   329                                  ; 13 and 14 are the lines vga3.asm programs at reset, so the two agree.
   330 00000196 C70660000E0D            	mov	word [vid_cursor_mode],(13<<8)|14
   331                                  
   332 0000019C 5153                    	pushm	bx,cx
   333 0000019E 31DB                    	xor	bx,bx
   334 000001A0 B90800                  	mov	cx,8
   335 000001A3 C747500000              .1:	mov	word [bx+vid_cursor],0
   336 000001A8 83C302                  	add	bx,2
   337 000001AB E2F6                    	loop	.1
   338 000001AD 5B59                    	popm	bx,cx
   339                                  
   340 000001AF F6C480                  	test	ah,0x80			; caller asked us not to clear?
   341 000001B2 0F8564FE                	jnz	v_done			; then leave the terminal alone entirely
   342                                  
   343 000001B6 E8CCFE                  	call	vcsi			; ESC [ 2 J -- erase the screen
   344 000001B9 B032                    	mov	al,'2'
   345 000001BB E896FE                  	call	vputc
   346 000001BE B04A                    	mov	al,'J'
   347 000001C0 E891FE                  	call	vputc
   348 000001C3 F606890002              	test	byte [console],CON_VIDEO
   349 000001C8 7403                    	jz	.2
   350 000001CA E8(0000)                	call	vga3_clear
   351 000001CD E8ECFE                  .2:	call	vgoto
   352 000001D0 E947FE                  	jmp	v_done
   353                                  
   354                                  
   355                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   356                                  ; fn 01 -- set cursor shape.  Recorded; the board takes it, a terminal
   357                                  ; has one of its own.
   358                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   359                                  v_fn01:
   360 000001D3 8B460C                  	mov	ax,[bp+offset_cx]
   361 000001D6 A36000                  	mov	[vid_cursor_mode],ax
   362 000001D9 F606890002              	test	byte [console],CON_VIDEO
   363 000001DE 0F8438FE                	jz	v_done
   364 000001E2 89C1                    	mov	cx,ax
   365 000001E4 E8(0000)                	call	vga3_shape
   366 000001E7 E930FE                  	jmp	v_done
   367                                  
   368                                  
   369                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   370                                  ; fn 02 -- set cursor position.  DH = row, DL = column, BH = page.
   371                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   372                                  v_fn02:
   373 000001EA 8B5E08                  	mov	bx,[bp+offset_bx]
   374 000001ED 88F8                    	mov	al,bh
   375 000001EF 2407                    	and	al,7
   376 000001F1 A26200                  	mov	[vid_active_page],al
   377                                  
   378 000001F4 8B460A                  	mov	ax,[bp+offset_dx]	; AH = row, AL = column
   379 000001F7 80FC19                  	cmp	ah,VID_ROWS
   380 000001FA 7202                    	jb	.1
   381 000001FC B418                    	mov	ah,VID_ROWS-1
   382 000001FE 3C50                    .1:	cmp	al,VID_COLS
   383 00000200 7202                    	jb	.2
   384 00000202 B04F                    	mov	al,VID_COLS-1
   385                                  .2:
   386 00000204 E89AFE                  	call	vsetcur
   387 00000207 E8B2FE                  	call	vgoto
   388 0000020A E90DFE                  	jmp	v_done
   389                                  
   390                                  
   391                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   392                                  ; fn 03 -- get cursor position.  BH = page.
   393                                  ;
   394                                  ;  Returns DH = row, DL = column, CX = cursor shape.
   395                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   396                                  v_fn03:
   397 0000020D 8B5E08                  	mov	bx,[bp+offset_bx]
   398 00000210 88F8                    	mov	al,bh
   399 00000212 2407                    	and	al,7
   400 00000214 A26200                  	mov	[vid_active_page],al
   401                                  
   402 00000217 E878FE                  	call	vcursor			; AH = row, AL = column
   403 0000021A 89460A                  	mov	[bp+offset_dx],ax
   404 0000021D A16000                  	mov	ax,[vid_cursor_mode]
   405 00000220 89460C                  	mov	[bp+offset_cx],ax
   406 00000223 E9F4FD                  	jmp	v_done
   407                                  
   408                                  
   409                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   410                                  ; fn 05 -- set the active display page
   411                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   412                                  v_fn05:
   413 00000226 8A460E                  	mov	al,[bp+offset_ax]
   414 00000229 2407                    	and	al,7
   415 0000022B A26200                  	mov	[vid_active_page],al
   416 0000022E E88BFE                  	call	vgoto
   417 00000231 E9E6FD                  	jmp	v_done
   418                                  
   419                                  
   420                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   421                                  ; fn 0F -- get the current mode
   422                                  ;
   423                                  ;  Returns AL = mode, AH = column count, BH = active page.
   424                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   425                                  v_fn0F:
   426 00000234 A04900                  	mov	al,[vid_mode]
   427 00000237 8A264A00                	mov	ah,[vid_columns]
   428 0000023B 89460E                  	mov	[bp+offset_ax],ax
   429 0000023E 8B5E08                  	mov	bx,[bp+offset_bx]
   430 00000241 8A3E6200                	mov	bh,[vid_active_page]
   431 00000245 895E08                  	mov	[bp+offset_bx],bx
   432 00000248 E9CFFD                  	jmp	v_done
   433                                  
   434                                  
   435                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   436                                  ; fn 12, BL = 10 -- EGA information;  fn 1A, AL = 00 -- display combination
   437                                  ;
   438                                  ; The two questions a program asks before writing the screen itself.  A
   439                                  ; program that hears "CGA" -- which is what silence means -- avoids snow
   440                                  ; the CGA way: it polls the status port at 3DAh before every write.  On
   441                                  ; this board that port is undecoded, 209 ms a read and a floating bus,
   442                                  ; so the program hangs or crawls.  One that hears "VGA" writes B800
   443                                  ; directly and moves the cursor through fn 02, both of which work.  So:
   444                                  ; VGA, colour, 256K -- the answers, not the hardware, but the answers a
   445                                  ; program acts on correctly.  Other subfunctions are left untouched, as
   446                                  ; the convention is for an unsupported call.
   447                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   448                                  v_fn12:
   449 0000024B 8B5E08                  	mov	bx,[bp+offset_bx]
   450 0000024E 80FB10                  	cmp	bl,0x10
   451 00000251 0F85C5FD                	jne	v_done
   452 00000255 C746080300              	mov	word [bp+offset_bx],0x0003	; BH 0 colour, BL 3 = 256K
   453 0000025A C7460C0900              	mov	word [bp+offset_cx],0x0009	; CH feature bits, CL switches: colour 80x25
   454 0000025F E9B8FD                  	jmp	v_done
   455                                  
   456                                  v_fn1A:
   457 00000262 8B460E                  	mov	ax,[bp+offset_ax]
   458 00000265 08C0                    	or	al,al
   459 00000267 0F85AFFD                	jnz	v_done			; only the read form
   460 0000026B C6460E1A                	mov	byte [bp+offset_ax],0x1A	; "supported"
   461 0000026F C746080800              	mov	word [bp+offset_bx],0x0008	; BL 8 VGA colour, BH 0 no second display
   462 00000274 E9A3FD                  	jmp	v_done
   463                                  
   464                                  
   465                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   466                                  ; fn 0E -- teletype output.  AL = character.
   467                                  ;
   468                                  ; The one function DOS leans on hardest.  Printable characters go out
   469                                  ; and move the cursor; the four control codes that matter are passed
   470                                  ; through and tracked.  The terminal does its own wrapping and
   471                                  ; scrolling, so there is nothing to do but keep our idea of the cursor
   472                                  ; in step.
   473                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   474                                  v_fn0E:
   475 00000277 8A460E                  	mov	al,[bp+offset_ax]
   476                                  
   477 0000027A 3C0D                    	cmp	al,ASCII_CR
   478 0000027C 7423                    	je	.cr
   479 0000027E 3C0A                    	cmp	al,ASCII_LF
   480 00000280 7428                    	je	.lf
   481 00000282 3C08                    	cmp	al,ASCII_BS
   482 00000284 742D                    	je	.bs
   483 00000286 3C07                    	cmp	al,ASCII_BEL
   484 00000288 7432                    	je	.bell
   485 0000028A 3C20                    	cmp	al,ASCII_SP
   486 0000028C 722E                    	jb	.bell			; any other control: emit, do not track
   487                                  
   488 0000028E E8C3FD                  	call	vputc
   489 00000291 F606890002              	test	byte [console],CON_VIDEO
   490 00000296 7403                    	jz	.adv
   491 00000298 E8(0000)                	call	vga3_putc
   492 0000029B E861FE                  .adv:	call	v_advance
   493 0000029E E979FD                  	jmp	v_done
   494                                  .cr:
   495 000002A1 E8B0FD                  	call	vputc
   496 000002A4 E879FE                  	call	v_col0
   497 000002A7 E970FD                  	jmp	v_done
   498                                  .lf:
   499 000002AA E8A7FD                  	call	vputc
   500 000002AD E87DFE                  	call	v_nextrow
   501 000002B0 E967FD                  	jmp	v_done
   502                                  .bs:
   503 000002B3 E89EFD                  	call	vputc
   504 000002B6 E88BFE                  	call	v_backsp
   505 000002B9 E95EFD                  	jmp	v_done
   506                                  .bell:
   507 000002BC E895FD                  	call	vputc
   508 000002BF E958FD                  	jmp	v_done
   509                                  
   510                                  
   511                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   512                                  ; fn 09 -- write character and attribute, CX times
   513                                  ; fn 0A -- write character, CX times
   514                                  ;
   515                                  ;  AL = character, BH = page, BL = attribute (09 only), CX = count
   516                                  ;
   517                                  ; The BIOS contract is that the cursor does NOT move.  On a terminal the
   518                                  ; characters move it anyway, so it is put back afterwards.  The
   519                                  ; attribute is discarded: there is nowhere to keep it, and emitting SGR
   520                                  ; for it would fight with whatever the application is doing.
   521                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   522                                  v_fn09:
   523                                  v_fn0A:
   524 000002C2 8B4E0C                  	mov	cx,[bp+offset_cx]
   525 000002C5 09C9                    	or	cx,cx
   526 000002C7 0F844FFD                	jz	v_done			; a count of zero writes nothing
   527                                  
   528 000002CB 8B460E                  	mov	ax,[bp+offset_ax]	; AL character, AH the function
   529 000002CE F606890002              	test	byte [console],CON_VIDEO
   530 000002D3 740F                    	jz	.1
   531 000002D5 8A5E08                  	mov	bl,[bp+offset_bx]	; the attribute, for 09
   532 000002D8 30D2                    	xor	dl,dl
   533 000002DA 80FC09                  	cmp	ah,0x09
   534 000002DD 7502                    	jne	.v
   535 000002DF FEC2                    	inc	dl			; 09 writes the attribute too
   536 000002E1 E8(0000)                .v:	call	vga3_cells
   537                                  .1:
   538 000002E4 51                      	push	cx
   539 000002E5 E86CFD                  	call	vputc
   540 000002E8 59                      	pop	cx
   541 000002E9 E2F9                    	loop	.1
   542                                  
   543 000002EB E8CEFD                  	call	vgoto			; the cursor did not officially move
   544 000002EE E929FD                  	jmp	v_done
   545                                  
   546                                  
   547                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   548                                  ; fn 08 -- read the character and attribute at the cursor
   549                                  ;
   550                                  ; There is no buffer to read, and no terminal answers this.  A space in
   551                                  ; the normal attribute is returned: it is what an unwritten cell holds,
   552                                  ; it is what the few callers that use this are usually testing for, and
   553                                  ; it is at least consistent.  This is the one function the no-buffer
   554                                  ; decision makes dishonest, and it is recorded here rather than left for
   555                                  ; someone to discover.
   556                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   557                                  v_fn08:
   558 000002F1 B82007                  	mov	ax,(VID_ATTR<<8) | ASCII_SP
   559 000002F4 F606890002              	test	byte [console],CON_VIDEO
   560 000002F9 7403                    	jz	.1
   561 000002FB E8(0000)                	call	vga3_getcell		; the board can be asked
   562 000002FE 89460E                  .1:	mov	[bp+offset_ax],ax
   563 00000301 E916FD                  	jmp	v_done
   564                                  
   565                                  
   566                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   567                                  ; fn 06 -- scroll a window up
   568                                  ; fn 07 -- scroll a window down
   569                                  ;
   570                                  ;  AL = lines to scroll, zero means blank the whole window
   571                                  ;  CH,CL = top-left row,column     DH,DL = bottom-right row,column
   572                                  ;  BH = attribute for the blanked lines
   573                                  ;
   574                                  ; A whole-screen scroll becomes a real terminal scroll.  Anything
   575                                  ; smaller is served by setting a scrolling region, scrolling inside it,
   576                                  ; and putting the region back -- which is what DOS's full-screen
   577                                  ; programs are asking for.  A window that is the whole screen and a
   578                                  ; count of zero is the common "clear the screen" call.
   579                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   580                                  v_fn06:
   581 00000304 B353                    	mov	bl,'S'			; ESC [ n S -- scroll up
   582 00000306 EB02                    	jmp	short v_scroll
   583                                  v_fn07:
   584 00000308 B354                    	mov	bl,'T'			; ESC [ n T -- scroll down
   585                                  
   586                                  v_scroll:
   587 0000030A 8B4E0C                  	mov	cx,[bp+offset_cx]	; CH = top row, CL = left column
   588 0000030D 8B560A                  	mov	dx,[bp+offset_dx]	; DH = bottom row, DL = right column
   589 00000310 8A460E                  	mov	al,[bp+offset_ax]	; lines
   590                                  
   591 00000313 F606890002              	test	byte [console],CON_VIDEO
   592 00000318 7412                    	jz	.serial
   593 0000031A 53                      	push	bx
   594 0000031B 8A7E09                  	mov	bh,[bp+offset_bx+1]	; the attribute for the blanked lines
   595 0000031E 80FB53                  	cmp	bl,'S'
   596 00000321 7505                    	jne	.dn
   597 00000323 E8(0000)                	call	vga3_scroll_up
   598 00000326 EB03                    	jmp	short .vd
   599 00000328 E8(0000)                .dn:	call	vga3_scroll_dn
   600 0000032B 5B                      .vd:	pop	bx
   601                                  .serial:
   602                                  ; A count of zero, or a count covering the window, blanks it.
   603 0000032C 08C0                    	or	al,al
   604 0000032E 7440                    	jz	.blank
   605 00000330 88F4                    	mov	ah,dh
   606 00000332 28EC                    	sub	ah,ch
   607 00000334 FEC4                    	inc	ah			; window height
   608 00000336 38E0                    	cmp	al,ah
   609 00000338 7336                    	jnb	.blank
   610                                  
   611                                  ; Set the scrolling region to the window, scroll, then release it.
   612 0000033A 50                      	push	ax
   613 0000033B E847FD                  	call	vcsi
   614 0000033E 88E8                    	mov	al,ch
   615 00000340 FEC0                    	inc	al
   616 00000342 E829FD                  	call	vputdec2
   617 00000345 B03B                    	mov	al,';'
   618 00000347 E80AFD                  	call	vputc
   619 0000034A 88F0                    	mov	al,dh
   620 0000034C FEC0                    	inc	al
   621 0000034E E81DFD                  	call	vputdec2
   622 00000351 B072                    	mov	al,'r'			; ESC [ top ; bottom r
   623 00000353 E8FEFC                  	call	vputc
   624                                  
   625 00000356 E82CFD                  	call	vcsi
   626 00000359 58                      	pop	ax
   627 0000035A E811FD                  	call	vputdec2
   628 0000035D 88D8                    	mov	al,bl			; 'S' or 'T'
   629 0000035F E8F2FC                  	call	vputc
   630                                  
   631 00000362 E820FD                  	call	vcsi			; ESC [ r -- region back to full screen
   632 00000365 B072                    	mov	al,'r'
   633 00000367 E8EAFC                  	call	vputc
   634 0000036A E84FFD                  	call	vgoto
   635 0000036D E9AAFC                  	jmp	v_done
   636                                  
   637                                  .blank:
   638                                  ; Blank the window a row at a time: position, then erase to end of line.
   639                                  ; ESC [ 2 J would be wrong for anything but the full screen.
   640 00000370 88E8                    	mov	al,ch			; current row
   641                                  .1:
   642 00000372 38F0                    	cmp	al,dh
   643 00000374 7727                    	ja	.9
   644 00000376 50                      	push	ax
   645 00000377 E80BFD                  	call	vcsi
   646 0000037A FEC0                    	inc	al
   647 0000037C E8EFFC                  	call	vputdec2
   648 0000037F B03B                    	mov	al,';'
   649 00000381 E8D0FC                  	call	vputc
   650 00000384 88C8                    	mov	al,cl			; left column
   651 00000386 FEC0                    	inc	al
   652 00000388 E8E3FC                  	call	vputdec2
   653 0000038B B048                    	mov	al,'H'
   654 0000038D E8C4FC                  	call	vputc
   655 00000390 E8F2FC                  	call	vcsi
   656 00000393 B04B                    	mov	al,'K'			; erase to end of line
   657 00000395 E8BCFC                  	call	vputc
   658 00000398 58                      	pop	ax
   659 00000399 FEC0                    	inc	al
   660 0000039B EBD5                    	jmp	.1
   661                                  .9:
   662 0000039D E81CFD                  	call	vgoto
   663 000003A0 E977FC                  	jmp	v_done
