    73                              <1> ;/* i386EX.inc  --  register definitions for the Intel 80386EX processor
    74                              <1> ;
    75                              <1> %define defb
    76                              <1> %define defw
    77                              <1> %define defd
    78                              <1> ;*/
    79                              <1> 
    80                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    81                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    82                              <1> ;*  first thing it does, so anything that restarts the board in software has
    83                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    84                              <1> ;*  hard way.
    85                              <1> ;*/
    86                              <1> defw    DEVICE_ID equ   0x2309
    87                              <1> 
    88                              <1> ;/* The Address Configuration register
    89                              <1> ;*/
    90                              <1> defb REMAPCFGH  equ     0x0023
    91                              <1> defb REMAPCFGL  equ     0x0022
    92                              <1> defw REMAPCFG   equ     0x0022
    93                              <1> 
    94                              <1> ;/* The A20gate and fast CPU Reset
    95                              <1> ;*/
    96                              <1> defb PORT92     equ     0xF092
    97                              <1> defb PORT92_AT  equ     0x0092
    98                              <1> 
    99                              <1> ;
   100                              <1> ;/* The DMA Controller and Bus Arbiter
   101                              <1> ;*/
