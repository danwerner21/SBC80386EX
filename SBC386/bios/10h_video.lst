   116 00000046 31D2                    	xor	dx,dx			; COM1
   117 00000048 CD14                    	int	0x14
   118 0000004A 585B595A5E5F            	popm	ax,bx,cx,dx,si,di
   119 00000050 C3                      	ret
   120                                  
   121                                  
   122                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   123                                  ; vputdec2 -- write AL as exactly two decimal digits
   124                                  ;
   125                                  ; ANSI accepts leading zeros, so two digits always is both correct and
   126                                  ; much shorter than suppressing them.  Rows reach 25 and columns 80, so
   127                                  ; two is enough.
   128                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   129                                  vputdec2:
   130 00000051 5350                    	pushm	ax,bx
   131 00000053 30E4                    	xor	ah,ah
   132 00000055 B30A                    	mov	bl,10
   133 00000057 F6F3                    	div	bl			; AL = tens, AH = units
   134 00000059 0430                    	add	al,'0'
   135 0000005B E8E0FF                  	call	vputc
   136 0000005E 88E0                    	mov	al,ah
   137 00000060 0430                    	add	al,'0'
   138 00000062 E8D9FF                  	call	vputc
   139 00000065 585B                    	popm	ax,bx
   140 00000067 C3                      	ret
   141                                  
