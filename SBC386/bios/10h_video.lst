   413                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   414                                  ; fn 09 -- write character and attribute, CX times
   415                                  ; fn 0A -- write character, CX times
   416                                  ;
   417                                  ;  AL = character, BH = page, BL = attribute (09 only), CX = count
   418                                  ;
   419                                  ; The BIOS contract is that the cursor does NOT move.  On a terminal the
   420                                  ; characters move it anyway, so it is put back afterwards.  The
   421                                  ; attribute is discarded: there is nowhere to keep it, and emitting SGR
   422                                  ; for it would fight with whatever the application is doing.
   423                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   424                                  v_fn09:
   425                                  v_fn0A:
   426 00000215 8B4E0C                  	mov	cx,[bp+offset_cx]
   427 00000218 09C9                    	or	cx,cx
   428 0000021A 0F84FCFD                	jz	v_done			; a count of zero writes nothing
   429                                  
   430 0000021E 8A460E                  	mov	al,[bp+offset_ax]
   431                                  .1:
   432 00000221 51                      	push	cx
   433 00000222 E819FE                  	call	vputc
   434 00000225 59                      	pop	cx
   435 00000226 E2F9                    	loop	.1
   436                                  
   437 00000228 E86AFE                  	call	vgoto			; the cursor did not officially move
   438 0000022B E9ECFD                  	jmp	v_done
   439                                  
   440                                  
   441                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   442                                  ; fn 08 -- read the character and attribute at the cursor
   443                                  ;
   444                                  ; There is no buffer to read, and no terminal answers this.  A space in
   445                                  ; the normal attribute is returned: it is what an unwritten cell holds,
   446                                  ; it is what the few callers that use this are usually testing for, and
   447                                  ; it is at least consistent.  This is the one function the no-buffer
   448                                  ; decision makes dishonest, and it is recorded here rather than left for
   449                                  ; someone to discover.
   450                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   451                                  v_fn08:
   452 0000022E B82007                  	mov	ax,(VID_ATTR<<8) | ASCII_SP
   453 00000231 89460E                  	mov	[bp+offset_ax],ax
   454 00000234 E9E3FD                  	jmp	v_done
   455                                  
   456                                  
   457                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   458                                  ; fn 06 -- scroll a window up
   459                                  ; fn 07 -- scroll a window down
   460                                  ;
   461                                  ;  AL = lines to scroll, zero means blank the whole window
   462                                  ;  CH,CL = top-left row,column     DH,DL = bottom-right row,column
   463                                  ;  BH = attribute for the blanked lines
   464                                  ;
   465                                  ; A whole-screen scroll becomes a real terminal scroll.  Anything
   466                                  ; smaller is served by setting a scrolling region, scrolling inside it,
   467                                  ; and putting the region back -- which is what DOS's full-screen
   468                                  ; programs are asking for.  A window that is the whole screen and a
   469                                  ; count of zero is the common "clear the screen" call.
   470                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   471                                  v_fn06:
   472 00000237 B353                    	mov	bl,'S'			; ESC [ n S -- scroll up
   473 00000239 EB02                    	jmp	short v_scroll
   474                                  v_fn07:
   475 0000023B B354                    	mov	bl,'T'			; ESC [ n T -- scroll down
   476                                  
   477                                  v_scroll:
   478 0000023D 8B4E0C                  	mov	cx,[bp+offset_cx]	; CH = top row, CL = left column
   479 00000240 8B560A                  	mov	dx,[bp+offset_dx]	; DH = bottom row, DL = right column
   480 00000243 8A460E                  	mov	al,[bp+offset_ax]	; lines
   481                                  
   482                                  ; A count of zero, or a count covering the window, blanks it.
   483 00000246 08C0                    	or	al,al
   484 00000248 7440                    	jz	.blank
   485 0000024A 88F4                    	mov	ah,dh
   486 0000024C 28EC                    	sub	ah,ch
   487 0000024E FEC4                    	inc	ah			; window height
   488 00000250 38E0                    	cmp	al,ah
   489 00000252 7336                    	jnb	.blank
   490                                  
   491                                  ; Set the scrolling region to the window, scroll, then release it.
   492 00000254 50                      	push	ax
   493 00000255 E810FE                  	call	vcsi
   494 00000258 88E8                    	mov	al,ch
   495 0000025A FEC0                    	inc	al
   496 0000025C E8F2FD                  	call	vputdec2
   497 0000025F B03B                    	mov	al,';'
   498 00000261 E8DAFD                  	call	vputc
   499 00000264 88F0                    	mov	al,dh
   500 00000266 FEC0                    	inc	al
   501 00000268 E8E6FD                  	call	vputdec2
   502 0000026B B072                    	mov	al,'r'			; ESC [ top ; bottom r
   503 0000026D E8CEFD                  	call	vputc
   504                                  
   505 00000270 E8F5FD                  	call	vcsi
   506 00000273 58                      	pop	ax
   507 00000274 E8DAFD                  	call	vputdec2
   508 00000277 88D8                    	mov	al,bl			; 'S' or 'T'
   509 00000279 E8C2FD                  	call	vputc
   510                                  
   511 0000027C E8E9FD                  	call	vcsi			; ESC [ r -- region back to full screen
   512 0000027F B072                    	mov	al,'r'
   513 00000281 E8BAFD                  	call	vputc
   514 00000284 E80EFE                  	call	vgoto
   515 00000287 E990FD                  	jmp	v_done
   516                                  
   517                                  .blank:
   518                                  ; Blank the window a row at a time: position, then erase to end of line.
   519                                  ; ESC [ 2 J would be wrong for anything but the full screen.
   520 0000028A 88E8                    	mov	al,ch			; current row
   521                                  .1:
   522 0000028C 38F0                    	cmp	al,dh
   523 0000028E 7727                    	ja	.9
   524 00000290 50                      	push	ax
   525 00000291 E8D4FD                  	call	vcsi
   526 00000294 FEC0                    	inc	al
   527 00000296 E8B8FD                  	call	vputdec2
   528 00000299 B03B                    	mov	al,';'
   529 0000029B E8A0FD                  	call	vputc
   530 0000029E 88C8                    	mov	al,cl			; left column
   531 000002A0 FEC0                    	inc	al
   532 000002A2 E8ACFD                  	call	vputdec2
   533 000002A5 B048                    	mov	al,'H'
   534 000002A7 E894FD                  	call	vputc
   535 000002AA E8BBFD                  	call	vcsi
   536 000002AD B04B                    	mov	al,'K'			; erase to end of line
   537 000002AF E88CFD                  	call	vputc
