    38                                  %include "macro.inc"
    39                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    40                              <1> ;
    41                              <1> ; some useful macros:
    42                              <1> ;
    43                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    44                              <1> %define NREPEAT 0
    45                              <1> 
    46                              <1> %if NREPEAT
    47                              <1> 
    48                              <1> %macro	rep	1
    49                              <1> %%loop:	%1
    50                              <1> 	dec	cx
    51                              <1> 	jnz	%%loop
    52                              <1> %endm
    53                              <1> 
    54                              <1> %macro	repne	1
    55                              <1> %%loop:	%1
    56                              <1> 	je	%%e
    57                              <1> 	dec	cx
    58                              <1> 	jnz	%%loop
    59                              <1> 	cmp	cx,1
    60                              <1> 	jmp	%%done
    61                              <1> %%e:	dec	cx
    62                              <1> 	cmp	cx,cx
    63                              <1> %%done:
    64                              <1> %endm
    65                              <1> 
    66                              <1> %macro	repe	1
    67                              <1> %%loop:	%1
    68                              <1> 	jne	%%ne
    69                              <1> 	dec	cx
    70                              <1> 	jnz	%%loop
    71                              <1> 	jmp	%%done
    72                              <1> %%ne:	dec	cx
    73                              <1> 	jcxz	%%cxz
    74                              <1> 	jmp	%%done
    75                              <1> %%cxz:	cmp	cx,1
    76                              <1> %%done:
    77                              <1> %endm
    78                              <1> 
    79                              <1> %macro	REP	1
    80                              <1> %%loop:	%1
    81                              <1> 	dec	ecx
    82                              <1> 	jnz	%%loop
    83                              <1> %endm
    84                              <1> 
    85                              <1> %macro	REPNE	1
    86                              <1> %%loop:	%1
    87                              <1> 	je	%%e
    88                              <1> 	dec	ecx
    89                              <1> 	jnz	%%loop
    90                              <1> 	cmp	cl,1
    91                              <1> 	jmp	%%done
    92                              <1> %%e:	dec	ecx
    93                              <1> 	cmp	cl,cl
    94                              <1> %%done:
    95                              <1> %endm
    96                              <1> 
    97                              <1> %macro	REPE	1
    98                              <1> %%loop:	%1
    99                              <1> 	jne	%%ne
   100                              <1> 	dec	ecx
   101                              <1> 	jnz	%%loop
   102                              <1> 	jmp	%%done
   103                              <1> %%ne:	dec	ecx
   104                              <1> 	jecxz	%%cxz
   105                              <1> 	jmp	%%done
   106                              <1> %%cxz:	cmp	cl,1
   107                              <1> %%done:
   108                              <1> %endm
   109                              <1> 
   110                              <1> %endif
   111                              <1> 
   112                              <1> 
   113                              <1> ;
   114                              <1> ; format of the BYTE initialization table:  address, byte
   115                              <1> ;
   116                              <1> %imacro  binit 2
   117                              <1>         dw      %1
   118                              <1>         db      %2
   119                              <1> %endmacro
   120                              <1> ; end with DW -1
   121                              <1> 
   122                              <1> ;
   123                              <1> ; format of the WORD initialization table:  address, word
   124                              <1> ;
   125                              <1> %imacro  winit 2
   126                              <1>         dw      %1
   127                              <1>         dw      %2
   128                              <1> %endmacro
   129                              <1> ; end with DW -1
   130                              <1> 
   131                              <1> 
   132                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   133                              <1> %imacro get_bda	1.nolist
   134                              <1> 	push	0x0040
   135                              <1> 	pop	%1
   136                              <1> 	cnop
   137                              <1> %endm
   138                              <1> 
   139                              <1> 
   140                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   141                              <1> %imacro	get_loc0 1.nolist
   142                              <1> 	push	0x0000
   143                              <1> 	pop	%1
   144                              <1> 	cnop
   145                              <1> %endm
   146                              <1> 
   147                              <1> 
   148                              <1> 
   149                              <1> %imacro setloc  1.nolist
   150                              <1>  times   (%1-($-$$)) db 0FFh
   151                              <1> %endm
   152                              <1> 
   153                              <1> %imacro db_lo   1
   154                              <1>  db (%1)&255
   155                              <1> %endm
   156                              <1> 
   157                              <1> %imacro cnop    0.nolist
   158                              <1> %ifdef SOFT_DEBUG
   159                              <1> %if SOFT_DEBUG
   160                              <1>         nop
   161                              <1> %endif
   162                              <1> %endif
   163                              <1> %endm
   164                              <1> 
   165                              <1> %imacro popm 1-*.nolist
   166                              <1> %rep %0
   167                              <1> %ifidni %1,ALL
   168                              <1>  popa
   169                              <1> %elifidni %1,F
   170                              <1>  popf
   171                              <1> %else
   172                              <1>  pop %1
   173                              <1> %ifidni %1,DS
   174                              <1>  cnop
   175                              <1> %elifidni %1,ES
   176                              <1>  cnop
   177                              <1> %elifidni %1,FS
   178                              <1>  cnop
   179                              <1> %elifidni %1,GS
   180                              <1>  cnop
   181                              <1> %endif
   182                              <1> %endif
   183                              <1> %rotate 1
   184                              <1> %endrep
   185                              <1> %endm
   186                              <1> 
   187                              <1> %imacro pushm 1-*.nolist
   188                              <1> %rep %0
   189                              <1> %rotate -1
   190                              <1> %ifidni %1,ALL
   191                              <1>  pusha
   192                              <1> %elifidni %1,F
   193                              <1>  pushf
   194                              <1> %else
   195                              <1>  push %1
   196                              <1> %endif
   197                              <1> %endrep
   198                              <1> %endm
   199                              <1> 
   200                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   201                              <1> %assign __size__ (%2-1)	| 0xFF
   202                              <1> %if (__size__ <= 0xFFFF)
   203                              <1> %assign __gran__ 0
   204                              <1> %else
   205                              <1> %assign __gran__ 0xC0			; G B 0 0
   206                              <1> %endif
   207                              <1> %assign __expand__ 0
   208                              <1> %if %0==3
   209                              <1> %if %3
   210                              <1> %assign __expand__ 4
   211                              <1> %endif
   212                              <1> %endif
   213                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   214                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   215                              <1> %endm
   216                              <1> 
   217                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   218                              <1> %assign __size__ (%2-1)	| 0xFF
   219                              <1> %if (__size__ <= 0xFFFF)
   220                              <1> %assign __gran__ 0
   221                              <1> %else
   222                              <1> %assign __gran__ 0xC0			; G D 0 0
   223                              <1> %endif
   224                              <1> %assign __conform__ 0
   225                              <1> %if %0==3
   226                              <1> %if %3
   227                              <1> %assign __conform__ 4
   228                              <1> %endif
   229                              <1> %endif
   230                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   231                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   232                              <1> %endm
   233                              <1> 
   234                              <1> ;/* End of macro.inc */
