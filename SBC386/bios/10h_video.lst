   411                              <1> defb    MCR1    equ     0x02FC
   412                              <1> defb    LSR1    equ     0x02FD
   413                              <1> defb    MSR1    equ     0x02FE
   414                              <1> defb    SCR1    equ     0x02FF
   415                              <1> 
   416                              <1> ;/* LSRx bits
   417                              <1> ;*/
   418                              <1> defb    LSR_TE  equ     BIT6
   419                              <1> defb    LSR_TBE equ     BIT5
   420                              <1> defb    LSR_BI  equ     BIT4
