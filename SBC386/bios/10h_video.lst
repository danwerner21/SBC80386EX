    44                                  %include "macro.inc"
    45                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    46                              <1> ;
    47                              <1> ; some useful macros:
    48                              <1> ;
    49                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    50                              <1> %define NREPEAT 0
    51                              <1> 
    52                              <1> %if NREPEAT
    53                              <1> 
    54                              <1> %macro	rep	1
    55                              <1> %%loop:	%1
    56                              <1> 	dec	cx
    57                              <1> 	jnz	%%loop
    58                              <1> %endm
    59                              <1> 
    60                              <1> %macro	repne	1
    61                              <1> %%loop:	%1
    62                              <1> 	je	%%e
    63                              <1> 	dec	cx
    64                              <1> 	jnz	%%loop
    65                              <1> 	cmp	cx,1
    66                              <1> 	jmp	%%done
    67                              <1> %%e:	dec	cx
    68                              <1> 	cmp	cx,cx
    69                              <1> %%done:
    70                              <1> %endm
    71                              <1> 
    72                              <1> %macro	repe	1
    73                              <1> %%loop:	%1
    74                              <1> 	jne	%%ne
    75                              <1> 	dec	cx
    76                              <1> 	jnz	%%loop
    77                              <1> 	jmp	%%done
    78                              <1> %%ne:	dec	cx
    79                              <1> 	jcxz	%%cxz
    80                              <1> 	jmp	%%done
    81                              <1> %%cxz:	cmp	cx,1
    82                              <1> %%done:
    83                              <1> %endm
    84                              <1> 
    85                              <1> %macro	REP	1
    86                              <1> %%loop:	%1
    87                              <1> 	dec	ecx
    88                              <1> 	jnz	%%loop
    89                              <1> %endm
    90                              <1> 
    91                              <1> %macro	REPNE	1
    92                              <1> %%loop:	%1
    93                              <1> 	je	%%e
    94                              <1> 	dec	ecx
    95                              <1> 	jnz	%%loop
    96                              <1> 	cmp	cl,1
    97                              <1> 	jmp	%%done
    98                              <1> %%e:	dec	ecx
    99                              <1> 	cmp	cl,cl
   100                              <1> %%done:
   101                              <1> %endm
   102                              <1> 
   103                              <1> %macro	REPE	1
   104                              <1> %%loop:	%1
   105                              <1> 	jne	%%ne
   106                              <1> 	dec	ecx
   107                              <1> 	jnz	%%loop
   108                              <1> 	jmp	%%done
   109                              <1> %%ne:	dec	ecx
   110                              <1> 	jecxz	%%cxz
   111                              <1> 	jmp	%%done
   112                              <1> %%cxz:	cmp	cl,1
   113                              <1> %%done:
   114                              <1> %endm
   115                              <1> 
   116                              <1> %endif
   117                              <1> 
   118                              <1> 
   119                              <1> ;
   120                              <1> ; format of the BYTE initialization table:  address, byte
   121                              <1> ;
   122                              <1> %imacro  binit 2
   123                              <1>         dw      %1
   124                              <1>         db      %2
   125                              <1> %endmacro
   126                              <1> ; end with DW -1
   127                              <1> 
   128                              <1> ;
   129                              <1> ; format of the WORD initialization table:  address, word
   130                              <1> ;
   131                              <1> %imacro  winit 2
   132                              <1>         dw      %1
   133                              <1>         dw      %2
   134                              <1> %endmacro
   135                              <1> ; end with DW -1
   136                              <1> 
   137                              <1> 
   138                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   139                              <1> %imacro get_bda	1.nolist
   140                              <1> 	push	0x0040
   141                              <1> 	pop	%1
   142                              <1> 	cnop
   143                              <1> %endm
   144                              <1> 
   145                              <1> 
   146                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   147                              <1> %imacro	get_loc0 1.nolist
   148                              <1> 	push	0x0000
   149                              <1> 	pop	%1
   150                              <1> 	cnop
   151                              <1> %endm
   152                              <1> 
   153                              <1> 
   154                              <1> 
   155                              <1> %imacro setloc  1.nolist
   156                              <1>  times   (%1-($-$$)) db 0FFh
   157                              <1> %endm
   158                              <1> 
   159                              <1> %imacro db_lo   1
   160                              <1>  db (%1)&255
   161                              <1> %endm
   162                              <1> 
   163                              <1> %imacro cnop    0.nolist
   164                              <1> %ifdef SOFT_DEBUG
   165                              <1> %if SOFT_DEBUG
   166                              <1>         nop
   167                              <1> %endif
   168                              <1> %endif
   169                              <1> %endm
   170                              <1> 
   171                              <1> %imacro popm 1-*.nolist
   172                              <1> %rep %0
   173                              <1> %ifidni %1,ALL
   174                              <1>  popa
   175                              <1> %elifidni %1,F
   176                              <1>  popf
   177                              <1> %else
   178                              <1>  pop %1
   179                              <1> %ifidni %1,DS
   180                              <1>  cnop
   181                              <1> %elifidni %1,ES
   182                              <1>  cnop
   183                              <1> %elifidni %1,FS
   184                              <1>  cnop
   185                              <1> %elifidni %1,GS
   186                              <1>  cnop
   187                              <1> %endif
   188                              <1> %endif
   189                              <1> %rotate 1
   190                              <1> %endrep
   191                              <1> %endm
   192                              <1> 
   193                              <1> %imacro pushm 1-*.nolist
   194                              <1> %rep %0
   195                              <1> %rotate -1
   196                              <1> %ifidni %1,ALL
   197                              <1>  pusha
   198                              <1> %elifidni %1,F
   199                              <1>  pushf
   200                              <1> %else
   201                              <1>  push %1
   202                              <1> %endif
   203                              <1> %endrep
   204                              <1> %endm
   205                              <1> 
   206                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   207                              <1> %assign __size__ (%2-1)	| 0xFF
   208                              <1> %if (__size__ <= 0xFFFF)
   209                              <1> %assign __gran__ 0
   210                              <1> %else
   211                              <1> %assign __gran__ 0xC0			; G B 0 0
   212                              <1> %endif
   213                              <1> %assign __expand__ 0
   214                              <1> %if %0==3
   215                              <1> %if %3
   216                              <1> %assign __expand__ 4
   217                              <1> %endif
   218                              <1> %endif
   219                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   220                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   221                              <1> %endm
   222                              <1> 
   223                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   224                              <1> %assign __size__ (%2-1)	| 0xFF
   225                              <1> %if (__size__ <= 0xFFFF)
   226                              <1> %assign __gran__ 0
   227                              <1> %else
   228                              <1> %assign __gran__ 0xC0			; G D 0 0
   229                              <1> %endif
   230                              <1> %assign __conform__ 0
   231                              <1> %if %0==3
   232                              <1> %if %3
   233                              <1> %assign __conform__ 4
   234                              <1> %endif
   235                              <1> %endif
   236                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   237                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   238                              <1> %endm
   239                              <1> 
   240                              <1> ;/* End of macro.inc */
