   370                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   371                                  ; fn 0E -- teletype output.  AL = character.
   372                                  ;
   373                                  ; The one function DOS leans on hardest.  Printable characters go out
   374                                  ; and move the cursor; the four control codes that matter are passed
   375                                  ; through and tracked.  The terminal does its own wrapping and
   376                                  ; scrolling, so there is nothing to do but keep our idea of the cursor
   377                                  ; in step.
   378                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   379                                  v_fn0E:
   380 000001D4 8A460E                  	mov	al,[bp+offset_ax]
   381                                  
   382 000001D7 3C0D                    	cmp	al,ASCII_CR
   383 000001D9 7419                    	je	.cr
   384 000001DB 3C0A                    	cmp	al,ASCII_LF
   385 000001DD 741E                    	je	.lf
   386 000001DF 3C08                    	cmp	al,ASCII_BS
   387 000001E1 7423                    	je	.bs
   388 000001E3 3C07                    	cmp	al,ASCII_BEL
   389 000001E5 7428                    	je	.bell
   390 000001E7 3C20                    	cmp	al,ASCII_SP
   391 000001E9 7224                    	jb	.bell			; any other control: emit, do not track
   392                                  
   393 000001EB E850FE                  	call	vputc
   394 000001EE E8CBFE                  	call	v_advance
   395 000001F1 E926FE                  	jmp	v_done
   396                                  .cr:
