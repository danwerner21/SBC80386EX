     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; 10h_video.asm -- INT 10h, the video interface, on a serial terminal
     3                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     4                                  ;
     5                                  ; Copyright (C) 2026 Dan Werner.  All rights reserved.
     6                                  ; Provided for hobbyist use on the RetroBrew SBC-386EX board.
     7                                  ;
     8                                  ; This program is free software: you can redistribute it and/or modify
     9                                  ; it under the terms of the GNU General Public License as published by
    10                                  ; the Free Software Foundation, either version 3 of the License, or
    11                                  ; (at your option) any later version.
    12                                  ;
    13                                  ; This program is distributed in the hope that it will be useful,
    14                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                                  ; GNU General Public License for more details.
    17                                  ;
    18                                  ; You should have received a copy of the GNU General Public License
    19                                  ; along with this program in the file COPYING in the topmost source
    20                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    21                                  ;
    22                                  ;
    23                                  ; There is no display buffer.  Output goes to the serial console as
    24                                  ; ANSI/VT100, and the only state kept is the cursor and mode fields in
    25                                  ; the BDA -- deliberately, because real memory-mapped video is coming to
    26                                  ; this board later and a pretend buffer at B800:0000 would just have to
    27                                  ; be torn out again.
    28                                  ;
    29                                  ; The consequence, stated plainly: function 08h cannot report what is on
    30                                  ; the screen, and 09h/0Ah write to the terminal and put the cursor back
    31                                  ; rather than editing a buffer.  Everything DOS actually leans on --
    32                                  ; teletype, cursor, mode, scroll -- is honest.
    33                                  ;
    34                                  ; Assembly by NASM 2.08 is preferred
    35                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    36                                  %include "seg_def.inc"
    37                              <1> ; SEG_DEF.inc
    38                              <1> ;
    39                              <1> %ifndef SEG_DEF
    40                              <1> %define SEG_DEF 1
    41                              <1> 
    42                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    43                              <1> 
    44                              <1> segment CONST		align=16	class=DATA	public
    45                              <1> segment CONST2		align=2		class=DATA	public
    46                              <1> segment _DATA		align=16	class=DATA	public
    47                              <1> segment _BSS		align=16	class=DATA	public
    48                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    49                              <1> 
    50                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    51                              <1> 
    52                              <1> 
    53                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    54                              <1> 
    55                              <1> %define XXX
    56                              <1> %endif
    57                              <1> ;
    58                              <1> ; end SEG_DEF.inc
