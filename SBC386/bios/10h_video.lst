   118                              <1> ; */
   119                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
   120                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
   121                              <1> ; program can set it and jump to FFFF:0000 -- that is the PC convention  */
   122                              <1> ; and this BIOS honours it.                                             */
   123                              <1> %define WARM_BOOT 0x1234
   124                              <1> ; */
