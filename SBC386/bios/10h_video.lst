   433                              <1> defb	MSR_deltaRI	equ	BIT2
   434                              <1> defb	MSR_deltaDSR	equ	BIT1
   435                              <1> defb	MSR_deltaCTS	equ	BIT0
   436                              <1> 
   437                              <1> ;/* Bits in CR0
