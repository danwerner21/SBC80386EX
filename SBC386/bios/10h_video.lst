     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; 10h_video.asm -- INT 10h, the video interface: a serial terminal, the
     3                                  ;                  VGA3 board, or both at once
     4                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     5                                  ;
     6                                  ; Copyright (C) 2026 Dan Werner.  All rights reserved.
     7                                  ; Provided for hobbyist use on the RetroBrew SBC-386EX board.
     8                                  ;
     9                                  ; This program is free software: you can redistribute it and/or modify
    10                                  ; it under the terms of the GNU General Public License as published by
    11                                  ; the Free Software Foundation, either version 3 of the License, or
    12                                  ; (at your option) any later version.
    13                                  ;
    14                                  ; This program is distributed in the hope that it will be useful,
    15                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                                  ; GNU General Public License for more details.
    18                                  ;
    19                                  ; You should have received a copy of the GNU General Public License
    20                                  ; along with this program in the file COPYING in the topmost source
    21                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    22                                  ;
    23                                  ;
    24                                  ; Two outputs, chosen by bda.console.  The serial one is ANSI/VT100 down
    25                                  ; SIO0, and every byte of it passes through vputc, which is where that
    26                                  ; console is switched.  The video one is the ECB VGA3 board, through the
    27                                  ; primitives in vga3.asm, hooked in at the points below where something
    28                                  ; is drawn or the cursor moves.  With both bits set the screen is
    29                                  ; mirrored down the serial line, which is how a board with a monitor
    30                                  ; stays debuggable from another room.
    31                                  ;
    32                                  ; The BDA cursor is the one cursor.  The serial side keeps it in step
    33                                  ; with what the terminal has done; the video side draws where it says.
    34                                  ; That is what lets both run from one set of functions.
    35                                  ;
    36                                  ; Function 08h reads the VGA3 when it is on and returns a space when it
    37                                  ; is not: a terminal cannot be asked.  Serial-only, 09h/0Ah write to the
    38                                  ; terminal and put the cursor back rather than editing a buffer.
    39                                  ;
    40                                  ; Assembly by NASM 2.08 is preferred
    41                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    42                                  %include "seg_def.inc"
    43                              <1> ; SEG_DEF.inc
    44                              <1> ;
    45                              <1> %ifndef SEG_DEF
    46                              <1> %define SEG_DEF 1
    47                              <1> 
    48                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    49                              <1> 
    50                              <1> segment CONST		align=16	class=DATA	public
    51                              <1> segment CONST2		align=2		class=DATA	public
    52                              <1> segment _DATA		align=16	class=DATA	public
    53                              <1> segment _BSS		align=16	class=DATA	public
    54                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    55                              <1> 
    56                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    57                              <1> 
    58                              <1> 
    59                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    60                              <1> 
    61                              <1> %define XXX
    62                              <1> %endif
    63                              <1> ;
    64                              <1> ; end SEG_DEF.inc
    43                                  %include "i386ex.inc"
