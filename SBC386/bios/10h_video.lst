   107                              <1> defb DMA1TAR_AT equ     0x0002
   108                              <1> defb DMA1BYC    equ     0xF003
   109                              <1> defb DMA1BYC_AT equ     0x0003
   110                              <1> defb DMACMD1    equ     0xF008
   111                              <1> defb DMACMD1_AT equ     0x0008
   112                              <1> defb DMASTS     equ     0xF008
   113                              <1> defb DMASTS_AT  equ     0x0008
   114                              <1> defb DMASRR     equ     0xF009
   115                              <1> defb DMASRR_AT  equ     0x0009
   116                              <1> defb DMAMSK     equ     0xF00A
   117                              <1> defb DMAMSK_AT  equ     0x000A
   118                              <1> defb DMAMOD1    equ     0xF00B
   119                              <1> defb DMAMOD1_AT equ     0x000B
   120                              <1> defb DMACLRBP   equ     0xF00C
   121                              <1> defb DMACLRBP_AT equ    0x000C
   122                              <1> defb DMACLR     equ     0xF00D
   123                              <1> defb DMACLR_AT  equ     0x000D
   124                              <1> defb DMACLRMSK  equ     0xF00E
   125                              <1> defb DMACLRMSK_AT equ   0x000E
   126                              <1> defb DMAGRPMSK  equ     0xF00F
   127                              <1> defb DMAGRPMSK_AT equ   0x000F
