   203                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   204                                  ; Cursor movement, tracked in the BDA.  The terminal does the real work
   205                                  ; -- it wraps and scrolls by itself -- so these only keep our idea of
   206                                  ; where the cursor is in step with what the terminal has done.
   207                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   208                                  v_advance:				; one column right, wrapping
   209 000000BC 515350                  	pushm	ax,bx,cx
   210 000000BF E8B3FF                  	call	vcursor			; AH = row, AL = column
   211 000000C2 FEC0                    	inc	al
   212 000000C4 3C50                    	cmp	al,VID_COLS
   213 000000C6 720B                    	jb	.9
   214 000000C8 30C0                    	xor	al,al			; wrapped: column 0 of the next row
   215 000000CA FEC4                    	inc	ah
   216 000000CC 80FC19                  	cmp	ah,VID_ROWS
   217 000000CF 7202                    	jb	.9
   218 000000D1 B418                    	mov	ah,VID_ROWS-1		; the terminal scrolled; stay on the
   219                                  .9:					;  bottom row
   220 000000D3 E8AEFF                  	call	vsetcur
   221 000000D6 585B59                  	popm	ax,bx,cx
   222 000000D9 C3                      	ret
   223                                  
   224                                  v_col0:					; carriage return
   225 000000DA 5350                    	pushm	ax,bx
   226 000000DC E896FF                  	call	vcursor
   227 000000DF 30C0                    	xor	al,al
   228 000000E1 E8A0FF                  	call	vsetcur
   229 000000E4 585B                    	popm	ax,bx
   230 000000E6 C3                      	ret
   231                                  
   232                                  v_nextrow:				; line feed
   233 000000E7 5350                    	pushm	ax,bx
   234 000000E9 E889FF                  	call	vcursor
   235 000000EC FEC4                    	inc	ah
   236 000000EE 80FC19                  	cmp	ah,VID_ROWS
   237 000000F1 7202                    	jb	.9
   238 000000F3 B418                    	mov	ah,VID_ROWS-1
   239                                  .9:
   240 000000F5 E88CFF                  	call	vsetcur
   241 000000F8 585B                    	popm	ax,bx
   242 000000FA C3                      	ret
   243                                  
   244                                  v_backsp:				; backspace
   245 000000FB 5350                    	pushm	ax,bx
   246 000000FD E875FF                  	call	vcursor
   247 00000100 08C0                    	or	al,al
   248 00000102 7402                    	jz	.9			; already at the left margin
   249 00000104 FEC8                    	dec	al
   250                                  .9:
   251 00000106 E87BFF                  	call	vsetcur
   252 00000109 585B                    	popm	ax,bx
   253 0000010B C3                      	ret
