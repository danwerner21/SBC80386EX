    42                                  %undef XXX
    43                                  
    44                                  	global	int_10h
    45                                  
    46                                  segment	_TEXT
    47                                  
    48                                  VID_COLS	equ	80		; the terminal we assume
    49                                  VID_ROWS	equ	25
    50                                  VID_MODE	equ	3		; 80x25 colour text
    51                                  VID_ATTR	equ	0x07		; normal white on black
    52                                  ASCII_BEL	equ	0x07
    53                                  
    54                                  
    55                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    56                                  ; INT 10h entry
    57                                  ;
    58                                  ; DS is pointed at the BIOS data area throughout, so the video fields
    59                                  ; are addressed directly.  Anything in the ROM needs a CS override --
    60                                  ; which is why the escape sequences below are built a character at a
    61                                  ; time instead of coming from strings.
    62                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    63                                  int_10h:
    64 00000000 FB                      	sti
    65 00000001 061E60                  	pushm	all,ds,es
    66 00000004 89E5                    	mov	bp,sp
    67 00000006 FC                      	cld
    68                                  
    69 00000007 6A401F                  	get_bda	DS			; the BDA is all the state there is
    70                                  
    71 0000000A 80FC10                  	cmp	ah,len_v_tab
    72 0000000D 730B                    	jnb	v_done			; unsupported: return quietly, as a
    73                                  					;  real BIOS does -- never an error
    74                                  
    75 0000000F 88E3                    	mov	bl,ah
    76 00000011 30FF                    	xor	bh,bh
    77 00000013 01DB                    	add	bx,bx
    78 00000015 2EFFA7[1E00]               cs	jmp	word [bx+v_tab]
    79                                  
    80                                  v_done:
