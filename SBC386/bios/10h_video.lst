   187 0000009B 89C1                    	mov	cx,ax
   188 0000009D E8C8FF                  	call	vcsi
   189 000000A0 88E8                    	mov	al,ch			; row
   190 000000A2 FEC0                    	inc	al			; ANSI counts from one
   191 000000A4 E8AAFF                  	call	vputdec2
   192 000000A7 B03B                    	mov	al,';'
   193 000000A9 E892FF                  	call	vputc
   194 000000AC 88C8                    	mov	al,cl			; column
   195 000000AE FEC0                    	inc	al
   196 000000B0 E89EFF                  	call	vputdec2
