   411                              <1> defb	MSR_CTS	equ	BIT4
   412                              <1> defb	MSR_deltaDCD	equ	BIT3
   413                              <1> defb	MSR_deltaRI	equ	BIT2
   414                              <1> defb	MSR_deltaDSR	equ	BIT1
   415                              <1> defb	MSR_deltaCTS	equ	BIT0
   416                              <1> 
   417                              <1> ;/* Bits in CR0
   418                              <1> ;*/
   419                              <1> defb    CR0_PE  equ     BIT0
   420                              <1> defb    CR0_MP  equ     BIT1
   421                              <1> defb    CR0_EM  equ     BIT2
   422                              <1> defb    CR0_TS  equ     BIT3
   423                              <1> defd    CR0_WP  equ     BIT16
   424                              <1> defd    CR0_PG  equ     BIT31
   425                              <1> 
   426                              <1> ;/* Some ASCII character codes
   427                              <1> ;*/
   428                              <1> defb    ASCII_NUL       equ     0x00
   429                              <1> defb    ASCII_BS        equ     0x08
   430                              <1> defb    ASCII_HT        equ     0x09
   431                              <1> defb    ASCII_LF        equ     0x0A
   432                              <1> defb    ASCII_NL        equ     0x0A
   433                              <1> defb    ASCII_FF        equ     0x0C
   434                              <1> defb    ASCII_CR        equ     0x0D
   435                              <1> defb	ASCII_ESC	equ	0x1B
   436                              <1> defb    ASCII_SP        equ     0x20
   437                              <1> defb    ASCII_DEL       equ     0x7F
   438                              <1> defb	ASCII_RUB	equ	0xFF
