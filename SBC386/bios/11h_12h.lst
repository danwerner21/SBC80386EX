    30                                  %include "seg_def.inc"
    31                              <1> ; SEG_DEF.inc
    32                              <1> ;
    33                              <1> %ifndef SEG_DEF
    34                              <1> %define SEG_DEF 1
    35                              <1> 
    36                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    37                              <1> 
    38                              <1> segment CONST		align=16	class=DATA	public
    39                              <1> segment CONST2		align=2		class=DATA	public
    40                              <1> segment _DATA		align=16	class=DATA	public
    41                              <1> segment _BSS		align=16	class=DATA	public
    42                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    43                              <1> 
    44                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    45                              <1> 
    46                              <1> 
    47                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    48                              <1> 
    49                              <1> %define XXX
    50                              <1> %endif
    51                              <1> ;
    52                              <1> ; end SEG_DEF.inc
