    33                                  %include "macro.inc"
    34                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    35                              <1> ;
    36                              <1> ; some useful macros:
    37                              <1> ;
    38                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    39                              <1> %define NREPEAT 0
    40                              <1> 
    41                              <1> %if NREPEAT
    42                              <1> 
    43                              <1> %macro	rep	1
    44                              <1> %%loop:	%1
    45                              <1> 	dec	cx
    46                              <1> 	jnz	%%loop
    47                              <1> %endm
    48                              <1> 
    49                              <1> %macro	repne	1
    50                              <1> %%loop:	%1
    51                              <1> 	je	%%e
    52                              <1> 	dec	cx
    53                              <1> 	jnz	%%loop
    54                              <1> 	cmp	cx,1
    55                              <1> 	jmp	%%done
    56                              <1> %%e:	dec	cx
    57                              <1> 	cmp	cx,cx
    58                              <1> %%done:
    59                              <1> %endm
    60                              <1> 
    61                              <1> %macro	repe	1
    62                              <1> %%loop:	%1
    63                              <1> 	jne	%%ne
    64                              <1> 	dec	cx
    65                              <1> 	jnz	%%loop
    66                              <1> 	jmp	%%done
    67                              <1> %%ne:	dec	cx
    68                              <1> 	jcxz	%%cxz
    69                              <1> 	jmp	%%done
    70                              <1> %%cxz:	cmp	cx,1
    71                              <1> %%done:
    72                              <1> %endm
    73                              <1> 
    74                              <1> %macro	REP	1
    75                              <1> %%loop:	%1
    76                              <1> 	dec	ecx
    77                              <1> 	jnz	%%loop
    78                              <1> %endm
    79                              <1> 
    80                              <1> %macro	REPNE	1
    81                              <1> %%loop:	%1
    82                              <1> 	je	%%e
    83                              <1> 	dec	ecx
    84                              <1> 	jnz	%%loop
    85                              <1> 	cmp	cl,1
    86                              <1> 	jmp	%%done
    87                              <1> %%e:	dec	ecx
    88                              <1> 	cmp	cl,cl
    89                              <1> %%done:
    90                              <1> %endm
    91                              <1> 
    92                              <1> %macro	REPE	1
    93                              <1> %%loop:	%1
    94                              <1> 	jne	%%ne
    95                              <1> 	dec	ecx
    96                              <1> 	jnz	%%loop
    97                              <1> 	jmp	%%done
    98                              <1> %%ne:	dec	ecx
    99                              <1> 	jecxz	%%cxz
   100                              <1> 	jmp	%%done
   101                              <1> %%cxz:	cmp	cl,1
   102                              <1> %%done:
   103                              <1> %endm
   104                              <1> 
   105                              <1> %endif
   106                              <1> 
   107                              <1> 
   108                              <1> ;
   109                              <1> ; format of the BYTE initialization table:  address, byte
   110                              <1> ;
   111                              <1> %imacro  binit 2
   112                              <1>         dw      %1
   113                              <1>         db      %2
   114                              <1> %endmacro
   115                              <1> ; end with DW -1
   116                              <1> 
   117                              <1> ;
   118                              <1> ; format of the WORD initialization table:  address, word
   119                              <1> ;
   120                              <1> %imacro  winit 2
   121                              <1>         dw      %1
   122                              <1>         dw      %2
   123                              <1> %endmacro
   124                              <1> ; end with DW -1
   125                              <1> 
   126                              <1> 
   127                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   128                              <1> %imacro get_bda	1.nolist
   129                              <1> 	push	0x0040
   130                              <1> 	pop	%1
   131                              <1> 	cnop
   132                              <1> %endm
   133                              <1> 
   134                              <1> 
   135                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   136                              <1> %imacro	get_loc0 1.nolist
   137                              <1> 	push	0x0000
   138                              <1> 	pop	%1
   139                              <1> 	cnop
   140                              <1> %endm
   141                              <1> 
   142                              <1> 
   143                              <1> 
   144                              <1> %imacro setloc  1.nolist
   145                              <1>  times   (%1-($-$$)) db 0FFh
   146                              <1> %endm
   147                              <1> 
   148                              <1> %imacro db_lo   1
   149                              <1>  db (%1)&255
   150                              <1> %endm
   151                              <1> 
   152                              <1> %imacro cnop    0.nolist
   153                              <1> %ifdef SOFT_DEBUG
   154                              <1> %if SOFT_DEBUG
   155                              <1>         nop
   156                              <1> %endif
   157                              <1> %endif
   158                              <1> %endm
   159                              <1> 
   160                              <1> %imacro popm 1-*.nolist
   161                              <1> %rep %0
   162                              <1> %ifidni %1,ALL
   163                              <1>  popa
   164                              <1> %elifidni %1,F
   165                              <1>  popf
   166                              <1> %else
   167                              <1>  pop %1
   168                              <1> %ifidni %1,DS
   169                              <1>  cnop
   170                              <1> %elifidni %1,ES
   171                              <1>  cnop
   172                              <1> %elifidni %1,FS
   173                              <1>  cnop
   174                              <1> %elifidni %1,GS
   175                              <1>  cnop
   176                              <1> %endif
   177                              <1> %endif
   178                              <1> %rotate 1
   179                              <1> %endrep
   180                              <1> %endm
   181                              <1> 
   182                              <1> %imacro pushm 1-*.nolist
   183                              <1> %rep %0
   184                              <1> %rotate -1
   185                              <1> %ifidni %1,ALL
   186                              <1>  pusha
   187                              <1> %elifidni %1,F
   188                              <1>  pushf
   189                              <1> %else
   190                              <1>  push %1
   191                              <1> %endif
   192                              <1> %endrep
   193                              <1> %endm
   194                              <1> 
   195                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   196                              <1> %assign __size__ (%2-1)	| 0xFF
   197                              <1> %if (__size__ <= 0xFFFF)
   198                              <1> %assign __gran__ 0
   199                              <1> %else
   200                              <1> %assign __gran__ 0xC0			; G B 0 0
   201                              <1> %endif
   202                              <1> %assign __expand__ 0
   203                              <1> %if %0==3
   204                              <1> %if %3
   205                              <1> %assign __expand__ 4
   206                              <1> %endif
   207                              <1> %endif
   208                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   209                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   210                              <1> %endm
   211                              <1> 
   212                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   213                              <1> %assign __size__ (%2-1)	| 0xFF
   214                              <1> %if (__size__ <= 0xFFFF)
   215                              <1> %assign __gran__ 0
   216                              <1> %else
   217                              <1> %assign __gran__ 0xC0			; G D 0 0
   218                              <1> %endif
   219                              <1> %assign __conform__ 0
   220                              <1> %if %0==3
   221                              <1> %if %3
   222                              <1> %assign __conform__ 4
   223                              <1> %endif
   224                              <1> %endif
   225                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   226                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   227                              <1> %endm
   228                              <1> 
   229                              <1> ;/* End of macro.inc */
    34                                  
    35                                  	global	int_11h
    36                                  	global	int_12h
    37                                  segment _TEXT
    38                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    39                                  ; int_11h	Get Equipment Configuration word
    40                                  ;
    41                                  ;    Enter with:
    42                                  ;	nothing
    43                                  ;
    44                                  ;    Exit with:
    45                                  ;	AX	equipment configuration word; viz.,
    46                                  ;
    47                                  ;			bits 15 14	number of printers
    48                                  ;			bit  13		used on PC,XT,PCjr only
    49                                  ;			bit  12		1=game adapter present
    50                                  ;			bits 11 10 9	number of RS-232 ports
    51                                  ;			bit  8		reserved
    52                                  ;			bits 7 6	no. of floppy drives - 1, if bit0 set
    53                                  ;			bits 5 4	initial video mode
    54                                  ;						00 - reserved
    55                                  ;						01 - 40x25 color text
    56                                  ;						10 - 80x25 color text
    57                                  ;						11 - 80x25 monochrome
    58                                  ;			bit  3		no longer used (was on PC)
    59                                  ;			bit  2		has pointing device (PS/2)
    60                                  ;			bit  1		math coprocessor (FPU) installed
    61                                  ;			bit  0		has floppy disk(s) (see bits 7 6)
    62                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    63                                  
    64                                  int_11h:
    65 00000000 FB                      	sti
    66 00000001 1E                      	push	DS	;save seg. reg.
    67 00000002 6A401F                  	get_bda	DS
    68 00000005 A11000                  	mov	ax,[equip_flag]
    69 00000008 1F                      	pop	DS
    70                                  	cnop
    71 00000009 CF                      	iret
    72                                  
    73                                  
    74                                  
    75                                  
    76                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    77                                  ; int_12h	Get Conventional Memory size in K-words
    78                                  ;
    79                                  ;    Enter with:
    80                                  ;	nothing
    81                                  ;
    82                                  ;    Exit with:
    83                                  ;	AX	number of 1K blocks below 1Mb (up to 640)
    84                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    85                                  
    86                                  int_12h:
    87 0000000A FB                      	sti
    88 0000000B 1E                      	push	DS	;save seg. reg.
    89 0000000C 6A401F                  	get_bda	DS
    90 0000000F A11300                  	mov	ax,[memory_size]
    91 00000012 1F                      	pop	DS
    92                                  	cnop
    93 00000013 CF                      	iret
