   840                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   841                                  ; fn47 -- Extended Seek (packet call)
   842                                  ;
   843                                  ;  Enter with:
   844                                  ;	AH = 47h
   845                                  ;	DL = drive code
   846                                  ;	DS:SI = the 16-byte disk packet
   847                                  ;
   848                                  ;  There is no seek command in the 8-bit PIO path -- the drive seeks as
   849                                  ;  part of the next transfer -- so the useful work here is checking that
   850                                  ;  the caller is asking for somewhere that exists.  Unlike fn42/43/44,
   851                                  ;  which leave the drive to reject a bad address, this one has nothing
   852                                  ;  else to do, so it range-checks against max_lba.
   853                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   854                                  fn47_extended_seek:
   855 000003DD E8E6FC                  	call	get_disk_table		; ES:DI -> T_DISKTAB, BX = driver
   856 000003E0 E82DFD                  	call	pkt_rw_validate
   857                                  
   858 000003E3 668B4408                	mov	eax,[si + pkt_disk_LBA]
   859 000003E7 26663B450A                  es	cmp	eax,[di+max_lba]
   860 000003EC 0F83AFFD                	jnb	ret_sector_not_found
   861                                  
   862 000003F0 E98DFC                  	jmp	good_return
   863                                  
   864                                  
   865                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   866                                  ; fn48 -- Get Drive Parameters (packet call)
   867                                  ;
   868                                  ;  Enter with:
   869                                  ;	AH = 48h
   870                                  ;	DL = drive code
   871                                  ;	DS:SI = the result buffer, with pkt_param_size already set
   872                                  ;
   873                                  ;  Exit with:
   874                                  ;	the buffer filled in, pkt_param_size set to what was written
   875                                  ;	AH = 0, Carry clear
   876                                  ;
   877                                  ;  The C:H:S reported is the TRANSLATED geometry, the same one AH=08h
   878                                  ;  gives, so the two calls cannot disagree.  pkt_total_sectors is
   879                                  ;  max_lba, the real capacity, which is generally larger -- that is
   880                                  ;  expected, and is the whole reason the packet calls exist.
   881                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   882                                  fn48_get_drive_parameters:
   883 000003F3 E8D0FC                  	call	get_disk_table		; ES:DI -> T_DISKTAB
   884                                  
   885 000003F6 833C1A                  	cmp	word [si + pkt_param_size],26
   886 000003F9 0F827BFC                	jb	ret_invalid_command	; buffer too small to fill in
   887                                  
   888 000003FD 26660FB705              	movzx	eax,word [es:di+ncylinders]
   889 00000402 66894404                	mov	[si + pkt_phys_cylinders],eax
   890 00000406 26660FB64502            	movzx	eax,byte [es:di+n__heads]
   891 0000040C 66894408                	mov	[si + pkt_phys_heads],eax
   892 00000410 26660FB6450E            	movzx	eax,byte [es:di+nsectors]
   893 00000416 6689440C                	mov	[si + pkt_phys_sectors],eax
   894                                  
   895 0000041A 26668B450A                  es	mov	eax,[di+max_lba]
   896 0000041F 66894410                	mov	[si + pkt_total_sectors],eax
   897 00000423 66C7441400000000        	mov	dword [si + pkt_total_sectors+4],0
   898                                  
   899 0000042B C744180002              	mov	word [si + pkt_bytes],512
   900 00000430 C744020200              	mov	word [si + ppt_info],0x0002	; bit 1: geometry is valid
   901                                  
   902 00000435 833C1E                  	cmp	word [si + pkt_param_size],30
   903 00000438 720F                    	jb	.short_form
   904                                  
   905                                  ; room for the EDD pointer, which this BIOS does not publish
   906 0000043A 66C7441AFFFFFFFF        	mov	dword [si + pkt_EDD_param_ptr],0xFFFFFFFF
   907 00000442 C7041E00                	mov	word [si + pkt_param_size],30
   908 00000446 E937FC                  	jmp	good_return
   909                                  
   910                                  .short_form:
   911 00000449 C7041A00                	mov	word [si + pkt_param_size],26
   912 0000044D E930FC                  	jmp	good_return
