   213                              <1> defw    CS5ADL  equ     0xF428
   214                              <1> defw    CS5ADH  equ     0xF42A
   215                              <1> defw    CS5MSKL equ     0xF42C
   216                              <1> defw    CS5MSKH equ     0xF42E
   217                              <1> defw    CS6ADL  equ     0xF430
   218                              <1> defw    CS6ADH  equ     0xF432
   219                              <1> defw    CS6MSKL equ     0xF434
   220                              <1> defw    CS6MSKH equ     0xF436
