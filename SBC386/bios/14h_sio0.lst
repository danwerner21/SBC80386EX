   424                              <1> defb    CR0_EM  equ     BIT2
   425                              <1> defb    CR0_TS  equ     BIT3
   426                              <1> defd    CR0_WP  equ     BIT16
   427                              <1> defd    CR0_PG  equ     BIT31
   428                              <1> 
