    36                                  %include "macro.inc"
    37                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    38                              <1> ;
    39                              <1> ; some useful macros:
    40                              <1> ;
    41                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    42                              <1> %define NREPEAT 0
    43                              <1> 
    44                              <1> %if NREPEAT
    45                              <1> 
    46                              <1> %macro	rep	1
    47                              <1> %%loop:	%1
    48                              <1> 	dec	cx
    49                              <1> 	jnz	%%loop
    50                              <1> %endm
    51                              <1> 
    52                              <1> %macro	repne	1
    53                              <1> %%loop:	%1
    54                              <1> 	je	%%e
    55                              <1> 	dec	cx
    56                              <1> 	jnz	%%loop
    57                              <1> 	cmp	cx,1
    58                              <1> 	jmp	%%done
    59                              <1> %%e:	dec	cx
    60                              <1> 	cmp	cx,cx
    61                              <1> %%done:
    62                              <1> %endm
    63                              <1> 
    64                              <1> %macro	repe	1
    65                              <1> %%loop:	%1
    66                              <1> 	jne	%%ne
    67                              <1> 	dec	cx
    68                              <1> 	jnz	%%loop
    69                              <1> 	jmp	%%done
    70                              <1> %%ne:	dec	cx
    71                              <1> 	jcxz	%%cxz
    72                              <1> 	jmp	%%done
    73                              <1> %%cxz:	cmp	cx,1
    74                              <1> %%done:
    75                              <1> %endm
    76                              <1> 
    77                              <1> %macro	REP	1
    78                              <1> %%loop:	%1
    79                              <1> 	dec	ecx
    80                              <1> 	jnz	%%loop
    81                              <1> %endm
    82                              <1> 
    83                              <1> %macro	REPNE	1
    84                              <1> %%loop:	%1
    85                              <1> 	je	%%e
    86                              <1> 	dec	ecx
    87                              <1> 	jnz	%%loop
    88                              <1> 	cmp	cl,1
    89                              <1> 	jmp	%%done
    90                              <1> %%e:	dec	ecx
    91                              <1> 	cmp	cl,cl
    92                              <1> %%done:
    93                              <1> %endm
    94                              <1> 
    95                              <1> %macro	REPE	1
    96                              <1> %%loop:	%1
    97                              <1> 	jne	%%ne
    98                              <1> 	dec	ecx
    99                              <1> 	jnz	%%loop
   100                              <1> 	jmp	%%done
   101                              <1> %%ne:	dec	ecx
   102                              <1> 	jecxz	%%cxz
   103                              <1> 	jmp	%%done
   104                              <1> %%cxz:	cmp	cl,1
   105                              <1> %%done:
   106                              <1> %endm
   107                              <1> 
   108                              <1> %endif
   109                              <1> 
   110                              <1> 
   111                              <1> ;
   112                              <1> ; format of the BYTE initialization table:  address, byte
   113                              <1> ;
   114                              <1> %imacro  binit 2
   115                              <1>         dw      %1
   116                              <1>         db      %2
   117                              <1> %endmacro
   118                              <1> ; end with DW -1
   119                              <1> 
   120                              <1> ;
   121                              <1> ; format of the WORD initialization table:  address, word
   122                              <1> ;
   123                              <1> %imacro  winit 2
   124                              <1>         dw      %1
   125                              <1>         dw      %2
   126                              <1> %endmacro
   127                              <1> ; end with DW -1
   128                              <1> 
   129                              <1> 
   130                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   131                              <1> %imacro get_bda	1.nolist
   132                              <1> 	push	0x0040
   133                              <1> 	pop	%1
   134                              <1> 	cnop
   135                              <1> %endm
   136                              <1> 
   137                              <1> 
   138                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   139                              <1> %imacro	get_loc0 1.nolist
   140                              <1> 	push	0x0000
   141                              <1> 	pop	%1
   142                              <1> 	cnop
   143                              <1> %endm
   144                              <1> 
   145                              <1> 
   146                              <1> 
   147                              <1> %imacro setloc  1.nolist
   148                              <1>  times   (%1-($-$$)) db 0FFh
   149                              <1> %endm
   150                              <1> 
   151                              <1> %imacro db_lo   1
   152                              <1>  db (%1)&255
   153                              <1> %endm
   154                              <1> 
   155                              <1> %imacro cnop    0.nolist
   156                              <1> %ifdef SOFT_DEBUG
   157                              <1> %if SOFT_DEBUG
   158                              <1>         nop
   159                              <1> %endif
   160                              <1> %endif
   161                              <1> %endm
   162                              <1> 
   163                              <1> %imacro popm 1-*.nolist
   164                              <1> %rep %0
   165                              <1> %ifidni %1,ALL
   166                              <1>  popa
   167                              <1> %elifidni %1,F
   168                              <1>  popf
   169                              <1> %else
   170                              <1>  pop %1
   171                              <1> %ifidni %1,DS
   172                              <1>  cnop
   173                              <1> %elifidni %1,ES
   174                              <1>  cnop
   175                              <1> %elifidni %1,FS
   176                              <1>  cnop
   177                              <1> %elifidni %1,GS
   178                              <1>  cnop
   179                              <1> %endif
   180                              <1> %endif
   181                              <1> %rotate 1
   182                              <1> %endrep
   183                              <1> %endm
   184                              <1> 
   185                              <1> %imacro pushm 1-*.nolist
   186                              <1> %rep %0
   187                              <1> %rotate -1
   188                              <1> %ifidni %1,ALL
   189                              <1>  pusha
   190                              <1> %elifidni %1,F
   191                              <1>  pushf
   192                              <1> %else
   193                              <1>  push %1
   194                              <1> %endif
   195                              <1> %endrep
   196                              <1> %endm
   197                              <1> 
   198                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   199                              <1> %assign __size__ (%2-1)	| 0xFF
   200                              <1> %if (__size__ <= 0xFFFF)
   201                              <1> %assign __gran__ 0
   202                              <1> %else
   203                              <1> %assign __gran__ 0xC0			; G B 0 0
   204                              <1> %endif
   205                              <1> %assign __expand__ 0
   206                              <1> %if %0==3
   207                              <1> %if %3
   208                              <1> %assign __expand__ 4
   209                              <1> %endif
   210                              <1> %endif
   211                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   212                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   213                              <1> %endm
   214                              <1> 
   215                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   216                              <1> %assign __size__ (%2-1)	| 0xFF
   217                              <1> %if (__size__ <= 0xFFFF)
   218                              <1> %assign __gran__ 0
   219                              <1> %else
   220                              <1> %assign __gran__ 0xC0			; G D 0 0
   221                              <1> %endif
   222                              <1> %assign __conform__ 0
   223                              <1> %if %0==3
   224                              <1> %if %3
   225                              <1> %assign __conform__ 4
   226                              <1> %endif
   227                              <1> %endif
   228                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   229                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   230                              <1> %endm
   231                              <1> 
   232                              <1> ;/* End of macro.inc */
    37                                  %include "stack.inc"
    38                              <1> XXX
    39                              <1> ; stack.h -- format of the stack formed by				*/
    40                              <1> ; */
    41                              <1> ;	PUSHM	ALL,DS,ES							*/
    42                              <1> ;	MOV	BP,SP									*/
    43                              <1> ; */
    44                              <1> ; */
    45                              <1> ; */
    46                              <1> struc _STD_STACK
    47 00000000 ????                <1> offset_di	resw	1		; PUSHA (all) save*//
    48 00000002 ????                <1> offset_si	resw	1
    49 00000004 ????                <1> offset_bp	resw	1
    50 00000006 ????                <1> offset_sp	resw	1
    51 00000008 ????                <1> offset_bx	resw	1
    52 0000000A ????                <1> offset_dx	resw	1
    53 0000000C ????                <1> offset_cx	resw	1
    54 0000000E ????                <1> offset_ax	resw	1
    55                              <1> ; */
    56 00000010 ????                <1> offset_ds	resw	1		; segment register aave */
    57 00000012 ????                <1> offset_es	resw	1
    58                              <1> ; */
    59 00000014 ????                <1> offset_ip	resw	1
    60 00000016 ????                <1> offset_cs	resw	1		; set for IRET */
    61 00000018 ????                <1> offset_flags	resw	1	; flag.0 is the Crrry */
    62                              <1> endstruc
    62          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    63                              <1> ; */
    38                                  %include "serial.inc"
    39                              <1> ; serial.inc
    40                              <1> ;
    41                              <1> ; the protocol flag bits
    42                              <1> ;
    43                              <1> CLK_737		equ	0010_0000b
    44                              <1> XON_XOFF	equ	0100_0000b
    45                              <1> RTS_CTS		equ	1000_0000b
    39                                  
    40                                  %define USE_CTS 0
    41                                  
    42                                  	global	int_14h
    43                                  segment _TEXT
    44                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    45                                  ; int_14h	-- called with INT 0x14 with function code in AH
    46                                  ;
    47                                  ;    Enter with:
    48                                  ;	AH	function code 0, 1, 2, 3
    49                                  ;	DX	port number 0=COM1, .. 3=COM4
    50                                  ;
    51                                  ;
    52                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    53                                  
    54                                  int_14h:
    55 00000000 FB                      	sti			; re-enable interrupts
    56 00000001 1E60                    	pushm	ALL,DS ;ES	; AX is usually a return value
    57 00000003 89E5                    	mov	bp,sp		; establish stack addressing
    58 00000005 6A401F                  	get_bda	DS		;get DS = segment pointer to BDA
    59                                  %if 0
    60                                  	mov	cx,[equip_flag]	; equipment flag in BDA
    61                                  	shr	cx,9		;number of RS-232 ports
    62                                  	and	cx,7		; **
    63                                  	mov	bx,dx		; COM1==0, COM2==1, ...
    64                                  	cmp	bx,cx		; 4 COM ports at most
    65                                  	jae	bad_error
    66                                  %else
    67 00000008 83FA04                  	cmp	dx,4		; 4 is the max
    68 0000000B 7325                    	jae	bad_error
    69 0000000D 89D3                    	mov	bx,dx		;index to BX
    70                                  %endif
    71                                  
    72                                  ; the index in BX is below the number in CX
    73 0000000F 01DB                    	add	bx,bx
    74 00000011 8B1F                    	mov	bx,[serial_dev + bx]
    75 00000013 09DB                    	or	bx,bx
    76 00000015 741B                    	jz	bad_error
    77 00000017 8D5705                  	lea	dx,[LSR0-TBR0 + bx]	; LSR address to DX
    78                                  ;
    79                                  ; we have the I/O base device code in BX
    80                                  ;
    81 0000001A 08E4                    	or	ah,ah
    82 0000001C 7478                    	jz	init_sio	; function 0
    83 0000001E FECC                    	dec	ah
    84 00000020 745C                    	jz	write		; function 1
    85 00000022 FECC                    	dec	ah
    86 00000024 743A                    	jz	read		; function 2
    87 00000026 FECC                    	dec	ah
    88 00000028 0F849B00                	jz	status		; function 3
    89 0000002C FECC                    	dec	ah
    90 0000002E 0F849B00                	jz	ext_init_sio	; function 4  PS/2
    91                                  
    92                                  ;
    93                                  ; the other PS/2 functions are not implemented
    94                                  ;
    95                                  bad_error:
    96 00000032 B80F8E                  	mov	ax,0x8E0F	; AH.7 = timeout
    97                                  return_AX:
    98 00000035 89460E                  	mov	[bp+offset_ax],ax
    99 00000038 611F                    	popm	ALL,DS ;ES	; restore the registers
   100 0000003A CF                      	iret
   101                                  
   102                                  
   103                                  
   104                                  SHIFT	equ	2		; set to 2 for 7.3728 mhz on 4UART
   105                                  OSC	equ	1843200<<SHIFT
   106                                  CLK	equ	OSC/16
   107                                  
   108                                  	global	_sio_divisors
   109                                  _sio_divisors:
   110                                  sio_divisors:
   111 0000003B 5D10                    	dw	CLK/110		;0
   112 0000003D 000C                    	dw	CLK/150
   113 0000003F 0006                    	dw	CLK/300
   114 00000041 0003                    	dw	CLK/600
   115 00000043 8001                    	dw	CLK/1200	;5
   116 00000045 C000                    	dw	CLK/2400
   117 00000047 6000                    	dw	CLK/4800
   118 00000049 3000                    	dw	CLK/9600	;7
   119                                  ; for the extended initialization call (PS/2)
   120 0000004B 1800                    	dw	CLK/19200	;8
   121 0000004D 0C00                    	dw	CLK/38400
   122 0000004F 0800                    	dw	CLK/56000	; actually 57600
   123 00000051 0400                    	dw	CLK/115200	;11
   124                                  %if SHIFT
   125 00000053 0200                    	dw	CLK/230400	;12
   126 00000055 0100                    	dw	CLK/460800	;13
   127                                  %endif
   128                                  
   129                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   130                                  ; get_status
   131                                  ;
   132                                  ;    Enter with:
   133                                  ;	BX	port base I/O address
   134                                  ;	DX	LSR I/O address
   135                                  ;
   136                                  ;    Exit with:
   137                                  ;	AH	line status
   138                                  ;	AL	modem status
   139                                  ;
   140                                  ;	BX	port I/O base address
   141                                  ;
   142                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   143                                  get_status:
   144 00000057 EC                      	in	al,dx		; get line status
   145 00000058 247F                    	and	al,7Fh		; clear undefined bit
   146 0000005A 88C4                    	mov	ah,al		; will return in AH
   147 0000005C 42                      	inc	dx		; MSR0 in DX
   148 0000005D EC                      	in	al,dx		; line status to AL
   149 0000005E 4A                      	dec	dx
   150 0000005F C3                      	ret
   151                                  
   152                                  
   153                                  
   154                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   155                                  ; read
   156                                  ;
   157                                  ;    Enter with:
   158                                  ;	BX	base port address
   159                                  ;	DX	LSR port address
   160                                  ;
   161                                  ;    Exit with:
   162                                  ;	AH	port (line) status
   163                                  ;	AL	character read
   164                                  ;	BX,DX	unchanged
   165                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   166                                  
   167                                  read:
   168 00000060 E8F4FF                  	call	get_status
   169 00000063 F6C401                  	test	ah,LSR_RBF	;anything in the buffer
   170 00000066 74F8                    	jz	read
   171                                  
   172 00000068 87DA                    	xchg	bx,dx		;RBR to DX
   173 0000006A EC                      	in	al,dx		;get the character
   174 0000006B 87DA                    	xchg	bx,dx		;LSR to DX
   175 0000006D 88C1                    	mov	cl,al		; save char read in
   176 0000006F E8E5FF                  	call	get_status
   177 00000072 80E41E                  	and	ah,BIT4+BIT3+BIT2+BIT1	; mask pertinent bits
   178 00000075 7403                    	jz	.3
   179 00000077 80CC80                  	or	ah,BIT7		;signal error
   180                                  .3:
   181 0000007A 88C8                    	mov	al,cl		;return char in AL, LSR in AH
   182 0000007C EBB7                    	jmp	return_AX
   183                                  
   184                                  
   185                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   186                                  ; write
   187                                  ;
   188                                  ;    Enter with:
   189                                  ;	AL	character to write
   190                                  ;	BX	base port address
   191                                  ;	DX	LSR port address
   192                                  ;
   193                                  ;    Exit with:
   194                                  ;	AH	port (line) status
   195                                  ;	AL	unchanged char
   196                                  ;	BX,DX	unchanged
   197                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   198                                  
   199                                  write:
   200 0000007E 88C1                    	mov	cl,al		;save output character
   201                                  .1:
   202 00000080 E8D4FF                  	call	get_status	;line status to AH
   203                                  %if USE_CTS
   204                                  	; modem status is in AL
   205                                  	test	al,MSR_CTS		; test CTS_bit
   206                                  	jz	.1
   207                                  %endif
   208 00000083 F6C420                  	test	ah,LSR_TBE	;buffer empty?
   209 00000086 74F8                    	jz	.1
   210 00000088 87DA                    	xchg	bx,dx		;DX = base (TBR)
   211 0000008A 88C8                    	mov	al,cl		; AL = character
   212 0000008C EE                      	out	dx,al		; put it out
   213 0000008D 87DA                    	xchg	bx,dx		;DX = LSR again
   214 0000008F E8C5FF                  	call	get_status
   215 00000092 88C8                    	mov	al,cl		;restore char in AL
   216 00000094 EB9F                    	jmp	return_AX
   217                                  
   218                                  
   219                                  
   220                                  
   221                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   222                                  ; init_sio
   223                                  ;
   224                                  ;    Enter with:
   225                                  ;	AL	initialization parameters
   226                                  ;			bits 7 6 5	data rate
   227                                  ;			bits 4 3	parity x0=none, 01=odd, 11=even
   228                                  ;			bit  2		stop bits 0->1, 1->2 stop bits
   229                                  ;			bits 1 0	word length 10->7 11->8 bits
   230                                  ;	BX	base port address
   231                                  ;	DX	LSR port address
   232                                  ;
   233                                  ;    Exit with:
   234                                  ;	AH	port (line) status
   235                                  ;	AL	modem status
   236                                  ;	BX,DX	unchanged
   237                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   238                                  
   239                                  init_sio:
   240 00000096 89C6                    	mov	si,ax		; index to SI
   241 00000098 81E6E000                	and	si,0x00E0	; mask to 3 bits
   242 0000009C C1EE04                  	shr	si,4		; form WORD index
   243 0000009F 83E01F                  	and	ax,00011111b	;mask for status bits
   244 000000A2 B102                    	mov	cl,SHIFT	;
   245                                  ; AL is LCR to-be
   246                                  ; SI is baud rate index
   247                                  ; CL is baud rate shift for 1.84mhz clock (2), 7.37mhz clk (0)
   248                                  do_init:
   249 000000A4 88C4                    	mov	ah,al		; save LCR value in AH
   250 000000A6 4A                      	dec	dx
   251 000000A7 0C80                    	or	al,80h		; set DLAB
   252 000000A9 4A                      	dec	dx		; DX = LCR address
   253 000000AA EE                      	out	dx,al		; set DLAB & LCR
   254 000000AB 52                      	push	DX
   255 000000AC 89DA                    	mov	dx,bx		; DX is DLL address
   256 000000AE 2E8BBC[3B00]               cs	mov	di,[sio_divisors + si]
   257 000000B3 D3EF                       	shr	di,cl
   258 000000B5 89F9                    	mov	cx,di
   259 000000B7 88C8                    	mov	al,cl
   260 000000B9 EE                         	out	dx,al		; set low byte
   261 000000BA 42                      	inc	dx   		; address DLH
   262 000000BB 88E8                    	mov	al,ch
   263 000000BD EE                      	out	dx,al		; set high byte
   264 000000BE 5A                      	pop	DX		; get LCR
   265 000000BF 88E0                    	mov	al,ah		; set to clear DLAB
   266 000000C1 EE                      	out	dx,al		; clear DLAB, set LCR bits
   267 000000C2 42                      	inc	dx		; DX = MCR
   268 000000C3 B003                    	mov	al,0x03		; set RTS & DTR
   269 000000C5 EE                      	out	dx,al		; **
   270 000000C6 42                      	inc	dx		; DX = LSR
   271                                  ; just fall into the Status return
   272                                  ;;	call	get_status
   273                                  ;;	jmp	return_AX
   274                                  
   275                                  
   276                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   277                                  ; status
   278                                  ;
   279                                  ;    Enter with:
   280                                  ;	BX	base port address
   281                                  ;	DX	LSR port address
   282                                  ;
   283                                  ;    Exit with:
   284                                  ;	AH	port (line) status
   285                                  ;	AL	modem status
   286                                  ;	BX,DX	unchanged
   287                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   288                                  
   289                                  status:
   290 000000C7 E88DFF                  	call	get_status
   291 000000CA E968FF                  	jmp	return_AX
   292                                  
   293                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   294                                  ; ext_init_sio		PS/2 extended init
   295                                  ;
   296                                  ;    Enter in the stack:
   297                                  ;	AL	break flag 0 or 1
   298                                  ;
   299                                  ;    SBC-386EX extension:
   300                                  ;	AL.765 are protocol bits
   301                                  ;
   302                                  ;	BH	parity
   303                                  ;			0 none
   304                                  ;			1 odd
   305                                  ;			2 even
   306                                  ;			3 stick parity odd
   307                                  ;			4 stick parity even
   308                                  ;	BL	stop bits
   309                                  ;			0 one stop bit
   310                                  ;			1 two stop bits (1.5 if CH==0)
   311                                  ;	CH	word length
   312                                  ;			0  5-bits
   313                                  ;			1  6-bits
   314                                  ;			2  7-bits
   315                                  ;			3  8-bits
   316                                  ;	CL	bit rate
   317                                  ;			0..8  (see table, 110 to 19200
   318                                  ;		386EX extension:
   319                                  ;			9..11 (38400,57600,115200)
   320                                  ;	DX	port number
   321                                  ;
   322                                  ;    Exit with:
   323                                  ;	AH	port (line) status
   324                                  ;	AL	modem status
   325                                  ;	BX,CX,DX	unchanged
   326                                  ;
   327                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   328                                  ext_init_sio:
   329 000000CD 8B4E0C                  	mov	cx,[bp + offset_cx]
   330                                  ; CL is the baud rate index
   331 000000D0 89CE                    	mov	si,cx		; index to SI
   332 000000D2 83E60F                  	and	si,0x000F
   333 000000D5 01F6                    	add	si,si		; SI is WORD index
   334                                  
   335 000000D7 88C4                    	mov	ah,al		; save protocol bits in AH
   336                                  
   337 000000D9 2401                    	and	al,1		; mask to 1 bit
   338 000000DB C0E006                  	shl	al,6		; break bit to bit 6
   339 000000DE 80E503                  	and	ch,3		; mask word length
   340 000000E1 08E8                    	or	al,ch		; break|nbits
   341                                  ; BX is the parity & stop bits
   342 000000E3 8B4E08                  	mov	cx,[bp + offset_bx]
   343 000000E6 80E101                  	and	cl,1		; mask stop bits
   344 000000E9 C0E102                  	shl	cl,2
   345 000000EC 08C8                    	or	al,cl		; break|stop|nbits
   346 000000EE 88E9                    	mov	cl,ch
   347 000000F0 83E107                  	and	cx,7
   348 000000F3 89CF                    	mov	di,cx
   349 000000F5 2E0A85[0501]               cs	or	al,[par_tab + di] ; break|parity|stop|nbits
   350 000000FA B102                    	mov	cl,2
   351 000000FC F6C420                  	test	ah,CLK_737	; test 7.37 clock flag
   352 000000FF 74A3                    	jz	do_init
   353 00000101 30C9                    	xor	cl,cl
   354 00000103 EB9F                    	jmp	do_init
   355                                  ; SI is word index to bit rate
   356                                  ; AL is LCR value
   357                                  ; CL is shift (2)
   358                                  ; BX is base port
   359                                  ; DX is LSR (will be decremented to LCR)
   360                                  
   361                                  
   362                                  par_tab:
   363 00000105 00                      	db	0	;none
   364 00000106 08                      	db	1<<3	;odd
   365 00000107 18                      	db	3<<3	;even
   366 00000108 28                      	db	5<<3	;stick one
   367 00000109 38                      	db	7<<3	;stick zero
   368 0000010A 00                      	db	0
   369 0000010B 00                      	db	0
   370 0000010C 00                      	db	0
   371                                  
   372                                  
   373                                  
   374                                  
   375                                  
   376                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   377                                  ; install_SIO0_		install the system board SIO0 (internal) 386EX port
   378                                  ;
   379                                  ;    Enter with:
   380                                  ;	AX	device code to install
   381                                  ;	direction flag clear
   382                                  ;
   383                                  ;    Exit with:
   384                                  ;	AX	0 if successful
   385                                  ;		non-Zero if error
   386                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   387                                  
   388                                  	global	install_SIO0_
   389                                  segment _TEXT			; this routine is C-callable
   390                                  
   391                                  install_SIO0_:
   392 0000010D 1E565152                	pushm	DX,CX,SI,DS
   393 00000111 89C2                    	mov	dx,ax		; use device code in DX
   394 00000113 6A401F                  	get_bda	DS		; get BIOS Data Area segment pointer
   395 00000116 8D360000                	lea	SI,[serial_dev]
   396 0000011A B90400                  	mov	cx,4
   397                                  .1:
   398 0000011D AD                      	lodsw			; get a device code
   399 0000011E 39D0                       	cmp	ax,dx		; is it already there
   400 00000120 7412                    	je	.8
   401 00000122 09C0                    	or	ax,ax		; is the slot empty
   402 00000124 7404                    	jz	.3		; empty if 0, install here
   403 00000126 E2F5                    	loop	.1
   404 00000128 EB0A                    	jmp	.8		; no empty slot
   405                                  
   406                                  ; empty slot found SI is already incremented
   407 0000012A 8954FE                  .3:	mov	[si-2],dx	;set device code
   408 0000012D 8006110002              	add	byte [equip_flag+1], 1<<(9-8)	; increment at bit 9
   409 00000132 EB03                    	jmp	.9		; AX is already zero
   410                                  
   411 00000134 B88E00                  .8:	mov	ax,0x8E		;
   412 00000137 5A595E1F                .9:	popm	DX,CX,SI,DS
   413 0000013B C3                      	ret
