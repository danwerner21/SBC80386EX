   411                              <1> defb	MSR_DCD	equ	BIT7
   412                              <1> defb	MSR_RI 	equ	BIT6
   413                              <1> defb	MSR_DSR	equ	BIT5
   414                              <1> defb	MSR_CTS	equ	BIT4
   415                              <1> defb	MSR_deltaDCD	equ	BIT3
   416                              <1> defb	MSR_deltaRI	equ	BIT2
   417                              <1> defb	MSR_deltaDSR	equ	BIT1
   418                              <1> defb	MSR_deltaCTS	equ	BIT0
   419                              <1> 
