   136 00000096 ??                  <1> kbd_flag3	resb	1	; mode state & type flags */
   137 00000097 ??                  <1> kbd_flag2	resb	1	; kbd LED flags */
   138                              <1> ; */
   139                              <1> ; Real Time Clock data area */
   140 00000098 ????????            <1> rtc_user_flag_addr	resd	1	; far address of user's wait flag */
   141 0000009C ????????            <1> rtc_user_wait_flag	resd	1	; user wait flag */
   142 000000A0 ??                  <1> rtc_wait_active	resb	1	; 01=busy, 80=posted, 00=post acknowledge */
   143                              <1> ; */
