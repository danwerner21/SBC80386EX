    60 0000003E ??                  <1> seek_status	resb	1	; drive recalibration status */
    61                              <1> ; bits 3..0 drive must recalibrate before next seek */
    62 0000003F ??                  <1> motor_status	resb	1	; bits 3..0 motor running */
    63                              <1> ; bit 7 current op is write */
    64 00000040 ??                  <1> motor_count	resb	1	; timeout counter for motor turn-off */
    65 00000041 ??                  <1> fd_status	resb	1	; return code status byte */
    66 00000042 ??????????????      <1> fd_ctrl_stat	resb	7	; controller return bytes */
    67                              <1> ; */
    68                              <1> ; Video Display data area -- also used for video emulation */
    69 00000049 ??                  <1> vid_mode	resb	1	; current display mode */
    70 0000004A ????                <1> vid_columns	resw	1	; no. of columns on the screen */
    71 0000004C ????                <1> vid_buf_len	resw	1	; length of video buffer in bytes*//
    72 0000004E ????                <1> vid_start	resw	1	; start address of screen regeneration (in vid buf)*//
    73 00000050 <res 10h>           <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
    74 00000060 ????                <1> vid_cursor_mode	resw	1
    75 00000062 ??                  <1> vid_active_page	resb	1
    76 00000063 ????                <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA)*//
    77 00000065 ??                  <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
    78 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
    79                              <1> ; */
