   122 00000088 ??                  <1> ega_info_3	resb	1		; switch settings*//
   123 00000089 ????                <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   124                              <1> ; */
   125                              <1> ; Disk / Diskette media data */
   126 0000008B ??                  <1> fd_last_data_rate	resb	1	; last data rate selected */
   127 0000008C ??                  <1> hd_status_reg	resb	1		; hard disk status register */
   128 0000008D ??                  <1> hd_error_reg	resb	1		; hard disk error register */
   129 0000008E ??                  <1> hd_int_flag	resb	1	; HD interrupt flag */
