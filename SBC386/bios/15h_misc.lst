   152 000000DB ????                <1> extended_memory	resw	1	; size of Extended Memory in Kilobytes */
   153                              <1> ; this size is stored in CMOS on the PC/AT */
   154 000000DD ????                <1> CPU_freq	resw	1	; CPU frequency in kilohertz */
   155 000000DF ????                <1> ebda_seg_ptr	resw	1		; for EBDA allocations; c.f., memory_size */
   156                              <1> ; */
