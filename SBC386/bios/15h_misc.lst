   131 00000090 ????                <1> hd_media	resb	2	; media state */
   132 00000092 ????                <1> hd_op_start	resb	2	; operation start state */
   133 00000094 ????                <1> hd_track	resw	1		; HD present cylinder number */
   134                              <1> ; */
