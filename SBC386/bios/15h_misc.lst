    81 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
    82                              <1> %define io_rom_addr_low io_rom_addr
    83                              <1> %define io_rom_addr_seg (io_rom_addr+2)
    84 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
    85                              <1> ; */
    86                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
    87 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
    88 0000006E ????                <1> timer_count_high	resw	1
    89                              <1> %define timer_count timer_count_low
    90                              <1> ; use timer_count as the double word timer counter */
    91 00000070 ??                  <1> timer_overflow	resb	1	; timer has rolled over since last read */
    92                              <1> ; */
    93                              <1> ; System & Keboard data area */
    94 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
    95 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
    96                              <1> ; */
    97                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
    98                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
    99                              <1> ; program can set it and jump to FFFF:0000 -- that is the PC convention  */
   100                              <1> ; and this BIOS honours it.                                             */
   101                              <1> %define WARM_BOOT 0x1234
