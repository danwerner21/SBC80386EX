   409                              <1> defb    LSR_PE  equ     BIT2
   410                              <1> defb    LSR_OE  equ     BIT1
   411                              <1> defb    LSR_RBF equ     BIT0
   412                              <1> 
   413                              <1> ;/* MSRx bits
   414                              <1> ;*/
   415                              <1> defb	MSR_DCD	equ	BIT7
   416                              <1> defb	MSR_RI 	equ	BIT6
   417                              <1> defb	MSR_DSR	equ	BIT5
   418                              <1> defb	MSR_CTS	equ	BIT4
   419                              <1> defb	MSR_deltaDCD	equ	BIT3
   420                              <1> defb	MSR_deltaRI	equ	BIT2
   421                              <1> defb	MSR_deltaDSR	equ	BIT1
   422                              <1> defb	MSR_deltaCTS	equ	BIT0
   423                              <1> 
   424                              <1> ;/* Bits in CR0
   425                              <1> ;*/
   426                              <1> defb    CR0_PE  equ     BIT0
   427                              <1> defb    CR0_MP  equ     BIT1
   428                              <1> defb    CR0_EM  equ     BIT2
   429                              <1> defb    CR0_TS  equ     BIT3
   430                              <1> defd    CR0_WP  equ     BIT16
   431                              <1> defd    CR0_PG  equ     BIT31
   432                              <1> 
   433                              <1> ;/* Some ASCII character codes
   434                              <1> ;*/
   435                              <1> defb    ASCII_NUL       equ     0x00
   436                              <1> defb    ASCII_BS        equ     0x08
   437                              <1> defb    ASCII_HT        equ     0x09
   438                              <1> defb    ASCII_LF        equ     0x0A
   439                              <1> defb    ASCII_NL        equ     0x0A
   440                              <1> defb    ASCII_FF        equ     0x0C
   441                              <1> defb    ASCII_CR        equ     0x0D
   442                              <1> defb	ASCII_ESC	equ	0x1B
   443                              <1> defb    ASCII_SP        equ     0x20
   444                              <1> defb    ASCII_DEL       equ     0x7F
   445                              <1> defb	ASCII_RUB	equ	0xFF
   446                              <1> 
