    43                                  %define XXX
    44                                  %include "bda.inc"
    45                              <1> XXX
    46                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
    47                              <1> %define BDA_segment 0x40
    48                              <1> ; bda.console -- which consoles INT 10h drives.  Set before the first */
    49                              <1> ; printf of POST; vga3_init adds the video bit when the board answers. */
    50                              <1> ; Both at once mirrors the screen down the serial line.  One comment  */
    51                              <1> ; per line here: bda.rul turns this file into bda.inc a line at a time. */
    52                              <1> %define CON_SERIAL	0x01
    53                              <1> %define CON_VIDEO	0x02
    54                              <1> struc _BDA
    55                              <1> ; first items at 0x40:0	*/
    56 00000000 ????????????????    <1> serial_dev	resw	4	; serial port device codes */
    57 00000008 ????????????????    <1> parallel_dev	resw	4	; printer port device codes */
    58 00000010 ????                <1> equip_flag	resw	1		; int 12h equipment flags */
    59 00000012 ??                  <1> mfg_test	resb	1		; initialization flags */
    60                              <1> ; */
    61                              <1> ; POST writes what it decided here, after the test of segment 0 has */
    62                              <1> ; zeroed the area, so the answer survives to be reported.  Nothing else */
    63                              <1> ; in this BIOS writes mfg_test.                                        */
    64                              <1> %define WARM_POST 0x01	; warm start: the memory march was skipped */
    65 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    66 00000015 ??                  <1> mfg_err_flag	resb	1
    67 00000016 ??                  <1> mfg_err_flag2	resb	1
    68                              <1> ; */
    69                              <1> ; first Keyboard data area */
    70 00000017 ??                  <1> kbd_flag	resb	1	; shift status &c. */
    71 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
    72 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
    73 0000001A ????                <1> buffer_head	resw	1
    74 0000001C ????                <1> buffer_tail	resw	1
    75                              <1> ; */
    76 0000001E <res 20h>           <1> kbd_buffer	resw	16	; buffer empty when  head==tail**/
    77                              <1> ; */
    78                              <1> ; Diskette data area */
    79 0000003E ??                  <1> seek_status	resb	1	; drive recalibration status */
    80                              <1> ; bits 3..0 drive must recalibrate before next seek */
    81 0000003F ??                  <1> motor_status	resb	1	; bits 3..0 motor running */
    82                              <1> ; bit 7 current op is write */
    83 00000040 ??                  <1> motor_count	resb	1	; timeout counter for motor turn-off */
    84 00000041 ??                  <1> fd_status	resb	1	; return code status byte */
    85 00000042 ??????????????      <1> fd_ctrl_stat	resb	7	; controller return bytes */
    86                              <1> ; */
    87                              <1> ; Video Display data area -- also used for video emulation */
    88 00000049 ??                  <1> vid_mode	resb	1	; current display mode */
    89 0000004A ????                <1> vid_columns	resw	1	; no. of columns on the screen */
    90 0000004C ????                <1> vid_buf_len	resw	1	; length of video buffer in bytes*//
    91 0000004E ????                <1> vid_start	resw	1	; start address of screen regeneration (in vid buf)*//
    92 00000050 <res 10h>           <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
    93 00000060 ????                <1> vid_cursor_mode	resw	1
    94 00000062 ??                  <1> vid_active_page	resb	1
    95 00000063 ????                <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA)*//
    96 00000065 ??                  <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
    97 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
    98                              <1> ; */
    99                              <1> ; POST and ROM data */
   100 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   101                              <1> %define io_rom_addr_low io_rom_addr
   102                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   103 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   104                              <1> ; */
   105                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   106 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
   107 0000006E ????                <1> timer_count_high	resw	1
   108                              <1> %define timer_count timer_count_low
   109                              <1> ; use timer_count as the double word timer counter */
