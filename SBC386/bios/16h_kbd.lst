    52 00000000 ????                <1> offset_di	resw	1		; PUSHA (all) save*//
    53 00000002 ????                <1> offset_si	resw	1
    54 00000004 ????                <1> offset_bp	resw	1
    55 00000006 ????                <1> offset_sp	resw	1
    56 00000008 ????                <1> offset_bx	resw	1
    57 0000000A ????                <1> offset_dx	resw	1
    58 0000000C ????                <1> offset_cx	resw	1
    59 0000000E ????                <1> offset_ax	resw	1
    60                              <1> ; */
    61 00000010 ????                <1> offset_ds	resw	1		; segment register aave */
    62 00000012 ????                <1> offset_es	resw	1
    63                              <1> ; */
    64 00000014 ????                <1> offset_ip	resw	1
    65 00000016 ????                <1> offset_cs	resw	1		; set for IRET */
    66 00000018 ????                <1> offset_flags	resw	1	; flag.0 is the Crrry */
    67                              <1> endstruc
