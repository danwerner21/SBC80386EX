   408                              <1> defb    LSR_PE  equ     BIT2
   409                              <1> defb    LSR_OE  equ     BIT1
   410                              <1> defb    LSR_RBF equ     BIT0
   411                              <1> 
   412                              <1> ;/* MSRx bits
   413                              <1> ;*/
