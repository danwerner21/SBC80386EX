    42                                  %undef XXX
    43                                  
    44                                  	global	int_16h
    45                                  	global	int_irq4
    46                                  	global	kbd_init_
    47                                  
    48                                  segment	_TEXT
    49                                  ASCII_BEL	equ 	0X08
    50                                  
    51                                  NS_EOI		equ	0x20		; non-specific end of interrupt
    52                                  KBD_START	equ	0x1E		; kbd_buffer, at 40:1E as on a PC
    53                                  KBD_END		equ	0x3E		; one past its last word
    54                                  
    55                                  
    56                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    57                                  ; kbd_init -- set the ring buffer up and turn the receive interrupt on
    58                                  ;
    59                                  ;	void kbd_init(void);
    60                                  ;
    61                                  ; Called from POST.  Until this runs the buffer pointers are zero, which
    62                                  ; would make the buffer look like a 16-word ring based at 40:0000 -- on
    63                                  ; top of the serial device table.
    64                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    65                                  kbd_init_:
    66 00000000 1E5250                  	pushm	ax,dx,ds
    67                                  
    68 00000003 6A401F                  	get_bda	DS
    69 00000006 C70680001E00            	mov	word [buffer_start],KBD_START
    70 0000000C C70682003E00            	mov	word [buffer_end],KBD_END
    71 00000012 C7061A001E00            	mov	word [buffer_head],KBD_START
    72 00000018 C7061C001E00            	mov	word [buffer_tail],KBD_START
    73 0000001E C606170000              	mov	byte [kbd_flag],0
    74 00000023 C606180000              	mov	byte [kbd_flag1],0
    75                                  
    76 00000028 BAF903                  	mov	dx,IER0			; receive data available
    77 0000002B B001                    	mov	al,0x01
    78 0000002D EE                      	out	dx,al
    79                                  
    80 0000002E 585A1F                  	popm	ax,dx,ds
    81                                  
    82 00000031 B80400                  	mov	ax,4			; IRQ4 -- SIO0 receive
    83                                  	extern	unmask_interrupt_
    84 00000034 E8(0000)                	call	unmask_interrupt_
    85 00000037 C3                      	ret
    86                                  
    87                                  
    88                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    89                                  ; int_irq4 -- the SIO0 receive interrupt
    90                                  ;
    91                                  ; Drains the UART into the ring buffer.  The loop matters: at 9600 baud
    92                                  ; with interrupts occasionally masked elsewhere, more than one character
    93                                  ; can be waiting by the time this runs, and leaving one behind would
    94                                  ; leave the interrupt asserted with nothing to clear it.
    95                                  ;
    96                                  ; A full buffer drops the character and beeps, which is what a PC does.
    97                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    98                                  int_irq4:
    99 00000038 1E575652515350          	pushm	ax,bx,cx,dx,si,di,ds
   100                                  
   101 0000003F 6A401F                  	get_bda	DS
   102 00000042 FC                      	cld
   103                                  .1:
   104 00000043 BAFD03                  	mov	dx,LSR0
   105 00000046 EC                      	in	al,dx
   106 00000047 A801                    	test	al,0x01			; anything in the receiver?
   107 00000049 740B                    	jz	.9
   108                                  
   109 0000004B BAF803                  	mov	dx,RBR0
   110 0000004E EC                      	in	al,dx
   111 0000004F 247F                    	and	al,0x7F			; the console is 7-bit clean
   112                                  
   113 00000051 E80E00                  	call	kbd_stuff
   114 00000054 EBED                    	jmp	.1
   115                                  .9:
   116 00000056 B020                    	mov	al,NS_EOI
   117 00000058 E620                    	out	OCW2M_AT,al
   118                                  
   119 0000005A 585B595A5E5F1F          	popm	ax,bx,cx,dx,si,di,ds
   120 00000061 CF                      	iret
   121                                  
   122                                  
   123                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   124                                  ; kbd_stuff -- put the character in AL into the ring buffer
   125                                  ;
   126                                  ;  DS is the BDA.  AX, BX, CX are destroyed.
   127                                  ;
   128                                  ; The stored word is the PC convention: scan code in the high byte,
   129                                  ; ASCII in the low.  DOS reads the ASCII; a few programs check the scan
   130                                  ; code, which is why it is synthesised rather than left zero.
   131                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   132                                  kbd_stuff:
   133 00000062 52515350                	pushm	ax,bx,cx,dx
   134                                  
   135                                  ; DEL from a terminal means backspace to DOS
   136 00000066 3C7F                    	cmp	al,0x7F
   137 00000068 7502                    	jne	.1
   138 0000006A B008                    	mov	al,ASCII_BS
   139                                  .1:
   140 0000006C 0FB6D8                  	movzx	bx,al
   141 0000006F 2E8AA7[1001]               cs	mov	ah,[bx+kbd_scan]	; synthesise the scan code
   142 00000074 89C1                    	mov	cx,ax			; CX is the word to store
   143                                  
   144 00000076 8B1E1C00                	mov	bx,[buffer_tail]
   145 0000007A 89D8                    	mov	ax,bx
   146 0000007C 83C002                  	add	ax,2
   147 0000007F 83F83E                  	cmp	ax,KBD_END
   148 00000082 7203                    	jb	.2
   149 00000084 B81E00                  	mov	ax,KBD_START		; wrapped
   150                                  .2:
   151 00000087 3B061A00                	cmp	ax,[buffer_head]
   152 0000008B 7407                    	je	.full			; tail would meet head: no room
   153                                  
   154 0000008D 890F                    	mov	[bx],cx			; DS is 0040, BX is the offset
   155 0000008F A31C00                  	mov	[buffer_tail],ax
   156 00000092 EB08                    	jmp	.9
   157                                  .full:
   158 00000094 B008                    	mov	al,ASCII_BEL		; the buffer is full -- complain
   159 00000096 B401                    	mov	ah,1
   160 00000098 31D2                    	xor	dx,dx
   161 0000009A CD14                    	int	0x14
   162                                  .9:
   163 0000009C 585B595A                	popm	ax,bx,cx,dx
   164 000000A0 C3                      	ret
   165                                  
   166                                  
   167                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   168                                  ; INT 16h -- keyboard services
   169                                  ;
   170                                  ;    Function		Usage
   171                                  ;    ========		=====
   172                                  ;	00	read a key, waiting for one
   173                                  ;	01	report whether a key is waiting, without taking it
   174                                  ;	02	read the shift flags
   175                                  ;	10h	as 00, extended
   176                                  ;	11h	as 01, extended
   177                                  ;	12h	as 02, extended
   178                                  ;
   179                                  ; 10h/11h/12h are the 101-key forms.  On a serial console they have
   180                                  ; nothing extra to report, so they share the code.
   181                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   182                                  int_16h:
   183 000000A1 FB                      	sti
   184 000000A2 061E60                  	pushm	all,ds,es
   185 000000A5 89E5                    	mov	bp,sp
   186 000000A7 FC                      	cld
   187 000000A8 6A401F                  	get_bda	DS
   188                                  
   189 000000AB 88E0                    	mov	al,ah
   190 000000AD 240F                    	and	al,0x0F			; 10h/11h/12h behave as 00/01/02
   191 000000AF 3C02                    	cmp	al,2
   192 000000B1 7710                    	ja	k_bad
   193                                  
   194 000000B3 08C0                    	or	al,al
   195 000000B5 7415                    	jz	k_read
   196 000000B7 FEC8                    	dec	al
   197 000000B9 7435                    	jz	k_peek
   198                                  
   199                                  ; function 02 -- shift flags
   200 000000BB A01700                  	mov	al,[kbd_flag]
   201 000000BE 88460E                  	mov	[bp+offset_ax],al
   202 000000C1 EB05                    	jmp	k_done
   203                                  
   204                                  k_bad:
   205 000000C3 C7460E0000              	mov	word [bp+offset_ax],0
   206                                  k_done:
   207 000000C8 611F07                  	popm	all,ds,es
   208 000000CB CF                      	iret
   209                                  
   210                                  
   211                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   212                                  ; function 00 -- read a key, waiting until there is one
   213                                  ;
   214                                  ; HLT rather than a spin: the tick and the receive interrupt both wake
   215                                  ; it, and it keeps the bus quiet while DOS is idle at the prompt.
   216                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   217                                  k_read:
   218 000000CC FB                      	sti
   219                                  .1:
   220 000000CD 8B1E1A00                	mov	bx,[buffer_head]
   221 000000D1 3B1E1C00                	cmp	bx,[buffer_tail]
   222 000000D5 7503                    	jne	.2
   223 000000D7 F4                      	hlt				; nothing yet; wait for an interrupt
   224 000000D8 EBF3                    	jmp	.1
   225                                  .2:
   226 000000DA 8B07                    	mov	ax,[bx]			; the waiting key
   227                                  
   228 000000DC 83C302                  	add	bx,2
   229 000000DF 83FB3E                  	cmp	bx,KBD_END
   230 000000E2 7203                    	jb	.3
   231 000000E4 BB1E00                  	mov	bx,KBD_START
   232                                  .3:
   233 000000E7 891E1A00                	mov	[buffer_head],bx
   234                                  
   235 000000EB 89460E                  	mov	[bp+offset_ax],ax
   236 000000EE EBD8                    	jmp	k_done
   237                                  
   238                                  
   239                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   240                                  ; function 01 -- is a key waiting?
   241                                  ;
   242                                  ;  ZF set means the buffer is empty.  The key is left where it is.
   243                                  ;
   244                                  ; The Zero flag has to reach the caller, so this returns with RETF 2 --
   245                                  ; discarding the stacked flags -- rather than IRET, which would put them
   246                                  ; back and lose the answer.
   247                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   248                                  k_peek:
   249 000000F0 8B1E1A00                	mov	bx,[buffer_head]
   250 000000F4 3B1E1C00                	cmp	bx,[buffer_tail]
   251 000000F8 740D                    	je	.empty
   252                                  
   253 000000FA 8B07                    	mov	ax,[bx]
   254 000000FC 89460E                  	mov	[bp+offset_ax],ax
   255                                  
   256 000000FF 611F07                  	popm	all,ds,es
   257 00000102 09E4                    	or	sp,sp			; SP is never zero, so ZF clear:
   258 00000104 CA0200                  	retf	2			;  a key is waiting
   259                                  .empty:
   260 00000107 611F07                  	popm	all,ds,es
   261 0000010A 39E4                    	cmp	sp,sp			; ZF set: nothing waiting
   262 0000010C CA0200                  	retf	2
   263                                  
   264                                  
   265                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   266                                  ; kbd_scan -- ASCII to the scan code of the key that would produce it
   267                                  ;
   268                                  ; A serial console delivers characters, not key events, so the scan code
   269                                  ; has to be invented.  Most software reads only the ASCII byte, but
   270                                  ; enough of it looks at the scan code -- for Enter, Backspace and Escape
   271                                  ; especially -- that returning zero causes trouble.
   272                                  ;
   273                                  ; The value is the set-1 make code of the key bearing that character;
   274                                  ; shifted symbols carry the code of the unshifted key, which is what a
   275                                  ; real keyboard would have reported.
   276                                  ;
   277                                  ; 00h..1Fh are the control codes: Ctrl+letter carries the letter's code,
   278                                  ; with Backspace, Tab, Enter and Escape given their own keys.
   279                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   280 0000010F 90                      	align	2
   281                                  kbd_scan:
   282                                  ;	  ^@   ^A   ^B   ^C   ^D   ^E   ^F   ^G
   283 00000110 031E302E20122122        	db 0x03,0x1E,0x30,0x2E,0x20,0x12,0x21,0x22
   284                                  ;	  BS   TAB  ^J   ^K   ^L   CR   ^N   ^O
   285 00000118 0E0F2425261C3118        	db 0x0E,0x0F,0x24,0x25,0x26,0x1C,0x31,0x18
   286                                  ;	  ^P   ^Q   ^R   ^S   ^T   ^U   ^V   ^W
   287 00000120 1910131F14162F11        	db 0x19,0x10,0x13,0x1F,0x14,0x16,0x2F,0x11
   288                                  ;	  ^X   ^Y   ^Z   ESC  ^\   ^]   ^^   ^_
   289 00000128 2D152C012B1B070C        	db 0x2D,0x15,0x2C,0x01,0x2B,0x1B,0x07,0x0C
   290                                  ;	  SP   !    "    #    $    %    &    '
   291 00000130 3902280405060828        	db 0x39,0x02,0x28,0x04,0x05,0x06,0x08,0x28
   292                                  ;	  (    )    *    +    ,    -    .    /
   293 00000138 0A0B090D330C3435        	db 0x0A,0x0B,0x09,0x0D,0x33,0x0C,0x34,0x35
   294                                  ;	  0    1    2    3    4    5    6    7
   295 00000140 0B02030405060708        	db 0x0B,0x02,0x03,0x04,0x05,0x06,0x07,0x08
