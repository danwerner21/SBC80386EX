     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; 16h_kbd.asm -- INT 16h keyboard services over the serial console,
     3                                  ;                fed by the SIO0 receive interrupt
     4                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     5                                  ;
     6                                  ; Copyright (C) 2026 Dan Werner.  All rights reserved.
     7                                  ; Provided for hobbyist use on the RetroBrew SBC-386EX board.
     8                                  ;
     9                                  ; This program is free software: you can redistribute it and/or modify
    10                                  ; it under the terms of the GNU General Public License as published by
    11                                  ; the Free Software Foundation, either version 3 of the License, or
    12                                  ; (at your option) any later version.
    13                                  ;
    14                                  ; This program is distributed in the hope that it will be useful,
    15                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                                  ; GNU General Public License for more details.
    18                                  ;
    19                                  ; You should have received a copy of the GNU General Public License
    20                                  ; along with this program in the file COPYING in the topmost source
    21                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    22                                  ;
    23                                  ;
    24                                  ; Receive is interrupt-driven, and that is not an optimisation.  INT 14h
    25                                  ; is polled; if INT 16h polled as well, every key struck while DOS was
    26                                  ; producing output would be lost, because nothing would be looking at
    27                                  ; the UART during the write.  The ISR fills the ring buffer the PC BIOS
    28                                  ; has always kept at 40:1E, and INT 16h only ever reads from that.
    29                                  ;
    30                                  ; SIO0 receive lands on IRQ4 -- measured with IRQFIND in the monitor,
    31                                  ; and the same line a PC/AT gives COM1.  With ICW2M = 08h that is
    32                                  ; INT 0Ch, which is where int_irq4 sits.
    33                                  ;
    34                                  ; Assembly by NASM 2.08 is preferred
    35                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    36                                  %include "seg_def.inc"
    37                              <1> ; SEG_DEF.inc
    38                              <1> ;
    39                              <1> %ifndef SEG_DEF
    40                              <1> %define SEG_DEF 1
    41                              <1> 
    42                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    43                              <1> 
    44                              <1> segment CONST		align=16	class=DATA	public
    45                              <1> segment CONST2		align=2		class=DATA	public
    46                              <1> segment _DATA		align=16	class=DATA	public
    47                              <1> segment _BSS		align=16	class=DATA	public
    48                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    49                              <1> 
    50                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    51                              <1> 
    52                              <1> 
    53                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    54                              <1> 
    55                              <1> %define XXX
    56                              <1> %endif
    57                              <1> ;
    58                              <1> ; end SEG_DEF.inc
