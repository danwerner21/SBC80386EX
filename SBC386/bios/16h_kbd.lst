   311 00000180 1910131F14162F11        	db 0x19,0x10,0x13,0x1F,0x14,0x16,0x2F,0x11
   312                                  ;	  x    y    z    {    |    }    ~    DEL
   313 00000188 2D152C1A2B1B2953        	db 0x2D,0x15,0x2C,0x1A,0x2B,0x1B,0x29,0x53
