   101                              <1> defb DMA0BYC    equ     0xF001
   102                              <1> defb DMA0BYC_AT equ     0x0001
   103                              <1> defb DMA1TAR    equ     0xF002
   104                              <1> defb DMA1TAR_AT equ     0x0002
   105                              <1> defb DMA1BYC    equ     0xF003
   106                              <1> defb DMA1BYC_AT equ     0x0003
   107                              <1> defb DMACMD1    equ     0xF008
   108                              <1> defb DMACMD1_AT equ     0x0008
   109                              <1> defb DMASTS     equ     0xF008
   110                              <1> defb DMASTS_AT  equ     0x0008
   111                              <1> defb DMASRR     equ     0xF009
   112                              <1> defb DMASRR_AT  equ     0x0009
   113                              <1> defb DMAMSK     equ     0xF00A
   114                              <1> defb DMAMSK_AT  equ     0x000A
   115                              <1> defb DMAMOD1    equ     0xF00B
   116                              <1> defb DMAMOD1_AT equ     0x000B
   117                              <1> defb DMACLRBP   equ     0xF00C
   118                              <1> defb DMACLRBP_AT equ    0x000C
   119                              <1> defb DMACLR     equ     0xF00D
   120                              <1> defb DMACLR_AT  equ     0x000D
   121                              <1> defb DMACLRMSK  equ     0xF00E
   122                              <1> defb DMACLRMSK_AT equ   0x000E
   123                              <1> defb DMAGRPMSK  equ     0xF00F
   124                              <1> defb DMAGRPMSK_AT equ   0x000F
