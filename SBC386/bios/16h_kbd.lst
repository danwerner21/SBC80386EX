    41                                  %include "macro.inc"
    42                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    43                              <1> ;
    44                              <1> ; some useful macros:
    45                              <1> ;
    46                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    47                              <1> %define NREPEAT 0
    48                              <1> 
    49                              <1> %if NREPEAT
    50                              <1> 
    51                              <1> %macro	rep	1
    52                              <1> %%loop:	%1
    53                              <1> 	dec	cx
    54                              <1> 	jnz	%%loop
    55                              <1> %endm
    56                              <1> 
    57                              <1> %macro	repne	1
    58                              <1> %%loop:	%1
    59                              <1> 	je	%%e
    60                              <1> 	dec	cx
    61                              <1> 	jnz	%%loop
    62                              <1> 	cmp	cx,1
    63                              <1> 	jmp	%%done
    64                              <1> %%e:	dec	cx
    65                              <1> 	cmp	cx,cx
    66                              <1> %%done:
    67                              <1> %endm
    68                              <1> 
    69                              <1> %macro	repe	1
    70                              <1> %%loop:	%1
    71                              <1> 	jne	%%ne
    72                              <1> 	dec	cx
    73                              <1> 	jnz	%%loop
    74                              <1> 	jmp	%%done
    75                              <1> %%ne:	dec	cx
    76                              <1> 	jcxz	%%cxz
    77                              <1> 	jmp	%%done
    78                              <1> %%cxz:	cmp	cx,1
    79                              <1> %%done:
    80                              <1> %endm
    81                              <1> 
    82                              <1> %macro	REP	1
    83                              <1> %%loop:	%1
    84                              <1> 	dec	ecx
    85                              <1> 	jnz	%%loop
    86                              <1> %endm
    87                              <1> 
    88                              <1> %macro	REPNE	1
    89                              <1> %%loop:	%1
    90                              <1> 	je	%%e
    91                              <1> 	dec	ecx
    92                              <1> 	jnz	%%loop
    93                              <1> 	cmp	cl,1
    94                              <1> 	jmp	%%done
    95                              <1> %%e:	dec	ecx
    96                              <1> 	cmp	cl,cl
    97                              <1> %%done:
    98                              <1> %endm
    99                              <1> 
   100                              <1> %macro	REPE	1
   101                              <1> %%loop:	%1
   102                              <1> 	jne	%%ne
   103                              <1> 	dec	ecx
   104                              <1> 	jnz	%%loop
   105                              <1> 	jmp	%%done
   106                              <1> %%ne:	dec	ecx
   107                              <1> 	jecxz	%%cxz
   108                              <1> 	jmp	%%done
   109                              <1> %%cxz:	cmp	cl,1
   110                              <1> %%done:
   111                              <1> %endm
   112                              <1> 
   113                              <1> %endif
   114                              <1> 
   115                              <1> 
   116                              <1> ;
   117                              <1> ; format of the BYTE initialization table:  address, byte
   118                              <1> ;
   119                              <1> %imacro  binit 2
   120                              <1>         dw      %1
   121                              <1>         db      %2
   122                              <1> %endmacro
   123                              <1> ; end with DW -1
   124                              <1> 
   125                              <1> ;
   126                              <1> ; format of the WORD initialization table:  address, word
   127                              <1> ;
   128                              <1> %imacro  winit 2
   129                              <1>         dw      %1
   130                              <1>         dw      %2
   131                              <1> %endmacro
   132                              <1> ; end with DW -1
   133                              <1> 
   134                              <1> 
   135                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   136                              <1> %imacro get_bda	1.nolist
   137                              <1> 	push	0x0040
   138                              <1> 	pop	%1
   139                              <1> 	cnop
   140                              <1> %endm
   141                              <1> 
   142                              <1> 
   143                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   144                              <1> %imacro	get_loc0 1.nolist
   145                              <1> 	push	0x0000
   146                              <1> 	pop	%1
   147                              <1> 	cnop
   148                              <1> %endm
   149                              <1> 
   150                              <1> 
   151                              <1> 
   152                              <1> %imacro setloc  1.nolist
   153                              <1>  times   (%1-($-$$)) db 0FFh
   154                              <1> %endm
   155                              <1> 
   156                              <1> %imacro db_lo   1
   157                              <1>  db (%1)&255
   158                              <1> %endm
   159                              <1> 
   160                              <1> %imacro cnop    0.nolist
   161                              <1> %ifdef SOFT_DEBUG
   162                              <1> %if SOFT_DEBUG
   163                              <1>         nop
   164                              <1> %endif
   165                              <1> %endif
   166                              <1> %endm
   167                              <1> 
   168                              <1> %imacro popm 1-*.nolist
   169                              <1> %rep %0
   170                              <1> %ifidni %1,ALL
   171                              <1>  popa
   172                              <1> %elifidni %1,F
   173                              <1>  popf
   174                              <1> %else
   175                              <1>  pop %1
   176                              <1> %ifidni %1,DS
   177                              <1>  cnop
   178                              <1> %elifidni %1,ES
   179                              <1>  cnop
   180                              <1> %elifidni %1,FS
   181                              <1>  cnop
   182                              <1> %elifidni %1,GS
   183                              <1>  cnop
   184                              <1> %endif
   185                              <1> %endif
   186                              <1> %rotate 1
   187                              <1> %endrep
   188                              <1> %endm
   189                              <1> 
   190                              <1> %imacro pushm 1-*.nolist
   191                              <1> %rep %0
   192                              <1> %rotate -1
   193                              <1> %ifidni %1,ALL
   194                              <1>  pusha
   195                              <1> %elifidni %1,F
   196                              <1>  pushf
   197                              <1> %else
   198                              <1>  push %1
   199                              <1> %endif
   200                              <1> %endrep
   201                              <1> %endm
   202                              <1> 
   203                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   204                              <1> %assign __size__ (%2-1)	| 0xFF
   205                              <1> %if (__size__ <= 0xFFFF)
   206                              <1> %assign __gran__ 0
   207                              <1> %else
   208                              <1> %assign __gran__ 0xC0			; G B 0 0
   209                              <1> %endif
   210                              <1> %assign __expand__ 0
   211                              <1> %if %0==3
   212                              <1> %if %3
   213                              <1> %assign __expand__ 4
   214                              <1> %endif
   215                              <1> %endif
   216                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   217                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   218                              <1> %endm
   219                              <1> 
   220                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   221                              <1> %assign __size__ (%2-1)	| 0xFF
   222                              <1> %if (__size__ <= 0xFFFF)
   223                              <1> %assign __gran__ 0
   224                              <1> %else
   225                              <1> %assign __gran__ 0xC0			; G D 0 0
   226                              <1> %endif
   227                              <1> %assign __conform__ 0
   228                              <1> %if %0==3
   229                              <1> %if %3
   230                              <1> %assign __conform__ 4
   231                              <1> %endif
   232                              <1> %endif
   233                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   234                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   235                              <1> %endm
   236                              <1> 
   237                              <1> ;/* End of macro.inc */
