   415                              <1> defb	MSR_RI 	equ	BIT6
   416                              <1> defb	MSR_DSR	equ	BIT5
   417                              <1> defb	MSR_CTS	equ	BIT4
   418                              <1> defb	MSR_deltaDCD	equ	BIT3
   419                              <1> defb	MSR_deltaRI	equ	BIT2
   420                              <1> defb	MSR_deltaDSR	equ	BIT1
   421                              <1> defb	MSR_deltaCTS	equ	BIT0
   422                              <1> 
   423                              <1> ;/* Bits in CR0
   424                              <1> ;*/
   425                              <1> defb    CR0_PE  equ     BIT0
   426                              <1> defb    CR0_MP  equ     BIT1
   427                              <1> defb    CR0_EM  equ     BIT2
   428                              <1> defb    CR0_TS  equ     BIT3
   429                              <1> defd    CR0_WP  equ     BIT16
