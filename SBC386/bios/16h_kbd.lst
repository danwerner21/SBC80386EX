   114 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   115                              <1> ; */
   116                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
   117                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
   118                              <1> ; program can set it and jump to FFFF:0000 -- that is the PC convention  */
   119                              <1> ; and this BIOS honours it.                                             */
   120                              <1> %define WARM_BOOT 0x1234
   121                              <1> ; */
