   297 00000148 090A2727330D3435        	db 0x09,0x0A,0x27,0x27,0x33,0x0D,0x34,0x35
   298                                  ;	  @    A    B    C    D    E    F    G
   299 00000150 031E302E20122122        	db 0x03,0x1E,0x30,0x2E,0x20,0x12,0x21,0x22
   300                                  ;	  H    I    J    K    L    M    N    O
   301 00000158 2317242526323118        	db 0x23,0x17,0x24,0x25,0x26,0x32,0x31,0x18
   302                                  ;	  P    Q    R    S    T    U    V    W
   303 00000160 1910131F14162F11        	db 0x19,0x10,0x13,0x1F,0x14,0x16,0x2F,0x11
   304                                  ;	  X    Y    Z    [    \    ]    ^    _
   305 00000168 2D152C1A2B1B070C        	db 0x2D,0x15,0x2C,0x1A,0x2B,0x1B,0x07,0x0C
   306                                  ;	  `    a    b    c    d    e    f    g
   307 00000170 291E302E20122122        	db 0x29,0x1E,0x30,0x2E,0x20,0x12,0x21,0x22
   308                                  ;	  h    i    j    k    l    m    n    o
   309 00000178 2317242526323118        	db 0x23,0x17,0x24,0x25,0x26,0x32,0x31,0x18
