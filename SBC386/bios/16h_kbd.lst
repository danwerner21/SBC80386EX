   406                              <1> defb    IIR1    equ     0x02FA
   407                              <1> defb    LCR1    equ     0x02FB
   408                              <1> defb    MCR1    equ     0x02FC
   409                              <1> defb    LSR1    equ     0x02FD
   410                              <1> defb    MSR1    equ     0x02FE
   411                              <1> defb    SCR1    equ     0x02FF
   412                              <1> 
   413                              <1> ;/* LSRx bits
   414                              <1> ;*/
   415                              <1> defb    LSR_TE  equ     BIT6
   416                              <1> defb    LSR_TBE equ     BIT5
   417                              <1> defb    LSR_BI  equ     BIT4
   418                              <1> defb    LSR_FE  equ     BIT3
   419                              <1> defb    LSR_PE  equ     BIT2
   420                              <1> defb    LSR_OE  equ     BIT1
   421                              <1> defb    LSR_RBF equ     BIT0
   422                              <1> 
   423                              <1> ;/* MSRx bits
   424                              <1> ;*/
   425                              <1> defb	MSR_DCD	equ	BIT7
   426                              <1> defb	MSR_RI 	equ	BIT6
   427                              <1> defb	MSR_DSR	equ	BIT5
   428                              <1> defb	MSR_CTS	equ	BIT4
   429                              <1> defb	MSR_deltaDCD	equ	BIT3
   430                              <1> defb	MSR_deltaRI	equ	BIT2
   431                              <1> defb	MSR_deltaDSR	equ	BIT1
   432                              <1> defb	MSR_deltaCTS	equ	BIT0
   433                              <1> 
   434                              <1> ;/* Bits in CR0
   435                              <1> ;*/
   436                              <1> defb    CR0_PE  equ     BIT0
   437                              <1> defb    CR0_MP  equ     BIT1
   438                              <1> defb    CR0_EM  equ     BIT2
   439                              <1> defb    CR0_TS  equ     BIT3
