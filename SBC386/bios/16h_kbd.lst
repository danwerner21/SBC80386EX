    70                              <1> ;/* i386EX.inc  --  register definitions for the Intel 80386EX processor
    71                              <1> ;
    72                              <1> %define defb
    73                              <1> %define defw
    74                              <1> %define defd
    75                              <1> ;*/
    76                              <1> 
    77                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    78                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    79                              <1> ;*  first thing it does, so anything that restarts the board in software has
    80                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    81                              <1> ;*  hard way.
    82                              <1> ;*/
    83                              <1> defw    DEVICE_ID equ   0x2309
    84                              <1> 
    85                              <1> ;/* The Address Configuration register
    86                              <1> ;*/
    87                              <1> defb REMAPCFGH  equ     0x0023
    88                              <1> defb REMAPCFGL  equ     0x0022
    89                              <1> defw REMAPCFG   equ     0x0022
    90                              <1> 
    91                              <1> ;/* The A20gate and fast CPU Reset
    92                              <1> ;*/
    93                              <1> defb PORT92     equ     0xF092
    94                              <1> defb PORT92_AT  equ     0x0092
    95                              <1> 
    96                              <1> ;
    97                              <1> ;/* The DMA Controller and Bus Arbiter
    98                              <1> ;*/
