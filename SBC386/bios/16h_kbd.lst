   185                              <1> ; end of 31 bytes of NVRAM information */
   186                              <1> ; */
   187 00000100 ??                  <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte*//
   188                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   189 00000101 ??                  <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   190                              <1> ; */
   191                              <1> ; Extentsion to BDA during BIOS startup */
   192                              <1> ; */
   193                              <1> endstruc
   193          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    45                                  %undef XXX
    46                                  
    47                                  	global	int_16h
    48                                  	global	int_irq4
    49                                  	global	int_irq1
    50                                  	global	kbd_init_
    51                                  
    52                                  	extern	reboot_			; 19h_boot.asm -- restarts the board
    53                                  
    54                                  segment	_TEXT
    55                                  
    56                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    57                                  ; The console reset sequence -- this machine's Ctrl-Alt-Del
    58                                  ;
    59                                  ; A serial console has no Ctrl and no Alt to press: it delivers characters,
    60                                  ; not key events, which is why kbd_flag never holds anything.  Nothing
    61                                  ; requires the sequence to be that particular one, though, so the trigger is
    62                                  ; a character unlikely to arrive by accident, three times in a row.
    63                                  ;
    64                                  ; 1Eh is Ctrl-^.  It was picked over the more obvious Ctrl-] (1Dh) because
    65                                  ; that is the telnet escape and would be eaten by the terminal program
    66                                  ; before it ever reached the board, and over Ctrl-\ (1Ch) because that is
    67                                  ; SIGQUIT to a Unix terminal.  Nothing in common use binds Ctrl-^.
    68                                  ;
    69                                  ; The count lives in alt_input, which on a PC accumulates Alt+numpad digits
    70                                  ; and here has nothing to do: the serial console has no Alt and no numpad.
    71                                  ; The PS/2 keyboard, which has both, has a real Ctrl-Alt-Del in kbd_scan1
    72                                  ; and does not use this field.
    73                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    74                                  RESET_KEY	equ	0x1E		; Ctrl-^
    75                                  RESET_COUNT	equ	3		; how many in a row
    76                                  ASCII_BEL	equ 	0X08
    77                                  
    78                                  NS_EOI		equ	0x20		; non-specific end of interrupt
    79                                  KBD_START	equ	0x1E		; kbd_buffer, at 40:1E as on a PC
    80                                  KBD_END		equ	0x3E		; one past its last word
    81                                  
    82                                  
    83                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    84                                  ; kbd_init -- set the ring buffer up and turn the receive interrupt on
    85                                  ;
    86                                  ;	void kbd_init(void);
    87                                  ;
    88                                  ; Called from POST.  Until this runs the buffer pointers are zero, which
    89                                  ; would make the buffer look like a 16-word ring based at 40:0000 -- on
    90                                  ; top of the serial device table.
    91                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    92                                  kbd_init_:
    93 00000000 1E5250                  	pushm	ax,dx,ds
    94                                  
    95 00000003 6A401F                  	get_bda	DS
    96 00000006 C70680001E00            	mov	word [buffer_start],KBD_START
    97 0000000C C70682003E00            	mov	word [buffer_end],KBD_END
    98 00000012 C7061A001E00            	mov	word [buffer_head],KBD_START
    99 00000018 C7061C001E00            	mov	word [buffer_tail],KBD_START
   100 0000001E C606170000              	mov	byte [kbd_flag],0
   101 00000023 C606180000              	mov	byte [kbd_flag1],0
   102 00000028 C606190000              	mov	byte [alt_input],0	; the console reset sequence counter
   103 0000002D C606970000              	mov	byte [kbd_flag2],0
   104 00000032 C606960000              	mov	byte [kbd_flag3],0	; no scan code prefix outstanding
   105                                  
   106 00000037 BAF903                  	mov	dx,IER0			; receive data available
   107 0000003A B001                    	mov	al,0x01
   108 0000003C EE                      	out	dx,al
   109                                  
   110 0000003D 585A1F                  	popm	ax,dx,ds
   111                                  
   112 00000040 B80400                  	mov	ax,4			; IRQ4 -- SIO0 receive
   113                                  	extern	unmask_interrupt_
   114 00000043 E8(0000)                	call	unmask_interrupt_
   115                                  
   116 00000046 E87101                  	call	kbc_init		; and the PS/2 keyboard, if the board is in
   117 00000049 C3                      	ret
   118                                  
   119                                  
   120                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   121                                  ; int_irq4 -- the SIO0 receive interrupt
   122                                  ;
   123                                  ; Drains the UART into the ring buffer.  The loop matters: at 9600 baud
   124                                  ; with interrupts occasionally masked elsewhere, more than one character
   125                                  ; can be waiting by the time this runs, and leaving one behind would
   126                                  ; leave the interrupt asserted with nothing to clear it.
   127                                  ;
   128                                  ; A full buffer drops the character and beeps, which is what a PC does.
   129                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   130                                  int_irq4:
   131 0000004A 1E575652515350          	pushm	ax,bx,cx,dx,si,di,ds
   132                                  
   133 00000051 6A401F                  	get_bda	DS
   134 00000054 FC                      	cld
   135                                  .1:
   136 00000055 BAFD03                  	mov	dx,LSR0
   137 00000058 EC                      	in	al,dx
   138 00000059 A801                    	test	al,0x01			; anything in the receiver?
   139 0000005B 7424                    	jz	.9
   140                                  
   141 0000005D BAF803                  	mov	dx,RBR0
   142 00000060 EC                      	in	al,dx
   143 00000061 247F                    	and	al,0x7F			; the console is 7-bit clean
   144                                  
   145                                  ; Watch for the reset sequence before the character goes anywhere.  The
   146                                  ; matching characters are eaten rather than delivered: this is an escape
   147                                  ; out of the running system, not data, and a partial sequence reaching DOS
   148                                  ; would be worse than losing it.
   149 00000063 3C1E                    	cmp	al,RESET_KEY
   150 00000065 7407                    	je	.rkey
   151 00000067 C606190000              	mov	byte [alt_input],0	; anything else breaks the run
   152 0000006C EB0E                    	jmp	short .stuff
   153                                  .rkey:
   154 0000006E FE061900                	inc	byte [alt_input]
   155 00000072 803E190003              	cmp	byte [alt_input],RESET_COUNT
   156 00000077 72DC                    	jb	.1			; not there yet; eat it and carry on
   157 00000079 E9(0000)                	jmp	reboot_			; does not return
   158                                  .stuff:
   159 0000007C E80E00                  	call	kbd_stuff
   160 0000007F EBD4                    	jmp	.1
   161                                  .9:
   162 00000081 B020                    	mov	al,NS_EOI
   163 00000083 E620                    	out	OCW2M_AT,al
   164                                  
   165 00000085 585B595A5E5F1F          	popm	ax,bx,cx,dx,si,di,ds
   166 0000008C CF                      	iret
   167                                  
   168                                  
   169                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   170                                  ; kbd_stuff -- put the character in AL into the ring buffer
   171                                  ;
   172                                  ;  DS is the BDA.  AX, BX, CX are destroyed.
   173                                  ;
   174                                  ; The stored word is the PC convention: scan code in the high byte,
   175                                  ; ASCII in the low.  DOS reads the ASCII; a few programs check the scan
   176                                  ; code, which is why it is synthesised rather than left zero.
   177                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   178                                  kbd_stuff:
   179 0000008D 52515350                	pushm	ax,bx,cx,dx
   180                                  
   181                                  ; DEL from a terminal means backspace to DOS
   182 00000091 3C7F                    	cmp	al,0x7F
   183 00000093 7502                    	jne	.1
   184 00000095 B008                    	mov	al,ASCII_BS
   185                                  .1:
   186 00000097 0FB6D8                  	movzx	bx,al
   187 0000009A 2E8AA7[3A01]               cs	mov	ah,[bx+kbd_scan]	; synthesise the scan code
   188 0000009F 89C1                    	mov	cx,ax			; CX is the word to store
   189                                  kbd_stuff_word:				; entered from kbd_stuff_ax with CX made
   190                                  
   191 000000A1 8B1E1C00                	mov	bx,[buffer_tail]
   192 000000A5 89D8                    	mov	ax,bx
   193 000000A7 83C002                  	add	ax,2
   194 000000AA 83F83E                  	cmp	ax,KBD_END
   195 000000AD 7203                    	jb	.2
   196 000000AF B81E00                  	mov	ax,KBD_START		; wrapped
   197                                  .2:
   198 000000B2 3B061A00                	cmp	ax,[buffer_head]
   199 000000B6 7407                    	je	.full			; tail would meet head: no room
   200                                  
   201 000000B8 890F                    	mov	[bx],cx			; DS is 0040, BX is the offset
   202 000000BA A31C00                  	mov	[buffer_tail],ax
   203 000000BD EB08                    	jmp	.9
   204                                  .full:
   205 000000BF B008                    	mov	al,ASCII_BEL		; the buffer is full -- complain
   206 000000C1 B401                    	mov	ah,1
   207 000000C3 31D2                    	xor	dx,dx
   208 000000C5 CD14                    	int	0x14
   209                                  .9:
   210 000000C7 585B595A                	popm	ax,bx,cx,dx
   211 000000CB C3                      	ret
   212                                  
   213                                  
   214                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   215                                  ; INT 16h -- keyboard services
   216                                  ;
   217                                  ;    Function		Usage
   218                                  ;    ========		=====
   219                                  ;	00	read a key, waiting for one
   220                                  ;	01	report whether a key is waiting, without taking it
   221                                  ;	02	read the shift flags
   222                                  ;	10h	as 00, extended
   223                                  ;	11h	as 01, extended
   224                                  ;	12h	as 02, extended
   225                                  ;
   226                                  ; 10h/11h/12h are the 101-key forms.  On a serial console they have
   227                                  ; nothing extra to report, so they share the code.
   228                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   229                                  int_16h:
   230 000000CC FB                      	sti
   231 000000CD 061E60                  	pushm	all,ds,es
   232 000000D0 89E5                    	mov	bp,sp
   233 000000D2 FC                      	cld
   234 000000D3 6A401F                  	get_bda	DS
   235                                  
   236 000000D6 88E0                    	mov	al,ah
   237 000000D8 240F                    	and	al,0x0F			; 10h/11h/12h behave as 00/01/02
   238 000000DA 3C02                    	cmp	al,2
   239 000000DC 7710                    	ja	k_bad
   240                                  
   241 000000DE 08C0                    	or	al,al
   242 000000E0 7415                    	jz	k_read
   243 000000E2 FEC8                    	dec	al
   244 000000E4 7435                    	jz	k_peek
   245                                  
   246                                  ; function 02 -- shift flags
   247 000000E6 A01700                  	mov	al,[kbd_flag]
   248 000000E9 88460E                  	mov	[bp+offset_ax],al
   249 000000EC EB05                    	jmp	k_done
   250                                  
   251                                  k_bad:
   252 000000EE C7460E0000              	mov	word [bp+offset_ax],0
   253                                  k_done:
   254 000000F3 611F07                  	popm	all,ds,es
   255 000000F6 CF                      	iret
   256                                  
   257                                  
   258                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   259                                  ; function 00 -- read a key, waiting until there is one
   260                                  ;
   261                                  ; HLT rather than a spin: the tick and the receive interrupt both wake
   262                                  ; it, and it keeps the bus quiet while DOS is idle at the prompt.
   263                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   264                                  k_read:
   265 000000F7 FB                      	sti
   266                                  .1:
   267 000000F8 8B1E1A00                	mov	bx,[buffer_head]
   268 000000FC 3B1E1C00                	cmp	bx,[buffer_tail]
   269 00000100 7503                    	jne	.2
   270 00000102 F4                      	hlt				; nothing yet; wait for an interrupt
   271 00000103 EBF3                    	jmp	.1
   272                                  .2:
   273 00000105 8B07                    	mov	ax,[bx]			; the waiting key
   274                                  
   275 00000107 83C302                  	add	bx,2
   276 0000010A 83FB3E                  	cmp	bx,KBD_END
   277 0000010D 7203                    	jb	.3
   278 0000010F BB1E00                  	mov	bx,KBD_START
   279                                  .3:
   280 00000112 891E1A00                	mov	[buffer_head],bx
   281                                  
   282 00000116 89460E                  	mov	[bp+offset_ax],ax
   283 00000119 EBD8                    	jmp	k_done
   284                                  
   285                                  
   286                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   287                                  ; function 01 -- is a key waiting?
   288                                  ;
   289                                  ;  ZF set means the buffer is empty.  The key is left where it is.
   290                                  ;
   291                                  ; The Zero flag has to reach the caller, so this returns with RETF 2 --
   292                                  ; discarding the stacked flags -- rather than IRET, which would put them
   293                                  ; back and lose the answer.
   294                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   295                                  k_peek:
   296 0000011B 8B1E1A00                	mov	bx,[buffer_head]
   297 0000011F 3B1E1C00                	cmp	bx,[buffer_tail]
   298 00000123 740D                    	je	.empty
   299                                  
   300 00000125 8B07                    	mov	ax,[bx]
   301 00000127 89460E                  	mov	[bp+offset_ax],ax
   302                                  
   303 0000012A 611F07                  	popm	all,ds,es
   304 0000012D 09E4                    	or	sp,sp			; SP is never zero, so ZF clear:
   305 0000012F CA0200                  	retf	2			;  a key is waiting
   306                                  .empty:
   307 00000132 611F07                  	popm	all,ds,es
   308 00000135 39E4                    	cmp	sp,sp			; ZF set: nothing waiting
   309 00000137 CA0200                  	retf	2
   310                                  
   311                                  
   312                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   313                                  ; kbd_scan -- ASCII to the scan code of the key that would produce it
   314                                  ;
   315                                  ; A serial console delivers characters, not key events, so the scan code
   316                                  ; has to be invented.  Most software reads only the ASCII byte, but
   317                                  ; enough of it looks at the scan code -- for Enter, Backspace and Escape
   318                                  ; especially -- that returning zero causes trouble.
   319                                  ;
   320                                  ; The value is the set-1 make code of the key bearing that character;
   321                                  ; shifted symbols carry the code of the unshifted key, which is what a
   322                                  ; real keyboard would have reported.
   323                                  ;
   324                                  ; 00h..1Fh are the control codes: Ctrl+letter carries the letter's code,
   325                                  ; with Backspace, Tab, Enter and Escape given their own keys.
   326                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   327                                  	align	2
   328                                  kbd_scan:
   329                                  ;	  ^@   ^A   ^B   ^C   ^D   ^E   ^F   ^G
   330 0000013A 031E302E20122122        	db 0x03,0x1E,0x30,0x2E,0x20,0x12,0x21,0x22
   331                                  ;	  BS   TAB  ^J   ^K   ^L   CR   ^N   ^O
   332 00000142 0E0F2425261C3118        	db 0x0E,0x0F,0x24,0x25,0x26,0x1C,0x31,0x18
   333                                  ;	  ^P   ^Q   ^R   ^S   ^T   ^U   ^V   ^W
   334 0000014A 1910131F14162F11        	db 0x19,0x10,0x13,0x1F,0x14,0x16,0x2F,0x11
   335                                  ;	  ^X   ^Y   ^Z   ESC  ^\   ^]   ^^   ^_
   336 00000152 2D152C012B1B070C        	db 0x2D,0x15,0x2C,0x01,0x2B,0x1B,0x07,0x0C
   337                                  ;	  SP   !    "    #    $    %    &    '
   338 0000015A 3902280405060828        	db 0x39,0x02,0x28,0x04,0x05,0x06,0x08,0x28
   339                                  ;	  (    )    *    +    ,    -    .    /
   340 00000162 0A0B090D330C3435        	db 0x0A,0x0B,0x09,0x0D,0x33,0x0C,0x34,0x35
   341                                  ;	  0    1    2    3    4    5    6    7
   342 0000016A 0B02030405060708        	db 0x0B,0x02,0x03,0x04,0x05,0x06,0x07,0x08
   343                                  ;	  8    9    :    ;    <    =    >    ?
   344 00000172 090A2727330D3435        	db 0x09,0x0A,0x27,0x27,0x33,0x0D,0x34,0x35
   345                                  ;	  @    A    B    C    D    E    F    G
   346 0000017A 031E302E20122122        	db 0x03,0x1E,0x30,0x2E,0x20,0x12,0x21,0x22
   347                                  ;	  H    I    J    K    L    M    N    O
   348 00000182 2317242526323118        	db 0x23,0x17,0x24,0x25,0x26,0x32,0x31,0x18
   349                                  ;	  P    Q    R    S    T    U    V    W
   350 0000018A 1910131F14162F11        	db 0x19,0x10,0x13,0x1F,0x14,0x16,0x2F,0x11
   351                                  ;	  X    Y    Z    [    \    ]    ^    _
   352 00000192 2D152C1A2B1B070C        	db 0x2D,0x15,0x2C,0x1A,0x2B,0x1B,0x07,0x0C
   353                                  ;	  `    a    b    c    d    e    f    g
   354 0000019A 291E302E20122122        	db 0x29,0x1E,0x30,0x2E,0x20,0x12,0x21,0x22
   355                                  ;	  h    i    j    k    l    m    n    o
   356 000001A2 2317242526323118        	db 0x23,0x17,0x24,0x25,0x26,0x32,0x31,0x18
   357                                  ;	  p    q    r    s    t    u    v    w
   358 000001AA 1910131F14162F11        	db 0x19,0x10,0x13,0x1F,0x14,0x16,0x2F,0x11
   359                                  ;	  x    y    z    {    |    }    ~    DEL
   360 000001B2 2D152C1A2B1B2953        	db 0x2D,0x15,0x2C,0x1A,0x2B,0x1B,0x29,0x53
   361                                  len_kbd_scan	equ	$ - kbd_scan
   362                                  
   363                                  
   364                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   365                                  ; The PS/2 keyboard on the ECB VGA3 board
   366                                  ;
   367                                  ; The board carries an Intel 8242 -- an 8042 with the PC/AT keyboard
   368                                  ; firmware in it -- at the first two ports of its I/O block, which P3 on
   369                                  ; the board puts at 4E0h.  That makes this the port 60h/64h protocol at a
   370                                  ; different address and nothing else: translation is on, so scan codes
   371                                  ; arrive in set 1 exactly as INT 09h on a PC receives them.
   372                                  ;
   373                                  ; The interrupt goes out on the bus line K4 selects; both positions reach
   374                                  ; the 386EX INT0 pin, which is master IR1, which with ICW2 = 08h is INT 09h.
   375                                  ; K1 puts the video interrupt on INT5 (slave IR1, INT 71h) so the two never
   376                                  ; share a line; nothing enables it.
   377                                  ;
   378                                  ; Established with V3KBD in the monitor before a line of this was written.
   379                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   380                                  KBC_DATA	equ	0x4E0		; 8242 data, read and write
   381                                  KBC_STAT	equ	0x4E1		; status on read, command on write
   382                                  
   383                                  KBC_OBF		equ	0x01		; a byte is waiting at KBC_DATA
   384                                  KBC_IBF		equ	0x02		; the last byte written is not yet taken
   385                                  
   386                                  KBC_SELFTEST	equ	0xAA		; resets the controller; replies 55
   387                                  KBC_WRCMD	equ	0x60		; write the command byte
   388                                  KBC_ENABLE	equ	0xAE		; keyboard interface on
   389                                  KB_RESET	equ	0xFF		; to the keyboard; replies FA, then AA
   390                                  KBC_CMDBYTE	equ	0x41		; IRQ on, set-2-to-1 translation on,
   391                                  				; interface enabled, no system flag
   392                                  
   393                                  ; kbd_flag, 40:17, PC layout
   394                                  KF_RSHIFT	equ	0x01
   395                                  KF_LSHIFT	equ	0x02
   396                                  KF_CTRL		equ	0x04
   397                                  KF_ALT		equ	0x08
   398                                  KF_SCROLL	equ	0x10
   399                                  KF_NUM		equ	0x20
   400                                  KF_CAPS		equ	0x40
   401                                  KF_INS		equ	0x80
   402                                  
   403                                  ; kbd_flag3, 40:96, PC layout: the prefix state between interrupts
   404                                  KF3_E1		equ	0x01		; last code was E1 (Pause)
   405                                  KF3_E0		equ	0x02		; last code was E0
   406                                  
   407                                  
   408                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   409                                  ; kbc_init -- bring the controller up, if it is there
   410                                  ;
   411                                  ; Called from kbd_init.  The board may be absent, in which case the port
   412                                  ; floats and reads FF; that case leaves quietly and IR1 stays masked.  The
   413                                  ; timer is not running yet when this is called, so waits are counted, not
   414                                  ; timed: 64K reads of a port at seven wait states is some 30 ms, which is
   415                                  ; more than an 8042 ever needs and short enough not to notice at POST.
   416                                  ;
   417                                  ; The sequence is the PC/AT one, in full, because a shorter one did not
   418                                  ; work: drain, write the command byte and enable left the keyboard silent
   419                                  ; until the monitor's V3KBD -- self-test, enable, keyboard reset -- was
   420                                  ; run by hand.  The self-test resets the controller; the keyboard reset
   421                                  ; resets the keyboard.  Its replies, FA then AA, take up to half a second
   422                                  ; and are not waited for: IR1 is unmasked before they arrive and the ISR
   423                                  ; takes them as the break codes of 7A and 2A, which mean nothing.
   424                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   425                                  kbc_init:
   426 000001BA 525150                  	pushm	ax,cx,dx
   427                                  
   428 000001BD BAE104                  	mov	dx,KBC_STAT
   429 000001C0 EC                      	in	al,dx
   430 000001C1 3CFF                    	cmp	al,0xFF
   431 000001C3 7437                    	je	.9			; nothing there
   432                                  
   433                                  ; Whatever the controller has been holding since power-up goes.
   434 000001C5 B91000                  	mov	cx,16
   435                                  .drain:
   436 000001C8 EC                      	in	al,dx
   437 000001C9 A801                    	test	al,KBC_OBF
   438 000001CB 7409                    	jz	.drained
   439 000001CD BAE004                  	mov	dx,KBC_DATA
   440 000001D0 EC                      	in	al,dx
   441 000001D1 BAE104                  	mov	dx,KBC_STAT
   442 000001D4 E2F2                    	loop	.drain
   443                                  .drained:
   444 000001D6 B0AA                    	mov	al,KBC_SELFTEST		; reset the controller ...
   445 000001D8 E83C00                  	call	kbc_put_cmd
   446 000001DB E82200                  	call	kbc_take		; ... and take its 55, or give up
   447 000001DE B060                    	mov	al,KBC_WRCMD
   448 000001E0 E83400                  	call	kbc_put_cmd
   449 000001E3 B041                    	mov	al,KBC_CMDBYTE
   450 000001E5 E83500                  	call	kbc_put_data
   451 000001E8 B0AE                    	mov	al,KBC_ENABLE
   452 000001EA E82A00                  	call	kbc_put_cmd
   453 000001ED B0FF                    	mov	al,KB_RESET		; and reset the keyboard; see above
   454 000001EF E82B00                  	call	kbc_put_data
   455                                  
   456 000001F2 58595A                  	popm	ax,cx,dx
   457 000001F5 B80100                  	mov	ax,1			; IRQ1 -- the keyboard
   458 000001F8 E8(0000)                	call	unmask_interrupt_
   459 000001FB C3                      	ret
   460                                  .9:
   461 000001FC 58595A                  	popm	ax,cx,dx
   462 000001FF C3                      	ret
   463                                  
   464                                  ; Wait, bounded, for the controller to offer a byte, and take it.  The
   465                                  ; value is not wanted; the point is that the controller has finished
   466                                  ; what it was asked before it is asked the next thing.
   467                                  kbc_take:
   468 00000200 525150                  	pushm	ax,cx,dx
   469 00000203 BAE104                  	mov	dx,KBC_STAT
   470 00000206 31C9                    	xor	cx,cx
   471 00000208 EC                      .w:	in	al,dx
   472 00000209 A801                    	test	al,KBC_OBF
   473 0000020B E1FB                    	loopz	.w
   474 0000020D 7404                    	jz	.9			; gave up
   475 0000020F BAE004                  	mov	dx,KBC_DATA
   476 00000212 EC                      	in	al,dx
   477 00000213 58595A                  .9:	popm	ax,cx,dx
   478 00000216 C3                      	ret
   479                                  
   480                                  ; Write AL to the controller (command) or to the keyboard (data), once
   481                                  ; the input buffer is free.  Gives up rather than hangs.
   482                                  kbc_put_cmd:
   483 00000217 52                      	push	dx
   484 00000218 BAE104                  	mov	dx,KBC_STAT
   485 0000021B EB04                    	jmp	short kbc_put
   486                                  kbc_put_data:
   487 0000021D 52                      	push	dx
   488 0000021E BAE004                  	mov	dx,KBC_DATA
   489                                  kbc_put:
   490 00000221 5150                    	pushm	ax,cx
   491 00000223 B90000                  	mov	cx,0			; 64K tries
   492                                  .wait:
   493 00000226 52                      	push	dx
   494 00000227 BAE104                  	mov	dx,KBC_STAT
   495 0000022A EC                      	in	al,dx
   496 0000022B 5A                      	pop	dx
   497 0000022C A802                    	test	al,KBC_IBF
   498 0000022E E0F6                    	loopnz	.wait
   499 00000230 5859                    	popm	ax,cx
   500 00000232 EE                      	out	dx,al
   501 00000233 5A                      	pop	dx
   502 00000234 C3                      	ret
   503                                  
   504                                  
   505                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   506                                  ; int_irq1 -- INT 09h, a scan code from the 8242
   507                                  ;
   508                                  ; One byte per interrupt: the 8042 holds the keyboard off until the byte
   509                                  ; is read, then lets the next one through, which raises the line again.
   510                                  ; The line is edge-triggered, so the byte is taken before EOI and nothing
   511                                  ; is left to re-arm.
   512                                  ;
   513                                  ; An interrupt with no byte waiting is spurious and is simply
   514                                  ; acknowledged.  The VGA3's retrace interrupt is not used (vga3.asm
   515                                  ; reads the CRTC's blanking bit instead), so K1 belongs on 2-3, off
   516                                  ; this line.
   517                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   518                                  int_irq1:
   519 00000235 1E52515350              	pushm	ax,bx,cx,dx,ds
   520                                  
   521 0000023A BAE104                  	mov	dx,KBC_STAT
   522 0000023D EC                      	in	al,dx
   523 0000023E A801                    	test	al,KBC_OBF
   524 00000240 740A                    	jz	.eoi			; no byte: spurious, acknowledge only
   525 00000242 BAE004                  	mov	dx,KBC_DATA
   526 00000245 EC                      	in	al,dx
   527                                  
   528 00000246 6A401F                  	get_bda	DS
   529 00000249 E80A00                  	call	kbd_scan1
   530                                  .eoi:
   531 0000024C B020                    	mov	al,NS_EOI
   532 0000024E E620                    	out	OCW2M_AT,al
   533                                  
   534 00000250 585B595A1F              	popm	ax,bx,cx,dx,ds
   535 00000255 CF                      	iret
   536                                  
   537                                  
   538                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   539                                  ; kbd_scan1 -- one set-1 scan code in AL, DS the BDA
   540                                  ;
   541                                  ; Shift-state keys change kbd_flag and produce nothing.  Everything else
   542                                  ; is looked up by the shift state in force and stored as the PC word,
   543                                  ; scan in AH and ASCII in AL, through kbd_stuff_ax.
   544                                  ;
   545                                  ; Prefixes: E0 marks the keys that were added to the 101-key board --
   546                                  ; the cursor cluster, the right Ctrl and Alt, keypad Enter and /.  It is
   547                                  ; remembered in kbd_flag3 across the interrupt boundary and consumed by
   548                                  ; the next code.  E1 opens the six-byte Pause sequence, which is thrown
   549                                  ; away in its entirety.
   550                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   551                                  kbd_scan1:
   552 00000256 3CE0                    	cmp	al,0xE0
   553 00000258 7439                    	je	.pfx_e0
   554 0000025A 3CE1                    	cmp	al,0xE1
   555 0000025C 743B                    	je	.pfx_e1
   556 0000025E F606960001              	test	byte [kbd_flag3],KF3_E1
   557 00000263 753A                    	jnz	.in_pause
   558                                  
   559 00000265 8A1E9600                	mov	bl,[kbd_flag3]		; BL bit 1: this code had an E0
   560 00000269 80269600FD              	and	byte [kbd_flag3],~KF3_E0
   561                                  
   562 0000026E A880                    	test	al,0x80
   563 00000270 7537                    	jnz	.release
   564 00000272 E86400                  	call	.shifter		; a shift-state key?
   565 00000275 721B                    	jc	.done			;   yes, and it has been handled
   566                                  
   567 00000277 3C53                    	cmp	al,0x53			; Del
   568 00000279 750F                    	jne	.lookup
   569 0000027B 8A261700                	mov	ah,[kbd_flag]
   570 0000027F 80E40C                  	and	ah,KF_CTRL+KF_ALT
   571 00000282 80FC0C                  	cmp	ah,KF_CTRL+KF_ALT
   572 00000285 7503                    	jne	.lookup
   573 00000287 E9(0000)                	jmp	reboot_			; Ctrl-Alt-Del: does not return
   574                                  
   575                                  .lookup:
   576 0000028A E8AE00                  	call	kbd_lookup		; AX = the word, or CF if nothing
   577 0000028D 7203                    	jc	.done
   578 0000028F E8AC01                  	call	kbd_stuff_ax
   579                                  .done:
   580 00000292 C3                      	ret
   581                                  
   582                                  .pfx_e0:
   583 00000293 800E960002              	or	byte [kbd_flag3],KF3_E0
   584 00000298 C3                      	ret
   585                                  .pfx_e1:
   586 00000299 800E960001              	or	byte [kbd_flag3],KF3_E1
   587 0000029E C3                      	ret
   588                                  .in_pause:
   589 0000029F 3CC5                    	cmp	al,0xC5			; the sequence ends with the break of 45
   590 000002A1 75EF                    	jne	.done
   591 000002A3 80269600FC              	and	byte [kbd_flag3],~(KF3_E1+KF3_E0)
   592 000002A8 C3                      	ret
   593                                  
   594                                  .release:
   595 000002A9 247F                    	and	al,0x7F
   596 000002AB 3C1D                    	cmp	al,0x1D
   597 000002AD 741E                    	je	.rel_ctrl
   598 000002AF 3C38                    	cmp	al,0x38
   599 000002B1 7420                    	je	.rel_alt
   600 000002B3 F6C302                  	test	bl,KF3_E0		; E0 AA, E0 B6: the fake shifts (below)
   601 000002B6 75DA                    	jnz	.done
   602 000002B8 3C2A                    	cmp	al,0x2A
   603 000002BA 7405                    	je	.rel_ls
   604 000002BC 3C36                    	cmp	al,0x36
   605 000002BE 7407                    	je	.rel_rs
   606 000002C0 C3                      	ret				; the release of an ordinary key
   607                                  .rel_ls:
   608 000002C1 80261700FD              	and	byte [kbd_flag],~KF_LSHIFT
   609 000002C6 C3                      	ret
   610                                  .rel_rs:
   611 000002C7 80261700FE              	and	byte [kbd_flag],~KF_RSHIFT
   612 000002CC C3                      	ret
   613                                  .rel_ctrl:
   614 000002CD 80261700FB              	and	byte [kbd_flag],~KF_CTRL
   615 000002D2 C3                      	ret
   616                                  .rel_alt:
   617 000002D3 80261700F7              	and	byte [kbd_flag],~KF_ALT
   618 000002D8 C3                      	ret
   619                                  
   620                                  ; The make of a shift-state key.  CF set if AL was one.  Caps, Num and
   621                                  ; Scroll toggle on make.  The LEDs are not yet driven: that wants a small
   622                                  ; state machine for the keyboard's acknowledgements, and belongs with the
   623                                  ; first thing that needs it.
   624                                  ;
   625                                  ; E0 2A and E0 36 are not shifts.  With Num Lock on, the keyboard brackets
   626                                  ; every cursor-cluster key in them so that a host which knows nothing of
   627                                  ; E0 still gets a cursor key rather than a digit.  This host does know,
   628                                  ; so they are swallowed, or they would flip the keypad the wrong way.
   629                                  .shifter:
   630 000002D9 3C2A                    	cmp	al,0x2A
   631 000002DB 741A                    	je	.set_ls
   632 000002DD 3C36                    	cmp	al,0x36
   633 000002DF 7422                    	je	.set_rs
   634 000002E1 3C1D                    	cmp	al,0x1D
   635 000002E3 742C                    	je	.set_ctrl
   636 000002E5 3C38                    	cmp	al,0x38
   637 000002E7 742F                    	je	.set_alt
   638 000002E9 3C3A                    	cmp	al,0x3A
   639 000002EB 7432                    	je	.tog_caps
   640 000002ED 3C45                    	cmp	al,0x45
   641 000002EF 7435                    	je	.tog_num
   642 000002F1 3C46                    	cmp	al,0x46
   643 000002F3 743D                    	je	.tog_scroll
   644 000002F5 F8                      	clc
   645 000002F6 C3                      	ret
   646 000002F7 F6C302                  .set_ls:	test	bl,KF3_E0
   647 000002FA 7513                    		jnz	.fake
   648 000002FC 800E170002              		or	byte [kbd_flag],KF_LSHIFT
   649 00000301 F9                      		stc
   650 00000302 C3                      		ret
   651 00000303 F6C302                  .set_rs:	test	bl,KF3_E0
   652 00000306 7507                    		jnz	.fake
   653 00000308 800E170001              		or	byte [kbd_flag],KF_RSHIFT
   654 0000030D F9                      		stc
   655 0000030E C3                      		ret
   656 0000030F F9                      .fake:		stc			; eaten, nothing changes
   657 00000310 C3                      		ret
   658 00000311 800E170004              .set_ctrl:	or	byte [kbd_flag],KF_CTRL
   659 00000316 F9                      		stc
   660 00000317 C3                      		ret
   661 00000318 800E170008              .set_alt:	or	byte [kbd_flag],KF_ALT
   662 0000031D F9                      		stc
   663 0000031E C3                      		ret
   664 0000031F 8036170040              .tog_caps:	xor	byte [kbd_flag],KF_CAPS
   665 00000324 F9                      		stc
   666 00000325 C3                      		ret
   667 00000326 F6C302                  .tog_num:	test	bl,KF3_E0		; E0 45 is not Num Lock
   668 00000329 750E                    		jnz	.not_shifter
   669 0000032B 8036170020              		xor	byte [kbd_flag],KF_NUM
   670 00000330 F9                      		stc
   671 00000331 C3                      		ret
   672 00000332 8036170010              .tog_scroll:	xor	byte [kbd_flag],KF_SCROLL
   673 00000337 F9                      		stc
   674 00000338 C3                      		ret
   675 00000339 F8                      .not_shifter:	clc
   676 0000033A C3                      		ret
   677                                  
   678                                  
   679                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   680                                  ; kbd_lookup -- scan code AL, E0 flag in BL bit 1, shift state in kbd_flag
   681                                  ;
   682                                  ; Returns the PC key word in AX, or CF set for a code with no meaning.
   683                                  ; Three regions of the set-1 space, each with its own rule:
   684                                  ;
   685                                  ;    01..39   the typewriter keys, four tables' worth
   686                                  ;    3B..44   F1..F10, plus 57 and 58 for F11 and F12: no ASCII, and the
   687                                  ;             scan code moves by a fixed amount per shift state
   688                                  ;    47..53   the keypad: digits when Num Lock says so and no E0 says
   689                                  ;             otherwise, cursor keys with no ASCII when not
   690                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   691                                  kbd_lookup:
   692 0000033B 88C4                    	mov	ah,al			; AH: the scan code, kept for the word
   693 0000033D 88DE                    	mov	dh,bl			; DH: the E0 flag; BL becomes an index
   694 0000033F 8A0E1700                	mov	cl,[kbd_flag]
   695                                  
   696 00000343 3C39                    	cmp	al,0x39
   697 00000345 761C                    	jbe	.typewriter
   698 00000347 3C3B                    	cmp	al,0x3B
   699 00000349 7216                    	jb	.none
   700 0000034B 3C44                    	cmp	al,0x44
   701 0000034D 765F                    	jbe	.fkey
   702 0000034F 3C47                    	cmp	al,0x47
   703 00000351 720E                    	jb	.none
   704 00000353 3C53                    	cmp	al,0x53
   705 00000355 0F869800                	jbe	.keypad
   706 00000359 3C57                    	cmp	al,0x57
   707 0000035B 7451                    	je	.fkey
   708 0000035D 3C58                    	cmp	al,0x58
   709 0000035F 744D                    	je	.fkey
   710                                  .none:
   711 00000361 F9                      	stc
   712 00000362 C3                      	ret
   713                                  
   714                                  ; --- the typewriter keys ---------------------------------------------
   715                                  .typewriter:
   716 00000363 0FB6D8                  	movzx	bx,al
   717 00000366 4B                      	dec	bx			; tables begin at scan code 01
   718 00000367 F6C108                  	test	cl,KF_ALT
   719 0000036A 753E                    	jnz	.alt
   720 0000036C F6C104                  	test	cl,KF_CTRL
   721 0000036F 752E                    	jnz	.ctrl
   722 00000371 F6C103                  	test	cl,KF_LSHIFT+KF_RSHIFT
   723 00000374 7507                    	jnz	.shifted
   724 00000376 2E8A87[4804]               cs	mov	al,[bx+kt_normal]
   725 0000037B EB05                    	jmp	short .caps
   726                                  .shifted:
   727 0000037D 2E8A87[8104]               cs	mov	al,[bx+kt_shift]
   728                                  .caps:
   729 00000382 F6C140                  	test	cl,KF_CAPS
   730 00000385 7416                    	jz	.tw_done
   731                                  ; Caps Lock inverts shift for letters and nothing else
   732 00000387 3C61                    	cmp	al,'a'
   733 00000389 7208                    	jb	.caps_upper
   734 0000038B 3C7A                    	cmp	al,'z'
   735 0000038D 770E                    	ja	.tw_done
   736 0000038F 2C20                    	sub	al,'a'-'A'
   737 00000391 EB0A                    	jmp	short .tw_done
   738                                  .caps_upper:
   739 00000393 3C41                    	cmp	al,'A'
   740 00000395 7206                    	jb	.tw_done
   741 00000397 3C5A                    	cmp	al,'Z'
   742 00000399 7702                    	ja	.tw_done
   743 0000039B 0420                    	add	al,'a'-'A'
   744                                  .tw_done:
   745 0000039D F8                      	clc
   746 0000039E C3                      	ret
   747                                  .ctrl:
   748 0000039F 2E8A87[BA04]               cs	mov	al,[bx+kt_ctrl]
   749 000003A4 3CFF                    	cmp	al,0xFF			; FF marks a key with no Ctrl meaning
   750 000003A6 74B9                    	je	.none
   751 000003A8 F8                      	clc
   752 000003A9 C3                      	ret
   753                                  .alt:
   754 000003AA 30C0                    	xor	al,al			; Alt+key: no ASCII, the scan code says which
   755 000003AC F8                      	clc
   756 000003AD C3                      	ret
   757                                  
   758                                  ; --- the function keys -----------------------------------------------
   759                                  .fkey:
   760 000003AE 3C57                    	cmp	al,0x57
   761 000003B0 7202                    	jb	.f10
   762 000003B2 2C4D                    	sub	al,0x57-0x0A		; F11, F12 follow F10 in the numbering
   763                                  .f10:
   764 000003B4 2C3B                    	sub	al,0x3B			; 0..11
   765 000003B6 F6C108                  	test	cl,KF_ALT
   766 000003B9 7528                    	jnz	.f_alt
   767 000003BB F6C104                  	test	cl,KF_CTRL
   768 000003BE 7519                    	jnz	.f_ctrl
   769 000003C0 F6C103                  	test	cl,KF_LSHIFT+KF_RSHIFT
   770 000003C3 750A                    	jnz	.f_shift
   771 000003C5 043B                    	add	al,0x3B			; F1..F10 are 3B..44, F11 and F12 85, 86
   772 000003C7 3C45                    	cmp	al,0x45
   773 000003C9 7220                    	jb	.f_out
   774 000003CB 0440                    	add	al,0x85-0x45
   775 000003CD EB1C                    	jmp	short .f_out
   776                                  .f_shift:
   777 000003CF 0454                    	add	al,0x54			; 54..5D, then 87, 88
   778 000003D1 3C5E                    	cmp	al,0x5E
   779 000003D3 7216                    	jb	.f_out
   780 000003D5 0429                    	add	al,0x87-0x5E
   781 000003D7 EB12                    	jmp	short .f_out
   782                                  .f_ctrl:
   783 000003D9 045E                    	add	al,0x5E			; 5E..67, then 89, 8A
   784 000003DB 3C68                    	cmp	al,0x68
   785 000003DD 720C                    	jb	.f_out
   786 000003DF 0421                    	add	al,0x89-0x68
   787 000003E1 EB08                    	jmp	short .f_out
   788                                  .f_alt:
   789 000003E3 0468                    	add	al,0x68			; 68..71, then 8B, 8C
   790 000003E5 3C72                    	cmp	al,0x72
   791 000003E7 7202                    	jb	.f_out
   792 000003E9 0419                    	add	al,0x8B-0x72
   793                                  .f_out:
   794 000003EB 88C4                    	mov	ah,al
   795 000003ED 30C0                    	xor	al,al
   796 000003EF F8                      	clc
   797 000003F0 C3                      	ret
   798                                  
   799                                  ; --- the keypad ---------------------------------------------------------
   800                                  .keypad:
   801 000003F1 0FB6D8                  	movzx	bx,al
   802 000003F4 83EB47                  	sub	bx,0x47
   803 000003F7 F6C108                  	test	cl,KF_ALT
   804 000003FA 75AE                    	jnz	.alt
   805 000003FC F6C104                  	test	cl,KF_CTRL
   806 000003FF 752C                    	jnz	.kp_ctrl
   807                                  
   808                                  ; Num Lock, an E0 (the cursor cluster), or Shift: each one flips it
   809 00000401 F6C120                  	test	cl,KF_NUM
   810 00000404 0F95C2                  	setnz	dl
   811 00000407 F6C602                  	test	dh,KF3_E0
   812 0000040A 7403                    	jz	.kp1
   813 0000040C 80F201                  	xor	dl,1
   814                                  .kp1:
   815 0000040F F6C103                  	test	cl,KF_LSHIFT+KF_RSHIFT
   816 00000412 7403                    	jz	.kp2
   817 00000414 80F201                  	xor	dl,1
   818                                  .kp2:
   819 00000417 2E8A87[F304]               cs	mov	al,[bx+kt_keypad]	; the digit, or '-' '+' regardless
   820 0000041C 3C2D                    	cmp	al,'-'
   821 0000041E 740B                    	je	.kp_out
   822 00000420 3C2B                    	cmp	al,'+'
   823 00000422 7407                    	je	.kp_out
   824 00000424 F6C201                  	test	dl,1
   825 00000427 7502                    	jnz	.kp_out			; digits wanted
   826 00000429 30C0                    	xor	al,al			; a cursor key: no ASCII
   827                                  .kp_out:
   828 0000042B F8                      	clc
   829 0000042C C3                      	ret
   830                                  .kp_ctrl:
   831 0000042D 2E8A87[0005]               cs	mov	al,[bx+kt_kp_ctrl]
   832 00000432 3CFF                    	cmp	al,0xFF
   833 00000434 0F8429FF                	je	.none
   834 00000438 88C4                    	mov	ah,al			; Ctrl-cursor: the scan code is the meaning
   835 0000043A 30C0                    	xor	al,al
   836 0000043C F8                      	clc
   837 0000043D C3                      	ret
   838                                  
   839                                  
   840                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   841                                  ; kbd_stuff_ax -- AX is the complete word: scan in AH, ASCII in AL
   842                                  ;
   843                                  ; The tail of kbd_stuff, entered when the caller already knows the scan
   844                                  ; code and does not want one synthesised from the ASCII.
   845                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   846                                  kbd_stuff_ax:
   847 0000043E 52515350                	pushm	ax,bx,cx,dx
   848 00000442 89C1                    	mov	cx,ax
   849 00000444 E95AFC                  	jmp	kbd_stuff_word
   850                                  
   851                                  
   852                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   853                                  ; Set-1 scan code to ASCII, scan codes 01 to 39.  US layout.
   854                                  ;
   855                                  ; No line here may END with a backslash -- not even a comment.  NASM
   856                                  ; takes that as a continuation and swallows the next line whole, which
   857                                  ; is how the a..\ row once vanished and shifted every key after it by
   858                                  ; fourteen places.  The listing shows it as a line number that skips.
   859                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   860 00000447 90                      	align	2
   861                                  kt_normal:
   862                                  ;	  Esc  1    2    3    4    5    6    7    8    9    0    -    =    BS   Tab
   863 00000448 1B3132333435363738-     	db 0x1B,'1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 0x08,0x09
   863 00000451 39302D3D0809       
   864                                  ;	  q    w    e    r    t    y    u    i    o    p    [    ]    Ent  Ctl
   865 00000457 71776572747975696F-     	db 'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 0x0D,0x00
   865 00000460 705B5D0D00         
   866                                  ;	  a    s    d    f    g    h    j    k    l    ;    '    `    LSh  backslash
   867 00000465 6173646667686A6B6C-     	db 'a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', 0x27,'`', 0x00,'\'
   867 0000046E 3B2760005C         
   868                                  ;	  z    x    c    v    b    n    m    ,    .    /    RSh  *    Alt  Sp
   869 00000473 7A786376626E6D2C2E-     	db 'z', 'x', 'c', 'v', 'b', 'n', 'm', ',', '.', '/', 0x00,'*', 0x00,' '
   869 0000047C 2F002A0020         
