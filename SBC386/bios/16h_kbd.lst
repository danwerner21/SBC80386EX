     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; 16h_kbd.asm -- INT 16h keyboard services, fed by two interrupts:
     3                                  ;                the SIO0 receive (IRQ4) for the serial console, and
     4                                  ;                the 8242 on the VGA3 board (IRQ1) for a PS/2 keyboard.
     5                                  ;                Both feed the one ring buffer at 40:1E; INT 16h does
     6                                  ;                not know or care which a key came from.
     7                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     8                                  ;
     9                                  ; Copyright (C) 2026 Dan Werner.  All rights reserved.
    10                                  ; Provided for hobbyist use on the RetroBrew SBC-386EX board.
    11                                  ;
    12                                  ; This program is free software: you can redistribute it and/or modify
    13                                  ; it under the terms of the GNU General Public License as published by
    14                                  ; the Free Software Foundation, either version 3 of the License, or
    15                                  ; (at your option) any later version.
    16                                  ;
    17                                  ; This program is distributed in the hope that it will be useful,
    18                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    19                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    20                                  ; GNU General Public License for more details.
    21                                  ;
    22                                  ; You should have received a copy of the GNU General Public License
    23                                  ; along with this program in the file COPYING in the topmost source
    24                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    25                                  ;
    26                                  ;
    27                                  ; Receive is interrupt-driven, and that is not an optimisation.  INT 14h
    28                                  ; is polled; if INT 16h polled as well, every key struck while DOS was
    29                                  ; producing output would be lost, because nothing would be looking at
    30                                  ; the UART during the write.  The ISR fills the ring buffer the PC BIOS
    31                                  ; has always kept at 40:1E, and INT 16h only ever reads from that.
    32                                  ;
    33                                  ; SIO0 receive lands on IRQ4 -- measured with IRQFIND in the monitor,
    34                                  ; and the same line a PC/AT gives COM1.  With ICW2M = 08h that is
    35                                  ; INT 0Ch, which is where int_irq4 sits.
    36                                  ;
    37                                  ; Assembly by NASM 2.08 is preferred
    38                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    39                                  %include "seg_def.inc"
    40                              <1> ; SEG_DEF.inc
    41                              <1> ;
    42                              <1> %ifndef SEG_DEF
    43                              <1> %define SEG_DEF 1
    44                              <1> 
    45                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    46                              <1> 
    47                              <1> segment CONST		align=16	class=DATA	public
    48                              <1> segment CONST2		align=2		class=DATA	public
    49                              <1> segment _DATA		align=16	class=DATA	public
    50                              <1> segment _BSS		align=16	class=DATA	public
    51                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    52                              <1> 
    53                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    54                              <1> 
    55                              <1> 
    56                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    57                              <1> 
    58                              <1> %define XXX
    59                              <1> %endif
    60                              <1> ;
    61                              <1> ; end SEG_DEF.inc
    40                                  %include "i386ex.inc"
