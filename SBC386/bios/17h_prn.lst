   405                              <1> defb    LSR_OE  equ     BIT1
   406                              <1> defb    LSR_RBF equ     BIT0
   407                              <1> 
   408                              <1> ;/* MSRx bits
   409                              <1> ;*/
   410                              <1> defb	MSR_DCD	equ	BIT7
   411                              <1> defb	MSR_RI 	equ	BIT6
   412                              <1> defb	MSR_DSR	equ	BIT5
   413                              <1> defb	MSR_CTS	equ	BIT4
   414                              <1> defb	MSR_deltaDCD	equ	BIT3
   415                              <1> defb	MSR_deltaRI	equ	BIT2
   416                              <1> defb	MSR_deltaDSR	equ	BIT1
   417                              <1> defb	MSR_deltaCTS	equ	BIT0
   418                              <1> 
   419                              <1> ;/* Bits in CR0
   420                              <1> ;*/
   421                              <1> defb    CR0_PE  equ     BIT0
   422                              <1> defb    CR0_MP  equ     BIT1
   423                              <1> defb    CR0_EM  equ     BIT2
   424                              <1> defb    CR0_TS  equ     BIT3
   425                              <1> defd    CR0_WP  equ     BIT16
   426                              <1> defd    CR0_PG  equ     BIT31
   427                              <1> 
   428                              <1> ;/* Some ASCII character codes
   429                              <1> ;*/
   430                              <1> defb    ASCII_NUL       equ     0x00
   431                              <1> defb    ASCII_BS        equ     0x08
   432                              <1> defb    ASCII_HT        equ     0x09
   433                              <1> defb    ASCII_LF        equ     0x0A
   434                              <1> defb    ASCII_NL        equ     0x0A
   435                              <1> defb    ASCII_FF        equ     0x0C
   436                              <1> defb    ASCII_CR        equ     0x0D
   437                              <1> defb	ASCII_ESC	equ	0x1B
   438                              <1> defb    ASCII_SP        equ     0x20
   439                              <1> defb    ASCII_DEL       equ     0x7F
   440                              <1> defb	ASCII_RUB	equ	0xFF
   441                              <1> 
   442                              <1> 
   443                              <1> ;/* End of i386EX.inc */
    26                                  %include "macro.inc"
    27                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    28                              <1> ;
    29                              <1> ; some useful macros:
    30                              <1> ;
    31                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    32                              <1> %define NREPEAT 0
    33                              <1> 
    34                              <1> %if NREPEAT
    35                              <1> 
    36                              <1> %macro	rep	1
    37                              <1> %%loop:	%1
    38                              <1> 	dec	cx
    39                              <1> 	jnz	%%loop
    40                              <1> %endm
    41                              <1> 
    42                              <1> %macro	repne	1
    43                              <1> %%loop:	%1
    44                              <1> 	je	%%e
    45                              <1> 	dec	cx
    46                              <1> 	jnz	%%loop
    47                              <1> 	cmp	cx,1
    48                              <1> 	jmp	%%done
    49                              <1> %%e:	dec	cx
    50                              <1> 	cmp	cx,cx
    51                              <1> %%done:
    52                              <1> %endm
    53                              <1> 
    54                              <1> %macro	repe	1
    55                              <1> %%loop:	%1
    56                              <1> 	jne	%%ne
    57                              <1> 	dec	cx
    58                              <1> 	jnz	%%loop
    59                              <1> 	jmp	%%done
    60                              <1> %%ne:	dec	cx
    61                              <1> 	jcxz	%%cxz
    62                              <1> 	jmp	%%done
    63                              <1> %%cxz:	cmp	cx,1
    64                              <1> %%done:
    65                              <1> %endm
    66                              <1> 
    67                              <1> %macro	REP	1
    68                              <1> %%loop:	%1
    69                              <1> 	dec	ecx
    70                              <1> 	jnz	%%loop
    71                              <1> %endm
    72                              <1> 
    73                              <1> %macro	REPNE	1
    74                              <1> %%loop:	%1
    75                              <1> 	je	%%e
    76                              <1> 	dec	ecx
    77                              <1> 	jnz	%%loop
    78                              <1> 	cmp	cl,1
    79                              <1> 	jmp	%%done
    80                              <1> %%e:	dec	ecx
    81                              <1> 	cmp	cl,cl
    82                              <1> %%done:
    83                              <1> %endm
    84                              <1> 
    85                              <1> %macro	REPE	1
    86                              <1> %%loop:	%1
    87                              <1> 	jne	%%ne
    88                              <1> 	dec	ecx
    89                              <1> 	jnz	%%loop
    90                              <1> 	jmp	%%done
    91                              <1> %%ne:	dec	ecx
    92                              <1> 	jecxz	%%cxz
    93                              <1> 	jmp	%%done
    94                              <1> %%cxz:	cmp	cl,1
    95                              <1> %%done:
    96                              <1> %endm
    97                              <1> 
    98                              <1> %endif
    99                              <1> 
   100                              <1> 
   101                              <1> ;
   102                              <1> ; format of the BYTE initialization table:  address, byte
   103                              <1> ;
   104                              <1> %imacro  binit 2
   105                              <1>         dw      %1
   106                              <1>         db      %2
   107                              <1> %endmacro
   108                              <1> ; end with DW -1
   109                              <1> 
   110                              <1> ;
   111                              <1> ; format of the WORD initialization table:  address, word
   112                              <1> ;
   113                              <1> %imacro  winit 2
   114                              <1>         dw      %1
   115                              <1>         dw      %2
   116                              <1> %endmacro
   117                              <1> ; end with DW -1
   118                              <1> 
   119                              <1> 
   120                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   121                              <1> %imacro get_bda	1.nolist
   122                              <1> 	push	0x0040
   123                              <1> 	pop	%1
   124                              <1> 	cnop
   125                              <1> %endm
   126                              <1> 
   127                              <1> 
   128                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   129                              <1> %imacro	get_loc0 1.nolist
   130                              <1> 	push	0x0000
   131                              <1> 	pop	%1
   132                              <1> 	cnop
   133                              <1> %endm
   134                              <1> 
   135                              <1> 
   136                              <1> 
   137                              <1> %imacro setloc  1.nolist
   138                              <1>  times   (%1-($-$$)) db 0FFh
   139                              <1> %endm
   140                              <1> 
   141                              <1> %imacro db_lo   1
   142                              <1>  db (%1)&255
   143                              <1> %endm
   144                              <1> 
   145                              <1> %imacro cnop    0.nolist
   146                              <1> %ifdef SOFT_DEBUG
   147                              <1> %if SOFT_DEBUG
   148                              <1>         nop
   149                              <1> %endif
   150                              <1> %endif
   151                              <1> %endm
   152                              <1> 
   153                              <1> %imacro popm 1-*.nolist
   154                              <1> %rep %0
   155                              <1> %ifidni %1,ALL
   156                              <1>  popa
   157                              <1> %elifidni %1,F
   158                              <1>  popf
   159                              <1> %else
   160                              <1>  pop %1
   161                              <1> %ifidni %1,DS
   162                              <1>  cnop
   163                              <1> %elifidni %1,ES
   164                              <1>  cnop
   165                              <1> %elifidni %1,FS
   166                              <1>  cnop
   167                              <1> %elifidni %1,GS
   168                              <1>  cnop
   169                              <1> %endif
   170                              <1> %endif
   171                              <1> %rotate 1
   172                              <1> %endrep
   173                              <1> %endm
   174                              <1> 
   175                              <1> %imacro pushm 1-*.nolist
   176                              <1> %rep %0
   177                              <1> %rotate -1
   178                              <1> %ifidni %1,ALL
   179                              <1>  pusha
   180                              <1> %elifidni %1,F
   181                              <1>  pushf
   182                              <1> %else
   183                              <1>  push %1
   184                              <1> %endif
   185                              <1> %endrep
   186                              <1> %endm
   187                              <1> 
   188                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   189                              <1> %assign __size__ (%2-1)	| 0xFF
   190                              <1> %if (__size__ <= 0xFFFF)
   191                              <1> %assign __gran__ 0
   192                              <1> %else
   193                              <1> %assign __gran__ 0xC0			; G B 0 0
   194                              <1> %endif
   195                              <1> %assign __expand__ 0
   196                              <1> %if %0==3
   197                              <1> %if %3
   198                              <1> %assign __expand__ 4
   199                              <1> %endif
   200                              <1> %endif
   201                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   202                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   203                              <1> %endm
   204                              <1> 
   205                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   206                              <1> %assign __size__ (%2-1)	| 0xFF
   207                              <1> %if (__size__ <= 0xFFFF)
   208                              <1> %assign __gran__ 0
   209                              <1> %else
   210                              <1> %assign __gran__ 0xC0			; G D 0 0
   211                              <1> %endif
   212                              <1> %assign __conform__ 0
   213                              <1> %if %0==3
   214                              <1> %if %3
   215                              <1> %assign __conform__ 4
   216                              <1> %endif
   217                              <1> %endif
   218                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   219                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   220                              <1> %endm
   221                              <1> 
   222                              <1> ;/* End of macro.inc */
    27                                  
    28                                  	global	int_17h
    29                                  
    30                                  segment	_TEXT
    31                                  
    32                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    33                                  ; INT 17h -- printer
    34                                  ;
    35                                  ;    Function		Usage
    36                                  ;    ========		=====
    37                                  ;	00	print the character in AL on printer DX
    38                                  ;	01	initialise printer DX
    39                                  ;	02	read the status of printer DX
    40                                  ;
    41                                  ;  All three return the printer status in AH.
    42                                  ;
    43                                  ; This board has no parallel port.  What matters is that the answer is a
    44                                  ; well-formed status rather than the invalid-command return: DOS probes
    45                                  ; LPT at startup, and a carry with AH=01 there reads as "function not
    46                                  ; supported", which is a different thing from "no printer" and does not
    47                                  ; always end the probe.
    48                                  ;
    49                                  ; The status returned is TIMEOUT (bit 0) with SELECTED (bit 4) clear --
    50                                  ; the unambiguous "nothing answered" that a retry loop terminates on.
    51                                  ; bda.parallel_dev[] stays zero, so DOS should not get this far anyway.
    52                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    53                                  PRN_TIMEOUT	equ	0x01		; bit 0: operation timed out
    54                                  
    55                                  int_17h:
    56 00000000 FB                      	sti
    57 00000001 80FC02                  	cmp	ah,2
    58 00000004 7706                    	ja	.bad
    59                                  
    60 00000006 B401                    	mov	ah,PRN_TIMEOUT		; no printer ever answers
    61 00000008 F8                      	clc
    62 00000009 CA0200                  	retf	2			; an INT handler returns FAR, and the
    63                                  					;  caller's flags must be discarded
    64                                  
    65                                  .bad:
    66 0000000C B401                    	mov	ah,PRN_TIMEOUT
    67 0000000E F9                      	stc
    68 0000000F CA0200                  	retf	2
