    55                              <1> ;/* i386EX.inc  --  register definitions for the Intel 80386EX processor
    56                              <1> ;
    57                              <1> %define defb
    58                              <1> %define defw
    59                              <1> %define defd
    60                              <1> ;*/
    61                              <1> 
    62                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    63                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    64                              <1> ;*  first thing it does, so anything that restarts the board in software has
    65                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    66                              <1> ;*  hard way.
    67                              <1> ;*/
    68                              <1> defw    DEVICE_ID equ   0x2309
    69                              <1> 
    70                              <1> ;/* The Address Configuration register
    71                              <1> ;*/
    72                              <1> defb REMAPCFGH  equ     0x0023
    73                              <1> defb REMAPCFGL  equ     0x0022
    74                              <1> defw REMAPCFG   equ     0x0022
    75                              <1> 
    76                              <1> ;/* The A20gate and fast CPU Reset
    77                              <1> ;*/
    78                              <1> defb PORT92     equ     0xF092
    79                              <1> defb PORT92_AT  equ     0x0092
    80                              <1> 
    81                              <1> ;
    82                              <1> ;/* The DMA Controller and Bus Arbiter
    83                              <1> ;*/
    84                              <1> defb DMA0TAR    equ     0xF000
    85                              <1> defb DMA0TAR_AT equ     0x0000
    86                              <1> defb DMA0BYC    equ     0xF001
    87                              <1> defb DMA0BYC_AT equ     0x0001
    88                              <1> defb DMA1TAR    equ     0xF002
    89                              <1> defb DMA1TAR_AT equ     0x0002
    90                              <1> defb DMA1BYC    equ     0xF003
    91                              <1> defb DMA1BYC_AT equ     0x0003
    92                              <1> defb DMACMD1    equ     0xF008
    93                              <1> defb DMACMD1_AT equ     0x0008
    94                              <1> defb DMASTS     equ     0xF008
    95                              <1> defb DMASTS_AT  equ     0x0008
    96                              <1> defb DMASRR     equ     0xF009
    97                              <1> defb DMASRR_AT  equ     0x0009
    98                              <1> defb DMAMSK     equ     0xF00A
    99                              <1> defb DMAMSK_AT  equ     0x000A
   100                              <1> defb DMAMOD1    equ     0xF00B
   101                              <1> defb DMAMOD1_AT equ     0x000B
   102                              <1> defb DMACLRBP   equ     0xF00C
   103                              <1> defb DMACLRBP_AT equ    0x000C
   104                              <1> defb DMACLR     equ     0xF00D
   105                              <1> defb DMACLR_AT  equ     0x000D
   106                              <1> defb DMACLRMSK  equ     0xF00E
   107                              <1> defb DMACLRMSK_AT equ   0x000E
   108                              <1> defb DMAGRPMSK  equ     0xF00F
   109                              <1> defb DMAGRPMSK_AT equ   0x000F
   110                              <1> defb DMA0REQ0_1 equ     0xF010
   111                              <1> defb DMA0REQ2_3 equ     0xF011
   112                              <1> defb DMA1REQ0_1 equ     0xF012
   113                              <1> defb DMA1REQ2_3 equ     0xF013
   114                              <1> defb DMABSR     equ     0xF018
   115                              <1> defb DMACHR     equ     0xF019
   116                              <1> defb DMAIS      equ     0xF019
   117                              <1> defb DMACMD2    equ     0xF01A
   118                              <1> defb DMAMOD2    equ     0xF01B
   119                              <1> defb DMAIEN     equ     0xF01C
   120                              <1> defb DMAOVFE    equ     0xF01D
   121                              <1> defb DMACLRTC   equ     0xF01E
   122                              <1> ;
   123                              <1> ;/* The DMA Page Registers
   124                              <1> ;*/
   125                              <1> defb DMA1TAR2    equ    0xF083
   126                              <1> defb DMA1TAR2_AT equ    0x0083
   127                              <1> defb DMA1TAR3    equ    0xF085
   128                              <1> defb DMA1TAR3_AT equ    0x0085
   129                              <1> defb DMA0TAR3    equ    0xF086
   130                              <1> defb DMA0TAR3_AT equ    0x0086
   131                              <1> defb DMA0TAR2    equ    0xF087
   132                              <1> defb DMA0TAR2_AT equ    0x0087
   133                              <1> ;
   134                              <1> defb DMA0BYC2   equ     0xF098
   135                              <1> defb DMA1BYC2   equ     0xF099
   136                              <1> 
   137                              <1> ;
   138                              <1> ;/* The Master Interrupt Controller
   139                              <1> ;*/
   140                              <1> defb ICW1M_AT   equ     0x0020
   141                              <1> defb ICW2M_AT   equ     0x0021
   142                              <1> defb ICW3M_AT   equ     0x0021
   143                              <1> defb ICW4M_AT   equ     0x0021
   144                              <1> defb OCW1M_AT   equ     0x0021
   145                              <1> defb OCW2M_AT   equ     0x0020
   146                              <1> defb OCW3M_AT   equ     0x0020
   147                              <1> 
   148                              <1> defb ICW1M      equ     0xF020
   149                              <1> defb ICW2M      equ     0xF021
   150                              <1> defb ICW3M      equ     0xF021
   151                              <1> defb ICW4M      equ     0xF021
   152                              <1> defb OCW1M      equ     0xF021
   153                              <1> defb OCW2M      equ     0xF020
   154                              <1> defb OCW3M      equ     0xF020
   155                              <1> defb IRR_M	equ	0xF020
   156                              <1> 
   157                              <1> ;
   158                              <1> ;/* The Slave Interrupt Controller
   159                              <1> ;*/
   160                              <1> defb ICW1S_AT   equ     0x00A0
   161                              <1> defb ICW2S_AT   equ     0x00A1
   162                              <1> defb ICW3S_AT   equ     0x00A1
   163                              <1> defb ICW4S_AT   equ     0x00A1
   164                              <1> defb OCW1S_AT   equ     0x00A1
   165                              <1> defb OCW2S_AT   equ     0x00A0
   166                              <1> defb OCW3S_AT   equ     0x00A0
   167                              <1> defb IRR_M_AT	equ	0x00A0
   168                              <1> 
   169                              <1> defb ICW1S      equ     0xF0A0
   170                              <1> defb ICW2S      equ     0xF0A1
   171                              <1> defb ICW3S      equ     0xF0A1
   172                              <1> defb ICW4S      equ     0xF0A1
   173                              <1> defb OCW1S      equ     0xF0A1
   174                              <1> defb OCW2S      equ     0xF0A0
   175                              <1> defb OCW3S      equ     0xF0A0
   176                              <1> 
   177                              <1> ;
   178                              <1> ;/* The Timer/Counter Unit
   179                              <1> ;*/
   180                              <1> defb    TMR0    equ     0xF040
   181                              <1> defb    TMR0_AT equ     0x0040
   182                              <1> defb    TMR1    equ     0xF041
   183                              <1> defb    TMR1_AT equ     0x0041
   184                              <1> defb    TMR2    equ     0xF042
   185                              <1> defb    TMR2_AT equ     0x0042
   186                              <1> defb    TMRCON  equ     0xF043
   187                              <1> defb    TMRCON_AT  equ  0x0043
   188                              <1> 
   189                              <1> ;
   190                              <1> ;/* The Chip Select Unit
   191                              <1> ;*/
   192                              <1> defw    CS0ADL  equ     0xF400
   193                              <1> defw    CS0ADH  equ     0xF402
   194                              <1> defw    CS0MSKL equ     0xF404
   195                              <1> defw    CS0MSKH equ     0xF406
   196                              <1> defw    CS1ADL  equ     0xF408
   197                              <1> defw    CS1ADH  equ     0xF40A
   198                              <1> defw    CS1MSKL equ     0xF40C
   199                              <1> defw    CS1MSKH equ     0xF40E
   200                              <1> defw    CS2ADL  equ     0xF410
   201                              <1> defw    CS2ADH  equ     0xF412
   202                              <1> defw    CS2MSKL equ     0xF414
   203                              <1> defw    CS2MSKH equ     0xF416
   204                              <1> defw    CS3ADL  equ     0xF418
   205                              <1> defw    CS3ADH  equ     0xF41A
   206                              <1> defw    CS3MSKL equ     0xF41C
   207                              <1> defw    CS3MSKH equ     0xF41E
   208                              <1> defw    CS4ADL  equ     0xF420
   209                              <1> defw    CS4ADH  equ     0xF422
   210                              <1> defw    CS4MSKL equ     0xF424
   211                              <1> defw    CS4MSKH equ     0xF426
   212                              <1> defw    CS5ADL  equ     0xF428
   213                              <1> defw    CS5ADH  equ     0xF42A
   214                              <1> defw    CS5MSKL equ     0xF42C
   215                              <1> defw    CS5MSKH equ     0xF42E
   216                              <1> defw    CS6ADL  equ     0xF430
   217                              <1> defw    CS6ADH  equ     0xF432
   218                              <1> defw    CS6MSKL equ     0xF434
   219                              <1> defw    CS6MSKH equ     0xF436
   220                              <1> defw    UCSADL  equ     0xF438
   221                              <1> defw    UCSADH  equ     0xF43A
   222                              <1> defw    UCSMSKL equ     0xF43C
   223                              <1> defw    UCSMSKH equ     0xF43E
   224                              <1> 
   225                              <1> ;
   226                              <1> ;/* The Synchronous Serial I/O Unit
   227                              <1> ;*/
   228                              <1> defw    SSIOTBUF equ    0xF480
   229                              <1> defw    SSIORBUF equ    0xF482
   230                              <1> defw    SSIOBAUD equ    0xF484
   231                              <1> defw    SSIOCON1 equ    0xF486
   232                              <1> defw    SSIOCON2 equ    0xF488
   233                              <1> defw    SSIOCTR  equ    0xF48A
   234                              <1> 
   235                              <1> ;
   236                              <1> ;/* The Refresh Control Unit
   237                              <1> ;*/
   238                              <1> defw    RFSBAD  equ     0xF4A0
   239                              <1> defw    RFSCIR  equ     0xF4A2
   240                              <1> defw    RFSCON  equ     0xF4A4
   241                              <1> defw    RFSADD  equ     0xF4A6
   242                              <1> 
   243                              <1> ;
   244                              <1> ;/* The Watchdog Timer Unit
   245                              <1> ;*/
   246                              <1> defw    WDTRLDH equ     0xF4C0
   247                              <1> defw    WDTRLDL equ     0xF4C2
   248                              <1> defw    WDTCNTH equ     0xF4C4
   249                              <1> defw    WDTCNTL equ     0xF4C6
   250                              <1> defw    WDTCLR  equ     0xF4C8
   251                              <1> defb    WDTSTATUS  equ  0xF4CA
   252                              <1> 
   253                              <1> ;
   254                              <1> ;/* Clock Generation and Power Management
   255                              <1> ;*/
   256                              <1> defb    PWRCON  equ     0xF800
   257                              <1> defw    CLKPRS  equ     0xF804
   258                              <1> 
   259                              <1> ;
   260                              <1> ;/* Device Configuration Registers
   261                              <1> ;*/
   262                              <1> defb    P1CFG   equ     0xF820
   263                              <1> defb    P2CFG   equ     0xF822
   264                              <1> defb    P3CFG   equ     0xF824
   265                              <1> defb    PINCFG  equ     0xF826
   266                              <1> defb    DMACFG  equ     0xF830
   267                              <1> defb    INTCFG  equ     0xF832
   268                              <1> defb    TMRCFG  equ     0xF834
   269                              <1> defb    SIOCFG  equ     0xF836
   270                              <1> 
   271                              <1> ;
   272                              <1> ;/* Parallel I/O Ports
   273                              <1> ;*/
   274                              <1> defb    P1PIN   equ     0xF860
   275                              <1> defb    P1LTC   equ     0xF862
   276                              <1> defb    P1DIR   equ     0xF864
   277                              <1> defb    P2PIN   equ     0xF868
   278                              <1> defb    P2LTC   equ     0xF86A
   279                              <1> defb    P2DIR   equ     0xF86C
   280                              <1> defb    P3PIN   equ     0xF870
   281                              <1> defb    P3LTC   equ     0xF872
   282                              <1> defb    P3DIR   equ     0xF874
   283                              <1> 
   284                              <1> 
   285                              <1> ; bits.inc
   286                              <1> ;
   287                              <1> ; assembly language bit definitions
   288                              <1> ;
   289                              <1> defb    BIT0    equ     0x01
   290                              <1> defb    BIT1    equ     0x02
   291                              <1> defb    BIT2    equ     0x04
   292                              <1> defb    BIT3    equ     0x08
   293                              <1> defb    BIT4    equ     0x10
   294                              <1> defb    BIT5    equ     0x20
   295                              <1> defb    BIT6    equ     0x40
   296                              <1> defb    BIT7    equ     0x80
   297                              <1> 
   298                              <1> defw    BIT8    equ     0x0100
   299                              <1> defw    BIT9    equ     0x0200
   300                              <1> defw    BIT10   equ     0x0400
   301                              <1> defw    BIT11   equ     0x0800
