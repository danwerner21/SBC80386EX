   407                              <1> defb	MSR_DCD	equ	BIT7
   408                              <1> defb	MSR_RI 	equ	BIT6
   409                              <1> defb	MSR_DSR	equ	BIT5
   410                              <1> defb	MSR_CTS	equ	BIT4
   411                              <1> defb	MSR_deltaDCD	equ	BIT3
   412                              <1> defb	MSR_deltaRI	equ	BIT2
   413                              <1> defb	MSR_deltaDSR	equ	BIT1
   414                              <1> defb	MSR_deltaCTS	equ	BIT0
   415                              <1> 
   416                              <1> ;/* Bits in CR0
   417                              <1> ;*/
   418                              <1> defb    CR0_PE  equ     BIT0
   419                              <1> defb    CR0_MP  equ     BIT1
   420                              <1> defb    CR0_EM  equ     BIT2
   421                              <1> defb    CR0_TS  equ     BIT3
   422                              <1> defd    CR0_WP  equ     BIT16
   423                              <1> defd    CR0_PG  equ     BIT31
   424                              <1> 
   425                              <1> ;/* Some ASCII character codes
   426                              <1> ;*/
   427                              <1> defb    ASCII_NUL       equ     0x00
   428                              <1> defb    ASCII_BS        equ     0x08
   429                              <1> defb    ASCII_HT        equ     0x09
   430                              <1> defb    ASCII_LF        equ     0x0A
   431                              <1> defb    ASCII_NL        equ     0x0A
   432                              <1> defb    ASCII_FF        equ     0x0C
   433                              <1> defb    ASCII_CR        equ     0x0D
   434                              <1> defb	ASCII_ESC	equ	0x1B
   435                              <1> defb    ASCII_SP        equ     0x20
   436                              <1> defb    ASCII_DEL       equ     0x7F
   437                              <1> defb	ASCII_RUB	equ	0xFF
   438                              <1> 
   439                              <1> 
   440                              <1> ;/* End of i386EX.inc */
    31                                  %include "macro.inc"
    32                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    33                              <1> ;
    34                              <1> ; some useful macros:
    35                              <1> ;
    36                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    37                              <1> %define NREPEAT 0
    38                              <1> 
    39                              <1> %if NREPEAT
    40                              <1> 
    41                              <1> %macro	rep	1
    42                              <1> %%loop:	%1
    43                              <1> 	dec	cx
    44                              <1> 	jnz	%%loop
    45                              <1> %endm
    46                              <1> 
    47                              <1> %macro	repne	1
    48                              <1> %%loop:	%1
    49                              <1> 	je	%%e
    50                              <1> 	dec	cx
    51                              <1> 	jnz	%%loop
    52                              <1> 	cmp	cx,1
    53                              <1> 	jmp	%%done
    54                              <1> %%e:	dec	cx
    55                              <1> 	cmp	cx,cx
    56                              <1> %%done:
    57                              <1> %endm
    58                              <1> 
    59                              <1> %macro	repe	1
    60                              <1> %%loop:	%1
    61                              <1> 	jne	%%ne
    62                              <1> 	dec	cx
    63                              <1> 	jnz	%%loop
    64                              <1> 	jmp	%%done
    65                              <1> %%ne:	dec	cx
    66                              <1> 	jcxz	%%cxz
    67                              <1> 	jmp	%%done
    68                              <1> %%cxz:	cmp	cx,1
    69                              <1> %%done:
    70                              <1> %endm
    71                              <1> 
    72                              <1> %macro	REP	1
    73                              <1> %%loop:	%1
    74                              <1> 	dec	ecx
    75                              <1> 	jnz	%%loop
    76                              <1> %endm
    77                              <1> 
    78                              <1> %macro	REPNE	1
    79                              <1> %%loop:	%1
    80                              <1> 	je	%%e
    81                              <1> 	dec	ecx
    82                              <1> 	jnz	%%loop
    83                              <1> 	cmp	cl,1
    84                              <1> 	jmp	%%done
    85                              <1> %%e:	dec	ecx
    86                              <1> 	cmp	cl,cl
    87                              <1> %%done:
    88                              <1> %endm
    89                              <1> 
    90                              <1> %macro	REPE	1
    91                              <1> %%loop:	%1
    92                              <1> 	jne	%%ne
    93                              <1> 	dec	ecx
    94                              <1> 	jnz	%%loop
    95                              <1> 	jmp	%%done
    96                              <1> %%ne:	dec	ecx
    97                              <1> 	jecxz	%%cxz
    98                              <1> 	jmp	%%done
    99                              <1> %%cxz:	cmp	cl,1
   100                              <1> %%done:
   101                              <1> %endm
   102                              <1> 
   103                              <1> %endif
   104                              <1> 
   105                              <1> 
   106                              <1> ;
   107                              <1> ; format of the BYTE initialization table:  address, byte
   108                              <1> ;
   109                              <1> %imacro  binit 2
   110                              <1>         dw      %1
   111                              <1>         db      %2
   112                              <1> %endmacro
   113                              <1> ; end with DW -1
   114                              <1> 
   115                              <1> ;
   116                              <1> ; format of the WORD initialization table:  address, word
   117                              <1> ;
   118                              <1> %imacro  winit 2
   119                              <1>         dw      %1
   120                              <1>         dw      %2
   121                              <1> %endmacro
   122                              <1> ; end with DW -1
   123                              <1> 
   124                              <1> 
   125                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   126                              <1> %imacro get_bda	1.nolist
   127                              <1> 	push	0x0040
   128                              <1> 	pop	%1
   129                              <1> 	cnop
   130                              <1> %endm
   131                              <1> 
   132                              <1> 
   133                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   134                              <1> %imacro	get_loc0 1.nolist
   135                              <1> 	push	0x0000
   136                              <1> 	pop	%1
   137                              <1> 	cnop
   138                              <1> %endm
   139                              <1> 
   140                              <1> 
   141                              <1> 
   142                              <1> %imacro setloc  1.nolist
   143                              <1>  times   (%1-($-$$)) db 0FFh
   144                              <1> %endm
   145                              <1> 
   146                              <1> %imacro db_lo   1
   147                              <1>  db (%1)&255
   148                              <1> %endm
   149                              <1> 
   150                              <1> %imacro cnop    0.nolist
   151                              <1> %ifdef SOFT_DEBUG
   152                              <1> %if SOFT_DEBUG
   153                              <1>         nop
   154                              <1> %endif
   155                              <1> %endif
   156                              <1> %endm
   157                              <1> 
   158                              <1> %imacro popm 1-*.nolist
   159                              <1> %rep %0
   160                              <1> %ifidni %1,ALL
   161                              <1>  popa
   162                              <1> %elifidni %1,F
   163                              <1>  popf
   164                              <1> %else
   165                              <1>  pop %1
   166                              <1> %ifidni %1,DS
   167                              <1>  cnop
   168                              <1> %elifidni %1,ES
   169                              <1>  cnop
   170                              <1> %elifidni %1,FS
   171                              <1>  cnop
   172                              <1> %elifidni %1,GS
   173                              <1>  cnop
   174                              <1> %endif
   175                              <1> %endif
   176                              <1> %rotate 1
   177                              <1> %endrep
   178                              <1> %endm
   179                              <1> 
   180                              <1> %imacro pushm 1-*.nolist
   181                              <1> %rep %0
   182                              <1> %rotate -1
   183                              <1> %ifidni %1,ALL
   184                              <1>  pusha
   185                              <1> %elifidni %1,F
   186                              <1>  pushf
   187                              <1> %else
   188                              <1>  push %1
   189                              <1> %endif
   190                              <1> %endrep
   191                              <1> %endm
   192                              <1> 
   193                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   194                              <1> %assign __size__ (%2-1)	| 0xFF
   195                              <1> %if (__size__ <= 0xFFFF)
   196                              <1> %assign __gran__ 0
   197                              <1> %else
   198                              <1> %assign __gran__ 0xC0			; G B 0 0
   199                              <1> %endif
   200                              <1> %assign __expand__ 0
   201                              <1> %if %0==3
   202                              <1> %if %3
   203                              <1> %assign __expand__ 4
   204                              <1> %endif
   205                              <1> %endif
   206                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   207                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   208                              <1> %endm
   209                              <1> 
   210                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   211                              <1> %assign __size__ (%2-1)	| 0xFF
   212                              <1> %if (__size__ <= 0xFFFF)
   213                              <1> %assign __gran__ 0
   214                              <1> %else
   215                              <1> %assign __gran__ 0xC0			; G D 0 0
   216                              <1> %endif
   217                              <1> %assign __conform__ 0
   218                              <1> %if %0==3
   219                              <1> %if %3
   220                              <1> %assign __conform__ 4
   221                              <1> %endif
   222                              <1> %endif
   223                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   224                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   225                              <1> %endm
   226                              <1> 
   227                              <1> ;/* End of macro.inc */
    32                                  ; ASCII_CR and ASCII_LF come from i386EX.inc -- "ascii.h" is a C
    33                                  ; header and NASM cannot read it
    34                                  
    35                                  	global	int_19h
    36                                  
    37                                  segment	_TEXT
    38                                  
    39                                  BOOT_SEG	equ	0x0000		; the boot sector is loaded and entered
    40                                  BOOT_OFF	equ	0x7C00		;  at 0000:7C00, by long convention
    41                                  BOOT_DRIVE	equ	0x80		; first fixed disk
    42                                  BOOT_RETRIES	equ	4		; as the PC/AT did
    43                                  
    44                                  
    45                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    46                                  ; INT 19h -- Bootstrap Loader
    47                                  ;
    48                                  ; Read cylinder 0, head 0, sector 1 of drive 80h into 0000:7C00, check
    49                                  ; that it ends in AA55h, and enter it.
    50                                  ;
    51                                  ; This call does not return.  It replaces the stack it was entered on,
    52                                  ; because the boot sector is entitled to assume nothing about whatever
    53                                  ; POST was using -- and on this board POST's stack lives up in the SRAM
    54                                  ; at A800:xxxx, which is no use to anything that follows.
    55                                  ;
    56                                  ;  Hands control over with:
    57                                  ;	CS:IP	0000:7C00
    58                                  ;	DL	80h, the drive it was read from
    59                                  ;	DS,ES	0000
    60                                  ;	SS:SP	0000:7C00, growing down away from the sector
    61                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    62                                  int_19h:
    63 00000000 FA                      	cli
    64 00000001 31C0                    	xor	ax,ax
    65 00000003 8ED0                    	mov	ss,ax			; the stack the boot sector expects:
    66                                  	cnop
    67 00000005 BC007C                  	mov	sp,BOOT_OFF		;  0000:7C00, growing downward
    68 00000008 8ED8                    	mov	ds,ax
    69                                  	cnop
    70 0000000A 8EC0                    	mov	es,ax
    71                                  	cnop
    72 0000000C FB                      	sti
    73 0000000D FC                      	cld
    74                                  
    75                                  ; Clear the boot location first.  A read that fails part way through, or
    76                                  ; a drive that returns short, must not be able to leave anything
    77                                  ; executable sitting there from an earlier attempt.
    78 0000000E BF007C                  	mov	di,BOOT_OFF
    79 00000011 B90001                  	mov	cx,256			; 256 words == one sector
    80 00000014 F3AB                    	rep	stosw			; AX is still zero
    81                                  
    82 00000016 B90400                  	mov	cx,BOOT_RETRIES
    83                                  .retry:
    84 00000019 51                      	push	cx
    85                                  
    86                                  ; Reset first.  On this BIOS that also puts the drives back into 8-bit
    87                                  ; PIO after the soft reset -- see fn00 in 13h_disk.asm.
    88 0000001A B400                    	mov	ah,0
    89 0000001C B280                    	mov	dl,BOOT_DRIVE
    90 0000001E CD13                    	int	0x13
    91 00000020 7215                    	jc	.again
    92                                  
    93 00000022 B80102                  	mov	ax,0x0201		; read, one sector
    94 00000025 B90100                  	mov	cx,0x0001		; cylinder 0, sector 1
    95 00000028 B600                    	mov	dh,0			; head 0
    96 0000002A B280                    	mov	dl,BOOT_DRIVE
    97 0000002C 31DB                    	xor	bx,bx
    98 0000002E 8EC3                    	mov	es,bx			; ES:BX = 0000:7C00
    99                                  	cnop
   100 00000030 BB007C                  	mov	bx,BOOT_OFF
   101 00000033 CD13                    	int	0x13
   102 00000035 7308                    	jnc	.loaded
   103                                  
   104                                  .again:
   105 00000037 59                      	pop	cx
   106 00000038 E2DF                    	loop	.retry
   107 0000003A BE[9E00]                	mov	si,msg_noread
   108 0000003D EB0C                    	jmp	short .give_up
   109                                  
   110                                  .loaded:
   111 0000003F 59                      	pop	cx
   112                                  
   113                                  ; The last two bytes of a bootable sector are AA55h.  Without this test
   114                                  ; a blank or data-only disk would be executed as code.
   115 00000040 813EFE7D55AA            	cmp	word [BOOT_OFF+510],0xAA55
   116 00000046 740B                    	je	.enter
   117                                  
   118 00000048 BE[C700]                	mov	si,msg_nosig
   119                                  
   120                                  .give_up:
   121 0000004B E81800                  	call	boot_msg
   122                                  ; INT 18h is where the PC/AT went when nothing would boot.  It is still
   123                                  ; a stub here, so if it returns there is nothing further to try.
   124 0000004E CD18                    	int	0x18
   125                                  .hang:
   126 00000050 F4                      	hlt
   127 00000051 EBFD                    	jmp	.hang
   128                                  
   129                                  .enter:
   130 00000053 BE[7F00]                	mov	si,msg_booting
   131 00000056 E80D00                  	call	boot_msg
   132                                  
   133 00000059 B280                    	mov	dl,BOOT_DRIVE		; the sector is told where it came from
   134 0000005B 31C0                    	xor	ax,ax
   135 0000005D 8ED8                    	mov	ds,ax
   136                                  	cnop
   137 0000005F 8EC0                    	mov	es,ax
   138                                  	cnop
   139 00000061 EA007C0000              	jmp	BOOT_SEG:BOOT_OFF
   140                                  
   141                                  
   142                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   143                                  ; boot_msg -- write the ASCIIZ string at CS:SI to the serial console
   144                                  ;
   145                                  ; The CS override matters: by the time this runs DS has been set to zero
   146                                  ; for the boot sector, while the strings are still up in the ROM.
   147                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   148                                  boot_msg:
   149 00000066 5652515350              	pushm	ax,bx,cx,dx,si
   150                                  .1:
   151 0000006B 2EAC                       cs	lodsb
   152 0000006D 08C0                    	or	al,al
   153 0000006F 7408                    	jz	.9
   154 00000071 B401                    	mov	ah,1			; write character
   155 00000073 31D2                    	xor	dx,dx			; COM1
   156 00000075 CD14                    	int	0x14
   157 00000077 EBF2                    	jmp	.1
   158                                  .9:
   159 00000079 585B595A5E              	popm	ax,bx,cx,dx,si
   160 0000007E C3                      	ret
   161                                  
   162                                  
   163                                  msg_booting:
   164 0000007F 0D0A426F6F74696E67-     	db	ASCII_CR,ASCII_LF,"Booting from drive 80h ...",ASCII_CR,ASCII_LF,0
   164 00000088 2066726F6D20647269-
   164 00000091 766520383068202E2E-
   164 0000009A 2E0D0A00           
   165                                  msg_noread:
   166 0000009E 0D0A494E5420313968-     	db	ASCII_CR,ASCII_LF,"INT 19h: cannot read the boot sector",ASCII_CR,ASCII_LF,0
   166 000000A7 3A2063616E6E6F7420-
   166 000000B0 726561642074686520-
   166 000000B9 626F6F742073656374-
   166 000000C2 6F720D0A00         
   167                                  msg_nosig:
   168 000000C7 0D0A494E5420313968-     	db	ASCII_CR,ASCII_LF,"INT 19h: no AA55h signature -- not bootable",ASCII_CR,ASCII_LF,0
   168 000000D0 3A206E6F2041413535-
   168 000000D9 68207369676E617475-
   168 000000E2 7265202D2D206E6F74-
   168 000000EB 20626F6F7461626C65-
   168 000000F4 0D0A00             
