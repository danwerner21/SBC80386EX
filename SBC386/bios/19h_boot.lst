    31                                  %include "macro.inc"
    32                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    33                              <1> ;
    34                              <1> ; some useful macros:
    35                              <1> ;
    36                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    37                              <1> %define NREPEAT 0
    38                              <1> 
    39                              <1> %if NREPEAT
    40                              <1> 
    41                              <1> %macro	rep	1
    42                              <1> %%loop:	%1
    43                              <1> 	dec	cx
    44                              <1> 	jnz	%%loop
    45                              <1> %endm
    46                              <1> 
    47                              <1> %macro	repne	1
    48                              <1> %%loop:	%1
    49                              <1> 	je	%%e
    50                              <1> 	dec	cx
    51                              <1> 	jnz	%%loop
    52                              <1> 	cmp	cx,1
    53                              <1> 	jmp	%%done
    54                              <1> %%e:	dec	cx
    55                              <1> 	cmp	cx,cx
    56                              <1> %%done:
    57                              <1> %endm
    58                              <1> 
    59                              <1> %macro	repe	1
    60                              <1> %%loop:	%1
    61                              <1> 	jne	%%ne
    62                              <1> 	dec	cx
    63                              <1> 	jnz	%%loop
    64                              <1> 	jmp	%%done
    65                              <1> %%ne:	dec	cx
    66                              <1> 	jcxz	%%cxz
    67                              <1> 	jmp	%%done
    68                              <1> %%cxz:	cmp	cx,1
    69                              <1> %%done:
    70                              <1> %endm
    71                              <1> 
    72                              <1> %macro	REP	1
    73                              <1> %%loop:	%1
    74                              <1> 	dec	ecx
    75                              <1> 	jnz	%%loop
    76                              <1> %endm
    77                              <1> 
    78                              <1> %macro	REPNE	1
    79                              <1> %%loop:	%1
    80                              <1> 	je	%%e
    81                              <1> 	dec	ecx
    82                              <1> 	jnz	%%loop
    83                              <1> 	cmp	cl,1
    84                              <1> 	jmp	%%done
    85                              <1> %%e:	dec	ecx
    86                              <1> 	cmp	cl,cl
    87                              <1> %%done:
    88                              <1> %endm
    89                              <1> 
    90                              <1> %macro	REPE	1
    91                              <1> %%loop:	%1
    92                              <1> 	jne	%%ne
    93                              <1> 	dec	ecx
    94                              <1> 	jnz	%%loop
    95                              <1> 	jmp	%%done
    96                              <1> %%ne:	dec	ecx
    97                              <1> 	jecxz	%%cxz
    98                              <1> 	jmp	%%done
    99                              <1> %%cxz:	cmp	cl,1
   100                              <1> %%done:
   101                              <1> %endm
   102                              <1> 
   103                              <1> %endif
   104                              <1> 
   105                              <1> 
   106                              <1> ;
   107                              <1> ; format of the BYTE initialization table:  address, byte
   108                              <1> ;
   109                              <1> %imacro  binit 2
   110                              <1>         dw      %1
   111                              <1>         db      %2
   112                              <1> %endmacro
   113                              <1> ; end with DW -1
   114                              <1> 
   115                              <1> ;
   116                              <1> ; format of the WORD initialization table:  address, word
   117                              <1> ;
   118                              <1> %imacro  winit 2
   119                              <1>         dw      %1
   120                              <1>         dw      %2
   121                              <1> %endmacro
   122                              <1> ; end with DW -1
   123                              <1> 
   124                              <1> 
   125                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   126                              <1> %imacro get_bda	1.nolist
   127                              <1> 	push	0x0040
   128                              <1> 	pop	%1
   129                              <1> 	cnop
   130                              <1> %endm
   131                              <1> 
   132                              <1> 
   133                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   134                              <1> %imacro	get_loc0 1.nolist
   135                              <1> 	push	0x0000
   136                              <1> 	pop	%1
   137                              <1> 	cnop
   138                              <1> %endm
   139                              <1> 
   140                              <1> 
   141                              <1> 
   142                              <1> %imacro setloc  1.nolist
   143                              <1>  times   (%1-($-$$)) db 0FFh
   144                              <1> %endm
   145                              <1> 
   146                              <1> %imacro db_lo   1
   147                              <1>  db (%1)&255
   148                              <1> %endm
   149                              <1> 
   150                              <1> %imacro cnop    0.nolist
   151                              <1> %ifdef SOFT_DEBUG
   152                              <1> %if SOFT_DEBUG
   153                              <1>         nop
   154                              <1> %endif
   155                              <1> %endif
   156                              <1> %endm
   157                              <1> 
   158                              <1> %imacro popm 1-*.nolist
   159                              <1> %rep %0
   160                              <1> %ifidni %1,ALL
   161                              <1>  popa
   162                              <1> %elifidni %1,F
   163                              <1>  popf
   164                              <1> %else
   165                              <1>  pop %1
   166                              <1> %ifidni %1,DS
   167                              <1>  cnop
   168                              <1> %elifidni %1,ES
   169                              <1>  cnop
   170                              <1> %elifidni %1,FS
   171                              <1>  cnop
   172                              <1> %elifidni %1,GS
   173                              <1>  cnop
   174                              <1> %endif
   175                              <1> %endif
   176                              <1> %rotate 1
   177                              <1> %endrep
   178                              <1> %endm
   179                              <1> 
   180                              <1> %imacro pushm 1-*.nolist
   181                              <1> %rep %0
   182                              <1> %rotate -1
   183                              <1> %ifidni %1,ALL
   184                              <1>  pusha
   185                              <1> %elifidni %1,F
   186                              <1>  pushf
   187                              <1> %else
   188                              <1>  push %1
   189                              <1> %endif
   190                              <1> %endrep
   191                              <1> %endm
   192                              <1> 
   193                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   194                              <1> %assign __size__ (%2-1)	| 0xFF
   195                              <1> %if (__size__ <= 0xFFFF)
   196                              <1> %assign __gran__ 0
   197                              <1> %else
   198                              <1> %assign __gran__ 0xC0			; G B 0 0
   199                              <1> %endif
   200                              <1> %assign __expand__ 0
   201                              <1> %if %0==3
   202                              <1> %if %3
   203                              <1> %assign __expand__ 4
   204                              <1> %endif
   205                              <1> %endif
   206                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   207                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   208                              <1> %endm
   209                              <1> 
   210                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   211                              <1> %assign __size__ (%2-1)	| 0xFF
   212                              <1> %if (__size__ <= 0xFFFF)
   213                              <1> %assign __gran__ 0
   214                              <1> %else
   215                              <1> %assign __gran__ 0xC0			; G D 0 0
   216                              <1> %endif
   217                              <1> %assign __conform__ 0
   218                              <1> %if %0==3
   219                              <1> %if %3
   220                              <1> %assign __conform__ 4
   221                              <1> %endif
   222                              <1> %endif
   223                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   224                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   225                              <1> %endm
   226                              <1> 
   227                              <1> ;/* End of macro.inc */
