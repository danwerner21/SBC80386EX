    79 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
    80                              <1> ; */
    81                              <1> ; POST and ROM data */
    82 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
    83                              <1> %define io_rom_addr_low io_rom_addr
    84                              <1> %define io_rom_addr_seg (io_rom_addr+2)
    85 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
    86                              <1> ; */
    87                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
    88 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
    89 0000006E ????                <1> timer_count_high	resw	1
    90                              <1> %define timer_count timer_count_low
    91                              <1> ; use timer_count as the double word timer counter */
    92 00000070 ??                  <1> timer_overflow	resb	1	; timer has rolled over since last read */
    93                              <1> ; */
    94                              <1> ; System & Keboard data area */
    95 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
    96 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
    97                              <1> ; */
    98                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
    99                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
   100                              <1> ; program can set it and jump to FFFF:0000 -- that is the PC convention  */
   101                              <1> ; and this BIOS honours it.                                             */
   102                              <1> %define WARM_BOOT 0x1234
