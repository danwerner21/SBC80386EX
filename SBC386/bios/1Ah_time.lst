   555                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   556                                  ;
   557                                  ; INT 1A
   558                                  ; function 20   Get NVRAM byte
   559                                  ;
   560                                  ; Enter with:
   561                                  ;       AH      0x20
   562                                  ;       AL      byte number ( 0 <= AL <= 30) 
   563                                  ;   (single byte read)
   564                                  ;
   565                                  ;       AH      0x20
   566                                  ;       AL      31
   567                                  ;       ES:BX   pointer to 31 byte buffer
   568                                  ;   (burst read)
   569                                  ;
   570                                  ; Exit with:
   571                                  ;       AL      byte read (single byte read)
   572                                  ;       Carry clear
   573                                  ;
   574                                  ;       AL      byte NVRAM[30] (burst read)
   575                                  ;       ES:BX buffer filled with bytes 0..30
   576                                  ;
   577                                  ;       Carry clear
   578                                  ;
   579                                  ; Error:
   580                                  ;       Carry set
   581                                  ;
   582                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   583                                  	global	ds_read
   584                                  ds_read:
   585 000001D2 5250                            pushm   ax,dx
   586                                  
   587 000001D4 3C1F                    	cmp	al,31
   588 000001D6 7314                    	jae	ds_burstr	; burst or error
   589                                  	
   590 000001D8 B4C1                    	mov	ah,1100_0001B	; NVRAM read
   591 000001DA E83100                   	call	byte_read
   592                                  
   593                                  ds_read_exit:
   594 000001DD 88E0                    	mov	al,ah		;return in AL
   595 000001DF 5A                      	pop	dx		;get old ax
   596 000001E0 88F4                    	mov	ah,dh		;restore AH
   597 000001E2 EB01                    	jmp	ds_good_exit
   598                                  
   599                                  ds_full_exit:
   600 000001E4 58                      	popm	ax
   601                                  ds_good_exit:
   602 000001E5 F8                      	clc 			;signal good return
   603 000001E6 5A                      	popm	dx
   604 000001E7 C3                      	ret	
   605                                  
   606                                  ds_error:
   607 000001E8 585A                    	popm	ax,dx
   608 000001EA F9                      	stc
   609 000001EB C3                      	ret
   610                                  
   611                                  
   612                                  
   613                                  
   614                                  ;
   615                                  ; handle burst read
   616                                  ds_burstr:
   617 000001EC 75FA                            jne	ds_error	;must be 31 exactly, else error
   618                                  
   619 000001EE 5153                    	pushm	bx,cx		;extra save
   620                                  
   621 000001F0 E8B700                  	call	ds_reset_on	;reset before command byte
   622 000001F3 E8C500                  	call	ds_reset_off	;set for read
   623                                  
   624                                  
   625 000001F6 B4FF                    	mov	ah,1111_1111B	;burst read command
   626 000001F8 E8CD00                  	call	ds_outb		;output the command
   627                                  
   628 000001FB B91F00                  	mov	cx,31		;
   629                                  ds_read2:
   630 000001FE E8DD00                  	call	ds_inb		;retrieve a byte in AH
   631 00000201 268827                    es	mov	byte [bx],ah	;save in the array
   632 00000204 43                        	inc	bx
   633 00000205 E2F7                    	loop	ds_read2	;and loop back
   634                                  
   635 00000207 E8A000                  	call	ds_reset_on	;terminate read
   636                                  
   637 0000020A 5B59                    	popm	bx,cx		;and restore
   638 0000020C EBCF                            jmp	ds_read_exit	;return AH
   639                                   
   640                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   641                                  ;
   642                                  ; byte read into AH
   643                                  ;	AH = command bits
   644                                  ;	AL = register number
   645                                  ; byte read direct
   646                                  ;	AH = command bits + (reg<<1)
   647                                  ;
   648                                  ; Exit with:
   649                                  ;	AH is the byte read in
   650                                  ;
   651                                  ;  Uses AX, DX
   652                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   653                                  byte_read:
   654                                  ; single byte read
   655 0000020E D0E0                    	shl	al,1		; shift by one
   656 00000210 08E0                            or      al,ah		; Clock or NVRAM read
   657 00000212 88C4                    	mov	ah,al		; command byte to AH
   658                                  byte_read_direct:
   659 00000214 E89300                  	call	ds_reset_on	;start of command, set AL & DX
   660 00000217 E8A100                  	call	ds_reset_off	;remove the Reset
   661                                  
   662                                  ; output the command
   663 0000021A E8AB00                          call    ds_outb
   664                                  
   665 0000021D E8BE00                  	call	ds_inb		;input byte to AH
   666                                  
   667 00000220 E88700                  	call	ds_reset_on	;terminate command
   668                                  
   669 00000223 C3                      	ret
   670                                  
   671                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   672                                  ; byte write
   673                                  ;	AH = command bits
   674                                  ;	AL = register number
   675                                  ;	CL = byte value to write
   676                                  ;
   677                                  ; byte_write_direct
   678                                  ;	AH = command, register<<1 included
   679                                  ;	CL = byte value to write
   680                                  ;
   681                                  ;  Uses AX, DX
   682                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   683                                  byte_write:
   684                                  ; single byte write
   685 00000224 D0E0                    	shl	al,1		; prepare command
   686 00000226 08E0                            or      al,ah		; clock or NVRAM write
   687 00000228 88C4                    	mov	ah,al		; command byte to AH
   688                                  byte_write_direct:
   689 0000022A E87D00                  	call	ds_reset_on	;start of command, set AL & DX
   690 0000022D E88B00                  	call	ds_reset_off	;prepare for read
   691                                  
   692                                  ; output the command, will turn Reset off
   693 00000230 E89500                          call    ds_outb
   694                                  
   695 00000233 88CC                            mov     ah,cl		;single byte to write
   696 00000235 E89000                          call    ds_outb
   697                                  
   698 00000238 E86F00                  	call	ds_reset_on	;terminate the write
   699 0000023B C3                      	ret
   700                                  
   701                                  
   702                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   703                                  ;
   704                                  ; INT 1A
   705                                  ; function 21   Set NVRAM byte
   706                                  ;
   707                                  ; Enter with:
   708                                  ;       AH      0x21
   709                                  ;       AL      byte number ( 0 <= AL <= 30) 
   710                                  ;   (single byte write)
   711                                  ;       CL      byte value to write
   712                                  ;
   713                                  ;       AH      0x21
   714                                  ;       AL      31
   715                                  ;       ES:BX   pointer to 31 byte buffer
   716                                  ;   (burst write)
   717                                  ;
   718                                  ; Exit with:
   719                                  ;       Carry clear
   720                                  ;
   721                                  ; Error:
   722                                  ;       Carry set
   723                                  ;
   724                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   725                                  	global	ds_write
   726                                  ds_write:
   727 0000023C 5250                            pushm   ax,dx
   728                                  
   729 0000023E 3C1F                    	cmp	al,31
   730 00000240 7307                    	jae	ds_burstw	; burst or error
   731                                  
   732                                  ; single byte write
   733                                  %if 1
   734 00000242 B4C0                    	mov	ah,1100_0000B   ; RAM/WRITE
   735 00000244 E8DDFF                  	call	byte_write
   736                                  %else
   737                                  	shl	al,1		; prepare command
   738                                          or      al,1100_0000B   ; RAM/WRITE
   739                                  	mov	ah,al		; command byte to AH
   740                                  
   741                                  	call	ds_reset_on	;start of command, set AL & DX
   742                                  	call	ds_reset_off	;prepare for read
   743                                  
   744                                  ; output the command, will turn Reset off
   745                                          call    ds_outb
   746                                  
   747                                          mov     ah,cl		;single byte to write
   748                                          call    ds_outb
   749                                  
   750                                  	call	ds_reset_on	;terminate the write
   751                                  %endif
   752 00000247 EB9B                    	jmp	ds_full_exit
   753                                  	
   754                                  	
   755                                  ; burst write
   756                                  ds_burstw:
   757 00000249 759D                            jne	ds_error	;must be 31 exactly, else error
   758                                  
   759 0000024B 5153                    	pushm	bx,cx		;extra save
   760                                  
   761 0000024D E85A00                  	call	ds_reset_on	;reset before command byte
   762 00000250 E86800                  	call	ds_reset_off	;prepare for burst write
   763                                  
   764 00000253 B4FE                    	mov	ah,1111_1110B	;burst write command
   765 00000255 E87000                  	call	ds_outb		;output the command
   766                                  
   767 00000258 B91F00                  	mov	cx,31		;
   768                                  ds_write2:
   769 0000025B 268A27                     es	mov	ah,byte [bx]	;get byte to write
   770 0000025E E86700                     	call	ds_outb
   771 00000261 43                      	inc	bx		;increment
   772 00000262 E2F7                    	loop	ds_write2
   773                                  
   774 00000264 E84300                  	call	ds_reset_on	;terminate the write
   775                                  
   776 00000267 5B59                    	popm	bx,cx
   777 00000269 E978FF                  	jmp	ds_full_exit	;restore & return
   778                                  
   779                                  
   780                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   781                                  ;
   782                                  ; INT 1A
   783                                  ; function 22   Enable/Disable write protect
   784                                  ;
   785                                  ; Enter with:
   786                                  ;       AH      0x22
   787                                  ;       AL      0x80 to set write protect
   788                                  ;		0x00 to disable write protect
   789                                  ;
   790                                  ; Exit with:
   791                                  ;       Carry clear
   792                                  ;
   793                                  ; Error:
   794                                  ;       Carry set
   795                                  ;
   796                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   797                                  wr_protect:
   798 0000026C 5250                    	pushm	ax,dx
   799 0000026E A87F                    	test	al,0111_1111B	; only 00,80h allowed
   800 00000270 0F8574FF                	jnz	ds_error
   801                                  
   802 00000274 51                      	pushm	cx
   803 00000275 88C1                    	mov	cl,al		; option to write
   804 00000277 B80780                  	mov	ax, 1000_0000B << 8 | 7	; clock write, reg 7
   805 0000027A E8A7FF                  	call	byte_write
   806 0000027D 59                      	popm	cx
   807                                  
   808 0000027E E963FF                  	jmp	ds_full_exit
   809                                  
   810                                  
   811                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   812                                  ;
   813                                  ; INT 1A
   814                                  ; function 23   Set charging parameters
   815                                  ;
   816                                  ; Enter with:
   817                                  ;       AH      0x23
   818                                  ;       AL      charge parameter byte
   819                                  ;
   820                                  ; Exit with:
   821                                  ;       Carry clear
   822                                  ;
   823                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   824                                  ds_set_charge:
   825 00000281 5250                    	pushm	ax,dx
   826 00000283 51                      	pushm	cx
   827                                  
   828 00000284 B480                    	mov	ah,1000_0000B	; clock write
   829 00000286 88C1                    	mov	cl,al		; byte to write
   830 00000288 B008                    	mov	al,8
   831 0000028A E897FF                  	call	byte_write
   832 0000028D 59                      	popm	cx
   833                                  
   834 0000028E E953FF                  	jmp	ds_full_exit
   835                                  
   836                                  
   837                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   838                                  ;
   839                                  ; INT 1A
   840                                  ; function 24   Get charging parameters
   841                                  ;
   842                                  ; Enter with:
   843                                  ;       AH      0x24
   844                                  ;
   845                                  ; Exit with:
   846                                  ;       AL      charge parameter byte
   847                                  ;       Carry clear
   848                                  ;
   849                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   850                                  	global	ds_get_charge
   851                                  ds_get_charge:
   852 00000291 5250                    	pushm	ax,dx
   853                                  
   854 00000293 B80881                  	mov	ax,1000_0001B << 8  | 8	; clock read
   855 00000296 E875FF                  	call	byte_read
   856 00000299 88E2                    	mov	dl,ah		; save in DL
   857 0000029B 58                      	popm	ax
   858 0000029C 88D0                    	mov	al,dl		; return in AL
   859                                  
   860 0000029E E944FF                  	jmp	ds_good_exit
   861                                  
   862                                  
   863                                  ;**********
   864                                  ; N.B. These will move to P1 from P3 on the final board
   865                                  ; Jan 2018 -- updated to P1 for rev 2.0 board
   866                                  ;**********
   867                                  DSLTC   equ     P1LTC           ; DS1302 latch
   868                                  DSPIN   equ     P1PIN           ;   pin value
   869                                  
   870                                  DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
   871                                  DSCLK   equ     BIT2            ; Clock idles high
   872                                  DSRST   equ     BIT3            ; Reset idles low (asserted)
   873                                  
   874                                  DSMSK   equ     DSRST+DSCLK+DSDAT
   875                                  
   876                                  
   877                                  %macro  us_delay 0
   878                                  	jmp	$+2
   879                                  	jmp	$+2
   880                                  	jmp	$+2
   881                                  %endmacro
   882                                  
   883                                  
   884 000002A1 90                      	align	2
   885                                  ds_out_latch:
   886 000002A2 EE                      	out	dx,al
   887                                  	us_delay
   878 000002A3 EB00                <1>  jmp $+2
   879 000002A5 EB00                <1>  jmp $+2
   880 000002A7 EB00                <1>  jmp $+2
   888 000002A9 C3                      	ret
   889                                  
   890                                  ;
   891                                  ; initializes the DSLTC in DX
   892                                  ; sets the Clock low, then asserts Reset
   893                                  ;
   894                                  	global	ds_reset_on
   895                                  ds_reset_on:
   896 000002AA BA62F8                  	mov	dx,DSLTC	;set I/O latch address in DX
   897 000002AD EC                      	in	al,dx		;get the latch value
   898 000002AE 24FB                    	and	al,~DSCLK	;set the clock low (should be idle state)
   899 000002B0 E8EFFF                  	call	ds_out_latch
   900 000002B3 0C01                    	or	al,DSDAT	;set data for input
   901 000002B5 24F7                    	and	al,~DSRST	;assert RESET#
   902 000002B7 E8E8FF                  	call	ds_out_latch
   903 000002BA C3                      	ret
   904                                  
   905                                  ;
   906                                  ; sets the Clock low, then removes the Reset
   907                                  ;
   908                                  	global	ds_reset_off
   909                                  ds_reset_off:		; assume DX is set
   910 000002BB 24FB                    	and	al,~DSCLK	;set the clock low (idle)
   911 000002BD 0C01                    	or	al,DSDAT	;set data for input
   912 000002BF E8E0FF                  	call	ds_out_latch
   913 000002C2 0C08                    	or	al,DSRST	;deassert RESET#
   914 000002C4 E8DBFF                  	call	ds_out_latch
   915 000002C7 C3                      	ret			;clock idles low
   916                                  
   917                                  ;
   918                                  ; moves output bit into position, and then drops the clock low
   919                                  ; pauses, then sets the clock high to clock in the data bit
   920                                  ; loops back for all 8 bits
   921                                  ; exits with the clock HIGH
   922                                  ;
   923                                  ds_outb:	;output the byte in AH
   924 000002C8 51                      	pushm	cx
   925 000002C9 B90800                  	mov	cx,8		;8 bits go out
   926                                  
   927 000002CC 24FB                    .1:	and	al,~DSCLK	;drop the clock
   928 000002CE D1E8                    	shr	ax,1		;LSB to AL
   929 000002D0 D0C0                    	rol	al,1		;data bit to position
   930 000002D2 E8CDFF                  	call	ds_out_latch
   931 000002D5 0C04                    	or	al,DSCLK	
   932 000002D7 E8C8FF                  	call	ds_out_latch
   933 000002DA E2F0                    	loop	.1
   934                                  
   935 000002DC 59                      	popm	cx
   936 000002DD C3                         	ret			;clock is high on exit
   937                                  
   938                                  ;
   939                                  ; sets clock High and data bit for input
   940                                  ; pauses, drops the clock, pauses, reads the data bit
   941                                  ; shifts 8 bits into AH from the left, hence LSB ends up in AX bit 8
   942                                  ; exits with the clock low
   943                                  ;
   944                                  ds_inb:		;input a byte to AH
   945 000002DE 51                      	pushm	cx
   946 000002DF B90800                  	mov	cx,8
   947                                  
   948 000002E2 0C05                    .2:	or	al,DSCLK+DSDAT	;raise the clock, O.C. data set for input
   949 000002E4 E8BBFF                  	call	ds_out_latch
   950 000002E7 24FB                    	and	al,~DSCLK	;drop the clock
   951 000002E9 E8B6FF                  	call	ds_out_latch
   952 000002EC 52                      	push	dx
   953 000002ED BA60F8                     	mov	dx,DSPIN	;set to read data bit
   954 000002F0 EC                      	in	al,dx		;data bit to LSB
   955 000002F1 5A                      	pop	dx
   956 000002F2 D1C8                    	ror	ax,1		;data to AH MSB
   957 000002F4 D0E0                    	shl	al,1		;restore latch value just read in
   958 000002F6 E2EA                    	loop	.2
   959                                  
   960 000002F8 59                      	popm	cx
   961 000002F9 C3                      	ret		; exit with clock Low
   962                                  
   963                                  ; convert packed BCD to binary int
   964                                  ;
   965                                  ;	arg in AL
   966                                  ;
   967                                  ;  int bcd2int(byte bcd);
   968                                  ;
   969                                  	global	bcd2int_
   970                                  bcd2int_:
   971 000002FA 88C4                    	mov	ah,al
   972 000002FC C0EC04                  	shr	ah,4		; AH is unpacked high decimal digit
   973 000002FF 240F                    	and	al,0x0F		; AL is unpacked low decimal digit
   974 00000301 D50A                    	aad			; convert to integer in AX
   975 00000303 C3                      	ret
   976                                  
   977                                  	global	day_of_week_
   978                                  day_of_week_:	;parameters in BCD
   979                                  ;	CH = century
   980                                  ;	CL = year
   981                                  ;	DH = month
   982                                  ;	DL = day
   983                                  ;
   984 00000304 88E8                    	mov	al,ch		;century to AL
   985 00000306 E8F1FF                  	call	bcd2int_
   986 00000309 89C3                    	mov	bx,ax
   987                                  
   988 0000030B 88C8                    	mov	al,cl		;year to AL
   989 0000030D E8EAFF                  	call	bcd2int_
   990 00000310 89C1                    	mov	cx,ax
   991                                  
   992 00000312 88F0                    	mov	al,dh		;month to AL
   993 00000314 E8E3FF                  	call	bcd2int_
   994 00000317 92                      	xchg	ax,dx		;month to DX, day to AL
   995 00000318 E8DFFF                  	call	bcd2int_
   996 0000031B 92                      	xchg	ax,dx		;day to DX, month to AX
   997                                  
   998                                  ; fall into 'dow_'
   999                                  	global	dow_
  1000                                  dow_:
  1001                                  ;	AX = month
  1002                                  ;	DX = day
  1003                                  ;	BX = century
  1004                                  ;	CX = year
  1005                                  ; normalize for calendar starting in March
  1006 0000031C 83E803                  	sub	ax,3		;
  1007 0000031F 790A                    	jns	.4
  1008 00000321 83C00C                  	add	ax,12		; month went negative
  1009 00000324 49                      	dec	cx
  1010 00000325 7904                    	jns	.4
  1011 00000327 83C164                  	add	cx,100		;
  1012 0000032A 4B                      	dec	bx		; year went negative
  1013                                  .4:
  1014                                  ; now calculate
  1015 0000032B 01CA                    	add	dx,cx		; D+Y
  1016 0000032D C1E902                  	shr	cx,2		; Y/4
  1017 00000330 01CA                    	add	dx,cx		; + Y/4
  1018 00000332 01DA                    	add	dx,bx		; + C
  1019 00000334 C1E302                  	shl	bx,2		; C*4
  1020 00000337 01DA                    	add	dx,bx		; D+Y+Y/4+5*C
  1021 00000339 C1EB04                  	shr	bx,4		; C/4
  1022 0000033C 01DA                    	add	dx,bx		; + C/4
  1023 0000033E B90500                  	mov	cx,5		; CX = 5
  1024 00000341 F6F1                    	div	cl		; M/5 to AL, Mrem to AH
  1025 00000343 88E3                    	mov	bl,ah		; BX = Mrem
  1026 00000345 2E8A9F[5B03]               cs	mov	bl,[dow_tab+bx]
  1027 0000034A 01DA                       	add	dx,bx
  1028 0000034C 41                      	inc	cx		; CL = 6
  1029 0000034D F6E1                    	mul	cl		; AX = (M/5)*6
