    53                              <1> ; directory.  If not, see <http://www.gnu.org/licenses/>.
    54                              <1> ;
    55                              <1> ;
    56                              <1> ; SBC-386 board revisions:
    57                              <1> ;       SBC386-0   prototype / concept testing
    58                              <1> ;	SBC-386EX 2.0	production / January 2018
    59                              <1> ;
    60                              <1> ; Assembly by NASM 2.08 is preferred
    61                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    62                              <1> ;
    63                              <1> ;include "i386EX.inc" -- must be included at a higher level
    64                              <1> 
    65                              <1> TIMER_STOP	equ	BIT6+BIT0 + ZBIT1 + ZBIT3 + ZBIT5 ; stop 0, 1, 2
    66                              <1> TIMER_RUN	equ	TIMER_STOP + BIT1 + BIT3	; run counters 0, 1
    67                              <1> 
    68                              <1>         binit   TMRCFG, ZBIT7+TIMER_STOP ; bit6: s/w control of GATEn, bit7=0 enables all clocks
   111 00000000 34F8                <2>  dw %1
   112 00000002 41                  <2>  db %2
    69                              <1> 		;Timers enabled, 1&2 use PSCLK, 0 uses TMRCLK0 (COMCLK/2)
    70                              <1> CTR0 equ ZBIT7+ZBIT6	;select counter 0
    71                              <1> CTR1 equ ZBIT7+ BIT6	;select counter 1
    72                              <1> CTR2 equ  BIT7+ZBIT6	;select counter 2
    73                              <1> CWR01 equ BIT5+BIT4	;Write Count low, then high
    74                              <1> MODE0 equ ZBIT3+ZBIT2+ZBIT1
    75                              <1> MODE1 equ ZBIT3+ZBIT2+ BIT1
    76                              <1> MODE2 equ ZBIT3+ BIT2+ZBIT1
    77                              <1> MODE3 equ ZBIT3+ BIT2+ BIT1
    78                              <1> MODE4 equ  BIT3+ZBIT2+ZBIT1
    79                              <1> MODE5 equ  BIT3+ZBIT2+ BIT1
    80                              <1> ; counter 0 runs at 1.8432mhz / 2  =  921600  (just under 1mhz)
    81                              <1> ; @20hz, the divisor is 46080 yielding a 50ms time slot
    82                              <1> COMCLK	equ	1843200		; standard 1.8432mhz oscillator
    83                              <1> BAUD	equ	9600		; default SIO0 bit rate
    84                              <1> DIVISOR	equ	COMCLK/16/BAUD	; SIO0 divisor to achieve BAUD rate
    85                              <1> CLKIN0	equ	COMCLK/2	; Timer0 input count rate
    86                              <1> MS50	equ	CLKIN0 / 20	; 50ms clock
    87                              <1> MS50HI	equ	MS50/256
    88                              <1> MS50LO	equ	MS50 & 0xFF
    89                              <1> MS18	equ	50619		; 18.206602hz clock (54.92513ms)
    90                              <1> 				; 0x1800BA = 1573050 ticks/day
    91                              <1> MS18b	equ	50625		; 18.204444hz clock (54.93164ms)
    92                              <1> 				; 0x180000 = 1572864 ticks/day
    93                              <1> MS18HI	equ	MS18/256
    94                              <1> MS18LO	equ	MS18 & 0xFF
    34                                  
    35                                  
    36                                  %ifndef DEBUG
    37                                  %define	DEBUG 1
    38                                  %endif
    39                                  
    40                                  	global	int_1Ah
    41                                  
    42                                  segment	_TEXT
    43                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    44                                  ;
    45                                  ; INT 1A
    46                                  ;
    47                                  ; Enter with:
    48                                  ;       AH      function code
    49                                  ;
    50                                  ; Exit with:
    51                                  ;	varies
    52                                  ;
    53                                  ;       Carry clear
    54                                  ;
    55                                  ; Error:
    56                                  ;	AH	error code
    57                                  ;       Carry set
    58                                  ;
    59                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    60                                  int_1Ah:
    61 00000000 FB                      	sti			;turn on interrupts
    62                                  ;
    63                                  ; Everything that is not a documented return value.  INT 1Ah answers in
    64                                  ; AX, CX, DX and the Carry -- nothing in this dispatch returns BX, DI,
    65                                  ; BP, DS or ES -- so a caller is entitled to get them back untouched,
    66                                  ; and until now only SI was saved.
    67                                  ;
    68                                  ; That is not a theoretical tidiness.  DOS reads the tick through
    69                                  ; AH=00h constantly, and a C caller reaches the clock the same way;
    70                                  ; a handler here that happens to use DS or BP corrupts whatever the
    71                                  ; caller was holding in them.  It was found by writing exactly such a
    72                                  ; caller -- a loop reading the seconds -- and watching it hang.
    73                                  ;
    74                                  ; Same family as the INT 13h defect in Phase 6: what the interface
    75                                  ; promises about registers, rather than what the hardware does.
    76                                  ;
    77 00000001 061E55575653            	pushm	bx,si,di,bp,ds,es
    78                                  
    79 00000007 89C6                    	mov	si,ax		; can't use BX for certain calls
    80 00000009 C1EE08                  	shr	si,8		; zero fill high bits
    81 0000000C 01F6                    	add	si,si		; address words
    82                                  
    83 0000000E 83FE10                  	cmp	si,len_dispatch0  ; length is in words
    84 00000011 7214                    	jb	low_dispatch2
    85                                  
    86 00000013 83EE40                  	sub	si,0x20 * 2	; calls based at 20h
    87 00000016 83FE0A                  	cmp	si,len_dispatch20  ; length is in words
    88 00000019 7213                    	jb	exec20_dispatch
    89                                  
    90                                  fn_not_defined:
    91 0000001B B486                    	mov	ah,0x86		;function not defined
    92 0000001D F9                      	stc
    93                                  exit:	
    94 0000001E 5B5E5F5D1F07            	popm	bx,si,di,bp,ds,es	; POP does not disturb the Carry the
    95                                  					;  handlers set
    96 00000024 CA0200                  	retf	2		;return from call
    97                                  
    98                                  low_dispatch2:
    99 00000027 2EFF94[3600]               cs	call	[dispatch0 + si]
   100 0000002C EBF0                    	jmp	exit
   101                                  
   102                                  exec20_dispatch:
   103 0000002E 2EFF94[4600]               cs	call	[dispatch20 + si]
   104 00000033 EBE9                    	jmp	exit
   105                                  
   106                                  
   107                                  
   108 00000035 90                      	align	2
   109                                  dispatch0:
   110 00000036 [6C00]                  	dw	get_tick_count
   111 00000038 [ED00]                  	dw	set_tick_count
   112 0000003A [0301]                  	dw	get_time
   113 0000003C [3501]                  	dw	set_time
   114 0000003E [6601]                  	dw	get_date
   115 00000040 [9C01]                  	dw	set_date
   116 00000042 [5000]                  	dw	set_alarm
   117 00000044 [5000]                  	dw	reset_alarm
   118                                  len_dispatch0	equ	$-dispatch0
   119                                  
   120                                  dispatch20:
   121 00000046 [DF01]                  	dw	ds_read		; 20h
   122 00000048 [4902]                  	dw	ds_write	; 21h
   123 0000004A [7902]                  	dw	wr_protect	; 22h
   124 0000004C [8E02]                  	dw	ds_set_charge	; 23h
   125 0000004E [9E02]                  	dw	ds_get_charge	; 24h
   126                                  len_dispatch20	equ	$-dispatch20
   127                                  
   128                                  set_alarm:
   129                                  reset_alarm:
   130 00000050 EBC9                    	jmp	fn_not_defined
   131                                  ;
   132                                  
   133                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   134                                  ; diagnostic aid
   135                                  ;	AL = read command
   136                                  ; 	AX has byte read in AL
   137                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   138                                  	global	ds_read_reg_
   139                                  ds_read_reg_:
   140 00000052 52                      	pushm	dx
   141 00000053 88C4                    	mov	ah,al			; move command to position
   142 00000055 80CC81                  	or	ah,1000_0001B
   143 00000058 E85B02                  	call	ds_reset_on
   144 0000005B E86902                  	call	ds_reset_off
   145 0000005E E87302                  	call	ds_outb
   146 00000061 E88602                  	call	ds_inb
   147 00000064 E84F02                  	call	ds_reset_on
   148 00000067 C1E808                  	shr	ax,8			; return byte value
   149 0000006A 5A                      	popm	dx
   150 0000006B C3                      	ret
   151                                  
   152                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   153                                  ; INT 1A
   154                                  ; function 00	get_tick_count
   155                                  ;
   156                                  ;    Enter with:
   157                                  ;	AH	00h
   158                                  ;
   159                                  ;    Exit with:
   160                                  ;	CX:DX	tick count
   161                                  ;	AL	rolled over flag  0=no	1=day rollover
   162                                  ;
   163                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   164                                  	align	2
   165                                  get_tick_count:
   166 0000006C 1E                      	push	ds		;save
   167 0000006D 6A401F                  	get_bda	DS
   168 00000070 FA                      	cli		;disable interrupts
   169 00000071 8B166C00                	mov	dx,[timer_count_low]
   170 00000075 8B0E6E00                	mov	cx,[timer_count_high]
   171 00000079 30C0                    	xor	al,al
   172 0000007B 86067000                	xchg	al,[timer_overflow]
   173 0000007F FB                      	sti		;restore interrupts
   174 00000080 F8                      	clc
   175 00000081 1F                      	pop	ds
   176 00000082 C3                      	ret
   177                                  
   178                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   179                                  ; Timer 0 interrupt handler
   180                                  ;
   181                                  ;	Count down the tick timer
   182                                  ;	Reset if it reaches zero
   183                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   184                                  	global	int_irq0
   185 00000083 90                      	align	2
   186                                  
   187                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   188                                  ; A heartbeat, for telling a hung machine from a halted one.
   189                                  ;
   190                                  ; Writes a character to the console about once a second from the timer
   191                                  ; tick.  If it keeps sounding through a lockup then interrupts are alive
   192                                  ; and whatever is stuck is a software loop; if it stops, the tick is not
   193                                  ; arriving at all, and nothing polled will ever recover the machine.  That
   194                                  ; is the difference between a bug to find and a machine to reset, and once
   195                                  ; the console has stopped answering there is no other way to tell.
   196                                  ;
   197                                  ; It is sounded twice, on either side of the INT 1Ch hook, because a hook
   198                                  ; that hangs would silence a single beat placed after it and look exactly
   199                                  ; like a dead tick.  Two characters separate the three cases:
   200                                  ;
   201                                  ;	"~+"	the tick is arriving and the hook returns -- look elsewhere
   202                                  ;	"~"	the tick arrives, the INT 1Ch hook never comes back
   203                                  ;	nothing	the tick is not being delivered: IF clear, IRQ0 masked,
   204                                  ;		 counter 0 stopped, or the CPU halted
   205                                  ;
   206                                  ; Both beats test the same not-yet-incremented count, so they pair up.
   207                                  ; INT 14h transmit is polled, so this works whatever else has failed.
   208                                  ;
   209                                  ; Debugging aid: TICK_BEAT belongs at 0 in any ROM anyone relies on.
   210                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   211                                  %define TICK_BEAT 0
   212                                  
   213                                  %macro	beat 1
   214                                  %if TICK_BEAT
   215                                  	pushm	ax,dx,ds		; irq0 has saved nothing yet
   216                                  	get_bda	DS
   217                                  	test	word [timer_count_low],0x000F	; every sixteenth tick
   218                                  	jnz	%%quiet
   219                                  	mov	al,%1
   220                                  	mov	ah,1			; INT 14h, write a character
   221                                  	xor	dx,dx			; COM1
   222                                  	int	0x14
   223                                  %%quiet:
   224                                  	popm	ax,dx,ds
   225                                  %endif
   226                                  %endmacro
   227                                  
   228                                  int_irq0:
   229 00000084 FC                      	cld			; insurance
   230                                  	beat	'~'
   214                              <1> %if TICK_BEAT
   215                              <1>  pushm ax,dx,ds
   216                              <1>  get_bda DS
   217                              <1>  test word [timer_count_low],0x000F
   218                              <1>  jnz %%quiet
   219                              <1>  mov al,%1
   220                              <1>  mov ah,1
   221                              <1>  xor dx,dx
   222                              <1>  int 0x14
   223                              <1> %%quiet:
   224                              <1>  popm ax,dx,ds
   225                              <1> %endif
   231 00000085 CD1C                    	int	0x1C
   232                                  	beat	'+'
   214                              <1> %if TICK_BEAT
   215                              <1>  pushm ax,dx,ds
   216                              <1>  get_bda DS
   217                              <1>  test word [timer_count_low],0x000F
   218                              <1>  jnz %%quiet
   219                              <1>  mov al,%1
   220                              <1>  mov ah,1
   221                              <1>  xor dx,dx
   222                              <1>  int 0x14
   223                              <1> %%quiet:
   224                              <1>  popm ax,dx,ds
   225                              <1> %endif
   233                                  
   234 00000087 1E5153                  	pushm	bx,cx,ds
   235 0000008A 6A401F                  	get_bda	DS
   236 0000008D B90800                  	mov	cx,8		; will be used later
   237                                  
   238 00000090 66FF066C00              	inc	dword [timer_count]
   239                                  
   240 00000095 66813E6C00BA001800      	cmp	dword [timer_count],tick
   241 0000009E 720E                    	jb	.2
   242                                  ; tick went to zero (or negative)
   243 000000A0 C606700001              	mov	byte [timer_overflow],1
   244 000000A5 66C7066C0000000000      	mov	dword [timer_count],0
   245                                  .2:
   246                                  ; handle the FDC motor timeout
   247 000000AE 382E4000                	cmp	[motor_count],ch	; CH==0
   248 000000B2 7409                    	je	.3
   249 000000B4 FE0E4000                	dec	byte [motor_count]
   250 000000B8 7503                    	jnz	.3
   251                                  	extern	FDC_stop_motor	; in diskfdc.asm
   252 000000BA E8(0000)                	call	FDC_stop_motor
   253                                  .3:
   254                                  ; handle the printer & serial line timeouts
   255                                  	extern	vt_tick			; 16h_kbd.asm -- the held Escape
   256 000000BD E8(0000)                	call	vt_tick
   257                                  
   258 000000C0 BB7800                  	mov	bx,printer_timeout	; 4 printer, 4 serial timeouts
   259 000000C3 382F                    .4:	cmp	byte [bx],ch
   260 000000C5 7402                    	je	.5
   261 000000C7 FE0F                    	dec	byte [bx]
   262 000000C9 43                      .5:	inc	bx
   263 000000CA E2F7                    	loop	.4
   264                                  
   265                                  ; restore before clearing the interrupt
   266 000000CC 5B591F                  	popm	bx,cx,ds
   267                                  
   268                                  	extern	clear_irq0	; currently in stub.asm
   269 000000CF E9(0000)                	jmp	clear_irq0
   270                                  
   271                                  
   272                                  ; Timer 0 constants
   273                                  ;
   274                                  divide	equ	MS18 		; 50619
   275                                  tick	equ	CLKIN0*86400/divide
   276                                  ttime	equ	(divide*1000000)/(CLKIN0)
   277                                  
   278                                  
   279                                  t0tab:
   280                                  	binit	TMRCON, CTR0 + CWR01 + MODE2 + ZBIT0	;binary
   111 000000D2 43F0                <1>  dw %1
   112 000000D4 34                  <1>  db %2
   281                                  	binit	TMR0, MS18LO	;low byte
   111 000000D5 40F0                <1>  dw %1
   112 000000D7 BB                  <1>  db %2
   282                                  	binit	TMR0, MS18HI	;high byte = 46080
   111 000000D8 40F0                <1>  dw %1
   112 000000DA C5                  <1>  db %2
   283                                  	binit	TMRCFG, TIMER_STOP + BIT1		; start timer 0
   111 000000DB 34F8                <1>  dw %1
   112 000000DD 43                  <1>  db %2
   284 000000DE FFFF                            dw      -1
   285                                  
   286                                  ; Timer 0 startup
   287                                  ;
   288                                  	global	start_timer0_
   289                                  	extern	initb			; in start.asm
   290                                  start_timer0_:
   291 000000E0 561E                    	pushm	ds,si
   292 000000E2 0E                      	push	cs
   293 000000E3 1F                      	pop	ds
   294 000000E4 BE[D200]                	mov	si,t0tab
   295 000000E7 E8(0000)                	call	initb
   296 000000EA 1F5E                    	popm	ds,si
   297 000000EC C3                      	ret
   298                                  
