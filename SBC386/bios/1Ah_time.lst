   297                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   298                                  ; INT 1A
   299                                  ; function 01	set_tick_count
   300                                  ;
   301                                  ;    Enter with:
   302                                  ;	AH	01h
   303                                  ;	CX:DX	tick count
   304                                  ;
   305                                  ;    Exit with:
   306                                  ;	nothing
   307                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   308                                  set_tick_count:
   309 000000EA 1E                      	push	ds
   310 000000EB 6A401F                  	get_bda	DS	;address BDA
   311 000000EE FA                      	cli		;disable interrupts
   312 000000EF 89166C00                	mov	[timer_count_low],dx
   313 000000F3 890E6E00                	mov	[timer_count_high],cx
   314 000000F7 C606700000              	mov	byte [timer_overflow],0	; 'byte' qualifier needed
   315 000000FC FB                      	sti		;interrupts back on
   316 000000FD F8                      	clc
   317 000000FE 1F                      	pop	ds
   318 000000FF C3                      	ret
   319                                  
   320                                  
   321                                  
   322                                  
   323                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   324                                  ;
   325                                  ; INT 1A
   326                                  ; function 02   Get Time
   327                                  ;
   328                                  ; Enter with:
   329                                  ;       AH      0x02
   330                                  ;
   331                                  ; Exit with:
   332                                  ;	CH	hours in BCD
   333                                  ;	CL	minutes in BCD
   334                                  ;	DH	seconds in BCD
   335                                  ;	DL	daylight savings time flag
   336                                  ;		  00=not DST, 01==DST
   337                                  ;	
   338                                  ;       Carry clear	if clock is running
   339                                  ;
   340                                  ; Error:
   341                                  ;       Carry set	if clock is stopped
   342                                  ;
   343                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   344                                  	global	get_time
   345                                  get_time:
   346 00000100 50                      	pushm	ax
   347 00000101 31DB                    	xor	bx,bx		; saved at a higher level
   348 00000103 B80081                  	mov	ax, 1000_0001B << 8 | 0		;seconds
   349 00000106 88C2                    	mov	dl,al		; DST off
   350 00000108 E80D01                  	call	byte_read
   351 0000010B 88E6                    	mov	dh,ah		; save seconds
   352                                  
   353 0000010D 52                      .1:	push	dx
   354 0000010E B80181                  	mov	ax, 1000_0001B << 8 | 1		; minutes
   355 00000111 E80401                  	call	byte_read
   356 00000114 88E1                    	mov	cl,ah		; save minutes
   357 00000116 B80281                  	mov	ax, 1000_0001B << 8 | 2		; hours
   358 00000119 E8FC00                  	call	byte_read
   359 0000011C 88E5                    	mov	ch,ah		; save hours
   360 0000011E B80081                  	mov	ax, 1000_0001B << 8 | 0		;seconds
   361 00000121 E8F400                  	call	byte_read
   362 00000124 5A                      	pop	dx
   363 00000125 86F4                    	xchg	dh,ah
   364 00000127 38F4                    	cmp	ah,dh
   365 00000129 75E2                    	jne	.1		; loop back
   366                                  
   367 0000012B 80E67F                  	and	dh,0x7F		; mask clock halt bit
   368 0000012E 00E4                    	add	ah,ah		; set carry if halted
   369                                  
   370 00000130 58                      	popm	ax
   371 00000131 C3                      	ret
   372                                  
   373                                  
   374                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   375                                  ;
   376                                  ; INT 1A
   377                                  ; function 03   Set Time
   378                                  ;
   379                                  ; Enter with:
   380                                  ;       AH      0x03
   381                                  ;
   382                                  ;	CH	hours in BCD
   383                                  ;	CL	minutes in BCD
   384                                  ;	DH	seconds in BCD
   385                                  ;	DL	daylight savings time flag (ignored)
   386                                  ;		  00=not DST, 01==DST
   387                                  ;	
   388                                  ; Exit with:
   389                                  ;       Carry clear	if clock is running
   390                                  ;
   391                                  ; Error:
   392                                  ;       Carry set	if clock is stopped
   393                                  ;
   394                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   395                                  	global	set_time
   396                                  set_time:
   397 00000132 5250                    	pushm	ax,dx
   398                                  
   399 00000134 5251                    	pushm	cx,dx		;protect the parameters
   400                                  
   401 00000136 B000                    	mov	al,0		;disable write protect
   402 00000138 E83B01                  	call	wr_protect	;**
   403                                  %if 0
   404                                  	mov	ax, 1000_0000B << 8 | 0		;seconds
   405                                  	mov	cl,80h			; stop the clock
   406                                  	call	byte_write
   407                                  %endif
   408 0000013B 5B                      	popm	bx		; was CX
   409                                  
   410 0000013C B80280                  	mov	ax, 1000_0000B << 8 | 2		;hours
   411 0000013F 88F9                    	mov	cl,bh		; **
   412 00000141 80E17F                  	and	cl,0x7F		; 24-hr format
   413 00000144 E8E700                  	call	byte_write
   414                                  
   415 00000147 B80180                  	mov	ax, 1000_0000B << 8 | 1		;minutes
   416 0000014A 88D9                    	mov	cl,bl		; **
   417 0000014C E8DF00                  	call	byte_write
   418                                  
   419 0000014F 5B                      	popm	bx		; was DX
   420                                  
   421 00000150 B80080                  	mov	ax, 1000_0000B << 8 | 0		;seconds
   422 00000153 88F9                    	mov	cl,bh
   423 00000155 80E17F                  	and	cl,0x7F			; enable the clock
   424 00000158 E8D300                  	call	byte_write
   425                                  
   426 0000015B B080                    	mov	al,80h		;set Write Protect
   427 0000015D E81601                  	call	wr_protect
   428                                  
   429 00000160 E98B00                  	jmp	ds_full_exit
   430                                  
   431                                  
   432                                  
   433                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   434                                  ;
   435                                  ; INT 1A
   436                                  ; function 04   Get Date
   437                                  ;
   438                                  ; Enter with:
   439                                  ;       AH      0x04
   440                                  ;
   441                                  ; Exit with:
   442                                  ;	CH	century in BCD
   443                                  ;	CL	year in BCD
   444                                  ;	DH	month in BCD
   445                                  ;	DL	day in BCD
   446                                  ;	
   447                                  ;       Carry clear	if clock is running
   448                                  ;
   449                                  ; Error:
   450                                  ;       Carry set	if clock is stopped
   451                                  ;
   452                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   453                                  	global	get_date
   454                                  get_date:
   455 00000163 B80681                  	mov	ax,1000_0001B << 8 | 6	;year
   456 00000166 E8AF00                  	call	byte_read
   457 00000169 88E1                    	mov	cl,ah		; return in CL
   458                                  
   459 0000016B B80481                  	mov	ax,1000_0001B << 8 | 4	;month
   460 0000016E E8A700                  	call	byte_read
   461 00000171 88E7                    	mov	bh,ah		; save in BH
   462                                  
   463 00000173 B80381                  	mov	ax,1000_0001B << 8 | 3	;day of month (DATE)
   464 00000176 E89F00                  	call	byte_read
   465 00000179 88E3                    	mov	bl,ah
   466                                  	
   467 0000017B B80581                  	mov	ax,1000_0001B << 8 | 5	;day of week (DAY)
   468 0000017E E89700                  	call	byte_read
   469 00000181 88E5                    	mov	ch,ah		; save in Century byte
   470                                  
   471 00000183 B80081                  	mov	ax,1000_0001B << 8 | 0	;clock halt flag
   472 00000186 E88F00                  	call	byte_read
   473                                  ; clock halt flag is in AH
   474                                  
   475 00000189 89DA                    	mov	dx,bx		;
   476 0000018B 88E8                    	mov	al,ch		; Day-of-Week flag to AL
   477 0000018D B519                    	mov	ch,0x19		; 20th century in CH
   478 0000018F 80F970                  	cmp	cl,0x70		; year less than '70 sets carry
   479                                  %if 0
   480                                  	adc	al,0		; add in the carry if CL<70h
   481                                  	daa			; correct (DAA doesn't work???)
   482                                  %else
   483 00000192 7302                    	jnb	.8
   484 00000194 B520                    	mov	ch,0x20		; carry is set
   485                                  .8:
   486                                  %endif
   487 00000196 D0E4                    	shl	ah,1		; clock halt to carry
   488 00000198 C3                      	ret
   489                                  
   490                                  
   491                                  
   492                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   493                                  ;
   494                                  ; INT 1A
   495                                  ; function 05   Set Date
   496                                  ;
   497                                  ; Enter with:
   498                                  ;       AH      0x05
   499                                  ;
   500                                  ;	CH	century in BCD	(used for Day Of Week calculation)
   501                                  ;	CL	year in BCD
   502                                  ;	DH	month in BCD
   503                                  ;	DL	day in BCD
   504                                  ;	
   505                                  ; Exit with:
   506                                  ;	Nothing
   507                                  ;
   508                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   509                                  	global	set_date
   510                                  set_date:
   511 00000199 5250                    	pushm	ax,dx		;usual 2 register save
   512 0000019B 80FD20                  	cmp	ch,0x20		; century must be 21st
   513 0000019E 7405                    	je	.1
   514 000001A0 80FD19                  	cmp 	ch,0x19		; century may be 20th
   515 000001A3 754D                    	jne	ds_error
   516                                  .1:
   517 000001A5 5152                    	pushm	dx,cx
   518                                  
   519 000001A7 E86401                  	call	day_of_week_
   520                                  
   521 000001AA 5B59                    	popm	bx,cx		; was DX,CX
   522 000001AC 51                      	pushm	cx		; save CX
   523                                  
   524 000001AD 88C5                    	mov	ch,al		; DOW to CH
   525                                  
   526 000001AF B000                    	mov	al,0		;disable write protect
   527 000001B1 E8C200                  	call	wr_protect
   528                                  
   529 000001B4 B80680                  	mov	ax,1000_0000B << 8 | 6	;year
   530 000001B7 E87400                  	call	byte_write	; year is in CL already
   531                                  
   532 000001BA B80480                  	mov	ax,1000_0000B << 8 | 4	;month
   533 000001BD 88F9                    	mov	cl,bh			; was in DH
   534 000001BF E86C00                  	call	byte_write
   535                                  
   536 000001C2 B80380                  	mov	ax,1000_0000B << 8 | 3	;day (DATE)
   537 000001C5 88D9                    	mov	cl,bl			; was in DL
   538 000001C7 E86400                  	call	byte_write
   539                                  
   540 000001CA B80580                  	mov	ax,1000_0000B << 8 | 5	;day of week (DOW)
   541 000001CD 88E9                    	mov	cl,ch
   542 000001CF FEC1                    	inc	cl		; DS1302 is 1..7, not 0..6
   543 000001D1 E85A00                  	call	byte_write
   544                                  
   545 000001D4 B080                    	mov	al,80h		;set Write Protect
   546 000001D6 E89D00                  	call	wr_protect
   547                                  
   548 000001D9 59                      	popm	cx
   549 000001DA EB12                    	jmp	ds_full_exit
   550                                  
   551                                  
   552                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   553                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   554                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   555                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   556                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   557                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   558                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   559                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   560                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   561                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   562                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   563                                  
