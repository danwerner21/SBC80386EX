    31                                  %include "bda.inc"
    32                              <1> XXX
    33                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
    34                              <1> %define BDA_segment 0x40
    35                              <1> ; bda.console -- which consoles INT 10h drives.  Set before the first */
    36                              <1> ; printf of POST; vga3_init adds the video bit when the board answers. */
    37                              <1> ; Both at once mirrors the screen down the serial line.  One comment  */
    38                              <1> ; per line here: bda.rul turns this file into bda.inc a line at a time. */
    39                              <1> %define CON_SERIAL	0x01
    40                              <1> %define CON_VIDEO	0x02
    41                              <1> struc _BDA
    42                              <1> ; first items at 0x40:0	*/
    43 00000000 ????????????????    <1> serial_dev	resw	4	; serial port device codes */
    44 00000008 ????????????????    <1> parallel_dev	resw	4	; printer port device codes */
    45 00000010 ????                <1> equip_flag	resw	1		; int 12h equipment flags */
    46 00000012 ??                  <1> mfg_test	resb	1		; initialization flags */
    47                              <1> ; */
    48                              <1> ; POST writes what it decided here, after the test of segment 0 has */
    49                              <1> ; zeroed the area, so the answer survives to be reported.  Nothing else */
    50                              <1> ; in this BIOS writes mfg_test.                                        */
    51                              <1> %define WARM_POST 0x01	; warm start: the memory march was skipped */
    52 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    53 00000015 ??                  <1> mfg_err_flag	resb	1
    54 00000016 ??                  <1> mfg_err_flag2	resb	1
    55                              <1> ; */
    56                              <1> ; first Keyboard data area */
