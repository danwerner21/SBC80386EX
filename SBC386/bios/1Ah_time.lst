   565                                  
   566                                  
   567                                  
   568                                  
   569                                  
   570                                  
   571                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   572                                  ;
   573                                  ; INT 1A
   574                                  ; function 20   Get NVRAM byte
   575                                  ;
   576                                  ; Enter with:
   577                                  ;       AH      0x20
   578                                  ;       AL      byte number ( 0 <= AL <= 30) 
   579                                  ;   (single byte read)
   580                                  ;
   581                                  ;       AH      0x20
   582                                  ;       AL      31
   583                                  ;       ES:BX   pointer to 31 byte buffer
   584                                  ;   (burst read)
   585                                  ;
   586                                  ; Exit with:
   587                                  ;       AL      byte read (single byte read)
   588                                  ;       Carry clear
   589                                  ;
   590                                  ;       AL      byte NVRAM[30] (burst read)
   591                                  ;       ES:BX buffer filled with bytes 0..30
   592                                  ;
   593                                  ;       Carry clear
   594                                  ;
   595                                  ; Error:
   596                                  ;       Carry set
   597                                  ;
   598                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   599                                  	global	ds_read
   600                                  ds_read:
   601 000001DC 5250                            pushm   ax,dx
   602                                  
   603 000001DE 3C1F                    	cmp	al,31
   604 000001E0 7314                    	jae	ds_burstr	; burst or error
   605                                  	
   606 000001E2 B4C1                    	mov	ah,1100_0001B	; NVRAM read
   607 000001E4 E83100                   	call	byte_read
   608                                  
   609                                  ds_read_exit:
   610 000001E7 88E0                    	mov	al,ah		;return in AL
   611 000001E9 5A                      	pop	dx		;get old ax
   612 000001EA 88F4                    	mov	ah,dh		;restore AH
   613 000001EC EB01                    	jmp	ds_good_exit
   614                                  
   615                                  ds_full_exit:
   616 000001EE 58                      	popm	ax
   617                                  ds_good_exit:
   618 000001EF F8                      	clc 			;signal good return
   619 000001F0 5A                      	popm	dx
   620 000001F1 C3                      	ret	
   621                                  
   622                                  ds_error:
   623 000001F2 585A                    	popm	ax,dx
   624 000001F4 F9                      	stc
   625 000001F5 C3                      	ret
   626                                  
   627                                  
   628                                  
   629                                  
   630                                  ;
   631                                  ; handle burst read
   632                                  ds_burstr:
   633 000001F6 75FA                            jne	ds_error	;must be 31 exactly, else error
   634                                  
   635 000001F8 5153                    	pushm	bx,cx		;extra save
   636                                  
   637 000001FA E8B700                  	call	ds_reset_on	;reset before command byte
   638 000001FD E8C500                  	call	ds_reset_off	;set for read
   639                                  
   640                                  
   641 00000200 B4FF                    	mov	ah,1111_1111B	;burst read command
   642 00000202 E8CD00                  	call	ds_outb		;output the command
   643                                  
   644 00000205 B91F00                  	mov	cx,31		;
   645                                  ds_read2:
   646 00000208 E8DD00                  	call	ds_inb		;retrieve a byte in AH
   647 0000020B 268827                    es	mov	byte [bx],ah	;save in the array
   648 0000020E 43                        	inc	bx
   649 0000020F E2F7                    	loop	ds_read2	;and loop back
   650                                  
   651 00000211 E8A000                  	call	ds_reset_on	;terminate read
   652                                  
   653 00000214 5B59                    	popm	bx,cx		;and restore
   654 00000216 EBCF                            jmp	ds_read_exit	;return AH
   655                                   
   656                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   657                                  ;
   658                                  ; byte read into AH
   659                                  ;	AH = command bits
   660                                  ;	AL = register number
   661                                  ; byte read direct
   662                                  ;	AH = command bits + (reg<<1)
   663                                  ;
   664                                  ; Exit with:
   665                                  ;	AH is the byte read in
   666                                  ;
   667                                  ;  Uses AX, DX
   668                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   669                                  byte_read:
   670                                  ; single byte read
   671 00000218 D0E0                    	shl	al,1		; shift by one
   672 0000021A 08E0                            or      al,ah		; Clock or NVRAM read
   673 0000021C 88C4                    	mov	ah,al		; command byte to AH
   674                                  byte_read_direct:
   675 0000021E E89300                  	call	ds_reset_on	;start of command, set AL & DX
   676 00000221 E8A100                  	call	ds_reset_off	;remove the Reset
   677                                  
   678                                  ; output the command
   679 00000224 E8AB00                          call    ds_outb
   680                                  
   681 00000227 E8BE00                  	call	ds_inb		;input byte to AH
   682                                  
   683 0000022A E88700                  	call	ds_reset_on	;terminate command
   684                                  
   685 0000022D C3                      	ret
   686                                  
   687                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   688                                  ; byte write
   689                                  ;	AH = command bits
   690                                  ;	AL = register number
   691                                  ;	CL = byte value to write
   692                                  ;
   693                                  ; byte_write_direct
   694                                  ;	AH = command, register<<1 included
   695                                  ;	CL = byte value to write
   696                                  ;
   697                                  ;  Uses AX, DX
   698                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   699                                  byte_write:
   700                                  ; single byte write
   701 0000022E D0E0                    	shl	al,1		; prepare command
   702 00000230 08E0                            or      al,ah		; clock or NVRAM write
   703 00000232 88C4                    	mov	ah,al		; command byte to AH
   704                                  byte_write_direct:
   705 00000234 E87D00                  	call	ds_reset_on	;start of command, set AL & DX
   706 00000237 E88B00                  	call	ds_reset_off	;prepare for read
   707                                  
   708                                  ; output the command, will turn Reset off
   709 0000023A E89500                          call    ds_outb
   710                                  
   711 0000023D 88CC                            mov     ah,cl		;single byte to write
   712 0000023F E89000                          call    ds_outb
   713                                  
   714 00000242 E86F00                  	call	ds_reset_on	;terminate the write
   715 00000245 C3                      	ret
   716                                  
   717                                  
   718                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   719                                  ;
   720                                  ; INT 1A
   721                                  ; function 21   Set NVRAM byte
   722                                  ;
   723                                  ; Enter with:
   724                                  ;       AH      0x21
   725                                  ;       AL      byte number ( 0 <= AL <= 30) 
   726                                  ;   (single byte write)
   727                                  ;       CL      byte value to write
   728                                  ;
   729                                  ;       AH      0x21
   730                                  ;       AL      31
   731                                  ;       ES:BX   pointer to 31 byte buffer
   732                                  ;   (burst write)
   733                                  ;
   734                                  ; Exit with:
   735                                  ;       Carry clear
   736                                  ;
   737                                  ; Error:
   738                                  ;       Carry set
   739                                  ;
   740                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   741                                  	global	ds_write
   742                                  ds_write:
   743 00000246 5250                            pushm   ax,dx
   744                                  
   745 00000248 3C1F                    	cmp	al,31
   746 0000024A 7307                    	jae	ds_burstw	; burst or error
   747                                  
   748                                  ; single byte write
   749                                  %if 1
   750 0000024C B4C0                    	mov	ah,1100_0000B   ; RAM/WRITE
   751 0000024E E8DDFF                  	call	byte_write
   752                                  %else
   753                                  	shl	al,1		; prepare command
   754                                          or      al,1100_0000B   ; RAM/WRITE
   755                                  	mov	ah,al		; command byte to AH
   756                                  
   757                                  	call	ds_reset_on	;start of command, set AL & DX
   758                                  	call	ds_reset_off	;prepare for read
   759                                  
   760                                  ; output the command, will turn Reset off
   761                                          call    ds_outb
   762                                  
   763                                          mov     ah,cl		;single byte to write
   764                                          call    ds_outb
   765                                  
   766                                  	call	ds_reset_on	;terminate the write
   767                                  %endif
   768 00000251 EB9B                    	jmp	ds_full_exit
   769                                  	
   770                                  	
   771                                  ; burst write
   772                                  ds_burstw:
   773 00000253 759D                            jne	ds_error	;must be 31 exactly, else error
   774                                  
   775 00000255 5153                    	pushm	bx,cx		;extra save
   776                                  
   777 00000257 E85A00                  	call	ds_reset_on	;reset before command byte
   778 0000025A E86800                  	call	ds_reset_off	;prepare for burst write
   779                                  
   780 0000025D B4FE                    	mov	ah,1111_1110B	;burst write command
   781 0000025F E87000                  	call	ds_outb		;output the command
   782                                  
   783 00000262 B91F00                  	mov	cx,31		;
   784                                  ds_write2:
   785 00000265 268A27                     es	mov	ah,byte [bx]	;get byte to write
   786 00000268 E86700                     	call	ds_outb
   787 0000026B 43                      	inc	bx		;increment
   788 0000026C E2F7                    	loop	ds_write2
   789                                  
   790 0000026E E84300                  	call	ds_reset_on	;terminate the write
   791                                  
   792 00000271 5B59                    	popm	bx,cx
   793 00000273 E978FF                  	jmp	ds_full_exit	;restore & return
   794                                  
   795                                  
   796                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   797                                  ;
   798                                  ; INT 1A
   799                                  ; function 22   Enable/Disable write protect
   800                                  ;
   801                                  ; Enter with:
   802                                  ;       AH      0x22
   803                                  ;       AL      0x80 to set write protect
   804                                  ;		0x00 to disable write protect
   805                                  ;
   806                                  ; Exit with:
   807                                  ;       Carry clear
   808                                  ;
   809                                  ; Error:
   810                                  ;       Carry set
   811                                  ;
   812                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   813                                  wr_protect:
   814 00000276 5250                    	pushm	ax,dx
   815 00000278 A87F                    	test	al,0111_1111B	; only 00,80h allowed
   816 0000027A 0F8574FF                	jnz	ds_error
   817                                  
   818 0000027E 51                      	pushm	cx
   819 0000027F 88C1                    	mov	cl,al		; option to write
   820 00000281 B80780                  	mov	ax, 1000_0000B << 8 | 7	; clock write, reg 7
   821 00000284 E8A7FF                  	call	byte_write
   822 00000287 59                      	popm	cx
   823                                  
   824 00000288 E963FF                  	jmp	ds_full_exit
   825                                  
   826                                  
   827                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   828                                  ;
   829                                  ; INT 1A
   830                                  ; function 23   Set charging parameters
   831                                  ;
   832                                  ; Enter with:
   833                                  ;       AH      0x23
   834                                  ;       AL      charge parameter byte
   835                                  ;
   836                                  ; Exit with:
   837                                  ;       Carry clear
   838                                  ;
   839                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   840                                  ds_set_charge:
   841 0000028B 5250                    	pushm	ax,dx
   842 0000028D 51                      	pushm	cx
   843                                  
   844 0000028E B480                    	mov	ah,1000_0000B	; clock write
   845 00000290 88C1                    	mov	cl,al		; byte to write
   846 00000292 B008                    	mov	al,8
   847 00000294 E897FF                  	call	byte_write
   848 00000297 59                      	popm	cx
   849                                  
   850 00000298 E953FF                  	jmp	ds_full_exit
   851                                  
   852                                  
   853                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   854                                  ;
   855                                  ; INT 1A
   856                                  ; function 24   Get charging parameters
   857                                  ;
   858                                  ; Enter with:
   859                                  ;       AH      0x24
   860                                  ;
   861                                  ; Exit with:
   862                                  ;       AL      charge parameter byte
   863                                  ;       Carry clear
   864                                  ;
   865                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   866                                  	global	ds_get_charge
   867                                  ds_get_charge:
   868 0000029B 5250                    	pushm	ax,dx
   869                                  
   870 0000029D B80881                  	mov	ax,1000_0001B << 8  | 8	; clock read
   871 000002A0 E875FF                  	call	byte_read
   872 000002A3 88E2                    	mov	dl,ah		; save in DL
   873 000002A5 58                      	popm	ax
   874 000002A6 88D0                    	mov	al,dl		; return in AL
   875                                  
   876 000002A8 E944FF                  	jmp	ds_good_exit
   877                                  
   878                                  
   879                                  ;**********
   880                                  ; N.B. These will move to P1 from P3 on the final board
   881                                  ; Jan 2018 -- updated to P1 for rev 2.0 board
   882                                  ;**********
   883                                  DSLTC   equ     P1LTC           ; DS1302 latch
   884                                  DSPIN   equ     P1PIN           ;   pin value
   885                                  
   886                                  DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
   887                                  DSCLK   equ     BIT2            ; Clock idles high
   888                                  DSRST   equ     BIT3            ; Reset idles low (asserted)
   889                                  
   890                                  DSMSK   equ     DSRST+DSCLK+DSDAT
   891                                  
   892                                  
   893                                  %macro  us_delay 0
   894                                  	jmp	$+2
   895                                  	jmp	$+2
   896                                  	jmp	$+2
   897                                  %endmacro
   898                                  
   899                                  
   900 000002AB 90                      	align	2
   901                                  ds_out_latch:
   902 000002AC EE                      	out	dx,al
   903                                  	us_delay
   894 000002AD EB00                <1>  jmp $+2
   895 000002AF EB00                <1>  jmp $+2
   896 000002B1 EB00                <1>  jmp $+2
   904 000002B3 C3                      	ret
   905                                  
   906                                  ;
   907                                  ; initializes the DSLTC in DX
   908                                  ; sets the Clock low, then asserts Reset
   909                                  ;
   910                                  	global	ds_reset_on
   911                                  ds_reset_on:
   912 000002B4 BA62F8                  	mov	dx,DSLTC	;set I/O latch address in DX
   913 000002B7 EC                      	in	al,dx		;get the latch value
   914 000002B8 24FB                    	and	al,~DSCLK	;set the clock low (should be idle state)
   915 000002BA E8EFFF                  	call	ds_out_latch
   916 000002BD 0C01                    	or	al,DSDAT	;set data for input
   917 000002BF 24F7                    	and	al,~DSRST	;assert RESET#
   918 000002C1 E8E8FF                  	call	ds_out_latch
   919 000002C4 C3                      	ret
   920                                  
   921                                  ;
   922                                  ; sets the Clock low, then removes the Reset
   923                                  ;
   924                                  	global	ds_reset_off
   925                                  ds_reset_off:		; assume DX is set
   926 000002C5 24FB                    	and	al,~DSCLK	;set the clock low (idle)
   927 000002C7 0C01                    	or	al,DSDAT	;set data for input
   928 000002C9 E8E0FF                  	call	ds_out_latch
   929 000002CC 0C08                    	or	al,DSRST	;deassert RESET#
   930 000002CE E8DBFF                  	call	ds_out_latch
   931 000002D1 C3                      	ret			;clock idles low
   932                                  
   933                                  ;
   934                                  ; moves output bit into position, and then drops the clock low
   935                                  ; pauses, then sets the clock high to clock in the data bit
   936                                  ; loops back for all 8 bits
   937                                  ; exits with the clock HIGH
   938                                  ;
   939                                  ds_outb:	;output the byte in AH
   940 000002D2 51                      	pushm	cx
   941 000002D3 B90800                  	mov	cx,8		;8 bits go out
   942                                  
   943 000002D6 24FB                    .1:	and	al,~DSCLK	;drop the clock
   944 000002D8 D1E8                    	shr	ax,1		;LSB to AL
   945 000002DA D0C0                    	rol	al,1		;data bit to position
   946 000002DC E8CDFF                  	call	ds_out_latch
   947 000002DF 0C04                    	or	al,DSCLK	
   948 000002E1 E8C8FF                  	call	ds_out_latch
   949 000002E4 E2F0                    	loop	.1
   950                                  
   951 000002E6 59                      	popm	cx
   952 000002E7 C3                         	ret			;clock is high on exit
   953                                  
   954                                  ;
   955                                  ; sets clock High and data bit for input
   956                                  ; pauses, drops the clock, pauses, reads the data bit
   957                                  ; shifts 8 bits into AH from the left, hence LSB ends up in AX bit 8
   958                                  ; exits with the clock low
   959                                  ;
   960                                  ds_inb:		;input a byte to AH
   961 000002E8 51                      	pushm	cx
   962 000002E9 B90800                  	mov	cx,8
   963                                  
   964 000002EC 0C05                    .2:	or	al,DSCLK+DSDAT	;raise the clock, O.C. data set for input
   965 000002EE E8BBFF                  	call	ds_out_latch
   966 000002F1 24FB                    	and	al,~DSCLK	;drop the clock
   967 000002F3 E8B6FF                  	call	ds_out_latch
   968 000002F6 52                      	push	dx
   969 000002F7 BA60F8                     	mov	dx,DSPIN	;set to read data bit
   970 000002FA EC                      	in	al,dx		;data bit to LSB
   971 000002FB 5A                      	pop	dx
   972 000002FC D1C8                    	ror	ax,1		;data to AH MSB
   973 000002FE D0E0                    	shl	al,1		;restore latch value just read in
   974 00000300 E2EA                    	loop	.2
   975                                  
   976 00000302 59                      	popm	cx
   977 00000303 C3                      	ret		; exit with clock Low
   978                                  
   979                                  ; convert packed BCD to binary int
   980                                  ;
   981                                  ;	arg in AL
   982                                  ;
   983                                  ;  int bcd2int(byte bcd);
   984                                  ;
   985                                  	global	bcd2int_
   986                                  bcd2int_:
   987 00000304 88C4                    	mov	ah,al
   988 00000306 C0EC04                  	shr	ah,4		; AH is unpacked high decimal digit
   989 00000309 240F                    	and	al,0x0F		; AL is unpacked low decimal digit
   990 0000030B D50A                    	aad			; convert to integer in AX
   991 0000030D C3                      	ret
   992                                  
   993                                  	global	day_of_week_
   994                                  day_of_week_:	;parameters in BCD
   995                                  ;	CH = century
   996                                  ;	CL = year
   997                                  ;	DH = month
   998                                  ;	DL = day
   999                                  ;
  1000 0000030E 88E8                    	mov	al,ch		;century to AL
  1001 00000310 E8F1FF                  	call	bcd2int_
  1002 00000313 89C3                    	mov	bx,ax
  1003                                  
  1004 00000315 88C8                    	mov	al,cl		;year to AL
  1005 00000317 E8EAFF                  	call	bcd2int_
  1006 0000031A 89C1                    	mov	cx,ax
  1007                                  
  1008 0000031C 88F0                    	mov	al,dh		;month to AL
  1009 0000031E E8E3FF                  	call	bcd2int_
  1010 00000321 92                      	xchg	ax,dx		;month to DX, day to AL
  1011 00000322 E8DFFF                  	call	bcd2int_
  1012 00000325 92                      	xchg	ax,dx		;day to DX, month to AX
  1013                                  
  1014                                  ; fall into 'dow_'
  1015                                  	global	dow_
  1016                                  dow_:
  1017                                  ;	AX = month
  1018                                  ;	DX = day
  1019                                  ;	BX = century
  1020                                  ;	CX = year
  1021                                  ; normalize for calendar starting in March
  1022 00000326 83E803                  	sub	ax,3		;
  1023 00000329 790A                    	jns	.4
  1024 0000032B 83C00C                  	add	ax,12		; month went negative
  1025 0000032E 49                      	dec	cx
  1026 0000032F 7904                    	jns	.4
  1027 00000331 83C164                  	add	cx,100		;
  1028 00000334 4B                      	dec	bx		; year went negative
  1029                                  .4:
  1030                                  ; now calculate
  1031 00000335 01CA                    	add	dx,cx		; D+Y
  1032 00000337 C1E902                  	shr	cx,2		; Y/4
  1033 0000033A 01CA                    	add	dx,cx		; + Y/4
  1034 0000033C 01DA                    	add	dx,bx		; + C
  1035 0000033E C1E302                  	shl	bx,2		; C*4
  1036 00000341 01DA                    	add	dx,bx		; D+Y+Y/4+5*C
  1037 00000343 C1EB04                  	shr	bx,4		; C/4
  1038 00000346 01DA                    	add	dx,bx		; + C/4
  1039 00000348 B90500                  	mov	cx,5		; CX = 5
  1040 0000034B F6F1                    	div	cl		; M/5 to AL, Mrem to AH
  1041 0000034D 88E3                    	mov	bl,ah		; BX = Mrem
  1042 0000034F 2E8A9F[6503]               cs	mov	bl,[dow_tab+bx]
  1043 00000354 01DA                       	add	dx,bx
  1044 00000356 41                      	inc	cx		; CL = 6
  1045 00000357 F6E1                    	mul	cl		; AX = (M/5)*6
  1046 00000359 01D0                    	add	ax,dx		; AX = sum
  1047 0000035B 31D2                    	xor	dx,dx
  1048 0000035D 41                      	inc	cx		; CX = 7
  1049 0000035E 40                      	inc	ax		; bias by 2
  1050 0000035F 40                      	inc	ax		; **
  1051 00000360 F7F1                    	div	cx		; SUM div 7
  1052 00000362 89D0                    	mov	ax,dx		; result to AX
  1053 00000364 C3                      	ret
