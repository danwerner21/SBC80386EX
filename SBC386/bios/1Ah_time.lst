    99                              <1> ; System & Keboard data area */
   100 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   101 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   102                              <1> ; */
   103                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
   104                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
