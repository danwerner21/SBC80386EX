   574                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   575                                  ;
   576                                  ; INT 1A
   577                                  ; function 20   Get NVRAM byte
   578                                  ;
   579                                  ; Enter with:
   580                                  ;       AH      0x20
   581                                  ;       AL      byte number ( 0 <= AL <= 30) 
   582                                  ;   (single byte read)
   583                                  ;
   584                                  ;       AH      0x20
   585                                  ;       AL      31
   586                                  ;       ES:BX   pointer to 31 byte buffer
   587                                  ;   (burst read)
   588                                  ;
   589                                  ; Exit with:
   590                                  ;       AL      byte read (single byte read)
   591                                  ;       Carry clear
   592                                  ;
   593                                  ;       AL      byte NVRAM[30] (burst read)
   594                                  ;       ES:BX buffer filled with bytes 0..30
   595                                  ;
   596                                  ;       Carry clear
   597                                  ;
   598                                  ; Error:
   599                                  ;       Carry set
   600                                  ;
   601                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   602                                  	global	ds_read
   603                                  ds_read:
   604 000001DF 5250                            pushm   ax,dx
   605                                  
   606 000001E1 3C1F                    	cmp	al,31
   607 000001E3 7314                    	jae	ds_burstr	; burst or error
   608                                  	
   609 000001E5 B4C1                    	mov	ah,1100_0001B	; NVRAM read
   610 000001E7 E83100                   	call	byte_read
   611                                  
   612                                  ds_read_exit:
   613 000001EA 88E0                    	mov	al,ah		;return in AL
   614 000001EC 5A                      	pop	dx		;get old ax
   615 000001ED 88F4                    	mov	ah,dh		;restore AH
   616 000001EF EB01                    	jmp	ds_good_exit
   617                                  
   618                                  ds_full_exit:
   619 000001F1 58                      	popm	ax
   620                                  ds_good_exit:
   621 000001F2 F8                      	clc 			;signal good return
   622 000001F3 5A                      	popm	dx
   623 000001F4 C3                      	ret	
   624                                  
   625                                  ds_error:
   626 000001F5 585A                    	popm	ax,dx
   627 000001F7 F9                      	stc
   628 000001F8 C3                      	ret
   629                                  
   630                                  
   631                                  
   632                                  
   633                                  ;
   634                                  ; handle burst read
   635                                  ds_burstr:
   636 000001F9 75FA                            jne	ds_error	;must be 31 exactly, else error
   637                                  
   638 000001FB 5153                    	pushm	bx,cx		;extra save
   639                                  
   640 000001FD E8B600                  	call	ds_reset_on	;reset before command byte
   641 00000200 E8C400                  	call	ds_reset_off	;set for read
   642                                  
   643                                  
   644 00000203 B4FF                    	mov	ah,1111_1111B	;burst read command
   645 00000205 E8CC00                  	call	ds_outb		;output the command
   646                                  
   647 00000208 B91F00                  	mov	cx,31		;
   648                                  ds_read2:
   649 0000020B E8DC00                  	call	ds_inb		;retrieve a byte in AH
   650 0000020E 268827                    es	mov	byte [bx],ah	;save in the array
   651 00000211 43                        	inc	bx
   652 00000212 E2F7                    	loop	ds_read2	;and loop back
   653                                  
   654 00000214 E89F00                  	call	ds_reset_on	;terminate read
   655                                  
   656 00000217 5B59                    	popm	bx,cx		;and restore
   657 00000219 EBCF                            jmp	ds_read_exit	;return AH
   658                                   
   659                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   660                                  ;
   661                                  ; byte read into AH
   662                                  ;	AH = command bits
   663                                  ;	AL = register number
   664                                  ; byte read direct
   665                                  ;	AH = command bits + (reg<<1)
   666                                  ;
   667                                  ; Exit with:
   668                                  ;	AH is the byte read in
   669                                  ;
   670                                  ;  Uses AX, DX
   671                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   672                                  byte_read:
   673                                  ; single byte read
   674 0000021B D0E0                    	shl	al,1		; shift by one
   675 0000021D 08E0                            or      al,ah		; Clock or NVRAM read
   676 0000021F 88C4                    	mov	ah,al		; command byte to AH
   677                                  byte_read_direct:
   678 00000221 E89200                  	call	ds_reset_on	;start of command, set AL & DX
   679 00000224 E8A000                  	call	ds_reset_off	;remove the Reset
   680                                  
   681                                  ; output the command
   682 00000227 E8AA00                          call    ds_outb
   683                                  
   684 0000022A E8BD00                  	call	ds_inb		;input byte to AH
   685                                  
   686 0000022D E88600                  	call	ds_reset_on	;terminate command
   687                                  
   688 00000230 C3                      	ret
   689                                  
   690                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   691                                  ; byte write
   692                                  ;	AH = command bits
   693                                  ;	AL = register number
   694                                  ;	CL = byte value to write
   695                                  ;
   696                                  ; byte_write_direct
   697                                  ;	AH = command, register<<1 included
   698                                  ;	CL = byte value to write
   699                                  ;
   700                                  ;  Uses AX, DX
   701                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   702                                  byte_write:
   703                                  ; single byte write
   704 00000231 D0E0                    	shl	al,1		; prepare command
   705 00000233 08E0                            or      al,ah		; clock or NVRAM write
   706 00000235 88C4                    	mov	ah,al		; command byte to AH
   707                                  byte_write_direct:
   708 00000237 E87C00                  	call	ds_reset_on	;start of command, set AL & DX
   709 0000023A E88A00                  	call	ds_reset_off	;prepare for read
   710                                  
   711                                  ; output the command, will turn Reset off
   712 0000023D E89400                          call    ds_outb
   713                                  
   714 00000240 88CC                            mov     ah,cl		;single byte to write
   715 00000242 E88F00                          call    ds_outb
   716                                  
   717 00000245 E86E00                  	call	ds_reset_on	;terminate the write
   718 00000248 C3                      	ret
   719                                  
   720                                  
   721                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   722                                  ;
   723                                  ; INT 1A
   724                                  ; function 21   Set NVRAM byte
   725                                  ;
   726                                  ; Enter with:
   727                                  ;       AH      0x21
   728                                  ;       AL      byte number ( 0 <= AL <= 30) 
   729                                  ;   (single byte write)
   730                                  ;       CL      byte value to write
   731                                  ;
   732                                  ;       AH      0x21
   733                                  ;       AL      31
   734                                  ;       ES:BX   pointer to 31 byte buffer
   735                                  ;   (burst write)
   736                                  ;
   737                                  ; Exit with:
   738                                  ;       Carry clear
   739                                  ;
   740                                  ; Error:
   741                                  ;       Carry set
   742                                  ;
   743                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   744                                  	global	ds_write
   745                                  ds_write:
   746 00000249 5250                            pushm   ax,dx
   747                                  
   748 0000024B 3C1F                    	cmp	al,31
   749 0000024D 7307                    	jae	ds_burstw	; burst or error
   750                                  
   751                                  ; single byte write
   752                                  %if 1
   753 0000024F B4C0                    	mov	ah,1100_0000B   ; RAM/WRITE
   754 00000251 E8DDFF                  	call	byte_write
   755                                  %else
   756                                  	shl	al,1		; prepare command
   757                                          or      al,1100_0000B   ; RAM/WRITE
   758                                  	mov	ah,al		; command byte to AH
   759                                  
   760                                  	call	ds_reset_on	;start of command, set AL & DX
   761                                  	call	ds_reset_off	;prepare for read
   762                                  
   763                                  ; output the command, will turn Reset off
   764                                          call    ds_outb
   765                                  
   766                                          mov     ah,cl		;single byte to write
   767                                          call    ds_outb
   768                                  
   769                                  	call	ds_reset_on	;terminate the write
   770                                  %endif
   771 00000254 EB9B                    	jmp	ds_full_exit
   772                                  	
   773                                  	
   774                                  ; burst write
   775                                  ds_burstw:
   776 00000256 759D                            jne	ds_error	;must be 31 exactly, else error
   777                                  
   778 00000258 5153                    	pushm	bx,cx		;extra save
   779                                  
   780 0000025A E85900                  	call	ds_reset_on	;reset before command byte
   781 0000025D E86700                  	call	ds_reset_off	;prepare for burst write
   782                                  
   783 00000260 B4FE                    	mov	ah,1111_1110B	;burst write command
   784 00000262 E86F00                  	call	ds_outb		;output the command
   785                                  
   786 00000265 B91F00                  	mov	cx,31		;
   787                                  ds_write2:
   788 00000268 268A27                     es	mov	ah,byte [bx]	;get byte to write
   789 0000026B E86600                     	call	ds_outb
   790 0000026E 43                      	inc	bx		;increment
   791 0000026F E2F7                    	loop	ds_write2
   792                                  
   793 00000271 E84200                  	call	ds_reset_on	;terminate the write
   794                                  
   795 00000274 5B59                    	popm	bx,cx
   796 00000276 E978FF                  	jmp	ds_full_exit	;restore & return
   797                                  
   798                                  
   799                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   800                                  ;
   801                                  ; INT 1A
   802                                  ; function 22   Enable/Disable write protect
   803                                  ;
   804                                  ; Enter with:
   805                                  ;       AH      0x22
   806                                  ;       AL      0x80 to set write protect
   807                                  ;		0x00 to disable write protect
   808                                  ;
   809                                  ; Exit with:
   810                                  ;       Carry clear
   811                                  ;
   812                                  ; Error:
   813                                  ;       Carry set
   814                                  ;
   815                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   816                                  wr_protect:
   817 00000279 5250                    	pushm	ax,dx
   818 0000027B A87F                    	test	al,0111_1111B	; only 00,80h allowed
   819 0000027D 0F8574FF                	jnz	ds_error
   820                                  
   821 00000281 51                      	pushm	cx
   822 00000282 88C1                    	mov	cl,al		; option to write
   823 00000284 B80780                  	mov	ax, 1000_0000B << 8 | 7	; clock write, reg 7
   824 00000287 E8A7FF                  	call	byte_write
   825 0000028A 59                      	popm	cx
   826                                  
   827 0000028B E963FF                  	jmp	ds_full_exit
   828                                  
   829                                  
   830                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   831                                  ;
   832                                  ; INT 1A
   833                                  ; function 23   Set charging parameters
   834                                  ;
   835                                  ; Enter with:
   836                                  ;       AH      0x23
   837                                  ;       AL      charge parameter byte
   838                                  ;
   839                                  ; Exit with:
   840                                  ;       Carry clear
   841                                  ;
   842                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   843                                  ds_set_charge:
   844 0000028E 5250                    	pushm	ax,dx
   845 00000290 51                      	pushm	cx
   846                                  
   847 00000291 B480                    	mov	ah,1000_0000B	; clock write
   848 00000293 88C1                    	mov	cl,al		; byte to write
   849 00000295 B008                    	mov	al,8
   850 00000297 E897FF                  	call	byte_write
   851 0000029A 59                      	popm	cx
   852                                  
   853 0000029B E953FF                  	jmp	ds_full_exit
   854                                  
   855                                  
   856                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   857                                  ;
   858                                  ; INT 1A
   859                                  ; function 24   Get charging parameters
   860                                  ;
   861                                  ; Enter with:
   862                                  ;       AH      0x24
   863                                  ;
   864                                  ; Exit with:
   865                                  ;       AL      charge parameter byte
   866                                  ;       Carry clear
   867                                  ;
   868                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   869                                  	global	ds_get_charge
   870                                  ds_get_charge:
   871 0000029E 5250                    	pushm	ax,dx
   872                                  
   873 000002A0 B80881                  	mov	ax,1000_0001B << 8  | 8	; clock read
   874 000002A3 E875FF                  	call	byte_read
   875 000002A6 88E2                    	mov	dl,ah		; save in DL
   876 000002A8 58                      	popm	ax
   877 000002A9 88D0                    	mov	al,dl		; return in AL
   878                                  
   879 000002AB E944FF                  	jmp	ds_good_exit
   880                                  
   881                                  
   882                                  ;**********
   883                                  ; N.B. These will move to P1 from P3 on the final board
   884                                  ; Jan 2018 -- updated to P1 for rev 2.0 board
   885                                  ;**********
   886                                  DSLTC   equ     P1LTC           ; DS1302 latch
   887                                  DSPIN   equ     P1PIN           ;   pin value
   888                                  
   889                                  DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
   890                                  DSCLK   equ     BIT2            ; Clock idles high
   891                                  DSRST   equ     BIT3            ; Reset idles low (asserted)
   892                                  
   893                                  DSMSK   equ     DSRST+DSCLK+DSDAT
   894                                  
   895                                  
   896                                  %macro  us_delay 0
   897                                  	jmp	$+2
   898                                  	jmp	$+2
   899                                  	jmp	$+2
   900                                  %endmacro
   901                                  
   902                                  
   903                                  	align	2
   904                                  ds_out_latch:
   905 000002AE EE                      	out	dx,al
   906                                  	us_delay
   897 000002AF EB00                <1>  jmp $+2
   898 000002B1 EB00                <1>  jmp $+2
   899 000002B3 EB00                <1>  jmp $+2
   907 000002B5 C3                      	ret
   908                                  
   909                                  ;
   910                                  ; initializes the DSLTC in DX
   911                                  ; sets the Clock low, then asserts Reset
   912                                  ;
   913                                  	global	ds_reset_on
   914                                  ds_reset_on:
   915 000002B6 BA62F8                  	mov	dx,DSLTC	;set I/O latch address in DX
   916 000002B9 EC                      	in	al,dx		;get the latch value
   917 000002BA 24FB                    	and	al,~DSCLK	;set the clock low (should be idle state)
   918 000002BC E8EFFF                  	call	ds_out_latch
   919 000002BF 0C01                    	or	al,DSDAT	;set data for input
   920 000002C1 24F7                    	and	al,~DSRST	;assert RESET#
   921 000002C3 E8E8FF                  	call	ds_out_latch
   922 000002C6 C3                      	ret
   923                                  
   924                                  ;
   925                                  ; sets the Clock low, then removes the Reset
   926                                  ;
   927                                  	global	ds_reset_off
   928                                  ds_reset_off:		; assume DX is set
   929 000002C7 24FB                    	and	al,~DSCLK	;set the clock low (idle)
   930 000002C9 0C01                    	or	al,DSDAT	;set data for input
   931 000002CB E8E0FF                  	call	ds_out_latch
   932 000002CE 0C08                    	or	al,DSRST	;deassert RESET#
   933 000002D0 E8DBFF                  	call	ds_out_latch
   934 000002D3 C3                      	ret			;clock idles low
   935                                  
   936                                  ;
   937                                  ; moves output bit into position, and then drops the clock low
   938                                  ; pauses, then sets the clock high to clock in the data bit
   939                                  ; loops back for all 8 bits
   940                                  ; exits with the clock HIGH
   941                                  ;
   942                                  ds_outb:	;output the byte in AH
   943 000002D4 51                      	pushm	cx
   944 000002D5 B90800                  	mov	cx,8		;8 bits go out
   945                                  
   946 000002D8 24FB                    .1:	and	al,~DSCLK	;drop the clock
   947 000002DA D1E8                    	shr	ax,1		;LSB to AL
   948 000002DC D0C0                    	rol	al,1		;data bit to position
   949 000002DE E8CDFF                  	call	ds_out_latch
   950 000002E1 0C04                    	or	al,DSCLK	
   951 000002E3 E8C8FF                  	call	ds_out_latch
   952 000002E6 E2F0                    	loop	.1
   953                                  
   954 000002E8 59                      	popm	cx
   955 000002E9 C3                         	ret			;clock is high on exit
   956                                  
   957                                  ;
   958                                  ; sets clock High and data bit for input
   959                                  ; pauses, drops the clock, pauses, reads the data bit
   960                                  ; shifts 8 bits into AH from the left, hence LSB ends up in AX bit 8
   961                                  ; exits with the clock low
   962                                  ;
   963                                  ds_inb:		;input a byte to AH
   964 000002EA 51                      	pushm	cx
   965 000002EB B90800                  	mov	cx,8
   966                                  
   967 000002EE 0C05                    .2:	or	al,DSCLK+DSDAT	;raise the clock, O.C. data set for input
   968 000002F0 E8BBFF                  	call	ds_out_latch
   969 000002F3 24FB                    	and	al,~DSCLK	;drop the clock
   970 000002F5 E8B6FF                  	call	ds_out_latch
   971 000002F8 52                      	push	dx
   972 000002F9 BA60F8                     	mov	dx,DSPIN	;set to read data bit
   973 000002FC EC                      	in	al,dx		;data bit to LSB
   974 000002FD 5A                      	pop	dx
   975 000002FE D1C8                    	ror	ax,1		;data to AH MSB
   976 00000300 D0E0                    	shl	al,1		;restore latch value just read in
   977 00000302 E2EA                    	loop	.2
   978                                  
   979 00000304 59                      	popm	cx
   980 00000305 C3                      	ret		; exit with clock Low
   981                                  
   982                                  ; convert packed BCD to binary int
   983                                  ;
   984                                  ;	arg in AL
   985                                  ;
   986                                  ;  int bcd2int(byte bcd);
   987                                  ;
   988                                  	global	bcd2int_
   989                                  bcd2int_:
   990 00000306 88C4                    	mov	ah,al
   991 00000308 C0EC04                  	shr	ah,4		; AH is unpacked high decimal digit
   992 0000030B 240F                    	and	al,0x0F		; AL is unpacked low decimal digit
   993 0000030D D50A                    	aad			; convert to integer in AX
   994 0000030F C3                      	ret
   995                                  
   996                                  	global	day_of_week_
   997                                  day_of_week_:	;parameters in BCD
   998                                  ;	CH = century
   999                                  ;	CL = year
  1000                                  ;	DH = month
  1001                                  ;	DL = day
  1002                                  ;
  1003 00000310 88E8                    	mov	al,ch		;century to AL
  1004 00000312 E8F1FF                  	call	bcd2int_
  1005 00000315 89C3                    	mov	bx,ax
  1006                                  
  1007 00000317 88C8                    	mov	al,cl		;year to AL
  1008 00000319 E8EAFF                  	call	bcd2int_
  1009 0000031C 89C1                    	mov	cx,ax
  1010                                  
  1011 0000031E 88F0                    	mov	al,dh		;month to AL
  1012 00000320 E8E3FF                  	call	bcd2int_
  1013 00000323 92                      	xchg	ax,dx		;month to DX, day to AL
  1014 00000324 E8DFFF                  	call	bcd2int_
  1015 00000327 92                      	xchg	ax,dx		;day to DX, month to AX
  1016                                  
  1017                                  ; fall into 'dow_'
  1018                                  	global	dow_
  1019                                  dow_:
  1020                                  ;	AX = month
  1021                                  ;	DX = day
  1022                                  ;	BX = century
  1023                                  ;	CX = year
  1024                                  ; normalize for calendar starting in March
  1025 00000328 83E803                  	sub	ax,3		;
  1026 0000032B 790A                    	jns	.4
  1027 0000032D 83C00C                  	add	ax,12		; month went negative
  1028 00000330 49                      	dec	cx
  1029 00000331 7904                    	jns	.4
  1030 00000333 83C164                  	add	cx,100		;
  1031 00000336 4B                      	dec	bx		; year went negative
  1032                                  .4:
  1033                                  ; now calculate
  1034 00000337 01CA                    	add	dx,cx		; D+Y
  1035 00000339 C1E902                  	shr	cx,2		; Y/4
  1036 0000033C 01CA                    	add	dx,cx		; + Y/4
  1037 0000033E 01DA                    	add	dx,bx		; + C
  1038 00000340 C1E302                  	shl	bx,2		; C*4
  1039 00000343 01DA                    	add	dx,bx		; D+Y+Y/4+5*C
  1040 00000345 C1EB04                  	shr	bx,4		; C/4
  1041 00000348 01DA                    	add	dx,bx		; + C/4
  1042 0000034A B90500                  	mov	cx,5		; CX = 5
  1043 0000034D F6F1                    	div	cl		; M/5 to AL, Mrem to AH
  1044 0000034F 88E3                    	mov	bl,ah		; BX = Mrem
  1045 00000351 2E8A9F[6703]               cs	mov	bl,[dow_tab+bx]
  1046 00000356 01DA                       	add	dx,bx
  1047 00000358 41                      	inc	cx		; CL = 6
  1048 00000359 F6E1                    	mul	cl		; AX = (M/5)*6
  1049 0000035B 01D0                    	add	ax,dx		; AX = sum
  1050 0000035D 31D2                    	xor	dx,dx
  1051 0000035F 41                      	inc	cx		; CX = 7
  1052 00000360 40                      	inc	ax		; bias by 2
  1053 00000361 40                      	inc	ax		; **
  1054 00000362 F7F1                    	div	cx		; SUM div 7
  1055 00000364 89D0                    	mov	ax,dx		; result to AX
  1056 00000366 C3                      	ret
