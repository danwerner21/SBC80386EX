    62                              <1> ;
    63                              <1> ;include "i386EX.inc" -- must be included at a higher level
    64                              <1> 
    65                              <1> TIMER_STOP	equ	BIT6+BIT0 + ZBIT1 + ZBIT3 + ZBIT5 ; stop 0, 1, 2
    66                              <1> TIMER_RUN	equ	TIMER_STOP + BIT1 + BIT3	; run counters 0, 1
    67                              <1> 
    68                              <1>         binit   TMRCFG, ZBIT7+TIMER_STOP ; bit6: s/w control of GATEn, bit7=0 enables all clocks
   111 00000000 34F8                <2>  dw %1
   112 00000002 41                  <2>  db %2
    69                              <1> 		;Timers enabled, 1&2 use PSCLK, 0 uses TMRCLK0 (COMCLK/2)
    70                              <1> CTR0 equ ZBIT7+ZBIT6	;select counter 0
    71                              <1> CTR1 equ ZBIT7+ BIT6	;select counter 1
    72                              <1> CTR2 equ  BIT7+ZBIT6	;select counter 2
    73                              <1> CWR01 equ BIT5+BIT4	;Write Count low, then high
    74                              <1> MODE0 equ ZBIT3+ZBIT2+ZBIT1
    75                              <1> MODE1 equ ZBIT3+ZBIT2+ BIT1
    76                              <1> MODE2 equ ZBIT3+ BIT2+ZBIT1
    77                              <1> MODE3 equ ZBIT3+ BIT2+ BIT1
    78                              <1> MODE4 equ  BIT3+ZBIT2+ZBIT1
    79                              <1> MODE5 equ  BIT3+ZBIT2+ BIT1
    80                              <1> ; counter 0 runs at 1.8432mhz / 2  =  921600  (just under 1mhz)
    81                              <1> ; @20hz, the divisor is 46080 yielding a 50ms time slot
    82                              <1> COMCLK	equ	1843200		; standard 1.8432mhz oscillator
    83                              <1> BAUD	equ	9600		; default SIO0 bit rate
    84                              <1> DIVISOR	equ	COMCLK/16/BAUD	; SIO0 divisor to achieve BAUD rate
    85                              <1> CLKIN0	equ	COMCLK/2	; Timer0 input count rate
    86                              <1> MS50	equ	CLKIN0 / 20	; 50ms clock
    87                              <1> MS50HI	equ	MS50/256
    88                              <1> MS50LO	equ	MS50 & 0xFF
    89                              <1> MS18	equ	50619		; 18.206602hz clock (54.92513ms)
    90                              <1> 				; 0x1800BA = 1573050 ticks/day
    91                              <1> MS18b	equ	50625		; 18.204444hz clock (54.93164ms)
    92                              <1> 				; 0x180000 = 1572864 ticks/day
    93                              <1> MS18HI	equ	MS18/256
    94                              <1> MS18LO	equ	MS18 & 0xFF
    34                                  
    35                                  
    36                                  %ifndef DEBUG
    37                                  %define	DEBUG 1
    38                                  %endif
    39                                  
    40                                  	global	int_1Ah
    41                                  
    42                                  segment	_TEXT
    43                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    44                                  ;
    45                                  ; INT 1A
    46                                  ;
    47                                  ; Enter with:
    48                                  ;       AH      function code
    49                                  ;
    50                                  ; Exit with:
    51                                  ;	varies
    52                                  ;
    53                                  ;       Carry clear
    54                                  ;
    55                                  ; Error:
    56                                  ;	AH	error code
    57                                  ;       Carry set
    58                                  ;
    59                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    60                                  int_1Ah:
    61 00000000 FB                      	sti			;turn on interrupts
    62 00000001 56                      	pushm	si
    63                                  
    64 00000002 89C6                    	mov	si,ax		; can't use BX for certain calls
    65 00000004 C1EE08                  	shr	si,8		; zero fill high bits
    66 00000007 01F6                    	add	si,si		; address words
    67                                  
    68 00000009 83FE10                  	cmp	si,len_dispatch0  ; length is in words
    69 0000000C 720F                    	jb	low_dispatch2
    70                                  
    71 0000000E 83EE40                  	sub	si,0x20 * 2	; calls based at 20h
    72 00000011 83FE0A                  	cmp	si,len_dispatch20  ; length is in words
    73 00000014 720E                    	jb	exec20_dispatch
    74                                  
    75                                  fn_not_defined:
    76 00000016 B486                    	mov	ah,0x86		;function not defined
    77 00000018 F9                      	stc
    78                                  exit:	
    79 00000019 5E                      	popm	si
    80 0000001A CA0200                  	retf	2		;return from call
    81                                  
    82                                  low_dispatch2:
    83 0000001D 2EFF94[2C00]               cs	call	[dispatch0 + si]
    84 00000022 EBF5                    	jmp	exit
    85                                  
    86                                  exec20_dispatch:
    87 00000024 2EFF94[3C00]               cs	call	[dispatch20 + si]
    88 00000029 EBEE                    	jmp	exit
    89                                  
    90                                  
    91                                  
    92 0000002B 90                      	align	2
    93                                  dispatch0:
    94 0000002C [6200]                  	dw	get_tick_count
    95 0000002E [E000]                  	dw	set_tick_count
    96 00000030 [F600]                  	dw	get_time
    97 00000032 [2801]                  	dw	set_time
    98 00000034 [5901]                  	dw	get_date
    99 00000036 [8F01]                  	dw	set_date
   100 00000038 [4600]                  	dw	set_alarm
   101 0000003A [4600]                  	dw	reset_alarm
   102                                  len_dispatch0	equ	$-dispatch0
   103                                  
   104                                  dispatch20:
   105 0000003C [D201]                  	dw	ds_read		; 20h
   106 0000003E [3C02]                  	dw	ds_write	; 21h
   107 00000040 [6C02]                  	dw	wr_protect	; 22h
   108 00000042 [8102]                  	dw	ds_set_charge	; 23h
   109 00000044 [9102]                  	dw	ds_get_charge	; 24h
   110                                  len_dispatch20	equ	$-dispatch20
   111                                  
   112                                  set_alarm:
   113                                  reset_alarm:
   114 00000046 EBCE                    	jmp	fn_not_defined
   115                                  ;
   116                                  
   117                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   118                                  ; diagnostic aid
   119                                  ;	AL = read command
   120                                  ; 	AX has byte read in AL
   121                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   122                                  	global	ds_read_reg_
   123                                  ds_read_reg_:
   124 00000048 52                      	pushm	dx
   125 00000049 88C4                    	mov	ah,al			; move command to position
   126 0000004B 80CC81                  	or	ah,1000_0001B
   127 0000004E E85902                  	call	ds_reset_on
   128 00000051 E86702                  	call	ds_reset_off
   129 00000054 E87102                  	call	ds_outb
   130 00000057 E88402                  	call	ds_inb
   131 0000005A E84D02                  	call	ds_reset_on
   132 0000005D C1E808                  	shr	ax,8			; return byte value
   133 00000060 5A                      	popm	dx
   134 00000061 C3                      	ret
   135                                  
   136                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   137                                  ; INT 1A
   138                                  ; function 00	get_tick_count
   139                                  ;
   140                                  ;    Enter with:
   141                                  ;	AH	00h
   142                                  ;
   143                                  ;    Exit with:
   144                                  ;	CX:DX	tick count
   145                                  ;	AL	rolled over flag  0=no	1=day rollover
   146                                  ;
   147                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   148                                  	align	2
   149                                  get_tick_count:
   150 00000062 1E                      	push	ds		;save
   151 00000063 6A401F                  	get_bda	DS
   152 00000066 FA                      	cli		;disable interrupts
   153 00000067 8B166C00                	mov	dx,[timer_count_low]
   154 0000006B 8B0E6E00                	mov	cx,[timer_count_high]
   155 0000006F 30C0                    	xor	al,al
   156 00000071 86067000                	xchg	al,[timer_overflow]
   157 00000075 FB                      	sti		;restore interrupts
   158 00000076 F8                      	clc
   159 00000077 1F                      	pop	ds
   160 00000078 C3                      	ret
   161                                  
   162                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   163                                  ; Timer 0 interrupt handler
   164                                  ;
   165                                  ;	Count down the tick timer
   166                                  ;	Reset if it reaches zero
   167                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   168                                  	global	int_irq0
   169 00000079 90                      	align	2
   170                                  
   171                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   172                                  ; A heartbeat, for telling a hung machine from a halted one.
   173                                  ;
   174                                  ; Writes a character to the console about once a second from the timer
   175                                  ; tick.  If it keeps sounding through a lockup then interrupts are alive
   176                                  ; and whatever is stuck is a software loop; if it stops, the tick is not
   177                                  ; arriving at all, and nothing polled will ever recover the machine.  That
   178                                  ; is the difference between a bug to find and a machine to reset, and once
   179                                  ; the console has stopped answering there is no other way to tell.
   180                                  ;
   181                                  ; It is sounded twice, on either side of the INT 1Ch hook, because a hook
   182                                  ; that hangs would silence a single beat placed after it and look exactly
   183                                  ; like a dead tick.  Two characters separate the three cases:
   184                                  ;
   185                                  ;	"~+"	the tick is arriving and the hook returns -- look elsewhere
   186                                  ;	"~"	the tick arrives, the INT 1Ch hook never comes back
   187                                  ;	nothing	the tick is not being delivered: IF clear, IRQ0 masked,
   188                                  ;		 counter 0 stopped, or the CPU halted
   189                                  ;
   190                                  ; Both beats test the same not-yet-incremented count, so they pair up.
   191                                  ; INT 14h transmit is polled, so this works whatever else has failed.
   192                                  ;
   193                                  ; Debugging aid: TICK_BEAT belongs at 0 in any ROM anyone relies on.
   194                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   195                                  %define TICK_BEAT 0
   196                                  
   197                                  %macro	beat 1
   198                                  %if TICK_BEAT
   199                                  	pushm	ax,dx,ds		; irq0 has saved nothing yet
   200                                  	get_bda	DS
   201                                  	test	word [timer_count_low],0x000F	; every sixteenth tick
   202                                  	jnz	%%quiet
   203                                  	mov	al,%1
   204                                  	mov	ah,1			; INT 14h, write a character
   205                                  	xor	dx,dx			; COM1
   206                                  	int	0x14
   207                                  %%quiet:
   208                                  	popm	ax,dx,ds
   209                                  %endif
   210                                  %endmacro
   211                                  
   212                                  int_irq0:
   213 0000007A FC                      	cld			; insurance
   214                                  	beat	'~'
   198                              <1> %if TICK_BEAT
   199                              <1>  pushm ax,dx,ds
   200                              <1>  get_bda DS
   201                              <1>  test word [timer_count_low],0x000F
   202                              <1>  jnz %%quiet
   203                              <1>  mov al,%1
   204                              <1>  mov ah,1
   205                              <1>  xor dx,dx
   206                              <1>  int 0x14
   207                              <1> %%quiet:
   208                              <1>  popm ax,dx,ds
   209                              <1> %endif
   215 0000007B CD1C                    	int	0x1C
   216                                  	beat	'+'
   198                              <1> %if TICK_BEAT
   199                              <1>  pushm ax,dx,ds
   200                              <1>  get_bda DS
   201                              <1>  test word [timer_count_low],0x000F
   202                              <1>  jnz %%quiet
   203                              <1>  mov al,%1
   204                              <1>  mov ah,1
   205                              <1>  xor dx,dx
   206                              <1>  int 0x14
   207                              <1> %%quiet:
   208                              <1>  popm ax,dx,ds
   209                              <1> %endif
   217                                  
   218 0000007D 1E5153                  	pushm	bx,cx,ds
   219 00000080 6A401F                  	get_bda	DS
   220 00000083 B90800                  	mov	cx,8		; will be used later
   221                                  
   222 00000086 66FF066C00              	inc	dword [timer_count]
   223                                  
   224 0000008B 66813E6C00BA001800      	cmp	dword [timer_count],tick
   225 00000094 720E                    	jb	.2
   226                                  ; tick went to zero (or negative)
   227 00000096 C606700001              	mov	byte [timer_overflow],1
   228 0000009B 66C7066C0000000000      	mov	dword [timer_count],0
   229                                  .2:
   230                                  ; handle the FDC motor timeout
   231 000000A4 382E4000                	cmp	[motor_count],ch	; CH==0
   232 000000A8 7409                    	je	.3
   233 000000AA FE0E4000                	dec	byte [motor_count]
   234 000000AE 7503                    	jnz	.3
   235                                  	extern	FDC_stop_motor	; in diskfdc.asm
   236 000000B0 E8(0000)                	call	FDC_stop_motor
   237                                  .3:
   238                                  ; handle the printer & serial line timeouts
   239 000000B3 BB7800                  	mov	bx,printer_timeout	; 4 printer, 4 serial timeouts
   240 000000B6 382F                    .4:	cmp	byte [bx],ch
   241 000000B8 7402                    	je	.5
   242 000000BA FE0F                    	dec	byte [bx]
   243 000000BC 43                      .5:	inc	bx
   244 000000BD E2F7                    	loop	.4
   245                                  
   246                                  ; restore before clearing the interrupt
   247 000000BF 5B591F                  	popm	bx,cx,ds
   248                                  
   249                                  	extern	clear_irq0	; currently in stub.asm
   250 000000C2 E9(0000)                	jmp	clear_irq0
   251                                  
   252                                  
   253                                  ; Timer 0 constants
   254                                  ;
   255                                  divide	equ	MS18 		; 50619
   256                                  tick	equ	CLKIN0*86400/divide
   257                                  ttime	equ	(divide*1000000)/(CLKIN0)
   258                                  
   259                                  
   260                                  t0tab:
   261                                  	binit	TMRCON, CTR0 + CWR01 + MODE2 + ZBIT0	;binary
   111 000000C5 43F0                <1>  dw %1
   112 000000C7 34                  <1>  db %2
   262                                  	binit	TMR0, MS18LO	;low byte
   111 000000C8 40F0                <1>  dw %1
   112 000000CA BB                  <1>  db %2
   263                                  	binit	TMR0, MS18HI	;high byte = 46080
   111 000000CB 40F0                <1>  dw %1
   112 000000CD C5                  <1>  db %2
   264                                  	binit	TMRCFG, TIMER_STOP + BIT1		; start timer 0
   111 000000CE 34F8                <1>  dw %1
   112 000000D0 43                  <1>  db %2
   265 000000D1 FFFF                            dw      -1
   266                                  
   267                                  ; Timer 0 startup
   268                                  ;
   269                                  	global	start_timer0_
   270                                  	extern	initb			; in start.asm
   271                                  start_timer0_:
   272 000000D3 561E                    	pushm	ds,si
   273 000000D5 0E                      	push	cs
   274 000000D6 1F                      	pop	ds
   275 000000D7 BE[C500]                	mov	si,t0tab
   276 000000DA E8(0000)                	call	initb
   277 000000DD 1F5E                    	popm	ds,si
   278 000000DF C3                      	ret
   279                                  
   280                                  
   281                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   282                                  ; INT 1A
   283                                  ; function 01	set_tick_count
   284                                  ;
   285                                  ;    Enter with:
   286                                  ;	AH	01h
   287                                  ;	CX:DX	tick count
   288                                  ;
   289                                  ;    Exit with:
   290                                  ;	nothing
   291                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   292                                  set_tick_count:
   293 000000E0 1E                      	push	ds
   294 000000E1 6A401F                  	get_bda	DS	;address BDA
   295 000000E4 FA                      	cli		;disable interrupts
   296 000000E5 89166C00                	mov	[timer_count_low],dx
   297 000000E9 890E6E00                	mov	[timer_count_high],cx
   298 000000ED C606700000              	mov	byte [timer_overflow],0	; 'byte' qualifier needed
   299 000000F2 FB                      	sti		;interrupts back on
   300 000000F3 F8                      	clc
   301 000000F4 1F                      	pop	ds
   302 000000F5 C3                      	ret
   303                                  
   304                                  
   305                                  
   306                                  
   307                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   308                                  ;
   309                                  ; INT 1A
   310                                  ; function 02   Get Time
   311                                  ;
   312                                  ; Enter with:
   313                                  ;       AH      0x02
   314                                  ;
   315                                  ; Exit with:
   316                                  ;	CH	hours in BCD
   317                                  ;	CL	minutes in BCD
   318                                  ;	DH	seconds in BCD
   319                                  ;	DL	daylight savings time flag
   320                                  ;		  00=not DST, 01==DST
   321                                  ;	
   322                                  ;       Carry clear	if clock is running
   323                                  ;
   324                                  ; Error:
   325                                  ;       Carry set	if clock is stopped
   326                                  ;
   327                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   328                                  	global	get_time
   329                                  get_time:
   330 000000F6 50                      	pushm	ax
   331 000000F7 31DB                    	xor	bx,bx		; saved at a higher level
   332 000000F9 B80081                  	mov	ax, 1000_0001B << 8 | 0		;seconds
   333 000000FC 88C2                    	mov	dl,al		; DST off
   334 000000FE E80D01                  	call	byte_read
   335 00000101 88E6                    	mov	dh,ah		; save seconds
   336                                  
   337 00000103 52                      .1:	push	dx
   338 00000104 B80181                  	mov	ax, 1000_0001B << 8 | 1		; minutes
   339 00000107 E80401                  	call	byte_read
   340 0000010A 88E1                    	mov	cl,ah		; save minutes
   341 0000010C B80281                  	mov	ax, 1000_0001B << 8 | 2		; hours
   342 0000010F E8FC00                  	call	byte_read
   343 00000112 88E5                    	mov	ch,ah		; save hours
   344 00000114 B80081                  	mov	ax, 1000_0001B << 8 | 0		;seconds
   345 00000117 E8F400                  	call	byte_read
   346 0000011A 5A                      	pop	dx
   347 0000011B 86F4                    	xchg	dh,ah
   348 0000011D 38F4                    	cmp	ah,dh
   349 0000011F 75E2                    	jne	.1		; loop back
   350                                  
   351 00000121 80E67F                  	and	dh,0x7F		; mask clock halt bit
   352 00000124 00E4                    	add	ah,ah		; set carry if halted
   353                                  
   354 00000126 58                      	popm	ax
   355 00000127 C3                      	ret
   356                                  
   357                                  
   358                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   359                                  ;
   360                                  ; INT 1A
   361                                  ; function 03   Set Time
   362                                  ;
   363                                  ; Enter with:
   364                                  ;       AH      0x03
   365                                  ;
   366                                  ;	CH	hours in BCD
   367                                  ;	CL	minutes in BCD
   368                                  ;	DH	seconds in BCD
   369                                  ;	DL	daylight savings time flag (ignored)
   370                                  ;		  00=not DST, 01==DST
   371                                  ;	
   372                                  ; Exit with:
   373                                  ;       Carry clear	if clock is running
   374                                  ;
   375                                  ; Error:
   376                                  ;       Carry set	if clock is stopped
   377                                  ;
   378                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   379                                  	global	set_time
   380                                  set_time:
   381 00000128 5250                    	pushm	ax,dx
   382                                  
   383 0000012A 5251                    	pushm	cx,dx		;protect the parameters
   384                                  
   385 0000012C B000                    	mov	al,0		;disable write protect
   386 0000012E E83B01                  	call	wr_protect	;**
   387                                  %if 0
   388                                  	mov	ax, 1000_0000B << 8 | 0		;seconds
   389                                  	mov	cl,80h			; stop the clock
   390                                  	call	byte_write
   391                                  %endif
   392 00000131 5B                      	popm	bx		; was CX
   393                                  
   394 00000132 B80280                  	mov	ax, 1000_0000B << 8 | 2		;hours
   395 00000135 88F9                    	mov	cl,bh		; **
   396 00000137 80E17F                  	and	cl,0x7F		; 24-hr format
   397 0000013A E8E700                  	call	byte_write
   398                                  
   399 0000013D B80180                  	mov	ax, 1000_0000B << 8 | 1		;minutes
   400 00000140 88D9                    	mov	cl,bl		; **
   401 00000142 E8DF00                  	call	byte_write
   402                                  
   403 00000145 5B                      	popm	bx		; was DX
   404                                  
   405 00000146 B80080                  	mov	ax, 1000_0000B << 8 | 0		;seconds
   406 00000149 88F9                    	mov	cl,bh
   407 0000014B 80E17F                  	and	cl,0x7F			; enable the clock
   408 0000014E E8D300                  	call	byte_write
   409                                  
   410 00000151 B080                    	mov	al,80h		;set Write Protect
   411 00000153 E81601                  	call	wr_protect
   412                                  
   413 00000156 E98B00                  	jmp	ds_full_exit
   414                                  
   415                                  
   416                                  
   417                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   418                                  ;
   419                                  ; INT 1A
   420                                  ; function 04   Get Date
   421                                  ;
   422                                  ; Enter with:
   423                                  ;       AH      0x04
   424                                  ;
   425                                  ; Exit with:
   426                                  ;	CH	century in BCD
   427                                  ;	CL	year in BCD
   428                                  ;	DH	month in BCD
   429                                  ;	DL	day in BCD
   430                                  ;	
   431                                  ;       Carry clear	if clock is running
   432                                  ;
   433                                  ; Error:
   434                                  ;       Carry set	if clock is stopped
   435                                  ;
   436                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   437                                  	global	get_date
   438                                  get_date:
   439 00000159 B80681                  	mov	ax,1000_0001B << 8 | 6	;year
   440 0000015C E8AF00                  	call	byte_read
   441 0000015F 88E1                    	mov	cl,ah		; return in CL
   442                                  
   443 00000161 B80481                  	mov	ax,1000_0001B << 8 | 4	;month
   444 00000164 E8A700                  	call	byte_read
   445 00000167 88E7                    	mov	bh,ah		; save in BH
   446                                  
   447 00000169 B80381                  	mov	ax,1000_0001B << 8 | 3	;day of month (DATE)
   448 0000016C E89F00                  	call	byte_read
   449 0000016F 88E3                    	mov	bl,ah
   450                                  	
   451 00000171 B80581                  	mov	ax,1000_0001B << 8 | 5	;day of week (DAY)
   452 00000174 E89700                  	call	byte_read
   453 00000177 88E5                    	mov	ch,ah		; save in Century byte
   454                                  
   455 00000179 B80081                  	mov	ax,1000_0001B << 8 | 0	;clock halt flag
   456 0000017C E88F00                  	call	byte_read
   457                                  ; clock halt flag is in AH
   458                                  
   459 0000017F 89DA                    	mov	dx,bx		;
   460 00000181 88E8                    	mov	al,ch		; Day-of-Week flag to AL
   461 00000183 B519                    	mov	ch,0x19		; 20th century in CH
   462 00000185 80F970                  	cmp	cl,0x70		; year less than '70 sets carry
   463                                  %if 0
   464                                  	adc	al,0		; add in the carry if CL<70h
   465                                  	daa			; correct (DAA doesn't work???)
   466                                  %else
   467 00000188 7302                    	jnb	.8
   468 0000018A B520                    	mov	ch,0x20		; carry is set
   469                                  .8:
   470                                  %endif
   471 0000018C D0E4                    	shl	ah,1		; clock halt to carry
   472 0000018E C3                      	ret
   473                                  
   474                                  
   475                                  
   476                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   477                                  ;
   478                                  ; INT 1A
   479                                  ; function 05   Set Date
   480                                  ;
   481                                  ; Enter with:
   482                                  ;       AH      0x05
   483                                  ;
   484                                  ;	CH	century in BCD	(used for Day Of Week calculation)
   485                                  ;	CL	year in BCD
   486                                  ;	DH	month in BCD
   487                                  ;	DL	day in BCD
   488                                  ;	
   489                                  ; Exit with:
   490                                  ;	Nothing
   491                                  ;
   492                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   493                                  	global	set_date
   494                                  set_date:
   495 0000018F 5250                    	pushm	ax,dx		;usual 2 register save
   496 00000191 80FD20                  	cmp	ch,0x20		; century must be 21st
   497 00000194 7405                    	je	.1
   498 00000196 80FD19                  	cmp 	ch,0x19		; century may be 20th
   499 00000199 754D                    	jne	ds_error
   500                                  .1:
   501 0000019B 5152                    	pushm	dx,cx
   502                                  
   503 0000019D E86401                  	call	day_of_week_
   504                                  
   505 000001A0 5B59                    	popm	bx,cx		; was DX,CX
   506 000001A2 51                      	pushm	cx		; save CX
   507                                  
   508 000001A3 88C5                    	mov	ch,al		; DOW to CH
   509                                  
   510 000001A5 B000                    	mov	al,0		;disable write protect
   511 000001A7 E8C200                  	call	wr_protect
   512                                  
   513 000001AA B80680                  	mov	ax,1000_0000B << 8 | 6	;year
   514 000001AD E87400                  	call	byte_write	; year is in CL already
   515                                  
   516 000001B0 B80480                  	mov	ax,1000_0000B << 8 | 4	;month
   517 000001B3 88F9                    	mov	cl,bh			; was in DH
   518 000001B5 E86C00                  	call	byte_write
   519                                  
   520 000001B8 B80380                  	mov	ax,1000_0000B << 8 | 3	;day (DATE)
   521 000001BB 88D9                    	mov	cl,bl			; was in DL
   522 000001BD E86400                  	call	byte_write
   523                                  
   524 000001C0 B80580                  	mov	ax,1000_0000B << 8 | 5	;day of week (DOW)
   525 000001C3 88E9                    	mov	cl,ch
   526 000001C5 FEC1                    	inc	cl		; DS1302 is 1..7, not 0..6
   527 000001C7 E85A00                  	call	byte_write
   528                                  
   529 000001CA B080                    	mov	al,80h		;set Write Protect
   530 000001CC E89D00                  	call	wr_protect
   531                                  
   532 000001CF 59                      	popm	cx
   533 000001D0 EB12                    	jmp	ds_full_exit
