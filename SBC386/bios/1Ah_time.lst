    88                              <1> %define io_rom_addr_low io_rom_addr
    89                              <1> %define io_rom_addr_seg (io_rom_addr+2)
    90 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
    91                              <1> ; */
    92                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
    93 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
    94 0000006E ????                <1> timer_count_high	resw	1
    95                              <1> %define timer_count timer_count_low
