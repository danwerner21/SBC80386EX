    60                              <1> ;/* i386EX.inc  --  register definitions for the Intel 80386EX processor
    61                              <1> ;
    62                              <1> %define defb
    63                              <1> %define defw
    64                              <1> %define defd
    65                              <1> ;*/
    66                              <1> 
    67                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    68                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    69                              <1> ;*  first thing it does, so anything that restarts the board in software has
    70                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    71                              <1> ;*  hard way.
    72                              <1> ;*/
    73                              <1> defw    DEVICE_ID equ   0x2309
    74                              <1> 
    75                              <1> ;/* The Address Configuration register
    76                              <1> ;*/
    77                              <1> defb REMAPCFGH  equ     0x0023
    78                              <1> defb REMAPCFGL  equ     0x0022
    79                              <1> defw REMAPCFG   equ     0x0022
    80                              <1> 
    81                              <1> ;/* The A20gate and fast CPU Reset
    82                              <1> ;*/
    83                              <1> defb PORT92     equ     0xF092
    84                              <1> defb PORT92_AT  equ     0x0092
    85                              <1> 
    86                              <1> ;
    87                              <1> ;/* The DMA Controller and Bus Arbiter
    88                              <1> ;*/
    89                              <1> defb DMA0TAR    equ     0xF000
    90                              <1> defb DMA0TAR_AT equ     0x0000
    91                              <1> defb DMA0BYC    equ     0xF001
    92                              <1> defb DMA0BYC_AT equ     0x0001
    93                              <1> defb DMA1TAR    equ     0xF002
    94                              <1> defb DMA1TAR_AT equ     0x0002
    95                              <1> defb DMA1BYC    equ     0xF003
    96                              <1> defb DMA1BYC_AT equ     0x0003
    97                              <1> defb DMACMD1    equ     0xF008
    98                              <1> defb DMACMD1_AT equ     0x0008
    99                              <1> defb DMASTS     equ     0xF008
   100                              <1> defb DMASTS_AT  equ     0x0008
   101                              <1> defb DMASRR     equ     0xF009
   102                              <1> defb DMASRR_AT  equ     0x0009
   103                              <1> defb DMAMSK     equ     0xF00A
   104                              <1> defb DMAMSK_AT  equ     0x000A
   105                              <1> defb DMAMOD1    equ     0xF00B
   106                              <1> defb DMAMOD1_AT equ     0x000B
   107                              <1> defb DMACLRBP   equ     0xF00C
   108                              <1> defb DMACLRBP_AT equ    0x000C
   109                              <1> defb DMACLR     equ     0xF00D
   110                              <1> defb DMACLR_AT  equ     0x000D
   111                              <1> defb DMACLRMSK  equ     0xF00E
   112                              <1> defb DMACLRMSK_AT equ   0x000E
   113                              <1> defb DMAGRPMSK  equ     0xF00F
   114                              <1> defb DMAGRPMSK_AT equ   0x000F
   115                              <1> defb DMA0REQ0_1 equ     0xF010
   116                              <1> defb DMA0REQ2_3 equ     0xF011
   117                              <1> defb DMA1REQ0_1 equ     0xF012
   118                              <1> defb DMA1REQ2_3 equ     0xF013
   119                              <1> defb DMABSR     equ     0xF018
   120                              <1> defb DMACHR     equ     0xF019
   121                              <1> defb DMAIS      equ     0xF019
   122                              <1> defb DMACMD2    equ     0xF01A
   123                              <1> defb DMAMOD2    equ     0xF01B
   124                              <1> defb DMAIEN     equ     0xF01C
   125                              <1> defb DMAOVFE    equ     0xF01D
   126                              <1> defb DMACLRTC   equ     0xF01E
   127                              <1> ;
   128                              <1> ;/* The DMA Page Registers
   129                              <1> ;*/
   130                              <1> defb DMA1TAR2    equ    0xF083
   131                              <1> defb DMA1TAR2_AT equ    0x0083
   132                              <1> defb DMA1TAR3    equ    0xF085
   133                              <1> defb DMA1TAR3_AT equ    0x0085
   134                              <1> defb DMA0TAR3    equ    0xF086
   135                              <1> defb DMA0TAR3_AT equ    0x0086
   136                              <1> defb DMA0TAR2    equ    0xF087
   137                              <1> defb DMA0TAR2_AT equ    0x0087
   138                              <1> ;
   139                              <1> defb DMA0BYC2   equ     0xF098
   140                              <1> defb DMA1BYC2   equ     0xF099
   141                              <1> 
   142                              <1> ;
   143                              <1> ;/* The Master Interrupt Controller
   144                              <1> ;*/
   145                              <1> defb ICW1M_AT   equ     0x0020
   146                              <1> defb ICW2M_AT   equ     0x0021
   147                              <1> defb ICW3M_AT   equ     0x0021
   148                              <1> defb ICW4M_AT   equ     0x0021
   149                              <1> defb OCW1M_AT   equ     0x0021
   150                              <1> defb OCW2M_AT   equ     0x0020
   151                              <1> defb OCW3M_AT   equ     0x0020
   152                              <1> 
   153                              <1> defb ICW1M      equ     0xF020
   154                              <1> defb ICW2M      equ     0xF021
   155                              <1> defb ICW3M      equ     0xF021
   156                              <1> defb ICW4M      equ     0xF021
   157                              <1> defb OCW1M      equ     0xF021
   158                              <1> defb OCW2M      equ     0xF020
   159                              <1> defb OCW3M      equ     0xF020
   160                              <1> defb IRR_M	equ	0xF020
   161                              <1> 
   162                              <1> ;
   163                              <1> ;/* The Slave Interrupt Controller
   164                              <1> ;*/
   165                              <1> defb ICW1S_AT   equ     0x00A0
   166                              <1> defb ICW2S_AT   equ     0x00A1
   167                              <1> defb ICW3S_AT   equ     0x00A1
   168                              <1> defb ICW4S_AT   equ     0x00A1
   169                              <1> defb OCW1S_AT   equ     0x00A1
   170                              <1> defb OCW2S_AT   equ     0x00A0
   171                              <1> defb OCW3S_AT   equ     0x00A0
   172                              <1> defb IRR_M_AT	equ	0x00A0
   173                              <1> 
   174                              <1> defb ICW1S      equ     0xF0A0
   175                              <1> defb ICW2S      equ     0xF0A1
   176                              <1> defb ICW3S      equ     0xF0A1
   177                              <1> defb ICW4S      equ     0xF0A1
   178                              <1> defb OCW1S      equ     0xF0A1
   179                              <1> defb OCW2S      equ     0xF0A0
   180                              <1> defb OCW3S      equ     0xF0A0
   181                              <1> 
   182                              <1> ;
   183                              <1> ;/* The Timer/Counter Unit
   184                              <1> ;*/
   185                              <1> defb    TMR0    equ     0xF040
   186                              <1> defb    TMR0_AT equ     0x0040
   187                              <1> defb    TMR1    equ     0xF041
   188                              <1> defb    TMR1_AT equ     0x0041
   189                              <1> defb    TMR2    equ     0xF042
   190                              <1> defb    TMR2_AT equ     0x0042
   191                              <1> defb    TMRCON  equ     0xF043
   192                              <1> defb    TMRCON_AT  equ  0x0043
   193                              <1> 
   194                              <1> ;
   195                              <1> ;/* The Chip Select Unit
   196                              <1> ;*/
   197                              <1> defw    CS0ADL  equ     0xF400
   198                              <1> defw    CS0ADH  equ     0xF402
   199                              <1> defw    CS0MSKL equ     0xF404
   200                              <1> defw    CS0MSKH equ     0xF406
   201                              <1> defw    CS1ADL  equ     0xF408
   202                              <1> defw    CS1ADH  equ     0xF40A
   203                              <1> defw    CS1MSKL equ     0xF40C
   204                              <1> defw    CS1MSKH equ     0xF40E
   205                              <1> defw    CS2ADL  equ     0xF410
   206                              <1> defw    CS2ADH  equ     0xF412
   207                              <1> defw    CS2MSKL equ     0xF414
   208                              <1> defw    CS2MSKH equ     0xF416
   209                              <1> defw    CS3ADL  equ     0xF418
   210                              <1> defw    CS3ADH  equ     0xF41A
   211                              <1> defw    CS3MSKL equ     0xF41C
   212                              <1> defw    CS3MSKH equ     0xF41E
   213                              <1> defw    CS4ADL  equ     0xF420
   214                              <1> defw    CS4ADH  equ     0xF422
   215                              <1> defw    CS4MSKL equ     0xF424
   216                              <1> defw    CS4MSKH equ     0xF426
   217                              <1> defw    CS5ADL  equ     0xF428
   218                              <1> defw    CS5ADH  equ     0xF42A
   219                              <1> defw    CS5MSKL equ     0xF42C
   220                              <1> defw    CS5MSKH equ     0xF42E
   221                              <1> defw    CS6ADL  equ     0xF430
   222                              <1> defw    CS6ADH  equ     0xF432
   223                              <1> defw    CS6MSKL equ     0xF434
   224                              <1> defw    CS6MSKH equ     0xF436
   225                              <1> defw    UCSADL  equ     0xF438
   226                              <1> defw    UCSADH  equ     0xF43A
   227                              <1> defw    UCSMSKL equ     0xF43C
   228                              <1> defw    UCSMSKH equ     0xF43E
   229                              <1> 
   230                              <1> ;
   231                              <1> ;/* The Synchronous Serial I/O Unit
   232                              <1> ;*/
   233                              <1> defw    SSIOTBUF equ    0xF480
   234                              <1> defw    SSIORBUF equ    0xF482
   235                              <1> defw    SSIOBAUD equ    0xF484
   236                              <1> defw    SSIOCON1 equ    0xF486
   237                              <1> defw    SSIOCON2 equ    0xF488
   238                              <1> defw    SSIOCTR  equ    0xF48A
   239                              <1> 
   240                              <1> ;
   241                              <1> ;/* The Refresh Control Unit
   242                              <1> ;*/
   243                              <1> defw    RFSBAD  equ     0xF4A0
   244                              <1> defw    RFSCIR  equ     0xF4A2
   245                              <1> defw    RFSCON  equ     0xF4A4
   246                              <1> defw    RFSADD  equ     0xF4A6
   247                              <1> 
   248                              <1> ;
   249                              <1> ;/* The Watchdog Timer Unit
   250                              <1> ;*/
   251                              <1> defw    WDTRLDH equ     0xF4C0
   252                              <1> defw    WDTRLDL equ     0xF4C2
   253                              <1> defw    WDTCNTH equ     0xF4C4
   254                              <1> defw    WDTCNTL equ     0xF4C6
   255                              <1> defw    WDTCLR  equ     0xF4C8
   256                              <1> defb    WDTSTATUS  equ  0xF4CA
   257                              <1> 
   258                              <1> ;
   259                              <1> ;/* Clock Generation and Power Management
   260                              <1> ;*/
   261                              <1> defb    PWRCON  equ     0xF800
   262                              <1> defw    CLKPRS  equ     0xF804
   263                              <1> 
   264                              <1> ;
   265                              <1> ;/* Device Configuration Registers
   266                              <1> ;*/
   267                              <1> defb    P1CFG   equ     0xF820
   268                              <1> defb    P2CFG   equ     0xF822
   269                              <1> defb    P3CFG   equ     0xF824
   270                              <1> defb    PINCFG  equ     0xF826
   271                              <1> defb    DMACFG  equ     0xF830
   272                              <1> defb    INTCFG  equ     0xF832
   273                              <1> defb    TMRCFG  equ     0xF834
   274                              <1> defb    SIOCFG  equ     0xF836
   275                              <1> 
   276                              <1> ;
   277                              <1> ;/* Parallel I/O Ports
   278                              <1> ;*/
   279                              <1> defb    P1PIN   equ     0xF860
   280                              <1> defb    P1LTC   equ     0xF862
   281                              <1> defb    P1DIR   equ     0xF864
   282                              <1> defb    P2PIN   equ     0xF868
   283                              <1> defb    P2LTC   equ     0xF86A
   284                              <1> defb    P2DIR   equ     0xF86C
   285                              <1> defb    P3PIN   equ     0xF870
   286                              <1> defb    P3LTC   equ     0xF872
   287                              <1> defb    P3DIR   equ     0xF874
   288                              <1> 
   289                              <1> 
   290                              <1> ; bits.inc
   291                              <1> ;
   292                              <1> ; assembly language bit definitions
   293                              <1> ;
   294                              <1> defb    BIT0    equ     0x01
   295                              <1> defb    BIT1    equ     0x02
   296                              <1> defb    BIT2    equ     0x04
   297                              <1> defb    BIT3    equ     0x08
   298                              <1> defb    BIT4    equ     0x10
   299                              <1> defb    BIT5    equ     0x20
   300                              <1> defb    BIT6    equ     0x40
   301                              <1> defb    BIT7    equ     0x80
   302                              <1> 
   303                              <1> defw    BIT8    equ     0x0100
   304                              <1> defw    BIT9    equ     0x0200
