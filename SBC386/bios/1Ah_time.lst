   300                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   301                                  ; INT 1A
   302                                  ; function 01	set_tick_count
   303                                  ;
   304                                  ;    Enter with:
   305                                  ;	AH	01h
   306                                  ;	CX:DX	tick count
   307                                  ;
   308                                  ;    Exit with:
   309                                  ;	nothing
   310                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   311                                  set_tick_count:
   312 000000ED 1E                      	push	ds
   313 000000EE 6A401F                  	get_bda	DS	;address BDA
   314 000000F1 FA                      	cli		;disable interrupts
   315 000000F2 89166C00                	mov	[timer_count_low],dx
   316 000000F6 890E6E00                	mov	[timer_count_high],cx
   317 000000FA C606700000              	mov	byte [timer_overflow],0	; 'byte' qualifier needed
   318 000000FF FB                      	sti		;interrupts back on
   319 00000100 F8                      	clc
   320 00000101 1F                      	pop	ds
   321 00000102 C3                      	ret
   322                                  
   323                                  
   324                                  
   325                                  
   326                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   327                                  ;
   328                                  ; INT 1A
   329                                  ; function 02   Get Time
   330                                  ;
   331                                  ; Enter with:
   332                                  ;       AH      0x02
   333                                  ;
   334                                  ; Exit with:
   335                                  ;	CH	hours in BCD
   336                                  ;	CL	minutes in BCD
   337                                  ;	DH	seconds in BCD
   338                                  ;	DL	daylight savings time flag
   339                                  ;		  00=not DST, 01==DST
   340                                  ;	
   341                                  ;       Carry clear	if clock is running
   342                                  ;
   343                                  ; Error:
   344                                  ;       Carry set	if clock is stopped
   345                                  ;
   346                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   347                                  	global	get_time
   348                                  get_time:
   349 00000103 50                      	pushm	ax
   350 00000104 31DB                    	xor	bx,bx		; saved at a higher level
   351 00000106 B80081                  	mov	ax, 1000_0001B << 8 | 0		;seconds
   352 00000109 88C2                    	mov	dl,al		; DST off
   353 0000010B E80D01                  	call	byte_read
   354 0000010E 88E6                    	mov	dh,ah		; save seconds
   355                                  
   356 00000110 52                      .1:	push	dx
   357 00000111 B80181                  	mov	ax, 1000_0001B << 8 | 1		; minutes
   358 00000114 E80401                  	call	byte_read
   359 00000117 88E1                    	mov	cl,ah		; save minutes
   360 00000119 B80281                  	mov	ax, 1000_0001B << 8 | 2		; hours
   361 0000011C E8FC00                  	call	byte_read
   362 0000011F 88E5                    	mov	ch,ah		; save hours
   363 00000121 B80081                  	mov	ax, 1000_0001B << 8 | 0		;seconds
   364 00000124 E8F400                  	call	byte_read
   365 00000127 5A                      	pop	dx
   366 00000128 86F4                    	xchg	dh,ah
   367 0000012A 38F4                    	cmp	ah,dh
   368 0000012C 75E2                    	jne	.1		; loop back
   369                                  
   370 0000012E 80E67F                  	and	dh,0x7F		; mask clock halt bit
   371 00000131 00E4                    	add	ah,ah		; set carry if halted
   372                                  
   373 00000133 58                      	popm	ax
   374 00000134 C3                      	ret
   375                                  
   376                                  
   377                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   378                                  ;
   379                                  ; INT 1A
   380                                  ; function 03   Set Time
   381                                  ;
   382                                  ; Enter with:
   383                                  ;       AH      0x03
   384                                  ;
   385                                  ;	CH	hours in BCD
   386                                  ;	CL	minutes in BCD
   387                                  ;	DH	seconds in BCD
   388                                  ;	DL	daylight savings time flag (ignored)
   389                                  ;		  00=not DST, 01==DST
   390                                  ;	
   391                                  ; Exit with:
   392                                  ;       Carry clear	if clock is running
   393                                  ;
   394                                  ; Error:
   395                                  ;       Carry set	if clock is stopped
   396                                  ;
   397                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   398                                  	global	set_time
   399                                  set_time:
   400 00000135 5250                    	pushm	ax,dx
   401                                  
   402 00000137 5251                    	pushm	cx,dx		;protect the parameters
   403                                  
   404 00000139 B000                    	mov	al,0		;disable write protect
   405 0000013B E83B01                  	call	wr_protect	;**
   406                                  %if 0
   407                                  	mov	ax, 1000_0000B << 8 | 0		;seconds
   408                                  	mov	cl,80h			; stop the clock
   409                                  	call	byte_write
   410                                  %endif
   411 0000013E 5B                      	popm	bx		; was CX
   412                                  
   413 0000013F B80280                  	mov	ax, 1000_0000B << 8 | 2		;hours
   414 00000142 88F9                    	mov	cl,bh		; **
   415 00000144 80E17F                  	and	cl,0x7F		; 24-hr format
   416 00000147 E8E700                  	call	byte_write
   417                                  
   418 0000014A B80180                  	mov	ax, 1000_0000B << 8 | 1		;minutes
   419 0000014D 88D9                    	mov	cl,bl		; **
   420 0000014F E8DF00                  	call	byte_write
   421                                  
   422 00000152 5B                      	popm	bx		; was DX
   423                                  
   424 00000153 B80080                  	mov	ax, 1000_0000B << 8 | 0		;seconds
   425 00000156 88F9                    	mov	cl,bh
   426 00000158 80E17F                  	and	cl,0x7F			; enable the clock
   427 0000015B E8D300                  	call	byte_write
   428                                  
   429 0000015E B080                    	mov	al,80h		;set Write Protect
   430 00000160 E81601                  	call	wr_protect
   431                                  
   432 00000163 E98B00                  	jmp	ds_full_exit
   433                                  
   434                                  
   435                                  
   436                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   437                                  ;
   438                                  ; INT 1A
   439                                  ; function 04   Get Date
   440                                  ;
   441                                  ; Enter with:
   442                                  ;       AH      0x04
   443                                  ;
   444                                  ; Exit with:
   445                                  ;	CH	century in BCD
   446                                  ;	CL	year in BCD
   447                                  ;	DH	month in BCD
   448                                  ;	DL	day in BCD
   449                                  ;	
   450                                  ;       Carry clear	if clock is running
   451                                  ;
   452                                  ; Error:
   453                                  ;       Carry set	if clock is stopped
   454                                  ;
   455                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   456                                  	global	get_date
   457                                  get_date:
   458 00000166 B80681                  	mov	ax,1000_0001B << 8 | 6	;year
   459 00000169 E8AF00                  	call	byte_read
   460 0000016C 88E1                    	mov	cl,ah		; return in CL
   461                                  
   462 0000016E B80481                  	mov	ax,1000_0001B << 8 | 4	;month
   463 00000171 E8A700                  	call	byte_read
   464 00000174 88E7                    	mov	bh,ah		; save in BH
   465                                  
   466 00000176 B80381                  	mov	ax,1000_0001B << 8 | 3	;day of month (DATE)
   467 00000179 E89F00                  	call	byte_read
   468 0000017C 88E3                    	mov	bl,ah
   469                                  	
   470 0000017E B80581                  	mov	ax,1000_0001B << 8 | 5	;day of week (DAY)
   471 00000181 E89700                  	call	byte_read
   472 00000184 88E5                    	mov	ch,ah		; save in Century byte
   473                                  
   474 00000186 B80081                  	mov	ax,1000_0001B << 8 | 0	;clock halt flag
   475 00000189 E88F00                  	call	byte_read
   476                                  ; clock halt flag is in AH
   477                                  
   478 0000018C 89DA                    	mov	dx,bx		;
   479 0000018E 88E8                    	mov	al,ch		; Day-of-Week flag to AL
   480 00000190 B519                    	mov	ch,0x19		; 20th century in CH
   481 00000192 80F970                  	cmp	cl,0x70		; year less than '70 sets carry
   482                                  %if 0
   483                                  	adc	al,0		; add in the carry if CL<70h
   484                                  	daa			; correct (DAA doesn't work???)
   485                                  %else
   486 00000195 7302                    	jnb	.8
   487 00000197 B520                    	mov	ch,0x20		; carry is set
   488                                  .8:
   489                                  %endif
   490 00000199 D0E4                    	shl	ah,1		; clock halt to carry
   491 0000019B C3                      	ret
   492                                  
   493                                  
   494                                  
   495                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   496                                  ;
   497                                  ; INT 1A
   498                                  ; function 05   Set Date
   499                                  ;
   500                                  ; Enter with:
   501                                  ;       AH      0x05
   502                                  ;
   503                                  ;	CH	century in BCD	(used for Day Of Week calculation)
   504                                  ;	CL	year in BCD
   505                                  ;	DH	month in BCD
   506                                  ;	DL	day in BCD
   507                                  ;	
   508                                  ; Exit with:
   509                                  ;	Nothing
   510                                  ;
   511                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   512                                  	global	set_date
   513                                  set_date:
   514 0000019C 5250                    	pushm	ax,dx		;usual 2 register save
   515 0000019E 80FD20                  	cmp	ch,0x20		; century must be 21st
   516 000001A1 7405                    	je	.1
   517 000001A3 80FD19                  	cmp 	ch,0x19		; century may be 20th
   518 000001A6 754D                    	jne	ds_error
   519                                  .1:
   520 000001A8 5152                    	pushm	dx,cx
   521                                  
   522 000001AA E86301                  	call	day_of_week_
   523                                  
   524 000001AD 5B59                    	popm	bx,cx		; was DX,CX
   525 000001AF 51                      	pushm	cx		; save CX
   526                                  
   527 000001B0 88C5                    	mov	ch,al		; DOW to CH
   528                                  
   529 000001B2 B000                    	mov	al,0		;disable write protect
   530 000001B4 E8C200                  	call	wr_protect
   531                                  
   532 000001B7 B80680                  	mov	ax,1000_0000B << 8 | 6	;year
   533 000001BA E87400                  	call	byte_write	; year is in CL already
   534                                  
   535 000001BD B80480                  	mov	ax,1000_0000B << 8 | 4	;month
   536 000001C0 88F9                    	mov	cl,bh			; was in DH
   537 000001C2 E86C00                  	call	byte_write
   538                                  
   539 000001C5 B80380                  	mov	ax,1000_0000B << 8 | 3	;day (DATE)
   540 000001C8 88D9                    	mov	cl,bl			; was in DL
   541 000001CA E86400                  	call	byte_write
   542                                  
   543 000001CD B80580                  	mov	ax,1000_0000B << 8 | 5	;day of week (DOW)
   544 000001D0 88E9                    	mov	cl,ch
   545 000001D2 FEC1                    	inc	cl		; DS1302 is 1..7, not 0..6
   546 000001D4 E85A00                  	call	byte_write
   547                                  
   548 000001D7 B080                    	mov	al,80h		;set Write Protect
   549 000001D9 E89D00                  	call	wr_protect
   550                                  
   551 000001DC 59                      	popm	cx
   552 000001DD EB12                    	jmp	ds_full_exit
   553                                  
   554                                  
   555                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   556                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   557                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   558                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   559                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   560                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   561                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   562                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   563                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   564                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   565                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   566                                  
