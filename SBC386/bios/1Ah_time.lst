   196                              <1> defw    CS1MSKH equ     0xF40E
   197                              <1> defw    CS2ADL  equ     0xF410
   198                              <1> defw    CS2ADH  equ     0xF412
   199                              <1> defw    CS2MSKL equ     0xF414
   200                              <1> defw    CS2MSKH equ     0xF416
