    58 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
    59 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
    60 0000001A ????                <1> buffer_head	resw	1
    61 0000001C ????                <1> buffer_tail	resw	1
    62                              <1> ; */
    63 0000001E <res 20h>           <1> kbd_buffer	resw	16	; buffer empty when  head==tail**/
    64                              <1> ; */
