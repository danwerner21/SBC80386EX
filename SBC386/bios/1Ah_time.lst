    41                              <1> ; */
    42                              <1> ; POST writes what it decided here, after the test of segment 0 has */
    43                              <1> ; zeroed the area, so the answer survives to be reported.  Nothing else */
    44                              <1> ; in this BIOS writes mfg_test.                                        */
    45                              <1> %define WARM_POST 0x01	; warm start: the memory march was skipped */
    46 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    47 00000015 ??                  <1> mfg_err_flag	resb	1
    48 00000016 ??                  <1> mfg_err_flag2	resb	1
    49                              <1> ; */
    50                              <1> ; first Keyboard data area */
    51 00000017 ??                  <1> kbd_flag	resb	1	; shift status &c. */
    52 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
    53 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
    54 0000001A ????                <1> buffer_head	resw	1
    55 0000001C ????                <1> buffer_tail	resw	1
