    32                                  %include "macro.inc"
    33                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    34                              <1> ;
    35                              <1> ; some useful macros:
    36                              <1> ;
    37                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    38                              <1> %define NREPEAT 0
    39                              <1> 
    40                              <1> %if NREPEAT
    41                              <1> 
    42                              <1> %macro	rep	1
    43                              <1> %%loop:	%1
    44                              <1> 	dec	cx
    45                              <1> 	jnz	%%loop
    46                              <1> %endm
    47                              <1> 
    48                              <1> %macro	repne	1
    49                              <1> %%loop:	%1
    50                              <1> 	je	%%e
    51                              <1> 	dec	cx
    52                              <1> 	jnz	%%loop
    53                              <1> 	cmp	cx,1
    54                              <1> 	jmp	%%done
    55                              <1> %%e:	dec	cx
    56                              <1> 	cmp	cx,cx
    57                              <1> %%done:
    58                              <1> %endm
    59                              <1> 
    60                              <1> %macro	repe	1
    61                              <1> %%loop:	%1
    62                              <1> 	jne	%%ne
    63                              <1> 	dec	cx
    64                              <1> 	jnz	%%loop
    65                              <1> 	jmp	%%done
    66                              <1> %%ne:	dec	cx
    67                              <1> 	jcxz	%%cxz
    68                              <1> 	jmp	%%done
    69                              <1> %%cxz:	cmp	cx,1
    70                              <1> %%done:
    71                              <1> %endm
    72                              <1> 
    73                              <1> %macro	REP	1
    74                              <1> %%loop:	%1
    75                              <1> 	dec	ecx
    76                              <1> 	jnz	%%loop
    77                              <1> %endm
    78                              <1> 
    79                              <1> %macro	REPNE	1
    80                              <1> %%loop:	%1
    81                              <1> 	je	%%e
    82                              <1> 	dec	ecx
    83                              <1> 	jnz	%%loop
    84                              <1> 	cmp	cl,1
    85                              <1> 	jmp	%%done
    86                              <1> %%e:	dec	ecx
    87                              <1> 	cmp	cl,cl
    88                              <1> %%done:
    89                              <1> %endm
    90                              <1> 
    91                              <1> %macro	REPE	1
    92                              <1> %%loop:	%1
    93                              <1> 	jne	%%ne
    94                              <1> 	dec	ecx
    95                              <1> 	jnz	%%loop
    96                              <1> 	jmp	%%done
    97                              <1> %%ne:	dec	ecx
    98                              <1> 	jecxz	%%cxz
    99                              <1> 	jmp	%%done
   100                              <1> %%cxz:	cmp	cl,1
   101                              <1> %%done:
   102                              <1> %endm
   103                              <1> 
   104                              <1> %endif
   105                              <1> 
   106                              <1> 
   107                              <1> ;
   108                              <1> ; format of the BYTE initialization table:  address, byte
   109                              <1> ;
   110                              <1> %imacro  binit 2
   111                              <1>         dw      %1
   112                              <1>         db      %2
   113                              <1> %endmacro
   114                              <1> ; end with DW -1
   115                              <1> 
   116                              <1> ;
   117                              <1> ; format of the WORD initialization table:  address, word
   118                              <1> ;
   119                              <1> %imacro  winit 2
   120                              <1>         dw      %1
   121                              <1>         dw      %2
   122                              <1> %endmacro
   123                              <1> ; end with DW -1
   124                              <1> 
   125                              <1> 
   126                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   127                              <1> %imacro get_bda	1.nolist
   128                              <1> 	push	0x0040
   129                              <1> 	pop	%1
   130                              <1> 	cnop
   131                              <1> %endm
   132                              <1> 
   133                              <1> 
   134                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   135                              <1> %imacro	get_loc0 1.nolist
   136                              <1> 	push	0x0000
   137                              <1> 	pop	%1
   138                              <1> 	cnop
   139                              <1> %endm
   140                              <1> 
   141                              <1> 
   142                              <1> 
   143                              <1> %imacro setloc  1.nolist
   144                              <1>  times   (%1-($-$$)) db 0FFh
   145                              <1> %endm
   146                              <1> 
   147                              <1> %imacro db_lo   1
   148                              <1>  db (%1)&255
   149                              <1> %endm
   150                              <1> 
   151                              <1> %imacro cnop    0.nolist
   152                              <1> %ifdef SOFT_DEBUG
   153                              <1> %if SOFT_DEBUG
   154                              <1>         nop
   155                              <1> %endif
   156                              <1> %endif
   157                              <1> %endm
   158                              <1> 
   159                              <1> %imacro popm 1-*.nolist
   160                              <1> %rep %0
   161                              <1> %ifidni %1,ALL
   162                              <1>  popa
   163                              <1> %elifidni %1,F
   164                              <1>  popf
   165                              <1> %else
   166                              <1>  pop %1
   167                              <1> %ifidni %1,DS
   168                              <1>  cnop
   169                              <1> %elifidni %1,ES
   170                              <1>  cnop
   171                              <1> %elifidni %1,FS
   172                              <1>  cnop
   173                              <1> %elifidni %1,GS
   174                              <1>  cnop
   175                              <1> %endif
   176                              <1> %endif
   177                              <1> %rotate 1
   178                              <1> %endrep
   179                              <1> %endm
   180                              <1> 
   181                              <1> %imacro pushm 1-*.nolist
   182                              <1> %rep %0
   183                              <1> %rotate -1
   184                              <1> %ifidni %1,ALL
   185                              <1>  pusha
   186                              <1> %elifidni %1,F
   187                              <1>  pushf
   188                              <1> %else
   189                              <1>  push %1
   190                              <1> %endif
   191                              <1> %endrep
   192                              <1> %endm
   193                              <1> 
   194                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   195                              <1> %assign __size__ (%2-1)	| 0xFF
   196                              <1> %if (__size__ <= 0xFFFF)
   197                              <1> %assign __gran__ 0
   198                              <1> %else
   199                              <1> %assign __gran__ 0xC0			; G B 0 0
   200                              <1> %endif
   201                              <1> %assign __expand__ 0
   202                              <1> %if %0==3
   203                              <1> %if %3
   204                              <1> %assign __expand__ 4
   205                              <1> %endif
   206                              <1> %endif
   207                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   208                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   209                              <1> %endm
   210                              <1> 
   211                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   212                              <1> %assign __size__ (%2-1)	| 0xFF
   213                              <1> %if (__size__ <= 0xFFFF)
   214                              <1> %assign __gran__ 0
   215                              <1> %else
   216                              <1> %assign __gran__ 0xC0			; G D 0 0
   217                              <1> %endif
   218                              <1> %assign __conform__ 0
   219                              <1> %if %0==3
   220                              <1> %if %3
   221                              <1> %assign __conform__ 4
   222                              <1> %endif
   223                              <1> %endif
   224                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   225                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   226                              <1> %endm
   227                              <1> 
   228                              <1> ;/* End of macro.inc */
