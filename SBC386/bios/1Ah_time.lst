   510                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   511                                  ;
   512                                  ; INT 1A
   513                                  ; function 20   Get NVRAM byte
   514                                  ;
   515                                  ; Enter with:
   516                                  ;       AH      0x20
   517                                  ;       AL      byte number ( 0 <= AL <= 30) 
   518                                  ;   (single byte read)
   519                                  ;
   520                                  ;       AH      0x20
   521                                  ;       AL      31
   522                                  ;       ES:BX   pointer to 31 byte buffer
   523                                  ;   (burst read)
   524                                  ;
   525                                  ; Exit with:
   526                                  ;       AL      byte read (single byte read)
   527                                  ;       Carry clear
   528                                  ;
   529                                  ;       AL      byte NVRAM[30] (burst read)
   530                                  ;       ES:BX buffer filled with bytes 0..30
   531                                  ;
   532                                  ;       Carry clear
   533                                  ;
   534                                  ; Error:
   535                                  ;       Carry set
   536                                  ;
   537                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   538                                  	global	ds_read
   539                                  ds_read:
   540 000001D2 5250                            pushm   ax,dx
   541                                  
   542 000001D4 3C1F                    	cmp	al,31
   543 000001D6 7314                    	jae	ds_burstr	; burst or error
   544                                  	
   545 000001D8 B4C1                    	mov	ah,1100_0001B	; NVRAM read
   546 000001DA E83100                   	call	byte_read
   547                                  
   548                                  ds_read_exit:
   549 000001DD 88E0                    	mov	al,ah		;return in AL
   550 000001DF 5A                      	pop	dx		;get old ax
   551 000001E0 88F4                    	mov	ah,dh		;restore AH
   552 000001E2 EB01                    	jmp	ds_good_exit
   553                                  
   554                                  ds_full_exit:
   555 000001E4 58                      	popm	ax
   556                                  ds_good_exit:
   557 000001E5 F8                      	clc 			;signal good return
   558 000001E6 5A                      	popm	dx
   559 000001E7 C3                      	ret	
   560                                  
   561                                  ds_error:
   562 000001E8 585A                    	popm	ax,dx
   563 000001EA F9                      	stc
   564 000001EB C3                      	ret
   565                                  
   566                                  
   567                                  
   568                                  
   569                                  ;
   570                                  ; handle burst read
   571                                  ds_burstr:
   572 000001EC 75FA                            jne	ds_error	;must be 31 exactly, else error
   573                                  
   574 000001EE 5153                    	pushm	bx,cx		;extra save
   575                                  
   576 000001F0 E8B700                  	call	ds_reset_on	;reset before command byte
   577 000001F3 E8C500                  	call	ds_reset_off	;set for read
   578                                  
   579                                  
   580 000001F6 B4FF                    	mov	ah,1111_1111B	;burst read command
   581 000001F8 E8CD00                  	call	ds_outb		;output the command
   582                                  
   583 000001FB B91F00                  	mov	cx,31		;
   584                                  ds_read2:
   585 000001FE E8DD00                  	call	ds_inb		;retrieve a byte in AH
   586 00000201 268827                    es	mov	byte [bx],ah	;save in the array
   587 00000204 43                        	inc	bx
   588 00000205 E2F7                    	loop	ds_read2	;and loop back
   589                                  
   590 00000207 E8A000                  	call	ds_reset_on	;terminate read
   591                                  
   592 0000020A 5B59                    	popm	bx,cx		;and restore
   593 0000020C EBCF                            jmp	ds_read_exit	;return AH
   594                                   
   595                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   596                                  ;
   597                                  ; byte read into AH
   598                                  ;	AH = command bits
   599                                  ;	AL = register number
   600                                  ; byte read direct
   601                                  ;	AH = command bits + (reg<<1)
   602                                  ;
   603                                  ; Exit with:
   604                                  ;	AH is the byte read in
   605                                  ;
   606                                  ;  Uses AX, DX
   607                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   608                                  byte_read:
   609                                  ; single byte read
   610 0000020E D0E0                    	shl	al,1		; shift by one
   611 00000210 08E0                            or      al,ah		; Clock or NVRAM read
   612 00000212 88C4                    	mov	ah,al		; command byte to AH
   613                                  byte_read_direct:
   614 00000214 E89300                  	call	ds_reset_on	;start of command, set AL & DX
   615 00000217 E8A100                  	call	ds_reset_off	;remove the Reset
   616                                  
   617                                  ; output the command
   618 0000021A E8AB00                          call    ds_outb
   619                                  
   620 0000021D E8BE00                  	call	ds_inb		;input byte to AH
   621                                  
   622 00000220 E88700                  	call	ds_reset_on	;terminate command
   623                                  
   624 00000223 C3                      	ret
   625                                  
   626                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   627                                  ; byte write
   628                                  ;	AH = command bits
   629                                  ;	AL = register number
   630                                  ;	CL = byte value to write
   631                                  ;
   632                                  ; byte_write_direct
   633                                  ;	AH = command, register<<1 included
   634                                  ;	CL = byte value to write
   635                                  ;
   636                                  ;  Uses AX, DX
   637                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   638                                  byte_write:
   639                                  ; single byte write
   640 00000224 D0E0                    	shl	al,1		; prepare command
   641 00000226 08E0                            or      al,ah		; clock or NVRAM write
   642 00000228 88C4                    	mov	ah,al		; command byte to AH
   643                                  byte_write_direct:
   644 0000022A E87D00                  	call	ds_reset_on	;start of command, set AL & DX
   645 0000022D E88B00                  	call	ds_reset_off	;prepare for read
   646                                  
   647                                  ; output the command, will turn Reset off
   648 00000230 E89500                          call    ds_outb
   649                                  
   650 00000233 88CC                            mov     ah,cl		;single byte to write
   651 00000235 E89000                          call    ds_outb
   652                                  
   653 00000238 E86F00                  	call	ds_reset_on	;terminate the write
   654 0000023B C3                      	ret
   655                                  
   656                                  
   657                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   658                                  ;
   659                                  ; INT 1A
   660                                  ; function 21   Set NVRAM byte
   661                                  ;
   662                                  ; Enter with:
   663                                  ;       AH      0x21
   664                                  ;       AL      byte number ( 0 <= AL <= 30) 
   665                                  ;   (single byte write)
   666                                  ;       CL      byte value to write
   667                                  ;
   668                                  ;       AH      0x21
   669                                  ;       AL      31
   670                                  ;       ES:BX   pointer to 31 byte buffer
   671                                  ;   (burst write)
   672                                  ;
   673                                  ; Exit with:
   674                                  ;       Carry clear
   675                                  ;
   676                                  ; Error:
   677                                  ;       Carry set
   678                                  ;
   679                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   680                                  	global	ds_write
   681                                  ds_write:
   682 0000023C 5250                            pushm   ax,dx
   683                                  
   684 0000023E 3C1F                    	cmp	al,31
   685 00000240 7307                    	jae	ds_burstw	; burst or error
   686                                  
   687                                  ; single byte write
   688                                  %if 1
   689 00000242 B4C0                    	mov	ah,1100_0000B   ; RAM/WRITE
   690 00000244 E8DDFF                  	call	byte_write
   691                                  %else
   692                                  	shl	al,1		; prepare command
   693                                          or      al,1100_0000B   ; RAM/WRITE
   694                                  	mov	ah,al		; command byte to AH
   695                                  
   696                                  	call	ds_reset_on	;start of command, set AL & DX
   697                                  	call	ds_reset_off	;prepare for read
   698                                  
   699                                  ; output the command, will turn Reset off
   700                                          call    ds_outb
   701                                  
   702                                          mov     ah,cl		;single byte to write
   703                                          call    ds_outb
   704                                  
   705                                  	call	ds_reset_on	;terminate the write
   706                                  %endif
   707 00000247 EB9B                    	jmp	ds_full_exit
   708                                  	
   709                                  	
   710                                  ; burst write
   711                                  ds_burstw:
   712 00000249 759D                            jne	ds_error	;must be 31 exactly, else error
   713                                  
   714 0000024B 5153                    	pushm	bx,cx		;extra save
   715                                  
   716 0000024D E85A00                  	call	ds_reset_on	;reset before command byte
   717 00000250 E86800                  	call	ds_reset_off	;prepare for burst write
   718                                  
   719 00000253 B4FE                    	mov	ah,1111_1110B	;burst write command
   720 00000255 E87000                  	call	ds_outb		;output the command
   721                                  
   722 00000258 B91F00                  	mov	cx,31		;
   723                                  ds_write2:
   724 0000025B 268A27                     es	mov	ah,byte [bx]	;get byte to write
   725 0000025E E86700                     	call	ds_outb
   726 00000261 43                      	inc	bx		;increment
   727 00000262 E2F7                    	loop	ds_write2
   728                                  
   729 00000264 E84300                  	call	ds_reset_on	;terminate the write
   730                                  
   731 00000267 5B59                    	popm	bx,cx
   732 00000269 E978FF                  	jmp	ds_full_exit	;restore & return
   733                                  
   734                                  
   735                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   736                                  ;
   737                                  ; INT 1A
   738                                  ; function 22   Enable/Disable write protect
   739                                  ;
   740                                  ; Enter with:
   741                                  ;       AH      0x22
   742                                  ;       AL      0x80 to set write protect
   743                                  ;		0x00 to disable write protect
   744                                  ;
   745                                  ; Exit with:
   746                                  ;       Carry clear
   747                                  ;
   748                                  ; Error:
   749                                  ;       Carry set
   750                                  ;
   751                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   752                                  wr_protect:
   753 0000026C 5250                    	pushm	ax,dx
   754 0000026E A87F                    	test	al,0111_1111B	; only 00,80h allowed
   755 00000270 0F8574FF                	jnz	ds_error
   756                                  
   757 00000274 51                      	pushm	cx
   758 00000275 88C1                    	mov	cl,al		; option to write
   759 00000277 B80780                  	mov	ax, 1000_0000B << 8 | 7	; clock write, reg 7
   760 0000027A E8A7FF                  	call	byte_write
   761 0000027D 59                      	popm	cx
   762                                  
   763 0000027E E963FF                  	jmp	ds_full_exit
   764                                  
   765                                  
   766                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   767                                  ;
   768                                  ; INT 1A
   769                                  ; function 23   Set charging parameters
   770                                  ;
   771                                  ; Enter with:
   772                                  ;       AH      0x23
   773                                  ;       AL      charge parameter byte
   774                                  ;
   775                                  ; Exit with:
   776                                  ;       Carry clear
   777                                  ;
   778                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   779                                  ds_set_charge:
   780 00000281 5250                    	pushm	ax,dx
   781 00000283 51                      	pushm	cx
   782                                  
   783 00000284 B480                    	mov	ah,1000_0000B	; clock write
   784 00000286 88C1                    	mov	cl,al		; byte to write
   785 00000288 B008                    	mov	al,8
   786 0000028A E897FF                  	call	byte_write
   787 0000028D 59                      	popm	cx
   788                                  
   789 0000028E E953FF                  	jmp	ds_full_exit
   790                                  
   791                                  
   792                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   793                                  ;
   794                                  ; INT 1A
   795                                  ; function 24   Get charging parameters
   796                                  ;
   797                                  ; Enter with:
   798                                  ;       AH      0x24
   799                                  ;
   800                                  ; Exit with:
   801                                  ;       AL      charge parameter byte
   802                                  ;       Carry clear
   803                                  ;
   804                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   805                                  	global	ds_get_charge
   806                                  ds_get_charge:
   807 00000291 5250                    	pushm	ax,dx
   808                                  
   809 00000293 B80881                  	mov	ax,1000_0001B << 8  | 8	; clock read
   810 00000296 E875FF                  	call	byte_read
   811 00000299 88E2                    	mov	dl,ah		; save in DL
   812 0000029B 58                      	popm	ax
   813 0000029C 88D0                    	mov	al,dl		; return in AL
   814                                  
   815 0000029E E944FF                  	jmp	ds_good_exit
   816                                  
   817                                  
   818                                  ;**********
   819                                  ; N.B. These will move to P1 from P3 on the final board
   820                                  ; Jan 2018 -- updated to P1 for rev 2.0 board
   821                                  ;**********
   822                                  DSLTC   equ     P1LTC           ; DS1302 latch
   823                                  DSPIN   equ     P1PIN           ;   pin value
   824                                  
   825                                  DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
   826                                  DSCLK   equ     BIT2            ; Clock idles high
   827                                  DSRST   equ     BIT3            ; Reset idles low (asserted)
   828                                  
   829                                  DSMSK   equ     DSRST+DSCLK+DSDAT
   830                                  
   831                                  
   832                                  %macro  us_delay 0
   833                                  	jmp	$+2
   834                                  	jmp	$+2
   835                                  	jmp	$+2
   836                                  %endmacro
   837                                  
   838                                  
   839 000002A1 90                      	align	2
   840                                  ds_out_latch:
   841 000002A2 EE                      	out	dx,al
   842                                  	us_delay
   833 000002A3 EB00                <1>  jmp $+2
   834 000002A5 EB00                <1>  jmp $+2
   835 000002A7 EB00                <1>  jmp $+2
   843 000002A9 C3                      	ret
   844                                  
   845                                  ;
   846                                  ; initializes the DSLTC in DX
   847                                  ; sets the Clock low, then asserts Reset
   848                                  ;
   849                                  	global	ds_reset_on
   850                                  ds_reset_on:
   851 000002AA BA62F8                  	mov	dx,DSLTC	;set I/O latch address in DX
   852 000002AD EC                      	in	al,dx		;get the latch value
   853 000002AE 24FB                    	and	al,~DSCLK	;set the clock low (should be idle state)
   854 000002B0 E8EFFF                  	call	ds_out_latch
   855 000002B3 0C01                    	or	al,DSDAT	;set data for input
   856 000002B5 24F7                    	and	al,~DSRST	;assert RESET#
   857 000002B7 E8E8FF                  	call	ds_out_latch
   858 000002BA C3                      	ret
   859                                  
   860                                  ;
   861                                  ; sets the Clock low, then removes the Reset
   862                                  ;
   863                                  	global	ds_reset_off
   864                                  ds_reset_off:		; assume DX is set
   865 000002BB 24FB                    	and	al,~DSCLK	;set the clock low (idle)
   866 000002BD 0C01                    	or	al,DSDAT	;set data for input
   867 000002BF E8E0FF                  	call	ds_out_latch
   868 000002C2 0C08                    	or	al,DSRST	;deassert RESET#
   869 000002C4 E8DBFF                  	call	ds_out_latch
   870 000002C7 C3                      	ret			;clock idles low
   871                                  
   872                                  ;
   873                                  ; moves output bit into position, and then drops the clock low
   874                                  ; pauses, then sets the clock high to clock in the data bit
   875                                  ; loops back for all 8 bits
   876                                  ; exits with the clock HIGH
   877                                  ;
   878                                  ds_outb:	;output the byte in AH
   879 000002C8 51                      	pushm	cx
   880 000002C9 B90800                  	mov	cx,8		;8 bits go out
   881                                  
   882 000002CC 24FB                    .1:	and	al,~DSCLK	;drop the clock
   883 000002CE D1E8                    	shr	ax,1		;LSB to AL
   884 000002D0 D0C0                    	rol	al,1		;data bit to position
   885 000002D2 E8CDFF                  	call	ds_out_latch
   886 000002D5 0C04                    	or	al,DSCLK	
   887 000002D7 E8C8FF                  	call	ds_out_latch
   888 000002DA E2F0                    	loop	.1
   889                                  
   890 000002DC 59                      	popm	cx
   891 000002DD C3                         	ret			;clock is high on exit
   892                                  
   893                                  ;
   894                                  ; sets clock High and data bit for input
   895                                  ; pauses, drops the clock, pauses, reads the data bit
   896                                  ; shifts 8 bits into AH from the left, hence LSB ends up in AX bit 8
   897                                  ; exits with the clock low
   898                                  ;
   899                                  ds_inb:		;input a byte to AH
   900 000002DE 51                      	pushm	cx
   901 000002DF B90800                  	mov	cx,8
   902                                  
   903 000002E2 0C05                    .2:	or	al,DSCLK+DSDAT	;raise the clock, O.C. data set for input
   904 000002E4 E8BBFF                  	call	ds_out_latch
   905 000002E7 24FB                    	and	al,~DSCLK	;drop the clock
   906 000002E9 E8B6FF                  	call	ds_out_latch
   907 000002EC 52                      	push	dx
   908 000002ED BA60F8                     	mov	dx,DSPIN	;set to read data bit
   909 000002F0 EC                      	in	al,dx		;data bit to LSB
   910 000002F1 5A                      	pop	dx
   911 000002F2 D1C8                    	ror	ax,1		;data to AH MSB
   912 000002F4 D0E0                    	shl	al,1		;restore latch value just read in
   913 000002F6 E2EA                    	loop	.2
   914                                  
   915 000002F8 59                      	popm	cx
   916 000002F9 C3                      	ret		; exit with clock Low
   917                                  
   918                                  ; convert packed BCD to binary int
   919                                  ;
   920                                  ;	arg in AL
   921                                  ;
   922                                  ;  int bcd2int(byte bcd);
   923                                  ;
   924                                  	global	bcd2int_
   925                                  bcd2int_:
   926 000002FA 88C4                    	mov	ah,al
   927 000002FC C0EC04                  	shr	ah,4		; AH is unpacked high decimal digit
   928 000002FF 240F                    	and	al,0x0F		; AL is unpacked low decimal digit
   929 00000301 D50A                    	aad			; convert to integer in AX
   930 00000303 C3                      	ret
   931                                  
   932                                  	global	day_of_week_
   933                                  day_of_week_:	;parameters in BCD
   934                                  ;	CH = century
   935                                  ;	CL = year
   936                                  ;	DH = month
   937                                  ;	DL = day
   938                                  ;
   939 00000304 88E8                    	mov	al,ch		;century to AL
   940 00000306 E8F1FF                  	call	bcd2int_
   941 00000309 89C3                    	mov	bx,ax
   942                                  
   943 0000030B 88C8                    	mov	al,cl		;year to AL
   944 0000030D E8EAFF                  	call	bcd2int_
   945 00000310 89C1                    	mov	cx,ax
   946                                  
   947 00000312 88F0                    	mov	al,dh		;month to AL
   948 00000314 E8E3FF                  	call	bcd2int_
   949 00000317 92                      	xchg	ax,dx		;month to DX, day to AL
   950 00000318 E8DFFF                  	call	bcd2int_
   951 0000031B 92                      	xchg	ax,dx		;day to DX, month to AX
   952                                  
   953                                  ; fall into 'dow_'
   954                                  	global	dow_
   955                                  dow_:
   956                                  ;	AX = month
   957                                  ;	DX = day
   958                                  ;	BX = century
   959                                  ;	CX = year
   960                                  ; normalize for calendar starting in March
   961 0000031C 83E803                  	sub	ax,3		;
   962 0000031F 790A                    	jns	.4
   963 00000321 83C00C                  	add	ax,12		; month went negative
   964 00000324 49                      	dec	cx
   965 00000325 7904                    	jns	.4
   966 00000327 83C164                  	add	cx,100		;
   967 0000032A 4B                      	dec	bx		; year went negative
   968                                  .4:
   969                                  ; now calculate
   970 0000032B 01CA                    	add	dx,cx		; D+Y
   971 0000032D C1E902                  	shr	cx,2		; Y/4
   972 00000330 01CA                    	add	dx,cx		; + Y/4
   973 00000332 01DA                    	add	dx,bx		; + C
   974 00000334 C1E302                  	shl	bx,2		; C*4
   975 00000337 01DA                    	add	dx,bx		; D+Y+Y/4+5*C
   976 00000339 C1EB04                  	shr	bx,4		; C/4
   977 0000033C 01DA                    	add	dx,bx		; + C/4
   978 0000033E B90500                  	mov	cx,5		; CX = 5
   979 00000341 F6F1                    	div	cl		; M/5 to AL, Mrem to AH
   980 00000343 88E3                    	mov	bl,ah		; BX = Mrem
   981 00000345 2E8A9F[5B03]               cs	mov	bl,[dow_tab+bx]
   982 0000034A 01DA                       	add	dx,bx
   983 0000034C 41                      	inc	cx		; CL = 6
   984 0000034D F6E1                    	mul	cl		; AX = (M/5)*6
   985 0000034F 01D0                    	add	ax,dx		; AX = sum
   986 00000351 31D2                    	xor	dx,dx
   987 00000353 41                      	inc	cx		; CX = 7
   988 00000354 40                      	inc	ax		; bias by 2
   989 00000355 40                      	inc	ax		; **
   990 00000356 F7F1                    	div	cx		; SUM div 7
   991 00000358 89D0                    	mov	ax,dx		; result to AX
   992 0000035A C3                      	ret
   993                                  
   994                                  dow_tab:
   995 0000035B 001F3D5C7A              	db	0,31,61,92,122;153
   996                                  
