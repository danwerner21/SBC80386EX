   481 00000129 750E                    	jne	.notverify
   482                                  	extern	_SecBuffer
   483 0000012B 2EA1[0000]                  cs	mov	ax,[_SecBuffer]
   484 0000012F 894608                  	mov	[bp+offset_bx],ax
   485 00000132 2EA1[0200]                  cs	mov	ax,[_SecBuffer+2]
