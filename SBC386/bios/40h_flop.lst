   725                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   726                                  ; 18h -- set media type for format
   727                                  ;
   728                                  ;  Enter with:
   729                                  ;	CH	last cylinder, CL bits 7:6 its high bits, bits 5:0 sectors
   730                                  ;	DL	drive
   731                                  ;
   732                                  ;  Exit with:
   733                                  ;	ES:DI	the parameter table describing that format
   734                                  ;	AH	0, or 0Ch if this drive cannot be asked for it
   735                                  ;
   736                                  ; Nothing is programmed here and nothing needs to be.  DOS asks this
   737                                  ; before formatting to find out whether a layout is possible at all and
   738                                  ; to be given the table for it; the rate and the geometry are settled
   739                                  ; when 05h runs.  Answering it is what lets a FORMAT proceed -- a drive
   740                                  ; that returns "invalid command" here is one DOS will not format.
   741                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   742                                  fn18_media:
   743 000002CD E876FD                  	call	fd_type
   744 000002D0 7250                    	jc	.nomedia
   745 000002D2 0FB6D8                  	movzx	bx,al			; the configured drive type
   746 000002D5 01DB                    	add	bx,bx
