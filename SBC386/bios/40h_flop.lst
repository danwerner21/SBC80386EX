   748                                  
   749                                  ; The geometry being asked for.
   750 000002DC 8A460C                  	mov	al,[bp+offset_cx]
   751 000002DF 88C4                    	mov	ah,al
   752 000002E1 243F                    	and	al,0x3F			; sectors per track
   753 000002E3 80E4C0                  	and	ah,0xC0
   754 000002E6 0FB6CC                  	movzx	cx,ah
   755 000002E9 C1E102                  	shl	cx,2
   756 000002EC 0FB6560D                	movzx	dx,byte [bp+offset_cx+1]
   757 000002F0 09CA                    	or	dx,cx
   758 000002F2 42                      	inc	dx			; cylinders, counted from the last
   759                                  
   760                                  .try:
   761 000002F3 2E0FB61C                    cs	movzx	bx,byte [si]
   762 000002F7 09DB                    	or	bx,bx
   763 000002F9 7427                    	jz	.nomedia		; the list ran out
   764 000002FB 46                      	inc	si
   765                                  
   766 000002FC 89DF                    	mov	di,bx			; fd_geom runs three bytes an entry
   767 000002FE 01FF                    	add	di,di
   768 00000300 01DF                    	add	di,bx
   769 00000302 2E3895[0000]                cs	cmp	byte [di+fd_geom],dl	; cylinders
   770 00000307 75EA                    	jne	.try
   771 00000309 2E3885[0200]                cs	cmp	byte [di+fd_geom+2],al	; sectors per track
   772 0000030E 75E3                    	jne	.try
   773                                  
   774 00000310 01DB                    	add	bx,bx
   775 00000312 2E8BBF[1000]                cs	mov	di,[bx+fd_param_table]
   776 00000317 897E00                  	mov	[bp+offset_di],di
   777 0000031A 8CC8                    	mov	ax,cs
   778 0000031C 894612                  	mov	[bp+offset_es],ax
   779 0000031F E9A7FD                  	jmp	fd_good
