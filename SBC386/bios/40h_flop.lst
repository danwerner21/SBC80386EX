   781                                  .nomedia:
   782 00000322 B40C                    	mov	ah,MEDIA_TYPE_NOT_FOUND
   783 00000324 E98FFD                  	jmp	fd_error
   784                                  
   785                                  
   786                                  ;
   787                                  ; Which formats a drive of each type may be asked to write, zero ended.
   788                                  ; A high density drive can also write the double density format of its
   789                                  ; own size; nothing can write a format its heads cannot reach, and a
   790                                  ; 720Kb drive asked for 1.44Mb has to be told no rather than left to
   791                                  ; produce a disk that reads back as noise.
   792                                  ;
