   636                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   637                                  ; 05h -- format a track
   638                                  ;
   639                                  ;  Enter with:
   640                                  ;	AL	sectors per track
   641                                  ;	CH	cylinder, CL bits 7:6 its high bits
   642                                  ;	DH	head
   643                                  ;	DL	drive
   644                                  ;	ES:BX	the address field table: four bytes a sector, C H R N
   645                                  ;
   646                                  ; The gap and the filler byte come from the table INT 1Eh points at, not
   647                                  ; from anything here.  That is where a FORMAT puts them when it wants a
   648                                  ; layout other than the standard one, and taking them from the built-in
   649                                  ; table instead would quietly ignore it.
   650                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   651                                  fn05_format:
   652 0000023B E808FE                  	call	fd_type
   653 0000023E 0F828600                	jc	.nodrive
   654 00000242 88C7                    	mov	bh,al			; BH = the FD_ type
   655                                  
   656 00000244 FF7612                  	push	word [bp+offset_es]	; the care rw_common takes, for the
   657 00000247 FF7608                  	push	word [bp+offset_bx]	;  same reason: the caller's cursor
   658 0000024A FF760C                  	push	word [bp+offset_cx]	;  registers have to go back
   659 0000024D FF760A                  	push	word [bp+offset_dx]
   660                                  
   661 00000250 1E                      	push	ds			; restored after the call below
   662                                  
   663 00000251 FF7612                  	push	word [bp+offset_es]	; chrn: segment first, so the offset
   664 00000254 FF7608                  	push	word [bp+offset_bx]	;  lands at the lower address
   665                                  
   666                                  ; The format gap and the filler, out of the INT 1Eh table.
   667 00000257 1E                      	push	ds
   668 00000258 31C0                    	xor	ax,ax
   669 0000025A 8ED8                    	mov	ds,ax
   670                                  	cnop
