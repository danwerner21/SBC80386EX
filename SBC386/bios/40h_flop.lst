    78 00000016 ????                <1> offset_cs	resw	1		; set for IRET */
    79 00000018 ????                <1> offset_flags	resw	1	; flag.0 is the Crrry */
    80                              <1> endstruc
    80          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    81                              <1> ; */
    56                                  %include "error.inc"
    57                              <1> XXX
    58                              <1> ; error.h -- defines for disk-specific error codes */
    59                              <1> ; */
    60                              <1> %define NO_ERROR	0
    61                              <1> %define INVALID_COMMAND		1
    62                              <1> %define ADDRESS_MARK_NOT_FOUND	2	; F */
    63                              <1> %define WRITE_PROTECTED		3	; F, SD */
    64                              <1> %define SECTOR_NOT_FOUND	4
    65                              <1> %define RESET_FAILED	5		; H */
    66                              <1> ; */
    67                              <1> %define DISK_REMOVED	6		; F, SD */
    68                              <1> %define	MEDIA_CHANGED	6
    69                              <1> ; */
    70                              <1> %define BAD_PARAMETER_TABLE	7
    71                              <1> %define DMA_OVERRUN		8		; F, H */
    72                              <1> ; */
    73                              <1> %define DMA_CROSSED_64K_BOUND	9
    74                              <1> %define DMA_BOUNDARY	9
    75                              <1> ; */
    76                              <1> %define BAD_SECTOR_FLAG	0x0A
    77                              <1> %define BAD_TRACK_FLAG	0x0B
    78                              <1> %define MEDIA_TYPE_NOT_FOUND	0x0C	; F */
    79                              <1> %define INVALID_NUMBER_OF_SECTORS	0x0D	; H */
    80                              <1> %define CONTROL_DATA_ADDRESS_MARK_DETECTED	0x0E	; H */
    81                              <1> %define DMA_ARBITRATION_LEVEL_OUT_OF_RANGE	0x0F	; H */
    82                              <1> %define BAD_CRC			0x10	; F */
    83                              <1> %define ECC_CORRECTED_DATA_ERROR	0x11	; H */
    84                              <1> %define CONTROLLER_FAILED		0x20
    85                              <1> %define BAD_SEEK		0x40
    86                              <1> %define TIME_OUT		0x80
    87                              <1> ; */
    88                              <1> %define DRIVE_NOT_READY		0xAA	; SD, H */
    89                              <1> %define UNDEFINED_ERROR		0xBB
    90                              <1> %define WRITE_FAULT		0xCC	; H */
    91                              <1> %define STATUS_REGISTER_ERROR	0xE0	; H */
    92                              <1> %define SENSE_OPERATION_FAILED	0xFF	; H */
    93                              <1> ; */
    94                              <1> ; */
    95                              <1> ; */
    96                              <1> ;---------- DISKETTE ERROR -------------------------------------	*/
    97                              <1> ; TIME_OUT	EQU	080H		; ATTACHMENT FAILED TO RESPOND		*/
    98                              <1> ; BAD_SEEK	EQU	040H		; SEEK OPERATION FAILED		*/
    99                              <1> ; BAD_NEC		EQU	020H		; DISKETTE CONTROLLER HAS FAILED		*/
   100                              <1> ; BAD_CRC		EQU	010H		; BAD CRC ON DISKETTE READ		*/
   101                              <1> ; DMA_BOUNDARY	EQU	009H		; ATTEMPT TO DMA ACROSS 64K BOUNDARY		*/
   102                              <1> ; BAD_DMA		EQU	008H		; DMA OVERRUN ON OPERATION		*/
   103                              <1> ; MEDIA_CHANGE	EQU	006H		; MEDIA REMOVED ON DUAL ATTACH CARD		*/
   104                              <1> ; RECORD_NOT_FND	EQU	004H		; REQUESTED SECTOR NOT FOUND		*/
   105                              <1> ; WRITE_PROTECT	EQU	003H		; WRITE ATTEMPTED ON WRITE PROTECT DISK		*/
   106                              <1> ; BAD_ADDR_MARK	EQU	002H		; ADDRESS MARK NOT FOUND		*/
   107                              <1> ; BAD_CMD		EQU	001H		; BAD COMMAND PASSED TO DISKETTE I/O		*/
   108                              <1> ; */
   109                              <1> ; */
    57                                  
    58                                  	global	int_40h
    59                                  	global	disk_base_360
    60                                  	global	disk_base_1200
    61                                  	global	disk_base_720
    62                                  	global	disk_base_1440
    63                                  	global	fd_param_table
    64                                  	global	fd_set_1E_
    65                                  
    66                                  	extern	_fd_reset
    67                                  	extern	_fd_rw
    68                                  	extern	_fd_format
    69                                  
    70                                  segment	_TEXT
    71                                  
    72                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    73                                  ; Geometry, by the drive type in bda.floppy_tab[].  The order matches the
    74                                  ; FD_ enum in "nvram.h", which is the PC/AT CMOS numbering: 1 is 360Kb,
    75                                  ; 2 is 1.2Mb, 3 is 720Kb, 4 is 1.44Mb.  Those numbers are what INT 13h
    76                                  ; function 15h hands back, and software has recognised them since 1984.
    77                                  ;
    78                                  ;	cylinders, heads, sectors per track
    79                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    80                                  	align	2
    81                                  fd_geom:
    82 00000000 000000                  	db	0,  0,  0		; FD_NONE
    83 00000003 280209                  	db	40, 2,  9		; FD_360
    84 00000006 50020F                  	db	80, 2, 15		; FD_1200
    85 00000009 500209                  	db	80, 2,  9		; FD_720
    86 0000000C 500212                  	db	80, 2, 18		; FD_1440
    87                                  FD_TYPES	equ	($-fd_geom)/3
    88                                  
    89                                  ; The same numbering as the enum in "nvram.h", which is the PC/AT CMOS
    90                                  ; coding.  Named here because the tables below are lists of types
    91                                  ; rather than a row per type, and a bare 4 in such a list says nothing.
    92                                  FD_NONE		equ	0
    93                                  FD_360		equ	1
    94                                  FD_1200		equ	2
    95                                  FD_720		equ	3
    96                                  FD_1440		equ	4
    97                                  
    98                                  ;
    99                                  ; The INT 1Eh disk base tables, one per type.  They differ in the places
   100                                  ; that matter to a reader: sectors per track, the gap lengths, and the
   101                                  ; motor start time.  INT 13h function 08h hands back the one that belongs
   102                                  ; to the drive being asked about.
   103                                  ;
   104 0000000F 90                      	align	2
   105                                  fd_param_table:
   106 00000010 [1A00]                  	dw	disk_base_none
   107 00000012 [3B00]                  	dw	disk_base_360
   108 00000014 [2500]                  	dw	disk_base_1200
   109 00000016 [3000]                  	dw	disk_base_720
   110 00000018 [1A00]                  	dw	disk_base_1440
   111                                  
   112                                  disk_base_none:
   113                                  disk_base_1440:
   114 0000001A DF                      	db	0xDF		; step rate 0Dh, head unload time Fh
   115 0000001B 02                      	db	0x02		; head load time 1, DMA used
   116 0000001C 25                      	db	0x25		; ticks before the motor stops
   117 0000001D 02                      	db	0x02		; bytes per sector, 2 = 512
   118 0000001E 12                      	db	18		; sectors per track
   119 0000001F 1B                      	db	0x1B		; gap length between sectors
   120 00000020 FF                      	db	0xFF		; data length
   121 00000021 6C                      	db	0x6C		; gap length when formatting
   122 00000022 F6                      	db	0xF6		; fill byte for formatting
   123 00000023 0F                      	db	0x0F		; head settle time, milliseconds
   124 00000024 08                      	db	0x08		; motor start time, eighths of a second
   125                                  
   126                                  disk_base_1200:
   127 00000025 DF022502                	db	0xDF, 0x02, 0x25, 0x02
   128 00000029 0F                      	db	15
   129 0000002A 1BFF54F60F08            	db	0x1B, 0xFF, 0x54, 0xF6, 0x0F, 0x08
   130                                  
   131                                  disk_base_720:
   132 00000030 DF022502                	db	0xDF, 0x02, 0x25, 0x02
   133 00000034 09                      	db	9
   134 00000035 2AFF50F60F08            	db	0x2A, 0xFF, 0x50, 0xF6, 0x0F, 0x08
   135                                  
   136                                  disk_base_360:
   137 0000003B DF022502                	db	0xDF, 0x02, 0x25, 0x02
   138 0000003F 09                      	db	9
   139 00000040 2AFF50F60F08            	db	0x2A, 0xFF, 0x50, 0xF6, 0x0F, 0x08
   140                                  
   141                                  
   142                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   143                                  ; fd_type -- the configured type of the drive in DL
   144                                  ;
   145                                  ;    Exit with:
   146                                  ;	AL	the FD_ type, 0 if the drive is not configured or not there
   147                                  ;	SI	its entry in fd_geom
   148                                  ;	Carry set if there is no such drive
   149                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   150                                  ; The drive comes from the saved frame, not from the live DL.  rw_common
   151                                  ; uses DX as its sectors-completed counter, so by the time fd_next asks for
   152                                  ; the geometry mid-transfer the live DL is a count, not a drive -- which
   153                                  ; fetched the wrong track layout, stepped the head and cylinder wrongly, and
   154                                  ; seeked somewhere that was not there.  The first sector always worked,
   155                                  ; which is why a DIR of a root directory inside one track never showed it.
   156                                  fd_type:
   157 00000046 53                      	push	bx
   158 00000047 1E                      	push	ds
   159 00000048 6A401F                  	get_bda	DS
   160                                  
   161 0000004B 0FB65E0A                	movzx	bx,byte [bp+offset_dx]	; BP is SS-relative, so this reads the
   162                                  					;  caller's DL whatever DS now is
   163 0000004F 80FB02                  	cmp	bl,2			; two drives is all a PC cable has
   164 00000052 731D                    	jnb	.bad
   165 00000054 8A87E300                	mov	al,[bx+floppy_tab]
   166 00000058 3C05                    	cmp	al,FD_TYPES
   167 0000005A 7315                    	jnb	.bad
   168 0000005C 08C0                    	or	al,al
   169 0000005E 7411                    	jz	.bad
   170                                  
   171 00000060 0FB6F0                  	movzx	si,al			; AL * 3 into the geometry table
   172 00000063 89F3                    	mov	bx,si			; BX is already saved
   173 00000065 01F6                    	add	si,si
   174 00000067 01DE                    	add	si,bx			;  -- and AX may have rubbish in AH,
   175 00000069 81C6[0000]              	add	si,fd_geom		;     which is why BX does the adding
   176 0000006D F8                      	clc
   177                                  .9:
   178 0000006E 1F                      	pop	ds
   179 0000006F 5B                      	pop	bx
   180 00000070 C3                      	ret
   181                                  .bad:
   182 00000071 30C0                    	xor	al,al
   183 00000073 F9                      	stc
   184 00000074 EBF8                    	jmp	short .9
   185                                  
   186                                  
   187                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   188                                  ; INT 40h
   189                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   190                                  ; This was neutralised for a while behind a FLOPPY_INT13 define, bisecting a
   191                                  ; boot failure that turned out to be a corrupt CF image -- the card would not
   192                                  ; boot on another PC either.  The switch is gone; it was chasing a fault that
   193                                  ; was never in this file.
   194                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   195                                  ; A trace, for watching a boot that hangs with no console left.
   196                                  ;
   197                                  ; INT 14h transmit is polled rather than interrupt driven, so this still
   198                                  ; writes when a hang has taken the interrupts with it -- which is exactly
   199                                  ; the case it is for.  One character in on each call, naming the function,
   200                                  ; and one out saying how it went:
   201                                  ;
   202                                  ;	0 1 2 3 4 8 E	the function: 00, 01, 02, 03, 04, 08, 15h
   203                                  ;	.		returned with no error
   204                                  ;	!		returned an error
   205                                  ;	?		an unsupported function
   206                                  ;
   207                                  ; So a working read is "2." and a drive retrying one for ever is
   208                                  ; "2!2!2!2!..." for as long as you care to watch it.
   209                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   210                                  %define FD_TRACE 0
   211                                  
   212                                  %if FD_TRACE
   213                                  fd_trace:				; AL = the character to send
   214                                  	pushm	ax,bx,cx,dx
   215                                  	mov	ah,1			; INT 14h write, polled
   216                                  	xor	dx,dx			; COM1
   217                                  	int	0x14
   218                                  	popm	ax,bx,cx,dx
   219                                  	ret
   220                                  
   221                                  
   222                                  ;
   223                                  ; The request, as "[cc hh ss nn ssss:bbbb]" -- cylinder, head, sector (with
   224                                  ; the two high cylinder bits still in its top bits, as INT 13h passes them),
   225                                  ; count, and the caller's buffer.
   226                                  ;
   227                                  ; Entered at the top of int_40h with CX and DX still as the caller set them,
   228                                  ; and BP framing the pushed registers.  Every helper below preserves BX, CX
   229                                  ; and DX so the live request survives being printed a piece at a time.
   230                                  ;
   231                                  fd_trace_rw:
   232                                  	pushm	ax,bx,cx,dx
   233                                  	mov	al,'['
   234                                  	call	fd_trace
   235                                  	mov	al,ch			; cylinder, low eight bits
   236                                  	call	fd_trace_hex
   237                                  	mov	al,' '
   238                                  	call	fd_trace
   239                                  	mov	al,dh			; head
   240                                  	call	fd_trace_hex
   241                                  	mov	al,' '
   242                                  	call	fd_trace
   243                                  	mov	al,cl			; sector, plus the high cylinder bits
   244                                  	call	fd_trace_hex
   245                                  	mov	al,' '
   246                                  	call	fd_trace
   247                                  	mov	al,[bp+offset_ax]	; sector count, as it came in
   248                                  	call	fd_trace_hex
   249                                  	mov	al,' '
   250                                  	call	fd_trace
   251                                  	mov	ax,[bp+offset_es]
   252                                  	call	fd_trace_hex16
   253                                  	mov	al,':'
   254                                  	call	fd_trace
   255                                  	mov	ax,[bp+offset_bx]
   256                                  	call	fd_trace_hex16
   257                                  	mov	al,']'
   258                                  	call	fd_trace
   259                                  	popm	ax,bx,cx,dx
   260                                  	ret
   261                                  
   262                                  fd_trace_hex16:				; AX, as four hex digits
   263                                  	pushm	ax,bx,cx,dx
   264                                  	xchg	al,ah
   265                                  	call	fd_trace_hex
   266                                  	xchg	al,ah
   267                                  	call	fd_trace_hex
   268                                  	popm	ax,bx,cx,dx
   269                                  	ret
   270                                  
   271                                  fd_trace_hex:				; AL, as two hex digits
   272                                  	pushm	ax,bx,cx,dx
   273                                  	mov	ah,al
   274                                  	shr	al,4
   275                                  	call	fd_trace_nyb
   276                                  	mov	al,ah
   277                                  	call	fd_trace_nyb
   278                                  	popm	ax,bx,cx,dx
   279                                  	ret
   280                                  
   281                                  fd_trace_nyb:
   282                                  	and	al,0x0F
   283                                  	add	al,'0'
   284                                  	cmp	al,'9'
   285                                  	jbe	.1
   286                                  	add	al,7			; 'A' through 'F'
   287                                  .1:
   288                                  	jmp	fd_trace		; its RET returns for us
   289                                  %endif
   290                                  
   291                                  
   292                                  int_40h:
   293 00000076 FB                      	sti
   294 00000077 061E60                  	pushm	all,ds,es
   295 0000007A 89E5                    	mov	bp,sp
   296 0000007C FC                      	cld
   297                                  
   298                                  %if FD_TRACE
   299                                  	push	ax
   300                                  	mov	al,ah
   301                                  	add	al,'0'			; 0-4 and 8 land on digits, 15h on E
   302                                  	call	fd_trace
   303                                  	pop	ax
   304                                  
   305                                  ; For the transfer calls, say what was asked for.  Which sectors DOS wants
   306                                  ; is the whole question once the driver is known to return them correctly:
   307                                  ; a request that is itself wrong -- a silly count, a cylinder off the end,
   308                                  ; a buffer in a segment that does not exist -- would be carried out
   309                                  ; faithfully and still wreck the caller.  The one-character trace cannot
   310                                  ; show that, and it is the only thing left that it cannot show.
   311                                  	cmp	ah,0x02
   312                                  	jb	.notrw
   313                                  	cmp	ah,0x05			; 05h formats, and wants the same
   314                                  	ja	.notrw			;  detail as a transfer
   315                                  	call	fd_trace_rw
   316                                  .notrw:
   317                                  %endif
   318                                  
   319 0000007D 80FC00                  	cmp	ah,0x00
   320 00000080 745C                    	je	fn00_reset
   321 00000082 80FC01                  	cmp	ah,0x01
   322 00000085 746B                    	je	fn01_status
   323 00000087 80FC02                  	cmp	ah,0x02
   324 0000008A 0F848000                	je	fn02_read
   325 0000008E 80FC03                  	cmp	ah,0x03
   326 00000091 7476                    	je	fn03_write
   327 00000093 80FC04                  	cmp	ah,0x04
   328 00000096 746D                    	je	fn04_verify
   329 00000098 80FC05                  	cmp	ah,0x05
   330 0000009B 0F849C01                	je	fn05_format
   331 0000009F 80FC08                  	cmp	ah,0x08
   332 000000A2 0F849602                	je	fn08_params
   333 000000A6 80FC15                  	cmp	ah,0x15
   334 000000A9 0F84E202                	je	fn15_type
   335 000000AD 80FC18                  	cmp	ah,0x18
   336 000000B0 0F841902                	je	fn18_media
   337                                  
   338 000000B4 B401                    	mov	ah,INVALID_COMMAND
   339                                  ; fall through
   340                                  
   341                                  ;
   342                                  ; Return paths.  AH carries the status and the Carry says whether it is an
   343                                  ; error, which is what floppy_call propagates when it does its RETF 2.
   344                                  ;
   345                                  fd_error:
   346 000000B6 88660F                  	mov	[bp+offset_ax+1],ah
   347                                  %if FD_TRACE
   348                                  	mov	al,'!'
   349                                  	call	fd_trace
   350                                  %endif
   351 000000B9 1E                      	push	ds
   352 000000BA 6A401F                  	get_bda	DS
   353 000000BD 88264100                	mov	[fd_status],ah
   354 000000C1 1F                      	pop	ds
   355 000000C2 611F07                  	popm	all,ds,es
   356 000000C5 F9                      	stc
   357 000000C6 CA0200                  	retf	2
   358                                  
   359                                  fd_good:
   360 000000C9 C6460F00                	mov	byte [bp+offset_ax+1],0
   361                                  %if FD_TRACE
   362                                  	mov	al,'.'
   363                                  	call	fd_trace
   364                                  %endif
   365 000000CD 1E                      	push	ds
   366 000000CE 6A401F                  	get_bda	DS
   367 000000D1 C606410000              	mov	byte [fd_status],0
   368 000000D6 1F                      	pop	ds
   369 000000D7 611F07                  	popm	all,ds,es
   370 000000DA F8                      	clc
   371 000000DB CA0200                  	retf	2
   372                                  
   373                                  
   374                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   375                                  ; 00h -- reset.  Pulses the controller's reset line and re-specifies it.
   376                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   377                                  fn00_reset:
   378 000000DE 1E                      	push	ds
   379 000000DF B8[ssss]                	mov	ax,DGROUP		; the driver in diskfdc.c reaches the
   380 000000E2 8ED8                    	mov	ds,ax			;  BDA through bda_ptr, which lives in
   381 000000E4 E8(0000)                	call	_fd_reset		;  DGROUP -- and INT 40h arrives with
   382 000000E7 1F                      	pop	ds			;  whatever DS the caller had
   383 000000E8 08C0                    	or	al,al
   384 000000EA 7502                    	jnz	.1
   385 000000EC EBDB                    	jmp	fd_good
   386 000000EE 88C4                    .1:	mov	ah,al
   387 000000F0 EBC4                    	jmp	fd_error
   388                                  
   389                                  
   390                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   391                                  ; 01h -- the status of the last operation.  DOS reads this after a failure.
   392                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   393                                  fn01_status:
   394 000000F2 1E                      	push	ds
   395 000000F3 6A401F                  	get_bda	DS
   396 000000F6 8A264100                	mov	ah,[fd_status]
   397 000000FA 1F                      	pop	ds
   398 000000FB 88660F                  	mov	[bp+offset_ax+1],ah
   399 000000FE 611F07                  	popm	all,ds,es
   400 00000101 F8                      	clc
   401 00000102 CA0200                  	retf	2
   402                                  
   403                                  
   404                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   405                                  ; 02h / 03h / 04h -- read, write, verify
   406                                  ;
   407                                  ;  Enter with:
   408                                  ;	AL	sectors to transfer
   409                                  ;	CH	cylinder, CL bits 5:0 sector, bits 7:6 cylinder high
   410                                  ;	DH	head
   411                                  ;	DL	drive
   412                                  ;	ES:BX	buffer
   413                                  ;
   414                                  ;  Exit with:
   415                                  ;	AL	sectors actually transferred
   416                                  ;
   417                                  ; One sector per driver call, stepping the address on afterwards.  Verify
   418                                  ; reads into the same buffer over and over and throws the data away: proving
   419                                  ; the sectors read back is the whole of what verify is for.
   420                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   421                                  fn04_verify:
   422 00000105 31FF                    	xor	di,di			; verify reads; the buffer is not
   423 00000107 EB07                    	jmp	short rw_common		;  advanced, which is what makes it
   424                                  fn03_write:				;  a verify rather than a read
   425 00000109 BF0100                  	mov	di,1
   426 0000010C EB02                    	jmp	short rw_common
   427                                  
   428                                  ;
   429                                  ; Put back the caller's cursor registers.  Used at every exit below that
   430                                  ; can be reached after they have been pushed.
   431                                  ;
   432                                  %macro	rw_pop 0
   433                                  	pop	word [bp+offset_dx]
   434                                  	pop	word [bp+offset_cx]
   435                                  	pop	word [bp+offset_bx]
   436                                  	pop	word [bp+offset_es]
   437                                  %endmacro
   438                                  
   439                                  fn02_read:
   440 0000010E 31FF                    	xor	di,di
   441                                  rw_common:
   442 00000110 E833FF                  	call	fd_type
   443 00000113 0F82CF00                	jc	.nodrive
   444 00000117 88C7                    	mov	bh,al			; BH = the FD_ type
   445                                  
   446                                  ;
   447                                  ; The caller's CX, DX and ES:BX are this loop's cursor: fd_next steps the
   448                                  ; cylinder, head and sector in the frame, and the buffer walks on by 512 a
   449                                  ; sector.  They have to go back before returning.  INT 13h hands back the
   450                                  ; registers it was called with -- only AH, AL and the Carry mean anything
   451                                  ; on return -- and DOS depends on that: it adds the transfer length to its
   452                                  ; own ES:BX afterwards, so a pointer left walked on gets counted twice.
   453                                  ;
   454                                  ; The doubling is not a slow leak.  It gains a sector for every sector
   455                                  ; transferred, and the moment the offset carries past FFFFh the next read
   456                                  ; lands back at the bottom of the same segment, on top of whatever is
   457                                  ; already living there -- which, when the file being loaded is COMMAND.COM,
   458                                  ; is DOS itself.
   459                                  ;
   460 00000119 FF7612                  	push	word [bp+offset_es]
   461 0000011C FF7608                  	push	word [bp+offset_bx]
