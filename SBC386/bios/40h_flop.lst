    76                              <1> ; */
    77 00000014 ????                <1> offset_ip	resw	1
    78 00000016 ????                <1> offset_cs	resw	1		; set for IRET */
    79 00000018 ????                <1> offset_flags	resw	1	; flag.0 is the Crrry */
    80                              <1> endstruc
    80          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    81                              <1> ; */
    56                                  %include "error.inc"
    57                              <1> XXX
    58                              <1> ; error.h -- defines for disk-specific error codes */
    59                              <1> ; */
    60                              <1> %define NO_ERROR	0
    61                              <1> %define INVALID_COMMAND		1
    62                              <1> %define ADDRESS_MARK_NOT_FOUND	2	; F */
    63                              <1> %define WRITE_PROTECTED		3	; F, SD */
    64                              <1> %define SECTOR_NOT_FOUND	4
    65                              <1> %define RESET_FAILED	5		; H */
    66                              <1> ; */
    67                              <1> %define DISK_REMOVED	6		; F, SD */
    68                              <1> %define	MEDIA_CHANGED	6
    69                              <1> ; */
    70                              <1> %define BAD_PARAMETER_TABLE	7
    71                              <1> %define DMA_OVERRUN		8		; F, H */
    72                              <1> ; */
    73                              <1> %define DMA_CROSSED_64K_BOUND	9
    74                              <1> %define DMA_BOUNDARY	9
    75                              <1> ; */
    76                              <1> %define BAD_SECTOR_FLAG	0x0A
    77                              <1> %define BAD_TRACK_FLAG	0x0B
    78                              <1> %define MEDIA_TYPE_NOT_FOUND	0x0C	; F */
    79                              <1> %define INVALID_NUMBER_OF_SECTORS	0x0D	; H */
    80                              <1> %define CONTROL_DATA_ADDRESS_MARK_DETECTED	0x0E	; H */
    81                              <1> %define DMA_ARBITRATION_LEVEL_OUT_OF_RANGE	0x0F	; H */
    82                              <1> %define BAD_CRC			0x10	; F */
    83                              <1> %define ECC_CORRECTED_DATA_ERROR	0x11	; H */
    84                              <1> %define CONTROLLER_FAILED		0x20
    85                              <1> %define BAD_SEEK		0x40
    86                              <1> %define TIME_OUT		0x80
    87                              <1> ; */
    88                              <1> %define DRIVE_NOT_READY		0xAA	; SD, H */
    89                              <1> %define UNDEFINED_ERROR		0xBB
    90                              <1> %define WRITE_FAULT		0xCC	; H */
    91                              <1> %define STATUS_REGISTER_ERROR	0xE0	; H */
    92                              <1> %define SENSE_OPERATION_FAILED	0xFF	; H */
    93                              <1> ; */
    94                              <1> ; */
    95                              <1> ; */
    96                              <1> ;---------- DISKETTE ERROR -------------------------------------	*/
    97                              <1> ; TIME_OUT	EQU	080H		; ATTACHMENT FAILED TO RESPOND		*/
    98                              <1> ; BAD_SEEK	EQU	040H		; SEEK OPERATION FAILED		*/
    99                              <1> ; BAD_NEC		EQU	020H		; DISKETTE CONTROLLER HAS FAILED		*/
   100                              <1> ; BAD_CRC		EQU	010H		; BAD CRC ON DISKETTE READ		*/
   101                              <1> ; DMA_BOUNDARY	EQU	009H		; ATTEMPT TO DMA ACROSS 64K BOUNDARY		*/
   102                              <1> ; BAD_DMA		EQU	008H		; DMA OVERRUN ON OPERATION		*/
   103                              <1> ; MEDIA_CHANGE	EQU	006H		; MEDIA REMOVED ON DUAL ATTACH CARD		*/
   104                              <1> ; RECORD_NOT_FND	EQU	004H		; REQUESTED SECTOR NOT FOUND		*/
   105                              <1> ; WRITE_PROTECT	EQU	003H		; WRITE ATTEMPTED ON WRITE PROTECT DISK		*/
   106                              <1> ; BAD_ADDR_MARK	EQU	002H		; ADDRESS MARK NOT FOUND		*/
   107                              <1> ; BAD_CMD		EQU	001H		; BAD COMMAND PASSED TO DISKETTE I/O		*/
   108                              <1> ; */
   109                              <1> ; */
    57                                  
    58                                  	global	int_40h
    59                                  	global	disk_base_360
    60                                  	global	disk_base_1200
    61                                  	global	disk_base_720
    62                                  	global	disk_base_1440
    63                                  	global	fd_param_table
    64                                  
    65                                  	extern	_fd_reset
    66                                  	extern	_fd_rw
    67                                  
    68                                  segment	_TEXT
    69                                  
    70                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    71                                  ; Geometry, by the drive type in bda.floppy_tab[].  The order matches the
    72                                  ; FD_ enum in "nvram.h", which is the PC/AT CMOS numbering: 1 is 360Kb,
    73                                  ; 2 is 1.2Mb, 3 is 720Kb, 4 is 1.44Mb.  Those numbers are what INT 13h
    74                                  ; function 15h hands back, and software has recognised them since 1984.
    75                                  ;
    76                                  ;	cylinders, heads, sectors per track
    77                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    78                                  	align	2
    79                                  fd_geom:
    80 00000000 000000                  	db	0,  0,  0		; FD_NONE
    81 00000003 280209                  	db	40, 2,  9		; FD_360
    82 00000006 50020F                  	db	80, 2, 15		; FD_1200
    83 00000009 500209                  	db	80, 2,  9		; FD_720
    84 0000000C 500212                  	db	80, 2, 18		; FD_1440
    85                                  FD_TYPES	equ	($-fd_geom)/3
    86                                  
    87                                  ;
    88                                  ; The INT 1Eh disk base tables, one per type.  They differ in the places
    89                                  ; that matter to a reader: sectors per track, the gap lengths, and the
    90                                  ; motor start time.  INT 13h function 08h hands back the one that belongs
    91                                  ; to the drive being asked about.
    92                                  ;
    93 0000000F 90                      	align	2
    94                                  fd_param_table:
    95 00000010 [1A00]                  	dw	disk_base_none
    96 00000012 [3B00]                  	dw	disk_base_360
    97 00000014 [2500]                  	dw	disk_base_1200
    98 00000016 [3000]                  	dw	disk_base_720
    99 00000018 [1A00]                  	dw	disk_base_1440
   100                                  
   101                                  disk_base_none:
   102                                  disk_base_1440:
   103 0000001A DF                      	db	0xDF		; step rate 0Dh, head unload time Fh
   104 0000001B 02                      	db	0x02		; head load time 1, DMA used
   105 0000001C 25                      	db	0x25		; ticks before the motor stops
   106 0000001D 02                      	db	0x02		; bytes per sector, 2 = 512
   107 0000001E 12                      	db	18		; sectors per track
   108 0000001F 1B                      	db	0x1B		; gap length between sectors
   109 00000020 FF                      	db	0xFF		; data length
   110 00000021 54                      	db	0x54		; gap length when formatting
   111 00000022 F6                      	db	0xF6		; fill byte for formatting
   112 00000023 0F                      	db	0x0F		; head settle time, milliseconds
   113 00000024 08                      	db	0x08		; motor start time, eighths of a second
   114                                  
   115                                  disk_base_1200:
   116 00000025 DF022502                	db	0xDF, 0x02, 0x25, 0x02
   117 00000029 0F                      	db	15
   118 0000002A 1BFF54F60F08            	db	0x1B, 0xFF, 0x54, 0xF6, 0x0F, 0x08
   119                                  
   120                                  disk_base_720:
   121 00000030 DF022502                	db	0xDF, 0x02, 0x25, 0x02
   122 00000034 09                      	db	9
   123 00000035 2AFF50F60F08            	db	0x2A, 0xFF, 0x50, 0xF6, 0x0F, 0x08
   124                                  
   125                                  disk_base_360:
   126 0000003B DF022502                	db	0xDF, 0x02, 0x25, 0x02
   127 0000003F 09                      	db	9
   128 00000040 2AFF50F60F08            	db	0x2A, 0xFF, 0x50, 0xF6, 0x0F, 0x08
   129                                  
   130                                  
   131                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   132                                  ; fd_type -- the configured type of the drive in DL
   133                                  ;
   134                                  ;    Exit with:
   135                                  ;	AL	the FD_ type, 0 if the drive is not configured or not there
   136                                  ;	SI	its entry in fd_geom
   137                                  ;	Carry set if there is no such drive
   138                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   139                                  ; The drive comes from the saved frame, not from the live DL.  rw_common
   140                                  ; uses DX as its sectors-completed counter, so by the time fd_next asks for
   141                                  ; the geometry mid-transfer the live DL is a count, not a drive -- which
   142                                  ; fetched the wrong track layout, stepped the head and cylinder wrongly, and
   143                                  ; seeked somewhere that was not there.  The first sector always worked,
   144                                  ; which is why a DIR of a root directory inside one track never showed it.
   145                                  fd_type:
   146 00000046 53                      	push	bx
   147 00000047 1E                      	push	ds
   148 00000048 6A401F                  	get_bda	DS
   149                                  
   150 0000004B 0FB65E0A                	movzx	bx,byte [bp+offset_dx]	; BP is SS-relative, so this reads the
   151                                  					;  caller's DL whatever DS now is
   152 0000004F 80FB02                  	cmp	bl,2			; two drives is all a PC cable has
   153 00000052 731D                    	jnb	.bad
   154 00000054 8A87E300                	mov	al,[bx+floppy_tab]
   155 00000058 3C05                    	cmp	al,FD_TYPES
   156 0000005A 7315                    	jnb	.bad
   157 0000005C 08C0                    	or	al,al
   158 0000005E 7411                    	jz	.bad
   159                                  
   160 00000060 0FB6F0                  	movzx	si,al			; AL * 3 into the geometry table
   161 00000063 89F3                    	mov	bx,si			; BX is already saved
   162 00000065 01F6                    	add	si,si
   163 00000067 01DE                    	add	si,bx			;  -- and AX may have rubbish in AH,
   164 00000069 81C6[0000]              	add	si,fd_geom		;     which is why BX does the adding
   165 0000006D F8                      	clc
   166                                  .9:
   167 0000006E 1F                      	pop	ds
   168 0000006F 5B                      	pop	bx
   169 00000070 C3                      	ret
   170                                  .bad:
   171 00000071 30C0                    	xor	al,al
   172 00000073 F9                      	stc
   173 00000074 EBF8                    	jmp	short .9
   174                                  
   175                                  
   176                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   177                                  ; INT 40h
   178                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   179                                  ; This was neutralised for a while behind a FLOPPY_INT13 define, bisecting a
   180                                  ; boot failure that turned out to be a corrupt CF image -- the card would not
   181                                  ; boot on another PC either.  The switch is gone; it was chasing a fault that
   182                                  ; was never in this file.
   183                                  int_40h:
   184 00000076 FB                      	sti
   185 00000077 061E60                  	pushm	all,ds,es
   186 0000007A 89E5                    	mov	bp,sp
   187 0000007C FC                      	cld
   188                                  
   189 0000007D 80FC00                  	cmp	ah,0x00
   190 00000080 744C                    	je	fn00_reset
   191 00000082 80FC01                  	cmp	ah,0x01
   192 00000085 745B                    	je	fn01_status
   193 00000087 80FC02                  	cmp	ah,0x02
   194 0000008A 7472                    	je	fn02_read
   195 0000008C 80FC03                  	cmp	ah,0x03
   196 0000008F 7468                    	je	fn03_write
   197 00000091 80FC04                  	cmp	ah,0x04
   198 00000094 745F                    	je	fn04_verify
   199 00000096 80FC08                  	cmp	ah,0x08
   200 00000099 0F844A01                	je	fn08_params
   201 0000009D 80FC15                  	cmp	ah,0x15
   202 000000A0 0F849601                	je	fn15_type
   203                                  
   204 000000A4 B401                    	mov	ah,INVALID_COMMAND
   205                                  ; fall through
   206                                  
   207                                  ;
   208                                  ; Return paths.  AH carries the status and the Carry says whether it is an
   209                                  ; error, which is what floppy_call propagates when it does its RETF 2.
   210                                  ;
   211                                  fd_error:
   212 000000A6 88660F                  	mov	[bp+offset_ax+1],ah
   213 000000A9 1E                      	push	ds
   214 000000AA 6A401F                  	get_bda	DS
   215 000000AD 88264100                	mov	[fd_status],ah
   216 000000B1 1F                      	pop	ds
   217 000000B2 611F07                  	popm	all,ds,es
   218 000000B5 F9                      	stc
   219 000000B6 CA0200                  	retf	2
   220                                  
   221                                  fd_good:
   222 000000B9 C6460F00                	mov	byte [bp+offset_ax+1],0
   223 000000BD 1E                      	push	ds
   224 000000BE 6A401F                  	get_bda	DS
   225 000000C1 C606410000              	mov	byte [fd_status],0
   226 000000C6 1F                      	pop	ds
   227 000000C7 611F07                  	popm	all,ds,es
   228 000000CA F8                      	clc
   229 000000CB CA0200                  	retf	2
   230                                  
   231                                  
   232                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   233                                  ; 00h -- reset.  Pulses the controller's reset line and re-specifies it.
   234                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   235                                  fn00_reset:
   236 000000CE 1E                      	push	ds
   237 000000CF B8[ssss]                	mov	ax,DGROUP		; the driver in diskfdc.c reaches the
   238 000000D2 8ED8                    	mov	ds,ax			;  BDA through bda_ptr, which lives in
   239 000000D4 E8(0000)                	call	_fd_reset		;  DGROUP -- and INT 40h arrives with
   240 000000D7 1F                      	pop	ds			;  whatever DS the caller had
   241 000000D8 08C0                    	or	al,al
   242 000000DA 7502                    	jnz	.1
   243 000000DC EBDB                    	jmp	fd_good
   244 000000DE 88C4                    .1:	mov	ah,al
   245 000000E0 EBC4                    	jmp	fd_error
   246                                  
   247                                  
   248                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   249                                  ; 01h -- the status of the last operation.  DOS reads this after a failure.
   250                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   251                                  fn01_status:
   252 000000E2 1E                      	push	ds
   253 000000E3 6A401F                  	get_bda	DS
   254 000000E6 8A264100                	mov	ah,[fd_status]
   255 000000EA 1F                      	pop	ds
   256 000000EB 88660F                  	mov	[bp+offset_ax+1],ah
   257 000000EE 611F07                  	popm	all,ds,es
   258 000000F1 F8                      	clc
   259 000000F2 CA0200                  	retf	2
   260                                  
   261                                  
   262                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   263                                  ; 02h / 03h / 04h -- read, write, verify
   264                                  ;
   265                                  ;  Enter with:
   266                                  ;	AL	sectors to transfer
   267                                  ;	CH	cylinder, CL bits 5:0 sector, bits 7:6 cylinder high
   268                                  ;	DH	head
   269                                  ;	DL	drive
   270                                  ;	ES:BX	buffer
   271                                  ;
   272                                  ;  Exit with:
   273                                  ;	AL	sectors actually transferred
   274                                  ;
   275                                  ; One sector per driver call, stepping the address on afterwards.  Verify
   276                                  ; reads into the same buffer over and over and throws the data away: proving
   277                                  ; the sectors read back is the whole of what verify is for.
   278                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   279                                  fn04_verify:
   280 000000F5 31FF                    	xor	di,di			; verify reads; the buffer is not
   281 000000F7 EB07                    	jmp	short rw_common		;  advanced, which is what makes it
   282                                  fn03_write:				;  a verify rather than a read
   283 000000F9 BF0100                  	mov	di,1
   284 000000FC EB02                    	jmp	short rw_common
   285                                  fn02_read:
   286 000000FE 31FF                    	xor	di,di
   287                                  rw_common:
   288 00000100 E843FF                  	call	fd_type
   289 00000103 0F828B00                	jc	.nodrive
   290 00000107 88C7                    	mov	bh,al			; BH = the FD_ type
   291                                  
   292 00000109 0FB64E0E                	movzx	cx,byte [bp+offset_ax]	; sectors wanted
   293 0000010D E36D                    	jcxz	.done			; nothing asked for
   294                                  
   295 0000010F 89CE                    	mov	si,cx			; SI counts down
   296 00000111 31D2                    	xor	dx,dx			; DX counts up: how many worked
   297                                  
   298                                  .loop:
   299 00000113 53525756                	pushm	si,di,dx,bx
   300 00000117 1E                      	push	ds			; restored after the call below
   301                                  
   302                                  ;
   303                                  ; fd_rw(write, drive, fdtype, cyl, head, sec, buf) -- __cdecl, so every
   304                                  ; argument goes on the stack, rightmost first, and the caller takes them
   305                                  ; off again.  Six words and a far pointer is sixteen bytes.
   306                                  ;
   307                                  ; The arguments are read through BP, which is SS-relative, so they can be
   308                                  ; pushed before DS is changed.  DS has to be DGROUP by the time the call
   309                                  ; happens and cannot be changed before the pushes -- a saved DS sitting
   310                                  ; between the arguments and the return address would be read as the first
   311                                  ; argument.
   312                                  ;
   313 00000118 FF7612                  	push	word [bp+offset_es]	; buf: segment first, so the offset
   314 0000011B FF7608                  	push	word [bp+offset_bx]	;  lands at the lower address
   315                                  
   316 0000011E 0FB6460C                	movzx	ax,byte [bp+offset_cx]	; CL: sector in bits 5:0
   317 00000122 83E03F                  	and	ax,0x3F
   318 00000125 50                      	push	ax
   319                                  
   320 00000126 0FB6460B                	movzx	ax,byte [bp+offset_dx+1]	; DH: head
   321 0000012A 50                      	push	ax
   322                                  
   323 0000012B 8A4E0C                  	mov	cl,[bp+offset_cx]	; the cylinder is split: CH is its
   324 0000012E 80E1C0                  	and	cl,0xC0			;  low eight bits and CL bits 7:6
   325 00000131 0FB6C9                  	movzx	cx,cl			;  are bits 9:8
   326 00000134 C1E102                  	shl	cx,2
   327 00000137 0FB6460D                	movzx	ax,byte [bp+offset_cx+1]
   328 0000013B 09C8                    	or	ax,cx
   329 0000013D 50                      	push	ax
   330                                  
   331 0000013E 0FB6C7                  	movzx	ax,bh			; the configured drive type
   332 00000141 50                      	push	ax
   333                                  
   334 00000142 0FB6460A                	movzx	ax,byte [bp+offset_dx]	; DL: drive, 0 or 1
   335 00000146 83E001                  	and	ax,1
   336 00000149 50                      	push	ax
   337                                  
   338 0000014A 57                      	push	di			; write?
   339                                  
   340 0000014B B8[ssss]                	mov	ax,DGROUP
   341 0000014E 8ED8                    	mov	ds,ax
   342 00000150 E8(0000)                	call	_fd_rw
   343 00000153 83C410                  	add	sp,16
   344                                  
   345 00000156 1F                      	pop	ds
   346 00000157 5E5F5A5B                	popm	si,di,dx,bx
   347                                  
   348 0000015B 09C0                    	or	ax,ax
   349 0000015D 7523                    	jnz	.failed
   350                                  
   351 0000015F 42                      	inc	dx			; one more done
   352 00000160 4E                      	dec	si
   353 00000161 7419                    	jz	.done
   354                                  
   355                                  	; step to the next sector, wrapping head then cylinder
   356 00000163 E83500                  	call	fd_next
   357 00000166 7222                    	jc	.badseek
   358                                  
   359                                  	; A verify has no buffer of its own: it reads each sector over the
   360                                  	; last one and throws the data away, which is the whole of what
   361                                  	; verify is.  Everything else advances, carrying across 64K.
   362 00000168 807E0F04                	cmp	byte [bp+offset_ax+1],4
   363 0000016C 74A5                    	je	.loop
   364                                  
   365 0000016E 8146080002              	add	word [bp+offset_bx],512
   366 00000173 739E                    	jnc	.loop
   367 00000175 8146120010              	add	word [bp+offset_es],0x1000
   368 0000017A EB97                    	jmp	.loop
   369                                  
   370                                  .done:
   371 0000017C 88560E                  	mov	[bp+offset_ax],dl	; sectors transferred
   372 0000017F E937FF                  	jmp	fd_good
   373                                  
   374                                  .failed:
   375 00000182 88560E                  	mov	[bp+offset_ax],dl	; how many made it
   376 00000185 88C4                    	mov	ah,al
   377 00000187 E91CFF                  	jmp	fd_error
   378                                  
   379                                  .badseek:
   380 0000018A 88560E                  	mov	[bp+offset_ax],dl
   381 0000018D B404                    	mov	ah,SECTOR_NOT_FOUND
   382 0000018F E914FF                  	jmp	fd_error
   383                                  
   384                                  .nodrive:
   385 00000192 C6460E00                	mov	byte [bp+offset_ax],0
   386 00000196 B480                    	mov	ah,TIME_OUT		; nothing configured there
   387 00000198 E90BFF                  	jmp	fd_error
   388                                  
   389                                  
   390                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   391                                  ; fd_next -- step CH/CL/DH on to the next sector
   392                                  ;
   393                                  ; Sectors count from 1 to the track's last, then the head flips, then the
   394                                  ; cylinder steps.  Carry set if that runs off the end of the disk.
   395                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   396                                  fd_next:
   397 0000019B 56515350                	pushm	ax,bx,cx,si
   398 0000019F E8A4FE                  	call	fd_type
   399 000001A2 7240                    	jc	.bad
   400                                  
   401 000001A4 2E8A5C02                    cs	mov	bl,[si+2]		; sectors per track
   402 000001A8 2E8A7C01                    cs	mov	bh,[si+1]		; heads
   403 000001AC 2E8A2C                      cs	mov	ch,[si]			; cylinders
   404                                  
   405 000001AF 8A460C                  	mov	al,[bp+offset_cx]
   406 000001B2 88C4                    	mov	ah,al
   407 000001B4 243F                    	and	al,0x3F			; the sector
   408 000001B6 FEC0                    	inc	al
   409 000001B8 38D8                    	cmp	al,bl
   410 000001BA 761A                    	jbe	.putsec
   411                                  
   412 000001BC B001                    	mov	al,1			; wrap to sector 1
   413 000001BE FE460B                  	inc	byte [bp+offset_dx+1]	; next head
   414 000001C1 8A4E0B                  	mov	cl,[bp+offset_dx+1]
   415 000001C4 38F9                    	cmp	cl,bh
   416 000001C6 720E                    	jb	.putsec
   417                                  
   418 000001C8 C6460B00                	mov	byte [bp+offset_dx+1],0	; back to head 0
   419 000001CC FE460D                  	inc	byte [bp+offset_cx+1]	; next cylinder
   420 000001CF 8A4E0D                  	mov	cl,[bp+offset_cx+1]
   421 000001D2 38E9                    	cmp	cl,ch
   422 000001D4 730E                    	jnb	.bad			; off the end of the disk
   423                                  .putsec:
   424 000001D6 80E4C0                  	and	ah,0xC0			; keep the cylinder high bits
   425 000001D9 08C4                    	or	ah,al
   426 000001DB 88660C                  	mov	[bp+offset_cx],ah
   427 000001DE F8                      	clc
   428                                  .9:
   429 000001DF 585B595E                	popm	ax,bx,cx,si
   430 000001E3 C3                      	ret
   431                                  .bad:
   432 000001E4 F9                      	stc
   433 000001E5 EBF8                    	jmp	short .9
   434                                  
   435                                  
   436                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   437                                  ; 08h -- get drive parameters
   438                                  ;
   439                                  ;  Exit with:
   440                                  ;	CH	last cylinder, CL bits 5:0 sectors per track
   441                                  ;	DH	last head
   442                                  ;	DL	number of floppy drives configured
   443                                  ;	BL	the drive type
   444                                  ;	ES:DI	the disk base table for it
   445                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   446                                  fn08_params:
   447 000001E7 E85CFE                  	call	fd_type
   448 000001EA 7236                    	jc	.nodrive
   449                                  
   450 000001EC 884608                  	mov	[bp+offset_bx],al	; BL = the type
   451 000001EF 0FB6D8                  	movzx	bx,al
   452                                  
   453 000001F2 2E8A24                      cs	mov	ah,[si]			; cylinders
   454 000001F5 FECC                    	dec	ah
   455 000001F7 88660D                  	mov	[bp+offset_cx+1],ah	; CH = last cylinder
   456 000001FA 2E8A4402                    cs	mov	al,[si+2]		; sectors per track
   457 000001FE 88460C                  	mov	[bp+offset_cx],al	; CL, and no cylinder above 255 here
   458 00000201 2E8A4401                    cs	mov	al,[si+1]		; heads
   459 00000205 FEC8                    	dec	al
   460 00000207 88460B                  	mov	[bp+offset_dx+1],al	; DH = last head
   461                                  
   462 0000020A 01DB                    	add	bx,bx
   463 0000020C 2E8BBF[1000]                cs	mov	di,[bx+fd_param_table]
   464 00000211 897E00                  	mov	[bp+offset_di],di
   465 00000214 8CC8                    	mov	ax,cs
   466 00000216 894612                  	mov	[bp+offset_es],ax
   467                                  
   468 00000219 E83100                  	call	fd_count
   469 0000021C 88460A                  	mov	[bp+offset_dx],al
   470 0000021F E997FE                  	jmp	fd_good
   471                                  
   472                                  .nodrive:
   473 00000222 C7460C0000              	mov	word [bp+offset_cx],0
   474 00000227 C6460B00                	mov	byte [bp+offset_dx+1],0
   475 0000022B E81F00                  	call	fd_count
   476 0000022E 88460A                  	mov	[bp+offset_dx],al
   477 00000231 C6460800                	mov	byte [bp+offset_bx],0
   478 00000235 B480                    	mov	ah,TIME_OUT
   479 00000237 E96CFE                  	jmp	fd_error
   480                                  
   481                                  
   482                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   483                                  ; 15h -- get disk type
   484                                  ;
   485                                  ;	AH	0 none, 1 no change line, 2 change line supported
   486                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   487                                  fn15_type:
   488 0000023A E809FE                  	call	fd_type
   489 0000023D B401                    	mov	ah,1			; a drive with no change line
   490 0000023F 7302                    	jnc	.1
   491 00000241 30E4                    	xor	ah,ah			; nothing configured there
   492                                  .1:
   493 00000243 88660F                  	mov	[bp+offset_ax+1],ah
   494 00000246 611F07                  	popm	all,ds,es
   495 00000249 F8                      	clc
   496 0000024A CA0200                  	retf	2
   497                                  
   498                                  
   499                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   500                                  ; fd_count -- how many floppy drives are configured, in AL
   501                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   502                                  fd_count:
   503 0000024D 1E                      	push	ds
   504 0000024E 6A401F                  	get_bda	DS
   505 00000251 30C0                    	xor	al,al
   506 00000253 803EE30000              	cmp	byte [floppy_tab],0
   507 00000258 7402                    	je	.1
   508 0000025A FEC0                    	inc	al
   509                                  .1:
   510 0000025C 803EE40000              	cmp	byte [floppy_tab+1],0
   511 00000261 7402                    	je	.2
   512 00000263 FEC0                    	inc	al
   513                                  .2:
   514 00000265 1F                      	pop	ds
   515 00000266 C3                      	ret
