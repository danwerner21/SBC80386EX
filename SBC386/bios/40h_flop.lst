   126                              <1> defb DMAMSK_AT  equ     0x000A
   127                              <1> defb DMAMOD1    equ     0xF00B
   128                              <1> defb DMAMOD1_AT equ     0x000B
   129                              <1> defb DMACLRBP   equ     0xF00C
