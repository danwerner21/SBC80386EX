    83 0000003E ??                  <1> seek_status	resb	1	; drive recalibration status */
    84                              <1> ; bits 3..0 drive must recalibrate before next seek */
    85 0000003F ??                  <1> motor_status	resb	1	; bits 3..0 motor running */
    86                              <1> ; bit 7 current op is write */
