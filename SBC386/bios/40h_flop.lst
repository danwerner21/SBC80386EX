   870                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   871                                  ; fd_count -- how many floppy drives are configured, in AL
   872                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   873                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   874                                  ; fd_set_1E -- point INT 1Eh at the table for drive A's configured type
   875                                  ;
   876                                  ;	void fd_set_1E(void);
   877                                  ;
   878                                  ; POST calls this once the SETUP configuration is known.  The vector is
   879                                  ; built from page0vectors pointing at the 1.44Mb table, which is the wrong
   880                                  ; answer for a 720Kb or 360Kb drive: it claims 18 sectors a track where
   881                                  ; there are 9, and DOS copies the table and works from the copy.
   882                                  ;
   883                                  ; Drive A decides it, because there is only one vector and INT 13h function
   884                                  ; 08h hands out the right table per drive anyway.
