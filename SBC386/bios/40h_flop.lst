   801 00000332 0100                    fd_media_360:	db	FD_360, 0
   802 00000334 020100                  fd_media_1200:	db	FD_1200, FD_360, 0
   803 00000337 0300                    fd_media_720:	db	FD_720, 0
   804 00000339 040300                  fd_media_1440:	db	FD_1440, FD_720, 0
