   591                                  ; fd_next -- step CH/CL/DH on to the next sector
   592                                  ;
   593                                  ; Sectors count from 1 to the track's last, then the head flips, then the
   594                                  ; cylinder steps.  Carry set if that runs off the end of the disk.
   595                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   596                                  fd_next:
