    88 00000041 ??                  <1> fd_status	resb	1	; return code status byte */
    89 00000042 ??????????????      <1> fd_ctrl_stat	resb	7	; controller return bytes */
    90                              <1> ; */
    91                              <1> ; Video Display data area -- also used for video emulation */
    92 00000049 ??                  <1> vid_mode	resb	1	; current display mode */
    93 0000004A ????                <1> vid_columns	resw	1	; no. of columns on the screen */
    94 0000004C ????                <1> vid_buf_len	resw	1	; length of video buffer in bytes*//
    95 0000004E ????                <1> vid_start	resw	1	; start address of screen regeneration (in vid buf)*//
    96 00000050 <res 10h>           <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
    97 00000060 ????                <1> vid_cursor_mode	resw	1
    98 00000062 ??                  <1> vid_active_page	resb	1
    99 00000063 ????                <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA)*//
   100 00000065 ??                  <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   101 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
   102                              <1> ; */
   103                              <1> ; POST and ROM data */
   104 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   105                              <1> %define io_rom_addr_low io_rom_addr
   106                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   107 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   108                              <1> ; */
   109                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   110 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
   111 0000006E ????                <1> timer_count_high	resw	1
   112                              <1> %define timer_count timer_count_low
   113                              <1> ; use timer_count as the double word timer counter */
   114 00000070 ??                  <1> timer_overflow	resb	1	; timer has rolled over since last read */
   115                              <1> ; */
   116                              <1> ; System & Keboard data area */
   117 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   118 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   119                              <1> ; */
   120                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
   121                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
