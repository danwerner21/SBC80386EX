   672 00000260 8B7C07                  	mov	di,[si+7]		; low half the gap, high half the filler
   673 00000263 1F                      	pop	ds
   674                                  	cnop
   675                                  
   676 00000264 89F8                    	mov	ax,di
   677 00000266 C1E808                  	shr	ax,8
   678 00000269 50                      	push	ax			; fill
   679 0000026A 89F8                    	mov	ax,di
   680 0000026C 30E4                    	xor	ah,ah
   681 0000026E 50                      	push	ax			; gpl
   682                                  
   683 0000026F 0FB6460E                	movzx	ax,byte [bp+offset_ax]	; AL: sectors per track
   684 00000273 50                      	push	ax
   685                                  
   686 00000274 0FB6460B                	movzx	ax,byte [bp+offset_dx+1]	; DH: head
   687 00000278 50                      	push	ax
   688                                  
   689 00000279 8A4E0C                  	mov	cl,[bp+offset_cx]	; the cylinder is split the same way
   690 0000027C 80E1C0                  	and	cl,0xC0			;  a read splits it
   691 0000027F 0FB6C9                  	movzx	cx,cl
   692 00000282 C1E102                  	shl	cx,2
   693 00000285 0FB6460D                	movzx	ax,byte [bp+offset_cx+1]
   694 00000289 09C8                    	or	ax,cx
   695 0000028B 50                      	push	ax
   696                                  
   697 0000028C 0FB6C7                  	movzx	ax,bh			; the configured drive type
   698 0000028F 50                      	push	ax
   699                                  
   700 00000290 0FB6460A                	movzx	ax,byte [bp+offset_dx]	; DL: drive, 0 or 1
   701 00000294 83E001                  	and	ax,1
   702 00000297 50                      	push	ax
   703                                  
   704 00000298 B8[ssss]                	mov	ax,DGROUP
