    53                                  %include "macro.inc"
    54                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    55                              <1> ;
    56                              <1> ; some useful macros:
    57                              <1> ;
    58                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    59                              <1> %define NREPEAT 0
    60                              <1> 
    61                              <1> %if NREPEAT
    62                              <1> 
    63                              <1> %macro	rep	1
    64                              <1> %%loop:	%1
    65                              <1> 	dec	cx
    66                              <1> 	jnz	%%loop
    67                              <1> %endm
    68                              <1> 
    69                              <1> %macro	repne	1
    70                              <1> %%loop:	%1
    71                              <1> 	je	%%e
    72                              <1> 	dec	cx
    73                              <1> 	jnz	%%loop
    74                              <1> 	cmp	cx,1
    75                              <1> 	jmp	%%done
    76                              <1> %%e:	dec	cx
    77                              <1> 	cmp	cx,cx
    78                              <1> %%done:
    79                              <1> %endm
    80                              <1> 
    81                              <1> %macro	repe	1
    82                              <1> %%loop:	%1
    83                              <1> 	jne	%%ne
    84                              <1> 	dec	cx
    85                              <1> 	jnz	%%loop
    86                              <1> 	jmp	%%done
    87                              <1> %%ne:	dec	cx
    88                              <1> 	jcxz	%%cxz
    89                              <1> 	jmp	%%done
    90                              <1> %%cxz:	cmp	cx,1
    91                              <1> %%done:
    92                              <1> %endm
    93                              <1> 
    94                              <1> %macro	REP	1
    95                              <1> %%loop:	%1
    96                              <1> 	dec	ecx
    97                              <1> 	jnz	%%loop
    98                              <1> %endm
    99                              <1> 
   100                              <1> %macro	REPNE	1
   101                              <1> %%loop:	%1
   102                              <1> 	je	%%e
   103                              <1> 	dec	ecx
   104                              <1> 	jnz	%%loop
   105                              <1> 	cmp	cl,1
   106                              <1> 	jmp	%%done
   107                              <1> %%e:	dec	ecx
   108                              <1> 	cmp	cl,cl
   109                              <1> %%done:
   110                              <1> %endm
   111                              <1> 
   112                              <1> %macro	REPE	1
   113                              <1> %%loop:	%1
   114                              <1> 	jne	%%ne
   115                              <1> 	dec	ecx
   116                              <1> 	jnz	%%loop
   117                              <1> 	jmp	%%done
   118                              <1> %%ne:	dec	ecx
   119                              <1> 	jecxz	%%cxz
   120                              <1> 	jmp	%%done
   121                              <1> %%cxz:	cmp	cl,1
   122                              <1> %%done:
   123                              <1> %endm
   124                              <1> 
   125                              <1> %endif
   126                              <1> 
   127                              <1> 
   128                              <1> ;
   129                              <1> ; format of the BYTE initialization table:  address, byte
   130                              <1> ;
   131                              <1> %imacro  binit 2
   132                              <1>         dw      %1
   133                              <1>         db      %2
   134                              <1> %endmacro
   135                              <1> ; end with DW -1
   136                              <1> 
   137                              <1> ;
   138                              <1> ; format of the WORD initialization table:  address, word
   139                              <1> ;
   140                              <1> %imacro  winit 2
   141                              <1>         dw      %1
   142                              <1>         dw      %2
   143                              <1> %endmacro
   144                              <1> ; end with DW -1
   145                              <1> 
   146                              <1> 
   147                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   148                              <1> %imacro get_bda	1.nolist
   149                              <1> 	push	0x0040
   150                              <1> 	pop	%1
   151                              <1> 	cnop
   152                              <1> %endm
   153                              <1> 
   154                              <1> 
   155                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   156                              <1> %imacro	get_loc0 1.nolist
   157                              <1> 	push	0x0000
   158                              <1> 	pop	%1
   159                              <1> 	cnop
   160                              <1> %endm
   161                              <1> 
   162                              <1> 
   163                              <1> 
   164                              <1> %imacro setloc  1.nolist
   165                              <1>  times   (%1-($-$$)) db 0FFh
   166                              <1> %endm
   167                              <1> 
   168                              <1> %imacro db_lo   1
   169                              <1>  db (%1)&255
   170                              <1> %endm
   171                              <1> 
   172                              <1> %imacro cnop    0.nolist
   173                              <1> %ifdef SOFT_DEBUG
   174                              <1> %if SOFT_DEBUG
   175                              <1>         nop
   176                              <1> %endif
   177                              <1> %endif
   178                              <1> %endm
   179                              <1> 
   180                              <1> %imacro popm 1-*.nolist
   181                              <1> %rep %0
   182                              <1> %ifidni %1,ALL
   183                              <1>  popa
   184                              <1> %elifidni %1,F
   185                              <1>  popf
   186                              <1> %else
   187                              <1>  pop %1
   188                              <1> %ifidni %1,DS
   189                              <1>  cnop
   190                              <1> %elifidni %1,ES
   191                              <1>  cnop
   192                              <1> %elifidni %1,FS
   193                              <1>  cnop
   194                              <1> %elifidni %1,GS
   195                              <1>  cnop
   196                              <1> %endif
   197                              <1> %endif
   198                              <1> %rotate 1
   199                              <1> %endrep
   200                              <1> %endm
   201                              <1> 
   202                              <1> %imacro pushm 1-*.nolist
   203                              <1> %rep %0
   204                              <1> %rotate -1
   205                              <1> %ifidni %1,ALL
   206                              <1>  pusha
   207                              <1> %elifidni %1,F
   208                              <1>  pushf
   209                              <1> %else
   210                              <1>  push %1
   211                              <1> %endif
   212                              <1> %endrep
   213                              <1> %endm
   214                              <1> 
   215                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   216                              <1> %assign __size__ (%2-1)	| 0xFF
   217                              <1> %if (__size__ <= 0xFFFF)
   218                              <1> %assign __gran__ 0
   219                              <1> %else
   220                              <1> %assign __gran__ 0xC0			; G B 0 0
   221                              <1> %endif
   222                              <1> %assign __expand__ 0
   223                              <1> %if %0==3
   224                              <1> %if %3
   225                              <1> %assign __expand__ 4
   226                              <1> %endif
   227                              <1> %endif
   228                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   229                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   230                              <1> %endm
   231                              <1> 
   232                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   233                              <1> %assign __size__ (%2-1)	| 0xFF
   234                              <1> %if (__size__ <= 0xFFFF)
   235                              <1> %assign __gran__ 0
   236                              <1> %else
   237                              <1> %assign __gran__ 0xC0			; G D 0 0
   238                              <1> %endif
   239                              <1> %assign __conform__ 0
   240                              <1> %if %0==3
   241                              <1> %if %3
   242                              <1> %assign __conform__ 4
   243                              <1> %endif
   244                              <1> %endif
   245                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   246                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   247                              <1> %endm
   248                              <1> 
   249                              <1> ;/* End of macro.inc */
