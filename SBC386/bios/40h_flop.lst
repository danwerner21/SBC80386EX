   435 000001C6 8F4608              <1>  pop word [bp+offset_bx]
   436 000001C9 8F4612              <1>  pop word [bp+offset_es]
   575 000001CC 88560E                  	mov	[bp+offset_ax],dl	; how many made it
   576 000001CF E9E4FE                  	jmp	fd_error
