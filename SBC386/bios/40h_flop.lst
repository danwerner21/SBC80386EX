   556                                  	; A verify has no buffer of its own: it reads each sector over the
   557                                  	; last one and throws the data away, which is the whole of what
   558                                  	; verify is.  Everything else advances, carrying across 64K.
   559 00000198 807E0F04                	cmp	byte [bp+offset_ax+1],4
