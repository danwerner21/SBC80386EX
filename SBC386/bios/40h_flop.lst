   521 0000015E 80E1C0                  	and	cl,0xC0			;  low eight bits and CL bits 7:6
   522 00000161 0FB6C9                  	movzx	cx,cl			;  are bits 9:8
   523 00000164 C1E102                  	shl	cx,2
   524 00000167 0FB6460D                	movzx	ax,byte [bp+offset_cx+1]
   525 0000016B 09C8                    	or	ax,cx
   526 0000016D 50                      	push	ax
   527                                  
   528 0000016E 0FB6C7                  	movzx	ax,bh			; the configured drive type
   529 00000171 50                      	push	ax
   530                                  
   531 00000172 0FB6460A                	movzx	ax,byte [bp+offset_dx]	; DL: drive, 0 or 1
   532 00000176 83E001                  	and	ax,1
   533 00000179 50                      	push	ax
   534                                  
   535 0000017A 57                      	push	di			; write?
   536                                  
   537 0000017B B8[ssss]                	mov	ax,DGROUP
   538 0000017E 8ED8                    	mov	ds,ax
   539 00000180 E8(0000)                	call	_fd_rw
   540 00000183 83C410                  	add	sp,16
   541                                  
   542 00000186 1F                      	pop	ds
   543 00000187 5E5F5A5B                	popm	si,di,dx,bx
   544                                  
   545 0000018B 09C0                    	or	ax,ax
   546 0000018D 752F                    	jnz	.failed
   547                                  
   548 0000018F 42                      	inc	dx			; one more done
   549 00000190 4E                      	dec	si
   550 00000191 7419                    	jz	.done
