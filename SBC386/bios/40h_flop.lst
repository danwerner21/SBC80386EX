   499                                  ;
   500                                  ; fd_rw(write, drive, fdtype, cyl, head, sec, buf) -- __cdecl, so every
   501                                  ; argument goes on the stack, rightmost first, and the caller takes them
   502                                  ; off again.  Six words and a far pointer is sixteen bytes.
   503                                  ;
   504                                  ; The arguments are read through BP, which is SS-relative, so they can be
   505                                  ; pushed before DS is changed.  DS has to be DGROUP by the time the call
   506                                  ; happens and cannot be changed before the pushes -- a saved DS sitting
   507                                  ; between the arguments and the return address would be read as the first
   508                                  ; argument.
   509                                  ;
