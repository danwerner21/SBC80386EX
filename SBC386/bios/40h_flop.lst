    88                              <1> 
    89                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    90                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    91                              <1> ;*  first thing it does, so anything that restarts the board in software has
    92                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    93                              <1> ;*  hard way.
    94                              <1> ;*/
    95                              <1> defw    DEVICE_ID equ   0x2309
    96                              <1> 
    97                              <1> ;/* The Address Configuration register
    98                              <1> ;*/
    99                              <1> defb REMAPCFGH  equ     0x0023
   100                              <1> defb REMAPCFGL  equ     0x0022
   101                              <1> defw REMAPCFG   equ     0x0022
   102                              <1> 
   103                              <1> ;/* The A20gate and fast CPU Reset
   104                              <1> ;*/
