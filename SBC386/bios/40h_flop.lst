    58                              <1> struc _BDA
    59                              <1> ; first items at 0x40:0	*/
    60 00000000 ????????????????    <1> serial_dev	resw	4	; serial port device codes */
    61 00000008 ????????????????    <1> parallel_dev	resw	4	; printer port device codes */
    62 00000010 ????                <1> equip_flag	resw	1		; int 12h equipment flags */
    63 00000012 ??                  <1> mfg_test	resb	1		; initialization flags */
    64                              <1> ; */
    65                              <1> ; POST writes what it decided here, after the test of segment 0 has */
    66                              <1> ; zeroed the area, so the answer survives to be reported.  Nothing else */
    67                              <1> ; in this BIOS writes mfg_test.                                        */
    68                              <1> %define WARM_POST 0x01	; warm start: the memory march was skipped */
    69 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    70 00000015 ??                  <1> mfg_err_flag	resb	1
    71 00000016 ??                  <1> mfg_err_flag2	resb	1
    72                              <1> ; */
    73                              <1> ; first Keyboard data area */
    74 00000017 ??                  <1> kbd_flag	resb	1	; shift status &c. */
    75 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
    76 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
    77 0000001A ????                <1> buffer_head	resw	1
    78 0000001C ????                <1> buffer_tail	resw	1
