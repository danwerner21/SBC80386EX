     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; 40h_flop.asm -- INT 40h, the floppy disk interface
     3                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     4                                  ;
     5                                  ; Copyright (C) 2026 Dan Werner.  All rights reserved.
     6                                  ; Provided for hobbyist use on the RetroBrew SBC-386EX board.
     7                                  ;
     8                                  ; This program is free software: you can redistribute it and/or modify
     9                                  ; it under the terms of the GNU General Public License as published by
    10                                  ; the Free Software Foundation, either version 3 of the License, or
    11                                  ; (at your option) any later version.
    12                                  ;
    13                                  ; This program is distributed in the hope that it will be useful,
    14                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                                  ; GNU General Public License for more details.
    17                                  ;
    18                                  ; You should have received a copy of the GNU General Public License
    19                                  ; along with this program in the file COPYING in the topmost source
    20                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    21                                  ;
    22                                  ;
    23                                  ; INT 13h sends every call with DL below 80h here, through floppy_call in
    24                                  ; 13h_disk.asm -- "int 0x40" and then "retf 2", so the flags this leaves are
    25                                  ; the ones the original caller sees.  The work is done by the driver in
    26                                  ; diskfdc.c; this is the BIOS surface over it.
    27                                  ;
    28                                  ;    Function		Usage
    29                                  ;    ========		=====
    30                                  ;	00	reset the disk system
    31                                  ;	01	get the status of the last operation
    32                                  ;	02	read sectors
    33                                  ;	03	write sectors
    34                                  ;	04	verify sectors
    35                                  ;	08	get drive parameters
    36                                  ;	15	get disk type
    37                                  ;
    38                                  ; Transfers go one sector per call into the driver, and this loops -- the
    39                                  ; same shape as rwv_common in 13h_disk.asm and for the same reason.  A
    40                                  ; multi-sector request that crosses the end of a track has to step the head,
    41                                  ; and the buffer advance has to carry across a 64K segment boundary, neither
    42                                  ; of which a single command handed to the controller can do.
    43                                  ;
    44                                  ; There is nothing to probe for.  A PC floppy interface cannot be asked what
    45                                  ; is attached, or even whether anything is, and JP4 on the Disk I/O board
    46                                  ; ties RDY to ground so the controller always believes a drive is ready.
    47                                  ; bda.floppy_tab[] is the only answer there is, and it comes from SETUP.
    48                                  ;
    49                                  ; Assembly by NASM 2.08 is preferred
    50                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    51                                  %include "seg_def.inc"
    52                              <1> ; SEG_DEF.inc
    53                              <1> ;
    54                              <1> %ifndef SEG_DEF
    55                              <1> %define SEG_DEF 1
    56                              <1> 
    57                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    58                              <1> 
    59                              <1> segment CONST		align=16	class=DATA	public
    60                              <1> segment CONST2		align=2		class=DATA	public
    61                              <1> segment _DATA		align=16	class=DATA	public
    62                              <1> segment _BSS		align=16	class=DATA	public
    63                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    64                              <1> 
    65                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    66                              <1> 
    67                              <1> 
    68                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    69                              <1> 
    70                              <1> %define XXX
    71                              <1> %endif
    72                              <1> ;
    73                              <1> ; end SEG_DEF.inc
