     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ;boot.asm
     3                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     4                                  ; The Real Mode statup jump
     5                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     6                                  	bits	16
     7                                  
     8                                  SEGBASE equ 0x10000-(ROM<<6)
     9                                  
    10                                          align   16
    11                                  bootstrap:
    12 00000000 EA000000F0                      jmp     SEGBASE:0000	; 5 byte real-mode far call
    13                                  %include "date.inc"
    14 00000005 30392F30382F3236    <1> 	db	"09/08/26"
    14 0000000D FFFC00                  	db	0xFF, 0xFC, 0x00	; PC/AT
