    31                                  %include "seg_def.inc"
    32                              <1> ; SEG_DEF.inc
    33                              <1> ;
    34                              <1> %ifndef SEG_DEF
    35                              <1> %define SEG_DEF 1
    36                              <1> 
    37                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    38                              <1> 
    39                              <1> segment CONST		align=16	class=DATA	public
    40                              <1> segment CONST2		align=2		class=DATA	public
    41                              <1> segment _DATA		align=16	class=DATA	public
    42                              <1> segment _BSS		align=16	class=DATA	public
    43                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    44                              <1> 
    45                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    46                              <1> 
    47                              <1> 
    48                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    49                              <1> 
    50                              <1> %define XXX
    51                              <1> %endif
    52                              <1> ;
    53                              <1> ; end SEG_DEF.inc
    32                                  %include "macro.inc"
    33                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    34                              <1> ;
    35                              <1> ; some useful macros:
    36                              <1> ;
    37                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    38                              <1> %define NREPEAT 0
    39                              <1> 
    40                              <1> %if NREPEAT
    41                              <1> 
    42                              <1> %macro	rep	1
    43                              <1> %%loop:	%1
    44                              <1> 	dec	cx
    45                              <1> 	jnz	%%loop
    46                              <1> %endm
    47                              <1> 
    48                              <1> %macro	repne	1
    49                              <1> %%loop:	%1
    50                              <1> 	je	%%e
    51                              <1> 	dec	cx
    52                              <1> 	jnz	%%loop
    53                              <1> 	cmp	cx,1
    54                              <1> 	jmp	%%done
    55                              <1> %%e:	dec	cx
    56                              <1> 	cmp	cx,cx
    57                              <1> %%done:
    58                              <1> %endm
    59                              <1> 
    60                              <1> %macro	repe	1
    61                              <1> %%loop:	%1
    62                              <1> 	jne	%%ne
    63                              <1> 	dec	cx
    64                              <1> 	jnz	%%loop
    65                              <1> 	jmp	%%done
    66                              <1> %%ne:	dec	cx
    67                              <1> 	jcxz	%%cxz
    68                              <1> 	jmp	%%done
    69                              <1> %%cxz:	cmp	cx,1
    70                              <1> %%done:
    71                              <1> %endm
    72                              <1> 
    73                              <1> %macro	REP	1
    74                              <1> %%loop:	%1
    75                              <1> 	dec	ecx
    76                              <1> 	jnz	%%loop
    77                              <1> %endm
    78                              <1> 
    79                              <1> %macro	REPNE	1
    80                              <1> %%loop:	%1
    81                              <1> 	je	%%e
    82                              <1> 	dec	ecx
    83                              <1> 	jnz	%%loop
    84                              <1> 	cmp	cl,1
    85                              <1> 	jmp	%%done
    86                              <1> %%e:	dec	ecx
    87                              <1> 	cmp	cl,cl
    88                              <1> %%done:
    89                              <1> %endm
    90                              <1> 
    91                              <1> %macro	REPE	1
    92                              <1> %%loop:	%1
    93                              <1> 	jne	%%ne
    94                              <1> 	dec	ecx
    95                              <1> 	jnz	%%loop
    96                              <1> 	jmp	%%done
    97                              <1> %%ne:	dec	ecx
    98                              <1> 	jecxz	%%cxz
    99                              <1> 	jmp	%%done
   100                              <1> %%cxz:	cmp	cl,1
   101                              <1> %%done:
   102                              <1> %endm
   103                              <1> 
   104                              <1> %endif
   105                              <1> 
   106                              <1> 
   107                              <1> ;
   108                              <1> ; format of the BYTE initialization table:  address, byte
   109                              <1> ;
   110                              <1> %imacro  binit 2
   111                              <1>         dw      %1
   112                              <1>         db      %2
   113                              <1> %endmacro
   114                              <1> ; end with DW -1
   115                              <1> 
   116                              <1> ;
   117                              <1> ; format of the WORD initialization table:  address, word
   118                              <1> ;
   119                              <1> %imacro  winit 2
   120                              <1>         dw      %1
   121                              <1>         dw      %2
   122                              <1> %endmacro
   123                              <1> ; end with DW -1
   124                              <1> 
   125                              <1> 
   126                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   127                              <1> %imacro get_bda	1.nolist
   128                              <1> 	push	0x0040
   129                              <1> 	pop	%1
   130                              <1> 	cnop
   131                              <1> %endm
   132                              <1> 
   133                              <1> 
   134                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   135                              <1> %imacro	get_loc0 1.nolist
   136                              <1> 	push	0x0000
   137                              <1> 	pop	%1
   138                              <1> 	cnop
   139                              <1> %endm
   140                              <1> 
   141                              <1> 
   142                              <1> 
   143                              <1> %imacro setloc  1.nolist
   144                              <1>  times   (%1-($-$$)) db 0FFh
   145                              <1> %endm
   146                              <1> 
   147                              <1> %imacro db_lo   1
   148                              <1>  db (%1)&255
   149                              <1> %endm
   150                              <1> 
   151                              <1> %imacro cnop    0.nolist
   152                              <1> %ifdef SOFT_DEBUG
   153                              <1> %if SOFT_DEBUG
   154                              <1>         nop
   155                              <1> %endif
   156                              <1> %endif
   157                              <1> %endm
   158                              <1> 
   159                              <1> %imacro popm 1-*.nolist
   160                              <1> %rep %0
   161                              <1> %ifidni %1,ALL
   162                              <1>  popa
   163                              <1> %elifidni %1,F
   164                              <1>  popf
   165                              <1> %else
   166                              <1>  pop %1
   167                              <1> %ifidni %1,DS
   168                              <1>  cnop
   169                              <1> %elifidni %1,ES
   170                              <1>  cnop
   171                              <1> %elifidni %1,FS
   172                              <1>  cnop
   173                              <1> %elifidni %1,GS
   174                              <1>  cnop
   175                              <1> %endif
   176                              <1> %endif
   177                              <1> %rotate 1
   178                              <1> %endrep
   179                              <1> %endm
   180                              <1> 
   181                              <1> %imacro pushm 1-*.nolist
   182                              <1> %rep %0
   183                              <1> %rotate -1
   184                              <1> %ifidni %1,ALL
   185                              <1>  pusha
   186                              <1> %elifidni %1,F
   187                              <1>  pushf
   188                              <1> %else
   189                              <1>  push %1
   190                              <1> %endif
   191                              <1> %endrep
   192                              <1> %endm
   193                              <1> 
   194                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   195                              <1> %assign __size__ (%2-1)	| 0xFF
   196                              <1> %if (__size__ <= 0xFFFF)
   197                              <1> %assign __gran__ 0
   198                              <1> %else
   199                              <1> %assign __gran__ 0xC0			; G B 0 0
   200                              <1> %endif
   201                              <1> %assign __expand__ 0
   202                              <1> %if %0==3
   203                              <1> %if %3
   204                              <1> %assign __expand__ 4
   205                              <1> %endif
   206                              <1> %endif
   207                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   208                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   209                              <1> %endm
   210                              <1> 
   211                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   212                              <1> %assign __size__ (%2-1)	| 0xFF
   213                              <1> %if (__size__ <= 0xFFFF)
   214                              <1> %assign __gran__ 0
   215                              <1> %else
   216                              <1> %assign __gran__ 0xC0			; G D 0 0
   217                              <1> %endif
   218                              <1> %assign __conform__ 0
   219                              <1> %if %0==3
   220                              <1> %if %3
   221                              <1> %assign __conform__ 4
   222                              <1> %endif
   223                              <1> %endif
   224                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   225                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   226                              <1> %endm
   227                              <1> 
   228                              <1> ;/* End of macro.inc */
    33                                  
    34                                  segment	_TEXT
    35                                  
    36                                  %ifndef CRC16
    37                                  %define CRC16 0		; don't include CRC16 calculations
    38                                  %endif
    39                                  %ifndef CRC7
    40                                  %define CRC7 0
    41                                  %endif
    42                                  
    43                                  
    44                                  %if CRC7
    45                                  %if CRC7==1
    46                                  CRC7poly	equ	00100001b	; 8-bit polynomial
    47                                  %else
    48                                  CRC7poly	equ	00010010b
    49                                  %endif
    50                                  
    51                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    52                                  ; crc7	calculate a CRC7 polynomial
    53                                  ;    /* THIS CODE DIFFERS FROM THE crc7 USED WITH THE SDCARDs */
    54                                  ; calcCRC7  calculate CRC7 for the SDcard (no OR of last bit)
    55                                  ;
    56                                  ;  Enter with:
    57                                  ;	ES:BX	points at a string of bytes
    58                                  ;	CX	count of bytes in the string
    59                                  ;	direction flag clear
    60                                  ;
    61                                  ;  Return with:
    62                                  ;	ES:BX	point at next byte beyond end of string
    63                                  ;	CX = 0
    64                                  ;	AL = CRC7 polynomial byte
    65                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    66                                  %if CRC7==2
    67                                  	global	calcCRC7
    68                                  calcCRC7:
    69                                  %else
    70                                  	global	crc7
    71                                  crc7:
    72                                  %endif
    73                                  	push	dx
    74                                  	xor	dl,dl		; start CRC7 at zero
    75                                  .1:
    76                                     es	mov	al,[bx]		; get next byte
    77                                     	inc	bx
    78                                  	mov	dh,8 			; 8 bits in AL
    79                                  .11:
    80                                  	mov	ah,dl			; copy CRC to AH
    81                                  	xor	ah,al			; Sign bit is 0 or 1
    82                                  	shl	ax,1
    83                                  	sbb	ah,ah			; AH is 0 or -1
    84                                  	shl	dl,1			; shift polynomial
    85                                  
    86                                  	and	ah,CRC7poly		; get bits to add into the CRC
    87                                  ; USE CRC7=1 FOR 8-BIT, CRC7=2 FOR 7-BIT (SDcards)
    88                                  
    89                                  	xor	dl,ah			; update the polynomial
    90                                  	dec	dh
    91                                  	jnz	.11
    92                                  
    93                                  	loop	.1
    94                                  
    95                                  	mov	al,dl		; final CRC7 to AL
    96                                  	pop	dx
    97                                  	ret
    98                                  
    99                                  %endif
   100                                  
   101                                  
   102                                  
   103                                  %if CRC16
   104                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   105                                  ; crc16		add data to the input CRC16 calculation
   106                                  ;
   107                                  ;  Enter with:
   108                                  ;	ES:BX	data pointer
   109                                  ;	CX	count of bytes
   110                                  ;	AX	partial CRC16 sum
   111                                  ;
   112                                  ;  Return with:
   113                                  ;	ES:BX	updated data pointer
   114                                  ;	CX = 0
   115                                  ;	AX	updated CRC16 sum
   116                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   117                                  	global	crc16
   118                                  crc16:
   119 00000000 56                      	pushm	si		; save SI
   120                                  
   121 00000001 89DE                    	mov	si,bx		; use ES:SI to address data
   122                                  .2:
   123 00000003 88E3                    	mov	bl,ah		; form index into table
   124 00000005 30FF                    	xor	bh,bh		; zap BH
   125 00000007 26321C                    es	xor	bl,[si]		; form table index
   126 0000000A 46                        	inc	si
   127 0000000B 88C4                      	mov	ah,al		; update CRC16
   128 0000000D 30C0                    	xor	al,al
   129 0000000F D1E3                    	shl	bx,1
   130 00000011 2E3387[1C00]              cs	xor	ax,[crc16tab + bx]
   131 00000016 E2EB                      	loop	.2
   132                                  
   133 00000018 89F3                    	mov	bx,si		; updated BX value
   134 0000001A 5E                      	popm	si
   135 0000001B C3                      	ret
   136                                  
   137                                  
   138                                  	align	2
   139                                  %include "crc16tab.inc"
