   514 000001C5 750C                    	jnz	.done
   515 000001C7 B302                    	mov	bl,ADDRESS_MARK_NOT_FOUND
   516 000001C9 A801                    	test	al,01h				; AMNF
   517 000001CB 7506                    	jnz	.done
   518 000001CD B3BB                    	mov	bl,UNDEFINED_ERROR
   519 000001CF EB02                    	jmp	short .done
   520                                  
   521                                  .timeout:
   522 000001D1 B380                    	mov	bl,TIME_OUT
   523                                  
   524                                  .done:
   525 000001D3 6A4007                  	get_bda	ES
   526 000001D6 26881E7400                  es	mov	[hd_status],bl			; INT 13h fn 01h reads this
   527 000001DB 0FB6C3                  	movzx	ax,bl
   528                                  
   529 000001DE 5B595A07                	popm	bx,cx,dx,es
   530 000001E2 C3                      	ret
   531                                  
   532                                  ; Read a sector of 512 bytes into memory at ES:[BX]
   533                                  ;
   534                                  ;  Call with:
   535                                  ;       ES:BX -- pointer to the data block
   536                                  ;
   537                                  ;  Exit with:
   538                                  ;       AX and DX are destroyed; other registers preserved
   539                                  ;
   540                                  ; "BE" version is for ide id information
   541                                  ;-----------------------------------------------------------------------------
   542                                  read_dataBE:
   543 000001E3 5153                        pushm   bx,cx
   544 000001E5 BAF001                  	mov		dx,IDEDTA
   545                                  
   546 000001E8 87FB                        xchg    di,bx
   547                                  
   548 000001EA B90001                  	mov     cx,256          ; sector size in words
   549                                  rdblk2BE:
   550 000001ED EC                      	in	al,dx
   551 000001EE 88C4                    	mov ah,al
   552 000001F0 EC                      	in	al,dx
   553 000001F1 AA                      	stosb
   554 000001F2 88E0                    	mov al,ah
   555 000001F4 AA                      	stosb
   556 000001F5 E2F6                        loop    rdblk2BE
   557 000001F7 5B59                        popm    bx,cx
   558 000001F9 C3                      	ret
   559                                  
   560                                  read_data:
   561 000001FA 51                          pushm   cx
   562 000001FB BAF001                  	mov		dx,IDEDTA
   563 000001FE 87FB                        xchg    di,bx			; STOSB works through ES:DI, so the buffer
   564                                  					;  offset goes there and comes back in BX
   565                                  					;  advanced by 512 -- which is what carries
   566                                  					;  a multi-sector transfer from one sector
   567                                  					;  to the next
   568 00000200 B90002                  	mov     cx,512          ; sector size in BYTES: this is 8-bit PIO
   569                                  rdblk2:
   570 00000203 EC                      	in	al,dx
   571 00000204 AA                      	stosb
   572 00000205 E2FC                        loop    rdblk2
   573 00000207 87FB                        xchg    di,bx
   574 00000209 59                          popm    cx
   575 0000020A C3                      	ret
   576                                  
   577                                  ;------------------------------------------------------------------------------
   578                                  ; Write a sector of 512 bytes from memory at DS:[BX]
   579                                  ;
   580                                  ; DS, not ES.  LODSB below reads through DS:SI, and IDE_WRITE_SECTOR loads
   581                                  ; the buffer segment into DS for exactly that reason -- the read side is the
   582                                  ; one that uses ES.  This comment said ES for years.
   583                                  ;
   584                                  ;  Call with:
   585                                  ;       DS:BX -- pointer to the data block
   586                                  ;
   587                                  ;  Exit with:
   588                                  ;       AX and DX are destroyed; other registers preserved
   589                                  ;
   590                                  ;-----------------------------------------------------------------------------
   591                                  write_data:
   592 0000020B 51                          pushm   cx
   593 0000020C BAF001                  	mov		dx,IDEDTA
   594 0000020F 87F3                        xchg    si,bx			; as in read_data, but through DS:SI
   595 00000211 B90002                  	mov     cx,512          ; sector size in BYTES: this is 8-bit PIO
   596                                  wtblk2:
   597 00000214 AC                      	lodsb
   598 00000215 EE                      	out	dx,al
   599 00000216 E2FC                        loop    wtblk2
   600 00000218 87F3                        xchg    si,bx
   601 0000021A 59                          popm    cx
   602 0000021B C3                      	ret
   603                                  
   604                                  
   605                                  
   606                                  ;-----------------------------------------------------------------------------
   607                                  ; write the logical block address to the drive's registers
   608                                  ;
   609                                  ;  Call with:
   610                                  ;       DX:AX = logical block address
   611                                  ;		BH = Master/Slave selection in bit 4
   612                                  ;       BL = Sector read count
   613                                  ;
   614                                  ;  Exit with:
   615                                  ;       AX, BX, DX are destroyed
   616                                  ;
   617                                  ;-----------------------------------------------------------------------------
   618                                  wr_lba:
   619 0000021C 51                      		push 	cx
   620 0000021D 50                              push    ax
   621 0000021E 52                              push    dx
   622 0000021F 89D9                            mov 	CX,BX
   623                                  
   624 00000221 B010                            mov     al,10h          ; Master/Slave mask
   625 00000223 20E8                            and     al,ch           ; mask bit
   626 00000225 88F3                            mov     bl,dh           ; high order
   627 00000227 80E30F                          and     bl,00Fh
   628 0000022A 80CBE0                          or      bl,0E0h         ; mark as LBA
   629                                  
   630 0000022D 08D8                    		or		al,bl
   631 0000022F BAF601                  		mov		dx,IDEDRV
   632 00000232 EE                      		out		dx,al			; DRV
   633                                  
   634 00000233 5B                              pop     bx              ; get DL to BL
   635                                  
   636 00000234 88D8                    		mov		al,bl
   637 00000236 4A                      		dec		dx
   638 00000237 EE                      		out		dx,al			; LBA - H
   639                                  
   640 00000238 5B                              pop     bx
   641                                  
   642 00000239 88F8                    		mov		al,bh
   643 0000023B 4A                      		dec		dx
   644 0000023C EE                      		out		dx,al			; LBA - M
   645                                  
   646 0000023D 88D8                    		mov		al,bl
   647 0000023F 4A                      		dec		dx
   648 00000240 EE                      		out		dx,al			; LBA - L
   649                                  
   650 00000241 88C8                    		mov		al,cl
   651 00000243 4A                      		dec		dx
   652 00000244 EE                      		out		dx,al 			; SET SECTOR COUNT
   653                                  
   654 00000245 59                      		POP 	CX
   655 00000246 C3                      		ret
