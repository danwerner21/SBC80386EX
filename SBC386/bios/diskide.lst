   327                                  ;
   328                                  ;  int IDE_INITIALIZE(byte master_slave);
   329                                  ;
   330                                  ;
   331                                  ;-----------------------------------------------------------------------------
   332                                   		global 	IDE_INITIALIZE
   333                                   		global 	IDE_INITIALIZE_
   334                                  IDE_INITIALIZE:
   335                                  IDE_INITIALIZE_:
   336 000000DF 5152500653                      pushm   bx,es,ax,dx,cx
   337 000000E4 55                              push    bp
   338 000000E5 89E5                            mov     bp,sp
   339 000000E7 575306                          pushm   es,bx,di
   340                                  
   341                                  
   342                                  
   343 000000EA E83700                  		call	ide_wait_not_busy		; make sure drive is ready
   344 000000ED 7524                    		jnz	.2
   345                                  
   346 000000EF B300                            mov     bl,0	 				; COUNT OF SECTORS TO READ INTO BL
   347 000000F1 8A7E02                          mov     bh,ARG(0) 				; Master/slave INTO BH
   348 000000F4 B80000                          mov     ax,0
   349 000000F7 BA0000                          mov     dx,0
   350 000000FA E81F01                  		call	wr_lba					; tell it which sector we want
   351                                  
