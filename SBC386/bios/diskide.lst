   159                                  ;  IDE_WRITE_SECTOR
   160                                  ; -----------------------------------------------------------------------------
   161                                  ; write a sector, specified by the 4 bytes in "lba",
   162                                  ; Return, acc is zero on success, non-zero for an error
   163                                  ;
   164                                  ;  int IDE_WRITE_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
   165                                  ;
   166                                  ;
   167                                  ;-----------------------------------------------------------------------------
   168                                          global  IDE_WRITE_SECTOR
   169                                          global  IDE_WRITE_SECTOR_
   170                                  IDE_WRITE_SECTOR:
   171                                  IDE_WRITE_SECTOR_:
   172 00000044 52                      		push 	DX
   173 00000045 53                      		push    BX
   174 00000046 51                      		push 	CX
   175 00000047 55                              push    bp
   176 00000048 89E5                            mov     bp,sp
   177 0000004A 1E                              push 	DS
   178 0000004B 56                              push	SI
   179                                  
   180                                  ; Master/slave must be taken out of AL BEFORE the wait below:
   181                                  ;  ide_wait_not_busy returns the drive status in AL, so reading
   182                                  ;  the argument afterwards always yielded 0 -- the master.  BX
   183                                  ;  is preserved across the call.
   184 0000004C 88C7                            mov     bh,al                   ; Master/slave INTO BH
   185 0000004E E8BD00                  		call	ide_wait_not_busy		; make sure drive is ready
   186 00000051 752E                    		jnz	.2
   187                                  
   188 00000053 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS
   189 00000056 8B560C                          mov     dx,ARG(5)
   190 00000059 8B460A                          mov     ax,ARG(4)
   191 0000005C E8A701                  		call	wr_lba					; tell it which sector we want
   192                                  
   193 0000005F B030                            mov     al,IDE_CMD_PIO_WRITE
   194 00000061 BAF701                  		mov		dx,IDESTTS
   195 00000064 EE                      		out		dx,al
   196                                  
   197                                  
   198 00000065 8B4E0E                          mov     CX,ARG(6) 				; COUNT OF SECTORS
   199 00000068 8E5E02                          mov     ds,ARG(0) 				; high address INTO ds
   200 0000006B 8B5E04                          mov     bx,ARG(1)				; low address into bx
   201                                  .4:
   202                                  ; DRQ is raised once per sector on the way out too, so the wait goes
   203                                  ; inside the loop here for the same reason as the read path.
   204 0000006E E8CB00                  		call	ide_wait_drq
   205 00000071 750E                    		jnz	.2
   206 00000073 E87F01                  		call	write_data				; send the data
   207 00000076 E2F6                    		loop	.4
   208                                  
   209                                  ; The drive is still writing the last sector when the loop ends: wait for
   210                                  ; it to finish so a failure is reported to this caller and not the next.
   211 00000078 E89300                  		call	ide_wait_not_busy
   212 0000007B 7504                    		jnz	.2
   213                                  
   214 0000007D 31C0                            xor     ax,ax
   215 0000007F EB03                    		jmp	.9
   216                                  .2:
   217 00000081 E8F000                  		call	ide_error				; real status, not -1
   218                                  .9:
   219 00000084 5E                         		POP 	SI
   220 00000085 1F                         		POP 	DS
   221 00000086 C9                              leave
   222 00000087 59                              pop 	CX
   223 00000088 5B                              pop 	BX
   224 00000089 5A                              pop 	DX
   225 0000008A C20600                          ret	6	; was 'ret', but Watcom proc must remove args!!!
   226                                  
