   206 00000080 1F                         		POP 	DS
   207 00000081 C9                              leave
   208 00000082 59                              pop 	CX
   209 00000083 5B                              pop 	BX
   210 00000084 5A                              pop 	DX
   211 00000085 C20600                          ret	6	; was 'ret', but Watcom proc must remove args!!!
