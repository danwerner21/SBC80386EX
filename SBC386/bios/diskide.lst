    91 00000000 ????????????????    <1> serial_dev	resw	4	; serial port device codes */
    92 00000008 ????????????????    <1> parallel_dev	resw	4	; printer port device codes */
    93 00000010 ????                <1> equip_flag	resw	1		; int 12h equipment flags */
    94 00000012 ??                  <1> mfg_test	resb	1		; initialization flags */
    95 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    96 00000015 ??                  <1> mfg_err_flag	resb	1
    97 00000016 ??                  <1> mfg_err_flag2	resb	1
    98                              <1> ; */
    99                              <1> ; first Keyboard data area */
   100 00000017 ??                  <1> kbd_flag	resb	1	; shift status &c. */
   101 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
   102 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
   103 0000001A ????                <1> buffer_head	resw	1
   104 0000001C ????                <1> buffer_tail	resw	1
   105                              <1> ; */
   106 0000001E <res 20h>           <1> kbd_buffer	resw	16	; buffer empty when  head==tail**/
   107                              <1> ; */
   108                              <1> ; Diskette data area */
   109 0000003E ??                  <1> seek_status	resb	1	; drive recalibration status */
   110                              <1> ; bits 3..0 drive must recalibrate before next seek */
   111 0000003F ??                  <1> motor_status	resb	1	; bits 3..0 motor running */
   112                              <1> ; bit 7 current op is write */
   113 00000040 ??                  <1> motor_count	resb	1	; timeout counter for motor turn-off */
   114 00000041 ??                  <1> fd_status	resb	1	; return code status byte */
   115 00000042 ??????????????      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   116                              <1> ; */
   117                              <1> ; Video Display data area -- also used for video emulation */
   118 00000049 ??                  <1> vid_mode	resb	1	; current display mode */
   119 0000004A ????                <1> vid_columns	resw	1	; no. of columns on the screen */
   120 0000004C ????                <1> vid_buf_len	resw	1	; length of video buffer in bytes*//
   121 0000004E ????                <1> vid_start	resw	1	; start address of screen regeneration (in vid buf)*//
   122 00000050 <res 10h>           <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   123 00000060 ????                <1> vid_cursor_mode	resw	1
   124 00000062 ??                  <1> vid_active_page	resb	1
   125 00000063 ????                <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA)*//
   126 00000065 ??                  <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   127 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
   128                              <1> ; */
   129                              <1> ; POST and ROM data */
   130 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   131                              <1> %define io_rom_addr_low io_rom_addr
   132                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   133 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   134                              <1> ; */
   135                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   136 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
   137 0000006E ????                <1> timer_count_high	resw	1
   138                              <1> %define timer_count timer_count_low
   139                              <1> ; use timer_count as the double word timer counter */
   140 00000070 ??                  <1> timer_overflow	resb	1	; timer has rolled over since last read */
   141                              <1> ; */
   142                              <1> ; System & Keboard data area */
   143 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   144 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   145                              <1> ; */
   146                              <1> ; Fixed (Hard) disk data area */
   147 00000074 ??                  <1> hd_status	resb	1	; status info for hard disk */
   148                              <1> %define disk_status1 hd_status
   149 00000075 ??                  <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
