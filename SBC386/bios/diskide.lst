   272 000000B5 EB0B                    		jmp	.9
   273                                  .3:
   274                                  
   275 000000B7 8E4602                          mov     es,ARG(0) 				; high address INTO ax
   276 000000BA 8B5E04                          mov     bx,ARG(1)				; low address into bx
   277 000000BD E80D01                  		call	read_dataBE				; grab the data
   278                                  
   279 000000C0 31C0                            xor     ax,ax
   280                                  
   281                                  .9:
   282 000000C2 5F                         		POP 	DI
   283 000000C3 07                         		POP 	ES
   284 000000C4 C9                              leave
