   247 000000A4 BAF701                  		mov	dx,IDESTTS
   248 000000A7 EE                      		out	dx,al
   249                                  
   250 000000A8 E87200                  		call	ide_wait_drq			;wait until it's got the data
   251 000000AB 7405                    		jz	.3
   252                                  .2:
   253 000000AD B8FFFF                     		mov		ax,-1					; MARK ERROR, ABORT
   254 000000B0 EB0B                    		jmp	.9
   255                                  .3:
   256                                  
   257 000000B2 8E4602                          mov     es,ARG(0) 				; high address INTO ax
   258 000000B5 8B5E04                          mov     bx,ARG(1)				; low address into bx
   259 000000B8 E87800                  		call	read_dataBE				; grab the data
   260                                  
   261 000000BB 31C0                            xor     ax,ax
   262                                  
   263                                  .9:
   264 000000BD 5F                         		POP 	DI
   265 000000BE 07                         		POP 	ES
   266 000000BF C9                              leave
