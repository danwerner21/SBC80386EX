   178 00000051 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS
   179 00000054 88C7                            mov     bh,al	 				; Master/slave INTO BH
   180 00000056 8B560C                          mov     dx,ARG(5)
   181 00000059 8B460A                          mov     ax,ARG(4)
