   274                                  ; -----------------------------------------------------------------------------
   275                                  ;  IDE_INITIALIZE
   276                                  ; -----------------------------------------------------------------------------
   277                                  ; IDE INITIALIZE DRIVE FOR OPERATION
   278                                  ;
   279                                  ;  int IDE_INITIALIZE(byte master_slave);
   280                                  ;
   281                                  ;
   282                                  ;-----------------------------------------------------------------------------
   283                                   		global 	IDE_INITIALIZE
   284                                   		global 	IDE_INITIALIZE_
   285                                  IDE_INITIALIZE:
   286                                  IDE_INITIALIZE_:
   287 000000C4 5152500653                      pushm   bx,es,ax,dx,cx
   288 000000C9 55                              push    bp
   289 000000CA 89E5                            mov     bp,sp
   290 000000CC 575306                          pushm   es,bx,di
   291                                  
   292                                  
   293                                  
   294 000000CF E83700                  		call	ide_wait_not_busy		; make sure drive is ready
   295 000000D2 7524                    		jnz	.2
   296                                  
   297 000000D4 B300                            mov     bl,0	 				; COUNT OF SECTORS TO READ INTO BL
   298 000000D6 8A7E02                          mov     bh,ARG(0) 				; Master/slave INTO BH
   299 000000D9 B80000                          mov     ax,0
   300 000000DC BA0000                          mov     dx,0
   301 000000DF E88A00                  		call	wr_lba					; tell it which sector we want
   302                                  
   303                                  ; SET 8-BIT MODE
   304 000000E2 E82400                  	  	call	ide_wait_not_busy		;make sure drive is ready
   305 000000E5 7511                    		jnz	.2
   306                                  
   307 000000E7 B001                    		mov	al,01h
   308 000000E9 BAF101                  		mov	dx,IDEERR
   309 000000EC EE                      		out	dx,al
   310 000000ED B0EF                    		mov	al,IDE_CMD_SET_FEATURE
   311 000000EF BAF701                  		mov	dx,IDESTTS
   312 000000F2 EE                      		out	dx,al
   313 000000F3 E81300                  		call	ide_wait_not_busy		;make sure drive is ready
   314 000000F6 7405                    		jz	.3
   315                                  .2:
   316 000000F8 B8FFFF                  		mov		ax,-1					; MARK ERROR, ABORT
   317 000000FB EB02                    		jmp	.9
   318                                  .3:
