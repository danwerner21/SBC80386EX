   260                                  ; IDE_READ_ID
   261                                  ; -----------------------------------------------------------------------------
   262                                  ; Read the 512 byte ID information from the attached drive
   263                                  ;
   264                                  ;  int DIDE_READ_ID(byte master_slave, byte far *buffer);
   265                                  ;
   266                                  ;
   267                                  ;-----------------------------------------------------------------------------
   268                                  		global	IDE_READ_ID
   269                                  		global	IDE_READ_ID_
   270                                  IDE_READ_ID:
   271                                  IDE_READ_ID_:
   272 000000A3 52                      		push 	DX
   273 000000A4 53                      		push    BX
   274 000000A5 51                      		push 	CX
   275 000000A6 55                              push    bp
   276 000000A7 89E5                            mov     bp,sp
   277 000000A9 06                              push 	ES
   278 000000AA 57                              push	DI
   279                                  
   280                                  
   281                                  ; Master/slave must be taken out of AL BEFORE the wait below:
   282                                  ;  ide_wait_not_busy returns the drive status in AL, so reading
   283                                  ;  the argument afterwards always yielded 0 -- the master.  BX
   284                                  ;  is preserved across the call.
   285 000000AB 88C7                            mov     bh,al                   ; Master/slave INTO BH
   286 000000AD E87400                  		call	ide_wait_not_busy		; make sure drive is ready
   287 000000B0 7516                    		jnz	.2
   288                                  
   289 000000B2 B300                            mov     bl,0	 				; COUNT OF SECTORS TO READ INTO BL
   290 000000B4 B80000                          mov     ax,0
   291 000000B7 BA0000                          mov     dx,0
   292 000000BA E85F01                  		call	wr_lba					; tell it which sector we want
   293                                  
   294                                  ; GET DRIVE IDENT
   295 000000BD B0EC                    		mov	al,IDE_CMD_IDENT
   296 000000BF BAF701                  		mov	dx,IDESTTS
   297 000000C2 EE                      		out	dx,al
   298                                  
   299 000000C3 E88C00                  		call	ide_wait_drq			;wait until it's got the data
   300 000000C6 7405                    		jz	.3
   301                                  .2:
   302 000000C8 E8BF00                     		call	ide_error				; real status, not -1
   303 000000CB EB0B                    		jmp	.9
   304                                  .3:
   305                                  
   306 000000CD 8E4602                          mov     es,ARG(0) 				; high address INTO ax
   307 000000D0 8B5E04                          mov     bx,ARG(1)				; low address into bx
   308 000000D3 E80D01                  		call	read_dataBE				; grab the data
   309                                  
   310 000000D6 31C0                            xor     ax,ax
   311                                  
   312                                  .9:
   313 000000D8 5F                         		POP 	DI
   314 000000D9 07                         		POP 	ES
   315 000000DA C9                              leave
   316 000000DB 59                              pop 	CX
   317 000000DC 5B                              pop 	BX
   318 000000DD 5A                              pop 	DX
   319 000000DE C3                              ret
   320                                  
