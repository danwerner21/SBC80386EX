   183                                  
   184 0000005F B030                            mov     al,IDE_CMD_PIO_WRITE
   185 00000061 BAF701                  		mov		dx,IDESTTS
   186 00000064 EE                      		out		dx,al
   187                                  
   188 00000065 E8B500                  		call	ide_wait_drq			; wait until it wants the data
   189 00000068 7405                    		jz	.3							; NO ERROR, CONTINUE
   190                                  .2:
   191 0000006A B8FFFF                     		mov		ax,-1					; MARK ERROR, ABORT
   192 0000006D EB10                    		jmp	.9
   193                                  .3:
   194                                  
   195 0000006F 8B4E0E                          mov     CX,ARG(6) 				; COUNT OF SECTORS
   196 00000072 8E5E02                          mov     ds,ARG(0) 				; high address INTO ds
   197 00000075 8B5E04                          mov     bx,ARG(1)				; low address into bx
   198                                  .4:
   199 00000078 E8E000                  		call	write_data				; send the data
   200 0000007B E2FB                    		loop	.4
   201                                  
   202 0000007D 31C0                            xor     ax,ax
   203                                  
   204                                  .9:
