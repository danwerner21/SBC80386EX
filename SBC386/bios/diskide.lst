   329 000000F4 BAF701                  		mov	dx,IDESTTS
   330 000000F7 EE                      		out	dx,al
   331 000000F8 E81300                  		call	ide_wait_not_busy		;make sure drive is ready
   332 000000FB 7405                    		jz	.3
   333                                  .2:
