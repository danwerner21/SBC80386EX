   329                                  ;------------------------------------------------------------------------------
   330                                  ; IDE INTERNAL SUBROUTINES
   331                                  ;------------------------------------------------------------------------------
   332                                  ;-----------------------------------------------------------------------------
   333                                  ;  Wait for RDY to be set
   334                                  ;
   335                                  ;  Exit with:
   336                                  ;       AL contains status
   337                                  ;       All other registers preserved
   338                                  ;
   339                                  ;------------------------------------------------------------------------------
   340                                  ide_wait_not_busy:
   341 00000109 515253                          pushm   bx,dx,cx
   342 0000010C B9FFFF                  		mov	cx,0FFFFh
   343                                  .1:
   344 0000010F BAF701                  		mov	dx,IDESTTS
   345 00000112 EC                      		in	al,dx
   346                                  
   347 00000113 2480                            and     al,10000000b
   348 00000115 E0F8                    		loopnz	.1
   349                                  
   350 00000117 08C0                    		or	al,al
   351 00000119 5B5A59                          popm    bx,dx,cx
   352 0000011C C3                      		ret
   353                                  ;------------------------------------------------------------------------------
   354                                  ; Wait for the drive to be ready to transfer data (DRQ = data request)
   355                                  ; Returns the drive's status in Acc
   356                                  ;
   357                                  ;  Exit with:
   358                                  ;       AL contains status
   359                                  ;       All other registers preserved
   360                                  ;------------------------------------------------------------------------------
   361                                  ide_wait_drq:
   362 0000011D 515253                          pushm   bx,dx,cx
   363 00000120 B9FFFF                  		mov	cx,0FFFFh
   364                                  .1:
   365 00000123 BAF701                     		mov	dx,IDESTTS
   366 00000126 EC                      		in	al,dx
   367                                  
   368 00000127 2488                            and     al,10001000b		; Mask off Busy(7) and DRQ(3)
   369 00000129 3408                            xor     al,00001000b		; We want Busy(7) to be 0 and DRQ (3) to be 1
   370                                  
   371 0000012B E0F6                    		loopnz	.1
   372                                  
   373 0000012D 08C0                    		or	al,al
   374 0000012F 5B5A59                          popm    bx,dx,cx
   375 00000132 C3                      	ret
   376                                  ;------------------------------------------------------------------------------
   377                                  ; Read a sector of 512 bytes into memory at ES:[BX]
   378                                  ;
   379                                  ;  Call with:
   380                                  ;       ES:BX -- pointer to the data block
   381                                  ;
   382                                  ;  Exit with:
   383                                  ;       AX and DX are destroyed; other registers preserved
   384                                  ;
   385                                  ; "BE" version is for ide id information
   386                                  ;-----------------------------------------------------------------------------
   387                                  read_dataBE:
   388 00000133 5153                        pushm   bx,cx
   389 00000135 BAF001                  	mov		dx,IDEDTA
   390                                  
   391 00000138 87FB                        xchg    di,bx
   392                                  
   393 0000013A B90001                  	mov     cx,256          ; sector size in words
   394                                  rdblk2BE:
   395 0000013D EC                      	in	al,dx
   396 0000013E 88C4                    	mov ah,al
   397 00000140 EC                      	in	al,dx
   398 00000141 AA                      	stosb
   399 00000142 88E0                    	mov al,ah
   400 00000144 AA                      	stosb
   401 00000145 E2F6                        loop    rdblk2BE
   402 00000147 5B59                        popm    bx,cx
   403 00000149 C3                      	ret
   404                                  
   405                                  read_data:
   406 0000014A 51                          pushm   cx
   407 0000014B BAF001                  	mov		dx,IDEDTA
   408 0000014E 87FB                        xchg    di,bx
   409 00000150 B90002                  	mov     cx,512          ; sector size in words
   410                                  rdblk2:
   411 00000153 EC                      	in	al,dx
   412 00000154 AA                      	stosb
   413 00000155 E2FC                        loop    rdblk2
   414 00000157 87FB                        xchg    di,bx
   415 00000159 59                          popm    cx
   416 0000015A C3                      	ret
   417                                  
   418                                  ;------------------------------------------------------------------------------
   419                                  ; Write a sector of 512 bytes from memory at ES:[BX]
   420                                  ;
   421                                  ;  Call with:
   422                                  ;       ES:BX -- pointer to the data block
   423                                  ;
   424                                  ;  Exit with:
   425                                  ;       AX and DX are destroyed; other registers preserved
   426                                  ;
   427                                  ;-----------------------------------------------------------------------------
   428                                  write_data:
   429 0000015B 51                          pushm   cx
   430 0000015C BAF001                  	mov		dx,IDEDTA
   431 0000015F 87F3                        xchg    si,bx
   432 00000161 B90002                  	mov     cx,512          ; sector size in words
   433                                  wtblk2:
   434 00000164 AC                      	lodsb
   435 00000165 EE                      	out	dx,al
   436 00000166 E2FC                        loop    wtblk2
   437 00000168 87F3                        xchg    si,bx
   438 0000016A 59                          popm    cx
   439 0000016B C3                      	ret
   440                                  
   441                                  
   442                                  
   443                                  ;-----------------------------------------------------------------------------
   444                                  ; write the logical block address to the drive's registers
   445                                  ;
   446                                  ;  Call with:
   447                                  ;       DX:AX = logical block address
   448                                  ;		BH = Master/Slave selection in bit 4
   449                                  ;       BL = Sector read count
   450                                  ;
   451                                  ;  Exit with:
   452                                  ;       AX, BX, DX are destroyed
   453                                  ;
   454                                  ;-----------------------------------------------------------------------------
   455                                  wr_lba:
   456 0000016C 51                      		push 	cx
   457 0000016D 50                              push    ax
   458 0000016E 52                              push    dx
   459 0000016F 89D9                            mov 	CX,BX
   460                                  
   461 00000171 B010                            mov     al,10h          ; Master/Slave mask
   462 00000173 20E8                            and     al,ch           ; mask bit
   463 00000175 88F3                            mov     bl,dh           ; high order
   464 00000177 80E30F                          and     bl,00Fh
   465 0000017A 80CBE0                          or      bl,0E0h         ; mark as LBA
   466                                  
   467 0000017D 08D8                    		or		al,bl
   468 0000017F BAF601                  		mov		dx,IDEDRV
   469 00000182 EE                      		out		dx,al			; DRV
   470                                  
   471 00000183 5B                              pop     bx              ; get DL to BL
   472                                  
   473 00000184 88D8                    		mov		al,bl
   474 00000186 4A                      		dec		dx
   475 00000187 EE                      		out		dx,al			; LBA - H
   476                                  
   477 00000188 5B                              pop     bx
   478                                  
   479 00000189 88F8                    		mov		al,bh
   480 0000018B 4A                      		dec		dx
   481 0000018C EE                      		out		dx,al			; LBA - M
   482                                  
   483 0000018D 88D8                    		mov		al,bl
   484 0000018F 4A                      		dec		dx
   485 00000190 EE                      		out		dx,al			; LBA - L
   486                                  
   487 00000191 88C8                    		mov		al,cl
   488 00000193 4A                      		dec		dx
   489 00000194 EE                      		out		dx,al 			; SET SECTOR COUNT
   490                                  
   491 00000195 59                      		POP 	CX
   492 00000196 C3                      		ret
