   220                                  ;
   221                                  ;
   222                                  ;-----------------------------------------------------------------------------
   223                                  		global	IDE_READ_ID
   224                                  		global	IDE_READ_ID_
   225                                  IDE_READ_ID:
   226                                  IDE_READ_ID_:
   227 00000088 52                      		push 	DX
   228 00000089 53                      		push    BX
   229 0000008A 51                      		push 	CX
   230 0000008B 55                              push    bp
   231 0000008C 89E5                            mov     bp,sp
   232 0000008E 06                              push 	ES
   233 0000008F 57                              push	DI
   234                                  
   235                                  
   236 00000090 E87600                  		call	ide_wait_not_busy		; make sure drive is ready
   237 00000093 7518                    		jnz	.2
   238                                  
   239 00000095 B300                            mov     bl,0	 				; COUNT OF SECTORS TO READ INTO BL
   240 00000097 88C7                            mov     bh,al 					; Master/slave INTO BH
   241 00000099 B80000                          mov     ax,0
   242 0000009C BA0000                          mov     dx,0
   243 0000009F E8CA00                  		call	wr_lba					; tell it which sector we want
   244                                  
