    97                              <1> %define DISK_REMOVED	6		; F, SD */
    98                              <1> %define	MEDIA_CHANGED	6
    99                              <1> ; */
   100                              <1> %define BAD_PARAMETER_TABLE	7
   101                              <1> %define DMA_OVERRUN		8		; F, H */
   102                              <1> ; */
   103                              <1> %define DMA_CROSSED_64K_BOUND	9
   104                              <1> %define DMA_BOUNDARY	9
   105                              <1> ; */
   106                              <1> %define BAD_SECTOR_FLAG	0x0A
   107                              <1> %define BAD_TRACK_FLAG	0x0B
   108                              <1> %define MEDIA_TYPE_NOT_FOUND	0x0C	; F */
   109                              <1> %define INVALID_NUMBER_OF_SECTORS	0x0D	; H */
   110                              <1> %define CONTROL_DATA_ADDRESS_MARK_DETECTED	0x0E	; H */
   111                              <1> %define DMA_ARBITRATION_LEVEL_OUT_OF_RANGE	0x0F	; H */
   112                              <1> %define BAD_CRC			0x10	; F */
   113                              <1> %define ECC_CORRECTED_DATA_ERROR	0x11	; H */
   114                              <1> %define CONTROLLER_FAILED		0x20
   115                              <1> %define BAD_SEEK		0x40
   116                              <1> %define TIME_OUT		0x80
   117                              <1> ; */
   118                              <1> %define DRIVE_NOT_READY		0xAA	; SD, H */
   119                              <1> %define UNDEFINED_ERROR		0xBB
   120                              <1> %define WRITE_FAULT		0xCC	; H */
   121                              <1> %define STATUS_REGISTER_ERROR	0xE0	; H */
   122                              <1> %define SENSE_OPERATION_FAILED	0xFF	; H */
   123                              <1> ; */
   124                              <1> ; */
   125                              <1> ; */
   126                              <1> ;---------- DISKETTE ERROR -------------------------------------	*/
   127                              <1> ; TIME_OUT	EQU	080H		; ATTACHMENT FAILED TO RESPOND		*/
   128                              <1> ; BAD_SEEK	EQU	040H		; SEEK OPERATION FAILED		*/
   129                              <1> ; BAD_NEC		EQU	020H		; DISKETTE CONTROLLER HAS FAILED		*/
   130                              <1> ; BAD_CRC		EQU	010H		; BAD CRC ON DISKETTE READ		*/
   131                              <1> ; DMA_BOUNDARY	EQU	009H		; ATTEMPT TO DMA ACROSS 64K BOUNDARY		*/
   132                              <1> ; BAD_DMA		EQU	008H		; DMA OVERRUN ON OPERATION		*/
   133                              <1> ; MEDIA_CHANGE	EQU	006H		; MEDIA REMOVED ON DUAL ATTACH CARD		*/
   134                              <1> ; RECORD_NOT_FND	EQU	004H		; REQUESTED SECTOR NOT FOUND		*/
   135                              <1> ; WRITE_PROTECT	EQU	003H		; WRITE ATTEMPTED ON WRITE PROTECT DISK		*/
   136                              <1> ; BAD_ADDR_MARK	EQU	002H		; ADDRESS MARK NOT FOUND		*/
   137                              <1> ; BAD_CMD		EQU	001H		; BAD COMMAND PASSED TO DISKETTE I/O		*/
   138                              <1> ; */
   139                              <1> ; */
    87                                  %undef XXX
    88                                  
    89                                  %define ARG(n) [bp+2+(n)*2]
    90                                  
    91                                  	SEGMENT	_TEXT
    92                                  
    93                                  ; -----------------------------------------------------------------------------
    94                                  ;  IDE_READ_SECTOR
    95                                  ; -----------------------------------------------------------------------------
    96                                  ; read a sector, specified by the 4 bytes in "lba",
    97                                  ; Return, acc is zero on success, non-zero for an error
    98                                  ;
    99                                  ;  int IDE_READ_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
   100                                  ;
   101                                  ;
   102                                  ;-----------------------------------------------------------------------------
   103                                          global  IDE_READ_SECTOR
   104                                          global  IDE_READ_SECTOR_
   105                                  IDE_READ_SECTOR:
   106                                  IDE_READ_SECTOR_:
   107 00000000 52                      		push 	DX
   108 00000001 53                      		push    BX
   109 00000002 51                      		push 	CX
   110 00000003 55                              push    bp
   111 00000004 89E5                            mov     bp,sp
   112 00000006 06                              push 	ES
   113 00000007 57                              push	DI
   114                                  
   115                                  ; A count of zero has to be caught before the drive is touched.  ATA reads
   116                                  ; a sector count register of 0 as a request for 256 sectors, and the LOOP
   117                                  ; below would run 65536 times -- 32Mb driven through the caller's buffer
   118                                  ; from a drive that is only sending 128Kb.  fn42 and fn43 can deliver one:
   119                                  ; pkt_rw_validate rejects a block count of 128 and above but says nothing
   120                                  ; about zero, and the EDD packet interface both allows it and defines it as
   121                                  ; "transfer nothing".  The CHS path never could -- rwv_common tests its own
   122                                  ; count first -- which is part of why this went unnoticed.
   123 00000008 807E0E00                        cmp     byte ARG(6),0
   124 0000000C 7504                            jne     .1
   125 0000000E 31C0                            xor     ax,ax                   ; nothing asked for, nothing to do
   126 00000010 EB34                            jmp     .9
   127                                  .1:
   128                                  
   129                                  ; Master/slave must be taken out of AL BEFORE the wait below:
   130                                  ;  ide_wait_not_busy returns the drive status in AL, so reading
   131                                  ;  the argument afterwards always yielded 0 -- the master.  BX
   132                                  ;  is preserved across the call.
   133 00000012 88C7                            mov     bh,al                   ; Master/slave INTO BH
   134 00000014 E80D01                  		call	ide_wait_not_busy		; make sure drive is ready
   135 00000017 752A                    		jnz	.2
   136                                  
   137 00000019 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS
   138 0000001C 8B560C                          mov     dx,ARG(5)
   139 0000001F 8B460A                          mov     ax,ARG(4)
   140 00000022 E8F701                  		call	wr_lba					; tell it which sector we want
   141                                  
   142 00000025 B020                            mov     al,IDE_CMD_PIO_READ
   143 00000027 BAF701                  		mov		dx,IDESTTS
   144 0000002A EE                      		out		dx,al
   145                                  
   146                                  ; Zero-extended from the same byte wr_lba was handed above.  Read as a word
   147                                  ; -- which is what this was -- the loop count and the count the drive was
   148                                  ; given could disagree the moment anything put rubbish in the high half.
   149 0000002B 0FB64E0E                        movzx   CX,byte ARG(6) 			; COUNT OF SECTORS
   150 0000002F 8E4602                          mov     es,ARG(0) 				; high address INTO es
   151 00000032 8B5E04                          mov     bx,ARG(1)				; low address into bx
   152                                  .4:
   153                                  ; ATA raises DRQ once per sector during a multi-sector PIO transfer, so
   154                                  ; the wait belongs inside this loop.  Polled once before it, the second
   155                                  ; and later sectors ran ahead of the drive and desynchronised.
   156 00000035 E81A01                  		call	ide_wait_drq
   157 00000038 7509                    		jnz	.2
   158 0000003A E8BD01                  		call	read_data				; grab the data
   159 0000003D E2F6                    		loop	.4
   160                                  
   161 0000003F 31C0                            xor     ax,ax
   162 00000041 EB03                    		jmp	.9
   163                                  .2:
   164 00000043 E84401                  		call	ide_error				; real status, not -1
   165                                  .9:
   166 00000046 5F                         		POP 	DI
   167 00000047 07                         		POP 	ES
   168 00000048 C9                              leave
   169 00000049 59                              pop 	CX
   170 0000004A 5B                              pop 	BX
   171 0000004B 5A                              pop 	DX
   172 0000004C C20600                          ret	6	; was 'ret', but Watcom proc must remove args!!!
   173                                  
   174                                  
   175                                  ; -----------------------------------------------------------------------------
   176                                  ;  IDE_WRITE_SECTOR
   177                                  ; -----------------------------------------------------------------------------
   178                                  ; write a sector, specified by the 4 bytes in "lba",
   179                                  ; Return, acc is zero on success, non-zero for an error
   180                                  ;
   181                                  ;  int IDE_WRITE_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
   182                                  ;
   183                                  ;
   184                                  ;-----------------------------------------------------------------------------
   185                                          global  IDE_WRITE_SECTOR
   186                                          global  IDE_WRITE_SECTOR_
   187                                  IDE_WRITE_SECTOR:
   188                                  IDE_WRITE_SECTOR_:
   189 0000004F 52                      		push 	DX
   190 00000050 53                      		push    BX
   191 00000051 51                      		push 	CX
   192 00000052 55                              push    bp
   193 00000053 89E5                            mov     bp,sp
   194 00000055 1E                              push 	DS
   195 00000056 56                              push	SI
   196                                  
   197                                  ; A count of zero has to be caught before the drive is touched.  ATA reads
   198                                  ; a sector count register of 0 as a request for 256 sectors, and the LOOP
   199                                  ; below would run 65536 times -- 32Mb driven through the caller's buffer
   200                                  ; from a drive that is only sending 128Kb.  fn42 and fn43 can deliver one:
   201                                  ; pkt_rw_validate rejects a block count of 128 and above but says nothing
   202                                  ; about zero, and the EDD packet interface both allows it and defines it as
   203                                  ; "transfer nothing".  The CHS path never could -- rwv_common tests its own
   204                                  ; count first -- which is part of why this went unnoticed.
   205 00000057 807E0E00                        cmp     byte ARG(6),0
   206 0000005B 7504                            jne     .1
   207 0000005D 31C0                            xor     ax,ax                   ; nothing asked for, nothing to do
   208 0000005F EB39                            jmp     .9
   209                                  .1:
   210                                  
   211                                  ; Master/slave must be taken out of AL BEFORE the wait below:
   212                                  ;  ide_wait_not_busy returns the drive status in AL, so reading
   213                                  ;  the argument afterwards always yielded 0 -- the master.  BX
   214                                  ;  is preserved across the call.
   215 00000061 88C7                            mov     bh,al                   ; Master/slave INTO BH
   216 00000063 E8BE00                  		call	ide_wait_not_busy		; make sure drive is ready
   217 00000066 752F                    		jnz	.2
   218                                  
   219 00000068 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS
   220 0000006B 8B560C                          mov     dx,ARG(5)
   221 0000006E 8B460A                          mov     ax,ARG(4)
   222 00000071 E8A801                  		call	wr_lba					; tell it which sector we want
   223                                  
   224 00000074 B030                            mov     al,IDE_CMD_PIO_WRITE
   225 00000076 BAF701                  		mov		dx,IDESTTS
   226 00000079 EE                      		out		dx,al
   227                                  
   228                                  ; Zero-extended, for the reason given on the read side.
   229 0000007A 0FB64E0E                        movzx   CX,byte ARG(6) 			; COUNT OF SECTORS
   230 0000007E 8E5E02                          mov     ds,ARG(0) 				; high address INTO ds
   231 00000081 8B5E04                          mov     bx,ARG(1)				; low address into bx
   232                                  .4:
   233                                  ; DRQ is raised once per sector on the way out too, so the wait goes
   234                                  ; inside the loop here for the same reason as the read path.
   235 00000084 E8CB00                  		call	ide_wait_drq
   236 00000087 750E                    		jnz	.2
   237 00000089 E87F01                  		call	write_data				; send the data
   238 0000008C E2F6                    		loop	.4
   239                                  
   240                                  ; The drive is still writing the last sector when the loop ends: wait for
   241                                  ; it to finish so a failure is reported to this caller and not the next.
   242 0000008E E89300                  		call	ide_wait_not_busy
   243 00000091 7504                    		jnz	.2
   244                                  
   245 00000093 31C0                            xor     ax,ax
   246 00000095 EB03                    		jmp	.9
   247                                  .2:
   248 00000097 E8F000                  		call	ide_error				; real status, not -1
   249                                  .9:
   250 0000009A 5E                         		POP 	SI
   251 0000009B 1F                         		POP 	DS
   252 0000009C C9                              leave
   253 0000009D 59                              pop 	CX
   254 0000009E 5B                              pop 	BX
   255 0000009F 5A                              pop 	DX
   256 000000A0 C20600                          ret	6	; was 'ret', but Watcom proc must remove args!!!
   257                                  
   258                                  
