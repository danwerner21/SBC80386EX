   141 00000039 31C0                            xor     ax,ax
   142                                  
   143                                  .9:
   144 0000003B 5F                         		POP 	DI
   145 0000003C 07                         		POP 	ES
   146 0000003D C9                              leave
   147 0000003E 59                              pop 	CX
   148 0000003F 5B                              pop 	BX
   149 00000040 5A                              pop 	DX
   150 00000041 C20600                          ret	6	; was 'ret', but Watcom proc must remove args!!!
