   243 0000008F 51                      		push 	CX
   244 00000090 55                              push    bp
   245 00000091 89E5                            mov     bp,sp
   246 00000093 06                              push 	ES
   247 00000094 57                              push	DI
   248                                  
   249                                  
   250                                  ; Master/slave must be taken out of AL BEFORE the wait below:
   251                                  ;  ide_wait_not_busy returns the drive status in AL, so reading
   252                                  ;  the argument afterwards always yielded 0 -- the master.  BX
   253                                  ;  is preserved across the call.
   254 00000095 88C7                            mov     bh,al                   ; Master/slave INTO BH
   255 00000097 E87400                  		call	ide_wait_not_busy		; make sure drive is ready
   256 0000009A 7516                    		jnz	.2
   257                                  
   258 0000009C B300                            mov     bl,0	 				; COUNT OF SECTORS TO READ INTO BL
   259 0000009E B80000                          mov     ax,0
   260 000000A1 BA0000                          mov     dx,0
