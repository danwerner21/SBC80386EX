   377                                  
   378                                  ;------------------------------------------------------------------------------
   379                                  ; IDE INTERNAL SUBROUTINES
   380                                  ;------------------------------------------------------------------------------
   381                                  ;-----------------------------------------------------------------------------
   382                                  ;  ide_wait_not_busy -- wait for BSY to clear
   383                                  ;
   384                                  ;  Exit with:
   385                                  ;       AL      the status register as read
   386                                  ;       ZF      set on success, clear on timeout
   387                                  ;       All other registers preserved
   388                                  ;
   389                                  ;  The old form of this spun on "mov cx,0FFFFh / loopnz", which is both
   390                                  ;  clock-dependent and far too short -- a few milliseconds at 20mhz, where
   391                                  ;  ATA allows seconds for a reset and a card can take hundreds of
   392                                  ;  milliseconds to come ready.  The 18.2hz BDA tick is used instead: it is
   393                                  ;  the only clock still running after POST, since start_timer0_ in
   394                                  ;  1Ah_time.asm gates counters 1 and 2 off.  A single word read of
   395                                  ;  timer_count_low cannot tear against IRQ0, and the unsigned subtraction
   396                                  ;  rides through the wrap.
   397                                  ;------------------------------------------------------------------------------
   398                                  IDE_TIMEOUT	equ	18*5		; five seconds, in 18.2hz ticks
   399                                  
   400                                  ide_wait_not_busy:
   401 00000124 06525153                        pushm   bx,cx,dx,es
   402 00000128 6A4007                  	get_bda	ES
   403 0000012B 268B1E6C00                  es	mov	bx,[timer_count_low]		; when we started
   404                                  .1:
   405 00000130 BAF701                  	mov	dx,IDESTTS
   406 00000133 EC                      	in	al,dx
   407 00000134 A880                    	test	al,80h				; BSY
   408 00000136 7413                    	jz	.9				; clear: ZF is already set
   409                                  
   410 00000138 268B0E6C00                  es	mov	cx,[timer_count_low]
   411 0000013D 29D9                    	sub	cx,bx
   412 0000013F 83F95A                  	cmp	cx,IDE_TIMEOUT
   413 00000142 72EC                    	jb	.1
   414                                  
   415 00000144 B90100                  	mov	cx,1
   416 00000147 09C9                    	or	cx,cx				; ZF clear -- timed out
   417 00000149 EB02                    	jmp	short .10
   418                                  .9:
   419 0000014B 31C9                    	xor	cx,cx				; ZF set -- ready
   420                                  .10:
   421 0000014D 5B595A07                        popm    bx,cx,dx,es
   422 00000151 C3                      	ret
   423                                  
   424                                  
   425                                  ;------------------------------------------------------------------------------
   426                                  ; ide_wait_drq -- wait for BSY clear and DRQ set
   427                                  ;
   428                                  ;  Exit with:
   429                                  ;       AL      the status register as read
   430                                  ;       ZF      set on success, clear on timeout or drive error
   431                                  ;       All other registers preserved
   432                                  ;
   433                                  ;  ERR is watched for as well as the timeout, so a drive that rejects the
   434                                  ;  command is noticed immediately instead of after five seconds.
   435                                  ;------------------------------------------------------------------------------
   436                                  ide_wait_drq:
   437 00000152 06525153                        pushm   bx,cx,dx,es
   438 00000156 6A4007                  	get_bda	ES
   439 00000159 268B1E6C00                  es	mov	bx,[timer_count_low]
   440                                  .1:
   441 0000015E BAF701                  	mov	dx,IDESTTS
   442 00000161 EC                      	in	al,dx
   443                                  
   444 00000162 A801                    	test	al,01h				; ERR -- do not wait it out
   445 00000164 7516                    	jnz	.8
   446                                  
   447 00000166 88C1                    	mov	cl,al
   448 00000168 80E188                  	and	cl,10001000b			; BSY and DRQ
   449 0000016B 80F908                  	cmp	cl,00001000b			; want BSY=0, DRQ=1
   450 0000016E 7413                    	je	.9
   451                                  
   452 00000170 268B0E6C00                  es	mov	cx,[timer_count_low]
   453 00000175 29D9                    	sub	cx,bx
   454 00000177 83F95A                  	cmp	cx,IDE_TIMEOUT
   455 0000017A 72E2                    	jb	.1
   456                                  .8:
   457 0000017C B90100                  	mov	cx,1
   458 0000017F 09C9                    	or	cx,cx				; ZF clear -- failed
   459 00000181 EB02                    	jmp	short .10
   460                                  .9:
   461 00000183 31C9                    	xor	cx,cx				; ZF set -- data is ready
   462                                  .10:
   463 00000185 5B595A07                        popm    bx,cx,dx,es
   464 00000189 C3                      	ret
   465                                  
   466                                  
   467                                  ;------------------------------------------------------------------------------
   468                                  ; ide_error -- turn the drive's status and error registers into a BIOS
   469                                  ;              status code, and record it where INT 13h fn 01h will find it
   470                                  ;
   471                                  ;  Exit with:
   472                                  ;       AX      the BIOS status code, never zero
   473                                  ;       bda.hd_status set to the same value
   474                                  ;       All other registers preserved
   475                                  ;
   476                                  ;  Every failure used to collapse to AX=-1, which gave INT 13h nothing to
   477                                  ;  report and DOS nothing to base a retry on.
   478                                  ;------------------------------------------------------------------------------
   479                                  ide_error:
   480 0000018A 06525153                	pushm	bx,cx,dx,es
   481                                  
   482 0000018E BAF701                  	mov	dx,IDESTTS
   483 00000191 EC                      	in	al,dx
   484 00000192 88C4                    	mov	ah,al				; keep the status register
   485                                  
   486 00000194 A880                    	test	al,80h				; still busy: it never answered
   487 00000196 7539                    	jnz	.timeout
   488 00000198 A801                    	test	al,01h				; no ERR either: we timed out
   489 0000019A 7435                    	jz	.timeout
   490                                  
   491 0000019C F6C420                  	test	ah,20h				; DF -- device fault
   492 0000019F 7404                    	jz	.decode
   493 000001A1 B3CC                    	mov	bl,WRITE_FAULT
   494 000001A3 EB2E                    	jmp	short .done
   495                                  
   496                                  .decode:
   497 000001A5 BAF101                  	mov	dx,IDEERR
   498 000001A8 EC                      	in	al,dx				; the error register
   499                                  
   500 000001A9 B30A                    	mov	bl,BAD_SECTOR_FLAG
   501 000001AB A880                    	test	al,80h				; BBK  bad block mark
   502 000001AD 7524                    	jnz	.done
   503 000001AF B310                    	mov	bl,BAD_CRC
   504 000001B1 A840                    	test	al,40h				; UNC  uncorrectable data
   505 000001B3 751E                    	jnz	.done
   506 000001B5 B304                    	mov	bl,SECTOR_NOT_FOUND
   507 000001B7 A810                    	test	al,10h				; IDNF sector id not found
   508 000001B9 7518                    	jnz	.done
   509 000001BB B301                    	mov	bl,INVALID_COMMAND
   510 000001BD A804                    	test	al,04h				; ABRT command aborted
   511 000001BF 7512                    	jnz	.done
   512 000001C1 B340                    	mov	bl,BAD_SEEK
