   298                                  ;
   299                                  ;
   300                                  ;-----------------------------------------------------------------------------
   301                                   		global 	IDE_INITIALIZE
   302                                   		global 	IDE_INITIALIZE_
   303                                  IDE_INITIALIZE:
   304                                  IDE_INITIALIZE_:
