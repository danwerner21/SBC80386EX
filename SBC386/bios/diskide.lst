   357 00000104 BAF101                  		mov	dx,IDEERR
   358 00000107 EE                      		out	dx,al
   359 00000108 B0EF                    		mov	al,IDE_CMD_SET_FEATURE
   360 0000010A BAF701                  		mov	dx,IDESTTS
   361 0000010D EE                      		out	dx,al
   362 0000010E E81300                  		call	ide_wait_not_busy		;make sure drive is ready
   363 00000111 7405                    		jz	.3
   364                                  .2:
   365 00000113 E87400                  		call	ide_error				; real status, not -1
   366 00000116 EB02                    		jmp	.9
   367                                  .3:
   368 00000118 31C0                            xor     ax,ax
   369                                  .9:
   370 0000011A 075B5F                          popm    es,bx,di
