    83                                  %include "macro.inc"
    84                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    85                              <1> ;
    86                              <1> ; some useful macros:
    87                              <1> ;
    88                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    89                              <1> %define NREPEAT 0
    90                              <1> 
    91                              <1> %if NREPEAT
    92                              <1> 
    93                              <1> %macro	rep	1
    94                              <1> %%loop:	%1
    95                              <1> 	dec	cx
    96                              <1> 	jnz	%%loop
    97                              <1> %endm
    98                              <1> 
    99                              <1> %macro	repne	1
   100                              <1> %%loop:	%1
   101                              <1> 	je	%%e
   102                              <1> 	dec	cx
   103                              <1> 	jnz	%%loop
   104                              <1> 	cmp	cx,1
   105                              <1> 	jmp	%%done
   106                              <1> %%e:	dec	cx
   107                              <1> 	cmp	cx,cx
   108                              <1> %%done:
   109                              <1> %endm
   110                              <1> 
   111                              <1> %macro	repe	1
   112                              <1> %%loop:	%1
   113                              <1> 	jne	%%ne
   114                              <1> 	dec	cx
   115                              <1> 	jnz	%%loop
   116                              <1> 	jmp	%%done
   117                              <1> %%ne:	dec	cx
   118                              <1> 	jcxz	%%cxz
   119                              <1> 	jmp	%%done
   120                              <1> %%cxz:	cmp	cx,1
   121                              <1> %%done:
   122                              <1> %endm
   123                              <1> 
   124                              <1> %macro	REP	1
   125                              <1> %%loop:	%1
   126                              <1> 	dec	ecx
   127                              <1> 	jnz	%%loop
   128                              <1> %endm
   129                              <1> 
   130                              <1> %macro	REPNE	1
   131                              <1> %%loop:	%1
   132                              <1> 	je	%%e
   133                              <1> 	dec	ecx
   134                              <1> 	jnz	%%loop
   135                              <1> 	cmp	cl,1
   136                              <1> 	jmp	%%done
   137                              <1> %%e:	dec	ecx
   138                              <1> 	cmp	cl,cl
   139                              <1> %%done:
   140                              <1> %endm
   141                              <1> 
   142                              <1> %macro	REPE	1
   143                              <1> %%loop:	%1
   144                              <1> 	jne	%%ne
   145                              <1> 	dec	ecx
   146                              <1> 	jnz	%%loop
   147                              <1> 	jmp	%%done
   148                              <1> %%ne:	dec	ecx
   149                              <1> 	jecxz	%%cxz
   150                              <1> 	jmp	%%done
   151                              <1> %%cxz:	cmp	cl,1
   152                              <1> %%done:
   153                              <1> %endm
   154                              <1> 
   155                              <1> %endif
   156                              <1> 
   157                              <1> 
   158                              <1> ;
   159                              <1> ; format of the BYTE initialization table:  address, byte
   160                              <1> ;
   161                              <1> %imacro  binit 2
   162                              <1>         dw      %1
   163                              <1>         db      %2
   164                              <1> %endmacro
   165                              <1> ; end with DW -1
   166                              <1> 
   167                              <1> ;
   168                              <1> ; format of the WORD initialization table:  address, word
   169                              <1> ;
   170                              <1> %imacro  winit 2
   171                              <1>         dw      %1
   172                              <1>         dw      %2
   173                              <1> %endmacro
   174                              <1> ; end with DW -1
   175                              <1> 
   176                              <1> 
   177                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   178                              <1> %imacro get_bda	1.nolist
   179                              <1> 	push	0x0040
   180                              <1> 	pop	%1
   181                              <1> 	cnop
   182                              <1> %endm
   183                              <1> 
   184                              <1> 
   185                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   186                              <1> %imacro	get_loc0 1.nolist
   187                              <1> 	push	0x0000
   188                              <1> 	pop	%1
   189                              <1> 	cnop
   190                              <1> %endm
   191                              <1> 
   192                              <1> 
   193                              <1> 
   194                              <1> %imacro setloc  1.nolist
   195                              <1>  times   (%1-($-$$)) db 0FFh
   196                              <1> %endm
   197                              <1> 
   198                              <1> %imacro db_lo   1
   199                              <1>  db (%1)&255
   200                              <1> %endm
   201                              <1> 
   202                              <1> %imacro cnop    0.nolist
   203                              <1> %ifdef SOFT_DEBUG
   204                              <1> %if SOFT_DEBUG
   205                              <1>         nop
   206                              <1> %endif
   207                              <1> %endif
   208                              <1> %endm
   209                              <1> 
   210                              <1> %imacro popm 1-*.nolist
   211                              <1> %rep %0
   212                              <1> %ifidni %1,ALL
   213                              <1>  popa
   214                              <1> %elifidni %1,F
   215                              <1>  popf
   216                              <1> %else
   217                              <1>  pop %1
   218                              <1> %ifidni %1,DS
   219                              <1>  cnop
   220                              <1> %elifidni %1,ES
   221                              <1>  cnop
   222                              <1> %elifidni %1,FS
   223                              <1>  cnop
   224                              <1> %elifidni %1,GS
   225                              <1>  cnop
   226                              <1> %endif
   227                              <1> %endif
   228                              <1> %rotate 1
   229                              <1> %endrep
   230                              <1> %endm
   231                              <1> 
   232                              <1> %imacro pushm 1-*.nolist
   233                              <1> %rep %0
   234                              <1> %rotate -1
   235                              <1> %ifidni %1,ALL
   236                              <1>  pusha
   237                              <1> %elifidni %1,F
   238                              <1>  pushf
   239                              <1> %else
   240                              <1>  push %1
   241                              <1> %endif
   242                              <1> %endrep
   243                              <1> %endm
   244                              <1> 
   245                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   246                              <1> %assign __size__ (%2-1)	| 0xFF
   247                              <1> %if (__size__ <= 0xFFFF)
   248                              <1> %assign __gran__ 0
   249                              <1> %else
   250                              <1> %assign __gran__ 0xC0			; G B 0 0
   251                              <1> %endif
   252                              <1> %assign __expand__ 0
   253                              <1> %if %0==3
   254                              <1> %if %3
   255                              <1> %assign __expand__ 4
   256                              <1> %endif
   257                              <1> %endif
   258                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   259                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   260                              <1> %endm
   261                              <1> 
   262                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   263                              <1> %assign __size__ (%2-1)	| 0xFF
   264                              <1> %if (__size__ <= 0xFFFF)
   265                              <1> %assign __gran__ 0
   266                              <1> %else
   267                              <1> %assign __gran__ 0xC0			; G D 0 0
   268                              <1> %endif
   269                              <1> %assign __conform__ 0
   270                              <1> %if %0==3
   271                              <1> %if %3
   272                              <1> %assign __conform__ 4
   273                              <1> %endif
   274                              <1> %endif
   275                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   276                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   277                              <1> %endm
   278                              <1> 
   279                              <1> ;/* End of macro.inc */
