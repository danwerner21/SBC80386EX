    93                                  ; -----------------------------------------------------------------------------
    94                                  ;  IDE_READ_SECTOR
    95                                  ; -----------------------------------------------------------------------------
    96                                  ; read a sector, specified by the 4 bytes in "lba",
    97                                  ; Return, acc is zero on success, non-zero for an error
    98                                  ;
    99                                  ;  int IDE_READ_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
   100                                  ;
   101                                  ;
   102                                  ;-----------------------------------------------------------------------------
   103                                          global  IDE_READ_SECTOR
   104                                          global  IDE_READ_SECTOR_
   105                                  IDE_READ_SECTOR:
   106                                  IDE_READ_SECTOR_:
   107 00000000 52                      		push 	DX
   108 00000001 53                      		push    BX
   109 00000002 51                      		push 	CX
   110 00000003 55                              push    bp
   111 00000004 89E5                            mov     bp,sp
   112 00000006 06                              push 	ES
   113 00000007 57                              push	DI
   114                                  
   115                                  ; Master/slave must be taken out of AL BEFORE the wait below:
   116                                  ;  ide_wait_not_busy returns the drive status in AL, so reading
   117                                  ;  the argument afterwards always yielded 0 -- the master.  BX
   118                                  ;  is preserved across the call.
   119 00000008 88C7                            mov     bh,al                   ; Master/slave INTO BH
   120 0000000A E80101                  		call	ide_wait_not_busy		; make sure drive is ready
   121 0000000D 7529                    		jnz	.2
   122                                  
   123 0000000F 8A5E0E                          mov     bl,ARG(6) 				; COUNT OF SECTORS
   124 00000012 8B560C                          mov     dx,ARG(5)
   125 00000015 8B460A                          mov     ax,ARG(4)
   126 00000018 E8EB01                  		call	wr_lba					; tell it which sector we want
   127                                  
   128 0000001B B020                            mov     al,IDE_CMD_PIO_READ
   129 0000001D BAF701                  		mov		dx,IDESTTS
   130 00000020 EE                      		out		dx,al
   131                                  
   132 00000021 8B4E0E                          mov     CX,ARG(6) 				; COUNT OF SECTORS
   133 00000024 8E4602                          mov     es,ARG(0) 				; high address INTO es
   134 00000027 8B5E04                          mov     bx,ARG(1)				; low address into bx
   135                                  .4:
   136                                  ; ATA raises DRQ once per sector during a multi-sector PIO transfer, so
   137                                  ; the wait belongs inside this loop.  Polled once before it, the second
   138                                  ; and later sectors ran ahead of the drive and desynchronised.
   139 0000002A E80F01                  		call	ide_wait_drq
   140 0000002D 7509                    		jnz	.2
   141 0000002F E8B201                  		call	read_data				; grab the data
   142 00000032 E2F6                    		loop	.4
   143                                  
   144 00000034 31C0                            xor     ax,ax
   145 00000036 EB03                    		jmp	.9
   146                                  .2:
   147 00000038 E83901                  		call	ide_error				; real status, not -1
   148                                  .9:
   149 0000003B 5F                         		POP 	DI
   150 0000003C 07                         		POP 	ES
   151 0000003D C9                              leave
   152 0000003E 59                              pop 	CX
   153 0000003F 5B                              pop 	BX
   154 00000040 5A                              pop 	DX
   155 00000041 C20600                          ret	6	; was 'ret', but Watcom proc must remove args!!!
   156                                  
