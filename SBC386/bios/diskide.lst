   309                                  
   310                                  
   311                                  
   312 000000D4 E83700                  		call	ide_wait_not_busy		; make sure drive is ready
   313 000000D7 7524                    		jnz	.2
   314                                  
   315 000000D9 B300                            mov     bl,0	 				; COUNT OF SECTORS TO READ INTO BL
   316 000000DB 8A7E02                          mov     bh,ARG(0) 				; Master/slave INTO BH
   317 000000DE B80000                          mov     ax,0
