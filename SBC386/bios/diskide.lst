    93                                  ;  IDE_READ_SECTOR
    94                                  ; -----------------------------------------------------------------------------
    95                                  ; read a sector, specified by the 4 bytes in "lba",
    96                                  ; Return, acc is zero on success, non-zero for an error
    97                                  ;
    98                                  ;  int IDE_READ_SECTOR(byte master_slave,byte far *buffer, dword sector_start,byte nsectors);
    99                                  ;
   100                                  ;
   101                                  ;-----------------------------------------------------------------------------
