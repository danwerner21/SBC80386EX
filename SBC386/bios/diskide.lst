   347                                  ;------------------------------------------------------------------------------
   348                                  ; IDE INTERNAL SUBROUTINES
   349                                  ;------------------------------------------------------------------------------
   350                                  ;-----------------------------------------------------------------------------
   351                                  ;  ide_wait_not_busy -- wait for BSY to clear
   352                                  ;
   353                                  ;  Exit with:
   354                                  ;       AL      the status register as read
   355                                  ;       ZF      set on success, clear on timeout
   356                                  ;       All other registers preserved
   357                                  ;
   358                                  ;  The old form of this spun on "mov cx,0FFFFh / loopnz", which is both
   359                                  ;  clock-dependent and far too short -- a few milliseconds at 20mhz, where
   360                                  ;  ATA allows seconds for a reset and a card can take hundreds of
   361                                  ;  milliseconds to come ready.  The 18.2hz BDA tick is used instead: it is
   362                                  ;  the only clock still running after POST, since start_timer0_ in
   363                                  ;  1Ah_time.asm gates counters 1 and 2 off.  A single word read of
   364                                  ;  timer_count_low cannot tear against IRQ0, and the unsigned subtraction
   365                                  ;  rides through the wrap.
   366                                  ;------------------------------------------------------------------------------
   367                                  IDE_TIMEOUT	equ	18*5		; five seconds, in 18.2hz ticks
   368                                  
   369                                  ide_wait_not_busy:
   370 0000010E 06525153                        pushm   bx,cx,dx,es
   371 00000112 6A4007                  	get_bda	ES
   372 00000115 268B1E6C00                  es	mov	bx,[timer_count_low]		; when we started
   373                                  .1:
   374 0000011A BAF701                  	mov	dx,IDESTTS
   375 0000011D EC                      	in	al,dx
   376 0000011E A880                    	test	al,80h				; BSY
   377 00000120 7413                    	jz	.9				; clear: ZF is already set
   378                                  
   379 00000122 268B0E6C00                  es	mov	cx,[timer_count_low]
   380 00000127 29D9                    	sub	cx,bx
   381 00000129 83F95A                  	cmp	cx,IDE_TIMEOUT
   382 0000012C 72EC                    	jb	.1
   383                                  
   384 0000012E B90100                  	mov	cx,1
   385 00000131 09C9                    	or	cx,cx				; ZF clear -- timed out
   386 00000133 EB02                    	jmp	short .10
   387                                  .9:
   388 00000135 31C9                    	xor	cx,cx				; ZF set -- ready
   389                                  .10:
   390 00000137 5B595A07                        popm    bx,cx,dx,es
   391 0000013B C3                      	ret
   392                                  
   393                                  
   394                                  ;------------------------------------------------------------------------------
   395                                  ; ide_wait_drq -- wait for BSY clear and DRQ set
   396                                  ;
   397                                  ;  Exit with:
   398                                  ;       AL      the status register as read
   399                                  ;       ZF      set on success, clear on timeout or drive error
   400                                  ;       All other registers preserved
   401                                  ;
   402                                  ;  ERR is watched for as well as the timeout, so a drive that rejects the
   403                                  ;  command is noticed immediately instead of after five seconds.
   404                                  ;------------------------------------------------------------------------------
   405                                  ide_wait_drq:
   406 0000013C 06525153                        pushm   bx,cx,dx,es
   407 00000140 6A4007                  	get_bda	ES
   408 00000143 268B1E6C00                  es	mov	bx,[timer_count_low]
   409                                  .1:
   410 00000148 BAF701                  	mov	dx,IDESTTS
   411 0000014B EC                      	in	al,dx
   412                                  
   413 0000014C A801                    	test	al,01h				; ERR -- do not wait it out
   414 0000014E 7516                    	jnz	.8
   415                                  
   416 00000150 88C1                    	mov	cl,al
   417 00000152 80E188                  	and	cl,10001000b			; BSY and DRQ
   418 00000155 80F908                  	cmp	cl,00001000b			; want BSY=0, DRQ=1
   419 00000158 7413                    	je	.9
   420                                  
   421 0000015A 268B0E6C00                  es	mov	cx,[timer_count_low]
   422 0000015F 29D9                    	sub	cx,bx
   423 00000161 83F95A                  	cmp	cx,IDE_TIMEOUT
   424 00000164 72E2                    	jb	.1
   425                                  .8:
   426 00000166 B90100                  	mov	cx,1
   427 00000169 09C9                    	or	cx,cx				; ZF clear -- failed
   428 0000016B EB02                    	jmp	short .10
   429                                  .9:
   430 0000016D 31C9                    	xor	cx,cx				; ZF set -- data is ready
   431                                  .10:
   432 0000016F 5B595A07                        popm    bx,cx,dx,es
   433 00000173 C3                      	ret
   434                                  
   435                                  
   436                                  ;------------------------------------------------------------------------------
   437                                  ; ide_error -- turn the drive's status and error registers into a BIOS
   438                                  ;              status code, and record it where INT 13h fn 01h will find it
   439                                  ;
   440                                  ;  Exit with:
   441                                  ;       AX      the BIOS status code, never zero
   442                                  ;       bda.hd_status set to the same value
   443                                  ;       All other registers preserved
   444                                  ;
   445                                  ;  Every failure used to collapse to AX=-1, which gave INT 13h nothing to
   446                                  ;  report and DOS nothing to base a retry on.
   447                                  ;------------------------------------------------------------------------------
   448                                  ide_error:
   449 00000174 06525153                	pushm	bx,cx,dx,es
   450                                  
   451 00000178 BAF701                  	mov	dx,IDESTTS
   452 0000017B EC                      	in	al,dx
   453 0000017C 88C4                    	mov	ah,al				; keep the status register
   454                                  
   455 0000017E A880                    	test	al,80h				; still busy: it never answered
   456 00000180 7539                    	jnz	.timeout
   457 00000182 A801                    	test	al,01h				; no ERR either: we timed out
   458 00000184 7435                    	jz	.timeout
   459                                  
   460 00000186 F6C420                  	test	ah,20h				; DF -- device fault
   461 00000189 7404                    	jz	.decode
   462 0000018B B3CC                    	mov	bl,WRITE_FAULT
   463 0000018D EB2E                    	jmp	short .done
   464                                  
   465                                  .decode:
   466 0000018F BAF101                  	mov	dx,IDEERR
   467 00000192 EC                      	in	al,dx				; the error register
   468                                  
   469 00000193 B30A                    	mov	bl,BAD_SECTOR_FLAG
   470 00000195 A880                    	test	al,80h				; BBK  bad block mark
   471 00000197 7524                    	jnz	.done
   472 00000199 B310                    	mov	bl,BAD_CRC
   473 0000019B A840                    	test	al,40h				; UNC  uncorrectable data
   474 0000019D 751E                    	jnz	.done
   475 0000019F B304                    	mov	bl,SECTOR_NOT_FOUND
   476 000001A1 A810                    	test	al,10h				; IDNF sector id not found
   477 000001A3 7518                    	jnz	.done
   478 000001A5 B301                    	mov	bl,INVALID_COMMAND
   479 000001A7 A804                    	test	al,04h				; ABRT command aborted
   480 000001A9 7512                    	jnz	.done
   481 000001AB B340                    	mov	bl,BAD_SEEK
   482 000001AD A802                    	test	al,02h				; TK0NF track 0 not found
   483 000001AF 750C                    	jnz	.done
   484 000001B1 B302                    	mov	bl,ADDRESS_MARK_NOT_FOUND
   485 000001B3 A801                    	test	al,01h				; AMNF
   486 000001B5 7506                    	jnz	.done
   487 000001B7 B3BB                    	mov	bl,UNDEFINED_ERROR
   488 000001B9 EB02                    	jmp	short .done
   489                                  
   490                                  .timeout:
   491 000001BB B380                    	mov	bl,TIME_OUT
   492                                  
   493                                  .done:
   494 000001BD 6A4007                  	get_bda	ES
   495 000001C0 26881E7400                  es	mov	[hd_status],bl			; INT 13h fn 01h reads this
   496 000001C5 0FB6C3                  	movzx	ax,bl
   497                                  
   498 000001C8 5B595A07                	popm	bx,cx,dx,es
   499 000001CC C3                      	ret
   500                                  
   501                                  ; Read a sector of 512 bytes into memory at ES:[BX]
   502                                  ;
   503                                  ;  Call with:
   504                                  ;       ES:BX -- pointer to the data block
   505                                  ;
   506                                  ;  Exit with:
   507                                  ;       AX and DX are destroyed; other registers preserved
   508                                  ;
   509                                  ; "BE" version is for ide id information
   510                                  ;-----------------------------------------------------------------------------
   511                                  read_dataBE:
   512 000001CD 5153                        pushm   bx,cx
   513 000001CF BAF001                  	mov		dx,IDEDTA
   514                                  
   515 000001D2 87FB                        xchg    di,bx
   516                                  
   517 000001D4 B90001                  	mov     cx,256          ; sector size in words
   518                                  rdblk2BE:
   519 000001D7 EC                      	in	al,dx
   520 000001D8 88C4                    	mov ah,al
   521 000001DA EC                      	in	al,dx
   522 000001DB AA                      	stosb
   523 000001DC 88E0                    	mov al,ah
   524 000001DE AA                      	stosb
   525 000001DF E2F6                        loop    rdblk2BE
   526 000001E1 5B59                        popm    bx,cx
   527 000001E3 C3                      	ret
   528                                  
   529                                  read_data:
   530 000001E4 51                          pushm   cx
   531 000001E5 BAF001                  	mov		dx,IDEDTA
   532 000001E8 87FB                        xchg    di,bx
   533 000001EA B90002                  	mov     cx,512          ; sector size in words
   534                                  rdblk2:
   535 000001ED EC                      	in	al,dx
   536 000001EE AA                      	stosb
   537 000001EF E2FC                        loop    rdblk2
   538 000001F1 87FB                        xchg    di,bx
   539 000001F3 59                          popm    cx
   540 000001F4 C3                      	ret
   541                                  
   542                                  ;------------------------------------------------------------------------------
   543                                  ; Write a sector of 512 bytes from memory at ES:[BX]
   544                                  ;
   545                                  ;  Call with:
   546                                  ;       ES:BX -- pointer to the data block
   547                                  ;
   548                                  ;  Exit with:
   549                                  ;       AX and DX are destroyed; other registers preserved
   550                                  ;
   551                                  ;-----------------------------------------------------------------------------
   552                                  write_data:
   553 000001F5 51                          pushm   cx
   554 000001F6 BAF001                  	mov		dx,IDEDTA
   555 000001F9 87F3                        xchg    si,bx
   556 000001FB B90002                  	mov     cx,512          ; sector size in words
   557                                  wtblk2:
   558 000001FE AC                      	lodsb
   559 000001FF EE                      	out	dx,al
   560 00000200 E2FC                        loop    wtblk2
   561 00000202 87F3                        xchg    si,bx
   562 00000204 59                          popm    cx
   563 00000205 C3                      	ret
   564                                  
   565                                  
   566                                  
   567                                  ;-----------------------------------------------------------------------------
   568                                  ; write the logical block address to the drive's registers
   569                                  ;
   570                                  ;  Call with:
   571                                  ;       DX:AX = logical block address
   572                                  ;		BH = Master/Slave selection in bit 4
   573                                  ;       BL = Sector read count
   574                                  ;
   575                                  ;  Exit with:
   576                                  ;       AX, BX, DX are destroyed
   577                                  ;
   578                                  ;-----------------------------------------------------------------------------
   579                                  wr_lba:
   580 00000206 51                      		push 	cx
   581 00000207 50                              push    ax
   582 00000208 52                              push    dx
   583 00000209 89D9                            mov 	CX,BX
   584                                  
   585 0000020B B010                            mov     al,10h          ; Master/Slave mask
   586 0000020D 20E8                            and     al,ch           ; mask bit
   587 0000020F 88F3                            mov     bl,dh           ; high order
   588 00000211 80E30F                          and     bl,00Fh
   589 00000214 80CBE0                          or      bl,0E0h         ; mark as LBA
   590                                  
   591 00000217 08D8                    		or		al,bl
   592 00000219 BAF601                  		mov		dx,IDEDRV
   593 0000021C EE                      		out		dx,al			; DRV
   594                                  
   595 0000021D 5B                              pop     bx              ; get DL to BL
   596                                  
   597 0000021E 88D8                    		mov		al,bl
   598 00000220 4A                      		dec		dx
   599 00000221 EE                      		out		dx,al			; LBA - H
   600                                  
   601 00000222 5B                              pop     bx
   602                                  
   603 00000223 88F8                    		mov		al,bh
   604 00000225 4A                      		dec		dx
   605 00000226 EE                      		out		dx,al			; LBA - M
   606                                  
   607 00000227 88D8                    		mov		al,bl
   608 00000229 4A                      		dec		dx
   609 0000022A EE                      		out		dx,al			; LBA - L
   610                                  
   611 0000022B 88C8                    		mov		al,cl
   612 0000022D 4A                      		dec		dx
   613 0000022E EE                      		out		dx,al 			; SET SECTOR COUNT
   614                                  
   615 0000022F 59                      		POP 	CX
   616 00000230 C3                      		ret
