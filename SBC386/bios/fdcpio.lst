    70                              <1> ;/* i386EX.inc  --  register definitions for the Intel 80386EX processor
    71                              <1> ;
    72                              <1> %define defb
    73                              <1> %define defw
    74                              <1> %define defd
    75                              <1> ;*/
    76                              <1> 
    77                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    78                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    79                              <1> ;*  first thing it does, so anything that restarts the board in software has
    80                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    81                              <1> ;*  hard way.
    82                              <1> ;*/
    83                              <1> defw    DEVICE_ID equ   0x2309
    84                              <1> 
    85                              <1> ;/* The Address Configuration register
    86                              <1> ;*/
    87                              <1> defb REMAPCFGH  equ     0x0023
    88                              <1> defb REMAPCFGL  equ     0x0022
    89                              <1> defw REMAPCFG   equ     0x0022
    90                              <1> 
    91                              <1> ;/* The A20gate and fast CPU Reset
    92                              <1> ;*/
    93                              <1> defb PORT92     equ     0xF092
    94                              <1> defb PORT92_AT  equ     0x0092
    95                              <1> 
    96                              <1> ;
    97                              <1> ;/* The DMA Controller and Bus Arbiter
    98                              <1> ;*/
    99                              <1> defb DMA0TAR    equ     0xF000
   100                              <1> defb DMA0TAR_AT equ     0x0000
   101                              <1> defb DMA0BYC    equ     0xF001
   102                              <1> defb DMA0BYC_AT equ     0x0001
   103                              <1> defb DMA1TAR    equ     0xF002
   104                              <1> defb DMA1TAR_AT equ     0x0002
   105                              <1> defb DMA1BYC    equ     0xF003
   106                              <1> defb DMA1BYC_AT equ     0x0003
   107                              <1> defb DMACMD1    equ     0xF008
   108                              <1> defb DMACMD1_AT equ     0x0008
   109                              <1> defb DMASTS     equ     0xF008
   110                              <1> defb DMASTS_AT  equ     0x0008
   111                              <1> defb DMASRR     equ     0xF009
   112                              <1> defb DMASRR_AT  equ     0x0009
   113                              <1> defb DMAMSK     equ     0xF00A
   114                              <1> defb DMAMSK_AT  equ     0x000A
   115                              <1> defb DMAMOD1    equ     0xF00B
   116                              <1> defb DMAMOD1_AT equ     0x000B
   117                              <1> defb DMACLRBP   equ     0xF00C
   118                              <1> defb DMACLRBP_AT equ    0x000C
   119                              <1> defb DMACLR     equ     0xF00D
   120                              <1> defb DMACLR_AT  equ     0x000D
   121                              <1> defb DMACLRMSK  equ     0xF00E
   122                              <1> defb DMACLRMSK_AT equ   0x000E
   123                              <1> defb DMAGRPMSK  equ     0xF00F
   124                              <1> defb DMAGRPMSK_AT equ   0x000F
   125                              <1> defb DMA0REQ0_1 equ     0xF010
   126                              <1> defb DMA0REQ2_3 equ     0xF011
   127                              <1> defb DMA1REQ0_1 equ     0xF012
   128                              <1> defb DMA1REQ2_3 equ     0xF013
   129                              <1> defb DMABSR     equ     0xF018
   130                              <1> defb DMACHR     equ     0xF019
   131                              <1> defb DMAIS      equ     0xF019
   132                              <1> defb DMACMD2    equ     0xF01A
   133                              <1> defb DMAMOD2    equ     0xF01B
   134                              <1> defb DMAIEN     equ     0xF01C
   135                              <1> defb DMAOVFE    equ     0xF01D
   136                              <1> defb DMACLRTC   equ     0xF01E
   137                              <1> ;
   138                              <1> ;/* The DMA Page Registers
   139                              <1> ;*/
