     9                                  ; it under the terms of the GNU General Public License as published by
    10                                  ; the Free Software Foundation, either version 3 of the License, or
    11                                  ; (at your option) any later version.
    12                                  ;
    13                                  ; This program is distributed in the hope that it will be useful,
    14                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                                  ; GNU General Public License for more details.
    17                                  ;
    18                                  ; You should have received a copy of the GNU General Public License
    19                                  ; along with this program in the file COPYING in the topmost source
    20                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    21                                  ;
    22                                  ;
    23                                  ; The floppy controller is an SMC FDC9266 on an ECB Disk I/O V3, reached at
    24                                  ; 0x430-0x43F -- Z80 I/O 30h-3Fh, which the 386EX sees at 0x400 + N.  There
    25                                  ; is no DMA on that board, so every byte of every sector passes through the
    26                                  ; CPU.  Only two things here need to be assembly; the rest of the driver is
    27                                  ; C, in "diskfdc.c".
    28                                  ;
    29                                  ;   the data phase	because a byte not collected within 16 microseconds
    30                                  ;			is an overrun, and a C loop through io_read() has
    31                                  ;			neither the speed nor the control over interrupts
    32                                  ;
    33                                  ;   FDC_stop_motor	because int_irq0 calls it having saved only BX, CX
    34                                  ;			and DS.  Anything it disturbs beyond those three
    35                                  ;			corrupts whatever the tick interrupted.
    36                                  ;
    37                                  ; Assembly by NASM 2.08 is preferred
    38                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    39                                  %include "seg_def.inc"
    40                              <1> ; SEG_DEF.inc
    41                              <1> ;
    42                              <1> %ifndef SEG_DEF
    43                              <1> %define SEG_DEF 1
    44                              <1> 
    45                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    46                              <1> 
    47                              <1> segment CONST		align=16	class=DATA	public
    48                              <1> segment CONST2		align=2		class=DATA	public
    49                              <1> segment _DATA		align=16	class=DATA	public
    50                              <1> segment _BSS		align=16	class=DATA	public
    51                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    52                              <1> 
    53                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    54                              <1> 
    55                              <1> 
    56                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    57                              <1> 
    58                              <1> %define XXX
    59                              <1> %endif
    60                              <1> ;
    61                              <1> ; end SEG_DEF.inc
    40                                  %include "i386ex.inc"
