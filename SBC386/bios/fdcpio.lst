    95 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
    96                              <1> ; */
    97                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
    98 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
    99 0000006E ????                <1> timer_count_high	resw	1
   100                              <1> %define timer_count timer_count_low
