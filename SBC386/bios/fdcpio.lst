   214                              <1> defw    CS1MSKH equ     0xF40E
   215                              <1> defw    CS2ADL  equ     0xF410
   216                              <1> defw    CS2ADH  equ     0xF412
   217                              <1> defw    CS2MSKL equ     0xF414
   218                              <1> defw    CS2MSKH equ     0xF416
   219                              <1> defw    CS3ADL  equ     0xF418
   220                              <1> defw    CS3ADH  equ     0xF41A
   221                              <1> defw    CS3MSKL equ     0xF41C
   222                              <1> defw    CS3MSKH equ     0xF41E
   223                              <1> defw    CS4ADL  equ     0xF420
   224                              <1> defw    CS4ADH  equ     0xF422
   225                              <1> defw    CS4MSKL equ     0xF424
   226                              <1> defw    CS4MSKH equ     0xF426
   227                              <1> defw    CS5ADL  equ     0xF428
   228                              <1> defw    CS5ADH  equ     0xF42A
   229                              <1> defw    CS5MSKL equ     0xF42C
   230                              <1> defw    CS5MSKH equ     0xF42E
   231                              <1> defw    CS6ADL  equ     0xF430
   232                              <1> defw    CS6ADH  equ     0xF432
   233                              <1> defw    CS6MSKL equ     0xF434
   234                              <1> defw    CS6MSKH equ     0xF436
   235                              <1> defw    UCSADL  equ     0xF438
   236                              <1> defw    UCSADH  equ     0xF43A
   237                              <1> defw    UCSMSKL equ     0xF43C
   238                              <1> defw    UCSMSKH equ     0xF43E
