    41                                  %include "macro.inc"
    42                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    43                              <1> ;
    44                              <1> ; some useful macros:
    45                              <1> ;
    46                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    47                              <1> %define NREPEAT 0
    48                              <1> 
    49                              <1> %if NREPEAT
    50                              <1> 
    51                              <1> %macro	rep	1
    52                              <1> %%loop:	%1
    53                              <1> 	dec	cx
    54                              <1> 	jnz	%%loop
    55                              <1> %endm
    56                              <1> 
    57                              <1> %macro	repne	1
    58                              <1> %%loop:	%1
    59                              <1> 	je	%%e
    60                              <1> 	dec	cx
    61                              <1> 	jnz	%%loop
    62                              <1> 	cmp	cx,1
    63                              <1> 	jmp	%%done
    64                              <1> %%e:	dec	cx
    65                              <1> 	cmp	cx,cx
    66                              <1> %%done:
    67                              <1> %endm
    68                              <1> 
    69                              <1> %macro	repe	1
    70                              <1> %%loop:	%1
    71                              <1> 	jne	%%ne
    72                              <1> 	dec	cx
    73                              <1> 	jnz	%%loop
    74                              <1> 	jmp	%%done
    75                              <1> %%ne:	dec	cx
    76                              <1> 	jcxz	%%cxz
    77                              <1> 	jmp	%%done
    78                              <1> %%cxz:	cmp	cx,1
    79                              <1> %%done:
    80                              <1> %endm
    81                              <1> 
    82                              <1> %macro	REP	1
    83                              <1> %%loop:	%1
    84                              <1> 	dec	ecx
    85                              <1> 	jnz	%%loop
    86                              <1> %endm
    87                              <1> 
    88                              <1> %macro	REPNE	1
    89                              <1> %%loop:	%1
    90                              <1> 	je	%%e
    91                              <1> 	dec	ecx
    92                              <1> 	jnz	%%loop
    93                              <1> 	cmp	cl,1
    94                              <1> 	jmp	%%done
    95                              <1> %%e:	dec	ecx
    96                              <1> 	cmp	cl,cl
    97                              <1> %%done:
    98                              <1> %endm
    99                              <1> 
   100                              <1> %macro	REPE	1
   101                              <1> %%loop:	%1
   102                              <1> 	jne	%%ne
   103                              <1> 	dec	ecx
   104                              <1> 	jnz	%%loop
   105                              <1> 	jmp	%%done
   106                              <1> %%ne:	dec	ecx
   107                              <1> 	jecxz	%%cxz
   108                              <1> 	jmp	%%done
   109                              <1> %%cxz:	cmp	cl,1
   110                              <1> %%done:
   111                              <1> %endm
   112                              <1> 
   113                              <1> %endif
   114                              <1> 
