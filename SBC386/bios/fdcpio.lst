   191                              <1> 
   192                              <1> ;
   193                              <1> ;/* The Timer/Counter Unit
   194                              <1> ;*/
   195                              <1> defb    TMR0    equ     0xF040
   196                              <1> defb    TMR0_AT equ     0x0040
