   184          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    43                                  
    44                                  FDC_LATCH	equ	0x438		; the 74LS273, write only
    45                                  FDC_MOTOR	equ	0x02		; its motor bit
    46                                  
    47                                  	global	_fdc_pio_in
    48                                  	global	_fdc_pio_out
    49                                  	global	FDC_stop_motor
    50                                  	global	FDC_stop_motor_
    51                                  
    52                                  segment	_TEXT
    53                                  
    54                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    55                                  ; fdc_pio_in -- the data phase of a read
    56                                  ; fdc_pio_out -- the data phase of a write
    57                                  ;
    58                                  ;	int fdc_pio_in (word base, byte far *buf, word count);
    59                                  ;	int fdc_pio_out(word base, byte far *buf, word count);
    60                                  ;
    61                                  ;	0	all of it moved
    62                                  ;	1	the controller stopped asking before the count ran out
    63                                  ;	2	it stopped answering altogether
    64                                  ;
    65                                  ; At 500 kbps a byte arrives every 16 microseconds, and one not collected
    66                                  ; before the next arrives is an overrun -- a silently corrupt sector, which
    67                                  ; reads as bad media rather than as bad timing.  On the way out an underrun
    68                                  ; is worse still: it damages what is on the disk, and no amount of re-reading
    69                                  ; recovers it.  So the burst runs with interrupts off.  The IRQ4 console
    70                                  ; handler saves nine registers, reads two ports, runs kbd_stuff and drains
    71                                  ; again if a second character is waiting -- plausibly 8 to 15 microseconds
    72                                  ; for one and past the budget for two.  It cannot land inside a sector.
    73                                  ;
    74                                  ; But only the burst, not the wait before it.  After the command is accepted
    75                                  ; the controller sits out the rotational latency until the wanted sector
    76                                  ; comes round, and that is up to a full revolution: 200ms at 300 rpm.
    77                                  ; Interrupts off for that long would cost the 18.2hz tick several counts,
    78                                  ; because a latched IRQ0 collapses however many periods it was held through
    79                                  ; into one interrupt, and the clock would lose time on every access.  The
    80                                  ; first byte is therefore waited for with interrupts as the caller left them,
    81                                  ; and CLI happens only once that byte is sitting in the data register.  The
    82                                  ; one exposure left -- an interrupt taken between seeing RQM and reaching
    83                                  ; CLI -- has the same 16 microseconds of slack to be absorbed in.
    84                                  ;
    85                                  ; MSR is matched three bits at a time, and EXEC belongs in the mask:
    86                                  ;
    87                                  ;	E0	RQM, DIO set, EXEC	the read data phase wants collecting
    88                                  ;	A0	RQM, DIO clear, EXEC	the write data phase wants feeding
    89                                  ;	C0	RQM, DIO set, no EXEC	the result phase: the command ended
    90                                  ;	80	RQM, DIO clear, no EXEC	the command phase, not yet handed over
    91                                  ;
    92                                  ; 80 and C0 are the pair that must not be confused with each other or with
    93                                  ; the data phases.  Testing EXEC alone cannot tell "not started" from
    94                                  ; "finished", and masking it away entirely lets a result-phase read pull
    95                                  ; sector data out of the data register and call it status.  Both of those
    96                                  ; were real, and both looked like hardware faults.
    97                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    98                                  
    99                                  _fdc_pio_in:
   100 00000000 55                      	push	bp
   101 00000001 89E5                    	mov	bp,sp
   102 00000003 83EC02                  	sub	sp,2			; [bp-2] is the result
   103 00000006 061E5756525153          	pushm	bx,cx,dx,si,di,ds,es
   104                                  
   105 0000000D C746FE0200              	mov	word [bp-2],2		; assume it never answers
   106 00000012 8B5604                  	mov	dx,[bp+4]		; the main status register
   107 00000015 C47E06                  	les	di,[bp+6]		; ES:DI -> the caller's buffer
   108 00000018 8B4E0A                  	mov	cx,[bp+10]
   109 0000001B FC                      	cld
   110 0000001C E34E                    	jcxz	.ok
   111                                  
   112 0000001E 66BB40420F00            	mov	ebx,1000000		; about a second: a revolution is 200ms
   113                                  .wait1:
   114 00000024 EC                      	in	al,dx
   115 00000025 24E0                    	and	al,0xE0
   116 00000027 3CE0                    	cmp	al,0xE0			; a byte to collect
   117 00000029 740A                    	je	.burst
   118 0000002B 3CC0                    	cmp	al,0xC0			; result phase: ended without data
   119 0000002D 7436                    	je	.short
   120 0000002F 664B                    	dec	ebx
   121 00000031 75F1                    	jnz	.wait1
   122 00000033 EB3C                    	jmp	.9
   123                                  
   124                                  .burst:
   125 00000035 9C                      	pushf
   126 00000036 FA                      	cli
   127                                  .next:
   128 00000037 42                      	inc	dx
   129 00000038 EC                      	in	al,dx
   130 00000039 4A                      	dec	dx
   131 0000003A AA                      	stosb
   132 0000003B 49                      	dec	cx
   133 0000003C 741F                    	jz	.done
   134                                  
   135 0000003E BB0000                  	mov	bx,0			; ~65k tries, far longer than 16us
   136                                  .wait:
   137 00000041 EC                      	in	al,dx
   138 00000042 24E0                    	and	al,0xE0
   139 00000044 3CE0                    	cmp	al,0xE0
   140 00000046 74EF                    	je	.next
   141 00000048 3CC0                    	cmp	al,0xC0
   142 0000004A 740A                    	je	.cut
   143 0000004C 4B                      	dec	bx
   144 0000004D 75F2                    	jnz	.wait
   145 0000004F C746FE0200              	mov	word [bp-2],2
   146 00000054 EB0C                    	jmp	short .out
   147                                  .cut:
   148 00000056 C746FE0100              	mov	word [bp-2],1
   149 0000005B EB05                    	jmp	short .out
   150                                  .done:
   151 0000005D C746FE0000              	mov	word [bp-2],0
   152                                  .out:
   153 00000062 9D                      	popf
   154 00000063 EB0C                    	jmp	short .9
   155                                  .short:
   156 00000065 C746FE0100              	mov	word [bp-2],1
   157 0000006A EB05                    	jmp	short .9
   158                                  .ok:
   159 0000006C C746FE0000              	mov	word [bp-2],0
   160                                  .9:
   161 00000071 5B595A5E5F1F07          	popm	bx,cx,dx,si,di,ds,es
   162 00000078 8B46FE                  	mov	ax,[bp-2]
   163 0000007B 89EC                    	mov	sp,bp
   164 0000007D 5D                      	pop	bp
   165 0000007E C3                      	ret
   166                                  
   167                                  
   168                                  _fdc_pio_out:
   169 0000007F 55                      	push	bp
   170 00000080 89E5                    	mov	bp,sp
   171 00000082 83EC02                  	sub	sp,2
   172 00000085 061E5756525153          	pushm	bx,cx,dx,si,di,ds,es
   173                                  
   174 0000008C C746FE0200              	mov	word [bp-2],2
   175 00000091 8B5604                  	mov	dx,[bp+4]
   176 00000094 C57606                  	lds	si,[bp+6]		; DS:SI -> the caller's buffer.  DS,
   177                                  					;  not ES: the direction differs and
   178                                  					;  so does the segment register
   179 00000097 8B4E0A                  	mov	cx,[bp+10]
   180 0000009A FC                      	cld
   181 0000009B E34E                    	jcxz	.ok
   182                                  
   183 0000009D 66BB40420F00            	mov	ebx,1000000
   184                                  .wait1:
   185 000000A3 EC                      	in	al,dx
   186 000000A4 24E0                    	and	al,0xE0
   187 000000A6 3CA0                    	cmp	al,0xA0			; wants a byte fed to it
   188 000000A8 740A                    	je	.burst
   189 000000AA 3CC0                    	cmp	al,0xC0
   190 000000AC 7436                    	je	.short
   191 000000AE 664B                    	dec	ebx
   192 000000B0 75F1                    	jnz	.wait1
   193 000000B2 EB3C                    	jmp	.9
   194                                  
   195                                  .burst:
   196 000000B4 9C                      	pushf
   197 000000B5 FA                      	cli
   198                                  .next:
   199 000000B6 AC                      	lodsb
   200 000000B7 42                      	inc	dx
   201 000000B8 EE                      	out	dx,al
   202 000000B9 4A                      	dec	dx
   203 000000BA 49                      	dec	cx
   204 000000BB 741F                    	jz	.done
   205                                  
   206 000000BD BB0000                  	mov	bx,0
   207                                  .wait:
   208 000000C0 EC                      	in	al,dx
   209 000000C1 24E0                    	and	al,0xE0
   210 000000C3 3CA0                    	cmp	al,0xA0
   211 000000C5 74EF                    	je	.next
   212 000000C7 3CC0                    	cmp	al,0xC0
   213 000000C9 740A                    	je	.cut
   214 000000CB 4B                      	dec	bx
   215 000000CC 75F2                    	jnz	.wait
   216 000000CE C746FE0200              	mov	word [bp-2],2
   217 000000D3 EB0C                    	jmp	short .out
   218                                  .cut:
   219 000000D5 C746FE0100              	mov	word [bp-2],1
   220 000000DA EB05                    	jmp	short .out
   221                                  .done:
   222 000000DC C746FE0000              	mov	word [bp-2],0
   223                                  .out:
   224 000000E1 9D                      	popf
   225 000000E2 EB0C                    	jmp	short .9
   226                                  .short:
   227 000000E4 C746FE0100              	mov	word [bp-2],1
   228 000000E9 EB05                    	jmp	short .9
   229                                  .ok:
   230 000000EB C746FE0000              	mov	word [bp-2],0
   231                                  .9:
