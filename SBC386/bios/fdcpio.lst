   238                                  
   239                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   240                                  ; FDC_stop_motor -- the motor timeout, called from the 18.2hz tick
   241                                  ;
   242                                  ; int_irq0 counts bda.motor_count down and calls this when it reaches zero.
   243                                  ; That call arrives having saved only BX, CX and DS, so everything else this
   244                                  ; touches has to be put back -- a driver that quietly corrupted DX or ES here
   245                                  ; would break whatever the tick happened to interrupt, which is to say
   246                                  ; anything at all, intermittently.
   247                                  ;
   248                                  ; The latch is a 74LS273 and cannot be read, so the motor bit is cleared in
   249                                  ; the shadow at bda.motor_status and the whole byte written back.  Losing
   250                                  ; track of that shadow means losing the drive select, the data rate and the
   251                                  ; reset line along with the motor.
   252                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   253                                  FDC_stop_motor:
   254                                  FDC_stop_motor_:
   255 000000FE 1E5250                  	pushm	ax,dx,ds
   256 00000101 9C                      	pushf
   257                                  
   258 00000102 6A401F                  	get_bda	DS
   259 00000105 A03F00                  	mov	al,[motor_status]
   260 00000108 24FD                    	and	al,~FDC_MOTOR		; motor off, everything else kept
   261 0000010A A23F00                  	mov	[motor_status],al
   262                                  
   263 0000010D BA3804                  	mov	dx,FDC_LATCH
   264 00000110 EE                      	out	dx,al
   265                                  
   266 00000111 9D                      	popf
   267 00000112 585A1F                  	popm	ax,dx,ds
   268 00000115 C3                      	ret
