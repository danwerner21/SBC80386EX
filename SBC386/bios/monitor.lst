    24                                  %include "seg_def.inc"
    25                              <1> ; SEG_DEF.inc
    26                              <1> ;
    27                              <1> %ifndef SEG_DEF
    28                              <1> %define SEG_DEF 1
    29                              <1> 
    30                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    31                              <1> 
    32                              <1> segment CONST		align=16	class=DATA	public
    33                              <1> segment CONST2		align=2		class=DATA	public
    34                              <1> segment _DATA		align=16	class=DATA	public
    35                              <1> segment _BSS		align=16	class=DATA	public
    36                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    37                              <1> 
    38                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    39                              <1> 
    40                              <1> 
    41                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    42                              <1> 
    43                              <1> %define XXX
    44                              <1> %endif
    45                              <1> ;
    46                              <1> ; end SEG_DEF.inc
