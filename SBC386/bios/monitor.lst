    26                                  %include "macro.inc"
    27                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    28                              <1> ;
    29                              <1> ; some useful macros:
    30                              <1> ;
    31                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    32                              <1> %define NREPEAT 0
    33                              <1> 
    34                              <1> %if NREPEAT
    35                              <1> 
    36                              <1> %macro	rep	1
    37                              <1> %%loop:	%1
    38                              <1> 	dec	cx
    39                              <1> 	jnz	%%loop
    40                              <1> %endm
    41                              <1> 
    42                              <1> %macro	repne	1
    43                              <1> %%loop:	%1
    44                              <1> 	je	%%e
    45                              <1> 	dec	cx
    46                              <1> 	jnz	%%loop
    47                              <1> 	cmp	cx,1
    48                              <1> 	jmp	%%done
    49                              <1> %%e:	dec	cx
    50                              <1> 	cmp	cx,cx
    51                              <1> %%done:
    52                              <1> %endm
    53                              <1> 
    54                              <1> %macro	repe	1
    55                              <1> %%loop:	%1
    56                              <1> 	jne	%%ne
    57                              <1> 	dec	cx
    58                              <1> 	jnz	%%loop
    59                              <1> 	jmp	%%done
    60                              <1> %%ne:	dec	cx
    61                              <1> 	jcxz	%%cxz
    62                              <1> 	jmp	%%done
    63                              <1> %%cxz:	cmp	cx,1
    64                              <1> %%done:
    65                              <1> %endm
    66                              <1> 
    67                              <1> %macro	REP	1
    68                              <1> %%loop:	%1
    69                              <1> 	dec	ecx
    70                              <1> 	jnz	%%loop
    71                              <1> %endm
    72                              <1> 
    73                              <1> %macro	REPNE	1
    74                              <1> %%loop:	%1
    75                              <1> 	je	%%e
    76                              <1> 	dec	ecx
    77                              <1> 	jnz	%%loop
    78                              <1> 	cmp	cl,1
    79                              <1> 	jmp	%%done
    80                              <1> %%e:	dec	ecx
    81                              <1> 	cmp	cl,cl
    82                              <1> %%done:
    83                              <1> %endm
    84                              <1> 
    85                              <1> %macro	REPE	1
    86                              <1> %%loop:	%1
    87                              <1> 	jne	%%ne
    88                              <1> 	dec	ecx
    89                              <1> 	jnz	%%loop
    90                              <1> 	jmp	%%done
    91                              <1> %%ne:	dec	ecx
    92                              <1> 	jecxz	%%cxz
    93                              <1> 	jmp	%%done
    94                              <1> %%cxz:	cmp	cl,1
    95                              <1> %%done:
    96                              <1> %endm
    97                              <1> 
    98                              <1> %endif
    99                              <1> 
   100                              <1> 
   101                              <1> ;
   102                              <1> ; format of the BYTE initialization table:  address, byte
   103                              <1> ;
   104                              <1> %imacro  binit 2
   105                              <1>         dw      %1
   106                              <1>         db      %2
   107                              <1> %endmacro
   108                              <1> ; end with DW -1
   109                              <1> 
   110                              <1> ;
   111                              <1> ; format of the WORD initialization table:  address, word
   112                              <1> ;
   113                              <1> %imacro  winit 2
   114                              <1>         dw      %1
   115                              <1>         dw      %2
   116                              <1> %endmacro
   117                              <1> ; end with DW -1
   118                              <1> 
   119                              <1> 
   120                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   121                              <1> %imacro get_bda	1.nolist
   122                              <1> 	push	0x0040
   123                              <1> 	pop	%1
   124                              <1> 	cnop
   125                              <1> %endm
   126                              <1> 
   127                              <1> 
   128                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   129                              <1> %imacro	get_loc0 1.nolist
   130                              <1> 	push	0x0000
   131                              <1> 	pop	%1
   132                              <1> 	cnop
   133                              <1> %endm
   134                              <1> 
   135                              <1> 
   136                              <1> 
   137                              <1> %imacro setloc  1.nolist
   138                              <1>  times   (%1-($-$$)) db 0FFh
   139                              <1> %endm
   140                              <1> 
   141                              <1> %imacro db_lo   1
   142                              <1>  db (%1)&255
   143                              <1> %endm
   144                              <1> 
   145                              <1> %imacro cnop    0.nolist
   146                              <1> %ifdef SOFT_DEBUG
   147                              <1> %if SOFT_DEBUG
   148                              <1>         nop
   149                              <1> %endif
   150                              <1> %endif
   151                              <1> %endm
   152                              <1> 
   153                              <1> %imacro popm 1-*.nolist
   154                              <1> %rep %0
   155                              <1> %ifidni %1,ALL
   156                              <1>  popa
   157                              <1> %elifidni %1,F
   158                              <1>  popf
   159                              <1> %else
   160                              <1>  pop %1
   161                              <1> %ifidni %1,DS
   162                              <1>  cnop
   163                              <1> %elifidni %1,ES
   164                              <1>  cnop
   165                              <1> %elifidni %1,FS
   166                              <1>  cnop
   167                              <1> %elifidni %1,GS
   168                              <1>  cnop
   169                              <1> %endif
   170                              <1> %endif
   171                              <1> %rotate 1
   172                              <1> %endrep
   173                              <1> %endm
   174                              <1> 
   175                              <1> %imacro pushm 1-*.nolist
   176                              <1> %rep %0
   177                              <1> %rotate -1
   178                              <1> %ifidni %1,ALL
   179                              <1>  pusha
   180                              <1> %elifidni %1,F
   181                              <1>  pushf
   182                              <1> %else
   183                              <1>  push %1
   184                              <1> %endif
   185                              <1> %endrep
   186                              <1> %endm
   187                              <1> 
   188                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   189                              <1> %assign __size__ (%2-1)	| 0xFF
   190                              <1> %if (__size__ <= 0xFFFF)
   191                              <1> %assign __gran__ 0
   192                              <1> %else
   193                              <1> %assign __gran__ 0xC0			; G B 0 0
   194                              <1> %endif
   195                              <1> %assign __expand__ 0
   196                              <1> %if %0==3
   197                              <1> %if %3
   198                              <1> %assign __expand__ 4
   199                              <1> %endif
   200                              <1> %endif
   201                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   202                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   203                              <1> %endm
   204                              <1> 
   205                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   206                              <1> %assign __size__ (%2-1)	| 0xFF
   207                              <1> %if (__size__ <= 0xFFFF)
   208                              <1> %assign __gran__ 0
   209                              <1> %else
   210                              <1> %assign __gran__ 0xC0			; G D 0 0
   211                              <1> %endif
   212                              <1> %assign __conform__ 0
   213                              <1> %if %0==3
   214                              <1> %if %3
   215                              <1> %assign __conform__ 4
   216                              <1> %endif
   217                              <1> %endif
   218                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   219                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   220                              <1> %endm
   221                              <1> 
   222                              <1> ;/* End of macro.inc */
    27                                  
    28                                  segment	_TEXT
    29                                  
    30                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    31                                  ; go_call -- FAR CALL an arbitrary Real Mode address, for the GO command
    32                                  ;
    33                                  ;	void __cdecl go_call(word seg, word off, T_REGS *regs);
    34                                  ;
    35                                  ; The register values in *regs are loaded before the call and written
    36                                  ; back from whatever the callee left behind, so GO can both set up a
    37                                  ; call and report what came out of it.
    38                                  ;
    39                                  ; A far CALL is used rather than a far JMP, so the target comes back to
    40                                  ; the monitor with a RETF.  A target that returns with IRET, or that
    41                                  ; leaves the stack unbalanced, will not find its way home.
    42                                  ;
    43                                  ; The callee is trusted for SS:SP and nothing else.  BP is re-formed
    44                                  ; from SP after the call because the callee is free to trash it.
    45                                  ;
    46                                  ;    Enter with (__cdecl -- arguments on the stack, caller cleans up):
    47                                  ;	[bp+4]	target segment
    48                                  ;	[bp+6]	target offset
    49                                  ;	[bp+8]	regs offset
    50                                  ;	[bp+10]	regs segment
    51                                  ;
    52                                  ;    T_REGS layout, in words:
    53                                  ;	+0 AX	+2 BX	+4 CX	+6 DX
    54                                  ;	+8 SI	+10 DI	+12 DS	+14 ES	+16 FLAGS
    55                                  ;
    56                                  ;    Exit with:
    57                                  ;	*regs updated, all of the monitor's own registers preserved
    58                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    59                                  	global	_go_call
    60                                  _go_call:
    61 00000000 55                      	push	bp
    62 00000001 89E5                    	mov	bp,sp
    63 00000003 061E575652515350        	pushm	ax,bx,cx,dx,si,di,ds,es		; SP is now BP-16
    64                                  
    65 0000000B 83EC04                  	sub	sp,4				; SP is now BP-20
    66 0000000E 8B4606                  	mov	ax,[bp+6]			; stage the far target where
    67 00000011 8946EC                  	mov	[bp-20],ax			;  CALL FAR can reach it with
    68 00000014 8B4604                  	mov	ax,[bp+4]			;  a BP-relative address
    69 00000017 8946EE                  	mov	[bp-18],ax
    70                                  
    71                                  ; Load the entry values.  DS and ES travel through the stack because
    72                                  ; T_REGS is addressed through ES:DI right up to the last moment.
    73 0000001A C47E08                  	les	di,[bp+8]			; ES:DI -> T_REGS
    74 0000001D 26FF750E                	push	word [es:di+14]			; ES for the callee
    75 00000021 26FF750C                	push	word [es:di+12]			; DS for the callee
    76 00000025 268B05                  	mov	ax,[es:di+0]
    77 00000028 268B5D02                	mov	bx,[es:di+2]
    78 0000002C 268B4D04                	mov	cx,[es:di+4]
    79 00000030 268B5506                	mov	dx,[es:di+6]
    80 00000034 268B7508                	mov	si,[es:di+8]
    81 00000038 268B7D0A                	mov	di,[es:di+10]			; DI last: it held the pointer
    82 0000003C 1F                      	pop	ds
    83 0000003D 07                      	pop	es				; SP is back to BP-20
    84                                  
    85 0000003E FF5EEC                  	call	far [bp-20]			; *** into the unknown ***
    86                                  
    87                                  ; Capture what came back.  PUSHF is first because nothing between the
    88                                  ; call and it may disturb the flags.
    89 00000041 9C                      	pushf
    90 00000042 50                      	push	ax
    91 00000043 53                      	push	bx
    92 00000044 51                      	push	cx
    93 00000045 52                      	push	dx
    94 00000046 56                      	push	si
    95 00000047 57                      	push	di
    96 00000048 1E                      	push	ds
    97 00000049 06                      	push	es
    98                                  
    99                                  ; Re-form BP.  A RETF with a balanced stack leaves SP at BP-20, and the
   100                                  ; nine words just pushed put it at BP-38.
   101 0000004A 89E5                    	mov	bp,sp
   102 0000004C 83C526                  	add	bp,38
   103                                  
   104 0000004F C47E08                  	les	di,[bp+8]			; ES:DI -> T_REGS again
   105 00000052 268F450E                	pop	word [es:di+14]			; ES	(pushed last)
   106 00000056 268F450C                	pop	word [es:di+12]			; DS
   107 0000005A 268F450A                	pop	word [es:di+10]			; DI
   108 0000005E 268F4508                	pop	word [es:di+8]			; SI
   109 00000062 268F4506                	pop	word [es:di+6]			; DX
   110 00000066 268F4504                	pop	word [es:di+4]			; CX
   111 0000006A 268F4502                	pop	word [es:di+2]			; BX
   112 0000006E 268F05                  	pop	word [es:di+0]			; AX
   113 00000071 268F4510                	pop	word [es:di+16]			; FLAGS
   114                                  
   115 00000075 83C404                  	add	sp,4				; drop the staged far target
   116 00000078 585B595A5E5F1F07        	popm	ax,bx,cx,dx,si,di,ds,es
   117 00000080 5D                      	pop	bp
   118 00000081 C3                      	ret			; __cdecl -- caller pops the arguments
