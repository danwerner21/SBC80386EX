   408                              <1> defb	MSR_deltaDSR	equ	BIT1
   409                              <1> defb	MSR_deltaCTS	equ	BIT0
   410                              <1> 
   411                              <1> ;/* Bits in CR0
   412                              <1> ;*/
   413                              <1> defb    CR0_PE  equ     BIT0
   414                              <1> defb    CR0_MP  equ     BIT1
   415                              <1> defb    CR0_EM  equ     BIT2
   416                              <1> defb    CR0_TS  equ     BIT3
   417                              <1> defd    CR0_WP  equ     BIT16
   418                              <1> defd    CR0_PG  equ     BIT31
   419                              <1> 
   420                              <1> ;/* Some ASCII character codes
   421                              <1> ;*/
   422                              <1> defb    ASCII_NUL       equ     0x00
   423                              <1> defb    ASCII_BS        equ     0x08
   424                              <1> defb    ASCII_HT        equ     0x09
   425                              <1> defb    ASCII_LF        equ     0x0A
   426                              <1> defb    ASCII_NL        equ     0x0A
   427                              <1> defb    ASCII_FF        equ     0x0C
   428                              <1> defb    ASCII_CR        equ     0x0D
   429                              <1> defb	ASCII_ESC	equ	0x1B
   430                              <1> defb    ASCII_SP        equ     0x20
   431                              <1> defb    ASCII_DEL       equ     0x7F
   432                              <1> defb	ASCII_RUB	equ	0xFF
