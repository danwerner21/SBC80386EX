   163                              <1> defb OCW3S_AT   equ     0x00A0
   164                              <1> defb IRR_M_AT	equ	0x00A0
   165                              <1> 
   166                              <1> defb ICW1S      equ     0xF0A0
   167                              <1> defb ICW2S      equ     0xF0A1
   168                              <1> defb ICW3S      equ     0xF0A1
   169                              <1> defb ICW4S      equ     0xF0A1
