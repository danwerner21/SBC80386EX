   204                              <1> defw    CS3MSKH equ     0xF41E
   205                              <1> defw    CS4ADL  equ     0xF420
   206                              <1> defw    CS4ADH  equ     0xF422
   207                              <1> defw    CS4MSKL equ     0xF424
   208                              <1> defw    CS4MSKH equ     0xF426
   209                              <1> defw    CS5ADL  equ     0xF428
   210                              <1> defw    CS5ADH  equ     0xF42A
   211                              <1> defw    CS5MSKL equ     0xF42C
   212                              <1> defw    CS5MSKH equ     0xF42E
   213                              <1> defw    CS6ADL  equ     0xF430
   214                              <1> defw    CS6ADH  equ     0xF432
   215                              <1> defw    CS6MSKL equ     0xF434
   216                              <1> defw    CS6MSKH equ     0xF436
   217                              <1> defw    UCSADL  equ     0xF438
   218                              <1> defw    UCSADH  equ     0xF43A
   219                              <1> defw    UCSMSKL equ     0xF43C
   220                              <1> defw    UCSMSKH equ     0xF43E
   221                              <1> 
   222                              <1> ;
   223                              <1> ;/* The Synchronous Serial I/O Unit
   224                              <1> ;*/
   225                              <1> defw    SSIOTBUF equ    0xF480
   226                              <1> defw    SSIORBUF equ    0xF482
   227                              <1> defw    SSIOBAUD equ    0xF484
   228                              <1> defw    SSIOCON1 equ    0xF486
   229                              <1> defw    SSIOCON2 equ    0xF488
   230                              <1> defw    SSIOCTR  equ    0xF48A
   231                              <1> 
   232                              <1> ;
   233                              <1> ;/* The Refresh Control Unit
   234                              <1> ;*/
