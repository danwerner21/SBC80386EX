   410                              <1> defb	MSR_CTS	equ	BIT4
   411                              <1> defb	MSR_deltaDCD	equ	BIT3
   412                              <1> defb	MSR_deltaRI	equ	BIT2
   413                              <1> defb	MSR_deltaDSR	equ	BIT1
   414                              <1> defb	MSR_deltaCTS	equ	BIT0
   415                              <1> 
   416                              <1> ;/* Bits in CR0
   417                              <1> ;*/
   418                              <1> defb    CR0_PE  equ     BIT0
   419                              <1> defb    CR0_MP  equ     BIT1
   420                              <1> defb    CR0_EM  equ     BIT2
   421                              <1> defb    CR0_TS  equ     BIT3
   422                              <1> defd    CR0_WP  equ     BIT16
   423                              <1> defd    CR0_PG  equ     BIT31
   424                              <1> 
   425                              <1> ;/* Some ASCII character codes
   426                              <1> ;*/
   427                              <1> defb    ASCII_NUL       equ     0x00
   428                              <1> defb    ASCII_BS        equ     0x08
   429                              <1> defb    ASCII_HT        equ     0x09
   430                              <1> defb    ASCII_LF        equ     0x0A
   431                              <1> defb    ASCII_NL        equ     0x0A
   432                              <1> defb    ASCII_FF        equ     0x0C
   433                              <1> defb    ASCII_CR        equ     0x0D
   434                              <1> defb	ASCII_ESC	equ	0x1B
   435                              <1> defb    ASCII_SP        equ     0x20
   436                              <1> defb    ASCII_DEL       equ     0x7F
   437                              <1> defb	ASCII_RUB	equ	0xFF
   438                              <1> 
   439                              <1> 
   440                              <1> ;/* End of i386EX.inc */
    31                                  ;%include "bda.inc"
    32                                  %include "macro.inc"
    33                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    34                              <1> ;
    35                              <1> ; some useful macros:
    36                              <1> ;
    37                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    38                              <1> %define NREPEAT 0
    39                              <1> 
    40                              <1> %if NREPEAT
    41                              <1> 
    42                              <1> %macro	rep	1
    43                              <1> %%loop:	%1
    44                              <1> 	dec	cx
    45                              <1> 	jnz	%%loop
    46                              <1> %endm
    47                              <1> 
    48                              <1> %macro	repne	1
    49                              <1> %%loop:	%1
    50                              <1> 	je	%%e
    51                              <1> 	dec	cx
    52                              <1> 	jnz	%%loop
    53                              <1> 	cmp	cx,1
    54                              <1> 	jmp	%%done
    55                              <1> %%e:	dec	cx
    56                              <1> 	cmp	cx,cx
    57                              <1> %%done:
    58                              <1> %endm
    59                              <1> 
    60                              <1> %macro	repe	1
    61                              <1> %%loop:	%1
    62                              <1> 	jne	%%ne
    63                              <1> 	dec	cx
    64                              <1> 	jnz	%%loop
    65                              <1> 	jmp	%%done
    66                              <1> %%ne:	dec	cx
    67                              <1> 	jcxz	%%cxz
    68                              <1> 	jmp	%%done
    69                              <1> %%cxz:	cmp	cx,1
    70                              <1> %%done:
    71                              <1> %endm
    72                              <1> 
    73                              <1> %macro	REP	1
    74                              <1> %%loop:	%1
    75                              <1> 	dec	ecx
    76                              <1> 	jnz	%%loop
    77                              <1> %endm
    78                              <1> 
    79                              <1> %macro	REPNE	1
    80                              <1> %%loop:	%1
    81                              <1> 	je	%%e
    82                              <1> 	dec	ecx
    83                              <1> 	jnz	%%loop
    84                              <1> 	cmp	cl,1
    85                              <1> 	jmp	%%done
    86                              <1> %%e:	dec	ecx
    87                              <1> 	cmp	cl,cl
    88                              <1> %%done:
    89                              <1> %endm
    90                              <1> 
    91                              <1> %macro	REPE	1
    92                              <1> %%loop:	%1
    93                              <1> 	jne	%%ne
    94                              <1> 	dec	ecx
    95                              <1> 	jnz	%%loop
    96                              <1> 	jmp	%%done
    97                              <1> %%ne:	dec	ecx
    98                              <1> 	jecxz	%%cxz
    99                              <1> 	jmp	%%done
   100                              <1> %%cxz:	cmp	cl,1
   101                              <1> %%done:
   102                              <1> %endm
   103                              <1> 
   104                              <1> %endif
   105                              <1> 
   106                              <1> 
   107                              <1> ;
   108                              <1> ; format of the BYTE initialization table:  address, byte
   109                              <1> ;
   110                              <1> %imacro  binit 2
   111                              <1>         dw      %1
   112                              <1>         db      %2
   113                              <1> %endmacro
   114                              <1> ; end with DW -1
   115                              <1> 
   116                              <1> ;
   117                              <1> ; format of the WORD initialization table:  address, word
   118                              <1> ;
   119                              <1> %imacro  winit 2
   120                              <1>         dw      %1
   121                              <1>         dw      %2
   122                              <1> %endmacro
   123                              <1> ; end with DW -1
   124                              <1> 
   125                              <1> 
   126                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   127                              <1> %imacro get_bda	1.nolist
   128                              <1> 	push	0x0040
   129                              <1> 	pop	%1
   130                              <1> 	cnop
   131                              <1> %endm
   132                              <1> 
   133                              <1> 
   134                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   135                              <1> %imacro	get_loc0 1.nolist
   136                              <1> 	push	0x0000
   137                              <1> 	pop	%1
   138                              <1> 	cnop
   139                              <1> %endm
   140                              <1> 
   141                              <1> 
   142                              <1> 
   143                              <1> %imacro setloc  1.nolist
   144                              <1>  times   (%1-($-$$)) db 0FFh
   145                              <1> %endm
   146                              <1> 
   147                              <1> %imacro db_lo   1
   148                              <1>  db (%1)&255
   149                              <1> %endm
   150                              <1> 
   151                              <1> %imacro cnop    0.nolist
   152                              <1> %ifdef SOFT_DEBUG
   153                              <1> %if SOFT_DEBUG
   154                              <1>         nop
   155                              <1> %endif
   156                              <1> %endif
   157                              <1> %endm
   158                              <1> 
   159                              <1> %imacro popm 1-*.nolist
   160                              <1> %rep %0
   161                              <1> %ifidni %1,ALL
   162                              <1>  popa
   163                              <1> %elifidni %1,F
   164                              <1>  popf
   165                              <1> %else
   166                              <1>  pop %1
   167                              <1> %ifidni %1,DS
   168                              <1>  cnop
   169                              <1> %elifidni %1,ES
   170                              <1>  cnop
   171                              <1> %elifidni %1,FS
   172                              <1>  cnop
   173                              <1> %elifidni %1,GS
   174                              <1>  cnop
   175                              <1> %endif
   176                              <1> %endif
   177                              <1> %rotate 1
   178                              <1> %endrep
   179                              <1> %endm
   180                              <1> 
   181                              <1> %imacro pushm 1-*.nolist
   182                              <1> %rep %0
   183                              <1> %rotate -1
   184                              <1> %ifidni %1,ALL
   185                              <1>  pusha
   186                              <1> %elifidni %1,F
   187                              <1>  pushf
   188                              <1> %else
   189                              <1>  push %1
   190                              <1> %endif
   191                              <1> %endrep
   192                              <1> %endm
   193                              <1> 
   194                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   195                              <1> %assign __size__ (%2-1)	| 0xFF
   196                              <1> %if (__size__ <= 0xFFFF)
   197                              <1> %assign __gran__ 0
   198                              <1> %else
   199                              <1> %assign __gran__ 0xC0			; G B 0 0
   200                              <1> %endif
   201                              <1> %assign __expand__ 0
   202                              <1> %if %0==3
   203                              <1> %if %3
   204                              <1> %assign __expand__ 4
   205                              <1> %endif
   206                              <1> %endif
   207                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   208                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   209                              <1> %endm
   210                              <1> 
   211                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   212                              <1> %assign __size__ (%2-1)	| 0xFF
   213                              <1> %if (__size__ <= 0xFFFF)
   214                              <1> %assign __gran__ 0
   215                              <1> %else
   216                              <1> %assign __gran__ 0xC0			; G D 0 0
   217                              <1> %endif
   218                              <1> %assign __conform__ 0
   219                              <1> %if %0==3
   220                              <1> %if %3
   221                              <1> %assign __conform__ 4
   222                              <1> %endif
   223                              <1> %endif
   224                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   225                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   226                              <1> %endm
   227                              <1> 
   228                              <1> ;/* End of macro.inc */
    33                                  
    34                                  
    35                                  segment CONST
    36                                  
    37                                  PM_GDT	equ	0x000F_0000 + gdt0
    38                                  	global	gdt0
    39                                  ;
    40                                  ; now the Global Descriptor Table prototype
    41                                  ;
    42                                  	align	16
    43 00000000 0000000000000000        gdt0:	dq	0		; null descriptor
    44                                  rom_gdt:
    45                                  descr08	equ	$-gdt0
    46 00000008 6F00                    	dw	len_gdt-1
    47 0000000A [00000F00]              	dd	PM_GDT
    48 0000000E 0000                    	dw	0		; filler
    49                                  descrP	equ	descr08
    50                                  
    51                                  
    52                                  descr10	equ	$-gdt0
    53 00000010 0000000000000000        	dq	0		; LDT filler
    54                                  
    55                                  
    56                                  descr18	equ	$-gdt0
    57 00000018 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
    58                                  descr_DS	equ	descr18
    59                                  
    60                                  
    61                                  descr20	equ	$-gdt0
    62 00000020 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
    63                                  descr_ES	equ	descr20
    64                                  
    65                                  
    66                                  descr28	equ	$-gdt0
    67 00000028 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
    68                                  descr_SS	equ	descr28
    69                                  
    70                                  
    71                                  descr30	equ	$-gdt0
    72 00000030 FFFF0000009BCF00        	descr_linear_code	0, 0x03FF_FFFF	; 64meg DRAM
    73                                  descr_CS	equ	descr30
    74                                  
    75                                  
    76                                  descr38	equ	$-gdt0
    77 00000038 FFFF00000F9B0000        	descr_linear_code	0xF0000, 0xFFFF ; 64K code (286)
    78                                  descr_BIOS	equ	descr38
    79                                  
    80                                  
    81                                  descr40	equ	$-gdt0
    82 00000040 FF02000400930000        	descr_linear_data	0x400, 0x300	; BIOS data area
    83                                  descr_BDA equ	descr40
    84                                  
    85                                  
    86                                  descr48	equ	$-gdt0
    87 00000048 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
    88                                  descr_FS	equ	descr48
    89                                  
    90                                  
    91                                  descr50	equ	$-gdt0
    92 00000050 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
    93                                  descr_GS	equ	descr50
    94                                  
    95                                  
    96                                  descr58	equ	$-gdt0
    97 00000058 FFFF000000930000        	descr_linear_data	0, 0xFFFF	; 64K return Data segment
    98                                  descr_RMdata	equ	descr58
    99                                  
   100                                  
   101                                  descr60	equ	$-gdt0
   102 00000060 FFFF00000F9B0000        	descr_linear_code	0x000F0000, 0xFFFF	; 64K return Code segment
   103                                  descr_RMcode	equ	descr60
   104                                  
   105                                  
   106                                  descr68	equ	$-gdt0
   107 00000068 FFFF00000F9BC100        	descr_linear_code	0xF0000, 0x1FFFF ; 128K code
   108                                  descr_BIOS32	equ	descr68
   109                                  
   110                                  
   111                                  len_gdt		equ	$-gdt0
   112                                  
   113                                  
   114                                  
   115                                  segment	_TEXT
   116                                  
   117                                  	bits	16
   118                                  
   119                                  	global	ext_mem_size
   120                                  ;
   121                                  ; enter protected mode to size Extended memory
   122                                  ;
   123                                  ext_mem_size:
   124 00000000 0F0116[0800]            	lgdt	[rom_gdt]	; use ROM version of GDT
   125                                  ;
   126                                  ; set the PE bit to switch into Protected Mode
   127                                  ;
   128 00000005 0F20C3                  	mov	ebx,cr0			; get CR0 to set Prot Mode
   129 00000008 80CB01                  	or	bl,1			; set PE bit
   130 0000000B 66F7E0                  	mul	eax	;time waster for prefetch queue
   131 0000000E 0F22C3                  	mov	cr0,ebx			; enter protected mode
   132                                  ; now in protected mode, but no segment registers are set
   133 00000011 EA[1600]6800            	jmp	descr_BIOS32:pm_continue
   134                                  
   135                                  	bits	32
   136                                  pm_continue:
   137 00000016 66BAFF04                	mov	dx,0x4FF
   138 0000001A B0F0                    	mov	al,0xF0
   139 0000001C EE                      	out	dx,al
   140                                  ;;;	hlt
   141                                  
   142 0000001D 66B81800                	mov	ax,descr_DS		; set DS descriptor
   143 00000021 8ED8                    	mov	ds,ax			; **
   144                                  
   145                                  ;	xor	ebx,ebx
   146                                  ;	xor	ebp,ebp
   147                                  ; stack value saves
   148                                  ;	mov	bx,ss
   149                                  ;	mov	esi,ebx			; save SS
   150                                  ;	mov	bp,sp			; save SP
   151                                  ;
   152                                  ;	shl	ebx,4			; account for
   153                                  ;	add	ebx,ebp			; new linear stack pointer
   154                                  ;
   155                                  ;	mov	ss,ax			; linear Stack
   156                                  ;	mov	esp,ebx			; set stack
   157                                  
   158                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   159                                  ;  __pm_sizeMem -- size Memory in Megabytes
   160                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   161                                  
   162 00000023 31C0                    	xor	eax,eax		; DO  I=0 TO 63
   163 00000025 8B10                    	mov	edx,[eax]	;save location [00000]
   164                                  __pm_size1:
   165 00000027 89C7                    	mov	edi,eax
   166 00000029 C1E714                  	shl	edi,20		; address Megabytes (2**20)
   167 0000002C 8907                    	mov	[edi],eax	; store the number 0..63
   168 0000002E FEC0                    	inc	al
   169 00000030 3C40                    	cmp	al,64		; 64mb limit
   170 00000032 72F3                    	jb	__pm_size1
   171                                  
   172 00000034 2B0500000000            	sub	eax,[0]		; get memory size in megabytes
   173 0000003A 891500000000            	mov	[0],edx		;restore location [00000]
   174 00000040 89C2                    	mov	edx,eax		; answer in EDX
   175                                  
   176                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   177                                  ; now return to Real Mode
   178                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   179                                  return_to_real:
   180 00000042 66B85800                	mov	ax,descr_RMdata		; 64K segment at 0x00000000
   181 00000046 8ED8                    	mov	ds,ax
   182                                  ;;;	jmp	$+2	; clear prefetch queue
   183 00000048 EA[4F000000]6000        	jmp	descr_RMcode:real_return
   184                                  real_return:
   185                                  	bits	16
   186                                  
   187 0000004F 0F20C0                  	mov	eax,cr0		;
   188 00000052 24FE                    	and	al,0xFE		; turn off PE bit
   189 00000054 0F22C0                  	mov	cr0,eax
   190 00000057 EA[5C00]00F0            	jmp	0xF000:really_return
   191                                  ;	jmp	far really_return
   192                                  really_return:
   193 0000005C B8[ssss]                	mov	ax,DGROUP
   194 0000005F 8ED8                    	mov	ds,ax
   195                                  ; the segment registers below were never touched in Protected Mode
   196                                  ;	mov	es,ax
   197                                  ;	mov	fs,ax
   198                                  ;	mov	gs,ax
   199                                  
   200                                  ; EDX is size in MB
   201 00000061 89D0                    	mov	ax,dx
   202 00000063 C3                      	ret
