    48                              <1> ; SEG_DEF.inc
    49                              <1> ;
    50                              <1> %ifndef SEG_DEF
    51                              <1> %define SEG_DEF 1
    52                              <1> 
    53                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    54                              <1> 
    55                              <1> segment CONST		align=16	class=DATA	public
    56                              <1> segment CONST2		align=2		class=DATA	public
    57                              <1> segment _DATA		align=16	class=DATA	public
    58                              <1> segment _BSS		align=16	class=DATA	public
    59                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    60                              <1> 
    61                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    62                              <1> 
    63                              <1> 
    64                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    65                              <1> 
    66                              <1> %define XXX
    67                              <1> %endif
    68                              <1> ;
    69                              <1> ; end SEG_DEF.inc
