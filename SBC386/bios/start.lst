    49                                  %include "macro.inc"
    50                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    51                              <1> ;
    52                              <1> ; some useful macros:
    53                              <1> ;
    54                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    55                              <1> %define NREPEAT 0
    56                              <1> 
    57                              <1> %if NREPEAT
    58                              <1> 
    59                              <1> %macro	rep	1
    60                              <1> %%loop:	%1
    61                              <1> 	dec	cx
    62                              <1> 	jnz	%%loop
    63                              <1> %endm
    64                              <1> 
    65                              <1> %macro	repne	1
    66                              <1> %%loop:	%1
    67                              <1> 	je	%%e
    68                              <1> 	dec	cx
    69                              <1> 	jnz	%%loop
    70                              <1> 	cmp	cx,1
    71                              <1> 	jmp	%%done
    72                              <1> %%e:	dec	cx
    73                              <1> 	cmp	cx,cx
    74                              <1> %%done:
    75                              <1> %endm
    76                              <1> 
    77                              <1> %macro	repe	1
    78                              <1> %%loop:	%1
    79                              <1> 	jne	%%ne
    80                              <1> 	dec	cx
    81                              <1> 	jnz	%%loop
    82                              <1> 	jmp	%%done
    83                              <1> %%ne:	dec	cx
    84                              <1> 	jcxz	%%cxz
    85                              <1> 	jmp	%%done
    86                              <1> %%cxz:	cmp	cx,1
    87                              <1> %%done:
    88                              <1> %endm
    89                              <1> 
    90                              <1> %macro	REP	1
    91                              <1> %%loop:	%1
    92                              <1> 	dec	ecx
    93                              <1> 	jnz	%%loop
    94                              <1> %endm
    95                              <1> 
    96                              <1> %macro	REPNE	1
    97                              <1> %%loop:	%1
    98                              <1> 	je	%%e
    99                              <1> 	dec	ecx
   100                              <1> 	jnz	%%loop
   101                              <1> 	cmp	cl,1
   102                              <1> 	jmp	%%done
   103                              <1> %%e:	dec	ecx
   104                              <1> 	cmp	cl,cl
   105                              <1> %%done:
   106                              <1> %endm
   107                              <1> 
   108                              <1> %macro	REPE	1
   109                              <1> %%loop:	%1
   110                              <1> 	jne	%%ne
   111                              <1> 	dec	ecx
   112                              <1> 	jnz	%%loop
   113                              <1> 	jmp	%%done
   114                              <1> %%ne:	dec	ecx
   115                              <1> 	jecxz	%%cxz
   116                              <1> 	jmp	%%done
   117                              <1> %%cxz:	cmp	cl,1
   118                              <1> %%done:
   119                              <1> %endm
   120                              <1> 
   121                              <1> %endif
   122                              <1> 
   123                              <1> 
   124                              <1> ;
   125                              <1> ; format of the BYTE initialization table:  address, byte
   126                              <1> ;
   127                              <1> %imacro  binit 2
   128                              <1>         dw      %1
   129                              <1>         db      %2
   130                              <1> %endmacro
   131                              <1> ; end with DW -1
   132                              <1> 
   133                              <1> ;
   134                              <1> ; format of the WORD initialization table:  address, word
   135                              <1> ;
   136                              <1> %imacro  winit 2
   137                              <1>         dw      %1
   138                              <1>         dw      %2
   139                              <1> %endmacro
   140                              <1> ; end with DW -1
   141                              <1> 
   142                              <1> 
   143                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   144                              <1> %imacro get_bda	1.nolist
   145                              <1> 	push	0x0040
   146                              <1> 	pop	%1
   147                              <1> 	cnop
   148                              <1> %endm
   149                              <1> 
   150                              <1> 
   151                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   152                              <1> %imacro	get_loc0 1.nolist
   153                              <1> 	push	0x0000
   154                              <1> 	pop	%1
   155                              <1> 	cnop
   156                              <1> %endm
   157                              <1> 
   158                              <1> 
   159                              <1> 
   160                              <1> %imacro setloc  1.nolist
   161                              <1>  times   (%1-($-$$)) db 0FFh
   162                              <1> %endm
   163                              <1> 
   164                              <1> %imacro db_lo   1
   165                              <1>  db (%1)&255
   166                              <1> %endm
   167                              <1> 
   168                              <1> %imacro cnop    0.nolist
   169                              <1> %ifdef SOFT_DEBUG
   170                              <1> %if SOFT_DEBUG
   171                              <1>         nop
   172                              <1> %endif
   173                              <1> %endif
   174                              <1> %endm
   175                              <1> 
   176                              <1> %imacro popm 1-*.nolist
   177                              <1> %rep %0
   178                              <1> %ifidni %1,ALL
   179                              <1>  popa
   180                              <1> %elifidni %1,F
   181                              <1>  popf
   182                              <1> %else
   183                              <1>  pop %1
   184                              <1> %ifidni %1,DS
   185                              <1>  cnop
   186                              <1> %elifidni %1,ES
   187                              <1>  cnop
   188                              <1> %elifidni %1,FS
   189                              <1>  cnop
   190                              <1> %elifidni %1,GS
   191                              <1>  cnop
   192                              <1> %endif
   193                              <1> %endif
   194                              <1> %rotate 1
   195                              <1> %endrep
   196                              <1> %endm
   197                              <1> 
   198                              <1> %imacro pushm 1-*.nolist
   199                              <1> %rep %0
   200                              <1> %rotate -1
   201                              <1> %ifidni %1,ALL
   202                              <1>  pusha
   203                              <1> %elifidni %1,F
   204                              <1>  pushf
   205                              <1> %else
   206                              <1>  push %1
   207                              <1> %endif
   208                              <1> %endrep
   209                              <1> %endm
   210                              <1> 
   211                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   212                              <1> %assign __size__ (%2-1)	| 0xFF
   213                              <1> %if (__size__ <= 0xFFFF)
   214                              <1> %assign __gran__ 0
   215                              <1> %else
   216                              <1> %assign __gran__ 0xC0			; G B 0 0
   217                              <1> %endif
   218                              <1> %assign __expand__ 0
   219                              <1> %if %0==3
   220                              <1> %if %3
   221                              <1> %assign __expand__ 4
   222                              <1> %endif
   223                              <1> %endif
   224                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   225                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   226                              <1> %endm
   227                              <1> 
   228                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   229                              <1> %assign __size__ (%2-1)	| 0xFF
   230                              <1> %if (__size__ <= 0xFFFF)
   231                              <1> %assign __gran__ 0
   232                              <1> %else
   233                              <1> %assign __gran__ 0xC0			; G D 0 0
   234                              <1> %endif
   235                              <1> %assign __conform__ 0
   236                              <1> %if %0==3
   237                              <1> %if %3
   238                              <1> %assign __conform__ 4
   239                              <1> %endif
   240                              <1> %endif
   241                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   242                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   243                              <1> %endm
   244                              <1> 
   245                              <1> ;/* End of macro.inc */
