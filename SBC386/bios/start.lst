   147 00000128 00F4                <1>  dw %1
   148 0000012A 0700                <1>  dw %2
   261                                  	winit	CS0MSKH, ~(0x00FF00 >> 6) & 0xFFFF
   147 0000012C 06F4                <1>  dw %1
   148 0000012E 03FC                <1>  dw %2
   262                                  	winit	CS0MSKL, ~(0x00FF00 <<10) & 0xF800 | BIT10+BIT0
   147 00000130 04F4                <1>  dw %1
   148 00000132 01FC                <1>  dw %2
   263                                  ;
   264                                  ; set up CS1# for the IDE I/O at 01F0..01FF	-- ZBIT0 disables it
   265                                  ;
   266                                  ; 7 wait states, not the 3 this carried for years.  3 was never measured;
   267                                  ; 7 was, from the monitor -- C007 written into CS1ADL by hand, then a full
   268                                  ; pass of IDENT, LBA and SECTEST against the card with no change in
   269                                  ; behaviour except that it stopped being marginal.  It matches what CS0
   270                                  ; already uses for the ECB I/O window, and the IDE path is nowhere near
   271                                  ; fast enough for four extra wait states per byte to matter: the transfer
   272                                  ; is 8-bit PIO through a single port either way.
   273                                  	winit	CS1ADH, (0x1F0 >> 6) & 0xFFFF
   147 00000134 0AF4                <1>  dw %1
   148 00000136 0700                <1>  dw %2
   274                                  	winit	CS1ADL, (0x1F0 <<10) & 0xFFFF | ZBIT9+ZBIT8 + ZBIT7+ 7;w.s.
   147 00000138 08F4                <1>  dw %1
   148 0000013A 07C0                <1>  dw %2
   275                                  	winit	CS1MSKH, ~(0x00FFF0 >> 6) & 0xFFFF
   147 0000013C 0EF4                <1>  dw %1
   148 0000013E 00FC                <1>  dw %2
   276                                  	winit	CS1MSKL, ~(0x00FFF0 <<10) & 0xF800 | BIT10+ BIT0
   147 00000140 0CF4                <1>  dw %1
   148 00000142 013C                <1>  dw %2
