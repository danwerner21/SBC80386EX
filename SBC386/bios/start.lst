   392                                  ;
   393                                  NVRAM00:
   394 00000201 E700                    	dw	00_0000_00111_00_1_11B		;serial line
   395                                  ; no protocols, rsvd, baud=9600, no parity, 2 stop, 8-bit
   396                                  
