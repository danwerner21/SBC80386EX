   400                                  ;
   401                                  NVRAM00:
   402 00000201 E700                    	dw	00_0000_00111_00_1_11B		;serial line
   403                                  ; no protocols, rsvd, baud=9600, no parity, 2 stop, 8-bit
   404                                  
   405 00000203 0000                    	db	0,0		; 2 empty floppy slots
   406 00000205 0000000000000000        	db	0,0,0,0,0,0,0,0	; 8 empty disk table slots
   407 0000020D 00<rep 13h>             	times (NVRAM00+31-$) db 0
