   778                                  ;
   779                                  ; Test memory from 1000:0000h to 7000:FFFFh
   780                                  ;
   781                                  ; The size this arrives at has to be the same either way, since it is what
   782                                  ; reaches bda.memory_size: the loop below ends with AX one segment past the
   783                                  ; last one tested, and the warm path just starts there.
