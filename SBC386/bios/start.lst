   748                                  
   749                                  
   750 00000155 B002                    	mov	al,0010b	; show '0010' in the LITES
   751 00000157 E8C001                  	call	lites
   752                                  
   753                                  ;
   754                                  ; Test memory from 1000:0000h to 7000:FFFFh
   755                                  ;
   756                                  ; The size this arrives at has to be the same either way, since it is what
   757                                  ; reaches bda.memory_size: the loop below ends with AX one segment past the
   758                                  ; last one tested, and the warm path just starts there.
   759                                  %if HALF_MEM
   760                                  LAST_SEG	equ	0x8000
   761                                  %else
   762                                  LAST_SEG	equ	0xA000
   763                                  %endif
   764                                  
   765                                  test_1to8:
   766 0000015A 36A10400                    ss	mov	ax,[WARM_MARK]
   767 0000015E 3D3412                  	cmp	ax,WARM_BOOT
   768 00000161 750E                    	jne	.cold
   769                                  
   770                                  ; A warm start.  This memory was marched over on the way in and has not
   771                                  ; been without power since, so the march buys nothing but the time it
   772                                  ; takes -- and it takes seconds, not milliseconds: seg_test walks a single
   773                                  ; bit through all 32 positions, so each 64K segment costs 32 passes of a
   774                                  ; REP STOSD and a REPE SCASD, and there are nine segments.
   775                                  ;
   776                                  ; What this path does not do is zero the memory.  The BIOS does not depend
   777                                  ; on that, but it is the difference worth reaching for if something ever
   778                                  ; behaves differently after a SETUP reboot than after a power cycle.
   779                                  ;
   780                                  ; Record the decision where main.c can report it.  The test of segment 0
   781                                  ; has already zeroed the BDA, so this survives, and a cold start leaves the
   782                                  ; byte at zero by simply not coming through here.
   783 00000163 6A4007                  	get_bda	ES
   784 00000166 26800E120001                es	or	byte [mfg_test],WARM_POST
   785                                  
   786 0000016C B800A0                  	mov	ax,LAST_SEG
   787 0000016F EB17                    	jmp	short .sized
   788                                  
   789                                  .cold:
