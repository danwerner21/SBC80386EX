  1275 00000360 E80100                          call    nout            ; write high nibble
  1276 00000363 58                              pop     ax
  1277 00000364 240F                    nout:   and     al,0x0F         ; mask low nibble
  1278 00000366 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1279 00000367 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1280 00000369 1440                            adc     al,0x40         ; form HEX digit
  1281 0000036B EB0F                            jmp     putc            ; 'putc' does the return
  1282                                  
  1283                                  
  1284                                  
  1285                                  ;
  1286                                  ; output an ASCII_SP to the console
  1287                                  ;
  1288                                  space:
  1289 0000036D B020                    	mov	al,ASCII_SP
  1290 0000036F EB0B                    	jmp	putc
  1291                                  ;
  1292                                  ; output a CR/LF to the console
  1293                                  ;
  1294                                  ;;crlf:
  1295                                  ;
  1296                                  ; outc -- write an ASCII 'cooked' character
  1297                                  ;       Convert NL to CR,NL
  1298                                  ;
  1299                                  outc:
  1300 00000371 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1301 00000373 7507                            jne     putc            ; if not, just put out the character
  1302                                  crlf:
  1303 00000375 B00D                            mov     al,ASCII_CR     ; get a CR
  1304 00000377 E80200                          call    putc            ; write it out
  1305 0000037A B00A                            mov     al,ASCII_NL     ; restore NL
  1306                                  ;
  1307                                  ; putc -- put out a character in AL to the SIO0 port
  1308                                  ;
  1309                                  putc:
  1310                                  %if 1
  1311 0000037C 5052                    	pushm	dx,ax
  1312 0000037E B401                    	mov	ah,1		;write char
  1313 00000380 BA0000                  	mov	dx,0
  1314 00000383 CD14                    	int	14h		;serial out
  1315 00000385 5A58                    	popm	dx,ax
  1316 00000387 C3                      	ret
  1317                                  %else
  1318                                  	push	dx		; register save
  1319                                  	push	ax		; PUSH EAX
  1320                                  putc1:
  1321                                          mov     dx,LSR0         ; Line Status Register
  1322                                  
  1323                                          in      al,dx
  1324                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1325                                          jz      putc1
  1326                                  
  1327                                          pop     ax
  1328                                          mov     dx,TBR0         ; Transmit buffer register
  1329                                          out     dx,al           ; send the character
  1330                                  
  1331                                          pop     dx              ; register restore
  1332                                          ret
  1333                                  %endif
  1334                                  %endif
  1335                                  
  1336                                  ;
  1337                                  ; word get_nvram_crc(word n);
  1338                                  ;	n = 31 (checks crc)
  1339                                  ;	n = 29 (forms crc)
  1340                                  ;
  1341                                  	global	get_nvram_crc_
  1342                                  get_nvram_crc_:
  1343 00000388 065153                  	pushm	bx,cx,es
  1344 0000038B 50                      	push	ax		; save count for nvram bytes
  1345                                  
  1346 0000038C B009                    	mov	al,1001B
  1347 0000038E E889FF                  	call	lites
  1348                                  
  1349 00000391 29C0                    	sub	ax,ax		; start CRC at 0000
  1350                                  %if 1
  1351 00000393 BB00F0                  	mov	bx,0xF000
  1352 00000396 8EC3                    	mov	es,bx
  1353 00000398 BBF0FF                  	mov	bx,0xFFF0
  1354 0000039B B91000                  	mov	cx,16
  1355 0000039E E8(0000)                	call	crc16
  1356                                  %endif
  1357 000003A1 6A4007                  	get_bda	ES
  1358 000003A4 BBE100                  	mov	bx,nvram_info
  1359 000003A7 59                      	pop	cx		; retrieve count in NVRAM
  1360 000003A8 E8(0000)                	call	crc16
  1361 000003AB 86E0                    	xchg	ah,al		; compensate for BIG Endian CRC16
  1362                                  
  1363 000003AD 5B5907                  	popm	bx,cx,es
  1364 000003B0 C3                      	ret
  1365                                  
  1366                                  	global	put_nvram_info_
  1367                                  put_nvram_info_:
  1368 000003B1 065350                  	pushm	ax,bx,es
  1369                                  
  1370 000003B4 B80022                     	mov	ax,0x2200		;disable write protect
  1371 000003B7 CD1A                    	int	0x1A
  1372                                  
  1373 000003B9 BBE100                  	mov	bx,nvram_info
  1374 000003BC 6A4007                  	get_bda	ES
  1375 000003BF B81F21                  	mov	ax,0x211F		; write 31 burst bytes
  1376 000003C2 CD1A                    	int	0x1A
  1377                                  
  1378 000003C4 B88022                  	mov	ax,0x2280		; set write protect
  1379 000003C7 CD1A                    	int	0x1A
  1380                                  
  1381 000003C9 585B07                  	popm	ax,bx,es
  1382 000003CC C3                      	ret
  1383                                  
