  1233                                  ; lites -- show a 4-bit value in the lites
  1234                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1235                                  ;
  1236                                  ;    Enter with:
  1237                                  ;	AL	set to value to display (0h..0Fh)
  1238                                  ;
  1239                                  ;    Exit with:
  1240                                  ;	All registers preserved
  1241                                  ;
  1242                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1243                                  	global	lites_
  1244                                  lites_:
  1245                                  lites:
  1246 0000031A 52509C                  	pushm	f,ax,dx
  1247                                  
  1248 0000031D BA62F8                  	mov	dx,P1LTC	; get the LITES latch
  1249 00000320 F6D0                    	not	al
  1250 00000322 C0E004                  	shl	al,4		; shift complement to position
  1251 00000325 88C4                    	mov	ah,al		; save in AH
  1252 00000327 FA                      	cli
  1253 00000328 EC                      	in	al,dx		; read the latch
  1254 00000329 240F                    	and	al,0Fh		; preserve bits
  1255 0000032B 08E0                    	or	al,ah		; set the new bits
  1256 0000032D EE                      	out	dx,al		; put out the new LITES value
  1257                                  
  1258 0000032E 9D585A                  	popm	f,ax,dx
  1259 00000331 C3                      	ret
  1260                                  
  1261                                  	global	jleds_
  1262                                  jleds_:
  1263 00000332 52                      	pushm	dx
  1264 00000333 BAFF04                  	mov	dx,0x4FF
  1265 00000336 EE                      	out	dx,al
  1266 00000337 5A                      	popm	dx
  1267 00000338 C3                      	ret
  1268                                  
  1269                                  	global	jledsh_
  1270                                  jledsh_:
  1271 00000339 52                      	pushm	dx
  1272 0000033A BAFF04                  	mov	dx,0x4FF
  1273 0000033D EE                      	out	dx,al
  1274 0000033E 5A                      	popm	dx
  1275 0000033F FA                      	cli
  1276 00000340 F4                      	hlt
  1277 00000341 C3                      	ret
  1278                                  
  1279                                  
  1280                                  
  1281                                  ;****** debugging stuff ******
  1282                                  %if 1
  1283                                  	global	eout,dout,wout,bout,nout
  1284                                  ; Hexadecimal output:
  1285                                  ; extdword(EAX)
  1286                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1287                                  ;
  1288 00000342 66C1C810                eout:   ror     eax,16          ; put out high word first
  1289 00000346 E80C00                          call    wout
  1290 00000349 66C1E810                        shr     eax,16          ; put out the low word
  1291 0000034D EB06                            jmp     wout
  1292 0000034F 92                      dout:   xchg    ax,dx           ; put out DX first
  1293 00000350 E80200                          call    wout
  1294 00000353 89D0                            mov     ax,dx
  1295 00000355 86E0                    wout:   xchg    ah,al           ; put out AH first
  1296 00000357 E80200                          call    bout
  1297 0000035A 88E0                            mov     al,ah           ; put out former AL
  1298 0000035C 50                      bout:   push    ax              ; save AL
  1299 0000035D C0E804                          shr     al,4            ; position High nibble
  1300 00000360 E80100                          call    nout            ; write high nibble
  1301 00000363 58                              pop     ax
  1302 00000364 240F                    nout:   and     al,0x0F         ; mask low nibble
  1303 00000366 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1304 00000367 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1305 00000369 1440                            adc     al,0x40         ; form HEX digit
  1306 0000036B EB0F                            jmp     putc            ; 'putc' does the return
  1307                                  
  1308                                  
  1309                                  
  1310                                  ;
  1311                                  ; output an ASCII_SP to the console
  1312                                  ;
  1313                                  space:
  1314 0000036D B020                    	mov	al,ASCII_SP
  1315 0000036F EB0B                    	jmp	putc
  1316                                  ;
  1317                                  ; output a CR/LF to the console
  1318                                  ;
  1319                                  ;;crlf:
  1320                                  ;
  1321                                  ; outc -- write an ASCII 'cooked' character
  1322                                  ;       Convert NL to CR,NL
  1323                                  ;
  1324                                  outc:
  1325 00000371 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1326 00000373 7507                            jne     putc            ; if not, just put out the character
  1327                                  crlf:
  1328 00000375 B00D                            mov     al,ASCII_CR     ; get a CR
  1329 00000377 E80200                          call    putc            ; write it out
  1330 0000037A B00A                            mov     al,ASCII_NL     ; restore NL
  1331                                  ;
  1332                                  ; putc -- put out a character in AL to the SIO0 port
  1333                                  ;
  1334                                  putc:
  1335                                  %if 1
  1336 0000037C 5052                    	pushm	dx,ax
  1337 0000037E B401                    	mov	ah,1		;write char
  1338 00000380 BA0000                  	mov	dx,0
  1339 00000383 CD14                    	int	14h		;serial out
  1340 00000385 5A58                    	popm	dx,ax
  1341 00000387 C3                      	ret
  1342                                  %else
  1343                                  	push	dx		; register save
  1344                                  	push	ax		; PUSH EAX
  1345                                  putc1:
  1346                                          mov     dx,LSR0         ; Line Status Register
  1347                                  
  1348                                          in      al,dx
  1349                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1350                                          jz      putc1
  1351                                  
  1352                                          pop     ax
  1353                                          mov     dx,TBR0         ; Transmit buffer register
  1354                                          out     dx,al           ; send the character
  1355                                  
  1356                                          pop     dx              ; register restore
  1357                                          ret
  1358                                  %endif
  1359                                  %endif
  1360                                  
  1361                                  ;
  1362                                  ; word get_nvram_crc(word n);
  1363                                  ;	n = 31 (checks crc)
  1364                                  ;	n = 29 (forms crc)
  1365                                  ;
  1366                                  	global	get_nvram_crc_
  1367                                  get_nvram_crc_:
  1368 00000388 065153                  	pushm	bx,cx,es
  1369 0000038B 50                      	push	ax		; save count for nvram bytes
  1370                                  
  1371 0000038C B009                    	mov	al,1001B
  1372 0000038E E889FF                  	call	lites
  1373                                  
  1374 00000391 29C0                    	sub	ax,ax		; start CRC at 0000
  1375                                  %if 1
  1376 00000393 BB00F0                  	mov	bx,0xF000
  1377 00000396 8EC3                    	mov	es,bx
  1378 00000398 BBF0FF                  	mov	bx,0xFFF0
  1379 0000039B B91000                  	mov	cx,16
  1380 0000039E E8(0000)                	call	crc16
  1381                                  %endif
  1382 000003A1 6A4007                  	get_bda	ES
  1383 000003A4 BBE100                  	mov	bx,nvram_info
  1384 000003A7 59                      	pop	cx		; retrieve count in NVRAM
  1385 000003A8 E8(0000)                	call	crc16
  1386 000003AB 86E0                    	xchg	ah,al		; compensate for BIG Endian CRC16
  1387                                  
  1388 000003AD 5B5907                  	popm	bx,cx,es
  1389 000003B0 C3                      	ret
  1390                                  
  1391                                  	global	put_nvram_info_
  1392                                  put_nvram_info_:
  1393 000003B1 065350                  	pushm	ax,bx,es
  1394                                  
  1395 000003B4 B80022                     	mov	ax,0x2200		;disable write protect
  1396 000003B7 CD1A                    	int	0x1A
  1397                                  
  1398 000003B9 BBE100                  	mov	bx,nvram_info
  1399 000003BC 6A4007                  	get_bda	ES
  1400 000003BF B81F21                  	mov	ax,0x211F		; write 31 burst bytes
  1401 000003C2 CD1A                    	int	0x1A
  1402                                  
  1403 000003C4 B88022                  	mov	ax,0x2280		; set write protect
  1404 000003C7 CD1A                    	int	0x1A
  1405                                  
  1406 000003C9 585B07                  	popm	ax,bx,es
  1407 000003CC C3                      	ret
  1408                                  
  1409                                  
  1410                                  
  1411                                  
  1412                                  ;        setloc (0x100000-(ROM<<10)-16)
  1413 000003CD 90<rep 3h>              	align	16
  1414                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1415                                  ; The Real Mode statup jump
  1416                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1417                                  	bits	16
  1418 000003D0 EA[0000][ssss]          	jmp	far origin
  1419 000003D5 FF<rep 9h>              	times 9 db 0FFh
  1420 000003DE FC00                    	db	0FCh, 00h		; PC/AT
  1421                                  
  1422                                  segment BOOT
  1423                                  %include "boot.asm"
  1424                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1425                              <1> ;boot.asm
  1426                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1427                              <1> ; The Real Mode statup jump
  1428                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1429                              <1> 	bits	16
  1430                              <1> 
  1431                              <1> SEGBASE equ 0x10000-(ROM<<6)
  1432                              <1> 
  1433 00000003 90<rep Dh>          <1>         align   16
  1434                              <1> bootstrap:
  1435 00000010 EA000000F0          <1>         jmp     SEGBASE:0000	; 5 byte real-mode far call
  1436                              <1> %include "date.inc"
  1437 00000015 30392F32372F3236    <2> 	db	"09/27/26"
  1437 0000001D FFFC00              <1> 	db	0xFF, 0xFC, 0x00	; PC/AT
