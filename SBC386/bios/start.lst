  1072                                  ;****** debugging stuff ******
  1073                                  %if 1
  1074                                  	global	eout,dout,wout,bout,nout
  1075                                  ; Hexadecimal output:
  1076                                  ; extdword(EAX)
  1077                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1078                                  ;
  1079 000002CB 66C1C810                eout:   ror     eax,16          ; put out high word first
  1080 000002CF E80C00                          call    wout
  1081 000002D2 66C1E810                        shr     eax,16          ; put out the low word
  1082 000002D6 EB06                            jmp     wout
  1083 000002D8 92                      dout:   xchg    ax,dx           ; put out DX first
  1084 000002D9 E80200                          call    wout
  1085 000002DC 89D0                            mov     ax,dx
  1086 000002DE 86E0                    wout:   xchg    ah,al           ; put out AH first
  1087 000002E0 E80200                          call    bout
  1088 000002E3 88E0                            mov     al,ah           ; put out former AL
  1089 000002E5 50                      bout:   push    ax              ; save AL
  1090 000002E6 C0E804                          shr     al,4            ; position High nibble
  1091 000002E9 E80100                          call    nout            ; write high nibble
  1092 000002EC 58                              pop     ax
  1093 000002ED 240F                    nout:   and     al,0x0F         ; mask low nibble
  1094 000002EF 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1095 000002F0 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1096 000002F2 1440                            adc     al,0x40         ; form HEX digit
  1097 000002F4 EB0F                            jmp     putc            ; 'putc' does the return
  1098                                  
  1099                                  
  1100                                  
  1101                                  ;
  1102                                  ; output an ASCII_SP to the console
  1103                                  ;
  1104                                  space:
  1105 000002F6 B020                    	mov	al,ASCII_SP
  1106 000002F8 EB0B                    	jmp	putc
  1107                                  ;
  1108                                  ; output a CR/LF to the console
  1109                                  ;
  1110                                  ;;crlf:
  1111                                  ;
  1112                                  ; outc -- write an ASCII 'cooked' character
  1113                                  ;       Convert NL to CR,NL
  1114                                  ;
  1115                                  outc:
  1116 000002FA 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1117 000002FC 7507                            jne     putc            ; if not, just put out the character
  1118                                  crlf:
  1119 000002FE B00D                            mov     al,ASCII_CR     ; get a CR
  1120 00000300 E80200                          call    putc            ; write it out
  1121 00000303 B00A                            mov     al,ASCII_NL     ; restore NL
  1122                                  ;
  1123                                  ; putc -- put out a character in AL to the SIO0 port
  1124                                  ;
  1125                                  putc:
  1126                                  %if 1
  1127 00000305 5052                    	pushm	dx,ax
  1128 00000307 B401                    	mov	ah,1		;write char
  1129 00000309 BA0000                  	mov	dx,0
  1130 0000030C CD14                    	int	14h		;serial out
  1131 0000030E 5A58                    	popm	dx,ax
  1132 00000310 C3                      	ret
  1133                                  %else
  1134                                  	push	dx		; register save
  1135                                  	push	ax		; PUSH EAX
  1136                                  putc1:
  1137                                          mov     dx,LSR0         ; Line Status Register
  1138                                  
  1139                                          in      al,dx
  1140                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1141                                          jz      putc1
  1142                                  
  1143                                          pop     ax
  1144                                          mov     dx,TBR0         ; Transmit buffer register
  1145                                          out     dx,al           ; send the character
  1146                                  
  1147                                          pop     dx              ; register restore
  1148                                          ret
  1149                                  %endif
  1150                                  %endif
