  1397                                  segment BOOT
  1398                                  %include "boot.asm"
  1399                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1400                              <1> ;boot.asm
  1401                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1402                              <1> ; The Real Mode statup jump
  1403                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1404                              <1> 	bits	16
  1405                              <1> 
  1406                              <1> SEGBASE equ 0x10000-(ROM<<6)
  1407                              <1> 
  1408 00000003 90<rep Dh>          <1>         align   16
  1409                              <1> bootstrap:
  1410 00000010 EA000000F0          <1>         jmp     SEGBASE:0000	; 5 byte real-mode far call
  1411                              <1> %include "date.inc"
  1412 00000015 30392F31342F3236    <2> 	db	"09/14/26"
  1412 0000001D FFFC00              <1> 	db	0xFF, 0xFC, 0x00	; PC/AT
