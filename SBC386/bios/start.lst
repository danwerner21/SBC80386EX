  1225 00000322 C0E004                  	shl	al,4		; shift complement to position
  1226 00000325 88C4                    	mov	ah,al		; save in AH
  1227 00000327 FA                      	cli
  1228 00000328 EC                      	in	al,dx		; read the latch
  1229 00000329 240F                    	and	al,0Fh		; preserve bits
  1230 0000032B 08E0                    	or	al,ah		; set the new bits
  1231 0000032D EE                      	out	dx,al		; put out the new LITES value
  1232                                  
  1233 0000032E 9D585A                  	popm	f,ax,dx
  1234 00000331 C3                      	ret
