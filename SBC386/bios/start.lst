   446                                  segment _TEXT
   447                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   448                                  ; initb_cx	primitive entry
   449                                  ; initb		callable entry (but uses CX)
   450                                  ;
   451                                  ;    Enter with:
   452                                  ;
   453                                  ;	DS:SI	pointing at the table of BYTES to init.
   454                                  ;	CX	used to hold the return address
   455                                  ;
   456                                  ;    Exit with:
   457                                  ;	AX,DX	trashed
   458                                  ;	CX	used to hold the return
   459                                  ;	SI	updated
   460                                  ;
   461                                  ;	All other registers preserved
   462                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   463                                  	global	initb
   464                                  initb:
   465 00000040 59                              pop     cx
   466                                  initb_cx:
   467 00000041 AD                      	lodsw                   ; get destination port
   468 00000042 89C2                            mov     dx,ax		; put where useful
   469 00000044 40                              inc     ax              ; test for EOF
   470 00000045 7404                    	jz	.9		; EOF? if so, return
   471                                  
   472 00000047 AC                      	lodsb                   ; get port value
   473 00000048 EE                              out     dx,al           ; output port value
   474 00000049 EBF6                            jmp     initb_cx
   475                                  .9:
   476 0000004B FFE1                            jmp     cx              ; EOF, return
   477                                  
   478                                  
   479                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   480                                  ; initw_cx	primitive entry
   481                                  ; initw		callable entry (but uses CX)
   482                                  ;
   483                                  ;    Enter with:
   484                                  ;
   485                                  ;	DS:SI	pointing at the table of WORDS to init.
   486                                  ;	CX	used to hold the return address
   487                                  ;
   488                                  ;    Exit with:
   489                                  ;	AX,DX	trashed
   490                                  ;	CX	used to hold the return
   491                                  ;	SI	updated
   492                                  ;
   493                                  ;	All other registers preserved
   494                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   495                                  initw:
   496 0000004D 59                              pop     cx
   497                                  initw_cx:
   498 0000004E AD                      	lodsw                   ; get destination port
   499 0000004F 89C2                            mov     dx,ax		; put where useful
   500 00000051 40                              inc     ax              ; test for EOF
   501 00000052 7404                    	jz	.9		; EOF? if so, return
   502                                  
   503 00000054 AD                      	lodsw                   ; get port value
   504 00000055 EF                              out     dx,ax           ; output to word port
   505 00000056 EBF6                            jmp     initw_cx
   506 00000058 FFE1                    .9:	jmp	cx		; EOF, return
   507                                  
