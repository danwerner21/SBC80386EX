    57                                  %include "seg_def.inc"
    58                              <1> ; SEG_DEF.inc
    59                              <1> ;
    60                              <1> %ifndef SEG_DEF
    61                              <1> %define SEG_DEF 1
    62                              <1> 
    63                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    64                              <1> 
    65                              <1> segment CONST		align=16	class=DATA	public
    66                              <1> segment CONST2		align=2		class=DATA	public
    67                              <1> segment _DATA		align=16	class=DATA	public
    68                              <1> segment _BSS		align=16	class=DATA	public
    69                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    70                              <1> 
    71                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    72                              <1> 
    73                              <1> 
    74                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    75                              <1> 
    76                              <1> %define XXX
    77                              <1> %endif
    78                              <1> ;
    79                              <1> ; end SEG_DEF.inc
