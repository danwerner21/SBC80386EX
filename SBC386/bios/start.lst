   525                                  ; Enable access to the Expanded I/O ports (F000..FXXX)
   526 00000084 E423                            in	al,REMAPCFGH	; reset the state machine (state A)
   527 00000086 B80080                          mov     ax,0x8000
   528 00000089 E623                            out     REMAPCFGH,al	; move to (state B)
   529 0000008B 86E0                            xchg    ah,al
   530 0000008D E622                            out     REMAPCFGL,al	; move to (state C)
   531 0000008F E722                            out     REMAPCFG,ax	; move to (state D), sets ESE bit
   532                                  ; Expanded I/O is now available -- ESE bit is set
