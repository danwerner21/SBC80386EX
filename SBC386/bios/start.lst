   678 0000010B EB00                    	jmp	$+2
   679 0000010D EB00                    	jmp	$+2
   680 0000010F EC                      	in	al,dx		;has an interrupt been generated
   681 00000110 A801                    	test	al,BIT0		; from Timer 0
   682 00000112 74F5                    	jz	wait00		;Out0 is still low
   683                                  
