   476 00000051 40                              inc     ax              ; test for EOF
   477 00000052 7404                    	jz	.9		; EOF? if so, return
   478                                  
   479 00000054 AD                      	lodsw                   ; get port value
   480 00000055 EF                              out     dx,ax           ; output to word port
   481 00000056 EBF6                            jmp     initw_cx
   482 00000058 FFE1                    .9:	jmp	cx		; EOF, return
