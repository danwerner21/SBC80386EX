   419                              <1> defb    RBR1    equ     0x02F8
   420                              <1> defb    TBR1    equ     0x02F8
   421                              <1> defb    DLL1    equ     0x02F8
   422                              <1> defb    DLH1    equ     0x02F9
   423                              <1> defb    IER1    equ     0x02F9
   424                              <1> defb    IIR1    equ     0x02FA
   425                              <1> defb    LCR1    equ     0x02FB
   426                              <1> defb    MCR1    equ     0x02FC
   427                              <1> defb    LSR1    equ     0x02FD
   428                              <1> defb    MSR1    equ     0x02FE
   429                              <1> defb    SCR1    equ     0x02FF
   430                              <1> 
   431                              <1> ;/* LSRx bits
   432                              <1> ;*/
   433                              <1> defb    LSR_TE  equ     BIT6
   434                              <1> defb    LSR_TBE equ     BIT5
   435                              <1> defb    LSR_BI  equ     BIT4
   436                              <1> defb    LSR_FE  equ     BIT3
   437                              <1> defb    LSR_PE  equ     BIT2
