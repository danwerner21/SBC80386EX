   477                                  
   478 00000054 AD                      	lodsw                   ; get port value
   479 00000055 EF                              out     dx,ax           ; output to word port
   480 00000056 EBF6                            jmp     initw_cx
   481 00000058 FFE1                    .9:	jmp	cx		; EOF, return
