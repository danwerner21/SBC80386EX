    71                              <1> ;
    72                              <1> ;
    73                              <1> ; SBC-386 board revisions:
    74                              <1> ;       SBC386-0   prototype / concept testing
    75                              <1> ;	SBC-386EX 2.0	production / January 2018
    76                              <1> ;
    77                              <1> ; Assembly by NASM 2.08 is preferred
    78                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    79                              <1> ;
    80                              <1> ;include "i386EX.inc" -- must be included at a higher level
    81                              <1> 
    82                              <1> TIMER_STOP	equ	BIT6+BIT0 + ZBIT1 + ZBIT3 + ZBIT5 ; stop 0, 1, 2
    83                              <1> TIMER_RUN	equ	TIMER_STOP + BIT1 + BIT3	; run counters 0, 1
    84                              <1> 
    85                              <1>         binit   TMRCFG, ZBIT7+TIMER_STOP ; bit6: s/w control of GATEn, bit7=0 enables all clocks
   128 00000000 34F8                <2>  dw %1
   129 00000002 41                  <2>  db %2
    86                              <1> 		;Timers enabled, 1&2 use PSCLK, 0 uses TMRCLK0 (COMCLK/2)
    87                              <1> CTR0 equ ZBIT7+ZBIT6	;select counter 0
    88                              <1> CTR1 equ ZBIT7+ BIT6	;select counter 1
    89                              <1> CTR2 equ  BIT7+ZBIT6	;select counter 2
    90                              <1> CWR01 equ BIT5+BIT4	;Write Count low, then high
    91                              <1> MODE0 equ ZBIT3+ZBIT2+ZBIT1
    92                              <1> MODE1 equ ZBIT3+ZBIT2+ BIT1
    93                              <1> MODE2 equ ZBIT3+ BIT2+ZBIT1
    94                              <1> MODE3 equ ZBIT3+ BIT2+ BIT1
    95                              <1> MODE4 equ  BIT3+ZBIT2+ZBIT1
    96                              <1> MODE5 equ  BIT3+ZBIT2+ BIT1
    97                              <1> ; counter 0 runs at 1.8432mhz / 2  =  921600  (just under 1mhz)
    98                              <1> ; @20hz, the divisor is 46080 yielding a 50ms time slot
    99                              <1> COMCLK	equ	1843200		; standard 1.8432mhz oscillator
   100                              <1> BAUD	equ	9600		; default SIO0 bit rate
   101                              <1> DIVISOR	equ	COMCLK/16/BAUD	; SIO0 divisor to achieve BAUD rate
   102                              <1> CLKIN0	equ	COMCLK/2	; Timer0 input count rate
   103                              <1> MS50	equ	CLKIN0 / 20	; 50ms clock
   104                              <1> MS50HI	equ	MS50/256
   105                              <1> MS50LO	equ	MS50 & 0xFF
   106                              <1> MS18	equ	50619		; 18.206602hz clock (54.92513ms)
   107                              <1> 				; 0x1800BA = 1573050 ticks/day
   108                              <1> MS18b	equ	50625		; 18.204444hz clock (54.93164ms)
   109                              <1> 				; 0x180000 = 1572864 ticks/day
   110                              <1> MS18HI	equ	MS18/256
   111                              <1> MS18LO	equ	MS18 & 0xFF
    51                                  %define XXX
    52                                  %include "bda.inc"
