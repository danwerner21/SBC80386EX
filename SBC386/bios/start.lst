   423                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   424                                  ; initb_cx	primitive entry
   425                                  ; initb		callable entry (but uses CX)
   426                                  ;
   427                                  ;    Enter with:
   428                                  ;
   429                                  ;	DS:SI	pointing at the table of BYTES to init.
   430                                  ;	CX	used to hold the return address
   431                                  ;
   432                                  ;    Exit with:
   433                                  ;	AX,DX	trashed
   434                                  ;	CX	used to hold the return
   435                                  ;	SI	updated
   436                                  ;
   437                                  ;	All other registers preserved
   438                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   439                                  	global	initb
   440                                  initb:
   441 00000040 59                              pop     cx
   442                                  initb_cx:
   443 00000041 AD                      	lodsw                   ; get destination port
   444 00000042 89C2                            mov     dx,ax		; put where useful
   445 00000044 40                              inc     ax              ; test for EOF
   446 00000045 7404                    	jz	.9		; EOF? if so, return
   447                                  
   448 00000047 AC                      	lodsb                   ; get port value
   449 00000048 EE                              out     dx,al           ; output port value
   450 00000049 EBF6                            jmp     initb_cx
   451                                  .9:
   452 0000004B FFE1                            jmp     cx              ; EOF, return
   453                                  
   454                                  
   455                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   456                                  ; initw_cx	primitive entry
   457                                  ; initw		callable entry (but uses CX)
   458                                  ;
   459                                  ;    Enter with:
   460                                  ;
   461                                  ;	DS:SI	pointing at the table of WORDS to init.
   462                                  ;	CX	used to hold the return address
   463                                  ;
   464                                  ;    Exit with:
   465                                  ;	AX,DX	trashed
   466                                  ;	CX	used to hold the return
   467                                  ;	SI	updated
   468                                  ;
   469                                  ;	All other registers preserved
   470                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   471                                  initw:
   472 0000004D 59                              pop     cx
   473                                  initw_cx:
   474 0000004E AD                      	lodsw                   ; get destination port
