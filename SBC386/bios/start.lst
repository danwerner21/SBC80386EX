   566                                  size_SRAM:
   567 000000B4 BF00A8                  	mov	di,SRAM_AD>>4	; SRAM segment
   568 000000B7 8ED7                    	mov	ss,di		; set up SS
   569                                  	cnop
   570 000000B9 8EC7                    	mov	es,di		; set ES for later testing
   571                                  	cnop
   572 000000BB BA0020                  	mov	dx,(32<<8)	; DH=32, DL=0
   573                                  .2:
   574 000000BE 89D7                    	mov	di,dx		; get address
   575 000000C0 C1E70A                  	shl	di,10		; convert to Kilobytes
   576 000000C3 368815                     ss	mov	[di],dl		; store a byte
   577 000000C6 FEC2                       	inc	dl
   578 000000C8 38F2                    	cmp	dl,dh		; test up to 32K
   579 000000CA 72F2                    	jb	.2
   580                                  ; compute SRAM size
   581 000000CC 362A160000                 ss	sub	dl,[0]
   582 000000D1 C1E20A                     	shl	dx,10		; convert DL to DX=?? Kilobytes
   583 000000D4 89D4                    	mov	sp,dx		; SS:8000h is stack start for 32K SRAM
   584                                  
   585                                  ; test the SRAM
   586 000000D6 C1EA02                  	shr	dx,2		; count of DWORDs
   587 000000D9 31F6                    	xor	si,si		; ES:SI is area to test
   588 000000DB BB[E100]                	mov	bx, .3
   589 000000DE E90E02                  	jmp	seg_test_bx	; do the single bit test
   590                                  .3:  ; return here
   591                                  
   592                                  
   593                                  ; All okay with the SRAM
