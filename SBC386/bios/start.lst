   418                              <1> defb    LSR_FE  equ     BIT3
   419                              <1> defb    LSR_PE  equ     BIT2
   420                              <1> defb    LSR_OE  equ     BIT1
   421                              <1> defb    LSR_RBF equ     BIT0
   422                              <1> 
   423                              <1> ;/* MSRx bits
   424                              <1> ;*/
   425                              <1> defb	MSR_DCD	equ	BIT7
   426                              <1> defb	MSR_RI 	equ	BIT6
   427                              <1> defb	MSR_DSR	equ	BIT5
   428                              <1> defb	MSR_CTS	equ	BIT4
   429                              <1> defb	MSR_deltaDCD	equ	BIT3
   430                              <1> defb	MSR_deltaRI	equ	BIT2
   431                              <1> defb	MSR_deltaDSR	equ	BIT1
   432                              <1> defb	MSR_deltaCTS	equ	BIT0
   433                              <1> 
   434                              <1> ;/* Bits in CR0
   435                              <1> ;*/
   436                              <1> defb    CR0_PE  equ     BIT0
   437                              <1> defb    CR0_MP  equ     BIT1
   438                              <1> defb    CR0_EM  equ     BIT2
   439                              <1> defb    CR0_TS  equ     BIT3
   440                              <1> defd    CR0_WP  equ     BIT16
   441                              <1> defd    CR0_PG  equ     BIT31
   442                              <1> 
   443                              <1> ;/* Some ASCII character codes
   444                              <1> ;*/
   445                              <1> defb    ASCII_NUL       equ     0x00
   446                              <1> defb    ASCII_BS        equ     0x08
   447                              <1> defb    ASCII_HT        equ     0x09
   448                              <1> defb    ASCII_LF        equ     0x0A
   449                              <1> defb    ASCII_NL        equ     0x0A
   450                              <1> defb    ASCII_FF        equ     0x0C
   451                              <1> defb    ASCII_CR        equ     0x0D
   452                              <1> defb	ASCII_ESC	equ	0x1B
   453                              <1> defb    ASCII_SP        equ     0x20
   454                              <1> defb    ASCII_DEL       equ     0x7F
   455                              <1> defb	ASCII_RUB	equ	0xFF
   456                              <1> 
