   503                                  ; Enable access to the Expanded I/O ports (F000..FXXX)
   504 00000084 E423                            in	al,REMAPCFGH	; reset the state machine (state A)
   505 00000086 B80080                          mov     ax,0x8000
   506 00000089 E623                            out     REMAPCFGH,al	; move to (state B)
