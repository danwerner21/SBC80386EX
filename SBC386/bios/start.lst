   832                                  %if SHADOW_MODE
   833                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   834                                  ; Shadow the ROM into DRAM
   835                                  ;
   836                                  ; The BIOS executes from 8-bit ROM at 5 wait states, and every INT 10h
   837                                  ; character and every IDE sector pays for it.  CS2 already covers the whole
   838                                  ; first megabyte of DRAM -- 16 bits wide at 2 wait states -- and the two
   839                                  ; overlap at F0000.  While UCS is enabled it is the one that answers there,
   840                                  ; so the ROM cannot simply be copied over itself: the copy has to run from
   841                                  ; somewhere else while UCS is switched off.
   842                                  ;
   843                                  ;   1. copy the ROM to a scratch segment, and check it arrived
   844                                  ;   2. jump into that copy, so execution is no longer inside the ROM
   845                                  ;   3. switch UCS off -- F0000 answers from DRAM from here on
   846                                  ;   4. copy the scratch back to F0000, and check it arrived
   847                                  ;   5. jump back to F000, which is now the DRAM copy
   848                                  ;
   849                                  ; Either check can fail without consequence.  A failure at step 1 leaves the
   850                                  ; ROM exactly as it was; a failure at step 4 switches UCS back on and returns
   851                                  ; to the real ROM.  Slower, but running.  Neither is expected -- but the DRAM
   852                                  ; under F0000 is the one part of the first megabyte that test_1to8 does not
   853                                  ; reach, and this is what writes to it, so it gets checked here instead.
   854                                  ;
   855                                  ; Between step 3 and the end of step 4, nothing may read DGROUP data or call
   856                                  ; anything that does: DS-relative reads land at F0000, which is uninitialised
   857                                  ; DRAM until that copy finishes.  That is why this stretch is bare string
   858                                  ; moves and port writes, with DS pointed at the scratch and not at DGROUP.
   859                                  ;
   860                                  ; This is done here rather than earlier because it needs DRAM that has been
   861                                  ; tested, and it must be before anything records a F000-relative address.
   862                                  ;
   863                                  ; One consequence worth knowing: F0000 is writable afterwards.  Writes into
   864                                  ; the BIOS used to fall on ROM and do nothing; now they land.  Nothing in
   865                                  ; this BIOS writes there -- _DATA and _BSS are empty by design -- but a stray
   866                                  ; far pointer that used to be harmless is not any more.
   867                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   868                                  SHADOW_SEG	equ	XFER_AD>>4	; scratch, inside the range just tested
   869                                  SHADOW_WORDS	equ	32768		; 64K, as words
   870                                  
   871                                  shadow_rom:
   872 0000018D 061E575652515350        	pushm	ax,bx,cx,dx,si,di,ds,es
   873 00000195 FA                      	cli				; belt and braces: the vectors at
   874                                  					;  0000:0000 are not built yet, so an
   875                                  					;  interrupt taken here has nowhere to go
   876 00000196 FC                      	cld
   877                                  
   878                                  ; 1 -- the ROM into the scratch segment
   879 00000197 8CC8                    	mov	ax,cs			; F000, the ROM
   880 00000199 8ED8                    	mov	ds,ax
   881                                  	cnop
   882 0000019B B80020                  	mov	ax,SHADOW_SEG
   883 0000019E 8EC0                    	mov	es,ax
   884                                  	cnop
   885 000001A0 31F6                    	xor	si,si
   886 000001A2 31FF                    	xor	di,di
   887 000001A4 B90080                  	mov	cx,SHADOW_WORDS
   888 000001A7 F3A5                    	rep	movsw
   889                                  
   890 000001A9 31F6                    	xor	si,si			; and check it arrived
   891 000001AB 31FF                    	xor	di,di
   892 000001AD B90080                  	mov	cx,SHADOW_WORDS
   893 000001B0 F3A7                    	repe	cmpsw
   894 000001B2 7536                    	jne	.9			; scratch DRAM will not hold it;
   895                                  					;  leave the ROM alone and say nothing
   896                                  
   897                                  ; 2 -- into the copy.  CS is the scratch segment from here.
   898 000001B4 EA[B901]0020            	jmp	SHADOW_SEG:.in_ram
   899                                  .in_ram:
   900                                  
   901                                  ; 3 -- switch UCS off
   902 000001B9 BA3CF4                  	mov	dx,UCSMSKL		; the low mask carries the enable bit
   903 000001BC ED                      	in	ax,dx
   904 000001BD 24FE                    	and	al,~BIT0
   905 000001BF EF                      	out	dx,ax
   906                                  
   907                                  ; 4 -- the scratch back into F0000, which is DRAM now
   908 000001C0 B80020                  	mov	ax,SHADOW_SEG
   909 000001C3 8ED8                    	mov	ds,ax
   910                                  	cnop
   911 000001C5 B800F0                  	mov	ax,0xF000
   912 000001C8 8EC0                    	mov	es,ax
   913                                  	cnop
   914 000001CA 31F6                    	xor	si,si
   915 000001CC 31FF                    	xor	di,di
   916 000001CE B90080                  	mov	cx,SHADOW_WORDS
   917 000001D1 F3A5                    	rep	movsw
   918                                  
   919 000001D3 31F6                    	xor	si,si			; and check that one too
   920 000001D5 31FF                    	xor	di,di
   921 000001D7 B90080                  	mov	cx,SHADOW_WORDS
   922 000001DA F3A7                    	repe	cmpsw
   923 000001DC 7407                    	je	.5
   924                                  
   925                                  ; The DRAM under the ROM will not hold it.  Put UCS back, and the far jump
