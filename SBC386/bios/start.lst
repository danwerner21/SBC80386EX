   967                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   968                                  ; seg_test -- test a segment of memory (variable size)
   969                                  ; seg_test_bx	ditto, but returns through BX
   970                                  ;
   971                                  ;    Enter with:
   972                                  ;	ES:SI	points at area to test
   973                                  ;	DX	count of size of area in DWORDS (16K==full segment)
   974                                  ;
   975                                  ;    Exit with:
   976                                  ;	ES:SI	unchanged
   977                                  ;	DX	unchanged
   978                                  ;	memory area is cleared to Zeroes if successful
   979                                  ;
   980                                  ;    Error Condition:
   981                                  ;	*** WILL HALT ***	so have the LITES set up
   982                                  ;
   983                                  ;    Trashes:
   984                                  ;	EAX
   985                                  ;	BX	is used for the return
   986                                  ;	CX
   987                                  ;	DI
   988                                  ;
   989                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   990                                  
   991                                  seg_test:
   992 00000277 5B                      	pop	bx
   993                                  seg_test_bx:
   994                                  
   995 00000278 66B801000000            	mov	eax,1		; EAX = 0000_0001h
   996                                  .4:
   997 0000027E 31FF                    	xor	di,di		;
   998 00000280 89D1                    	mov	cx,dx		; set DWORD count
   999 00000282 F366AB                  	rep stosd		; store all of memory
  1000                                  
  1001 00000285 89D1                    	mov	cx,dx		; reset the count
  1002 00000287 31FF                    	xor	di,di		; reset start address
  1003 00000289 F366AF                  	repe	scasd		;
  1004 0000028C 7407                    	je	.5		; continue on no error
  1005                                  
  1006                                  %if 1
  1007 0000028E BAFF04                  	mov	dx,0x4FF
  1008 00000291 B0F5                    	mov	al,0xF5		; error code
  1009 00000293 EE                      	out	dx,al		; Zap jrc LEDs to 0xFF
  1010 00000294 F4                      	hlt			; with the LITES as set
  1011                                  %endif
  1012                                  
  1013 00000295 66D1E0                  .5:	shl	eax,1
  1014 00000298 73E4                    	jnc	.4
  1015                                  ; now zero the SRAM
  1016 0000029A 31FF                    	xor	di,di		; reset the start address
  1017 0000029C 89D1                    	mov	cx,dx		; reset the count
  1018 0000029E F366AB                  	rep	stosd		; zero the SRAM
  1019                                  
  1020 000002A1 FFE3                    	jmp	bx	; return
