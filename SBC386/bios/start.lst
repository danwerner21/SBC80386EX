  1257                                  ;****** debugging stuff ******
  1258                                  %if 1
  1259                                  	global	eout,dout,wout,bout,nout
  1260                                  ; Hexadecimal output:
  1261                                  ; extdword(EAX)
  1262                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1263                                  ;
  1264 00000342 66C1C810                eout:   ror     eax,16          ; put out high word first
  1265 00000346 E80C00                          call    wout
  1266 00000349 66C1E810                        shr     eax,16          ; put out the low word
  1267 0000034D EB06                            jmp     wout
  1268 0000034F 92                      dout:   xchg    ax,dx           ; put out DX first
  1269 00000350 E80200                          call    wout
  1270 00000353 89D0                            mov     ax,dx
  1271 00000355 86E0                    wout:   xchg    ah,al           ; put out AH first
  1272 00000357 E80200                          call    bout
  1273 0000035A 88E0                            mov     al,ah           ; put out former AL
  1274 0000035C 50                      bout:   push    ax              ; save AL
  1275 0000035D C0E804                          shr     al,4            ; position High nibble
  1276 00000360 E80100                          call    nout            ; write high nibble
  1277 00000363 58                              pop     ax
  1278 00000364 240F                    nout:   and     al,0x0F         ; mask low nibble
  1279 00000366 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1280 00000367 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1281 00000369 1440                            adc     al,0x40         ; form HEX digit
  1282 0000036B EB0F                            jmp     putc            ; 'putc' does the return
  1283                                  
  1284                                  
  1285                                  
  1286                                  ;
  1287                                  ; output an ASCII_SP to the console
  1288                                  ;
  1289                                  space:
  1290 0000036D B020                    	mov	al,ASCII_SP
  1291 0000036F EB0B                    	jmp	putc
  1292                                  ;
  1293                                  ; output a CR/LF to the console
  1294                                  ;
  1295                                  ;;crlf:
  1296                                  ;
  1297                                  ; outc -- write an ASCII 'cooked' character
  1298                                  ;       Convert NL to CR,NL
  1299                                  ;
  1300                                  outc:
  1301 00000371 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1302 00000373 7507                            jne     putc            ; if not, just put out the character
  1303                                  crlf:
  1304 00000375 B00D                            mov     al,ASCII_CR     ; get a CR
  1305 00000377 E80200                          call    putc            ; write it out
  1306 0000037A B00A                            mov     al,ASCII_NL     ; restore NL
  1307                                  ;
  1308                                  ; putc -- put out a character in AL to the SIO0 port
  1309                                  ;
  1310                                  putc:
  1311                                  %if 1
  1312 0000037C 5052                    	pushm	dx,ax
  1313 0000037E B401                    	mov	ah,1		;write char
  1314 00000380 BA0000                  	mov	dx,0
  1315 00000383 CD14                    	int	14h		;serial out
  1316 00000385 5A58                    	popm	dx,ax
  1317 00000387 C3                      	ret
  1318                                  %else
  1319                                  	push	dx		; register save
  1320                                  	push	ax		; PUSH EAX
  1321                                  putc1:
  1322                                          mov     dx,LSR0         ; Line Status Register
  1323                                  
  1324                                          in      al,dx
  1325                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1326                                          jz      putc1
  1327                                  
  1328                                          pop     ax
  1329                                          mov     dx,TBR0         ; Transmit buffer register
  1330                                          out     dx,al           ; send the character
  1331                                  
  1332                                          pop     dx              ; register restore
  1333                                          ret
  1334                                  %endif
  1335                                  %endif
  1336                                  
  1337                                  ;
  1338                                  ; word get_nvram_crc(word n);
  1339                                  ;	n = 31 (checks crc)
  1340                                  ;	n = 29 (forms crc)
  1341                                  ;
  1342                                  	global	get_nvram_crc_
  1343                                  get_nvram_crc_:
  1344 00000388 065153                  	pushm	bx,cx,es
  1345 0000038B 50                      	push	ax		; save count for nvram bytes
  1346                                  
  1347 0000038C B009                    	mov	al,1001B
  1348 0000038E E889FF                  	call	lites
  1349                                  
  1350 00000391 29C0                    	sub	ax,ax		; start CRC at 0000
  1351                                  %if 1
  1352 00000393 BB00F0                  	mov	bx,0xF000
  1353 00000396 8EC3                    	mov	es,bx
  1354 00000398 BBF0FF                  	mov	bx,0xFFF0
  1355 0000039B B91000                  	mov	cx,16
  1356 0000039E E8(0000)                	call	crc16
  1357                                  %endif
  1358 000003A1 6A4007                  	get_bda	ES
  1359 000003A4 BBE100                  	mov	bx,nvram_info
  1360 000003A7 59                      	pop	cx		; retrieve count in NVRAM
  1361 000003A8 E8(0000)                	call	crc16
  1362 000003AB 86E0                    	xchg	ah,al		; compensate for BIG Endian CRC16
  1363                                  
  1364 000003AD 5B5907                  	popm	bx,cx,es
  1365 000003B0 C3                      	ret
  1366                                  
  1367                                  	global	put_nvram_info_
  1368                                  put_nvram_info_:
  1369 000003B1 065350                  	pushm	ax,bx,es
  1370                                  
  1371 000003B4 B80022                     	mov	ax,0x2200		;disable write protect
  1372 000003B7 CD1A                    	int	0x1A
  1373                                  
  1374 000003B9 BBE100                  	mov	bx,nvram_info
  1375 000003BC 6A4007                  	get_bda	ES
  1376 000003BF B81F21                  	mov	ax,0x211F		; write 31 burst bytes
  1377 000003C2 CD1A                    	int	0x1A
  1378                                  
  1379 000003C4 B88022                  	mov	ax,0x2280		; set write protect
  1380 000003C7 CD1A                    	int	0x1A
  1381                                  
  1382 000003C9 585B07                  	popm	ax,bx,es
  1383 000003CC C3                      	ret
  1384                                  
  1385                                  
  1386                                  
  1387                                  
  1388                                  ;        setloc (0x100000-(ROM<<10)-16)
  1389 000003CD 90<rep 3h>              	align	16
  1390                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1391                                  ; The Real Mode statup jump
  1392                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1393                                  	bits	16
  1394 000003D0 EA[0000][ssss]          	jmp	far origin
  1395 000003D5 FF<rep 9h>              	times 9 db 0FFh
  1396 000003DE FC00                    	db	0FCh, 00h		; PC/AT
  1397                                  
  1398                                  segment BOOT
  1399                                  %include "boot.asm"
  1400                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1401                              <1> ;boot.asm
  1402                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1403                              <1> ; The Real Mode statup jump
  1404                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1405                              <1> 	bits	16
  1406                              <1> 
  1407                              <1> SEGBASE equ 0x10000-(ROM<<6)
  1408                              <1> 
  1409 00000003 90<rep Dh>          <1>         align   16
  1410                              <1> bootstrap:
  1411 00000010 EA000000F0          <1>         jmp     SEGBASE:0000	; 5 byte real-mode far call
  1412                              <1> %include "date.inc"
  1413 00000015 30392F32372F3236    <2> 	db	"09/27/26"
  1413 0000001D FFFC00              <1> 	db	0xFF, 0xFC, 0x00	; PC/AT
