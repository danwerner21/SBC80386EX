   603                                  
   604                                  ;
   605                                  ; Test low 64K memory and ROM checksum
   606                                  ;
   607                                  ;
   608                                  ; Is this a warm start?
   609                                  ;
   610                                  ; The flag has to be read here, before the test of segment 0 below, because
   611                                  ; that test zeroes the whole first 64K and the BDA sits inside it -- which is
   612                                  ; also, conveniently, what clears the flag so that the start after this one
   613                                  ; is a cold one again.
   614                                  ;
   615                                  ; The answer is parked in the stack segment.  That is the 32K at A8000 which
   616                                  ; size_SRAM set SS to, and neither memory test reaches it: segment 0 covers
   617                                  ; 00000-0FFFF and test_1to8 covers 10000-9FFFF.  SP starts at 8000h and
   618                                  ; grows down, so a word at offset 4 is 32K clear of anything the stack will
   619                                  ; ever touch, and seg_test has already been over that memory.
   620                                  ;
   621                                  WARM_MARK	equ	4	; word in the stack segment; see above
   622                                  
   623 000000E3 6A4007                  	get_bda	ES
   624 000000E6 26A17200                    es	mov	ax,[reset_flag]
   625 000000EA 36A30400                    ss	mov	[WARM_MARK],ax
   626                                  
   627 000000EE B001                    	mov	al,0001b	; show '0001' in the LITES
   628 000000F0 E82702                  	call	lites
   629                                  ;
   630                                  ; Test and zero the entirety of SEGMENT 0x0000:xxxx
   631                                  ;
   632 000000F3 31F6                    	xor	si,si
   633 000000F5 8EC6                    	mov	es,si		; select segment 0
   634 000000F7 BA0040                  	mov	dx,1<<14	; 16K dwords = 64K bytes
   635 000000FA E8F101                  	call	seg_test
   636                                  
