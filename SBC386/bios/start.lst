  1208                                  ; lites -- show a 4-bit value in the lites
  1209                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1210                                  ;
  1211                                  ;    Enter with:
  1212                                  ;	AL	set to value to display (0h..0Fh)
  1213                                  ;
  1214                                  ;    Exit with:
  1215                                  ;	All registers preserved
  1216                                  ;
  1217                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
