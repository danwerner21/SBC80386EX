  1257                                  %if 1
  1258                                  	global	eout,dout,wout,bout,nout
  1259                                  ; Hexadecimal output:
  1260                                  ; extdword(EAX)
  1261                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1262                                  ;
