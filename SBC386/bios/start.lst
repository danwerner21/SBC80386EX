   422                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   423                                  ; initb_cx	primitive entry
   424                                  ; initb		callable entry (but uses CX)
   425                                  ;
   426                                  ;    Enter with:
   427                                  ;
   428                                  ;	DS:SI	pointing at the table of BYTES to init.
   429                                  ;	CX	used to hold the return address
   430                                  ;
   431                                  ;    Exit with:
   432                                  ;	AX,DX	trashed
   433                                  ;	CX	used to hold the return
   434                                  ;	SI	updated
   435                                  ;
   436                                  ;	All other registers preserved
   437                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   438                                  	global	initb
   439                                  initb:
   440 00000040 59                              pop     cx
   441                                  initb_cx:
   442 00000041 AD                      	lodsw                   ; get destination port
   443 00000042 89C2                            mov     dx,ax		; put where useful
   444 00000044 40                              inc     ax              ; test for EOF
   445 00000045 7404                    	jz	.9		; EOF? if so, return
   446                                  
   447 00000047 AC                      	lodsb                   ; get port value
   448 00000048 EE                              out     dx,al           ; output port value
   449 00000049 EBF6                            jmp     initb_cx
   450                                  .9:
   451 0000004B FFE1                            jmp     cx              ; EOF, return
   452                                  
   453                                  
   454                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   455                                  ; initw_cx	primitive entry
   456                                  ; initw		callable entry (but uses CX)
   457                                  ;
   458                                  ;    Enter with:
   459                                  ;
   460                                  ;	DS:SI	pointing at the table of WORDS to init.
   461                                  ;	CX	used to hold the return address
   462                                  ;
   463                                  ;    Exit with:
   464                                  ;	AX,DX	trashed
   465                                  ;	CX	used to hold the return
   466                                  ;	SI	updated
   467                                  ;
   468                                  ;	All other registers preserved
   469                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   470                                  initw:
   471 0000004D 59                              pop     cx
   472                                  initw_cx:
