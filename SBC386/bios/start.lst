   735                                  	extern	uart_det_
   736                                  ;;;	mov	ax,RBR0
   737                                  	mov	ax,0x03F8	;;; see what is on-chip
   738                                  ; this call will trash AX,BX,CX,DX
   739                                  	call	uart_det_
   740                                  ; this detection code confirms that the UART on the 386EX is a 16450
   741                                  
   742                                  %if 1
   743                                  	mov	dx,0x4FF	; jrc LEDs
   744                                  	out	dx,al
   745                                  %endif
   746                                  	popa
