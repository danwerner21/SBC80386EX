   280                                  	winit	CS3MSKH, 0x0000
   147 0000014C 1EF4                <1>  dw %1
   148 0000014E 0000                <1>  dw %2
   281                                  	winit	CS3MSKL, 0xF800 | BIT10+BIT0
   147 00000150 1CF4                <1>  dw %1
