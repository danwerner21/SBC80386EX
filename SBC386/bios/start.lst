  1153                                  ; seg_test -- test a segment of memory (variable size)
  1154                                  ; seg_test_bx	ditto, but returns through BX
  1155                                  ;
  1156                                  ;    Enter with:
  1157                                  ;	ES:SI	points at area to test
  1158                                  ;	DX	count of size of area in DWORDS (16K==full segment)
  1159                                  ;
  1160                                  ;    Exit with:
  1161                                  ;	ES:SI	unchanged
  1162                                  ;	DX	unchanged
  1163                                  ;	memory area is cleared to Zeroes if successful
  1164                                  ;
  1165                                  ;    Error Condition:
  1166                                  ;	*** WILL HALT ***	so have the LITES set up
  1167                                  ;
  1168                                  ;    Trashes:
  1169                                  ;	EAX
  1170                                  ;	BX	is used for the return
  1171                                  ;	CX
  1172                                  ;	DI
  1173                                  ;
