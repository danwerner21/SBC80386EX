    22                                  ;
    23                                  ; SBC-386 board revisions:
    24                                  ;       SBC386-0   prototype / concept testing
    25                                  ;	SBC-386EX 2.0	production / January 2018
    26                                  ;
    27                                  ; Assembly by NASM 2.08 is preferred
    28                                  ;
    29                                  %define P3_FPU_CHECK 	0
    30                                  %define wFPU 		1
    31                                  %define HALF_MEM 	0		; 1 = exclude DRAM that overlaps the ROM
    32                                  				; 0 = DRAM & ROM overlap
    33                                  %define SHADOW_MODE 	1		; shadow ROM in DRAM
    34                                  %define WATCH_BUS 	1		; Watchdog timer monitors bus
    35                                  
    36                                  ; Shadowing copies the ROM into the DRAM underneath it, which is exactly the
    37                                  ; DRAM that HALF_MEM exists to exclude.  The two cannot both be set; say so
    38                                  ; at assembly time rather than leaving a build that copies 64K into nothing
    39                                  ; and then jumps to it.
    40                                  %if SHADOW_MODE
    41                                   %if HALF_MEM
    42                                    %error "SHADOW_MODE needs the DRAM under F0000 that HALF_MEM excludes"
    43                                   %endif
    44                                  %endif
    45                                  
    46                                  ;%define MFPIC 		1	; no COMCLK, use MFPIC (defined in i386ex.inc)
    47                                  
    48                                  %define	PATT 41			; 41, 37, 33
    49                                  %ifndef CRC
    50                                  %define CRC 0
    51                                  %endif
    52                                  %ifndef CRC_AT
    53                                  %define CRC_AT 0xFFEE
    54                                  %endif
    55                                  
