    59                                  %include "macro.inc"
    60                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    61                              <1> ;
    62                              <1> ; some useful macros:
    63                              <1> ;
    64                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    65                              <1> %define NREPEAT 0
    66                              <1> 
    67                              <1> %if NREPEAT
    68                              <1> 
    69                              <1> %macro	rep	1
    70                              <1> %%loop:	%1
    71                              <1> 	dec	cx
    72                              <1> 	jnz	%%loop
    73                              <1> %endm
    74                              <1> 
    75                              <1> %macro	repne	1
    76                              <1> %%loop:	%1
    77                              <1> 	je	%%e
    78                              <1> 	dec	cx
    79                              <1> 	jnz	%%loop
    80                              <1> 	cmp	cx,1
    81                              <1> 	jmp	%%done
    82                              <1> %%e:	dec	cx
    83                              <1> 	cmp	cx,cx
    84                              <1> %%done:
    85                              <1> %endm
    86                              <1> 
    87                              <1> %macro	repe	1
    88                              <1> %%loop:	%1
    89                              <1> 	jne	%%ne
    90                              <1> 	dec	cx
    91                              <1> 	jnz	%%loop
    92                              <1> 	jmp	%%done
    93                              <1> %%ne:	dec	cx
    94                              <1> 	jcxz	%%cxz
    95                              <1> 	jmp	%%done
    96                              <1> %%cxz:	cmp	cx,1
    97                              <1> %%done:
    98                              <1> %endm
    99                              <1> 
   100                              <1> %macro	REP	1
   101                              <1> %%loop:	%1
   102                              <1> 	dec	ecx
   103                              <1> 	jnz	%%loop
   104                              <1> %endm
   105                              <1> 
   106                              <1> %macro	REPNE	1
   107                              <1> %%loop:	%1
   108                              <1> 	je	%%e
   109                              <1> 	dec	ecx
   110                              <1> 	jnz	%%loop
   111                              <1> 	cmp	cl,1
   112                              <1> 	jmp	%%done
   113                              <1> %%e:	dec	ecx
   114                              <1> 	cmp	cl,cl
   115                              <1> %%done:
   116                              <1> %endm
   117                              <1> 
   118                              <1> %macro	REPE	1
   119                              <1> %%loop:	%1
   120                              <1> 	jne	%%ne
   121                              <1> 	dec	ecx
   122                              <1> 	jnz	%%loop
   123                              <1> 	jmp	%%done
   124                              <1> %%ne:	dec	ecx
   125                              <1> 	jecxz	%%cxz
   126                              <1> 	jmp	%%done
   127                              <1> %%cxz:	cmp	cl,1
   128                              <1> %%done:
   129                              <1> %endm
   130                              <1> 
   131                              <1> %endif
   132                              <1> 
   133                              <1> 
   134                              <1> ;
   135                              <1> ; format of the BYTE initialization table:  address, byte
   136                              <1> ;
   137                              <1> %imacro  binit 2
   138                              <1>         dw      %1
   139                              <1>         db      %2
   140                              <1> %endmacro
   141                              <1> ; end with DW -1
   142                              <1> 
   143                              <1> ;
   144                              <1> ; format of the WORD initialization table:  address, word
   145                              <1> ;
   146                              <1> %imacro  winit 2
   147                              <1>         dw      %1
   148                              <1>         dw      %2
   149                              <1> %endmacro
   150                              <1> ; end with DW -1
   151                              <1> 
   152                              <1> 
   153                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   154                              <1> %imacro get_bda	1.nolist
   155                              <1> 	push	0x0040
   156                              <1> 	pop	%1
   157                              <1> 	cnop
   158                              <1> %endm
   159                              <1> 
   160                              <1> 
   161                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   162                              <1> %imacro	get_loc0 1.nolist
   163                              <1> 	push	0x0000
   164                              <1> 	pop	%1
   165                              <1> 	cnop
   166                              <1> %endm
   167                              <1> 
   168                              <1> 
   169                              <1> 
   170                              <1> %imacro setloc  1.nolist
   171                              <1>  times   (%1-($-$$)) db 0FFh
   172                              <1> %endm
   173                              <1> 
   174                              <1> %imacro db_lo   1
   175                              <1>  db (%1)&255
   176                              <1> %endm
   177                              <1> 
   178                              <1> %imacro cnop    0.nolist
   179                              <1> %ifdef SOFT_DEBUG
   180                              <1> %if SOFT_DEBUG
   181                              <1>         nop
   182                              <1> %endif
   183                              <1> %endif
   184                              <1> %endm
   185                              <1> 
   186                              <1> %imacro popm 1-*.nolist
   187                              <1> %rep %0
   188                              <1> %ifidni %1,ALL
   189                              <1>  popa
   190                              <1> %elifidni %1,F
   191                              <1>  popf
   192                              <1> %else
   193                              <1>  pop %1
   194                              <1> %ifidni %1,DS
   195                              <1>  cnop
   196                              <1> %elifidni %1,ES
   197                              <1>  cnop
   198                              <1> %elifidni %1,FS
   199                              <1>  cnop
   200                              <1> %elifidni %1,GS
   201                              <1>  cnop
   202                              <1> %endif
   203                              <1> %endif
   204                              <1> %rotate 1
   205                              <1> %endrep
   206                              <1> %endm
   207                              <1> 
   208                              <1> %imacro pushm 1-*.nolist
   209                              <1> %rep %0
   210                              <1> %rotate -1
   211                              <1> %ifidni %1,ALL
   212                              <1>  pusha
   213                              <1> %elifidni %1,F
   214                              <1>  pushf
   215                              <1> %else
   216                              <1>  push %1
   217                              <1> %endif
   218                              <1> %endrep
   219                              <1> %endm
   220                              <1> 
   221                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   222                              <1> %assign __size__ (%2-1)	| 0xFF
   223                              <1> %if (__size__ <= 0xFFFF)
   224                              <1> %assign __gran__ 0
   225                              <1> %else
   226                              <1> %assign __gran__ 0xC0			; G B 0 0
   227                              <1> %endif
   228                              <1> %assign __expand__ 0
   229                              <1> %if %0==3
   230                              <1> %if %3
   231                              <1> %assign __expand__ 4
   232                              <1> %endif
   233                              <1> %endif
   234                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   235                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   236                              <1> %endm
   237                              <1> 
   238                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   239                              <1> %assign __size__ (%2-1)	| 0xFF
   240                              <1> %if (__size__ <= 0xFFFF)
   241                              <1> %assign __gran__ 0
   242                              <1> %else
   243                              <1> %assign __gran__ 0xC0			; G D 0 0
   244                              <1> %endif
   245                              <1> %assign __conform__ 0
   246                              <1> %if %0==3
   247                              <1> %if %3
   248                              <1> %assign __conform__ 4
   249                              <1> %endif
   250                              <1> %endif
   251                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   252                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   253                              <1> %endm
   254                              <1> 
   255                              <1> ;/* End of macro.inc */
