   404                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   405                                  ; initb_cx	primitive entry
   406                                  ; initb		callable entry (but uses CX)
   407                                  ;
   408                                  ;    Enter with:
   409                                  ;
   410                                  ;	DS:SI	pointing at the table of BYTES to init.
   411                                  ;	CX	used to hold the return address
   412                                  ;
   413                                  ;    Exit with:
   414                                  ;	AX,DX	trashed
   415                                  ;	CX	used to hold the return
   416                                  ;	SI	updated
   417                                  ;
   418                                  ;	All other registers preserved
   419                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   420                                  	global	initb
   421                                  initb:
   422 00000040 59                              pop     cx
   423                                  initb_cx:
   424 00000041 AD                      	lodsw                   ; get destination port
   425 00000042 89C2                            mov     dx,ax		; put where useful
   426 00000044 40                              inc     ax              ; test for EOF
   427 00000045 7404                    	jz	.9		; EOF? if so, return
   428                                  
   429 00000047 AC                      	lodsb                   ; get port value
   430 00000048 EE                              out     dx,al           ; output port value
   431 00000049 EBF6                            jmp     initb_cx
   432                                  .9:
   433 0000004B FFE1                            jmp     cx              ; EOF, return
   434                                  
   435                                  
   436                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   437                                  ; initw_cx	primitive entry
   438                                  ; initw		callable entry (but uses CX)
   439                                  ;
   440                                  ;    Enter with:
   441                                  ;
   442                                  ;	DS:SI	pointing at the table of WORDS to init.
   443                                  ;	CX	used to hold the return address
   444                                  ;
   445                                  ;    Exit with:
   446                                  ;	AX,DX	trashed
   447                                  ;	CX	used to hold the return
   448                                  ;	SI	updated
   449                                  ;
   450                                  ;	All other registers preserved
   451                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   452                                  initw:
   453 0000004D 59                              pop     cx
   454                                  initw_cx:
   455 0000004E AD                      	lodsw                   ; get destination port
   456 0000004F 89C2                            mov     dx,ax		; put where useful
   457 00000051 40                              inc     ax              ; test for EOF
   458 00000052 7404                    	jz	.9		; EOF? if so, return
   459                                  
   460 00000054 AD                      	lodsw                   ; get port value
   461 00000055 EF                              out     dx,ax           ; output to word port
   462 00000056 EBF6                            jmp     initw_cx
   463 00000058 FFE1                    .9:	jmp	cx		; EOF, return
