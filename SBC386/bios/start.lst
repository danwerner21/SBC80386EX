   701                                  
   702                                  ; set up the refresh counter correctly
   703 00000125 89D8                    	mov	ax,bx		; count in khz
   704 00000127 83C005                  	add	ax,5		; round up a bit
   705 0000012A C1E806                  	shr	ax,6		; divide by 64khz
   706 0000012D BAA2F4                  	mov	dx,RFSCIR	; Refresh Count
   707 00000130 EF                      	out	dx,ax
