   848 0000018D 061E575652515350        	pushm	ax,bx,cx,dx,si,di,ds,es
   849 00000195 FA                      	cli				; belt and braces: the vectors at
   850                                  					;  0000:0000 are not built yet, so an
   851                                  					;  interrupt taken here has nowhere to go
   852 00000196 FC                      	cld
   853                                  
   854                                  ; 1 -- the ROM into the scratch segment
   855 00000197 8CC8                    	mov	ax,cs			; F000, the ROM
   856 00000199 8ED8                    	mov	ds,ax
   857                                  	cnop
   858 0000019B B80020                  	mov	ax,SHADOW_SEG
   859 0000019E 8EC0                    	mov	es,ax
   860                                  	cnop
   861 000001A0 31F6                    	xor	si,si
   862 000001A2 31FF                    	xor	di,di
   863 000001A4 B90080                  	mov	cx,SHADOW_WORDS
   864 000001A7 F3A5                    	rep	movsw
   865                                  
   866 000001A9 31F6                    	xor	si,si			; and check it arrived
   867 000001AB 31FF                    	xor	di,di
   868 000001AD B90080                  	mov	cx,SHADOW_WORDS
   869 000001B0 F3A7                    	repe	cmpsw
   870 000001B2 7536                    	jne	.9			; scratch DRAM will not hold it;
   871                                  					;  leave the ROM alone and say nothing
   872                                  
   873                                  ; 2 -- into the copy.  CS is the scratch segment from here.
   874 000001B4 EA[B901]0020            	jmp	SHADOW_SEG:.in_ram
   875                                  .in_ram:
   876                                  
   877                                  ; 3 -- switch UCS off
   878 000001B9 BA3CF4                  	mov	dx,UCSMSKL		; the low mask carries the enable bit
   879 000001BC ED                      	in	ax,dx
   880 000001BD 24FE                    	and	al,~BIT0
   881 000001BF EF                      	out	dx,ax
   882                                  
   883                                  ; 4 -- the scratch back into F0000, which is DRAM now
   884 000001C0 B80020                  	mov	ax,SHADOW_SEG
   885 000001C3 8ED8                    	mov	ds,ax
   886                                  	cnop
   887 000001C5 B800F0                  	mov	ax,0xF000
   888 000001C8 8EC0                    	mov	es,ax
   889                                  	cnop
   890 000001CA 31F6                    	xor	si,si
   891 000001CC 31FF                    	xor	di,di
   892 000001CE B90080                  	mov	cx,SHADOW_WORDS
   893 000001D1 F3A5                    	rep	movsw
   894                                  
   895 000001D3 31F6                    	xor	si,si			; and check that one too
   896 000001D5 31FF                    	xor	di,di
   897 000001D7 B90080                  	mov	cx,SHADOW_WORDS
   898 000001DA F3A7                    	repe	cmpsw
   899 000001DC 7407                    	je	.5
