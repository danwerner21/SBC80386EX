  1076                                  ;****** debugging stuff ******
  1077                                  %if 1
  1078                                  	global	eout,dout,wout,bout,nout
  1079                                  ; Hexadecimal output:
  1080                                  ; extdword(EAX)
  1081                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1082                                  ;
  1083 000002BB 66C1C810                eout:   ror     eax,16          ; put out high word first
  1084 000002BF E80C00                          call    wout
  1085 000002C2 66C1E810                        shr     eax,16          ; put out the low word
  1086 000002C6 EB06                            jmp     wout
  1087 000002C8 92                      dout:   xchg    ax,dx           ; put out DX first
  1088 000002C9 E80200                          call    wout
  1089 000002CC 89D0                            mov     ax,dx
  1090 000002CE 86E0                    wout:   xchg    ah,al           ; put out AH first
  1091 000002D0 E80200                          call    bout
  1092 000002D3 88E0                            mov     al,ah           ; put out former AL
  1093 000002D5 50                      bout:   push    ax              ; save AL
  1094 000002D6 C0E804                          shr     al,4            ; position High nibble
  1095 000002D9 E80100                          call    nout            ; write high nibble
  1096 000002DC 58                              pop     ax
  1097 000002DD 240F                    nout:   and     al,0x0F         ; mask low nibble
  1098 000002DF 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1099 000002E0 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1100 000002E2 1440                            adc     al,0x40         ; form HEX digit
  1101 000002E4 EB0F                            jmp     putc            ; 'putc' does the return
  1102                                  
  1103                                  
  1104                                  
  1105                                  ;
  1106                                  ; output an ASCII_SP to the console
  1107                                  ;
  1108                                  space:
  1109 000002E6 B020                    	mov	al,ASCII_SP
  1110 000002E8 EB0B                    	jmp	putc
  1111                                  ;
  1112                                  ; output a CR/LF to the console
  1113                                  ;
  1114                                  ;;crlf:
  1115                                  ;
  1116                                  ; outc -- write an ASCII 'cooked' character
  1117                                  ;       Convert NL to CR,NL
  1118                                  ;
  1119                                  outc:
  1120 000002EA 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1121 000002EC 7507                            jne     putc            ; if not, just put out the character
  1122                                  crlf:
  1123 000002EE B00D                            mov     al,ASCII_CR     ; get a CR
  1124 000002F0 E80200                          call    putc            ; write it out
  1125 000002F3 B00A                            mov     al,ASCII_NL     ; restore NL
  1126                                  ;
  1127                                  ; putc -- put out a character in AL to the SIO0 port
  1128                                  ;
  1129                                  putc:
  1130                                  %if 1
  1131 000002F5 5052                    	pushm	dx,ax
  1132 000002F7 B401                    	mov	ah,1		;write char
  1133 000002F9 BA0000                  	mov	dx,0
  1134 000002FC CD14                    	int	14h		;serial out
  1135 000002FE 5A58                    	popm	dx,ax
  1136 00000300 C3                      	ret
  1137                                  %else
  1138                                  	push	dx		; register save
  1139                                  	push	ax		; PUSH EAX
  1140                                  putc1:
  1141                                          mov     dx,LSR0         ; Line Status Register
  1142                                  
  1143                                          in      al,dx
  1144                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1145                                          jz      putc1
  1146                                  
  1147                                          pop     ax
  1148                                          mov     dx,TBR0         ; Transmit buffer register
  1149                                          out     dx,al           ; send the character
  1150                                  
  1151                                          pop     dx              ; register restore
  1152                                          ret
  1153                                  %endif
  1154                                  %endif
