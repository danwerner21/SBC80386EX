   807                                  %if SHADOW_MODE
   808                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   809                                  ; Shadow the ROM into DRAM
   810                                  ;
   811                                  ; The BIOS executes from 8-bit ROM at 5 wait states, and every INT 10h
   812                                  ; character and every IDE sector pays for it.  CS2 already covers the whole
   813                                  ; first megabyte of DRAM -- 16 bits wide at 2 wait states -- and the two
   814                                  ; overlap at F0000.  While UCS is enabled it is the one that answers there,
   815                                  ; so the ROM cannot simply be copied over itself: the copy has to run from
   816                                  ; somewhere else while UCS is switched off.
   817                                  ;
   818                                  ;   1. copy the ROM to a scratch segment, and check it arrived
   819                                  ;   2. jump into that copy, so execution is no longer inside the ROM
   820                                  ;   3. switch UCS off -- F0000 answers from DRAM from here on
   821                                  ;   4. copy the scratch back to F0000, and check it arrived
   822                                  ;   5. jump back to F000, which is now the DRAM copy
   823                                  ;
   824                                  ; Either check can fail without consequence.  A failure at step 1 leaves the
   825                                  ; ROM exactly as it was; a failure at step 4 switches UCS back on and returns
   826                                  ; to the real ROM.  Slower, but running.  Neither is expected -- but the DRAM
   827                                  ; under F0000 is the one part of the first megabyte that test_1to8 does not
   828                                  ; reach, and this is what writes to it, so it gets checked here instead.
   829                                  ;
   830                                  ; Between step 3 and the end of step 4, nothing may read DGROUP data or call
   831                                  ; anything that does: DS-relative reads land at F0000, which is uninitialised
   832                                  ; DRAM until that copy finishes.  That is why this stretch is bare string
   833                                  ; moves and port writes, with DS pointed at the scratch and not at DGROUP.
   834                                  ;
   835                                  ; This is done here rather than earlier because it needs DRAM that has been
   836                                  ; tested, and it must be before anything records a F000-relative address.
   837                                  ;
   838                                  ; One consequence worth knowing: F0000 is writable afterwards.  Writes into
   839                                  ; the BIOS used to fall on ROM and do nothing; now they land.  Nothing in
   840                                  ; this BIOS writes there -- _DATA and _BSS are empty by design -- but a stray
   841                                  ; far pointer that used to be harmless is not any more.
   842                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   843                                  SHADOW_SEG	equ	XFER_AD>>4	; scratch, inside the range just tested
   844                                  SHADOW_WORDS	equ	32768		; 64K, as words
   845                                  
   846                                  shadow_rom:
   847 0000018D 061E575652515350        	pushm	ax,bx,cx,dx,si,di,ds,es
   848 00000195 FA                      	cli				; belt and braces: the vectors at
   849                                  					;  0000:0000 are not built yet, so an
   850                                  					;  interrupt taken here has nowhere to go
   851 00000196 FC                      	cld
   852                                  
   853                                  ; 1 -- the ROM into the scratch segment
   854 00000197 8CC8                    	mov	ax,cs			; F000, the ROM
   855 00000199 8ED8                    	mov	ds,ax
   856                                  	cnop
   857 0000019B B80020                  	mov	ax,SHADOW_SEG
   858 0000019E 8EC0                    	mov	es,ax
   859                                  	cnop
   860 000001A0 31F6                    	xor	si,si
   861 000001A2 31FF                    	xor	di,di
   862 000001A4 B90080                  	mov	cx,SHADOW_WORDS
   863 000001A7 F3A5                    	rep	movsw
   864                                  
   865 000001A9 31F6                    	xor	si,si			; and check it arrived
   866 000001AB 31FF                    	xor	di,di
   867 000001AD B90080                  	mov	cx,SHADOW_WORDS
   868 000001B0 F3A7                    	repe	cmpsw
   869 000001B2 7536                    	jne	.9			; scratch DRAM will not hold it;
   870                                  					;  leave the ROM alone and say nothing
   871                                  
   872                                  ; 2 -- into the copy.  CS is the scratch segment from here.
   873 000001B4 EA[B901]0020            	jmp	SHADOW_SEG:.in_ram
   874                                  .in_ram:
   875                                  
   876                                  ; 3 -- switch UCS off
   877 000001B9 BA3CF4                  	mov	dx,UCSMSKL		; the low mask carries the enable bit
   878 000001BC ED                      	in	ax,dx
   879 000001BD 24FE                    	and	al,~BIT0
   880 000001BF EF                      	out	dx,ax
   881                                  
   882                                  ; 4 -- the scratch back into F0000, which is DRAM now
   883 000001C0 B80020                  	mov	ax,SHADOW_SEG
   884 000001C3 8ED8                    	mov	ds,ax
   885                                  	cnop
   886 000001C5 B800F0                  	mov	ax,0xF000
   887 000001C8 8EC0                    	mov	es,ax
   888                                  	cnop
   889 000001CA 31F6                    	xor	si,si
   890 000001CC 31FF                    	xor	di,di
   891 000001CE B90080                  	mov	cx,SHADOW_WORDS
   892 000001D1 F3A5                    	rep	movsw
   893                                  
   894 000001D3 31F6                    	xor	si,si			; and check that one too
   895 000001D5 31FF                    	xor	di,di
   896 000001D7 B90080                  	mov	cx,SHADOW_WORDS
   897 000001DA F3A7                    	repe	cmpsw
   898 000001DC 7407                    	je	.5
   899                                  
   900                                  ; The DRAM under the ROM will not hold it.  Put UCS back, and the far jump
   901                                  ; below returns to the real ROM instead of to a copy that is not there.
   902 000001DE BA3CF4                  	mov	dx,UCSMSKL
   903 000001E1 ED                      	in	ax,dx
   904 000001E2 0C01                    	or	al,BIT0
   905 000001E4 EF                      	out	dx,ax
   906                                  .5:
   907                                  
   908                                  ; 5 -- back to F000, shadowed or not
   909 000001E5 EA[EA01]00F0            	jmp	0xF000:.back
   910                                  .back:
   911                                  .9:
   912 000001EA 585B595A5E5F1F07        	popm	ax,bx,cx,dx,si,di,ds,es
   913                                  %endif
