  1035                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1036                                  ; lites -- show a 4-bit value in the lites
  1037                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1038                                  ;
  1039                                  ;    Enter with:
  1040                                  ;	AL	set to value to display (0h..0Fh)
  1041                                  ;
  1042                                  ;    Exit with:
  1043                                  ;	All registers preserved
  1044                                  ;
  1045                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1046                                  	global	lites_
  1047                                  lites_:
  1048                                  lites:
  1049 00000293 52509C                  	pushm	f,ax,dx
  1050                                  
  1051 00000296 BA62F8                  	mov	dx,P1LTC	; get the LITES latch
  1052 00000299 F6D0                    	not	al
  1053 0000029B C0E004                  	shl	al,4		; shift complement to position
  1054 0000029E 88C4                    	mov	ah,al		; save in AH
  1055 000002A0 FA                      	cli
  1056 000002A1 EC                      	in	al,dx		; read the latch
  1057 000002A2 240F                    	and	al,0Fh		; preserve bits
  1058 000002A4 08E0                    	or	al,ah		; set the new bits
  1059 000002A6 EE                      	out	dx,al		; put out the new LITES value
  1060                                  
  1061 000002A7 9D585A                  	popm	f,ax,dx
  1062 000002AA C3                      	ret
  1063                                  
