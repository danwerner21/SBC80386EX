   519                                  error_halt:
   520 00000061 FA                      	cli
   521 00000062 F4                      	hlt
   522 00000063 EBFD                    	jmp	$-1
   523                                  
   524                                  start1:
   525                                  ; test the Flags register
   526                                  %if 1
   527 00000065 B4D5                    	mov	ah,0xD5		;set the S, Z, A, P, C flags
   528 00000067 9E                      	sahf
   529 00000068 90                      	nop
   530 00000069 90                      	nop
   531 0000006A 73F5                    	jnc	error_halt
   532 0000006C 75F3                    	jnz	error_halt
   533 0000006E 79F1                    	jns	error_halt
   534 00000070 7BEF                    	jnp	error_halt
   535                                  
   536 00000072 F8                      	clc
   537 00000073 72EC                    	jc	error_halt
   538 00000075 30E4                    	xor	ah,ah
   539 00000077 72E8                    	jc	error_halt
   540 00000079 75E6                    	jnz	error_halt
   541 0000007B 9E                      	sahf
   542 0000007C 7AE3                    	jp	error_halt
   543 0000007E 78E1                    	js	error_halt
   544 00000080 74DF                    	jz	error_halt
   545 00000082 72DD                    	jc	error_halt
   546                                  
   547                                  %endif
   548                                  
   549                                  ; Enable access to the Expanded I/O ports (F000..FXXX)
   550 00000084 E423                            in	al,REMAPCFGH	; reset the state machine (state A)
   551 00000086 B80080                          mov     ax,0x8000
   552 00000089 E623                            out     REMAPCFGH,al	; move to (state B)
   553 0000008B 86E0                            xchg    ah,al
   554 0000008D E622                            out     REMAPCFGL,al	; move to (state C)
   555 0000008F E722                            out     REMAPCFG,ax	; move to (state D), sets ESE bit
   556                                  ; Expanded I/O is now available -- ESE bit is set
   557 00000091 FC                              cld                     ; do this as insurance (direction=forward)
   558                                  
   559 00000092 B8[ssss]                	mov	ax,DGROUP	; set up data area (CONST & CONST2)
   560 00000095 8ED8                    	mov	ds,ax		;  addressing thru DS
   561                                  	cnop
   562 00000097 8EC0                    	mov	es,ax		;  and ES
   563                                  	cnop
   564                                  
   565                                  ; Do the word port initialization
   566                                  ;
   567 00000099 BE[0001]                        mov     si,wtab1        ; get table address to SI
   568 0000009C B9[A100]                        mov     cx,return2      ; set return address
   569 0000009F EBAD                            jmp     initw_cx        ; simulate call
   570                                  return2:
   571                                  
   572                                  ; Do the byte port initialization
   573                                  ;
   574 000000A1 BE[8A01]                        mov     si,btab1        ; get table address to SI
   575 000000A4 B9[A900]                        mov     cx,return1      ; set return address
   576 000000A7 EB98                            jmp     initb_cx        ; simulate call
   577                                  return1:
   578                                  
   579                                  
   580                                  %if 1
   581 000000A9 BAFF04                  	mov	dx,0x4FF
   582 000000AC 88D0                    	mov	al,dl
   583 000000AE EE                      	out	dx,al		; Zap jrc LEDs to 0xFF
   584                                  %endif
   585                                  
   586 000000AF B003                    	mov al,0011b
   587 000000B1 E86602                  	call lites
   588                                  
   589                                  ; Size the SRAM
   590                                  
   591                                  size_SRAM:
   592 000000B4 BF00A8                  	mov	di,SRAM_AD>>4	; SRAM segment
   593 000000B7 8ED7                    	mov	ss,di		; set up SS
   594                                  	cnop
   595 000000B9 8EC7                    	mov	es,di		; set ES for later testing
   596                                  	cnop
   597 000000BB BA0020                  	mov	dx,(32<<8)	; DH=32, DL=0
   598                                  .2:
   599 000000BE 89D7                    	mov	di,dx		; get address
   600 000000C0 C1E70A                  	shl	di,10		; convert to Kilobytes
   601 000000C3 368815                     ss	mov	[di],dl		; store a byte
   602 000000C6 FEC2                       	inc	dl
   603 000000C8 38F2                    	cmp	dl,dh		; test up to 32K
   604 000000CA 72F2                    	jb	.2
   605                                  ; compute SRAM size
   606 000000CC 362A160000                 ss	sub	dl,[0]
   607 000000D1 C1E20A                     	shl	dx,10		; convert DL to DX=?? Kilobytes
   608 000000D4 89D4                    	mov	sp,dx		; SS:8000h is stack start for 32K SRAM
   609                                  
   610                                  ; test the SRAM
   611 000000D6 C1EA02                  	shr	dx,2		; count of DWORDs
   612 000000D9 31F6                    	xor	si,si		; ES:SI is area to test
   613 000000DB BB[E100]                	mov	bx, .3
   614 000000DE E90E02                  	jmp	seg_test_bx	; do the single bit test
   615                                  .3:  ; return here
   616                                  
   617                                  
   618                                  ; All okay with the SRAM
   619                                  ; We now have a stack, & can use CALL
   620                                  ;	shr	dx,8    (already shifted by 2) == Kbytes in DL
   621                                  ;   so we will just use DH as the Kilobyte count
   622                                  %if HALF_MEM | 1
   623 000000E1 89D5                    	mov	bp,dx		; Save SRAM size in BP for later
   624                                  %else
   625                                  	xor	bp,bp		; No SRAM, just DRAM was tested
   626                                  %endif
   627                                  
   628                                  
   629                                  ;
   630                                  ; Test low 64K memory and ROM checksum
   631                                  ;
   632                                  ;
   633                                  ; Is this a warm start?
   634                                  ;
   635                                  ; The flag has to be read here, before the test of segment 0 below, because
   636                                  ; that test zeroes the whole first 64K and the BDA sits inside it -- which is
   637                                  ; also, conveniently, what clears the flag so that the start after this one
   638                                  ; is a cold one again.
   639                                  ;
   640                                  ; The answer is parked in the stack segment.  That is the 32K at A8000 which
   641                                  ; size_SRAM set SS to, and neither memory test reaches it: segment 0 covers
   642                                  ; 00000-0FFFF and test_1to8 covers 10000-9FFFF.  SP starts at 8000h and
   643                                  ; grows down, so a word at offset 4 is 32K clear of anything the stack will
   644                                  ; ever touch, and seg_test has already been over that memory.
   645                                  ;
   646                                  WARM_MARK	equ	4	; word in the stack segment; see above
   647                                  
   648 000000E3 6A4007                  	get_bda	ES
   649 000000E6 26A17200                    es	mov	ax,[reset_flag]
   650 000000EA 36A30400                    ss	mov	[WARM_MARK],ax
   651                                  
   652 000000EE B001                    	mov	al,0001b	; show '0001' in the LITES
   653 000000F0 E82702                  	call	lites
   654                                  ;
   655                                  ; Test and zero the entirety of SEGMENT 0x0000:xxxx
   656                                  ;
   657 000000F3 31F6                    	xor	si,si
   658 000000F5 8EC6                    	mov	es,si		; select segment 0
   659 000000F7 BA0040                  	mov	dx,1<<14	; 16K dwords = 64K bytes
   660 000000FA E8F101                  	call	seg_test
   661                                  
   662                                  ; Will halt with '0001' in the LITES if there is a memory problem
   663                                  
   664                                  
   665                                  ; Calculate ROM CRC
   666                                  ;
   667                                  ; removed for debug purposes
   668                                  crc_computation:
   669                                  ;	mov	ax,cs
   670                                  ;	mov	es,ax		; ES:BX addresses ROM
   671                                  ;	cnop
   672                                  ;
   673                                  ;	xor	ax,ax
   674                                  ;	mov	bx,(CRC_AT+2)&0xFFFF	;start here
   675                                  ;	xor	cx,cx
   676                                  ;	xor	dx,dx		;overflow for 1's complement
   677                                  ; CRC16 computation
   678                                  	extern	crc16
   679                                  ;
   680                                  ;	call	crc16
   681                                  ;	or	ax,ax		; test for zero checksum
   682                                  ;	jz	.1
   683                                  ;	hlt
   684                                  .1:
   685                                  
   686                                  
   687                                  
   688                                  ; Determine the CPU frequency
   689                                  
   690                                  get_CLKOUT:
   691                                  %if MFPIC & 0
   692                                  	mov	bx,33000	; 33mhz clock
   693                                  %else
   694 000000FD BA34F8                  	mov	dx,TMRCFG	; Timer control
   695 00000100 B04B                    	mov	al,TIMER_RUN	;start counters 0 & 1
   696 00000102 EE                      	out	dx,al		; **
   697                                  
   698 00000103 BA20F0                  	mov	dx,OCW3M
   699 00000106 B04A                    	mov	al,BIT6+ZBIT5+ ZBIT4+BIT3 +BIT1+ZBIT0  ;IRreg
   700 00000108 EE                      	out	dx,al
   701                                  wait00:
   702 00000109 EB00                    	jmp	$+2
   703 0000010B EB00                    	jmp	$+2
   704 0000010D EB00                    	jmp	$+2
   705 0000010F EC                      	in	al,dx		;has an interrupt been generated
   706 00000110 A801                    	test	al,BIT0		; from Timer 0
   707 00000112 74F5                    	jz	wait00		;Out0 is still low
   708                                  
   709 00000114 BA34F8                  	mov	dx,TMRCFG
   710 00000117 B041                    	mov	al,TIMER_STOP	; turn off all the gates
   711 00000119 EE                      	out	dx,al
   712                                  
   713 0000011A BA41F0                  	mov	dx,TMR1		; read what is left in timer 1
   714 0000011D EC                      	in	al,dx		;low byte
   715 0000011E 88C3                    	mov	bl,al
   716 00000120 EC                      	in	al,dx		;high byte
   717 00000121 88C7                    	mov	bh,al
   718 00000123 F7D3                    	not	bx		; -count-1
   719                                  %endif
   720                                  %if MFPIC
   721                                  	mov	ax,bx
   722                                  	call	wout
   723                                  %endif
   724                                  ;
   725                                  
   726                                  ; set up the refresh counter correctly
   727 00000125 89D8                    	mov	ax,bx		; count in khz
   728 00000127 83C005                  	add	ax,5		; round up a bit
   729 0000012A C1E806                  	shr	ax,6		; divide by 64khz
   730 0000012D BAA2F4                  	mov	dx,RFSCIR	; Refresh Count
   731 00000130 EF                      	out	dx,ax
   732                                  
   733                                  ; put out CPU frequency message
   734                                  
   735 00000131 8D87F401                	lea	ax,[bx+500]	; round to nearest integer
   736 00000135 B9E803                  	mov	cx,1000
   737 00000138 31D2                    	xor	dx,dx
   738 0000013A F7F1                    	div	cx		;integer frequency
   739                                  %if 1
   740 0000013C BAFF04                  	mov	dx,0x4FF	; jrc LEDs
   741 0000013F EE                      	out	dx,al
   742                                  %endif
