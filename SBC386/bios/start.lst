   751 00000155 B002                    	mov	al,0010b	; show '0010' in the LITES
   752 00000157 E8C001                  	call	lites
   753                                  
   754                                  ;
   755                                  ; Test memory from 1000:0000h to 7000:FFFFh
   756                                  ;
   757                                  ; The size this arrives at has to be the same either way, since it is what
   758                                  ; reaches bda.memory_size: the loop below ends with AX one segment past the
   759                                  ; last one tested, and the warm path just starts there.
   760                                  %if HALF_MEM
   761                                  LAST_SEG	equ	0x8000
   762                                  %else
   763                                  LAST_SEG	equ	0xA000
   764                                  %endif
