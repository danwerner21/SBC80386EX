   980                                  ; seg_test -- test a segment of memory (variable size)
   981                                  ; seg_test_bx	ditto, but returns through BX
   982                                  ;
   983                                  ;    Enter with:
   984                                  ;	ES:SI	points at area to test
   985                                  ;	DX	count of size of area in DWORDS (16K==full segment)
   986                                  ;
   987                                  ;    Exit with:
   988                                  ;	ES:SI	unchanged
   989                                  ;	DX	unchanged
   990                                  ;	memory area is cleared to Zeroes if successful
   991                                  ;
   992                                  ;    Error Condition:
   993                                  ;	*** WILL HALT ***	so have the LITES set up
   994                                  ;
   995                                  ;    Trashes:
   996                                  ;	EAX
   997                                  ;	BX	is used for the return
   998                                  ;	CX
   999                                  ;	DI
  1000                                  ;
  1001                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1002                                  
  1003                                  seg_test:
  1004 00000267 5B                      	pop	bx
  1005                                  seg_test_bx:
  1006                                  
  1007 00000268 66B801000000            	mov	eax,1		; EAX = 0000_0001h
  1008                                  .4:
  1009 0000026E 31FF                    	xor	di,di		;
  1010 00000270 89D1                    	mov	cx,dx		; set DWORD count
  1011 00000272 F366AB                  	rep stosd		; store all of memory
  1012                                  
  1013 00000275 89D1                    	mov	cx,dx		; reset the count
  1014 00000277 31FF                    	xor	di,di		; reset start address
  1015 00000279 F366AF                  	repe	scasd		;
  1016 0000027C 7407                    	je	.5		; continue on no error
  1017                                  
  1018                                  %if 1
  1019 0000027E BAFF04                  	mov	dx,0x4FF
  1020 00000281 B0F5                    	mov	al,0xF5		; error code
  1021 00000283 EE                      	out	dx,al		; Zap jrc LEDs to 0xFF
  1022 00000284 F4                      	hlt			; with the LITES as set
  1023                                  %endif
  1024                                  
  1025 00000285 66D1E0                  .5:	shl	eax,1
  1026 00000288 73E4                    	jnc	.4
  1027                                  ; now zero the SRAM
  1028 0000028A 31FF                    	xor	di,di		; reset the start address
  1029 0000028C 89D1                    	mov	cx,dx		; reset the count
  1030 0000028E F366AB                  	rep	stosd		; zero the SRAM
  1031                                  
  1032 00000291 FFE3                    	jmp	bx	; return
  1033                                  
