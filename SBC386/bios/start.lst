  1209                                  ; lites -- show a 4-bit value in the lites
  1210                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1211                                  ;
  1212                                  ;    Enter with:
  1213                                  ;	AL	set to value to display (0h..0Fh)
  1214                                  ;
  1215                                  ;    Exit with:
  1216                                  ;	All registers preserved
  1217                                  ;
  1218                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
