   666                                  get_CLKOUT:
   667                                  %if MFPIC & 0
   668                                  	mov	bx,33000	; 33mhz clock
   669                                  %else
   670 000000FD BA34F8                  	mov	dx,TMRCFG	; Timer control
   671 00000100 B04B                    	mov	al,TIMER_RUN	;start counters 0 & 1
   672 00000102 EE                      	out	dx,al		; **
   673                                  
   674 00000103 BA20F0                  	mov	dx,OCW3M
   675 00000106 B04A                    	mov	al,BIT6+ZBIT5+ ZBIT4+BIT3 +BIT1+ZBIT0  ;IRreg
   676 00000108 EE                      	out	dx,al
   677                                  wait00:
   678 00000109 EB00                    	jmp	$+2
   679 0000010B EB00                    	jmp	$+2
   680 0000010D EB00                    	jmp	$+2
   681 0000010F EC                      	in	al,dx		;has an interrupt been generated
   682 00000110 A801                    	test	al,BIT0		; from Timer 0
   683 00000112 74F5                    	jz	wait00		;Out0 is still low
   684                                  
   685 00000114 BA34F8                  	mov	dx,TMRCFG
   686 00000117 B041                    	mov	al,TIMER_STOP	; turn off all the gates
   687 00000119 EE                      	out	dx,al
   688                                  
   689 0000011A BA41F0                  	mov	dx,TMR1		; read what is left in timer 1
   690 0000011D EC                      	in	al,dx		;low byte
   691 0000011E 88C3                    	mov	bl,al
   692 00000120 EC                      	in	al,dx		;high byte
   693 00000121 88C7                    	mov	bh,al
   694 00000123 F7D3                    	not	bx		; -count-1
   695                                  %endif
