  1387                                  ;        setloc (0x100000-(ROM<<10)-16)
  1388 000003CD 90<rep 3h>              	align	16
  1389                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1390                                  ; The Real Mode statup jump
  1391                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1392                                  	bits	16
  1393 000003D0 EA[0000][ssss]          	jmp	far origin
  1394 000003D5 FF<rep 9h>              	times 9 db 0FFh
  1395 000003DE FC00                    	db	0FCh, 00h		; PC/AT
