   285                              <1> 
   286                              <1> ;
   287                              <1> ;/* Clock Generation and Power Management
   288                              <1> ;*/
   289                              <1> defb    PWRCON  equ     0xF800
   290                              <1> defw    CLKPRS  equ     0xF804
   291                              <1> 
