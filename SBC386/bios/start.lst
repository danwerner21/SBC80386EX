   971                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   972                                  ; seg_test -- test a segment of memory (variable size)
   973                                  ; seg_test_bx	ditto, but returns through BX
   974                                  ;
   975                                  ;    Enter with:
   976                                  ;	ES:SI	points at area to test
   977                                  ;	DX	count of size of area in DWORDS (16K==full segment)
   978                                  ;
   979                                  ;    Exit with:
   980                                  ;	ES:SI	unchanged
   981                                  ;	DX	unchanged
   982                                  ;	memory area is cleared to Zeroes if successful
   983                                  ;
   984                                  ;    Error Condition:
   985                                  ;	*** WILL HALT ***	so have the LITES set up
   986                                  ;
   987                                  ;    Trashes:
   988                                  ;	EAX
   989                                  ;	BX	is used for the return
   990                                  ;	CX
   991                                  ;	DI
   992                                  ;
   993                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   994                                  
   995                                  seg_test:
   996 00000267 5B                      	pop	bx
   997                                  seg_test_bx:
   998                                  
   999 00000268 66B801000000            	mov	eax,1		; EAX = 0000_0001h
  1000                                  .4:
  1001 0000026E 31FF                    	xor	di,di		;
  1002 00000270 89D1                    	mov	cx,dx		; set DWORD count
  1003 00000272 F366AB                  	rep stosd		; store all of memory
  1004                                  
  1005 00000275 89D1                    	mov	cx,dx		; reset the count
  1006 00000277 31FF                    	xor	di,di		; reset start address
  1007 00000279 F366AF                  	repe	scasd		;
  1008 0000027C 7407                    	je	.5		; continue on no error
  1009                                  
  1010                                  %if 1
  1011 0000027E BAFF04                  	mov	dx,0x4FF
  1012 00000281 B0F5                    	mov	al,0xF5		; error code
  1013 00000283 EE                      	out	dx,al		; Zap jrc LEDs to 0xFF
  1014 00000284 F4                      	hlt			; with the LITES as set
  1015                                  %endif
  1016                                  
  1017 00000285 66D1E0                  .5:	shl	eax,1
  1018 00000288 73E4                    	jnc	.4
  1019                                  ; now zero the SRAM
  1020 0000028A 31FF                    	xor	di,di		; reset the start address
  1021 0000028C 89D1                    	mov	cx,dx		; reset the count
  1022 0000028E F366AB                  	rep	stosd		; zero the SRAM
  1023                                  
  1024 00000291 FFE3                    	jmp	bx	; return
