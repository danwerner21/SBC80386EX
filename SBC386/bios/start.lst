  1023                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1024                                  ; lites -- show a 4-bit value in the lites
  1025                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1026                                  ;
  1027                                  ;    Enter with:
  1028                                  ;	AL	set to value to display (0h..0Fh)
  1029                                  ;
  1030                                  ;    Exit with:
  1031                                  ;	All registers preserved
  1032                                  ;
  1033                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1034                                  	global	lites_
  1035                                  lites_:
  1036                                  lites:
  1037 000002A3 52509C                  	pushm	f,ax,dx
  1038                                  
  1039 000002A6 BA62F8                  	mov	dx,P1LTC	; get the LITES latch
  1040 000002A9 F6D0                    	not	al
  1041 000002AB C0E004                  	shl	al,4		; shift complement to position
  1042 000002AE 88C4                    	mov	ah,al		; save in AH
  1043 000002B0 FA                      	cli
  1044 000002B1 EC                      	in	al,dx		; read the latch
  1045 000002B2 240F                    	and	al,0Fh		; preserve bits
  1046 000002B4 08E0                    	or	al,ah		; set the new bits
  1047 000002B6 EE                      	out	dx,al		; put out the new LITES value
  1048                                  
  1049 000002B7 9D585A                  	popm	f,ax,dx
  1050 000002BA C3                      	ret
  1051                                  
  1052                                  	global	jleds_
  1053                                  jleds_:
