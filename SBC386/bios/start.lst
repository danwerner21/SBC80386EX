  1027                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1028                                  ; lites -- show a 4-bit value in the lites
  1029                                  ; lites_ -- Watcom C callable:   "int lites(int value);"
  1030                                  ;
  1031                                  ;    Enter with:
  1032                                  ;	AL	set to value to display (0h..0Fh)
  1033                                  ;
  1034                                  ;    Exit with:
  1035                                  ;	All registers preserved
  1036                                  ;
  1037                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1038                                  	global	lites_
  1039                                  lites_:
  1040                                  lites:
  1041 00000293 52509C                  	pushm	f,ax,dx
  1042                                  
  1043 00000296 BA62F8                  	mov	dx,P1LTC	; get the LITES latch
  1044 00000299 F6D0                    	not	al
  1045 0000029B C0E004                  	shl	al,4		; shift complement to position
  1046 0000029E 88C4                    	mov	ah,al		; save in AH
  1047 000002A0 FA                      	cli
  1048 000002A1 EC                      	in	al,dx		; read the latch
  1049 000002A2 240F                    	and	al,0Fh		; preserve bits
  1050 000002A4 08E0                    	or	al,ah		; set the new bits
  1051 000002A6 EE                      	out	dx,al		; put out the new LITES value
  1052                                  
  1053 000002A7 9D585A                  	popm	f,ax,dx
  1054 000002AA C3                      	ret
  1055                                  
  1056                                  	global	jleds_
  1057                                  jleds_:
