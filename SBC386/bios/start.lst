   443                              <1> defb	MSR_DCD	equ	BIT7
   444                              <1> defb	MSR_RI 	equ	BIT6
   445                              <1> defb	MSR_DSR	equ	BIT5
   446                              <1> defb	MSR_CTS	equ	BIT4
   447                              <1> defb	MSR_deltaDCD	equ	BIT3
   448                              <1> defb	MSR_deltaRI	equ	BIT2
   449                              <1> defb	MSR_deltaDSR	equ	BIT1
   450                              <1> defb	MSR_deltaCTS	equ	BIT0
   451                              <1> 
   452                              <1> ;/* Bits in CR0
   453                              <1> ;*/
   454                              <1> defb    CR0_PE  equ     BIT0
   455                              <1> defb    CR0_MP  equ     BIT1
   456                              <1> defb    CR0_EM  equ     BIT2
   457                              <1> defb    CR0_TS  equ     BIT3
