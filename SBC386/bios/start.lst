    81                              <1> ;
    82                              <1> ;
    83                              <1> ; SBC-386 board revisions:
    84                              <1> ;       SBC386-0   prototype / concept testing
    85                              <1> ;	SBC-386EX 2.0	production / January 2018
    86                              <1> ;
    87                              <1> ; Assembly by NASM 2.08 is preferred
    88                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    89                              <1> ;
    90                              <1> ;include "i386EX.inc" -- must be included at a higher level
    91                              <1> 
    92                              <1> TIMER_STOP	equ	BIT6+BIT0 + ZBIT1 + ZBIT3 + ZBIT5 ; stop 0, 1, 2
    93                              <1> TIMER_RUN	equ	TIMER_STOP + BIT1 + BIT3	; run counters 0, 1
    94                              <1> 
    95                              <1>         binit   TMRCFG, ZBIT7+TIMER_STOP ; bit6: s/w control of GATEn, bit7=0 enables all clocks
   138 00000000 34F8                <2>  dw %1
   139 00000002 41                  <2>  db %2
    96                              <1> 		;Timers enabled, 1&2 use PSCLK, 0 uses TMRCLK0 (COMCLK/2)
    97                              <1> CTR0 equ ZBIT7+ZBIT6	;select counter 0
    98                              <1> CTR1 equ ZBIT7+ BIT6	;select counter 1
    99                              <1> CTR2 equ  BIT7+ZBIT6	;select counter 2
   100                              <1> CWR01 equ BIT5+BIT4	;Write Count low, then high
   101                              <1> MODE0 equ ZBIT3+ZBIT2+ZBIT1
   102                              <1> MODE1 equ ZBIT3+ZBIT2+ BIT1
   103                              <1> MODE2 equ ZBIT3+ BIT2+ZBIT1
   104                              <1> MODE3 equ ZBIT3+ BIT2+ BIT1
   105                              <1> MODE4 equ  BIT3+ZBIT2+ZBIT1
   106                              <1> MODE5 equ  BIT3+ZBIT2+ BIT1
   107                              <1> ; counter 0 runs at 1.8432mhz / 2  =  921600  (just under 1mhz)
   108                              <1> ; @20hz, the divisor is 46080 yielding a 50ms time slot
   109                              <1> COMCLK	equ	1843200		; standard 1.8432mhz oscillator
   110                              <1> BAUD	equ	9600		; default SIO0 bit rate
   111                              <1> DIVISOR	equ	COMCLK/16/BAUD	; SIO0 divisor to achieve BAUD rate
   112                              <1> CLKIN0	equ	COMCLK/2	; Timer0 input count rate
   113                              <1> MS50	equ	CLKIN0 / 20	; 50ms clock
   114                              <1> MS50HI	equ	MS50/256
   115                              <1> MS50LO	equ	MS50 & 0xFF
   116                              <1> MS18	equ	50619		; 18.206602hz clock (54.92513ms)
   117                              <1> 				; 0x1800BA = 1573050 ticks/day
   118                              <1> MS18b	equ	50625		; 18.204444hz clock (54.93164ms)
   119                              <1> 				; 0x180000 = 1572864 ticks/day
   120                              <1> MS18HI	equ	MS18/256
   121                              <1> MS18LO	equ	MS18 & 0xFF
    61                                  %define XXX
    62                                  %include "bda.inc"
    63                              <1> XXX
    64                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
    65                              <1> %define BDA_segment 0x40
    66                              <1> struc _BDA
    67                              <1> ; first items at 0x40:0	*/
    68 00000000 ????????????????    <1> serial_dev	resw	4	; serial port device codes */
    69 00000008 ????????????????    <1> parallel_dev	resw	4	; printer port device codes */
    70 00000010 ????                <1> equip_flag	resw	1		; int 12h equipment flags */
    71 00000012 ??                  <1> mfg_test	resb	1		; initialization flags */
    72                              <1> ; */
    73                              <1> ; POST writes what it decided here, after the test of segment 0 has */
    74                              <1> ; zeroed the area, so the answer survives to be reported.  Nothing else */
    75                              <1> ; in this BIOS writes mfg_test.                                        */
    76                              <1> %define WARM_POST 0x01	; warm start: the memory march was skipped */
    77 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    78 00000015 ??                  <1> mfg_err_flag	resb	1
    79 00000016 ??                  <1> mfg_err_flag2	resb	1
    80                              <1> ; */
    81                              <1> ; first Keyboard data area */
    82 00000017 ??                  <1> kbd_flag	resb	1	; shift status &c. */
    83 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
    84 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
    85 0000001A ????                <1> buffer_head	resw	1
    86 0000001C ????                <1> buffer_tail	resw	1
    87                              <1> ; */
    88 0000001E <res 20h>           <1> kbd_buffer	resw	16	; buffer empty when  head==tail**/
    89                              <1> ; */
    90                              <1> ; Diskette data area */
    91 0000003E ??                  <1> seek_status	resb	1	; drive recalibration status */
    92                              <1> ; bits 3..0 drive must recalibrate before next seek */
    93 0000003F ??                  <1> motor_status	resb	1	; bits 3..0 motor running */
    94                              <1> ; bit 7 current op is write */
    95 00000040 ??                  <1> motor_count	resb	1	; timeout counter for motor turn-off */
    96 00000041 ??                  <1> fd_status	resb	1	; return code status byte */
    97 00000042 ??????????????      <1> fd_ctrl_stat	resb	7	; controller return bytes */
    98                              <1> ; */
    99                              <1> ; Video Display data area -- also used for video emulation */
   100 00000049 ??                  <1> vid_mode	resb	1	; current display mode */
   101 0000004A ????                <1> vid_columns	resw	1	; no. of columns on the screen */
   102 0000004C ????                <1> vid_buf_len	resw	1	; length of video buffer in bytes*//
   103 0000004E ????                <1> vid_start	resw	1	; start address of screen regeneration (in vid buf)*//
   104 00000050 <res 10h>           <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   105 00000060 ????                <1> vid_cursor_mode	resw	1
   106 00000062 ??                  <1> vid_active_page	resb	1
   107 00000063 ????                <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA)*//
   108 00000065 ??                  <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   109 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
   110                              <1> ; */
   111                              <1> ; POST and ROM data */
   112 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   113                              <1> %define io_rom_addr_low io_rom_addr
   114                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   115 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   116                              <1> ; */
   117                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   118 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
   119 0000006E ????                <1> timer_count_high	resw	1
   120                              <1> %define timer_count timer_count_low
   121                              <1> ; use timer_count as the double word timer counter */
   122 00000070 ??                  <1> timer_overflow	resb	1	; timer has rolled over since last read */
   123                              <1> ; */
   124                              <1> ; System & Keboard data area */
   125 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   126 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   127                              <1> ; */
   128                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
   129                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
   130                              <1> ; program can set it and jump to FFFF:0000 -- that is the PC convention  */
   131                              <1> ; and this BIOS honours it.                                             */
   132                              <1> %define WARM_BOOT 0x1234
   133                              <1> ; */
   134                              <1> ; Fixed (Hard) disk data area */
   135 00000074 ??                  <1> hd_status	resb	1	; status info for hard disk */
   136                              <1> %define disk_status1 hd_status
   137 00000075 ??                  <1> hd_number	resb	1	; number of hard disks (for int 13h, fn 8h) */
   138 00000076 ??                  <1> control_byte	resb	1	; head control ???? */
   139 00000077 ??                  <1> port_offset	resb	1	; obsolete, maybe ???? */
   140                              <1> ; */
   141                              <1> ; Timeout counters */
   142 00000078 ????????            <1> printer_timeout	resb	4	; four bytes for each interaace */
   143 0000007C ????????            <1> serial_timeout	resb	4	; four bytes for each interacce */
   144                              <1> ; */
   145                              <1> ; Keyboard additional data area -- buffer location within segment 40h */
   146 00000080 ????                <1> buffer_start	resw	1	; offset of keyboard buffer start**/
   147 00000082 ????                <1> buffer_end	resw	1		; offset of end of kbd buffer */
   148                              <1> ; */
   149                              <1> ; EGA/PGA? data work area (graphic mode?  probably available) */
   150 00000084 ??                  <1> ega_rows	resb	1		; rows on the active screen (less 1)**/
   151 00000085 ????                <1> ega_points	resw	1		; bytes per charateer	*/
   152 00000087 ??                  <1> ega_info	resb	1		; mode options ????*//
   153 00000088 ??                  <1> ega_info_3	resb	1		; switch settings*//
   154 00000089 ????                <1> ega_rsvd	resb	2	; reserved for adapter mfgrs */
   155                              <1> ; */
   156                              <1> ; Disk / Diskette media data */
   157 0000008B ??                  <1> fd_last_data_rate	resb	1	; last data rate selected */
   158 0000008C ??                  <1> hd_status_reg	resb	1		; hard disk status register */
   159 0000008D ??                  <1> hd_error_reg	resb	1		; hard disk error register */
   160 0000008E ??                  <1> hd_int_flag	resb	1	; HD interrupt flag */
   161 0000008F ??                  <1> hd_cntrl	resb	1		; HD/FD combo controller bit flag */
   162 00000090 ????                <1> hd_media	resb	2	; media state */
   163 00000092 ????                <1> hd_op_start	resb	2	; operation start state */
   164 00000094 ????                <1> hd_track	resw	1		; HD present cylinder number */
   165                              <1> ; */
   166                              <1> ; Additional Keyboard flags */
   167 00000096 ??                  <1> kbd_flag3	resb	1	; mode state & type flags */
