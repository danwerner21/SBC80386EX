   412                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   413                                  ; initb_cx	primitive entry
   414                                  ; initb		callable entry (but uses CX)
   415                                  ;
   416                                  ;    Enter with:
   417                                  ;
   418                                  ;	DS:SI	pointing at the table of BYTES to init.
   419                                  ;	CX	used to hold the return address
   420                                  ;
   421                                  ;    Exit with:
   422                                  ;	AX,DX	trashed
   423                                  ;	CX	used to hold the return
   424                                  ;	SI	updated
   425                                  ;
   426                                  ;	All other registers preserved
   427                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   428                                  	global	initb
   429                                  initb:
   430 00000040 59                              pop     cx
   431                                  initb_cx:
   432 00000041 AD                      	lodsw                   ; get destination port
   433 00000042 89C2                            mov     dx,ax		; put where useful
   434 00000044 40                              inc     ax              ; test for EOF
   435 00000045 7404                    	jz	.9		; EOF? if so, return
   436                                  
   437 00000047 AC                      	lodsb                   ; get port value
   438 00000048 EE                              out     dx,al           ; output port value
   439 00000049 EBF6                            jmp     initb_cx
   440                                  .9:
   441 0000004B FFE1                            jmp     cx              ; EOF, return
   442                                  
   443                                  
   444                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   445                                  ; initw_cx	primitive entry
   446                                  ; initw		callable entry (but uses CX)
   447                                  ;
   448                                  ;    Enter with:
   449                                  ;
   450                                  ;	DS:SI	pointing at the table of WORDS to init.
   451                                  ;	CX	used to hold the return address
   452                                  ;
   453                                  ;    Exit with:
   454                                  ;	AX,DX	trashed
   455                                  ;	CX	used to hold the return
   456                                  ;	SI	updated
   457                                  ;
   458                                  ;	All other registers preserved
   459                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   460                                  initw:
   461 0000004D 59                              pop     cx
   462                                  initw_cx:
   463 0000004E AD                      	lodsw                   ; get destination port
   464 0000004F 89C2                            mov     dx,ax		; put where useful
   465 00000051 40                              inc     ax              ; test for EOF
   466 00000052 7404                    	jz	.9		; EOF? if so, return
   467                                  
   468 00000054 AD                      	lodsw                   ; get port value
   469 00000055 EF                              out     dx,ax           ; output to word port
   470 00000056 EBF6                            jmp     initw_cx
   471 00000058 FFE1                    .9:	jmp	cx		; EOF, return
