  1084                                  ;****** debugging stuff ******
  1085                                  %if 1
  1086                                  	global	eout,dout,wout,bout,nout
  1087                                  ; Hexadecimal output:
  1088                                  ; extdword(EAX)
  1089                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1090                                  ;
  1091 000002BB 66C1C810                eout:   ror     eax,16          ; put out high word first
  1092 000002BF E80C00                          call    wout
  1093 000002C2 66C1E810                        shr     eax,16          ; put out the low word
  1094 000002C6 EB06                            jmp     wout
  1095 000002C8 92                      dout:   xchg    ax,dx           ; put out DX first
  1096 000002C9 E80200                          call    wout
  1097 000002CC 89D0                            mov     ax,dx
  1098 000002CE 86E0                    wout:   xchg    ah,al           ; put out AH first
  1099 000002D0 E80200                          call    bout
  1100 000002D3 88E0                            mov     al,ah           ; put out former AL
  1101 000002D5 50                      bout:   push    ax              ; save AL
  1102 000002D6 C0E804                          shr     al,4            ; position High nibble
  1103 000002D9 E80100                          call    nout            ; write high nibble
  1104 000002DC 58                              pop     ax
  1105 000002DD 240F                    nout:   and     al,0x0F         ; mask low nibble
  1106 000002DF 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1107 000002E0 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1108 000002E2 1440                            adc     al,0x40         ; form HEX digit
  1109 000002E4 EB0F                            jmp     putc            ; 'putc' does the return
  1110                                  
  1111                                  
  1112                                  
  1113                                  ;
  1114                                  ; output an ASCII_SP to the console
  1115                                  ;
  1116                                  space:
  1117 000002E6 B020                    	mov	al,ASCII_SP
  1118 000002E8 EB0B                    	jmp	putc
  1119                                  ;
  1120                                  ; output a CR/LF to the console
  1121                                  ;
  1122                                  ;;crlf:
  1123                                  ;
  1124                                  ; outc -- write an ASCII 'cooked' character
  1125                                  ;       Convert NL to CR,NL
  1126                                  ;
  1127                                  outc:
  1128 000002EA 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1129 000002EC 7507                            jne     putc            ; if not, just put out the character
  1130                                  crlf:
  1131 000002EE B00D                            mov     al,ASCII_CR     ; get a CR
  1132 000002F0 E80200                          call    putc            ; write it out
  1133 000002F3 B00A                            mov     al,ASCII_NL     ; restore NL
  1134                                  ;
  1135                                  ; putc -- put out a character in AL to the SIO0 port
  1136                                  ;
  1137                                  putc:
  1138                                  %if 1
  1139 000002F5 5052                    	pushm	dx,ax
  1140 000002F7 B401                    	mov	ah,1		;write char
  1141 000002F9 BA0000                  	mov	dx,0
  1142 000002FC CD14                    	int	14h		;serial out
  1143 000002FE 5A58                    	popm	dx,ax
  1144 00000300 C3                      	ret
  1145                                  %else
  1146                                  	push	dx		; register save
  1147                                  	push	ax		; PUSH EAX
  1148                                  putc1:
  1149                                          mov     dx,LSR0         ; Line Status Register
  1150                                  
  1151                                          in      al,dx
  1152                                          test    al,LSR_TBE      ; Transmit Buffer Empty
  1153                                          jz      putc1
  1154                                  
  1155                                          pop     ax
  1156                                          mov     dx,TBR0         ; Transmit buffer register
  1157                                          out     dx,al           ; send the character
  1158                                  
  1159                                          pop     dx              ; register restore
  1160                                          ret
  1161                                  %endif
  1162                                  %endif
