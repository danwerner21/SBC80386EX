   565                                  ; Size the SRAM
   566                                  
   567                                  size_SRAM:
   568 000000B4 BF00A8                  	mov	di,SRAM_AD>>4	; SRAM segment
   569 000000B7 8ED7                    	mov	ss,di		; set up SS
   570                                  	cnop
   571 000000B9 8EC7                    	mov	es,di		; set ES for later testing
   572                                  	cnop
   573 000000BB BA0020                  	mov	dx,(32<<8)	; DH=32, DL=0
   574                                  .2:
   575 000000BE 89D7                    	mov	di,dx		; get address
   576 000000C0 C1E70A                  	shl	di,10		; convert to Kilobytes
   577 000000C3 368815                     ss	mov	[di],dl		; store a byte
   578 000000C6 FEC2                       	inc	dl
   579 000000C8 38F2                    	cmp	dl,dh		; test up to 32K
   580 000000CA 72F2                    	jb	.2
   581                                  ; compute SRAM size
   582 000000CC 362A160000                 ss	sub	dl,[0]
   583 000000D1 C1E20A                     	shl	dx,10		; convert DL to DX=?? Kilobytes
   584 000000D4 89D4                    	mov	sp,dx		; SS:8000h is stack start for 32K SRAM
   585                                  
   586                                  ; test the SRAM
   587 000000D6 C1EA02                  	shr	dx,2		; count of DWORDs
   588 000000D9 31F6                    	xor	si,si		; ES:SI is area to test
   589 000000DB BB[E100]                	mov	bx, .3
   590 000000DE E90E02                  	jmp	seg_test_bx	; do the single bit test
   591                                  .3:  ; return here
   592                                  
   593                                  
   594                                  ; All okay with the SRAM
   595                                  ; We now have a stack, & can use CALL
   596                                  ;	shr	dx,8    (already shifted by 2) == Kbytes in DL
   597                                  ;   so we will just use DH as the Kilobyte count
   598                                  %if HALF_MEM | 1
   599 000000E1 89D5                    	mov	bp,dx		; Save SRAM size in BP for later
   600                                  %else
   601                                  	xor	bp,bp		; No SRAM, just DRAM was tested
   602                                  %endif
   603                                  
   604                                  
   605                                  ;
   606                                  ; Test low 64K memory and ROM checksum
   607                                  ;
   608                                  ;
   609                                  ; Is this a warm start?
   610                                  ;
   611                                  ; The flag has to be read here, before the test of segment 0 below, because
   612                                  ; that test zeroes the whole first 64K and the BDA sits inside it -- which is
   613                                  ; also, conveniently, what clears the flag so that the start after this one
   614                                  ; is a cold one again.
   615                                  ;
   616                                  ; The answer is parked in the stack segment.  That is the 32K at A8000 which
   617                                  ; size_SRAM set SS to, and neither memory test reaches it: segment 0 covers
   618                                  ; 00000-0FFFF and test_1to8 covers 10000-9FFFF.  SP starts at 8000h and
   619                                  ; grows down, so a word at offset 4 is 32K clear of anything the stack will
   620                                  ; ever touch, and seg_test has already been over that memory.
   621                                  ;
   622                                  WARM_MARK	equ	4	; word in the stack segment; see above
   623                                  
   624 000000E3 6A4007                  	get_bda	ES
   625 000000E6 26A17200                    es	mov	ax,[reset_flag]
   626 000000EA 36A30400                    ss	mov	[WARM_MARK],ax
   627                                  
   628 000000EE B001                    	mov	al,0001b	; show '0001' in the LITES
   629 000000F0 E82702                  	call	lites
   630                                  ;
   631                                  ; Test and zero the entirety of SEGMENT 0x0000:xxxx
   632                                  ;
   633 000000F3 31F6                    	xor	si,si
   634 000000F5 8EC6                    	mov	es,si		; select segment 0
   635 000000F7 BA0040                  	mov	dx,1<<14	; 16K dwords = 64K bytes
   636 000000FA E8F101                  	call	seg_test
   637                                  
   638                                  ; Will halt with '0001' in the LITES if there is a memory problem
   639                                  
