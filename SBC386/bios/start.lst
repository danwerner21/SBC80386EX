    88                              <1> ;/* i386EX.inc  --  register definitions for the Intel 80386EX processor
    89                              <1> ;
    90                              <1> %define defb
    91                              <1> %define defw
    92                              <1> %define defd
    93                              <1> ;*/
    94                              <1> 
    95                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
    96                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
    97                              <1> ;*  first thing it does, so anything that restarts the board in software has
    98                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
    99                              <1> ;*  hard way.
   100                              <1> ;*/
   101                              <1> defw    DEVICE_ID equ   0x2309
   102                              <1> 
   103                              <1> ;/* The Address Configuration register
   104                              <1> ;*/
   105                              <1> defb REMAPCFGH  equ     0x0023
   106                              <1> defb REMAPCFGL  equ     0x0022
   107                              <1> defw REMAPCFG   equ     0x0022
   108                              <1> 
   109                              <1> ;/* The A20gate and fast CPU Reset
   110                              <1> ;*/
   111                              <1> defb PORT92     equ     0xF092
   112                              <1> defb PORT92_AT  equ     0x0092
   113                              <1> 
   114                              <1> ;
   115                              <1> ;/* The DMA Controller and Bus Arbiter
   116                              <1> ;*/
   117                              <1> defb DMA0TAR    equ     0xF000
   118                              <1> defb DMA0TAR_AT equ     0x0000
   119                              <1> defb DMA0BYC    equ     0xF001
   120                              <1> defb DMA0BYC_AT equ     0x0001
   121                              <1> defb DMA1TAR    equ     0xF002
   122                              <1> defb DMA1TAR_AT equ     0x0002
   123                              <1> defb DMA1BYC    equ     0xF003
   124                              <1> defb DMA1BYC_AT equ     0x0003
   125                              <1> defb DMACMD1    equ     0xF008
   126                              <1> defb DMACMD1_AT equ     0x0008
   127                              <1> defb DMASTS     equ     0xF008
   128                              <1> defb DMASTS_AT  equ     0x0008
   129                              <1> defb DMASRR     equ     0xF009
   130                              <1> defb DMASRR_AT  equ     0x0009
   131                              <1> defb DMAMSK     equ     0xF00A
   132                              <1> defb DMAMSK_AT  equ     0x000A
   133                              <1> defb DMAMOD1    equ     0xF00B
   134                              <1> defb DMAMOD1_AT equ     0x000B
   135                              <1> defb DMACLRBP   equ     0xF00C
   136                              <1> defb DMACLRBP_AT equ    0x000C
   137                              <1> defb DMACLR     equ     0xF00D
   138                              <1> defb DMACLR_AT  equ     0x000D
   139                              <1> defb DMACLRMSK  equ     0xF00E
   140                              <1> defb DMACLRMSK_AT equ   0x000E
   141                              <1> defb DMAGRPMSK  equ     0xF00F
   142                              <1> defb DMAGRPMSK_AT equ   0x000F
   143                              <1> defb DMA0REQ0_1 equ     0xF010
   144                              <1> defb DMA0REQ2_3 equ     0xF011
   145                              <1> defb DMA1REQ0_1 equ     0xF012
   146                              <1> defb DMA1REQ2_3 equ     0xF013
   147                              <1> defb DMABSR     equ     0xF018
   148                              <1> defb DMACHR     equ     0xF019
   149                              <1> defb DMAIS      equ     0xF019
   150                              <1> defb DMACMD2    equ     0xF01A
   151                              <1> defb DMAMOD2    equ     0xF01B
   152                              <1> defb DMAIEN     equ     0xF01C
   153                              <1> defb DMAOVFE    equ     0xF01D
   154                              <1> defb DMACLRTC   equ     0xF01E
   155                              <1> ;
   156                              <1> ;/* The DMA Page Registers
   157                              <1> ;*/
   158                              <1> defb DMA1TAR2    equ    0xF083
   159                              <1> defb DMA1TAR2_AT equ    0x0083
   160                              <1> defb DMA1TAR3    equ    0xF085
   161                              <1> defb DMA1TAR3_AT equ    0x0085
   162                              <1> defb DMA0TAR3    equ    0xF086
   163                              <1> defb DMA0TAR3_AT equ    0x0086
   164                              <1> defb DMA0TAR2    equ    0xF087
   165                              <1> defb DMA0TAR2_AT equ    0x0087
   166                              <1> ;
   167                              <1> defb DMA0BYC2   equ     0xF098
   168                              <1> defb DMA1BYC2   equ     0xF099
   169                              <1> 
   170                              <1> ;
   171                              <1> ;/* The Master Interrupt Controller
   172                              <1> ;*/
   173                              <1> defb ICW1M_AT   equ     0x0020
   174                              <1> defb ICW2M_AT   equ     0x0021
   175                              <1> defb ICW3M_AT   equ     0x0021
   176                              <1> defb ICW4M_AT   equ     0x0021
   177                              <1> defb OCW1M_AT   equ     0x0021
   178                              <1> defb OCW2M_AT   equ     0x0020
   179                              <1> defb OCW3M_AT   equ     0x0020
   180                              <1> 
   181                              <1> defb ICW1M      equ     0xF020
   182                              <1> defb ICW2M      equ     0xF021
   183                              <1> defb ICW3M      equ     0xF021
   184                              <1> defb ICW4M      equ     0xF021
   185                              <1> defb OCW1M      equ     0xF021
   186                              <1> defb OCW2M      equ     0xF020
   187                              <1> defb OCW3M      equ     0xF020
   188                              <1> defb IRR_M	equ	0xF020
   189                              <1> 
   190                              <1> ;
   191                              <1> ;/* The Slave Interrupt Controller
   192                              <1> ;*/
   193                              <1> defb ICW1S_AT   equ     0x00A0
   194                              <1> defb ICW2S_AT   equ     0x00A1
   195                              <1> defb ICW3S_AT   equ     0x00A1
   196                              <1> defb ICW4S_AT   equ     0x00A1
   197                              <1> defb OCW1S_AT   equ     0x00A1
   198                              <1> defb OCW2S_AT   equ     0x00A0
   199                              <1> defb OCW3S_AT   equ     0x00A0
   200                              <1> defb IRR_M_AT	equ	0x00A0
   201                              <1> 
   202                              <1> defb ICW1S      equ     0xF0A0
   203                              <1> defb ICW2S      equ     0xF0A1
   204                              <1> defb ICW3S      equ     0xF0A1
   205                              <1> defb ICW4S      equ     0xF0A1
   206                              <1> defb OCW1S      equ     0xF0A1
   207                              <1> defb OCW2S      equ     0xF0A0
   208                              <1> defb OCW3S      equ     0xF0A0
   209                              <1> 
   210                              <1> ;
   211                              <1> ;/* The Timer/Counter Unit
   212                              <1> ;*/
   213                              <1> defb    TMR0    equ     0xF040
   214                              <1> defb    TMR0_AT equ     0x0040
   215                              <1> defb    TMR1    equ     0xF041
   216                              <1> defb    TMR1_AT equ     0x0041
   217                              <1> defb    TMR2    equ     0xF042
   218                              <1> defb    TMR2_AT equ     0x0042
   219                              <1> defb    TMRCON  equ     0xF043
   220                              <1> defb    TMRCON_AT  equ  0x0043
   221                              <1> 
   222                              <1> ;
   223                              <1> ;/* The Chip Select Unit
   224                              <1> ;*/
   225                              <1> defw    CS0ADL  equ     0xF400
   226                              <1> defw    CS0ADH  equ     0xF402
   227                              <1> defw    CS0MSKL equ     0xF404
   228                              <1> defw    CS0MSKH equ     0xF406
   229                              <1> defw    CS1ADL  equ     0xF408
   230                              <1> defw    CS1ADH  equ     0xF40A
   231                              <1> defw    CS1MSKL equ     0xF40C
   232                              <1> defw    CS1MSKH equ     0xF40E
   233                              <1> defw    CS2ADL  equ     0xF410
   234                              <1> defw    CS2ADH  equ     0xF412
   235                              <1> defw    CS2MSKL equ     0xF414
   236                              <1> defw    CS2MSKH equ     0xF416
   237                              <1> defw    CS3ADL  equ     0xF418
   238                              <1> defw    CS3ADH  equ     0xF41A
   239                              <1> defw    CS3MSKL equ     0xF41C
   240                              <1> defw    CS3MSKH equ     0xF41E
   241                              <1> defw    CS4ADL  equ     0xF420
   242                              <1> defw    CS4ADH  equ     0xF422
   243                              <1> defw    CS4MSKL equ     0xF424
   244                              <1> defw    CS4MSKH equ     0xF426
   245                              <1> defw    CS5ADL  equ     0xF428
   246                              <1> defw    CS5ADH  equ     0xF42A
   247                              <1> defw    CS5MSKL equ     0xF42C
   248                              <1> defw    CS5MSKH equ     0xF42E
   249                              <1> defw    CS6ADL  equ     0xF430
   250                              <1> defw    CS6ADH  equ     0xF432
   251                              <1> defw    CS6MSKL equ     0xF434
   252                              <1> defw    CS6MSKH equ     0xF436
   253                              <1> defw    UCSADL  equ     0xF438
   254                              <1> defw    UCSADH  equ     0xF43A
   255                              <1> defw    UCSMSKL equ     0xF43C
   256                              <1> defw    UCSMSKH equ     0xF43E
   257                              <1> 
   258                              <1> ;
   259                              <1> ;/* The Synchronous Serial I/O Unit
   260                              <1> ;*/
   261                              <1> defw    SSIOTBUF equ    0xF480
   262                              <1> defw    SSIORBUF equ    0xF482
   263                              <1> defw    SSIOBAUD equ    0xF484
   264                              <1> defw    SSIOCON1 equ    0xF486
   265                              <1> defw    SSIOCON2 equ    0xF488
   266                              <1> defw    SSIOCTR  equ    0xF48A
   267                              <1> 
   268                              <1> ;
   269                              <1> ;/* The Refresh Control Unit
   270                              <1> ;*/
   271                              <1> defw    RFSBAD  equ     0xF4A0
   272                              <1> defw    RFSCIR  equ     0xF4A2
   273                              <1> defw    RFSCON  equ     0xF4A4
   274                              <1> defw    RFSADD  equ     0xF4A6
   275                              <1> 
   276                              <1> ;
   277                              <1> ;/* The Watchdog Timer Unit
   278                              <1> ;*/
   279                              <1> defw    WDTRLDH equ     0xF4C0
