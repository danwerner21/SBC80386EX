  1177                                  ; seg_test -- test a segment of memory (variable size)
  1178                                  ; seg_test_bx	ditto, but returns through BX
  1179                                  ;
  1180                                  ;    Enter with:
  1181                                  ;	ES:SI	points at area to test
  1182                                  ;	DX	count of size of area in DWORDS (16K==full segment)
  1183                                  ;
  1184                                  ;    Exit with:
  1185                                  ;	ES:SI	unchanged
  1186                                  ;	DX	unchanged
  1187                                  ;	memory area is cleared to Zeroes if successful
  1188                                  ;
  1189                                  ;    Error Condition:
  1190                                  ;	*** WILL HALT ***	so have the LITES set up
  1191                                  ;
  1192                                  ;    Trashes:
  1193                                  ;	EAX
  1194                                  ;	BX	is used for the return
  1195                                  ;	CX
  1196                                  ;	DI
  1197                                  ;
  1198                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
