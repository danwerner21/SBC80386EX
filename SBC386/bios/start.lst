   257                                  
   258                                  ; set up CS5# for the CGA/EGA/VGA register range at 03C0..03DF
   259                                  ;
   260                                  ; Nothing on this board lives there.  The point is that the cycle should
   261                                  ; END: an address matching no chip select has nothing to terminate it, so
   262                                  ; the bus monitor times out and the read costs 209 ms -- see 06d.  A DOS
   263                                  ; program that writes the screen itself polls 3DAh before every write to
   264                                  ; avoid CGA snow, and at 209 ms a read that is not slow, it is stopped.
   265                                  ; Turbo C hung there with interrupts disabled and no way back.
   266                                  ;
   267                                  ; With the window claimed the read finishes in wait states and returns a
   268                                  ; floating FF.  That is enough for a program waiting for a status bit to
   269                                  ; be SET -- which is what Turbo C was doing, proven by its coming up.  It
   270                                  ; is not enough for one waiting for the bit to CHANGE, because a constant
   271                                  ; never does; that case needs the ports emulated, which is item 16.
   272                                  ;
   273                                  ; 03C0..03DF and not 03B0..03DF because the window must be a power of two
   274                                  ; on its own boundary, and because 0380..03FF would swallow COM1 at 03F8.
   275                                  ; The MDA registers at 03B0..03BF are therefore still undecoded; nothing
   276                                  ; has yet been seen to want them.
   277                                  	winit	CS5ADH, (0x3C0 >> 6) & 0xFFFF
   147 00000124 2AF4                <1>  dw %1
   148 00000126 0F00                <1>  dw %2
   278                                  	winit	CS5ADL, (0x3C0 <<10) & 0xFFFF | ZBIT9+ZBIT8 + ZBIT7+ 7;w.s.
   147 00000128 28F4                <1>  dw %1
   148 0000012A 0700                <1>  dw %2
   279                                  	winit	CS5MSKH, ~(0x001F00 >> 6) & 0xFFFF
   147 0000012C 2EF4                <1>  dw %1
   148 0000012E 83FF                <1>  dw %2
   280                                  	winit	CS5MSKL, ~(0x001F00 <<10) & 0xF800 | BIT10+BIT0
   147 00000130 2CF4                <1>  dw %1
   148 00000132 01FC                <1>  dw %2
   281                                  ;
   282                                  ; set up CS0# for the external I/O at 0400..04FF
   283                                  	winit	CS0ADH, (0x400 >> 6) & 0xFFFF
   147 00000134 02F4                <1>  dw %1
   148 00000136 1000                <1>  dw %2
   284                                  	winit	CS0ADL, (0x400 <<10) & 0xFFFF | ZBIT9+ZBIT8 + ZBIT7+ 7;w.s.
   147 00000138 00F4                <1>  dw %1
   148 0000013A 0700                <1>  dw %2
   285                                  	winit	CS0MSKH, ~(0x00FF00 >> 6) & 0xFFFF
   147 0000013C 06F4                <1>  dw %1
   148 0000013E 03FC                <1>  dw %2
   286                                  	winit	CS0MSKL, ~(0x00FF00 <<10) & 0xF800 | BIT10+BIT0
   147 00000140 04F4                <1>  dw %1
   148 00000142 01FC                <1>  dw %2
   287                                  ;
   288                                  ; set up CS1# for the IDE I/O at 01F0..01FF	-- ZBIT0 disables it
   289                                  ;
   290                                  ; 7 wait states, not the 3 this carried for years.  3 was never measured;
   291                                  ; 7 was, from the monitor -- C007 written into CS1ADL by hand, then a full
   292                                  ; pass of IDENT, LBA and SECTEST against the card with no change in
   293                                  ; behaviour except that it stopped being marginal.  It matches what CS0
   294                                  ; already uses for the ECB I/O window, and the IDE path is nowhere near
   295                                  ; fast enough for four extra wait states per byte to matter: the transfer
   296                                  ; is 8-bit PIO through a single port either way.
   297                                  	winit	CS1ADH, (0x1F0 >> 6) & 0xFFFF
   147 00000144 0AF4                <1>  dw %1
   148 00000146 0700                <1>  dw %2
   298                                  	winit	CS1ADL, (0x1F0 <<10) & 0xFFFF | ZBIT9+ZBIT8 + ZBIT7+ 7;w.s.
   147 00000148 08F4                <1>  dw %1
   148 0000014A 07C0                <1>  dw %2
   299                                  	winit	CS1MSKH, ~(0x00FFF0 >> 6) & 0xFFFF
   147 0000014C 0EF4                <1>  dw %1
   148 0000014E 00FC                <1>  dw %2
   300                                  	winit	CS1MSKL, ~(0x00FFF0 <<10) & 0xF800 | BIT10+ BIT0
   147 00000150 0CF4                <1>  dw %1
   148 00000152 013C                <1>  dw %2
   301                                  ;
   302                                  ; set up CS3# for the external Memory select at $000B_xxxx
   303                                  	winit	CS3ADH, 0x000B
   147 00000154 1AF4                <1>  dw %1
   148 00000156 0B00                <1>  dw %2
   304                                  	winit	CS3ADL, 0x0000 | ZBIT9+BIT8+ZBIT7 + 5;w.s.
   147 00000158 18F4                <1>  dw %1
   148 0000015A 0501                <1>  dw %2
   305                                  	winit	CS3MSKH, 0x0000
   147 0000015C 1EF4                <1>  dw %1
   148 0000015E 0000                <1>  dw %2
   306                                  	winit	CS3MSKL, 0xF800 | BIT10+BIT0
   147 00000160 1CF4                <1>  dw %1
   148 00000162 01FC                <1>  dw %2
