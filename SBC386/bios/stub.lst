   266                                  KBD_getchar_:
   267                                  @KBD_getchar:
   268                                  .1:
   269 00000028 B402                    	mov	ah,2		; read from serial line
   270 0000002A BA0000                  	mov	dx,0		; COM1
   271 0000002D CD14                    	int	0x14		; SIO0 write
   272                                  %if VSHOW
   273                                  ;;	xchg	al,ah
   274                                  	mov	dx,0x4ff
   275                                  	out	dx,al
   276                                  ;;	xchg	al,ah
   277                                  %endif
   278 0000002F F6C4FF                  	test	ah,0xFF		; any error bit set?
   279 00000032 75F4                    	jnz	.1
   280 00000034 247F                    	and	al,0x7F		; mask to 7 bits
   281 00000036 C3                      	ret
