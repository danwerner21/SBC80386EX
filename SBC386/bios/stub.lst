   242                                  ;/* this is just a stub for the moment */
   243                                  VIDEO_putchar_:
   244                                  @VIDEO_putchar:
   245                                  @CVDU_putchar:
   246                                  %define VSHOW 0
   247                                  %if VSHOW
   248                                  	mov	dx,0x4ff
   249                                  	out	dx,al
   250                                  %endif
   251 00000020 B401                    	mov	ah,1		; write to serial line
   252 00000022 BA0000                  	mov	dx,0		; COM1
   253 00000025 CD14                    	int	0x14		; SIO0 write
   254                                  %if VSHOW
   255                                  	mov	al,ah
   256                                  	mov	dx,0x4ff
   257                                  	out	dx,al
   258                                  %endif
   259 00000027 C3                      	ret
