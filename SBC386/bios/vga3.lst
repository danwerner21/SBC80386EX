   527                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   528                                  ; vga3_init -- is the board there, and if so bring it up
   529                                  ;
   530                                  ;	int vga3_init(void);		returns 1 if it is
   531                                  ;
   532                                  ; Called from POST before the first INT 10h, and from the monitor after
   533                                  ; VGA3 has been over the memory.  Two patterns at an off-screen address
   534                                  ; decide presence: a floating bus reads FF and agrees with neither.
   535                                  ; Then the CRTC; the memory window with video off; the font and a clear
   536                                  ; screen written straight in, which is allowed to sparkle because
   537                                  ; nothing is being shown yet; and video on.
   538                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   539                                  vga3_init_:
