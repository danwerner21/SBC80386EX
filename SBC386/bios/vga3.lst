   210 000000DF ????                <1> ebda_seg_ptr	resw	1		; for EBDA allocations; c.f., memory_size */
   211                              <1> ; */
   212                              <1> ; start of 31 bytes of NVRAM informaiion */
   213 000000E1 ????                <1> nvram_info	resb	2	; 31 bytes of NVRAM information (this may move)*//
   214                              <1> ; starts with 2 bytes of SIO0 params */
   215 000000E3 ????                <1> floppy_tab	resb	2		; floppy disk driver table */
   216 000000E5 ????????????????    <1> disk_tab	resb	8  		; hard disk driver table */
   217 000000ED ??                  <1> boot_order	resb	1		; which device INT 19h tries, and in what order */
   218 000000EE ??                  <1> console_sel	resb	1		; which console SETUP was told to use */
   219 000000EF <res Fh>            <1> nvram_unused	resb	15
   220 000000FE ????                <1> nvram_checksum	resw	1	; 31st byte of the NVRAM info */
   221                              <1> ; end of 31 bytes of NVRAM information */
   222                              <1> ; */
   223 00000100 ??                  <1> AT_status_byte	resb	1	; at 40:100h, 00500h, Print Screen Status byte*//
   224                              <1> ; 00=ready/ok  01=busy  0FF=error	*/
   225 00000101 ??                  <1> SRAM_size	resb	1	; size of SRAM in Kilobytes */
   226                              <1> ; */
   227                              <1> ; Extentsion to BDA during BIOS startup */
   228                              <1> ; */
   229                              <1> endstruc
   229          ******************  <1>  warning: segment attributes specified on redeclaration of segment: ignoring [-w+other]
    76                                  %undef XXX
    77                                  
    78                                  	global	vga3_init_		; C: int vga3_init(void), 1 if present
    79                                  	global	vga3_putc		; AL at the cursor, character only
    80                                  	global	vga3_cells		; AL,BL at the cursor CX times; DL=1 attr too
    81                                  	global	vga3_getcell		; -> AX, the cell under the cursor
    82                                  	global	vga3_cursor		; AH row, AL column -> the CRTC
    83                                  	global	vga3_shape		; CX as INT 10h fn 01
    84                                  	global	vga3_scroll_up		; as INT 10h fn 06
    85                                  	global	vga3_scroll_dn		; as INT 10h fn 07
    86                                  	global	vga3_clear		; the screen to spaces, cursor home
    87                                  
    88                                  segment	_TEXT
    89                                  
    90                                  V3_PORT		equ	0x4E0		; P3 jumpered to E0h
    91                                  V3_CRTC_A	equ	V3_PORT+2	; HD6445 address register
    92                                  V3_CRTC_D	equ	V3_PORT+3	; HD6445 data register
    93                                  V3_CFG		equ	V3_PORT+4	; write only
    94                                  V3_ADR_HI	equ	V3_PORT+5	; write only
    95                                  V3_ADR_LO	equ	V3_PORT+6	; write only
    96                                  V3_DATA		equ	V3_PORT+7
    97                                  
    98                                  V3_SEG		equ	0xB800		; the 32K, memory mapped
    99                                  V3_FONT		equ	0x7000		; page 7, as CFG below says
   100                                  V3_COLS		equ	80
   101                                  V3_ROWS		equ	25
   102                                  V3_CELLS	equ	V3_COLS*V3_ROWS
   103                                  V3_BLANK	equ	0x0720		; attribute 07, a space
   104                                  
   105                                  ; CFG: bit 7 memory window at B8000 (clear: B0000); 6:4 font page 7;
   106                                  ; bit 3 one font; bit 2 video on; bit 0 nine-dot characters.
   107                                  V3_CFG_QUIET	equ	0xF0		; mapped, video off
   108                                  V3_CFG_ON	equ	0xF4
   109                                  
   110                                  R31		equ	31		; HD6445: bit 1 = vertical blanking
   111                                  ROW_BLANKING	equ	25		; "row" the beam is on during blanking
   112                                  
   113                                  
   114                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   115                                  ; 80x25, nine-dot characters, 28.322mhz dots: VGA's 720x400 text timing.
   116                                  ;   80 shown + 2 + 12 + 6 = 100 char clocks = 900 dots = 31.469khz
   117                                  ;   400 lines + 12 + 2 + 35 = 449 lines = 70.08hz
   118                                  ;
   119                                  ; These are the parameters the SBC-188 BIOS (John Coffman, 2012) drove
   120                                  ; this same board with.  Vsync belongs on line 412, which is not a row
   121                                  ; boundary; the HD6445 can do it anyway -- R7 puts it at row 25, line
   122                                  ; 400, and R27, enabled by bit 3 of R30, moves it 12 lines on.  So the
   123                                  ; frame is VGA's 449 lines exactly, not the 453 a plain 6845 forced.
   124                                  ; R2 is the arithmetic 82: the 68 that once "centred" the picture was
   125                                  ; correcting for a monitor that had taken the signal for 640x350, which
   126                                  ; is a sync-polarity matter for the jumpers, not for this table.
   127                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   128                                  	align	2
   129                                  v3_mode:
   130 00000000 006301500252032C        	db	0,  99,   1,  80,   2,  82,   3,  0x2C
   131 00000008 041B050106190719        	db	4,  27,   5,  1,    6,  25,   7,  25
   132 00000010 0800090F0A6D0B0E        	db	8,  0,    9,  15,   10, 0x6D, 11, 14	; cursor lines 13-14, blink 1/32
   133 00000018 0C000D000E000F00        	db	12, 0,    13, 0,    14, 0,    15, 0
   134 00000020 1E001F002000            	db	30, 0,    31, 0,    32, 0		; control 1..3 known
   135 00000026 1B0C1E08                	db	27, 12,   30, 0x08			; vsync 12 lines after row 25
   136                                  v3_mode_len	equ	$ - v3_mode
   137                                  
   138                                  
   139                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   140                                  ; The register path: the CRTC, and the RAM for the presence test
   141                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   142                                  
   143                                  ; g_crtc -- AH to CRTC register AL.  AL is destroyed.
   144                                  g_crtc:
   145 0000002A 52                      	push	dx
   146 0000002B BAE204                  	mov	dx,V3_CRTC_A
   147 0000002E EE                      	out	dx,al
   148 0000002F 42                      	inc	dx
   149 00000030 88E0                    	mov	al,ah
   150 00000032 EE                      	out	dx,al
   151 00000033 5A                      	pop	dx
   152 00000034 C3                      	ret
   153                                  
   154                                  ; g_rd / g_wr -- AL from / to RAM byte BX through the address registers
   155                                  g_seek:
   156 00000035 5250                    	pushm	ax,dx
   157 00000037 BAE504                  	mov	dx,V3_ADR_HI
   158 0000003A 88F8                    	mov	al,bh
   159 0000003C EE                      	out	dx,al
   160 0000003D 42                      	inc	dx
   161 0000003E 88D8                    	mov	al,bl
   162 00000040 EE                      	out	dx,al
   163 00000041 585A                    	popm	ax,dx
   164 00000043 C3                      	ret
   165                                  g_rd:
   166 00000044 E8EEFF                  	call	g_seek
   167 00000047 52                      	push	dx
   168 00000048 BAE704                  	mov	dx,V3_DATA
   169 0000004B EC                      	in	al,dx
   170 0000004C 5A                      	pop	dx
   171 0000004D C3                      	ret
   172                                  g_wr:
   173 0000004E E8E4FF                  	call	g_seek
   174 00000051 52                      	push	dx
   175 00000052 BAE704                  	mov	dx,V3_DATA
   176 00000055 EE                      	out	dx,al
   177 00000056 5A                      	pop	dx
   178 00000057 C3                      	ret
   179                                  
   180                                  
   181                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   182                                  ; Addressing
   183                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   184                                  
   185                                  ; g_cell -- BX = byte offset of the cell at row AH, column AL.  Needs
   186                                  ; no segment; everything else preserved.
   187                                  g_cell:
   188 00000058 5250                    	pushm	ax,dx
   189 0000005A 88C2                    	mov	dl,al
   190 0000005C 88E0                    	mov	al,ah
   191 0000005E B450                    	mov	ah,V3_COLS
   192 00000060 F6E4                    	mul	ah
   193 00000062 30F6                    	xor	dh,dh
   194 00000064 01D0                    	add	ax,dx
   195 00000066 01C0                    	add	ax,ax
   196 00000068 89C3                    	mov	bx,ax
   197 0000006A 585A                    	popm	ax,dx
   198 0000006C C3                      	ret
   199                                  
   200                                  ; g_bda_cursor -- AH = row, AL = column of the active page's cursor.
   201                                  ; DS is the BDA.
   202                                  g_bda_cursor:
   203 0000006D 53                      	push	bx
   204 0000006E 8A1E6200                	mov	bl,[vid_active_page]
   205 00000072 80E307                  	and	bl,7
   206 00000075 30FF                    	xor	bh,bh
   207 00000077 01DB                    	add	bx,bx
   208 00000079 8B4750                  	mov	ax,[bx+vid_cursor]
   209 0000007C 5B                      	pop	bx
   210 0000007D C3                      	ret
   211                                  
   212                                  
   213                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   214                                  ; The beam.  DS is the BDA.
   215                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   216                                  
   217                                  ; beam_avoid -- wait for vertical blanking, then return.  The arguments
   218                                  ; the callers pass -- the rows they are about to touch -- are ignored:
   219                                  ; during blanking every row is safe.  They are kept because the callers
   220                                  ; read better for having said what they touch, and because a scheme that
   221                                  ; uses them may yet be made to work.
   222                                  ;
   223                                  ; Bounded at 64K reads, about two frames.  If the bit never sets there is
   224                                  ; no CRTC clock and nothing to synchronise with, so the write proceeds.
   225                                  ; Everything preserved.
   226                                  beam_avoid:
   227 0000007E 525150                  	pushm	ax,cx,dx
   228 00000081 BAE204                  	mov	dx,V3_CRTC_A
   229 00000084 B01F                    	mov	al,R31
   230 00000086 EE                      	out	dx,al
   231 00000087 42                      	inc	dx			; DX = the data port, R31 selected
   232 00000088 31C9                    	xor	cx,cx
   233 0000008A EC                      .w:	in	al,dx
   234 0000008B A802                    	test	al,2
   235 0000008D E1FB                    	loopz	.w
   236 0000008F 58595A                  	popm	ax,cx,dx
   237 00000092 C3                      	ret
   238                                  
   239                                  
   240                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   241                                  ; The primitives INT 10h uses.  DS is the BDA.  Registers preserved
   242                                  ; except where a result is returned.
   243                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   244                                  
   245                                  ; vga3_putc -- the character AL into the cell under the cursor; the
   246                                  ; attribute there is left alone, as teletype on a PC leaves it.
   247                                  vga3_putc:
   248 00000093 06525350                	pushm	ax,bx,dx,es
   249 00000097 88C2                    	mov	dl,al
   250 00000099 E8D1FF                  	call	g_bda_cursor		; AH row, AL column
   251 0000009C 88E0                    	mov	al,ah
   252 0000009E E8DDFF                  	call	beam_avoid		; AH..AL = the row
   253 000000A1 E8C9FF                  	call	g_bda_cursor
   254 000000A4 E8B1FF                  	call	g_cell
   255 000000A7 B800B8                  	mov	ax,V3_SEG
   256 000000AA 8EC0                    	mov	es,ax
   257 000000AC 268817                  	mov	[es:bx],dl
   258 000000AF 585B5A07                	popm	ax,bx,dx,es
   259 000000B3 C3                      	ret
   260                                  
   261                                  ; vga3_cells -- AL, CX times, from the cursor on; with attribute BL when
   262                                  ; DL is 1 (fn 09), character only when 0 (fn 0A).  Clipped to the
   263                                  ; screen.  Written a row at a time, each row once the beam is off it.
   264                                  vga3_cells:
   265 000000B4 06575652515350          	pushm	ax,bx,cx,dx,si,di,es
   266 000000BB 88DE                    	mov	dh,bl			; DH attribute, DL type
   267 000000BD 88C3                    	mov	bl,al			; BL character
   268 000000BF E8ABFF                  	call	g_bda_cursor
   269 000000C2 89C6                    	mov	si,ax			; SI = row:column
   270 000000C4 E891FF                  	call	g_cell
   271 000000C7 89DF                    	mov	di,bx			; DI = byte offset
   272 000000C9 B8A00F                  	mov	ax,V3_CELLS*2
   273 000000CC 29F8                    	sub	ax,di
   274 000000CE D1E8                    	shr	ax,1			; cells to the end of the screen
   275 000000D0 39C1                    	cmp	cx,ax
   276 000000D2 7602                    	jbe	.1
   277 000000D4 89C1                    	mov	cx,ax
   278 000000D6 E33C                    .1:	jcxz	.9
   279 000000D8 B800B8                  	mov	ax,V3_SEG
   280 000000DB 8EC0                    	mov	es,ax
   281                                  .row:
   282 000000DD 89F0                    	mov	ax,si			; AH row, AL column
   283 000000DF 88C7                    	mov	bh,al			; BH = column
   284 000000E1 88E0                    	mov	al,ah
   285 000000E3 E898FF                  	call	beam_avoid		; this row
   286 000000E6 B050                    	mov	al,V3_COLS
   287 000000E8 28F8                    	sub	al,bh
   288 000000EA 30E4                    	xor	ah,ah			; AX = cells left in this row
   289 000000EC 39C8                    	cmp	ax,cx
   290 000000EE 7602                    	jbe	.2
   291 000000F0 89C8                    	mov	ax,cx
   292 000000F2 29C1                    .2:	sub	cx,ax
   293 000000F4 91                      	xchg	ax,cx			; CX = cells now, AX = cells after
   294 000000F5 50                      	push	ax
   295 000000F6 88D8                    	mov	al,bl			; character
   296 000000F8 88F4                    	mov	ah,dh			; attribute
   297 000000FA F6C201                  	test	dl,1
   298 000000FD 7506                    	jnz	.both
   299 000000FF AA                      .char:	stosb
   300 00000100 47                      	inc	di
   301 00000101 E2FC                    	loop	.char
   302 00000103 EB02                    	jmp	short .3
   303 00000105 F3AB                    .both:	rep	stosw
   304 00000107 59                      .3:	pop	cx
   305 00000108 E30A                    	jcxz	.9
   306 0000010A 89F0                    	mov	ax,si			; column 0 of the next row
   307 0000010C FEC4                    	inc	ah
   308 0000010E 30C0                    	xor	al,al
   309 00000110 89C6                    	mov	si,ax
   310 00000112 EBC9                    	jmp	short .row
   311                                  .9:
   312 00000114 585B595A5E5F07          	popm	ax,bx,cx,dx,si,di,es
   313 0000011B C3                      	ret
   314                                  
   315                                  ; vga3_getcell -- AX = attribute:character under the cursor.  A read
   316                                  ; disturbs the fetch as a write does, so it too waits for the beam.
   317                                  vga3_getcell:
   318 0000011C 0653                    	pushm	bx,es
   319 0000011E E84CFF                  	call	g_bda_cursor
   320 00000121 88E0                    	mov	al,ah
   321 00000123 E858FF                  	call	beam_avoid
   322 00000126 E844FF                  	call	g_bda_cursor
   323 00000129 E82CFF                  	call	g_cell
   324 0000012C B800B8                  	mov	ax,V3_SEG
   325 0000012F 8EC0                    	mov	es,ax
   326 00000131 268B07                  	mov	ax,[es:bx]
   327 00000134 5B07                    	popm	bx,es
   328 00000136 C3                      	ret
   329                                  
   330                                  ; vga3_cursor -- the hardware cursor to row AH, column AL.  A CRTC
   331                                  ; register, not RAM: no contention, so immediate.
   332                                  vga3_cursor:
   333 00000137 5350                    	pushm	ax,bx
   334 00000139 E81CFF                  	call	g_cell
   335 0000013C D1EB                    	shr	bx,1			; cell number
   336 0000013E B00E                    	mov	al,14
   337 00000140 88FC                    	mov	ah,bh
   338 00000142 E8E5FE                  	call	g_crtc
   339 00000145 B00F                    	mov	al,15
   340 00000147 88DC                    	mov	ah,bl
   341 00000149 E8DEFE                  	call	g_crtc
   342 0000014C 585B                    	popm	ax,bx
   343 0000014E C3                      	ret
   344                                  
   345                                  ; vga3_shape -- as INT 10h fn 01: CH start line, bit 5 no cursor; CL end.
   346                                  ; R10 bits 6:5 are the 6845's blink control: 01 not displayed, 10 blink.
   347                                  vga3_shape:
   348 0000014F 50                      	pushm	ax
   349 00000150 88EC                    	mov	ah,ch
   350 00000152 80E41F                  	and	ah,0x1F
   351 00000155 80CC40                  	or	ah,0x40
   352 00000158 F6C520                  	test	ch,0x20
   353 0000015B 7402                    	jz	.1
   354 0000015D B420                    	mov	ah,0x20
   355 0000015F B00A                    .1:	mov	al,10
   356 00000161 E8C6FE                  	call	g_crtc
   357 00000164 88CC                    	mov	ah,cl
   358 00000166 80E41F                  	and	ah,0x1F
   359 00000169 B00B                    	mov	al,11
   360 0000016B E8BCFE                  	call	g_crtc
   361 0000016E 58                      	popm	ax
   362 0000016F C3                      	ret
   363                                  
   364                                  
   365                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   366                                  ; Scrolling, as INT 10h fn 06 and 07 have it
   367                                  ;
   368                                  ;   CH,CL  top-left row, column      DH,DL  bottom-right row, column
   369                                  ;   AL     lines to scroll, zero meaning blank the whole window
   370                                  ;   BH     attribute for the lines that are blanked
   371                                  ;
   372                                  ; Rows are moved one at a time, each once the beam is clear of both its
   373                                  ; source and its destination, then the vacated rows are blanked.  Up
   374                                  ; works from the top down -- the order the beam draws in, so the copy
   375                                  ; runs behind it -- and down from the bottom up, so that a row is always
   376                                  ; read before it is overwritten.
   377                                  ;
   378                                  ; Registers through the loops: CX and DX the window, BH the attribute,
   379                                  ; BL the row counter, DI the lines (low) and the window height (high).
   380                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   381                                  vga3_scroll_up:
   382 00000170 56                      	pushm	si
   383 00000171 31F6                    	xor	si,si
   384 00000173 EB04                    	jmp	short g_scroll
   385                                  vga3_scroll_dn:
   386 00000175 56                      	pushm	si
   387 00000176 BE0100                  	mov	si,1
   388                                  
   389                                  g_scroll:				; SI 0 up, 1 down
   390 00000179 065752515350            	pushm	ax,bx,cx,dx,di,es
   391 0000017F FC                      	cld
   392 00000180 80FE18                  	cmp	dh,V3_ROWS-1
   393 00000183 7602                    	jbe	.1
   394 00000185 B618                    	mov	dh,V3_ROWS-1
   395 00000187 80FA4F                  .1:	cmp	dl,V3_COLS-1
   396 0000018A 7602                    	jbe	.2
   397 0000018C B24F                    	mov	dl,V3_COLS-1
   398 0000018E 38F5                    .2:	cmp	ch,dh
   399 00000190 7767                    	ja	.done			; an empty window
   400 00000192 38D1                    	cmp	cl,dl
   401 00000194 7763                    	ja	.done
   402 00000196 88F4                    	mov	ah,dh
   403 00000198 28EC                    	sub	ah,ch
   404 0000019A FEC4                    	inc	ah			; AH = rows in the window
   405 0000019C 08C0                    	or	al,al
   406 0000019E 7404                    	jz	.all
   407 000001A0 38E0                    	cmp	al,ah
   408 000001A2 7202                    	jb	.some
   409 000001A4 88E0                    .all:	mov	al,ah			; blank it all
   410                                  .some:
   411 000001A6 89C7                    	mov	di,ax			; DI: lines in the low byte, rows in the high
   412 000001A8 B800B8                  	mov	ax,V3_SEG
   413 000001AB 8EC0                    	mov	es,ax
   414 000001AD 30DB                    	xor	bl,bl			; k = 0
   415                                  
   416                                  .move:
   417 000001AF 89F8                    	mov	ax,di
   418 000001B1 28C4                    	sub	ah,al			; AH = rows to move
   419 000001B3 38E3                    	cmp	bl,ah
   420 000001B5 731F                    	jae	.blank
   421 000001B7 09F6                    	or	si,si
   422 000001B9 750A                    	jnz	.mv_dn
   423 000001BB 89F8                    	mov	ax,di			; up: destination = top + k,
   424 000001BD 88EC                    	mov	ah,ch
   425 000001BF 00DC                    	add	ah,bl
   426 000001C1 00E0                    	add	al,ah			;     source = destination + lines
   427 000001C3 EB0A                    	jmp	short .mv
   428                                  .mv_dn:
   429 000001C5 89F8                    	mov	ax,di			; down: destination = bottom - k,
   430 000001C7 88F4                    	mov	ah,dh
   431 000001C9 28DC                    	sub	ah,bl
   432 000001CB F6D8                    	neg	al
   433 000001CD 00E0                    	add	al,ah			;       source = destination - lines
   434                                  .mv:
   435 000001CF E82F00                  	call	row_copy		; AH destination row, AL source row
   436 000001D2 FEC3                    	inc	bl
   437 000001D4 EBD9                    	jmp	short .move
   438                                  
   439                                  .blank:
   440 000001D6 30DB                    	xor	bl,bl			; j = 0
   441                                  .bl:
   442 000001D8 89F8                    	mov	ax,di
   443 000001DA 38C3                    	cmp	bl,al			; j < lines?
   444 000001DC 731B                    	jae	.done
   445 000001DE 09F6                    	or	si,si
   446 000001E0 750A                    	jnz	.bl_dn
   447 000001E2 88F4                    	mov	ah,dh			; up: bottom - lines + 1 + j
   448 000001E4 28C4                    	sub	ah,al
   449 000001E6 FEC4                    	inc	ah
   450 000001E8 00DC                    	add	ah,bl
   451 000001EA EB04                    	jmp	short .bl_go
   452                                  .bl_dn:
   453 000001EC 88EC                    	mov	ah,ch			; down: top + j
   454 000001EE 00DC                    	add	ah,bl
   455                                  .bl_go:
   456 000001F0 88F8                    	mov	al,bh			; the attribute
   457 000001F2 E84500                  	call	row_blank		; AH row, AL attribute
   458 000001F5 FEC3                    	inc	bl
   459 000001F7 EBDF                    	jmp	short .bl
   460                                  
   461                                  .done:
   462 000001F9 585B595A5F07            	popm	ax,bx,cx,dx,di,es
   463 000001FF 5E                      	popm	si
   464 00000200 C3                      	ret
   465                                  
   466                                  ; row_copy -- source row AL to destination row AH, columns CL..DL, on
   467                                  ; the board (ES), once the beam is clear of both.  Everything preserved.
   468                                  row_copy:
   469 00000201 1E575652515350          	pushm	ax,bx,cx,dx,si,di,ds
   470 00000208 89C3                    	mov	bx,ax
   471 0000020A 38DF                    	cmp	bh,bl
   472 0000020C 7602                    	jbe	.r1
   473 0000020E 86FB                    	xchg	bh,bl			; BH the lower row, BL the higher
   474 00000210 50                      .r1:	push	ax
   475 00000211 89D8                    	mov	ax,bx
   476 00000213 E868FE                  	call	beam_avoid		; AH..AL
   477 00000216 58                      	pop	ax
   478 00000217 88C6                    	mov	dh,al			; the source row
   479 00000219 88C8                    	mov	al,cl
   480 0000021B E83AFE                  	call	g_cell
   481 0000021E 89DF                    	mov	di,bx			; destination
   482 00000220 88F4                    	mov	ah,dh
   483 00000222 E833FE                  	call	g_cell
