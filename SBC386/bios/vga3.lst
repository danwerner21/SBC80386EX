   108                              <1> 
   109                              <1> ;/* The component identifier the 386EX leaves in DX after a hardware reset:
   110                              <1> ;*  DH is the device (23h, 386EX) and DL the stepping.  POST tests it as the
   111                              <1> ;*  first thing it does, so anything that restarts the board in software has
   112                              <1> ;*  to present it too -- see reboot_ in 19h_boot.asm, which learned that the
   113                              <1> ;*  hard way.
   114                              <1> ;*/
   115                              <1> defw    DEVICE_ID equ   0x2309
   116                              <1> 
