     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; vga3.asm -- the ECB VGA3 board: 80x25 text on an HD6445, memory mapped
     3                                  ;             at B8000, written wherever the beam is not
     4                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     5                                  ;
     6                                  ; Copyright (C) 2026 Dan Werner.  All rights reserved.
     7                                  ; Provided for hobbyist use on the RetroBrew SBC-386EX board.
     8                                  ;
     9                                  ; This program is free software: you can redistribute it and/or modify
    10                                  ; it under the terms of the GNU General Public License as published by
    11                                  ; the Free Software Foundation, either version 3 of the License, or
    12                                  ; (at your option) any later version.
    13                                  ;
    14                                  ; This program is distributed in the hope that it will be useful,
    15                                  ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                                  ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                                  ; GNU General Public License for more details.
    18                                  ;
    19                                  ; You should have received a copy of the GNU General Public License
    20                                  ; along with this program in the file COPYING in the topmost source
    21                                  ; directory.  If not, see <http://www.gnu.org/licenses/>.
    22                                  ;
    23                                  ;
    24                                  ; THE BOARD
    25                                  ;
    26                                  ; Eight I/O ports at 4E0h (P3 jumpered E0h): an 8242 keyboard controller
    27                                  ; at +0/+1, the HD6445 CRTC at +2/+3, the CFG register at +4, and at
    28                                  ; +5..+7 a pair of address registers and a data port that reach the 32K
    29                                  ; of video RAM a byte at a time.  CFG bit 7 also puts that 32K on the
    30                                  ; ECB memory bus, at B0000 (clear) or B8000 (set).  The SBC's CS3 maps
    31                                  ; B0000..BFFFF to the bus with DRAM suppressed there, 8-bit, five wait
    32                                  ; states, READY generated internally -- so the RAM is simply memory at
    33                                  ; B800:0000, one bus cycle a byte, and a program that writes the screen
    34                                  ; directly, as DOS programs do, is writing the board.
    35                                  ;
    36                                  ; THE RAM IS NOT ARBITRATED.  A CPU access while the CRTC is fetching
    37                                  ; corrupts that fetch and the screen sparkles -- by either path; both
    38                                  ; were measured.  The CPU's own read or write is not harmed: V3RDCHK
    39                                  ; read the live screen 32,000 times without an error.  Confining writes
    40                                  ; to vertical blanking was tried and is far too slow: blanking is 11%
    41                                  ; of the frame, and a scroll took four frames.
    42                                  ;
    43                                  ; THE DESIGN: WRITE DURING BLANKING
    44                                  ;
    45                                  ; Bit 1 of HD6445 register 31, read through the data port, is vertical
    46                                  ; blanking -- the SBC-188 BIOS scrolled on it.  Every write to the board
    47                                  ; waits for it, then goes.  Blanking is 1553 usec of the 14271 usec frame
    48                                  ; (measured with V3BEAM), which is about thirteen row copies, so a
    49                                  ; whole-screen scroll takes two frames, near 28 ms.  Single characters
    50                                  ; wait at most one frame and usually far less.
    51                                  ;
    52                                  ; Two cleverer schemes were built and both failed, which is why this one
    53                                  ; is deliberately dull.  Queueing the work for a retrace interrupt was
    54                                  ; four frames a scroll and unusably slow.  Computing the beam position
    55                                  ; from a blanking edge and the 1 mhz counter -- write to any row the beam
    56                                  ; is not on -- was fast but flickered, and went on flickering after the
    57                                  ; counter-wrap bug in it was fixed, for a reason never established.  The
    58                                  ; CRTC status bit needs no model of the hardware to be right.
    59                                  ;
    60                                  ; The board's retrace interrupt is not used either: the status bit is
    61                                  ; exact and free of interrupt latency, and it leaves INT0 to the
    62                                  ; keyboard.  K1 may sit in either position.  Should R31 never change --
    63                                  ; no CRTC clock, say -- writes go ahead blind rather than hang.
    64                                  ;
    65                                  ; Layout of the 32K: screen at 0000, 4000 bytes, character then
    66                                  ; attribute; font in the last 4K page, which CFG selects.  The CRTC
    67                                  ; start address stays at 0 so that B800:0000 is the top-left cell.
    68                                  ;
    69                                  ; Assembly by NASM 2.08 is preferred
    70                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    71                                  %include "seg_def.inc"
    72                              <1> ; SEG_DEF.inc
    73                              <1> ;
    74                              <1> %ifndef SEG_DEF
    75                              <1> %define SEG_DEF 1
    76                              <1> 
    77                              <1> segment _TEXT	use16 	align=16	class=CODE	public
    78                              <1> 
    79                              <1> segment CONST		align=16	class=DATA	public
    80                              <1> segment CONST2		align=2		class=DATA	public
    81                              <1> segment _DATA		align=16	class=DATA	public
    82                              <1> segment _BSS		align=16	class=DATA	public
    83                              <1> ;group DGROUP CONST2 CONST _DATA _BSS
    84                              <1> 
    85                              <1> group DGROUP  _TEXT CONST2 CONST _DATA _BSS
    86                              <1> 
    87                              <1> 
    88                              <1> segment BOOT at 0xFFFF	align=16	class=BOOT	use16
    89                              <1> 
    90                              <1> %define XXX
    91                              <1> %endif
    92                              <1> ;
    93                              <1> ; end SEG_DEF.inc
