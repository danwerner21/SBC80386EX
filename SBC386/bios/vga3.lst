    73                                  %include "macro.inc"
    74                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    75                              <1> ;
    76                              <1> ; some useful macros:
    77                              <1> ;
    78                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    79                              <1> %define NREPEAT 0
    80                              <1> 
    81                              <1> %if NREPEAT
    82                              <1> 
    83                              <1> %macro	rep	1
    84                              <1> %%loop:	%1
    85                              <1> 	dec	cx
    86                              <1> 	jnz	%%loop
    87                              <1> %endm
    88                              <1> 
    89                              <1> %macro	repne	1
    90                              <1> %%loop:	%1
    91                              <1> 	je	%%e
    92                              <1> 	dec	cx
    93                              <1> 	jnz	%%loop
    94                              <1> 	cmp	cx,1
    95                              <1> 	jmp	%%done
    96                              <1> %%e:	dec	cx
    97                              <1> 	cmp	cx,cx
    98                              <1> %%done:
    99                              <1> %endm
   100                              <1> 
   101                              <1> %macro	repe	1
   102                              <1> %%loop:	%1
   103                              <1> 	jne	%%ne
   104                              <1> 	dec	cx
   105                              <1> 	jnz	%%loop
   106                              <1> 	jmp	%%done
   107                              <1> %%ne:	dec	cx
   108                              <1> 	jcxz	%%cxz
   109                              <1> 	jmp	%%done
   110                              <1> %%cxz:	cmp	cx,1
   111                              <1> %%done:
   112                              <1> %endm
   113                              <1> 
   114                              <1> %macro	REP	1
   115                              <1> %%loop:	%1
   116                              <1> 	dec	ecx
   117                              <1> 	jnz	%%loop
   118                              <1> %endm
   119                              <1> 
   120                              <1> %macro	REPNE	1
   121                              <1> %%loop:	%1
   122                              <1> 	je	%%e
   123                              <1> 	dec	ecx
   124                              <1> 	jnz	%%loop
   125                              <1> 	cmp	cl,1
   126                              <1> 	jmp	%%done
   127                              <1> %%e:	dec	ecx
   128                              <1> 	cmp	cl,cl
   129                              <1> %%done:
   130                              <1> %endm
   131                              <1> 
   132                              <1> %macro	REPE	1
   133                              <1> %%loop:	%1
   134                              <1> 	jne	%%ne
   135                              <1> 	dec	ecx
   136                              <1> 	jnz	%%loop
   137                              <1> 	jmp	%%done
   138                              <1> %%ne:	dec	ecx
   139                              <1> 	jecxz	%%cxz
   140                              <1> 	jmp	%%done
   141                              <1> %%cxz:	cmp	cl,1
   142                              <1> %%done:
   143                              <1> %endm
   144                              <1> 
   145                              <1> %endif
   146                              <1> 
   147                              <1> 
   148                              <1> ;
   149                              <1> ; format of the BYTE initialization table:  address, byte
   150                              <1> ;
   151                              <1> %imacro  binit 2
   152                              <1>         dw      %1
   153                              <1>         db      %2
   154                              <1> %endmacro
   155                              <1> ; end with DW -1
   156                              <1> 
   157                              <1> ;
   158                              <1> ; format of the WORD initialization table:  address, word
   159                              <1> ;
   160                              <1> %imacro  winit 2
   161                              <1>         dw      %1
   162                              <1>         dw      %2
   163                              <1> %endmacro
   164                              <1> ; end with DW -1
   165                              <1> 
   166                              <1> 
   167                              <1> ; get the BIOS Data Area segment pointer to a [segment] register
   168                              <1> %imacro get_bda	1.nolist
   169                              <1> 	push	0x0040
   170                              <1> 	pop	%1
   171                              <1> 	cnop
   172                              <1> %endm
   173                              <1> 
   174                              <1> 
   175                              <1> ; get the Location 0 (Interrupt Descriptor Table) pointer to a register
   176                              <1> %imacro	get_loc0 1.nolist
   177                              <1> 	push	0x0000
   178                              <1> 	pop	%1
   179                              <1> 	cnop
   180                              <1> %endm
   181                              <1> 
   182                              <1> 
   183                              <1> 
   184                              <1> %imacro setloc  1.nolist
   185                              <1>  times   (%1-($-$$)) db 0FFh
   186                              <1> %endm
   187                              <1> 
   188                              <1> %imacro db_lo   1
   189                              <1>  db (%1)&255
   190                              <1> %endm
   191                              <1> 
   192                              <1> %imacro cnop    0.nolist
   193                              <1> %ifdef SOFT_DEBUG
   194                              <1> %if SOFT_DEBUG
   195                              <1>         nop
   196                              <1> %endif
   197                              <1> %endif
   198                              <1> %endm
   199                              <1> 
   200                              <1> %imacro popm 1-*.nolist
   201                              <1> %rep %0
   202                              <1> %ifidni %1,ALL
   203                              <1>  popa
   204                              <1> %elifidni %1,F
   205                              <1>  popf
   206                              <1> %else
   207                              <1>  pop %1
   208                              <1> %ifidni %1,DS
   209                              <1>  cnop
   210                              <1> %elifidni %1,ES
   211                              <1>  cnop
   212                              <1> %elifidni %1,FS
   213                              <1>  cnop
   214                              <1> %elifidni %1,GS
   215                              <1>  cnop
   216                              <1> %endif
   217                              <1> %endif
   218                              <1> %rotate 1
   219                              <1> %endrep
   220                              <1> %endm
   221                              <1> 
   222                              <1> %imacro pushm 1-*.nolist
   223                              <1> %rep %0
   224                              <1> %rotate -1
   225                              <1> %ifidni %1,ALL
   226                              <1>  pusha
   227                              <1> %elifidni %1,F
   228                              <1>  pushf
   229                              <1> %else
   230                              <1>  push %1
   231                              <1> %endif
   232                              <1> %endrep
   233                              <1> %endm
   234                              <1> 
   235                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   236                              <1> %assign __size__ (%2-1)	| 0xFF
   237                              <1> %if (__size__ <= 0xFFFF)
   238                              <1> %assign __gran__ 0
   239                              <1> %else
   240                              <1> %assign __gran__ 0xC0			; G B 0 0
   241                              <1> %endif
   242                              <1> %assign __expand__ 0
   243                              <1> %if %0==3
   244                              <1> %if %3
   245                              <1> %assign __expand__ 4
   246                              <1> %endif
   247                              <1> %endif
   248                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   249                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   250                              <1> %endm
   251                              <1> 
   252                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   253                              <1> %assign __size__ (%2-1)	| 0xFF
   254                              <1> %if (__size__ <= 0xFFFF)
   255                              <1> %assign __gran__ 0
   256                              <1> %else
   257                              <1> %assign __gran__ 0xC0			; G D 0 0
   258                              <1> %endif
   259                              <1> %assign __conform__ 0
   260                              <1> %if %0==3
   261                              <1> %if %3
   262                              <1> %assign __conform__ 4
   263                              <1> %endif
   264                              <1> %endif
   265                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   266                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   267                              <1> %endm
   268                              <1> 
   269                              <1> ;/* End of macro.inc */
    74                                  %define XXX
    75                                  %include "bda.inc"
    76                              <1> XXX
    77                              <1> ; bda.h -- definitions of the BIOS Data Area at 0040:0000 (0x400)  */
    78                              <1> %define BDA_segment 0x40
    79                              <1> ; bda.console -- which consoles INT 10h drives.  Set before the first */
    80                              <1> ; printf of POST; vga3_init adds the video bit when the board answers. */
    81                              <1> ; Both at once mirrors the screen down the serial line.  One comment  */
    82                              <1> ; per line here: bda.rul turns this file into bda.inc a line at a time. */
    83                              <1> %define CON_SERIAL	0x01
    84                              <1> %define CON_VIDEO	0x02
    85                              <1> struc _BDA
    86                              <1> ; first items at 0x40:0	*/
    87 00000000 ????????????????    <1> serial_dev	resw	4	; serial port device codes */
    88 00000008 ????????????????    <1> parallel_dev	resw	4	; printer port device codes */
    89 00000010 ????                <1> equip_flag	resw	1		; int 12h equipment flags */
    90 00000012 ??                  <1> mfg_test	resb	1		; initialization flags */
    91                              <1> ; */
    92                              <1> ; POST writes what it decided here, after the test of segment 0 has */
    93                              <1> ; zeroed the area, so the answer survives to be reported.  Nothing else */
    94                              <1> ; in this BIOS writes mfg_test.                                        */
    95                              <1> %define WARM_POST 0x01	; warm start: the memory march was skipped */
    96 00000013 ????                <1> memory_size	resw	1	; base memory size in Kilowords (1224) */
    97 00000015 ??                  <1> mfg_err_flag	resb	1
    98 00000016 ??                  <1> mfg_err_flag2	resb	1
    99                              <1> ; */
   100                              <1> ; first Keyboard data area */
   101 00000017 ??                  <1> kbd_flag	resb	1	; shift status &c. */
   102 00000018 ??                  <1> kbd_flag1	resb	1	;  mrre  */
   103 00000019 ??                  <1> alt_input	resb	1	; save alternate kbd entry code */
   104 0000001A ????                <1> buffer_head	resw	1
   105 0000001C ????                <1> buffer_tail	resw	1
   106                              <1> ; */
   107 0000001E <res 20h>           <1> kbd_buffer	resw	16	; buffer empty when  head==tail**/
   108                              <1> ; */
   109                              <1> ; Diskette data area */
   110 0000003E ??                  <1> seek_status	resb	1	; drive recalibration status */
   111                              <1> ; bits 3..0 drive must recalibrate before next seek */
   112 0000003F ??                  <1> motor_status	resb	1	; bits 3..0 motor running */
   113                              <1> ; bit 7 current op is write */
   114 00000040 ??                  <1> motor_count	resb	1	; timeout counter for motor turn-off */
   115 00000041 ??                  <1> fd_status	resb	1	; return code status byte */
   116 00000042 ??????????????      <1> fd_ctrl_stat	resb	7	; controller return bytes */
   117                              <1> ; */
   118                              <1> ; Video Display data area -- also used for video emulation */
   119 00000049 ??                  <1> vid_mode	resb	1	; current display mode */
   120 0000004A ????                <1> vid_columns	resw	1	; no. of columns on the screen */
   121 0000004C ????                <1> vid_buf_len	resw	1	; length of video buffer in bytes*//
   122 0000004E ????                <1> vid_start	resw	1	; start address of screen regeneration (in vid buf)*//
   123 00000050 <res 10h>           <1> vid_cursor	resw	8	; cursor postition on up to 8 screens */
   124 00000060 ????                <1> vid_cursor_mode	resw	1
   125 00000062 ??                  <1> vid_active_page	resb	1
   126 00000063 ????                <1> vid_addr_chip	resw	1	; I/O address for the video chip (6845,EGA,VGA)*//
   127 00000065 ??                  <1> vid_crt_mode	resb	1	; current setting of the 3x8 register ???? */
   128 00000066 ??                  <1> vid_palette	resb	1	; current color setting / palette **/
   129                              <1> ; */
   130                              <1> ; POST and ROM data */
   131 00000067 ????????            <1> io_rom_addr	resd	1	; far word to ROM initialization routine */
   132                              <1> %define io_rom_addr_low io_rom_addr
   133                              <1> %define io_rom_addr_seg (io_rom_addr+2)
   134 0000006B ??                  <1> interrupt_flag	resb	1	; indicates an interrupt occurred */
   135                              <1> ; */
   136                              <1> ; Timer data area  18.206602 hz  = ~54.925 ms  */
   137 0000006C ????                <1> timer_count_low	resw	1	; low word of timer count */
   138 0000006E ????                <1> timer_count_high	resw	1
   139                              <1> %define timer_count timer_count_low
   140                              <1> ; use timer_count as the double word timer counter */
   141 00000070 ??                  <1> timer_overflow	resb	1	; timer has rolled over since last read */
   142                              <1> ; */
   143                              <1> ; System & Keboard data area */
   144 00000071 ??                  <1> kbd_break_flag	resb	1	; bit 7 set if Break key is pressed */
   145 00000072 ????                <1> reset_flag	resw	1	; word=0x1234 if Reset is underway (80286) */
   146                              <1> ; */
   147                              <1> ; reboot() writes WARM_BOOT here before restarting the board, and POST */
   148                              <1> ; reads it to decide whether the memory march can be skipped.  Any       */
   149                              <1> ; program can set it and jump to FFFF:0000 -- that is the PC convention  */
   150                              <1> ; and this BIOS honours it.                                             */
   151                              <1> %define WARM_BOOT 0x1234
   152                              <1> ; */
   153                              <1> ; Fixed (Hard) disk data area */
   154 00000074 ??                  <1> hd_status	resb	1	; status info for hard disk */
