!  tools\COPT rules to translate
!  a NASM struc to a C struct
!

struc %1
=
struct _Loc0_vectors_ {

endstruc
=
} *LOC0_PTR;
#define loc0 (*LOC0_PTR)

; %1
=
/* %1 */

;	%1
=
/*	%1		*/

;
=

;%1
=
/*%1*/

! we had to change the comment character to get this to work
%1:
%2	resd	%3
=
%2	resd	%3
#define %1 %2

%1	resd	1
=
dword	%1;

%1	resd	1	%2
=
dword	%1;

%1	resd	%2
=
dword	%1[%2]

%1	resd	%2	%3
=
dword	%1[%3];

! we had to change the comment character to get this to work
%1	equ	%2
=
#define %1 %2

%1[%]define %2 %3
=
#define %2 %3
