   402                                  ; ---- The SD core ------------------------------------------------------------
   403                                  %include "sdcore.inc"
   404                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   405                              <1> ; sdcore.inc -- the SBC-386EX microSD socket: the SSIO, SPI-mode SD, and
   406                              <1> ;		reading and writing 512-byte sectors.
   407                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   408                              <1> ;
   409                              <1> ; This program is free software: you can redistribute it and/or modify
   410                              <1> ; it under the terms of the GNU General Public License as published by
   411                              <1> ; the Free Software Foundation, either version 3 of the License, or
   412                              <1> ; (at your option) any later version.  See SBC386/bios/COPYING.
   413                              <1> ;
   414                              <1> ; The routines below are SDTEST 13's (sdtest.asm), which proved them on
   415                              <1> ; the board, without its diagnostics.  sdtest.asm's comments say how each
   416                              <1> ; part was found; the short version, for anyone changing them:
   417                              <1> ;
   418                              <1> ;   - the card's clock is STXCLK and SRXCLK tied: transmitter master,
   419                              <1> ;     receiver slave, never both master
   420                              <1> ;   - CS# (P3.6) is open drain; P3DIR bit 6 must stay set, or 5V reaches
   421                              <1> ;     the card.  Nothing here writes P3DIR
   422                              <1> ;   - every burst restarts the baud-rate generator and waits [phd] before
   423                              <1> ;     starting (genstart): left free running, its phase at the start
   424                              <1> ;     decides whether the card hears the burst right
   425                              <1> ;   - twenty bytes of FF go before every command frame
   426                              <1> ;   - the receive offset is found from R1's first 0 bit, and every byte
   427                              <1> ;     after it reassembled at that offset
   428                              <1> ;   - a read -- command, R1, wait, token, data, CRC -- is one burst; so is
   429                              <1> ;     a write up to its data response
   430                              <1> ;   - waits are bounded; interrupts are off for each burst
   431                              <1> ;
   432                              <1> ; Uses DS = ES = the segment it lives in, and the direction flag clear.
   433                              <1> ;
   434                              <1> ; The caller provides nothing; it calls sd_start once, then sd_read and
   435                              <1> ; wr_sector with sector numbers of the card (not of a partition), secbuf
   436                              <1> ; holding the data.
   437                              <1> 
   438                              <1> SSIOTBUF	equ	0F480h		; write only
   439                              <1> SSIORBUF	equ	0F482h		; read only
   440                              <1> SSIOBAUD	equ	0F484h		; write only
   441                              <1> SSIOCON1	equ	0F486h
   442                              <1> SSIOCON2	equ	0F488h
   443                              <1> SSIOCTR		equ	0F48Ah		; read only
   444                              <1> P3PIN		equ	0F870h
   445                              <1> P3LTC		equ	0F872h
   446                              <1> P3DIR		equ	0F874h
   447                              <1> 
   448                              <1> TUE		equ	80h		; SSIOCON1: transmit underflow
   449                              <1> THBE		equ	40h		;  transmit holding buffer empty
   450                              <1> TEN		equ	10h		;  transmitter enable
   451                              <1> ROE		equ	08h		;  receive overflow
   452                              <1> RHBF		equ	04h		;  receive holding buffer full
   453                              <1> REN		equ	01h		;  receiver enable
   454                              <1> TXM		equ	02h		; SSIOCON2: transmitter master
   455                              <1> BEN		equ	80h		; SSIOBAUD: generator enable
   456                              <1> SDnCS		equ	40h		; P3.6
   457                              <1> SDnCD		equ	02h		; P3.1, low with a card in
   458                              <1> 
   459                              <1> ; SERCLK is CLK2/4, 10 MHz at 20 MHz; the clock is SERCLK / (2*BV + 2)
   460                              <1> BV_SLOW		equ	12		; 385 kHz: initialisation wants < 400
   461                              <1> 
   462                              <1> TICKS		equ	6Ch		; BDA timer count, 18.2 a second
   463                              <1> PRE		equ	20		; command burst: FFs before the frame
   464                              <1> WINLEN		equ	PRE+24		;  then 8 bytes of frame, 16 of window
   465                              <1> 
   466                              <1> WHY_OK		equ	0		; [why] after a failure
   467                              <1> WHY_R1		equ	1		;  no R1, or not 00
   468                              <1> WHY_TOK		equ	2		;  no data token, or not FE
   469                              <1> WHY_CRC		equ	3		;  the data's CRC16 is wrong
   470                              <1> WHY_SSIO	equ	4		;  a word lost (overflow) or late (underflow)
   471                              <1> WHY_SHORT	equ	5		;  the block not all kept
   472                              <1> WHY_WRESP	equ	6		;  the write not accepted
   473                              <1> WHY_BUSY	equ	7		;  still busy after half a second
   474                              <1> WHY_STAT	equ	8		;  CMD13 reported an error
