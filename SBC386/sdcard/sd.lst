   883                              <1> ; ---- A data command, in one burst --------------------------------------
   884                              <1> ;
   885                              <1> ; The command, R1, the wait, the token, the data and its CRC16 all go in
   886                              <1> ; one burst, so one offset serves the lot: the offset can differ from one
   887                              <1> ; burst to the next, and a fast card's token can arrive inside the
   888                              <1> ; command's own window (v6).
   889                              <1> ;
   890                              <1> ;   words 0 to WINLEN/2-1	the preamble, the frame and its window: the
   891                              <1> ;			transmitter refilled from cmdbuf, every word kept in
   892                              <1> ;			xbuf
   893                              <1> ;   then		the transmitter left alone -- it repeats its last word,
   894                              <1> ;			FFFF, an underflow, and exactly what the card wants --
   895                              <1> ;			and every word read into a ring of RINGW words, until
   896                              <1> ;			XDATA words after the first that is not FFFF
   897                              <1> ;
   898                              <1> ; The ring keeps the last RINGW words in order, so a token that came in
   899                              <1> ; the window followed by data starting with FFFF loses nothing (v11's
   900                              <1> ; "ea" at 1 MHz); a long wait for the token only overwrites FFs, whole
   901                              <1> ; words at a time, which leaves the alignment alone.  rd_xact unrolls the
   902                              <1> ; ring after the window, oldest first.
   903                              <1> 
   904                              <1> XDATA		equ	262		; > 1 + 257 words: token, 512+2 bytes
   905                              <1> RINGW		equ	560		; > XDATA + 257: room for all-FF data
   906                              <1> 
   907                              <1> ; xact_burst -- send cmdbuf, then FFs; keep the window in xbuf and the
   908                              <1> ; rest in the ring, as above.  [rtot] = words into the ring, [rwp] = where
   909                              <1> ; the next would have gone.  CF if the SSIO stopped, or nothing but FFFF
   910                              <1> ; came for CAPMAX words.  Interrupts off.
   911                              <1> CAPMAX		equ	30000		; 0.5s at 1 MHz, 0.2s at 2.5
   912                              <1> xact_burst:
