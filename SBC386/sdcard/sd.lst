   531 0000037B E2FD                <1> 	loop	.d
   532 0000037D BA86F4              <1> .go:	mov	dx,SSIOCON1
   533 00000380 B011                <1> 	mov	al,TEN|REN
   534 00000382 EE                  <1> 	out	dx,al
   535 00000383 59                  <1> 	pop	cx
   536 00000384 C3                  <1> 	ret
