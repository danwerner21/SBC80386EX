   870 0000057C C606[FC0B]FF        <1> 	mov	byte [frame],0FFh
   871 00000581 0C40                <1> 	or	al,40h
   872 00000583 A2[FD0B]            <1> 	mov	[frame+1],al
   873 00000586 8826[020C]          <1> 	mov	[frame+6],ah
   874 0000058A C606[030C]FF        <1> 	mov	byte [frame+7],0FFh
   875 0000058F 881E[010C]          <1> 	mov	[frame+5],bl
   876 00000593 883E[000C]          <1> 	mov	[frame+4],bh
   877 00000597 66C1EB10            <1> 	shr	ebx,16
   878 0000059B 881E[FF0B]          <1> 	mov	[frame+3],bl
   879 0000059F 883E[FE0B]          <1> 	mov	[frame+2],bh
   880 000005A3 665B                <1> 	pop	ebx
   881 000005A5 C3                  <1> 	ret
