     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; sd.asm -- SD.SYS, a DOS block device driver for the SBC-386EX's on-board
     3                                  ;		microSD socket.
     4                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     5                                  ;
     6                                  ; This program is free software: you can redistribute it and/or modify
     7                                  ; it under the terms of the GNU General Public License as published by
     8                                  ; the Free Software Foundation, either version 3 of the License, or
     9                                  ; (at your option) any later version.  See SBC386/bios/COPYING.
    10                                  ;
    11                                  ;	nasm -O9 -f bin -o SD.SYS sd.asm		(sdcore.inc beside it)
    12                                  ;	CONFIG.SYS:  DEVICE=SD.SYS
    13                                  ;
    14                                  ; One drive letter: the card's first FAT12 or FAT16 partition (MBR types
    15                                  ; 01, 04, 06, 0E), or, on a card with no partition table, the whole card
    16                                  ; as one volume.  Sectors are numbered in 32 bits (header attribute bit
    17                                  ; 1), as a partition over 32 MB needs; DOS 4 or later, so.
    18                                  ;
    19                                  ; At load the card is brought up (sdcore.inc's sd_start: the fastest
    20                                  ; clock that reads sector 0 correctly) and the volume found.  With no
    21                                  ; card, or nothing it can use, the driver says so and does not stay.
    22                                  ;
    23                                  ; Each sector is read or written by sdcore.inc in one burst, with CRC16
    24                                  ; checked on reads and the card's data response and status on writes,
    25                                  ; and tried three times.  Write-with-verify reads each sector back and
    26                                  ; compares.  Media check watches card detect: a card taken out (and put
    27                                  ; back) is reported as changed, and brought up again before the BPB is
    28                                  ; rebuilt.
    29                                  ;
    30                                  ; The driver runs on its own stack: DOS lends a block driver very little,
    31                                  ; and the SSIO bursts run with interrupts off for up to a revolution of
    32                                  ; the card's internal wait, so nothing else is borrowed either.
    33                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    34                                  
    35                                  	cpu	386
    36                                  	bits	16
    37                                  	org	0
    38                                  
    39                                  ; ---- Device header ----------------------------------------------------------
    40 00000000 FFFFFFFF                header:	dd	-1			; one driver in this file
    41 00000004 0200                    	dw	0002h			; block device; 32-bit sector numbers
    42 00000006 [1600]                  	dw	strategy
    43 00000008 [2100]                  	dw	interrupt
    44 0000000A 01                      	db	1			; units (DOS fills it in from INIT)
    45 0000000B 00<rep 7h>              	times 7 db 0
    46                                  
    47                                  ; request header offsets
    48                                  RQ_UNIT		equ	1
    49                                  RQ_CMD		equ	2
    50                                  RQ_STATUS	equ	3
    51                                  RQ_MEDIA	equ	13		; also INIT's unit count out
    52                                  RQ_ADDR		equ	14		; transfer address; INIT's break address;
    53                                  					;  MEDIA CHECK's answer (byte)
    54                                  RQ_COUNT	equ	18		; sectors; BUILD BPB's BPB pointer; INIT's
    55                                  					;  BPB array pointer
    56                                  RQ_START	equ	20		; start sector, FFFFh: see RQ_START32
    57                                  RQ_DRIVE	equ	22		; INIT: the drive number DOS gave us
    58                                  RQ_START32	equ	26
    59                                  
    60                                  ST_DONE		equ	0100h
    61                                  ST_ERROR	equ	8000h
    62                                  E_UNKNOWN	equ	03h		; error codes, low byte of the status
    63                                  E_NOTREADY	equ	02h
    64                                  E_SECTOR	equ	08h
    65                                  E_WRITE		equ	0Ah
    66                                  E_READ		equ	0Bh
    67                                  
    68 00000012 00000000                reqptr	dd	0
    69                                  
    70                                  strategy:
    71 00000016 2E891E[1200]            	mov	[cs:reqptr],bx
    72 0000001B 2E8C06[1400]            	mov	[cs:reqptr+2],es
    73 00000020 CB                      	retf
    74                                  
    75                                  ; ---- The interrupt routine: everything, on our own stack -----------------
    76                                  interrupt:
    77 00000021 9C                      	pushf
    78 00000022 6660                    	pushad
    79 00000024 1E                      	push	ds
    80 00000025 06                      	push	es
    81 00000026 2E8926[AA1B]            	mov	[cs:oldsp],sp
    82 0000002B 2E8C16[A81B]            	mov	[cs:oldss],ss
    83 00000030 8CC8                    	mov	ax,cs
    84 00000032 FA                      	cli
    85 00000033 8ED0                    	mov	ss,ax
    86 00000035 BC[AC1D]                	mov	sp,stacktop
    87 00000038 FB                      	sti				; (DOS's flags are restored on the way out)
    88 00000039 0E                      	push	cs
    89 0000003A 1F                      	pop	ds
    90 0000003B 0E                      	push	cs
    91 0000003C 07                      	pop	es
    92 0000003D FC                      	cld
    93 0000003E C41E[1200]              	les	bx,[reqptr]
    94 00000042 268A4702                	mov	al,[es:bx+RQ_CMD]
    95 00000046 0E                      	push	cs
    96 00000047 07                      	pop	es
    97 00000048 C706[A11B]0001          	mov	word [status],ST_DONE
    98 0000004E 3C00                    	cmp	al,0
    99 00000050 741C                    	je	.init
   100 00000052 3C01                    	cmp	al,1
   101 00000054 741D                    	je	.media
   102 00000056 3C02                    	cmp	al,2
   103 00000058 741E                    	je	.bpb
   104 0000005A 3C04                    	cmp	al,4
   105 0000005C 741F                    	je	.read
   106 0000005E 3C08                    	cmp	al,8
   107 00000060 7420                    	je	.write
   108 00000062 3C09                    	cmp	al,9
   109 00000064 7426                    	je	.writev
   110 00000066 C706[A11B]0381          	mov	word [status],ST_DONE|ST_ERROR|E_UNKNOWN
   111 0000006C EB26                    	jmp	.out
   112 0000006E E83B1D                  .init:	call	do_init
   113 00000071 EB21                    	jmp	.out
   114 00000073 E83A00                  .media:	call	do_media
   115 00000076 EB1C                    	jmp	.out
   116 00000078 E86900                  .bpb:	call	do_bpb
   117 0000007B EB17                    	jmp	.out
   118 0000007D E82101                  .read:	call	do_read
   119 00000080 EB12                    	jmp	.out
   120 00000082 C606[A31B]00            .write:	mov	byte [verify],0
   121 00000087 E84201                  	call	do_write
   122 0000008A EB08                    	jmp	.out
   123                                  .writev:
   124 0000008C C606[A31B]01            	mov	byte [verify],1
   125 00000091 E83801                  	call	do_write
   126 00000094 C41E[1200]              .out:	les	bx,[reqptr]
   127 00000098 A1[A11B]                	mov	ax,[status]
   128 0000009B 26894703                	mov	[es:bx+RQ_STATUS],ax
   129 0000009F FA                      	cli
   130 000000A0 2E8E16[A81B]            	mov	ss,[cs:oldss]
   131 000000A5 2E8B26[AA1B]            	mov	sp,[cs:oldsp]
   132 000000AA 07                      	pop	es
   133 000000AB 1F                      	pop	ds
   134 000000AC 6661                    	popad
   135 000000AE 9D                      	popf
   136 000000AF CB                      	retf
   137                                  
   138                                  ; ---- MEDIA CHECK -----------------------------------------------------------
   139                                  ; Not changed, unless the card is out or has been: then changed, and the
   140                                  ; card brought up again (if it is back) for the BUILD BPB that follows.
   141                                  do_media:
   142 000000B0 C41E[1200]              	les	bx,[reqptr]
   143 000000B4 26C6470E01              	mov	byte [es:bx+RQ_ADDR],1	; not changed
   144 000000B9 0E                      	push	cs
   145 000000BA 07                      	pop	es
   146 000000BB E81C09                  	call	sd_card
   147 000000BE 7507                    	jnz	.in
   148 000000C0 C606[A41B]01            	mov	byte [gone],1
   149 000000C5 EB11                    	jmp	.changed
   150 000000C7 803E[A41B]00            .in:	cmp	byte [gone],0
   151 000000CC 7415                    	je	.x
   152 000000CE E87A01                  	call	restart			; back: bring it up
   153 000000D1 7205                    	jc	.changed		;  (BUILD BPB will say not ready)
   154 000000D3 C606[A41B]00            	mov	byte [gone],0
   155                                  .changed:
   156 000000D8 C41E[1200]              	les	bx,[reqptr]
   157 000000DC 26C6470EFF              	mov	byte [es:bx+RQ_ADDR],0FFh
   158 000000E1 0E                      	push	cs
   159 000000E2 07                      	pop	es
   160 000000E3 C3                      .x:	ret
   161                                  
   162                                  ; ---- BUILD BPB ----------------------------------------------------------------
   163                                  do_bpb:
   164 000000E4 803E[A41B]00            	cmp	byte [gone],0
   165 000000E9 7511                    	jne	.nr
   166 000000EB C41E[1200]              	les	bx,[reqptr]
   167 000000EF 26C74712[741B]          	mov	word [es:bx+RQ_COUNT],bpb
   168 000000F5 268C4F14                	mov	[es:bx+RQ_COUNT+2],cs
   169 000000F9 0E                      	push	cs
   170 000000FA 07                      	pop	es
   171 000000FB C3                      	ret
   172 000000FC C706[A11B]0281          .nr:	mov	word [status],ST_DONE|ST_ERROR|E_NOTREADY
   173 00000102 C3                      	ret
   174                                  
   175                                  ; ---- INPUT, OUTPUT, OUTPUT WITH VERIFY -------------------------------------
   176                                  ; getio -- the request's transfer address, count and start sector into
   177                                  ; xfer, count and lba; the count it asks for checked against the volume.
   178                                  ; CF, with [status] set, if the card is out or the range runs off the end.
   179                                  getio:
   180 00000103 C41E[1200]              	les	bx,[reqptr]
   181 00000107 268B470E                	mov	ax,[es:bx+RQ_ADDR]
   182 0000010B 268B5710                	mov	dx,[es:bx+RQ_ADDR+2]
   183 0000010F 268B4F12                	mov	cx,[es:bx+RQ_COUNT]
   184 00000113 26660FB77714            	movzx	esi,word [es:bx+RQ_START]
   185 00000119 83FEFF                  	cmp	si,0FFFFh
   186 0000011C 7505                    	jne	.s16
   187 0000011E 26668B771A              	mov	esi,[es:bx+RQ_START32]
   188 00000123 26C747120000            .s16:	mov	word [es:bx+RQ_COUNT],0	; none done yet
   189 00000129 0E                      	push	cs
   190 0000012A 07                      	pop	es
   191 0000012B 89C5                    	mov	bp,ax			; normalised: offset under 16, so the
   192 0000012D C1ED04                  	shr	bp,4			;  512s added per sector cannot wrap
   193 00000130 01EA                    	add	dx,bp
   194 00000132 83E00F                  	and	ax,0Fh
   195 00000135 A3[9B1B]                	mov	[xfer],ax
   196 00000138 8916[9D1B]              	mov	[xfer+2],dx
   197 0000013C 890E[9F1B]              	mov	[count],cx
   198 00000140 668936[971B]            	mov	[lba],esi
   199 00000145 E89208                  	call	sd_card
   200 00000148 7419                    	jz	.nr
   201 0000014A 803E[A41B]00            	cmp	byte [gone],0
   202 0000014F 7512                    	jne	.nr
   203 00000151 660FB7C9                	movzx	ecx,cx
   204 00000155 6601F1                  	add	ecx,esi
   205 00000158 7216                    	jc	.range
   206 0000015A 663B0E[931B]            	cmp	ecx,[vsize]
   207 0000015F 770F                    	ja	.range
   208 00000161 F8                      	clc
   209 00000162 C3                      	ret
   210 00000163 C606[A41B]01            .nr:	mov	byte [gone],1
   211 00000168 C706[A11B]0281          	mov	word [status],ST_DONE|ST_ERROR|E_NOTREADY
   212 0000016E F9                      	stc
   213 0000016F C3                      	ret
   214 00000170 C706[A11B]0881          .range:	mov	word [status],ST_DONE|ST_ERROR|E_SECTOR
   215 00000176 F9                      	stc
   216 00000177 C3                      	ret
   217                                  
   218                                  ; next -- one sector done: the count in the request up, the transfer
   219                                  ; address on 512 bytes (kept normalised), the sector on one.
   220                                  next:
   221 00000178 C41E[1200]              	les	bx,[reqptr]
   222 0000017C 26FF4712                	inc	word [es:bx+RQ_COUNT]
   223 00000180 0E                      	push	cs
   224 00000181 07                      	pop	es
   225 00000182 A1[9B1B]                	mov	ax,[xfer]
   226 00000185 050002                  	add	ax,512
   227 00000188 89C2                    	mov	dx,ax
   228 0000018A C1EA04                  	shr	dx,4
   229 0000018D 0116[9D1B]              	add	[xfer+2],dx
   230 00000191 83E00F                  	and	ax,0Fh
   231 00000194 A3[9B1B]                	mov	[xfer],ax
   232 00000197 66FF06[971B]            	inc	dword [lba]
   233 0000019C FF0E[9F1B]              	dec	word [count]
   234 000001A0 C3                      	ret
   235                                  
   236                                  do_read:
   237 000001A1 E85FFF                  	call	getio
   238 000001A4 7225                    	jc	.x
   239 000001A6 833E[9F1B]00            .s:	cmp	word [count],0
   240 000001AB 741E                    	je	.x
   241 000001AD E86300                  	call	rd_try
   242 000001B0 7213                    	jc	.err
   243 000001B2 06                      	push	es			; to the caller's buffer
   244 000001B3 C43E[9B1B]              	les	di,[xfer]
   245 000001B7 BE[400E]                	mov	si,secbuf
   246 000001BA B90001                  	mov	cx,256
   247 000001BD F3A5                    	rep	movsw
   248 000001BF 07                      	pop	es
   249 000001C0 E8B5FF                  	call	next
   250 000001C3 EBE1                    	jmp	.s
   251 000001C5 C706[A11B]0B81          .err:	mov	word [status],ST_DONE|ST_ERROR|E_READ
   252 000001CB C3                      .x:	ret
   253                                  
   254                                  do_write:
   255 000001CC E834FF                  	call	getio
   256 000001CF 7241                    	jc	.x
   257 000001D1 833E[9F1B]00            .s:	cmp	word [count],0
   258 000001D6 743A                    	je	.x
   259 000001D8 1E                      	push	ds			; from the caller's buffer
   260 000001D9 C536[9B1B]              	lds	si,[xfer]
   261 000001DD BF[400E]                	mov	di,secbuf
   262 000001E0 B90001                  	mov	cx,256
   263 000001E3 F3A5                    	rep	movsw
   264 000001E5 1F                      	pop	ds
   265 000001E6 E84600                  	call	wr_try
   266 000001E9 7221                    	jc	.err
   267 000001EB 803E[A31B]00            	cmp	byte [verify],0
   268 000001F0 7415                    	je	.n
   269 000001F2 E81E00                  	call	rd_try			; read it back and compare
   270 000001F5 7215                    	jc	.err
   271 000001F7 06                      	push	es
   272 000001F8 C43E[9B1B]              	les	di,[xfer]
   273 000001FC BE[400E]                	mov	si,secbuf
   274 000001FF B90001                  	mov	cx,256
   275 00000202 F3A7                    	repe	cmpsw
   276 00000204 07                      	pop	es
   277 00000205 7505                    	jne	.err
   278 00000207 E86EFF                  .n:	call	next
   279 0000020A EBC5                    	jmp	.s
   280 0000020C C706[A11B]0A81          .err:	mov	word [status],ST_DONE|ST_ERROR|E_WRITE
   281 00000212 C3                      .x:	ret
   282                                  
   283                                  ; rd_try, wr_try -- sector [lba] of the volume, three tries.  CF if all
   284                                  ; three failed.
   285                                  rd_try:
   286 00000213 C606[A51B]03            	mov	byte [rtries],3
   287 00000218 668B1E[971B]            .t:	mov	ebx,[lba]
   288 0000021D 66031E[8F1B]            	add	ebx,[poff]
   289 00000222 E87E07                  	call	sd_read
   290 00000225 7307                    	jnc	.x
   291 00000227 FE0E[A51B]              	dec	byte [rtries]
   292 0000022B 75EB                    	jnz	.t
   293 0000022D F9                      	stc
   294 0000022E C3                      .x:	ret
   295                                  
   296                                  wr_try:
   297 0000022F C606[A51B]03            	mov	byte [rtries],3
   298 00000234 668B1E[971B]            .t:	mov	ebx,[lba]
   299 00000239 66031E[8F1B]            	add	ebx,[poff]
   300 0000023E E8F805                  	call	wr_sector
   301 00000241 7307                    	jnc	.x
   302 00000243 FE0E[A51B]              	dec	byte [rtries]
   303 00000247 75EB                    	jnz	.t
   304 00000249 F9                      	stc
   305 0000024A C3                      .x:	ret
   306                                  
   307                                  ; ---- Finding the volume -----------------------------------------------------
   308                                  ; restart -- the card from nothing, and its volume: CF if either fails,
   309                                  ; [fail] saying which (a message, for INIT).
   310                                  restart:
   311 0000024B C706[A61B][BE1E]        	mov	word [fail],m_nocard
   312 00000251 E88607                  	call	sd_card
   313 00000254 740F                    	jz	.no
   314 00000256 C706[A61B][E71E]        	mov	word [fail],m_nostart
   315 0000025C E88807                  	call	sd_start
   316 0000025F 7204                    	jc	.no
   317 00000261 E80300                  	call	findvol
   318 00000264 C3                      	ret
   319 00000265 F9                      .no:	stc
   320 00000266 C3                      	ret
   321                                  
   322                                  ; findvol -- poff, vsize and bpb from the card: the first FAT12/16
   323                                  ; partition in the MBR, or, if sector 0 is itself a boot sector, the
   324                                  ; whole card.  CF, [fail] set, if neither.
   325                                  findvol:
   326 00000267 C706[A61B][121F]        	mov	word [fail],m_noread
   327 0000026D 66C706[8F1B]000000-     	mov	dword [poff],0
   327 00000275 00                 
   328 00000276 66C706[971B]000000-     	mov	dword [lba],0
   328 0000027E 00                 
   329 0000027F E891FF                  	call	rd_try
   330 00000282 0F828100                	jc	.no
   331 00000286 C706[A61B][3D1F]        	mov	word [fail],m_nomedia
   332 0000028C 813E[3E10]55AA          	cmp	word [secbuf+510],0AA55h
   333 00000292 7573                    	jne	.no
   334 00000294 BE[FE0F]                	mov	si,secbuf+1BEh		; the partition table
   335 00000297 B90400                  	mov	cx,4
   336 0000029A 8A4404                  .p:	mov	al,[si+4]
   337 0000029D 3C01                    	cmp	al,01h			; FAT12
   338 0000029F 741E                    	je	.got
   339 000002A1 3C04                    	cmp	al,04h			; FAT16 < 32 MB
   340 000002A3 741A                    	je	.got
   341 000002A5 3C06                    	cmp	al,06h			; FAT16
   342 000002A7 7416                    	je	.got
   343 000002A9 3C0E                    	cmp	al,0Eh			; FAT16, LBA
   344 000002AB 7412                    	je	.got
   345 000002AD 83C610                  	add	si,16
   346 000002B0 E2E8                    	loop	.p
   347 000002B2 E85400                  	call	isboot			; none: is sector 0 a boot sector?
   348 000002B5 7331                    	jnc	.bs
   349 000002B7 C706[A61B][7D1F]        	mov	word [fail],m_nopart
   350 000002BD EB48                    	jmp	.no
   351 000002BF 668B4408                .got:	mov	eax,[si+8]
   352 000002C3 66A3[8F1B]              	mov	[poff],eax
   353 000002C7 66C706[971B]000000-     	mov	dword [lba],0		; its boot sector
   353 000002CF 00                 
   354 000002D0 E840FF                  	call	rd_try
   355 000002D3 7232                    	jc	.no
   356 000002D5 C706[A61B][B21F]        	mov	word [fail],m_noboot
   357 000002DB 813E[3E10]55AA          	cmp	word [secbuf+510],0AA55h
   358 000002E1 7524                    	jne	.no
   359 000002E3 E82300                  	call	isboot
   360 000002E6 721F                    	jc	.no
   361 000002E8 BE[4B0E]                .bs:	mov	si,secbuf+0Bh		; the BPB
   362 000002EB BF[741B]                	mov	di,bpb
   363 000002EE B91900                  	mov	cx,BPBLEN
   364 000002F1 F3A4                    	rep	movsb
   365 000002F3 660FB706[7C1B]          	movzx	eax,word [bpb+8]	; total sectors: 16 bits, or 32 if 0
   366 000002F9 09C0                    	or	ax,ax
   367 000002FB 7504                    	jnz	.t
   368 000002FD 66A1[891B]              	mov	eax,[bpb+21]
   369 00000301 66A3[931B]              .t:	mov	[vsize],eax
   370 00000305 F8                      	clc
   371 00000306 C3                      	ret
   372 00000307 F9                      .no:	stc
   373 00000308 C3                      	ret
   374                                  
   375                                  ; isboot -- CF clear if secbuf looks like a FAT boot sector: a jump, 512
   376                                  ; bytes a sector, a power of two sectors a cluster, one or two FATs.
   377                                  isboot:
   378 00000309 A0[400E]                	mov	al,[secbuf]
   379 0000030C 3CEB                    	cmp	al,0EBh
   380 0000030E 7404                    	je	.j
   381 00000310 3CE9                    	cmp	al,0E9h
   382 00000312 7524                    	jne	.no
   383 00000314 813E[4B0E]0002          .j:	cmp	word [secbuf+0Bh],512
   384 0000031A 751C                    	jne	.no
   385 0000031C A0[4D0E]                	mov	al,[secbuf+0Dh]
   386 0000031F 08C0                    	or	al,al
   387 00000321 7415                    	jz	.no
   388 00000323 88C4                    	mov	ah,al
   389 00000325 FECC                    	dec	ah
   390 00000327 84E0                    	test	al,ah			; a power of two
   391 00000329 750D                    	jnz	.no
   392 0000032B A0[500E]                	mov	al,[secbuf+10h]
   393 0000032E 3C01                    	cmp	al,1
   394 00000330 7206                    	jb	.no
   395 00000332 3C02                    	cmp	al,2
   396 00000334 7702                    	ja	.no
   397 00000336 F8                      	clc
   398 00000337 C3                      	ret
   399 00000338 F9                      .no:	stc
   400 00000339 C3                      	ret
