   814                                  
   815                                  ; genstart -- start a burst at a known phase of the clock: the generator
   816                                  ; from reset, [phd] reads of SSIOCTR as a delay, then the transmitter and
   817                                  ; receiver.  The first word must already be in SSIOTBUF.
   818                                  ;
   819                                  ; Why.  The transmitter starts in step with the baud-rate generator, and
   820                                  ; how a burst begins depends on the generator's phase at that instant
   821                                  ; (Intel's figures 12-7 and 12-8).  Free running, that phase is set by
   822                                  ; the time since the last burst: about the same throughout a run, since
   823                                  ; the code repeats, but different from run to run.  v10 shows it: CMD0
   824                                  ; answered in some runs, not at all in others, and a different code path
   825                                  ; (the recovery) turned a good run bad.  Restarting the generator each
   826                                  ; burst makes the phase repeatable; v5 did that with no delay and got a
   827                                  ; bad phase every time.  So step 3 tries delays until CMD0 answers, and
   828                                  ; step 9 does the same at each speed.  All with interrupts off: the delay
   829                                  ; is counted in instructions and must not be stretched.
   830                                  NPHD		equ	8		; delays tried: 0 to 7 reads
   831                                  genstart:
   832 000007FC 51                      	push	cx
   833 000007FD BA84F4                  	mov	dx,SSIOBAUD
   834 00000800 30C0                    	xor	al,al			; stopped: count cleared
   835 00000802 EE                      	out	dx,al
   836 00000803 A0[491C]                	mov	al,[baud]
   837 00000806 EE                      	out	dx,al			; and from the top
   838 00000807 0FB60E[441C]            	movzx	cx,byte [phd]
   839 0000080C E306                    	jcxz	.go
   840 0000080E BA8AF4                  	mov	dx,SSIOCTR
   841 00000811 EC                      .d:	in	al,dx
   842 00000812 E2FD                    	loop	.d
   843 00000814 BA86F4                  .go:	mov	dx,SSIOCON1
   844 00000817 B011                    	mov	al,TEN|REN
   845 00000819 EE                      	out	dx,al
   846 0000081A 59                      	pop	cx
   847 0000081B C3                      	ret
   848                                  
   849                                  ; spi_xfer -- move CX words (at least one) through the SSIO, full duplex.
   850                                  ;   SI	the bytes to send, two a word, first byte first; 0 sends FFh
   851                                  ;   DI	where to put the bytes received, the same way; 0 discards them
   852                                  ; Returns AX = the last word received, first byte in AL; CF set if the
   853                                  ; SSIO stopped answering.  Advances SI and DI when they are not 0.
   854                                  ; Clobbers BX, CX, DX.
   855                                  ;
   856                                  ; The transmitter is double buffered: the next word goes into the holding
   857                                  ; buffer while the last one shifts, and the receiver hands over each word
   858                                  ; as it completes.  If the buffer were not refilled in time the
   859                                  ; transmitter would send the old word again and the receiver would lose
   860                                  ; one, so the burst runs with interrupts held off.  The last word is
   861                                  ; followed by a disable, which lets it finish and then stops the clock.
   862                                  ;
   863                                  ; The baud-rate generator runs whether or not the transmitter does, and
   864                                  ; the transmitter starts in step with it, so how a burst begins depends
   865                                  ; on the generator's phase at that moment (Intel's figures 12-7, 12-8).
   866                                  ; One way the card counts an edge the slave receiver does not, and every
   867                                  ; byte comes in a bit early.  Free running, a command burst always gets
   868                                  ; through and its R1 locates the offset (v3, v4); but the offset can
   869                                  ; differ from one burst to the next above 385 kHz (v4), so a data command
   870                                  ; goes in one burst with its data (xact_burst).  Restarting the
   871                                  ; generator for every burst to fix the phase stopped the card hearing
   872                                  ; commands at all (v5), so it runs free.
   873                                  spi_xfer:
   874 0000081C 9C                      	pushf
   875 0000081D FA                      	cli
   876 0000081E E84B00                  	call	.txword
   877 00000821 BA80F4                  	mov	dx,SSIOTBUF
   878 00000824 EF                      	out	dx,ax
   879 00000825 E8D4FF                  	call	genstart
   880 00000828 49                      .loop:	dec	cx
   881 00000829 741A                    	jz	.last
   882 0000082B B440                    	mov	ah,THBE			; the last word is in the shifter
   883 0000082D E85300                  	call	.wait
   884 00000830 7231                    	jc	.fail
   885 00000832 E83700                  	call	.txword
   886 00000835 BA80F4                  	mov	dx,SSIOTBUF
   887 00000838 EF                      	out	dx,ax
   888 00000839 B404                    	mov	ah,RHBF			; the last word has come in
   889 0000083B E84500                  	call	.wait
   890 0000083E 7223                    	jc	.fail
   891 00000840 E83400                  	call	.rxword
   892 00000843 EBE3                    	jmp	.loop
   893 00000845 B440                    .last:	mov	ah,THBE
   894 00000847 E83900                  	call	.wait
   895 0000084A 7217                    	jc	.fail
   896 0000084C EC                      	in	al,dx			; DX = SSIOCON1
   897 0000084D 2488                    	and	al,TUE|ROE
   898 0000084F 0806[571C]              	or	[ssio_err],al		; should never happen; reported if it does
   899 00000853 30C0                    	xor	al,al			; disable: the word in the shifter finishes
   900 00000855 EE                      	out	dx,al
   901 00000856 B404                    	mov	ah,RHBF
   902 00000858 E82800                  	call	.wait
   903 0000085B 7206                    	jc	.fail
   904 0000085D E81700                  	call	.rxword
   905 00000860 9D                      	popf
   906 00000861 F8                      	clc
   907 00000862 C3                      	ret
   908 00000863 BA86F4                  .fail:	mov	dx,SSIOCON1
   909 00000866 30C0                    	xor	al,al
   910 00000868 EE                      	out	dx,al
   911 00000869 9D                      	popf
   912 0000086A F9                      	stc
   913 0000086B C3                      	ret
   914                                  
   915                                  .txword:				; AX = the next word to send
   916 0000086C B8FFFF                  	mov	ax,0FFFFh
