   765                                  ; The SSIO.
   766                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   767                                  
   768                                  ; ssio_init -- stopped, then arrangement [cfg] (TXM or RXM, never both),
   769                                  ; the generator running slow, the receive buffer emptied.
   770                                  ssio_init:
