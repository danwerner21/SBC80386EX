  1126                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1127                                  ; SD commands.
  1128                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1129                                  
  1130                                  ; sd_cmd -- send command AL with argument EBX and CRC byte AH (end bit
  1131                                  ; included; only CMD0 and CMD8 are checked in SPI mode), and return its
  1132                                  ; R1 in AL.  AL = FFh and CF set if no answer started in the window.  The
  1133                                  ; card must be selected.  Leaves the transaction positioned after R1, at
  1134                                  ; the offset found, for rd_abyte and rd_ablock.
  1135                                  ;
  1136                                  ; One burst of WINLEN bytes: FF, 40|cmd, the argument big end first, the
  1137                                  ; CRC, FF, then sixteen more FFs to clock the answer in.  R1's bit 7 is
  1138                                  ; always 0 and the card sends FFs until it answers, so the first 0 bit
  1139                                  ; from byte 6 on (an answer can start in byte 7, and arrive a bit early)
  1140                                  ; is the top bit of R1.
  1141                                  sd_cmd:
  1142 000009B6 6653                    	push	ebx
  1143 000009B8 51                      	push	cx
  1144 000009B9 52                      	push	dx
  1145 000009BA 56                      	push	si
  1146 000009BB 57                      	push	di
  1147 000009BC E88300                  	call	mkframe
  1148 000009BF BE[5F1C]                	mov	si,cmdbuf		; preamble, frame, window
  1149 000009C2 BF[8B1C]                	mov	di,win
  1150 000009C5 803E[221C]00            	cmp	byte [split],0
  1151 000009CA 7508                    	jne	.split
  1152 000009CC B91600                  	mov	cx,WINLEN/2
  1153 000009CF E88801                  	call	spi_burst		; the tight loop: right at any speed
  1154 000009D2 EB19                    	jmp	.sent
  1155 000009D4 B90E00                  .split:	mov	cx,(PRE+8)/2		; preamble and frame alone
  1156 000009D7 E842FE                  	call	spi_xfer
  1157 000009DA 7211                    	jc	.sent
  1158 000009DC B90800                  	mov	cx,(WINLEN-PRE-8)/2	; then the window, a word a burst
  1159 000009DF 51                      .sp1:	push	cx
  1160 000009E0 31F6                    	xor	si,si
  1161 000009E2 B90100                  	mov	cx,1
  1162 000009E5 E834FE                  	call	spi_xfer		; DI advances
  1163 000009E8 59                      	pop	cx
  1164 000009E9 7202                    	jc	.sent
  1165 000009EB E2F2                    	loop	.sp1
  1166 000009ED C606[501C]00            .sent:	mov	byte [held],0
  1167 000009F2 721E                    	jc	.none
  1168 000009F4 BBD000                  	mov	bx,(PRE+6)*8		; bit number: R1 can start in frame byte 7
  1169 000009F7 89DE                    .find:	mov	si,bx
  1170 000009F9 C1EE03                  	shr	si,3
  1171 000009FC 8A84[8B1C]              	mov	al,[win+si]
  1172 00000A00 88D9                    	mov	cl,bl
  1173 00000A02 80E107                  	and	cl,7
  1174 00000A05 D2E0                    	shl	al,cl
  1175 00000A07 A880                    	test	al,80h
  1176 00000A09 7416                    	jz	.found
  1177 00000A0B 43                      	inc	bx
  1178 00000A0C 81FB3001                	cmp	bx,(WINLEN-6)*8		; room for R1 and lookahead
  1179 00000A10 72E5                    	jb	.find
  1180 00000A12 C606[521C]2C            .none:	mov	byte [aidx],WINLEN
  1181 00000A17 C606[531C]00            	mov	byte [sbits],0
  1182 00000A1C B0FF                    	mov	al,0FFh
  1183 00000A1E F9                      	stc
  1184 00000A1F EB1A                    	jmp	.out
  1185 00000A21 88D8                    .found:	mov	al,bl
  1186 00000A23 2407                    	and	al,7
  1187 00000A25 A2[531C]                	mov	[sbits],al
  1188 00000A28 C1EB03                  	shr	bx,3
  1189 00000A2B 8A87[8B1C]              	mov	al,[win+bx]
  1190 00000A2F A2[541C]                	mov	[la],al
  1191 00000A32 43                      	inc	bx
  1192 00000A33 881E[521C]              	mov	[aidx],bl
  1193 00000A37 E8E2FE                  	call	rd_abyte		; R1
  1194 00000A3A F8                      	clc
  1195 00000A3B 5F                      .out:	pop	di
  1196 00000A3C 5E                      	pop	si
  1197 00000A3D 5A                      	pop	dx
  1198 00000A3E 59                      	pop	cx
  1199 00000A3F 665B                    	pop	ebx
  1200 00000A41 C3                      	ret
  1201                                  
  1202                                  ; mkframe -- command AL, argument EBX, CRC byte AH into the frame: FF,
  1203                                  ; 40|cmd, the argument big end first, the CRC, FF.  The FFs before it (the
  1204                                  ; preamble) and after it (the window), are never written.  Clears the
  1205                                  ; trace and the SSIO error flags.
  1206                                  ;
  1207                                  ; Why a preamble.  The transmitter starts in step with the free-running
  1208                                  ; baud-rate generator; caught high, the clock pin goes from floating low
  1209                                  ; straight to high, an edge the card counts -- and DI at that instant is
  1210                                  ; still floating, held LOW by R7.  So the card can see a 0 before the
  1211                                  ; burst's first bit, takes it for a command's start bit, and swallows the
  1212                                  ; next 48 bits as a command of its own: CMD0 went unanswered in v3's first
  1213                                  ; run, v5, v7 and v8, card reinserted or not, and was answered in the
  1214                                  ; others -- a matter of phase.  Twenty bytes of FF first let any such
  1215                                  ; phantom command end, be answered (illegal command) and finish before
  1216                                  ; the real frame; the search for R1 starts after the frame, past the
  1217                                  ; phantom's answer.
  1218                                  mkframe:
  1219 00000A42 6653                    	push	ebx
  1220 00000A44 C606[581C]00            	mov	byte [ntrace],0
  1221 00000A49 C606[571C]00            	mov	byte [ssio_err],0
  1222 00000A4E C606[731C]FF            	mov	byte [frame],0FFh
  1223 00000A53 0C40                    	or	al,40h
  1224 00000A55 A2[741C]                	mov	[frame+1],al
  1225 00000A58 8826[791C]              	mov	[frame+6],ah
  1226 00000A5C C606[7A1C]FF            	mov	byte [frame+7],0FFh
  1227 00000A61 881E[781C]              	mov	[frame+5],bl
  1228 00000A65 883E[771C]              	mov	[frame+4],bh
  1229 00000A69 66C1EB10                	shr	ebx,16
  1230 00000A6D 881E[761C]              	mov	[frame+3],bl
  1231 00000A71 883E[751C]              	mov	[frame+2],bh
  1232 00000A75 665B                    	pop	ebx
  1233 00000A77 C3                      	ret
  1234                                  
  1235                                  ; wait_token -- the card's bytes until one is not FFh, for up to half a
  1236                                  ; second.  AL = that byte (FEh starts a data block).
  1237                                  wait_token:
  1238 00000A78 53                      	push	bx
  1239 00000A79 51                      	push	cx
  1240 00000A7A E85306                  	call	ticks
  1241 00000A7D 89C3                    	mov	bx,ax
  1242 00000A7F B90001                  .w:	mov	cx,256
  1243 00000A82 E897FE                  .w1:	call	rd_abyte
  1244 00000A85 3CFF                    	cmp	al,0FFh
  1245 00000A87 750E                    	jne	.got
  1246 00000A89 E2F7                    	loop	.w1
  1247 00000A8B E84206                  	call	ticks
  1248 00000A8E 29D8                    	sub	ax,bx
  1249 00000A90 83F809                  	cmp	ax,9
  1250 00000A93 72EA                    	jb	.w
  1251 00000A95 B0FF                    	mov	al,0FFh
  1252 00000A97 59                      .got:	pop	cx
  1253 00000A98 5B                      	pop	bx
  1254 00000A99 C3                      	ret
  1255                                  
  1256                                  ; ---- A data command, in one burst --------------------------------------
  1257                                  ;
  1258                                  ; The command, R1, the wait, the token, the data and its CRC16 all go in
  1259                                  ; one burst, so one offset serves the lot: the offset can differ from one
  1260                                  ; burst to the next, and a fast card's token can arrive inside the
  1261                                  ; command's own window (v6).
  1262                                  ;
  1263                                  ;   words 0 to WINLEN/2-1	the preamble, the frame and its window: the
  1264                                  ;			transmitter refilled from cmdbuf, every word kept in
  1265                                  ;			xbuf
  1266                                  ;   then		the transmitter left alone -- it repeats its last word,
  1267                                  ;			FFFF, an underflow, and exactly what the card wants --
  1268                                  ;			and every word read into a ring of RINGW words, until
  1269                                  ;			XDATA words after the first that is not FFFF
  1270                                  ;
  1271                                  ; The ring keeps the last RINGW words in order, so a token that came in
  1272                                  ; the window followed by data starting with FFFF loses nothing (v11's
  1273                                  ; "ea" at 1 MHz); a long wait for the token only overwrites FFs, whole
  1274                                  ; words at a time, which leaves the alignment alone.  rd_xact unrolls the
  1275                                  ; ring after the window, oldest first.
  1276                                  
  1277                                  XDATA		equ	262		; > 1 + 257 words: token, 512+2 bytes
  1278                                  RINGW		equ	560		; > XDATA + 257: room for all-FF data
  1279                                  
  1280                                  ; xact_burst -- send cmdbuf, then FFs; keep the window in xbuf and the
  1281                                  ; rest in the ring, as above.  [rtot] = words into the ring, [rwp] = where
  1282                                  ; the next would have gone.  CF if the SSIO stopped, or nothing but FFFF
  1283                                  ; came for CAPMAX words.  Interrupts off.
  1284                                  CAPMAX		equ	30000		; 0.5s at 1 MHz, 0.2s at 2.5
  1285                                  xact_burst:
  1286 00000A9A 55                      	push	bp
  1287 00000A9B 9C                      	pushf
  1288 00000A9C FA                      	cli
  1289 00000A9D BE[5F1C]                	mov	si,cmdbuf
  1290 00000AA0 BF[D72B]                	mov	di,xbuf
  1291 00000AA3 AD                      	lodsw				; word 0 waits in the buffer ...
  1292 00000AA4 86C4                    	xchg	al,ah
  1293 00000AA6 BA80F4                  	mov	dx,SSIOTBUF
  1294 00000AA9 EF                      	out	dx,ax
  1295 00000AAA E84FFD                  	call	genstart		; ... goes to the shifter at enable,
  1296 00000AAD AD                      	lodsw				;  and word 1 takes its place
  1297 00000AAE 86C4                    	xchg	al,ah
  1298 00000AB0 BA80F4                  	mov	dx,SSIOTBUF
  1299 00000AB3 EF                      	out	dx,ax
  1300 00000AB4 BD1600                  	mov	bp,WINLEN/2
  1301                                  	; Each word that comes in means the shifter has just taken the word
  1302                                  	; waiting in the buffer: the next goes in at once, and the word in is
  1303                                  	; read while the following one shifts.
  1304 00000AB7 BA86F4                  .w:	mov	dx,SSIOCON1
  1305 00000ABA 31DB                    	xor	bx,bx			; 65536 polls: a word at any speed
  1306 00000ABC EC                      .w1:	in	al,dx
  1307 00000ABD A804                    	test	al,RHBF
  1308 00000ABF 7505                    	jnz	.w2
  1309 00000AC1 4B                      	dec	bx
  1310 00000AC2 75F8                    	jnz	.w1
  1311 00000AC4 EB70                    	jmp	.fail
  1312 00000AC6 B8FFFF                  .w2:	mov	ax,0FFFFh
  1313 00000AC9 81FE[8B1C]              	cmp	si,cmdbuf+WINLEN
  1314 00000ACD 7303                    	jae	.w3
  1315 00000ACF AD                      	lodsw
  1316 00000AD0 86C4                    	xchg	al,ah
  1317 00000AD2 BA80F4                  .w3:	mov	dx,SSIOTBUF
  1318 00000AD5 EF                      	out	dx,ax
  1319 00000AD6 BA82F4                  	mov	dx,SSIORBUF
  1320 00000AD9 ED                      	in	ax,dx
  1321 00000ADA 86C4                    	xchg	al,ah			; first byte first
  1322 00000ADC AB                      	stosw
  1323 00000ADD 4D                      	dec	bp
  1324 00000ADE 75D7                    	jnz	.w
  1325                                  	; The rest: read only.
  1326 00000AE0 BF[3825]                	mov	di,xring
  1327 00000AE3 31ED                    	xor	bp,bp			; BP = words into the ring
  1328 00000AE5 31DB                    	xor	bx,bx			; BX = BP to stop at, once known
  1329 00000AE7 B93075                  	mov	cx,CAPMAX
  1330 00000AEA BA86F4                  .r:	mov	dx,SSIOCON1
  1331 00000AED 31F6                    	xor	si,si			; 65536 polls (SI is free once the frame
  1332 00000AEF EC                      .r1:	in	al,dx			;  is out)
  1333 00000AF0 A804                    	test	al,RHBF
  1334 00000AF2 7505                    	jnz	.r2
  1335 00000AF4 4E                      	dec	si
  1336 00000AF5 75F8                    	jnz	.r1
  1337 00000AF7 EB3D                    	jmp	.fail
  1338 00000AF9 BA82F4                  .r2:	mov	dx,SSIORBUF
  1339 00000AFC ED                      	in	ax,dx
  1340 00000AFD 86C4                    	xchg	al,ah
  1341 00000AFF AB                      	stosw
  1342 00000B00 81FF[9829]              	cmp	di,xring+RINGW*2
  1343 00000B04 7203                    	jb	.r3
  1344 00000B06 BF[3825]                	mov	di,xring
  1345 00000B09 45                      .r3:	inc	bp
  1346 00000B0A 09DB                    	or	bx,bx
  1347 00000B0C 750B                    	jnz	.r4
  1348 00000B0E 83F8FF                  	cmp	ax,0FFFFh
  1349 00000B11 7419                    	je	.r5
  1350 00000B13 89EB                    	mov	bx,bp			; the first that is not FFFF
  1351 00000B15 81C30601                	add	bx,XDATA
  1352 00000B19 39DD                    .r4:	cmp	bp,bx
  1353 00000B1B 72CD                    	jb	.r
  1354 00000B1D E81D00                  	call	ssio_stop
  1355 00000B20 892E[2F25]              	mov	[rtot],bp
  1356 00000B24 893E[3125]              	mov	[rwp],di
  1357 00000B28 9D                      	popf
  1358 00000B29 F8                      	clc
  1359 00000B2A 5D                      	pop	bp
  1360 00000B2B C3                      	ret
  1361 00000B2C 49                      .r5:	dec	cx
  1362 00000B2D 75BB                    	jnz	.r
  1363 00000B2F E80B00                  	call	ssio_stop		; nothing came
  1364 00000B32 9D                      	popf
  1365 00000B33 F9                      	stc
  1366 00000B34 5D                      	pop	bp
  1367 00000B35 C3                      	ret
  1368 00000B36 E80400                  .fail:	call	ssio_stop
  1369 00000B39 9D                      	popf
  1370 00000B3A F9                      	stc
  1371 00000B3B 5D                      	pop	bp
  1372 00000B3C C3                      	ret
  1373                                  
  1374                                  ; ssio_stop -- end a burst: the word shifting finishes, any word waiting
  1375                                  ; in the buffer is never sent; that last word read and dropped.  The
  1376                                  ; overflow flag is added to [ssio_err] first -- not the underflow flag,
  1377                                  ; which a burst ending on a repeated FFFF sets on purpose.
  1378                                  ssio_stop:
  1379 00000B3D BA86F4                  	mov	dx,SSIOCON1
  1380 00000B40 EC                      	in	al,dx
  1381 00000B41 2408                    	and	al,ROE
  1382 00000B43 0806[571C]              	or	[ssio_err],al
  1383 00000B47 30C0                    	xor	al,al
  1384 00000B49 EE                      	out	dx,al
  1385 00000B4A 51                      	push	cx
  1386 00000B4B 31C9                    	xor	cx,cx
  1387 00000B4D EC                      .s1:	in	al,dx
  1388 00000B4E A804                    	test	al,RHBF
  1389 00000B50 7502                    	jnz	.s2
  1390 00000B52 E2F9                    	loop	.s1
  1391 00000B54 59                      .s2:	pop	cx
  1392 00000B55 BA82F4                  	mov	dx,SSIORBUF
  1393 00000B58 ED                      	in	ax,dx
  1394 00000B59 C3                      	ret
  1395                                  
  1396                                  ; spi_burst -- send CX words (at least 2) from SI, keeping the CX words
  1397                                  ; received at DI; the last word goes out once more as the burst ends, so
  1398                                  ; it should be FFFF.  CF if the SSIO stopped.  Interrupts off.
  1399                                  spi_burst:
  1400 00000B5A 55                      	push	bp
  1401 00000B5B 9C                      	pushf
  1402 00000B5C FA                      	cli
  1403 00000B5D 89CD                    	mov	bp,cx			; BP = words still to receive
  1404 00000B5F AD                      	lodsw
  1405 00000B60 86C4                    	xchg	al,ah
  1406 00000B62 BA80F4                  	mov	dx,SSIOTBUF
  1407 00000B65 EF                      	out	dx,ax
  1408 00000B66 E893FC                  	call	genstart
  1409 00000B69 AD                      	lodsw
  1410 00000B6A 86C4                    	xchg	al,ah
  1411 00000B6C BA80F4                  	mov	dx,SSIOTBUF
  1412 00000B6F EF                      	out	dx,ax
  1413 00000B70 83E902                  	sub	cx,2			; CX = words still to send
  1414 00000B73 BA86F4                  .l:	mov	dx,SSIOCON1
  1415 00000B76 31DB                    	xor	bx,bx			; 65536 polls: a word at any speed.  (256
  1416 00000B78 EC                      .l1:	in	al,dx			;  was too few at 385 kHz: on-chip I/O
  1417 00000B79 A804                    	test	al,RHBF			;  is quick, and v12 lost every command)
  1418 00000B7B 750A                    	jnz	.l2
  1419 00000B7D 4B                      	dec	bx
  1420 00000B7E 75F8                    	jnz	.l1
  1421 00000B80 E8BAFF                  	call	ssio_stop
  1422 00000B83 9D                      	popf
  1423 00000B84 F9                      	stc
  1424 00000B85 5D                      	pop	bp
  1425 00000B86 C3                      	ret
  1426 00000B87 E314                    .l2:	jcxz	.l3
  1427 00000B89 AD                      	lodsw
  1428 00000B8A 86C4                    	xchg	al,ah
  1429 00000B8C BA80F4                  	mov	dx,SSIOTBUF
  1430 00000B8F EF                      	out	dx,ax
  1431 00000B90 49                      	dec	cx
  1432 00000B91 750A                    	jnz	.l3
  1433 00000B93 BA86F4                  	mov	dx,SSIOCON1		; the last word is in: an underflow
