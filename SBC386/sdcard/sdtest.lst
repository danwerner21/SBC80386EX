  1439 00000BA1 86C4                    	xchg	al,ah
  1440 00000BA3 AB                      	stosw
  1441 00000BA4 4D                      	dec	bp
  1442 00000BA5 75CC                    	jnz	.l
  1443 00000BA7 E893FF                  	call	ssio_stop
  1444 00000BAA 9D                      	popf
  1445 00000BAB F8                      	clc
  1446 00000BAC 5D                      	pop	bp
  1447 00000BAD C3                      	ret
