     1                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     2                                  ; sdtest.asm -- bring up the SBC-386EX's on-board microSD socket, one rung
     3                                  ;		at a time, under DOS.
     4                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     5                                  ;
     6                                  ; This program is free software: you can redistribute it and/or modify
     7                                  ; it under the terms of the GNU General Public License as published by
     8                                  ; the Free Software Foundation, either version 3 of the License, or
     9                                  ; (at your option) any later version.  See SBC386/bios/COPYING.
    10                                  ;
    11                                  ;	nasm -O9 -f bin -o SDTEST.COM sdtest.asm	(-O9 sizes the jumps)
    12                                  ;
    13                                  ; THE WIRING (Hardware/SBC-386EX-2.0-kicad, SDcard sheet)
    14                                  ;
    15                                  ;   card CLK  <- pins 98 STXCLK and 77 SRXCLK, tied; 2.7K/4.7K divider
    16                                  ;   card DI   <- pin 79 SSIOTX; 2.7K/4.7K divider
    17                                  ;   card DO   -> pin 78 SSIORX; 10K pull-up to the card's 3.3V
    18                                  ;   card CS#  <- pin 86 P3.6, OPEN DRAIN; 10K pull-up to 3.3V, LED D8
    19                                  ;   card CD#  -> pin 75 P3.1, low when a card is in; 10K pull-up to 5V
    20                                  ;
    21                                  ; CS# goes straight from a 5V pin to the card.  P3DIR bit 6 must stay set
    22                                  ; -- open drain, pulled up to 3.3V -- or the card sees 5V; this program
    23                                  ; refuses to run if it is clear and never changes it.
    24                                  ;
    25                                  ; THE SSIO (Intel386 EX User's Manual, 272485, chapter 12)
    26                                  ;
    27                                  ; Words of 16 bits, most significant bit first; no 8-bit mode.  One of
    28                                  ; the transmitter and receiver is master and drives the clock -- STXCLK
    29                                  ; and SRXCLK are tied, and are the card's clock -- and the other is slave,
    30                                  ; clocked from its pin.  NEVER BOTH MASTER: two outputs on one wire.
    31                                  ;
    32                                  ;   TXM	transmitter master, receiver slave (Intel's figure 12-2)
    33                                  ;   RXM	receiver master, transmitter slave (figure 12-3)
    34                                  ;
    35                                  ; THE FIRST RUN (v1, TXM) found the card answering CMD0 -- it took the
    36                                  ; command, so clock, DI and CS work -- but read FE 03 for FF 01: every
    37                                  ; bit one early.  Either the slave receiver samples just after the card
    38                                  ; changes DO, or the clock gains an edge as it floats low at the end of
    39                                  ; each burst (R8 pulls it down).  So this version does not assume an
    40                                  ; alignment, it finds it:
    41                                  ;
    42                                  ;   - a command goes out in one burst with sixteen bytes of response
    43                                  ;     window after it; R1 always has bit 7 clear, so the first 0 bit in
    44                                  ;     the window is where the card's bytes start, and its position mod 8
    45                                  ;     is the receive offset for the rest of the transaction;
    46                                  ;   - every byte after that is reassembled at that offset;
    47                                  ;   - CID, CSD and sectors are checked against their CRC7 and CRC16, so
    48                                  ;     an alignment that changes between bursts shows up as a CRC error
    49                                  ;     rather than as plausible data;
    50                                  ;   - step 3 runs CMD0 in both arrangements and prints what each saw.
    51                                  ;
    52                                  ; Clock: SERCLK (SIOCFG bit 2, set by the BIOS) is CLK2/4, 10 MHz with a
    53                                  ; 20 MHz part, and the generator gives SERCLK / (2*BV + 2):
    54                                  BV_SLOW		equ	12		; 385 kHz: initialisation wants < 400
    55                                  ; and afterwards the fastest of BV 4..1 (1 to 2.5 MHz) that step 9 finds
    56                                  ; reading reliably: see bvtab.
    57                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    58                                  
    59                                  	cpu	386
    60                                  	bits	16
    61                                  	org	100h
    62                                  
    63                                  SSIOTBUF	equ	0F480h		; write only
    64                                  SSIORBUF	equ	0F482h		; read only
    65                                  SSIOBAUD	equ	0F484h		; write only
    66                                  SSIOCON1	equ	0F486h
    67                                  SSIOCON2	equ	0F488h
    68                                  SSIOCTR		equ	0F48Ah		; read only
    69                                  PINCFG		equ	0F826h
    70                                  SIOCFG		equ	0F836h
    71                                  P3PIN		equ	0F870h
    72                                  P3LTC		equ	0F872h
    73                                  P3DIR		equ	0F874h
    74                                  
    75                                  ; SSIOCON1
    76                                  TUE		equ	80h		; transmit underflow
    77                                  THBE		equ	40h		; transmit holding buffer empty
    78                                  TEN		equ	10h		; transmitter enable
    79                                  ROE		equ	08h		; receive overflow
    80                                  RHBF		equ	04h		; receive holding buffer full
    81                                  REN		equ	01h		; receiver enable
    82                                  ; SSIOCON2 -- exactly one of these
    83                                  TXM		equ	02h		; TXMM: transmitter master
    84                                  RXM		equ	01h		; RXMM: receiver master
    85                                  ; SSIOBAUD
    86                                  BEN		equ	80h		; generator enable
    87                                  ; port 3
    88                                  SDnCS		equ	40h		; P3.6
    89                                  SDnCD		equ	02h		; P3.1
    90                                  
    91                                  TICKS		equ	6Ch		; BDA timer count, 18.2 a second
    92                                  PRE		equ	20		; command burst: FFs before the frame (below)
    93                                  WINLEN		equ	PRE+24		;  then 8 bytes of frame, 16 of window
    94                                  TRACEMAX	equ	16
    95                                  
    96                                  %macro	say	1
    97                                  	mov	dx,%1
    98                                  	call	puts
    99                                  %endmacro
   100                                  
