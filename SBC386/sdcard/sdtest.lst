   920 00000874 86C4                    	xchg	al,ah			; first byte goes out first: MSB
   921 00000876 C3                      .tx1:	ret
   922                                  
   923                                  .rxword:				; AX = the word received, stored
   924 00000877 BA82F4                  	mov	dx,SSIORBUF
