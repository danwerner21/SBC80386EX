  1477 00000BE8 E857FE                  	call	mkframe
  1478 00000BEB E892FD                  	call	cs_low
  1479 00000BEE E8A9FE                  	call	xact_burst
  1480 00000BF1 9C                      	pushf
  1481 00000BF2 E89DFD                  	call	cs_high
  1482 00000BF5 9D                      	popf
  1483 00000BF6 0F829800                	jc	.timeout
