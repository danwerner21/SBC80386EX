  1097 0000040D BA04F8                  	mov	dx,CLKPRS	; pre-scale clock
  1098 00000410 EF                      	out	dx,ax		; PSCLK is now 1.000 mhz (1 usec clock)
  1099                                  
  1100                                  ;;;	call	bout
  1101                                  
  1102 00000411 BE[0901]                	mov	si,msgfreq
  1103 00000414 E86B00                  	call	putstr
