  1237                                  %include "ds1302.asm"
  1238                              <1> ; ds1302.asm -- access to the RTC and NVRAM
  1239                              <1> ;
  1240                              <1> ;**********
  1241                              <1> ; N.B. These will move to P1 from P3 on the final board
  1242                              <1> ;**********
  1243                              <1> DSLTC   equ     P3LTC           ; DS1302 latch
  1244                              <1> DSPIN   equ     P3PIN           ;   pin value
  1245                              <1> 
  1246                              <1> DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
  1247                              <1> DSCLK   equ     BIT1            ; Clock idles high
  1248                              <1> DSRST   equ     BIT6            ; Reset idles low (asserted)
  1249                              <1> 
  1250                              <1> DSMSK   equ     DSRST+DSCLK+DSDAT
  1251                              <1> 
  1252                              <1> 
  1253                              <1> %macro  nvdelay 0
  1254                              <1>         jmp     $+2
  1255                              <1>         jmp     $+2
  1256                              <1>         jmp     $+2
  1257                              <1> %endmacro
  1258                              <1> 
  1259                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1260                              <1> ;
  1261                              <1> ; INT 1A
  1262                              <1> ; function 20   Get NVRAM byte
  1263                              <1> ;
  1264                              <1> ; Enter with:
  1265                              <1> ;       AH      0x20
  1266                              <1> ;       AL      byte number ( 0 <= AL <= 30) 
  1267                              <1> ;   (single byte read)
  1268                              <1> ;
  1269                              <1> ;       AH      0x20
  1270                              <1> ;       AL      31
  1271                              <1> ;       ES:BX   pointer to 31 byte buffer
  1272                              <1> ;   (burst read)
  1273                              <1> ;
  1274                              <1> ; Exit with:
  1275                              <1> ;       AL      byte read (single byte read)
  1276                              <1> ;       Carry clear
  1277                              <1> ;
  1278                              <1> ;       AL      byte NVRAM[30] (burst read)
  1279                              <1> ;       ES:BX buffer filled with bytes 0..30
  1280                              <1> ;
  1281                              <1> ;       Carry clear
  1282                              <1> ;
  1283                              <1> ; Error:
  1284                              <1> ;       Carry set
  1285                              <1> ;
  1286                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1287                              <1> nv_read:
  1288 000004BA 5250                <1>         pushm   ax,dx
  1289                              <1> 
  1290 000004BC 3C1F                <1> 	cmp	al,31
  1291 000004BE 7316                <1> 	jae	nv_burstr	; burst or error
  1292                              <1> 
  1293                              <1> ; single byte read
  1294 000004C0 C1E009              <1> 	shl	ax,9		; AH = AL<<1
  1295 000004C3 80CCC1              <1>         or      ah,1100_0001B   ; RAM/READ
  1296                              <1> 
  1297 000004C6 E86400              <1> 	call	nv_reset_on	;start of command, set AL & DX
  1298                              <1> 
  1299                              <1> ; output the command, will turn Reset off
  1300 000004C9 E87500              <1>         call    nv_outb
  1301                              <1> 
  1302 000004CC E88A00              <1> 	call	nv_inb		;input byte to AH
  1303                              <1> 
  1304                              <1> nv_read_exit:
  1305 000004CF 88E0                <1> 	mov	al,ah		;return in AL
  1306 000004D1 5A                  <1> 	pop	dx		;get old ax
  1307 000004D2 88F4                <1> 	mov	ah,dh		;restore AH
  1308 000004D4 EB34                <1> 	jmp	nv_good_exit	;clear Carry & restore CX,DX
  1309                              <1> 
  1310                              <1> 
  1311                              <1> 
  1312                              <1> ;
  1313                              <1> ; handle burst read
  1314                              <1> nv_burstr:
  1315 000004D6 7535                <1>         jne	nv_error	;must be 31 exactly, else error
  1316                              <1> 
  1317 000004D8 5153                <1> 	pushm	bx,cx		;extra save
  1318                              <1> 
  1319 000004DA E85000              <1> 	call	nv_reset_on	;reset before command byte
  1320                              <1> 
  1321 000004DD B4FF                <1> 	mov	ah,1111_1111B	;burst read command
  1322 000004DF E85F00              <1> 	call	nv_outb		;output the command
  1323                              <1> 
  1324 000004E2 B91F00              <1> 	mov	cx,31		;
  1325                              <1> nv_read2:
  1326 000004E5 E87100              <1> 	call	nv_inb		;retrieve a byte in AH
  1327 000004E8 268827              <1>   es	mov	byte [bx],ah	;save in the array
  1328 000004EB 43                  <1>   	inc	bx
  1329 000004EC E2F7                <1> 	loop	nv_read2	;and loop back
  1330                              <1> 
  1331 000004EE 5B59                <1> 	popm	bx,cx		;and restore
  1332 000004F0 EBDD                <1>         jmp	nv_read_exit	;return AH
  1333                              <1>         
  1334                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1335                              <1> ;
  1336                              <1> ; INT 1A
  1337                              <1> ; function 21   Set NVRAM byte
  1338                              <1> ;
  1339                              <1> ; Enter with:
  1340                              <1> ;       AH      0x21
  1341                              <1> ;       AL      byte number ( 0 <= AL <= 30) 
  1342                              <1> ;   (single byte write)
  1343                              <1> ;       CL      byte value to write
  1344                              <1> ;
  1345                              <1> ;       AH      0x21
  1346                              <1> ;       AL      31
  1347                              <1> ;       ES:BX   pointer to 31 byte buffer
  1348                              <1> ;   (burst write)
  1349                              <1> ;
  1350                              <1> ; Exit with:
  1351                              <1> ;       Carry clear
  1352                              <1> ;
  1353                              <1> ; Error:
  1354                              <1> ;       Carry set
  1355                              <1> ;
  1356                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1357                              <1> nv_write:
  1358 000004F2 5250                <1>         pushm   ax,dx
  1359                              <1> 
  1360 000004F4 3C1F                <1> 	cmp	al,31
  1361 000004F6 7319                <1> 	jae	nv_burstw	; burst or error
  1362                              <1> 
  1363                              <1> ; single byte write
  1364 000004F8 C1E009              <1> 	shl	ax,9		; AH = AL<<1
  1365 000004FB 80CCC0              <1>         or      ah,1100_0000B   ; RAM/WRITE
  1366                              <1> 
  1367 000004FE E82C00              <1> 	call	nv_reset_on	;start of command, set AL & DX
  1368                              <1> 
  1369                              <1> ; output the command, will turn Reset off
  1370 00000501 E83D00              <1>         call    nv_outb
  1371                              <1> 
  1372 00000504 88CC                <1>         mov     ah,cl		;single byte to write
  1373 00000506 E83800              <1>         call    nv_outb
  1374                              <1> 
  1375                              <1> nv_full_exit:
  1376 00000509 58                  <1> 	popm	ax
  1377                              <1> nv_good_exit:
  1378 0000050A F8                  <1> 	clc 			;signal good return
  1379                              <1> nv_exit:
  1380 0000050B 5A                  <1> 	popm	dx
  1381 0000050C C3                  <1> 	ret	
  1382                              <1> ;	IRET
  1383                              <1> 
  1384                              <1> 
  1385                              <1> nv_error:
