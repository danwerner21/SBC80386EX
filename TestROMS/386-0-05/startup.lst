   823 0000026A BA26F4                          mov     dx,CS4MSKH      ; high mask
   824 0000026D B80FFC                          mov     ax,0xFC0F       ; set for 1mb only
   825 00000270 EF                              out     dx,ax           ;
   826 00000271 BA24F4                          mov     dx,CS4MSKL      ; low mask
   827 00000274 B801FC                          mov     ax,0xFC01       ; 1mb, mask SMM, enable
   828 00000277 EF                              out     dx,ax           ;
   829                                  
   830                                  ; Test all bits of the data path into memory
   831                                  ;
   832 00000278 31DB                            xor     bx,bx           ; will write to location 0
   833 0000027A 8EDB                            mov     ds,bx           ; DS=0000
   834 0000027C 90                              nop
   835 0000027D 8EC3                            mov     es,bx           ; ES=0000
   836 0000027F 90                              nop
   837                                  
   838 00000280 B90080                          mov     cx,32768
   839                                  mem0:
   840 00000283 B80100                          mov     ax,1            ; test bit 0
   841                                  mem1:
   842 00000286 8907                            mov     [bx],ax         ; store it
   843 00000288 90                              nop
   844 00000289 90                              nop
   845 0000028A 90                              nop
   846 0000028B 3B07                            cmp     ax,[bx]         ; compare to what was written
   847 0000028D 0F85C001                        jne     patherr
   848                                  %if 0
   849                                          cmp     ah,[bx+1]       ; byte compare
   850                                          jne     patherr
   851                                          cmp     al,[bx]         ; byte compare
   852                                          jne     patherr
   853                                  %endif
   854 00000291 D1E0                            shl     ax,1            ; test next bit
   855 00000293 73F1                            jnc     mem1
   856                                  ; the One's test passed
   857                                  
   858 00000295 B8FEFF                          mov     ax,0xFFFE       ; test zero bit
   859                                  mem2:
   860 00000298 8907                            mov     [bx],ax         ; store it
   861 0000029A 90                              nop
   862 0000029B 90                              nop
   863 0000029C 3B07                            cmp     ax,[bx]         ; check readback
   864 0000029E 0F85AF01                        jne     patherr
   865                                  %if 0
   866                                          cmp     ah,[bx+1]       ; byte compare
   867                                          jne     patherr
   868                                          cmp     al,[bx]         ; byte compare
   869                                          jne     patherr
   870                                  %endif
   871 000002A2 D1C0                            rol     ax,1
   872 000002A4 73F2                            jnc     mem2
   873                                  ; the Zero bit test passed
   874                                  
   875 000002A6 8D5F02                          lea     bx,[bx+2]
   876 000002A9 E2D8                            loop    mem0
   877                                  
   878                                  ; The BX has incremented by 2*32k, so it is now 0000
   879                                  
   880 000002AB 8ED3                            mov     ss,bx           ; set the stack pointer
   881 000002AD BC0040                          mov     sp,0x4000       ; may now use Stack & memory
   882                                  
   883 000002B0 6800F0                          push    0xF000
   884 000002B3 68[B702]                        push    good
