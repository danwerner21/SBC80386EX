  1062                                  
  1063                                  ; Try to determine the CPU frequency
  1064                                  
  1065 000003D8 BA34F8                  	mov	dx,TMRCFG	; Timer control
  1066 000003DB B04B                    	mov	al,TIMER_RUN	;start counters 0 & 1
  1067 000003DD EE                      	out	dx,al		; **
  1068                                  
  1069 000003DE BA20F0                  	mov	dx,OCW3M
  1070 000003E1 B04A                    	mov	al,BIT6+ZBIT5+ ZBIT4+BIT3 +BIT1+ZBIT0  ;IRreg
  1071 000003E3 EE                      	out	dx,al
  1072                                  wait00:
  1073 000003E4 EB00                    	jmp	$+2
  1074 000003E6 EB00                    	jmp	$+2
  1075 000003E8 EB00                    	jmp	$+2
