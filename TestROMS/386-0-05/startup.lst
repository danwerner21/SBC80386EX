  1209                                  
  1210                                  
  1211                                  ; Hexadecimal output:
  1212                                  ; extdword(EAX)
  1213                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  1214                                  ;
  1215 0000048F 66C1C810                eout:   ror     eax,16          ; put out high word first
  1216 00000493 E80C00                          call    wout
  1217 00000496 66C1E810                        shr     eax,16          ; put out the low word
  1218 0000049A EB06                            jmp     wout
  1219 0000049C 92                      dout:   xchg    ax,dx           ; put out DX first
  1220 0000049D E80200                          call    wout
  1221 000004A0 89D0                            mov     ax,dx
  1222 000004A2 86E0                    wout:   xchg    ah,al           ; put out AH first
  1223 000004A4 E80200                          call    bout
  1224 000004A7 88E0                            mov     al,ah           ; put out former AL
  1225 000004A9 50                      bout:   push    ax              ; save AL
  1226 000004AA C0E804                          shr     al,4            ; position High nibble
  1227 000004AD E80100                          call    nout            ; write high nibble
  1228 000004B0 58                              pop     ax
  1229 000004B1 240F                    nout:   and     al,0x0F         ; mask low nibble
  1230 000004B3 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  1231 000004B4 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  1232 000004B6 1440                            adc     al,0x40         ; form HEX digit
  1233 000004B8 EBB7                            jmp     putc            ; 'putc' does the return
