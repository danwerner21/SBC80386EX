  1085 000003F8 EC                      	in	al,dx		;low byte
  1086 000003F9 88C3                    	mov	bl,al
  1087 000003FB EC                      	in	al,dx		;high byte
  1088 000003FC 88C7                    	mov	bh,al
  1089 000003FE F7D3                    	not	bx		; -count-1
  1090                                  
  1091 00000400 8D87F401                	lea	ax,[bx+500]	; round to nearest integer
  1092 00000404 B9E803                  	mov	cx,1000
  1093 00000407 31D2                    	xor	dx,dx
  1094 00000409 F7F1                    	div	cx		;integer frequency
  1095 0000040B 48                      	dec	ax
