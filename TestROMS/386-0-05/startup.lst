  1105                                  ;;;	mov	ax,bx		;
  1106                                  ;;;	call	wout
  1107                                  
  1108 00000417 8D4705                  	lea	ax,[bx+5]	; round to 2 decimal places
  1109 0000041A 31D2                    	xor	dx,dx
  1110 0000041C F7F1                    	div	cx
  1111                                  
  1112 0000041E 52                      	push	dx		;save the remainder
  1113 0000041F B90A00                  	mov	cx,10
  1114 00000422 F6F1                    	div	cl
  1115 00000424 C0E004                  	shl	al,4
  1116 00000427 08E0                    	or	al,ah		; form BCD byte
  1117 00000429 E87D00                  	call	bout
  1118 0000042C B02E                    	mov	al,'.'
  1119 0000042E E84000                  	call	putc
  1120                                  
  1121 00000431 58                      	pop	ax		;remainder
