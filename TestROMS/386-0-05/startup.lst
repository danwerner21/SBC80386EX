  1138                                  ;  Halt with success ('1000') in the LITES
  1139                                  
  1140                                  
  1141                                  patherr:
  1142                                  stop:
  1143 00000451 F4                              hlt
  1144 00000452 EBFD                            jmp     $-1
  1145                                  
  1146                                  ; lites -- enter with new "lites" value in AL
  1147                                  ;       uses AX & DX
  1148                                  ;
  1149                                  lites:
  1150 00000454 F7D0                            not     ax              ; complement bits
  1151 00000456 C1C804                          ror     ax,4            ; rotate lites to hi bits of AH
  1152 00000459 BA62F8                          mov     dx,P1LTC        ; get parallel port address
  1153 0000045C EC                              in      al,dx           ; get port value
  1154 0000045D 30C4                            xor     ah,al           ; xor to AH
  1155 0000045F 80E4F0                          and     ah,0xF0         ; mask bits
  1156 00000462 30E0                            xor     al,ah           ; store in al
  1157 00000464 EE                              out     dx,al           ; and output
  1158 00000465 C3                              ret
  1159                                  
  1160                                  ;
  1161                                  ; outc -- write an ASCII 'cooked' character
  1162                                  ;       Convert NL to CR,NL
  1163                                  ;
  1164                                  outc:
  1165 00000466 3C0A                            cmp     al,ASCII_NL     ; test for NL
  1166 00000468 7507                            jne     putc            ; if not, just put out the character
