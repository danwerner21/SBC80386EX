  1184 0000047F EE                              out     dx,al           ; send the character
  1185                                  
  1186 00000480 5A                              pop     dx              ; register restores
  1187 00000481 C3                              ret
  1188                                  
  1189                                  
  1190                                  ; putstr -- put out ASCII string terminated by NUL
  1191                                  ;       DS:SI points at the string
