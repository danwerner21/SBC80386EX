   193                              <1> defw    CS0ADH  equ     0xF402
   194                              <1> defw    CS0MSKL equ     0xF404
   195                              <1> defw    CS0MSKH equ     0xF406
   196                              <1> defw    CS1ADL  equ     0xF408
   197                              <1> defw    CS1ADH  equ     0xF40A
   198                              <1> defw    CS1MSKL equ     0xF40C
   199                              <1> defw    CS1MSKH equ     0xF40E
   200                              <1> defw    CS2ADL  equ     0xF410
   201                              <1> defw    CS2ADH  equ     0xF412
   202                              <1> defw    CS2MSKL equ     0xF414
   203                              <1> defw    CS2MSKH equ     0xF416
   204                              <1> defw    CS3ADL  equ     0xF418
   205                              <1> defw    CS3ADH  equ     0xF41A
   206                              <1> defw    CS3MSKL equ     0xF41C
   207                              <1> defw    CS3MSKH equ     0xF41E
   208                              <1> defw    CS4ADL  equ     0xF420
   209                              <1> defw    CS4ADH  equ     0xF422
