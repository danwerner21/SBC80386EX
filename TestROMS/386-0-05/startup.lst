   791 0000023F ED                              in      ax,dx           ; read the Reset value
   792 00000240 83E0F0                          and     ax,0xFFF0       ; XXXF.XXXX (64K ROM0 should select)
   793 00000243 EF                              out     dx,ax           ;
   794 00000244 BA38F4                          mov     dx,UCSADL       ; address low
   795 00000247 ED                              in      ax,dx           ; read the Reset value
   796 00000248 25E2FD                          and     ax,0xFDE2       ; 8-bit, 2 wait states only
   797 0000024B EF                              out     dx,ax           ;
   798                                  
   799                                  ; Do the byte port initialization
   800                                  ;
   801 0000024C BE[8B01]                        mov     si,btab1        ; get table address to SI
   802 0000024F B9[5402]                        mov     cx,return1      ; set return address
   803 00000252 EBBE                            jmp     initb_          ; simulate call
   804                                  return1:
