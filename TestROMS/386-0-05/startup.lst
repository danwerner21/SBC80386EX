   211                              <1> defw    CS4MSKH equ     0xF426
   212                              <1> defw    CS5ADL  equ     0xF428
   213                              <1> defw    CS5ADH  equ     0xF42A
   214                              <1> defw    CS5MSKL equ     0xF42C
   215                              <1> defw    CS5MSKH equ     0xF42E
   216                              <1> defw    CS6ADL  equ     0xF430
   217                              <1> defw    CS6ADH  equ     0xF432
   218                              <1> defw    CS6MSKL equ     0xF434
   219                              <1> defw    CS6MSKH equ     0xF436
   220                              <1> defw    UCSADL  equ     0xF438
   221                              <1> defw    UCSADH  equ     0xF43A
   222                              <1> defw    UCSMSKL equ     0xF43C
   223                              <1> defw    UCSMSKH equ     0xF43E
   224                              <1> 
   225                              <1> ;
   226                              <1> ;/* The Synchronous Serial I/O Unit
   227                              <1> ;*/
   228                              <1> defw    SSIOTBUF equ    0xF480
   229                              <1> defw    SSIORBUF equ    0xF482
   230                              <1> defw    SSIOBAUD equ    0xF484
   231                              <1> defw    SSIOCON1 equ    0xF486
