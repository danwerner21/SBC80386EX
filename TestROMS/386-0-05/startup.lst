   890 000002BA EC                              in      al,dx           ; P1.3 is co-processor presence detect
   891 000002BB 89C3                            mov     bx,ax           ; save state in BL
   892                                  ; save FPU bit in BL
   893                                  
   894 000002BD B001                    	mov     al,1            ; show in the lights
   895 000002BF E89201                          call    lites
   896                                  
   897                                  
