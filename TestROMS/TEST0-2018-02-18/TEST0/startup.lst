   477                              <1> %imacro descr_linear_data 2-3.nolist	; address, size [, E]  E!=0 means expand down
   478                              <1> %assign __size__ (%2-1)	| 0xFF
   479                              <1> %if (__size__ <= 0xFFFF)
   480                              <1> %assign __gran__ 0
   481                              <1> %else
   482                              <1> %assign __gran__ 0xC0			; G B 0 0
   483                              <1> %endif
   484                              <1> %assign __expand__ 0
   485                              <1> %if %0==3
   486                              <1> %if %3
   487                              <1> %assign __expand__ 4
   488                              <1> %endif
   489                              <1> %endif
   490                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   491                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x93|__expand__)<<8)|(((%1)>>16)&0xFF)
   492                              <1> %endm
   493                              <1> 
   494                              <1> %imacro descr_linear_code 2-3.nolist	; address, size [,C]  C!=0 means conforming
   495                              <1> %assign __size__ (%2-1)	| 0xFF
   496                              <1> %if (__size__ <= 0xFFFF)
   497                              <1> %assign __gran__ 0
   498                              <1> %else
   499                              <1> %assign __gran__ 0xC0			; G D 0 0
   500                              <1> %endif
   501                              <1> %assign __conform__ 0
   502                              <1> %if %0==3
   503                              <1> %if %3
   504                              <1> %assign __conform__ 4
   505                              <1> %endif
   506                              <1> %endif
   507                              <1> dd (((%1)&0xFFFF)<<16)|(__size__&0xFFFF)
   508                              <1> dd (((%1)>>24)&0xFF)|((__gran__|(__size__>>16)&0x0F)<<16)|((0x9B|__conform__)<<8)|(((%1)>>16)&0xFF)
   509                              <1> %endm
