  1959 00000A67 EBFD                            jmp     $-1
  1960                                  dramstop:
  1961 00000A69 EBFE                    	jmp	$
  1962                                  
  1963                                  ; lites -- enter with new "lites" value in AL
  1964                                  ;       uses AX & DX
  1965                                  ;
  1966                                  %if 0
  1967                                  lites:		; Real mode entry
  1968                                          not     ax              ; complement bits
  1969                                          ror     ax,4            ; rotate lites to hi bits of AH
  1970                                          mov     dx,P1LTC        ; get parallel port address
  1971                                          in      al,dx           ; get port value
  1972                                          xor     ah,al           ; xor to AH
  1973                                          and     ah,0xF0         ; mask bits
  1974                                          xor     al,ah           ; store in al
  1975                                          out     dx,al           ; and output
  1976                                          ret
  1977                                  %endif
  1978                                  __lites:	; for Protected Mode
  1979 00000A6B 66                      	db	0x66		;opcode prefix
  1980                                  lites:		; Real mode entry
  1981 00000A6C BA62F8                          mov     dx,P1LTC        ; get parallel port address
  1982 00000A6F F6D0                    	not	al		; complement bits
  1983 00000A71 88C4                    	mov	ah,al
  1984 00000A73 C0E404                  	shl	ah,4		; bits to position, zero low 4 bits
  1985 00000A76 EC                      	in	al,dx
  1986 00000A77 240F                    	and	al,0x0F		; save low bits
  1987 00000A79 08E0                    	or	al,ah		; set complemented bits
  1988 00000A7B EE                      	out	dx,al		; and output
  1989 00000A7C C3                      	ret
  1990                                  
  1991                                  ;
  1992                                  ; output an ASCII_SP to the console
  1993                                  ;
  1994                                  space:
  1995 00000A7D B020                    	mov	al,ASCII_SP
  1996 00000A7F EB0B                    	jmp	putc
  1997                                  ;
  1998                                  ; output a CR/LF to the console
  1999                                  ;
  2000                                  ;;crlf:
  2001                                  ;
  2002                                  ; outc -- write an ASCII 'cooked' character
  2003                                  ;       Convert NL to CR,NL
  2004                                  ;
  2005                                  outc:
  2006 00000A81 3C0A                            cmp     al,ASCII_NL     ; test for NL
  2007 00000A83 7507                            jne     putc            ; if not, just put out the character
  2008                                  crlf:
  2009 00000A85 B00D                            mov     al,ASCII_CR     ; get a CR
  2010 00000A87 E80200                          call    putc            ; write it out
  2011 00000A8A B00A                            mov     al,ASCII_NL     ; restore NL
  2012                                  ;
  2013                                  ; putc -- put out a character in AL to the SIO0 port
  2014                                  ;
  2015                                  putc:
  2016 00000A8C 52                              push    dx              ; register saves
  2017 00000A8D 50                              push    ax
  2018                                  putc1:
  2019 00000A8E BAFD03                          mov     dx,LSR0         ; Line Status Register
  2020 00000A91 EC                              in      al,dx
  2021 00000A92 A820                            test    al,LSR_TBE      ; Transmit Buffer Empty
  2022 00000A94 74F8                            jz      putc1
  2023                                  
  2024 00000A96 58                              pop     ax
  2025 00000A97 BAF803                          mov     dx,TBR0         ; Transmit buffer register
  2026 00000A9A EE                              out     dx,al           ; send the character
  2027                                  
  2028 00000A9B 5A                              pop     dx              ; register restores
  2029 00000A9C C3                              ret
  2030                                  
  2031                                  
  2032                                  ; test for character waiting for input
  2033                                  ;	returns 1 in AL if char waiting
  2034                                  ;	returns 0 in AL if no char is waiting
  2035                                  ;
  2036                                  testc:
  2037 00000A9D 52                      	push	dx
  2038 00000A9E BAFD03                  	mov	dx,LSR0		; Line Status Register
  2039 00000AA1 EC                      	in	al,dx
  2040 00000AA2 2401                    	and	al,LSR_RBF	; Receive buffer full
  2041 00000AA4 5A                      	pop	dx
  2042 00000AA5 C3                      	ret
  2043                                  
  2044                                  
  2045                                  getc:
  2046 00000AA6 52                      	push	dx
  2047                                  getc1:
  2048 00000AA7 BAFD03                  	mov	dx,LSR0		; Line Status Register
  2049 00000AAA EC                      	in	al,dx
  2050 00000AAB A801                    	test	al,LSR_RBF	; Receive buffer full
  2051 00000AAD 74F8                    	jz	getc1
  2052                                  
  2053 00000AAF BAF803                  	mov	dx,RBR0		; Receive Buffer
  2054 00000AB2 EC                      	in	al,dx		; get the character
  2055 00000AB3 5A                      	pop	dx
  2056 00000AB4 C3                      	ret
  2057                                  
  2058                                  ; putstr -- put out ASCII string terminated by NUL
  2059                                  ;       DS:SI points at the string
  2060                                  ;
  2061                                  putstr:
  2062 00000AB5 31C0                            xor     ax,ax           ; set NUL terminator in AH
  2063                                  ;
  2064                                  ; gputstr -- general put out an ASCII string
  2065                                  ;       DS:SI points at the string
  2066                                  ;       AH is the terminator character, usually NUL
  2067                                  ;
  2068                                  gputstr:
  2069 00000AB7 AC                              lodsb                   ; get next character
  2070 00000AB8 38C4                            cmp     ah,al           ; is it the terminator
  2071 00000ABA 7405                            je      ps9
  2072 00000ABC E8C2FF                          call    outc
  2073 00000ABF EBF6                            jmp     gputstr
  2074 00000AC1 C3                      ps9:    ret
  2075                                  
  2076                                  
  2077                                  
  2078                                  
  2079                                  ; Hexadecimal output:
  2080                                  ; extdword(EAX)
  2081                                  ; dword(DX:AX) word(AX) byte(AL) nibble(AL[3..0])   output
  2082                                  ;
  2083 00000AC2 66C1C810                eout:   ror     eax,16          ; put out high word first
  2084 00000AC6 E80C00                          call    wout
  2085 00000AC9 66C1E810                        shr     eax,16          ; put out the low word
  2086 00000ACD EB06                            jmp     wout
  2087 00000ACF 92                      dout:   xchg    ax,dx           ; put out DX first
  2088 00000AD0 E80200                          call    wout
  2089 00000AD3 89D0                            mov     ax,dx
  2090 00000AD5 86E0                    wout:   xchg    ah,al           ; put out AH first
  2091 00000AD7 E80200                          call    bout
  2092 00000ADA 88E0                            mov     al,ah           ; put out former AL
  2093 00000ADC 50                      bout:   push    ax              ; save AL
  2094 00000ADD C0E804                          shr     al,4            ; position High nibble
  2095 00000AE0 E80100                          call    nout            ; write high nibble
  2096 00000AE3 58                              pop     ax
  2097 00000AE4 240F                    nout:   and     al,0x0F         ; mask low nibble
  2098 00000AE6 27                              daa                     ; divide by 10, AH=quotient, AL=remainder
  2099 00000AE7 04F0                            add     al,0xF0         ; propagate quotient into the Carry flag
  2100 00000AE9 1440                            adc     al,0x40         ; form HEX digit
  2101 00000AEB EB9F                            jmp     putc            ; 'putc' does the return
  2102                                  
  2103                                  
  2104                                  dev_VGA3	equ	0x4E0	;
  2105                                  ;
  2106                                  ; VGA3 reads & writes
  2107                                  ;
  2108                                  ; Enter with address in ES:BX
  2109                                  ; Value in AL, option in DH
  2110                                  ;   DH == 0	; use indirect r/w using address registers
  2111                                  ;   DH == 1	; use direct memory write
  2112                                  ;
  2113                                  vga3wr:
  2114 00000AED 08F6                    	or	dh,dh		;test write option
  2115 00000AEF 7404                    	jz	vwrind
  2116 00000AF1 268807                     ES	mov	[bx],al		;direct write
  2117 00000AF4 C3                         	ret
  2118                                  vwrind:
  2119 00000AF5 52                      	push	dx
  2120 00000AF6 BAE504                  	mov	dx,dev_VGA3 + 5
  2121 00000AF9 86C7                    	xchg	al,bh		;high address part
  2122 00000AFB EE                      	out	dx,al		;write to address reg.
  2123 00000AFC 42                      	inc	dx
  2124 00000AFD 86C3                    	xchg	al,bl		;low address part
  2125 00000AFF EE                      	out	dx,al		;write low address
  2126 00000B00 42                      	inc	dx
  2127 00000B01 86C7                    	xchg	al,bh		;restore value to write
  2128 00000B03 EE                      	out	dx,al		;write to memory
  2129 00000B04 86DF                    	xchg	bl,bh		;restore BX
  2130 00000B06 5A                      	pop	dx
  2131 00000B07 C3                      	ret
  2132                                  
  2133                                  vga3rd:
  2134 00000B08 08F6                    	or	dh,dh
  2135 00000B0A 7404                    	jz	vrdind
  2136 00000B0C 268A07                     ES	mov	al,[bx]		;direct read
  2137 00000B0F C3                         	ret
  2138                                  vrdind:
