  2169                              <1> ; ds1302.asm -- access to the RTC and NVRAM
  2170                              <1> ;
  2171                              <1> ;**********
  2172                              <1> ; N.B. These will move to P1 from P3 on the final board
  2173                              <1> ; Jan 2018 -- updated to P1 for rev 2.0 board
  2174                              <1> ;**********
  2175                              <1> DSLTC   equ     P1LTC           ; DS1302 latch
  2176                              <1> DSPIN   equ     P1PIN           ;   pin value
  2177                              <1> 
  2178                              <1> DSDAT   equ     BIT0            ; Data must be bit 0 & idles high
  2179                              <1> DSCLK   equ     BIT2            ; Clock idles high
  2180                              <1> DSRST   equ     BIT3            ; Reset idles low (asserted)
  2181                              <1> 
  2182                              <1> DSMSK   equ     DSRST+DSCLK+DSDAT
  2183                              <1> 
  2184                              <1> 
  2185                              <1> %macro  nvdelay 0
  2186                              <1>         jmp     $+2
  2187                              <1>         jmp     $+2
  2188                              <1>         jmp     $+2
  2189                              <1> %endmacro
  2190                              <1> 
  2191                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2192                              <1> ;
  2193                              <1> ; INT 1A
  2194                              <1> ; function 20   Get NVRAM byte
  2195                              <1> ;
  2196                              <1> ; Enter with:
  2197                              <1> ;       AH      0x20
  2198                              <1> ;       AL      byte number ( 0 <= AL <= 30) 
  2199                              <1> ;   (single byte read)
  2200                              <1> ;
  2201                              <1> ;       AH      0x20
  2202                              <1> ;       AL      31
  2203                              <1> ;       ES:BX   pointer to 31 byte buffer
  2204                              <1> ;   (burst read)
  2205                              <1> ;
  2206                              <1> ; Exit with:
  2207                              <1> ;       AL      byte read (single byte read)
  2208                              <1> ;       Carry clear
  2209                              <1> ;
  2210                              <1> ;       AL      byte NVRAM[30] (burst read)
  2211                              <1> ;       ES:BX buffer filled with bytes 0..30
  2212                              <1> ;
  2213                              <1> ;       Carry clear
  2214                              <1> ;
  2215                              <1> ; Error:
  2216                              <1> ;       Carry set
  2217                              <1> ;
  2218                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2219                              <1> nv_read:
  2220 00000B55 5250                <1>         pushm   ax,dx
  2221                              <1> 
  2222 00000B57 3C1F                <1> 	cmp	al,31
  2223 00000B59 7316                <1> 	jae	nv_burstr	; burst or error
  2224                              <1> 
  2225                              <1> ; single byte read
  2226 00000B5B C1E009              <1> 	shl	ax,9		; AH = AL<<1
  2227 00000B5E 80CCC1              <1>         or      ah,1100_0001B   ; RAM/READ
  2228                              <1> 
  2229 00000B61 E86400              <1> 	call	nv_reset_on	;start of command, set AL & DX
  2230                              <1> 
  2231                              <1> ; output the command, will turn Reset off
  2232 00000B64 E87500              <1>         call    nv_outb
  2233                              <1> 
  2234 00000B67 E88A00              <1> 	call	nv_inb		;input byte to AH
  2235                              <1> 
  2236                              <1> nv_read_exit:
  2237 00000B6A 88E0                <1> 	mov	al,ah		;return in AL
  2238 00000B6C 5A                  <1> 	pop	dx		;get old ax
  2239 00000B6D 88F4                <1> 	mov	ah,dh		;restore AH
  2240 00000B6F EB34                <1> 	jmp	nv_good_exit	;clear Carry & restore CX,DX
  2241                              <1> 
  2242                              <1> 
  2243                              <1> 
  2244                              <1> ;
  2245                              <1> ; handle burst read
  2246                              <1> nv_burstr:
  2247 00000B71 7535                <1>         jne	nv_error	;must be 31 exactly, else error
  2248                              <1> 
  2249 00000B73 5153                <1> 	pushm	bx,cx		;extra save
  2250                              <1> 
  2251 00000B75 E85000              <1> 	call	nv_reset_on	;reset before command byte
  2252                              <1> 
  2253 00000B78 B4FF                <1> 	mov	ah,1111_1111B	;burst read command
  2254 00000B7A E85F00              <1> 	call	nv_outb		;output the command
  2255                              <1> 
  2256 00000B7D B91F00              <1> 	mov	cx,31		;
  2257                              <1> nv_read2:
  2258 00000B80 E87100              <1> 	call	nv_inb		;retrieve a byte in AH
  2259 00000B83 268827              <1>   es	mov	byte [bx],ah	;save in the array
  2260 00000B86 43                  <1>   	inc	bx
  2261 00000B87 E2F7                <1> 	loop	nv_read2	;and loop back
  2262                              <1> 
  2263 00000B89 5B59                <1> 	popm	bx,cx		;and restore
  2264 00000B8B EBDD                <1>         jmp	nv_read_exit	;return AH
  2265                              <1>         
  2266                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2267                              <1> ;
  2268                              <1> ; INT 1A
  2269                              <1> ; function 21   Set NVRAM byte
  2270                              <1> ;
  2271                              <1> ; Enter with:
  2272                              <1> ;       AH      0x21
  2273                              <1> ;       AL      byte number ( 0 <= AL <= 30) 
  2274                              <1> ;   (single byte write)
  2275                              <1> ;       CL      byte value to write
  2276                              <1> ;
  2277                              <1> ;       AH      0x21
  2278                              <1> ;       AL      31
  2279                              <1> ;       ES:BX   pointer to 31 byte buffer
  2280                              <1> ;   (burst write)
  2281                              <1> ;
  2282                              <1> ; Exit with:
  2283                              <1> ;       Carry clear
  2284                              <1> ;
  2285                              <1> ; Error:
  2286                              <1> ;       Carry set
  2287                              <1> ;
  2288                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2289                              <1> nv_write:
  2290 00000B8D 5250                <1>         pushm   ax,dx
  2291                              <1> 
  2292 00000B8F 3C1F                <1> 	cmp	al,31
  2293 00000B91 7319                <1> 	jae	nv_burstw	; burst or error
  2294                              <1> 
  2295                              <1> ; single byte write
  2296 00000B93 C1E009              <1> 	shl	ax,9		; AH = AL<<1
  2297 00000B96 80CCC0              <1>         or      ah,1100_0000B   ; RAM/WRITE
  2298                              <1> 
  2299 00000B99 E82C00              <1> 	call	nv_reset_on	;start of command, set AL & DX
  2300                              <1> 
  2301                              <1> ; output the command, will turn Reset off
  2302 00000B9C E83D00              <1>         call    nv_outb
  2303                              <1> 
  2304 00000B9F 88CC                <1>         mov     ah,cl		;single byte to write
  2305 00000BA1 E83800              <1>         call    nv_outb
  2306                              <1> 
  2307                              <1> nv_full_exit:
  2308 00000BA4 58                  <1> 	popm	ax
  2309                              <1> nv_good_exit:
  2310 00000BA5 F8                  <1> 	clc 			;signal good return
  2311                              <1> nv_exit:
  2312 00000BA6 5A                  <1> 	popm	dx
  2313 00000BA7 C3                  <1> 	ret	
  2314                              <1> ;	IRET
  2315                              <1> 
  2316                              <1> 
  2317                              <1> nv_error:
  2318 00000BA8 58                  <1> 	pop	ax
  2319 00000BA9 F9                  <1> 	stc
  2320 00000BAA EBFA                <1> 	jmp	nv_exit
  2321                              <1> 
  2322                              <1> 
  2323                              <1> ; burst write
  2324                              <1> nv_burstw:
  2325 00000BAC 75FA                <1>         jne	nv_error	;must be 31 exactly, else error
  2326                              <1> 
  2327 00000BAE 5153                <1> 	pushm	bx,cx		;extra save
  2328                              <1> 
  2329 00000BB0 E81500              <1> 	call	nv_reset_on	;reset before command byte
  2330                              <1> 
  2331 00000BB3 B4FE                <1> 	mov	ah,1111_1110B	;burst write command
  2332 00000BB5 E82400              <1> 	call	nv_outb		;output the command
  2333                              <1> 
  2334 00000BB8 B91F00              <1> 	mov	cx,31		;
  2335                              <1> nv_write2:
  2336 00000BBB 268A27              <1>    es	mov	ah,byte [bx]	;get byte to write
  2337 00000BBE E81B00              <1>    	call	nv_outb
  2338 00000BC1 43                  <1> 	inc	bx		;increment
  2339 00000BC2 E2F7                <1> 	loop	nv_write2
  2340                              <1> 
  2341 00000BC4 5B59                <1> 	popm	bx,cx
  2342 00000BC6 EBDC                <1> 	jmp	nv_full_exit	;restore & return
  2343                              <1> 
  2344                              <1> 
  2345                              <1> 
  2346                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2347                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2348                              <1> ; utility programs
  2349                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2350                              <1> 
  2351                              <1> ; assert the RTC reset pin
  2352                              <1> ;
  2353                              <1> ;	exit with Clock High and Input Mode
  2354                              <1> ;
  2355                              <1> nv_reset_on:
  2356 00000BC8 BA62F8              <1> 	mov	dx,DSLTC	;Latch I/O address to be kept in DX
  2357 00000BCB EC                  <1> 	in	al,dx		;read the latch value
  2358 00000BCC 24F7                <1> 	and	al,~DSRST	;set Reset asserted
  2359 00000BCE 0C05                <1> 	or	al,DSDAT+DSCLK	;set Clock high, Read mode
  2360                              <1> nv_out_latch:
  2361 00000BD0 EE                  <1> 	out	dx,al		;output to latch
  2362                              <1> nv_delay:
  2363                              <1> 	nvdelay			;delay
  2364 00000BD1 EB00                <2>  jmp $+2
  2365 00000BD3 EB00                <2>  jmp $+2
  2366 00000BD5 EB00                <2>  jmp $+2
  2367 00000BD7 C3                  <1>         ret
  2368                              <1> 
  2369                              <1> 
  2370                              <1> ; remove Reset from the RTC pin
  2371                              <1> ;	do not affect the Clock pin
  2372                              <1> ;
  2373                              <1> nv_reset_off:		;assume latch value is in AL
  2374 00000BD8 0C08                <1> 	or	al,DSRST	;
  2375 00000BDA EBF4                <1> 	jmp	nv_out_latch
  2376                              <1> 
  2377                              <1> 
  2378                              <1> ; output a byte turning Reset off in the process
  2379                              <1> ;	byte is in AH
  2380                              <1> ;	latch status is in AL
  2381                              <1> ;	exit with Clock High
  2382                              <1> ;
  2383                              <1> nv_outb:
  2384 00000BDC 51                  <1> 	pushm	cx		;save register
  2385                              <1> 
  2386 00000BDD B90800              <1> 	mov	cx,8		;count 8 bits
  2387 00000BE0 0C08                <1> 	or	al,DSRST	;turn Reset off
  2388                              <1> nv_outb1:
  2389 00000BE2 D1E8                <1> 	shr	ax,1		;data LSB to bit7
  2390 00000BE4 D0C0                <1> 	rol	al,1		;data to bit0
  2391 00000BE6 24FB                <1> 	and	al,~DSCLK	;drop the clock
  2392 00000BE8 E8E5FF              <1> 	call	nv_out_latch	;output the latch
  2393 00000BEB 0C04                <1> 	or	al,DSCLK	;raise the clock
  2394 00000BED E8E0FF              <1> 	call	nv_out_latch	;clock in the data bit
  2395 00000BF0 E2F0                <1> 	loop	nv_outb1	;count the bits
  2396                              <1> 
  2397 00000BF2 59                  <1> 	popm	cx
  2398 00000BF3 C3                  <1>         ret
  2399                              <1> 
  2400                              <1> 
  2401                              <1> ; input a byte
  2402                              <1> ;	latch status is in AL
  2403                              <1> ;	return byte in AH
  2404                              <1> ;	exit with Clock High
  2405                              <1> ;
  2406                              <1> nv_inb:
  2407 00000BF4 51                  <1> 	pushm	cx		;register save
  2408                              <1> 
  2409 00000BF5 B108                <1> 	mov	cl,8		;count 8 bits
  2410 00000BF7 0C01                <1> 	or	al,DSDAT	;set Read mode
  2411                              <1> nv_inb1:
  2412 00000BF9 24FB                <1> 	and	al,~DSCLK	;drop the clock
  2413 00000BFB E8D2FF              <1> 	call	nv_out_latch	;**
  2414 00000BFE BA60F8              <1> 	mov	dx,DSPIN	;set to read data bit
  2415 00000C01 88C5                <1> 	mov	ch,al		;save latch in CH
  2416 00000C03 EC                  <1> 	in	al,dx		;read the bit
  2417 00000C04 D1C8                <1> 	ror	ax,1		;shift data into bit15
  2418 00000C06 88E8                <1> 	mov	al,ch		;restore latch
  2419 00000C08 BA62F8              <1> 	mov	dx,DSLTC	;restore latch address
  2420 00000C0B 0C04                <1> 	or	al,DSCLK	;raise the clock
  2421 00000C0D E8C0FF              <1> 	call	nv_out_latch	;**
  2422 00000C10 FEC9                <1> 	dec	cl
  2423 00000C12 75E5                <1> 	jnz	nv_inb1		;loop for 8 bits
  2424                              <1> 
  2425 00000C14 59                  <1> 	popm	cx		;restore
  2426 00000C15 C3                  <1> 	ret
  2427                              <1> 
  2428                              <1> 
  2429                              <1> 
  2430                              <1> 
  2431                                  
  2432                                  
  2433 00000C16 90<rept>                	align	16
  2434                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2435                                  ; The Linear Protected Mode code
  2436                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2437                                  %assign	PM_BASE  0x000F0000+ROM
  2438                                  %if 1
  2439 00000C20 FFFF00000093CF00        	descr_linear_data	0,0x0400_0000	; 64meg at 00000000
  2440 00000C28 FFFF000000970000        	descr_linear_data	0,0xFFFF, 1	; 64k 80286 data seg (exp down)
  2441 00000C30 FFFF0000009BCF00        	descr_linear_code	0,0x03FF_FFFF	; 64meg at 00000000
  2442                                  %endif
  2443                                  ;
  2444                                  ; The GDT prototype will be copied to the lowest address in SRAM
  2445                                  ;
  2446                                  PM_GDT	equ	SRAM_AD			; protected mode address
  2447                                  ;RM_GDT	equ	(SRAM_AD>>4):0000	; real mode segment offset
  2448                                  	
  2449                                  ;
  2450                                  ; now the Global Descriptor Table prototype
  2451                                  ;
  2452 00000C38 90<rept>                	align	16
  2453 00000C40 0000000000000000        gdt0:	dq	0		; null descriptor
  2454                                  descr08	equ	$-gdt0
  2455 00000C48 6F00                    	dw	len_gdt-1
  2456 00000C4A 00800A00                	dd	PM_GDT
  2457 00000C4E 0000                    	dw	0		; filler
  2458                                  descrP	equ	descr08
  2459                                  
  2460                                  
  2461                                  descr10	equ	$-gdt0
  2462 00000C50 0000000000000000        	dq	0		; LDT filler
  2463                                  
  2464                                  
  2465                                  descr18	equ	$-gdt0
  2466 00000C58 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
  2467                                  descr_DS	equ	descr18
  2468                                  
  2469                                  
  2470                                  descr20	equ	$-gdt0
  2471 00000C60 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
  2472                                  descr_ES	equ	descr20
  2473                                  
  2474                                  
  2475                                  descr28	equ	$-gdt0
  2476 00000C68 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
  2477                                  descr_SS	equ	descr28
  2478                                  
  2479                                  
  2480                                  descr30	equ	$-gdt0
  2481 00000C70 FFFF0000009BCF00        	descr_linear_code	0, 0x03FF_FFFF	; 64meg DRAM
  2482                                  descr_CS	equ	descr30
  2483                                  
  2484                                  
  2485                                  descr38	equ	$-gdt0
  2486 00000C78 FFFF00000F9B0000        	descr_linear_code	0xF0000, 0xFFFF ; 64K code (286)
  2487                                  descr_BIOS	equ	descr38
  2488                                  
  2489                                  
  2490                                  descr40	equ	$-gdt0
  2491 00000C80 FF02000400930000        	descr_linear_data	0x400, 0x300	; BIOS data area
  2492                                  descr_BDA equ	descr40
  2493                                  
  2494                                  
  2495                                  descr48	equ	$-gdt0
  2496 00000C88 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
  2497                                  descr_FS	equ	descr48
  2498                                  
  2499                                  
  2500                                  descr50	equ	$-gdt0
  2501 00000C90 FFFF00000093CF00        	descr_linear_data	0, 0x03FF_FFFF	; 64meg DRAM
  2502                                  descr_GS	equ	descr50
  2503                                  
  2504                                  
  2505                                  descr58	equ	$-gdt0
  2506 00000C98 FFFF000000930000        	descr_linear_data	0, 0xFFFF	; 64K return Data segment
  2507                                  descr_RMdata	equ	descr58
  2508                                  
  2509                                  
  2510                                  descr60	equ	$-gdt0
  2511 00000CA0 FFFF00000F9B0000        	descr_linear_code	0x000F0000, 0xFFFF	; 64K return Code segment
  2512                                  descr_RMcode	equ	descr60
  2513                                  
  2514                                  
  2515                                  descr68	equ	$-gdt0
  2516 00000CA8 FFFF00000F9BC100        	descr_linear_code	0xF0000, 0x1FFFF ; 128K code
  2517                                  descr_BIOS32	equ	descr68
  2518                                  
  2519                                  
  2520                                  len_gdt		equ	$-gdt0
  2521                                  
  2522                                  
  2523 00000CB0 FF<rept>                        setloc (0x10000-ROM-16)
  2524                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2525                                  ; The Real Mode statup jump
  2526                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2527                                  	bits	16
  2528                                          align   16
  2529                                  bootstrap:
  2530 00000FF0 EA[2A05]00F0                    jmp     0xF000:start	; 5 byte real-mode far call
  2531                                  	
  2532 00000FF5 FF<rept>                	times	11  db 0xFF	; fill out the ROM
