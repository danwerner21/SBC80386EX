  2140 00000B11 BAE504                  	mov	dx,dev_VGA3 + 5	;high address register
  2141 00000B14 88F8                    	mov	al,bh
  2142 00000B16 EE                      	out	dx,al		;high part of address
  2143 00000B17 42                      	inc	dx
  2144 00000B18 88D8                    	mov	al,bl		;low part of address
  2145 00000B1A EE                      	out	dx,al		; **
  2146 00000B1B 42                      	inc	dx
  2147 00000B1C EC                      	in	al,dx		;get data byte
  2148 00000B1D 5A                      	pop	dx
  2149 00000B1E C3                      	ret
