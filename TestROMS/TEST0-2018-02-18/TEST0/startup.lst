   738 00000443 26F8                <1>  dw %1
   739 00000445 40                  <1>  db %2
   740                                  
   741                                  TIMER_STOP	equ	BIT6+BIT0 + ZBIT1 + ZBIT3 + ZBIT5 ; stop 0, 1, 2
   742                                  TIMER_RUN	equ	TIMER_STOP + BIT1 + BIT3	; run counters 0, 1
   743                                  
   744                                          binit   TMRCFG, ZBIT7+TIMER_STOP ; bit6: s/w control of GATEn, bit7=0 enables all clocks
   745 00000446 34F8                <1>  dw %1
   746 00000448 41                  <1>  db %2
   747                                  		;Timers enabled, 1&2 use PSCLK, 0 uses TMRCLK0 (COMCLK/2)
   748                                  CTR0 equ ZBIT7+ZBIT6	;select counter 0
   749                                  CTR1 equ ZBIT7+ BIT6	;select counter 1
   750                                  CTR2 equ  BIT7+ZBIT6	;select counter 2
   751                                  CWR01 equ BIT5+BIT4	;Write Count low, then high
   752                                  MODE0 equ 0
   753                                  MODE1 equ BIT1
   754                                  ; counter 0 runs at 1.8432mhz / 2  =  921600  (just under 1mhz)
   755                                  ; @20hz, the divisor is 46080 yielding a 50ms time slot
   756                                  COMCLK	equ	1843200		; standard 1.8432mhz oscillator
   757                                  BAUD	equ	9600		; default SIO0 bit rate
   758                                  DIVISOR	equ	COMCLK/16/BAUD	; SIO0 divisor to achieve BAUD rate
   759                                  CLKIN0	equ	COMCLK/2	; Timer0 input count rate
   760                                  MS50	equ	CLKIN0 / 20
