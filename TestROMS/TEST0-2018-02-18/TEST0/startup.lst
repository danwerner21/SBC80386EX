  1845 000009B7 90                      	align	2
  1846 000009B8 EA[BD09]6800            	jmp	descr_BIOS32:pm_continue
  1847                                  
  1848                                  
  1849                                  	bits	32
  1850                                  pm_continue:
  1851 000009BD 66BAFF04                	mov	dx,0x4FF
  1852 000009C1 B06F                    	mov	al,0x6F
  1853 000009C3 EE                      	out	dx,al
  1854 000009C4 90                      	cnop
  1855                                  
  1856 000009C5 66BA62F8                	mov	dx,P1LTC
  1857 000009C9 EE                      	out	dx,al
  1858 000009CA 90                      	cnop
  1859                                  
  1860                                  
  1861 000009CB 66B81800                	mov	ax,descr_DS
  1862 000009CF 8ED8                    	mov	ds,ax
  1863 000009D1 8EC0                    	mov	es,ax
  1864 000009D3 8ED0                    	mov	ss,ax
  1865 000009D5 BC00000B00              	mov	esp,SRAM_AD + 0x8000
  1866                                  
  1867 000009DA B00C                    	mov	al,0x0C		; 1100 in LED lites
  1868 000009DC E88A000000              	call	__lites		; destroys EDX
  1869                                  
  1870                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1871                                  ; size memory here
  1872                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1873                                  
  1874 000009E1 31C0                    	xor	eax,eax		; DO  I=0 TO 63
  1875                                  size_loop:
  1876 000009E3 89C7                    	mov	edi,eax
  1877 000009E5 C1E714                  	shl	edi,20		; address Megabytes (2**20)
  1878 000009E8 8907                    	mov	[edi],eax	; store the number 0..63
  1879 000009EA FEC0                    	inc	al
  1880 000009EC 3C40                    	cmp	al,64		; 64mb limit
  1881 000009EE 72F3                    	jb	size_loop
  1882                                  
  1883 000009F0 2B0500000000            	sub	eax,[0]		; get memory size in megabytes
  1884 000009F6 89C7                    	mov	edi,eax		; return in EDI
  1885                                  
  1886                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1887                                  ; now return to Real Mode
  1888                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1889 000009F8 66B85800                	mov	ax,descr_RMdata		; 64K segment at 0x00000000
  1890 000009FC 8EE8                    	mov	gs,ax
  1891 000009FE 8EE0                    	mov	fs,ax
  1892 00000A00 8EC0                    	mov	es,ax
  1893 00000A02 8ED8                    	mov	ds,ax
  1894 00000A04 8ED0                    	mov	ss,ax
  1895 00000A06 EB00                    	jmp	$+2	; clear prefetch queue
  1896 00000A08 EA[0F0A0000]6000        	jmp	descr_RMcode:real_return
  1897                                  real_return:
  1898                                  	bits	16
  1899 00000A0F 0F20C0                  	mov	eax,cr0		;
  1900 00000A12 24FE                    	and	al,0xFE		; turn off PE bit
  1901 00000A14 0F22C0                  	mov	cr0,eax
  1902 00000A17 EB00                    	jmp	$+2
  1903 00000A19 EA[1E0A]00F0            	jmp	0xF000:really_return
  1904                                  really_return:
  1905 00000A1E B800A8                  	mov	ax,(SRAM_AD>>4)&0xFFFF
  1906 00000A21 8ED0                    	mov	ss,ax
  1907 00000A23 BC0080                  	mov	sp,SRAM_MS+1
  1908                                  
  1909 00000A26 31C0                    	xor	ax,ax
  1910 00000A28 8ED8                    	mov	ds,ax
  1911 00000A2A 8EC0                    	mov	es,ax
  1912 00000A2C 8EE0                    	mov	fs,ax
  1913 00000A2E 8EE8                    	mov	gs,ax
  1914                                  
  1915 00000A30 B80300                  	mov	ax,3
  1916 00000A33 E83600                  	call	lites
  1917                                  
  1918 00000A36 0E                      	push	cs
  1919 00000A37 1F                      	pop	ds
  1920 00000A38 BE[D903]                	mov	si,msg_real
  1921 00000A3B E87700                  	call	putstr
  1922                                  %if 0
  1923                                  	mov	ax,di
  1924                                  	call	bout
  1925                                  	call	space
  1926                                  %endif
  1927 00000A3E 89F8                    	mov	ax,di
  1928 00000A40 D40A                    	aam
