  1945 00000A58 BE[1D04]                	mov	si,msg99	;"Done." message
  1946 00000A5B E85700                  	call	putstr
  1947                                  
  1948 00000A5E B80600                  	mov	ax,6
  1949 00000A61 E80800                  	call	lites
  1950                                  
  1951 00000A64 EB00                    	jmp	stop
  1952                                  
  1953                                  
  1954                                  ;  Halt with success ('0110') in the LITES
  1955                                  
  1956                                  patherr:
  1957                                  stop:
